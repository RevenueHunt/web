# Cloudflare Pages redirects. Activated when CF is wired up.
# Rules are matched top-to-bottom, first match wins.

# --- Blog index pagination — must come BEFORE the legacy /blog/<slug>/ rule.
# /blog/2/.../blog/8/ are real Astro routes; the catch-all below would
# otherwise 301 them to /2/ (404). Self-rewrite (200) consumes the match.
# Extend this list if the blog grows past page 8.
/blog/2/  /blog/2/  200
/blog/3/  /blog/3/  200
/blog/4/  /blog/4/  200
/blog/5/  /blog/5/  200
/blog/6/  /blog/6/  200
/blog/7/  /blog/7/  200
/blog/8/  /blog/8/  200

# --- RSS feeds — WP served /feed/, /blog/feed/, /comments/feed/; the new site
# emits a single /feed.xml. Must come BEFORE the /blog/:slug/ rule, which would
# otherwise catch /blog/feed/ and 301 it to /feed/ (404).
/feed/  /feed.xml  301
/blog/feed/  /feed.xml  301
/comments/feed/  /feed.xml  301

# Legacy /blog/<slug>/ → /<slug>/ — WP shipped both URLs but always 301'd
# /blog/<slug>/ to /<slug>/. Preserve that behavior so old inbound links still work.
/blog/:slug/  /:slug/  301

# www → apex must be configured in Cloudflare Redirect Rules/Page Rules.
# Cloudflare Workers & Pages validates _redirects with relative URL patterns only.

# Strip AMP — Yoast generated these; never canonical.
/*/amp/  /:splat/  301
/*/amp  /:splat/  301

# WordPress admin/login/XML-RPC paths intentionally have no static routes here,
# so Cloudflare Pages will return its normal 404 for them.

# --- Careers: /jobs/<slug>/ postings moved to top-level routes on the new site.
/jobs/technical-customer-support/  /technical-customer-support/  301
/jobs/marketing-sales-funnel-architect/  /marketing-sales-funnel-architect/  301

# --- /shop/ — Shop-app page retired; send to the Shopify platform page.
/shop/  /product-recommendation-quiz-shopify/  301

# --- Author archives — /author/alex/ and /author/pochodura/ are real routes
# (src/pages/author/[slug]/). Only the retired "angel" slug redirects; it was
# the same person as "alex".
/author/angel/  /author/alex/  301

# --- Knowledge base: /faqs/* migrated to docs.revenuehunt.com.
#
# Cloudflare Workers & Pages rejects large _redirects files once the dynamic
# redirect limit is exceeded. Keep only the catch-all here so deploys pass.
# If per-article 301s are required, configure them outside this repo via
# Cloudflare Bulk Redirects / Redirect Rules.
# Catch-all: KB index, /faqs/category/*, /faqs/tag/*, and any other /faqs/
# URL not listed above → docs home. Keep LAST in this block.
/faqs/*  https://docs.revenuehunt.com/  301
