# Cloudflare Pages redirects. Activated when CF is wired up.

# Legacy /blog/<slug>/ → /<slug>/ — WP shipped both URLs but always 301'd
# /blog/<slug>/ to /<slug>/. Preserve that behavior so old inbound links still work.
/blog/:slug/  /:slug/  301

# www → apex
https://www.revenuehunt.com/*  https://revenuehunt.com/:splat  301!

# Strip AMP — Yoast generated these; never canonical.
/*/amp/  /:splat/  301
/*/amp  /:splat/  301

# Trailing-slash normalization (Astro emits with trailing slash already, but be defensive)
/wp-admin/*  /  404
/wp-login.php  /  404
/xmlrpc.php  /  404
