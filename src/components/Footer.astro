---
import { SITE } from "../lib/site";

/* Columns mirror revenuehunt.com footer (audited 2026-05-15). */
const groups: { heading: string; links: { label: string; href: string; external?: boolean }[] }[] = [
  {
    heading: "Product",
    links: [
      { label: "Product recommendation quiz", href: "/product-recommendation-quiz/" },
      { label: "How it works", href: "/how-it-works/" },
      { label: "Plans and pricing", href: "/pricing/" },
      { label: "Integrations", href: "/integrations/" },
      { label: "FAQs", href: "https://docs.revenuehunt.com/", external: true },
    ],
  },
  {
    heading: "Company",
    links: [
      { label: "What's new", href: "/whats-new/" },
      { label: "Blog", href: "/blog/" },
      { label: "Jobs", href: "/jobs/" },
      { label: "Contact us", href: "/contact/" },
    ],
  },
  {
    heading: "Resources",
    links: [
      { label: "Tutorial videos", href: "https://docs.revenuehunt.com/tutorials/", external: true },
      { label: "Testimonials", href: "/testimonials/" },
      { label: "For beauty brands", href: "/for-beauty-brands/" },
      { label: "Partners and affiliates", href: "/partners/" },
    ],
  },
];
const social: { label: string; href: string; path: string }[] = [
  {
    label: "RevenueHunt on LinkedIn",
    href: SITE.social.linkedin,
    path: "M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 110-4.13 2.06 2.06 0 010 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z",
  },
  {
    label: "RevenueHunt on X",
    href: SITE.social.twitter,
    path: "M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.46l8.6-9.83L0 1.15h7.59l5.24 6.93 6.07-6.93zm-1.29 19.5h2.04L6.49 3.24H4.3L17.61 20.65z",
  },
  {
    label: "RevenueHunt on YouTube",
    href: SITE.social.youtube,
    path: "M23.5 6.2a3.02 3.02 0 00-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.51A3.02 3.02 0 00.5 6.2C0 8.07 0 12 0 12s0 3.93.5 5.8a3.02 3.02 0 002.12 2.14c1.88.51 9.38.51 9.38.51s7.5 0 9.38-.51a3.02 3.02 0 002.12-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.8zM9.6 15.6V8.4l6.27 3.6-6.27 3.6z",
  },
];
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid grid-cols-2 gap-10 md:grid-cols-3">
      {groups.map((g) => (
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-500">{g.heading}</h3>
          <ul class="mt-4 space-y-2 text-sm text-slate-700">
            {g.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  {...(l.external ? { target: "_blank", rel: "external noopener" } : {})}
                  class="transition hover:text-slate-900"
                >
                  {l.label}{l.external && <span aria-hidden="true" class="ml-1 text-slate-400">↗</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="mt-12 flex flex-col items-start justify-between gap-4 border-t border-slate-200 pt-8 text-sm text-slate-600 sm:flex-row sm:items-center">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
        <p>&copy; Dairy Capital Limited {year}. RevenueHunt is a trading name of Dairy Capital Limited.</p>
        <ul class="flex gap-4">
          {social.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="external noopener"
                aria-label={s.label}
                class="text-slate-400 transition hover:text-slate-900"
              >
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={s.path} />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        <li><a href="/tos/" class="transition hover:text-slate-900">Terms of Service</a></li>
        <li><a href="/privacy/" class="transition hover:text-slate-900">Privacy Policy</a></li>
        <li><a href="/security/" class="transition hover:text-slate-900">Security</a></li>
        <li><a href="/feed.xml" class="transition hover:text-slate-900">RSS</a></li>
      </ul>
    </div>
  </div>
</footer>
