---
import { SITE } from "../lib/site";

const nav = [
  { label: "Product", href: "/product-recommendation-quiz/" },
  { label: "Pricing", href: "/pricing/" },
  { label: "Integrations", href: "/integrations/" },
  { label: "Templates", href: "/templates/" },
  { label: "Customers", href: "/testimonials/" },
  { label: "Blog", href: "/blog/" },
];
---

<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="text-xl font-bold tracking-tight text-slate-900">{SITE.name}</a>
    <nav class="hidden gap-7 text-sm font-medium text-slate-700 md:flex">
      {nav.map((item) => (
        <a href={item.href} class="transition hover:text-slate-900">{item.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <a href={`${SITE.app_url}/login`} class="text-sm font-medium text-slate-700 transition hover:text-slate-900">Log in</a>
      <a
        href={`${SITE.app_url}/signup`}
        class="rounded-md bg-[#16161D] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#26262e]"
      >
        Start free trial
      </a>
    </div>
  </div>
</header>
