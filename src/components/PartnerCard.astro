---
interface Props {
  name: string;
  url: string;
  logo: string;
  description: string;
  alt: string;
  cta: string;
}

const { name, url, logo, description, alt, cta } = Astro.props;
---

<li>
  <a
    href={url}
    target="_blank"
    rel="external noopener nofollow"
    class="group flex h-full flex-col items-start rounded-2xl border border-slate-200 bg-white p-6 text-start shadow-sm transition hover:border-slate-300 hover:shadow-md"
  >
    <img
      src={logo}
      alt={alt}
      loading="lazy"
      width="120"
      height="120"
      class="h-24 w-24 rounded-lg object-cover"
    />
    <h3 class="mt-5 text-lg font-semibold text-slate-900 group-hover:text-[#16161D]">{name}</h3>
    <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{description}</p>
    <span class="mt-5 inline-flex items-center justify-center rounded-md bg-[#16161D] px-5 py-2.5 text-sm font-semibold text-white transition group-hover:bg-[#26262e]">
      {cta}
    </span>
  </a>
</li>
