---
interface Props {
  value: number;
  /** Tailwind size classes for each star. */
  class?: string;
}
const { value, class: cls = "h-5 w-5" } = Astro.props;
const pct = Math.max(0, Math.min(100, (value / 5) * 100));
const star = `<svg viewBox="0 0 20 20" fill="currentColor" class="${cls}" aria-hidden="true"><path d="M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.36 4.18a1 1 0 00.95.69h4.4c.97 0 1.37 1.24.59 1.81l-3.56 2.59a1 1 0 00-.36 1.12l1.36 4.18c.3.92-.76 1.69-1.54 1.12l-3.56-2.59a1 1 0 00-1.18 0l-3.56 2.59c-.78.57-1.84-.2-1.54-1.12l1.36-4.18a1 1 0 00-.36-1.12L1.4 9.61c-.78-.57-.38-1.81.59-1.81h4.4a1 1 0 00.95-.69L9.05 2.93z"/></svg>`;
const row = star.repeat(5);
---
<span class="relative inline-flex align-middle" role="img" aria-label={`${value} out of 5 stars`}>
  <span class="flex text-slate-300" set:html={row} />
  <span class="absolute inset-0 flex overflow-hidden text-amber-400" style={`width:${pct}%`} set:html={row} />
</span>
