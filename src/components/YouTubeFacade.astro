---
/* Click-to-load YouTube facade. Renders the video poster + a play button and
   only injects the (heavy) youtube-nocookie embed on click — keeps the embed's
   JS off the initial load, which cuts page weight and improves mobile INP.
   Fills its parent, so wrap it in an aspect-ratio container. */
interface Props {
  id: string;
  title: string;
  /** Local poster (e.g. a same-origin webp). Skips the remote i.ytimg fetch -
   *  use it for above-the-fold facades so the poster is the LCP and ships webp. */
  poster?: string;
  /** Above-the-fold? Loads the poster eagerly with high fetch priority. */
  eager?: boolean;
  /** Poster alt text. Defaults to "" (decorative); set it on LCP facades. */
  alt?: string;
}
const { id, title, poster, eager = false, alt = "" } = Astro.props;
const posterWebp = `https://i.ytimg.com/vi_webp/${id}/maxresdefault.webp`;
const posterJpg = `https://i.ytimg.com/vi/${id}/maxresdefault.jpg`;
---

<button
  type="button"
  class="yt-facade group relative block h-full w-full cursor-pointer overflow-hidden"
  data-yt-id={id}
  aria-label={`Play video: ${title}`}
>
  <picture>
    {!poster && <source srcset={posterWebp} type="image/webp" />}
    <img
      src={poster ?? posterJpg}
      alt={alt}
      width="1280"
      height="720"
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : undefined}
      decoding="async"
      class="h-full w-full object-cover"
    />
  </picture>
  <span class="absolute inset-0 flex items-center justify-center bg-black/10 transition group-hover:bg-black/20">
    <span class="flex h-20 w-20 items-center justify-center rounded-full bg-black/70 shadow-lg transition group-hover:scale-105 group-hover:bg-[#FF0000]">
      <svg class="ml-0.5 h-9 w-9 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M8 5v14l11-7z" />
      </svg>
    </span>
  </span>
</button>

<!-- Click handling is global, in Base.astro, so in-content (markdown) facades work too. -->
