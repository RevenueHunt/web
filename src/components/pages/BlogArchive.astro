---
import type { CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { breadcrumb, organization } from "../../lib/schema";
import { SITE } from "../../lib/site";
import { postHref, sortByDate } from "../../lib/blog";

interface Props {
  kind: "category" | "tag";
  name: string;
  slug: string;
  posts: CollectionEntry<"blog">[];
}

const { kind, name, slug, posts } = Astro.props;

const sorted = sortByDate(posts);
const pathPrefix = kind === "category" ? "cat" : "tag";
const archiveUrl = `/${pathPrefix}/${slug}/`;
const heroLabel = kind === "category" ? "Category" : "Tag";
const titlePrefix = kind === "category" ? name : `#${name}`;
const pageTitle = `${titlePrefix} - ${SITE.name} blog`;
const pageDescription =
  kind === "category"
    ? `Articles in the ${name} category - strategies, case studies, and product updates from the RevenueHunt team.`
    : `Articles tagged ${name} - strategies, case studies, and product updates from the RevenueHunt team.`;

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Home", url: "/" },
    { name: "Blog", url: "/blog/" },
    { name: titlePrefix, url: archiveUrl },
  ]),
];

function fmt(d: Date) {
  return d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
}
---

<Base title={pageTitle} description={pageDescription} jsonLd={jsonLd}>
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-6xl px-6 py-14 sm:py-16">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-slate-700">Home</a>
        <span class="mx-2 text-slate-300">/</span>
        <a href="/blog/" class="hover:text-slate-700">Blog</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">{titlePrefix}</span>
      </nav>
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">{heroLabel}</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">{titlePrefix}</h1>
      <p class="mt-4 text-lg text-slate-600">{sorted.length} {sorted.length === 1 ? "article" : "articles"}</p>
    </div>
  </section>

  <main class="mx-auto max-w-4xl px-6 py-12 sm:py-16">
    <ul class="divide-y divide-slate-200">
      {sorted.map((post) => (
        <li>
          <a href={postHref(post)} class="group flex gap-6 py-6 sm:gap-8">
            {post.data.featuredImage ? (
              <div class="flex aspect-square h-32 w-32 flex-shrink-0 items-center justify-center overflow-hidden rounded-lg bg-slate-50 sm:h-40 sm:w-40">
                <img
                  src={post.data.featuredImage}
                  alt={post.data.title}
                  loading="lazy"
                  class="max-h-full max-w-full object-contain"
                />
              </div>
            ) : (
              <div class="aspect-square h-32 w-32 flex-shrink-0 rounded-lg bg-slate-100 sm:h-40 sm:w-40" />
            )}
            <div class="min-w-0 flex-1">
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
                {fmt(post.data.pubDate)}
                {post.data.author && ` · ${post.data.author}`}
              </p>
              <h2 class="mt-2 text-xl font-semibold text-slate-900 group-hover:text-[#16161D]">{post.data.title}</h2>
              {post.data.description && (
                <p class="mt-2 line-clamp-2 text-sm text-slate-600 sm:text-base">{post.data.description}</p>
              )}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </main>

  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-white/70">
        Most shoppers leave because they can't find the right product
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Turn shoppers into confident buyers with a Product Recommendation Quiz that drives sales.
      </h2>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a
          href="/demo/"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >Book a demo</a>
        <a
          href="/pricing/"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >See pricing</a>
      </div>
    </div>
  </section>
</Base>
