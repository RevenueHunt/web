---
import Base from "../../layouts/Base.astro";
import { organization, breadcrumb, softwareApplication } from "../../lib/schema";
import { SITE } from "../../lib/site";
import { COMPETITORS_BY_LANG, COMPETITOR_ORDER } from "../../lib/competitors";
import { t, type Lang, localizedHref } from "../../lib/i18n";
import { LT } from "../../lib/content/longtail";

interface Props {
  lang?: Lang;
  translated?: boolean;
}
const { lang = "en", translated = false } = Astro.props;
const lt = LT[lang];
const lp = (p: string) => localizedHref(p, lang);
const items = COMPETITOR_ORDER.map((slug) => COMPETITORS_BY_LANG[lang][slug]!);

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=compare_index";
const WOO_PLUGIN = "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";

const jsonLd = [
  organization(),
  softwareApplication(),
  breadcrumb([
    { name: t[lang].breadcrumb_home, url: lp("/") },
    { name: lt.cmp_breadcrumb, url: lp("/compare/") },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    itemListElement: items.map((c, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: `RevenueHunt vs ${c.name}`,
      url: new URL(lp(`/compare/${c.slug}/`), SITE.site_url).href,
    })),
  },
];
---

<Base
  title={lt.cmp_hub_title}
  description={lt.cmp_hub_desc}
  ogImage="/og/compare.png"
  jsonLd={jsonLd}
  lang={lang}
  translated={translated}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={lp("/")} class="hover:text-slate-700">{t[lang].breadcrumb_home}</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">{lt.cmp_breadcrumb}</span>
      </nav>
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">{lt.cmp_hub_eyebrow}</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          {lt.cmp_hub_h1}
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          {lt.cmp_hub_sub}
        </p>
      </div>
    </div>
  </section>

  <!-- Comparison cards -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <ul class="grid gap-4 sm:grid-cols-2" role="list">
        {items.map((c) => (
          <li>
            <a
              href={lp(`/compare/${c.slug}/`)}
              class="group block h-full rounded-xl border border-slate-200 p-6 transition hover:border-[#16161D] hover:shadow-md"
            >
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">{c.category}</p>
              <h2 class="mt-2 text-lg font-semibold text-slate-900 group-hover:text-[#16161D]">
                RevenueHunt vs {c.name}
              </h2>
              <p class="mt-2 text-sm text-slate-600">{c.heroSubtitle}</p>
              <span class="mt-4 inline-flex items-center text-sm font-medium text-[#16161D]">
                {lt.cmp_see}
                <svg class="ms-1 h-4 w-4 transition-transform group-hover:translate-x-0.5 rtl:-scale-x-100" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M7.21 4.29a1 1 0 011.42 0l5 5a1 1 0 010 1.42l-5 5a1 1 0 11-1.42-1.42L11.09 10 7.21 6.12a1 1 0 010-1.42z" clip-rule="evenodd" />
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        {lt.hub_brands_h2}
      </h2>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SHOPIFY_INSTALL}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          {lt.cta_start_shopify}
        </a>
        <a
          href={WOO_PLUGIN}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          {lt.cta_start_woo}
        </a>
      </div>
    </div>
  </section>
</Base>
