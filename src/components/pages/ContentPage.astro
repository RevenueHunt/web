---
// Shared renderer for a `pages` collection entry (the non-blog marketing/content
// pages). Platform slugs delegate to the bespoke PlatformPage layout; everything
// else uses the generic hero + prose + ResourceCards + CTA layout. Used by the
// English [slug] route and by each locale's [slug] route, so the markup lives in
// one place and only the `lang`/`translated` props differ.
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../Breadcrumb.astro";
import PlatformPage from "./PlatformPage.astro";
import ResourceCards from "../ResourceCards.astro";
import { organization, breadcrumb, softwareApplication } from "../../lib/schema";
import { SITE } from "../../lib/site";
import { PLATFORM_CONFIGS } from "../../lib/platforms";
import { t, type Lang, localizedHref } from "../../lib/i18n";
import { CHROME } from "../../lib/content/chrome";

interface Props {
  entry: CollectionEntry<"pages">;
  lang?: Lang;
  /** True when this page exists in every locale (emits hreflang). */
  translated?: boolean;
  /** Optional crumb inserted between Home and the page title (e.g. Jobs). */
  parentCrumb?: { label: string; href: string };
  /** Optional red status badge shown below the title (e.g. Applications closed). */
  badge?: string;
}

const { entry, lang = "en", translated = false, parentCrumb, badge } = Astro.props;
const c = CHROME[lang];
const lp = (path: string) => localizedHref(path, lang);

const slug = entry.data.legacySlug;
const isPlatform = slug in PLATFORM_CONFIGS;
const platformConfig = isPlatform ? PLATFORM_CONFIGS[slug] : null;

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=footer_cta";
const WOOCOMMERCE_DOWNLOAD =
  "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";

// Legal/utility pages should not carry product SoftwareApplication schema. (These
// are English-only and never reach the locale routes, but keep the guard for the
// English path that shares this component.)
const LEGAL_SLUGS = new Set(["privacy", "tos", "dpa", "security"]);

const pageUrl = lp(`/${slug}/`);
const jsonLd = [
  organization(),
  ...(LEGAL_SLUGS.has(slug) ? [] : [softwareApplication()]),
  breadcrumb([
    { name: t[lang].breadcrumb_home, url: lp("/") },
    ...(parentCrumb ? [{ name: parentCrumb.label, url: lp(parentCrumb.href) }] : []),
    { name: entry.data.title, url: pageUrl },
  ]),
];

// Always render (cheap); the platform branch ignores Content and lets
// PlatformPage render the body itself.
const { Content } = await render(entry);
---

{isPlatform && platformConfig ? (
  <PlatformPage entry={entry} config={platformConfig} lang={lang} translated={translated} />
) : (
  <Base
    title={`${entry.data.title} - ${SITE.name}`}
    description={entry.data.description}
    ogImage={entry.data.featuredImage ?? undefined}
    jsonLd={jsonLd}
    lang={lang}
    translated={translated}
  >
    <section class="bg-gradient-to-b from-slate-50 to-white">
      <div class="mx-auto max-w-5xl px-6 py-14 sm:py-16">
        <Breadcrumb items={[
          { label: t[lang].breadcrumb_home, href: lp("/") },
          ...(parentCrumb ? [{ label: parentCrumb.label, href: lp(parentCrumb.href) }] : []),
          { label: entry.data.title },
        ]} />
        <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">{entry.data.title}</h1>
        {badge && (
          <p class="mt-5">
            <span class="inline-flex items-center rounded-full bg-red-50 px-3 py-1 text-sm font-semibold text-red-700 ring-1 ring-inset ring-red-600/20">{badge}</span>
          </p>
        )}
        {entry.data.description && (
          <p class="mt-6 max-w-3xl text-xl text-slate-600">{entry.data.description}</p>
        )}
      </div>
    </section>

    <div class="mx-auto max-w-5xl px-6 py-12 sm:py-16">
      <article class="prose prose-slate prose-lg max-w-none
        prose-headings:tracking-tight prose-headings:text-slate-900
        prose-h2:mt-16 prose-h2:text-3xl prose-h2:font-bold prose-h2:border-b prose-h2:border-slate-200 prose-h2:pb-3
        prose-h3:mt-10 prose-h3:text-xl prose-h3:font-semibold
        prose-h6:mt-8 prose-h6:text-sm prose-h6:font-semibold prose-h6:uppercase prose-h6:tracking-wider prose-h6:text-slate-500
        prose-p:text-slate-700
        prose-img:rounded-lg prose-img:my-6
        prose-a:text-slate-900 prose-a:underline-offset-4 hover:prose-a:text-slate-700
        prose-strong:text-slate-900
        prose-li:my-1">
        <Content />
      </article>
    </div>

    {!LEGAL_SLUGS.has(slug) && <ResourceCards lang={lang} />}

    <section class="bg-[#16161D]">
      <div class="mx-auto max-w-4xl px-6 py-20 text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-white/70">
          {c.cta_kicker}
        </p>
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
          {c.cta_h2}
        </h2>
        <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
          <a
            href={SHOPIFY_INSTALL}
            target="_blank"
            rel="external noopener nofollow"
            class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
          >
            {c.cta_install_shopify}
          </a>
          <a
            href={WOOCOMMERCE_DOWNLOAD}
            target="_blank"
            rel="external noopener nofollow"
            class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
          >
            {c.cta_get_woocommerce}
          </a>
        </div>
      </div>
    </section>
  </Base>
)}
