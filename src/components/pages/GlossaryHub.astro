---
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../Breadcrumb.astro";
import { organization, breadcrumb, softwareApplication, definedTermSet } from "../../lib/schema";
import {
  GLOSSARY_BY_LANG,
  GLOSSARY_ORDER,
  GLOSSARY_RELATED_GUIDES_BY_LANG,
} from "../../lib/glossary";
import { t, type Lang, localizedHref } from "../../lib/i18n";
import { LT } from "../../lib/content/longtail";

interface Props {
  lang?: Lang;
  translated?: boolean;
}
const { lang = "en", translated = false } = Astro.props;
const lt = LT[lang];
const lp = (p: string) => localizedHref(p, lang);
const terms = GLOSSARY_ORDER.map((slug) => GLOSSARY_BY_LANG[lang][slug]!);
const guides = GLOSSARY_RELATED_GUIDES_BY_LANG[lang];

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=glossary_index";
const WOO_PLUGIN = "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";

const jsonLd = [
  organization(),
  softwareApplication(),
  breadcrumb([
    { name: t[lang].breadcrumb_home, url: lp("/") },
    { name: lt.gl_breadcrumb, url: lp("/glossary/") },
  ]),
  definedTermSet(
    terms.map((term) => ({ name: term.term, description: term.shortAnswer, url: lp(`/glossary/${term.slug}/`) })),
  ),
];
---

<Base
  title={lt.gl_hub_title}
  description={lt.gl_hub_desc}
  ogImage="/og/glossary.png"
  jsonLd={jsonLd}
  lang={lang}
  translated={translated}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-14 sm:py-16">
      <Breadcrumb items={[{ label: t[lang].breadcrumb_home, href: lp("/") }, { label: lt.gl_breadcrumb }]} />
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">{lt.gl_hub_eyebrow}</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          {lt.gl_hub_h1}
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          {lt.gl_hub_sub}
        </p>
      </div>
    </div>
  </section>

  <!-- Terms -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">{lt.gl_hub_terms_h2}</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {terms.map((term) => (
          <li>
            <a
              href={lp(`/glossary/${term.slug}/`)}
              class="group block h-full rounded-xl border border-slate-200 p-6 transition hover:border-[#16161D] hover:shadow-md"
            >
              <h3 class="text-lg font-semibold text-slate-900 group-hover:text-[#16161D]">{term.term}</h3>
              <p class="mt-2 text-sm text-slate-600">{term.shortAnswer}</p>
              <span class="mt-4 inline-flex items-center text-sm font-medium text-[#16161D]">
                {lt.gl_hub_read}
                <svg class="ms-1 h-4 w-4 transition-transform group-hover:translate-x-0.5 rtl:-scale-x-100" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M7.21 4.29a1 1 0 011.42 0l5 5a1 1 0 010 1.42l-5 5a1 1 0 11-1.42-1.42L11.09 10 7.21 6.12a1 1 0 010-1.42z" clip-rule="evenodd" />
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Related guides -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">{lt.gl_hub_guides_h2}</h2>
      <p class="mt-3 max-w-3xl text-slate-700">
        {lt.gl_hub_guides_sub}
      </p>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {guides.map((g) => (
          <li>
            <a
              href={g.external ? g.href : lp(g.href)}
              {...(g.external ? { target: "_blank", rel: "external noopener" } : {})}
              class="group block h-full rounded-xl border border-slate-200 bg-white p-6 transition hover:border-[#16161D] hover:shadow-md"
            >
              <h3 class="text-lg font-semibold text-slate-900 group-hover:text-[#16161D]">{g.label}</h3>
              {g.blurb && <p class="mt-2 text-sm text-slate-600">{g.blurb}</p>}
              <span class="mt-4 inline-flex items-center text-sm font-medium text-[#16161D]">
                {lt.gl_hub_readmore}
                <svg class="ms-1 h-4 w-4 transition-transform group-hover:translate-x-0.5 rtl:-scale-x-100" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M7.21 4.29a1 1 0 011.42 0l5 5a1 1 0 010 1.42l-5 5a1 1 0 11-1.42-1.42L11.09 10 7.21 6.12a1 1 0 010-1.42z" clip-rule="evenodd" />
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        {lt.hub_brands_h2}
      </h2>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SHOPIFY_INSTALL}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          {lt.cta_start_shopify}
        </a>
        <a
          href={WOO_PLUGIN}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          {lt.cta_start_woo}
        </a>
      </div>
    </div>
  </section>
</Base>
