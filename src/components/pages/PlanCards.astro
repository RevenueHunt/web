---
import { PLANS_BY_LANG } from "../../lib/plans";
import { localizedHref, type Lang } from "../../lib/i18n";
import { CHROME, fill } from "../../lib/content/chrome";

interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const plans = PLANS_BY_LANG[lang];
const chrome = CHROME[lang];
const enterprise = fill(chrome.plans_enterprise, { price: "$299/mo." });
const [enterpriseBefore, enterpriseAfter] = enterprise.split("$299/mo.");
---

<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
  {plans.map((plan) => (
    <li>
      <article class="flex h-full flex-col rounded-2xl bg-white p-6 shadow-sm">
        <h3 class="text-sm font-medium text-slate-700">{plan.name}</h3>
        <div class="mt-2 flex items-baseline gap-2">
          <span class="text-4xl font-bold tracking-tight text-slate-900">
            {plan.priceYearly ? (
              <>
                <span data-billing="monthly">{plan.price}</span>
                <span data-billing="yearly" hidden>{plan.priceYearly}</span>
              </>
            ) : (
              <span>{plan.price}</span>
            )}
          </span>
          {plan.priceSuffix && (
            <span class="text-base text-slate-700">{plan.priceSuffix}</span>
          )}
        </div>
        <p class="mt-2 text-sm text-slate-600">
          {plan.priceNoteYearly ? (
            <>
              <span data-billing="monthly">{plan.priceNote}</span>
              <span data-billing="yearly" hidden>{plan.priceNoteYearly}</span>
            </>
          ) : (
            <span>{plan.priceNote}</span>
          )}
        </p>
        <p class="mt-3 text-sm italic text-slate-500">{plan.tagline}</p>

        <hr class="my-5 border-slate-200" />

        <ul class="space-y-2.5 text-sm text-slate-800">
          {plan.features.map((f) => (
            <li class="flex items-start gap-2">
              {f.plus ? (
                <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-slate-400" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <path d="M10 4v12M4 10h12"/>
                </svg>
              ) : (
                <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-slate-900" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="4 11 8 15 16 5"/>
                </svg>
              )}
              <span>
                {f.text}
                {f.link && (
                  <>
                    {" "}
                    <a href={f.link.href} class="font-medium text-slate-900 underline underline-offset-4 hover:text-slate-700">{f.link.label}</a>
                  </>
                )}
              </span>
            </li>
          ))}
        </ul>
      </article>
    </li>
  ))}
</ul>

<p class="mx-auto mt-12 max-w-4xl text-center text-base text-slate-700">
  {enterpriseBefore}<strong class="font-semibold">$299/mo.</strong>{enterpriseAfter}{" "}
  <a href={localizedHref("/demo/", lang)} class="font-semibold text-slate-900 underline underline-offset-4 hover:text-slate-700">{chrome.plans_enterprise_cta}</a>.
</p>
