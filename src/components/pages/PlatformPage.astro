---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { organization, breadcrumb, productWithReviews } from "../../lib/schema";
import { SITE } from "../../lib/site";
import { PLATFORM_CONFIGS, type PlatformConfig } from "../../lib/platforms";
import { SOLUTIONS, FEATURED_SOLUTIONS } from "../../lib/solutions";
import { PLATFORM_REVIEWS } from "../../lib/reviews";
import YouTubeFacade from "../YouTubeFacade.astro";
import Reviews from "../Reviews.astro";

interface Props {
  entry: CollectionEntry<"pages">;
  config: PlatformConfig;
}

const { entry, config } = Astro.props;
const { Content } = await render(entry);

// Sibling platform links - every platform page links to all other platform pages.
// Source of truth: PLATFORM_CONFIGS keyed by slug. Adding a new entry there will
// automatically surface it in every other platform page's sibling block.
const SIBLING_TAGLINES: Record<string, string> = {
  "product-recommendation-quiz-shopify": "Native Shopify app, free plan, instant install",
  "product-recommendation-quiz-woocommerce": "Self-hosted WordPress plugin, no monthly fee",
  "product-recommendation-quiz-bigcommerce": "Native BigCommerce app with deep catalog sync",
  "product-recommendation-quiz-wix-stores": "Embed via universal script - works on any Wix store",
  "product-recommendation-quiz-for-squarespace-commerce": "Embed via universal script - works on any Squarespace site",
  "product-recommendation-quiz-for-magento": "Standalone hosted solution, no Magento extension required",
  "product-recommendation-quiz-standalone-google-product-feed":
    "Platform-agnostic - runs on Google Product Feed, no store integration needed",
  "product-recommendation-quiz-pos-tablet-stands": "In-store quizzes on iPad / Android POS tablets",
  "product-recommendation-quiz":
    "The all-platforms overview - start here if you're comparing options",
};

const currentSlug = entry.data.legacySlug;
const siblings = Object.entries(PLATFORM_CONFIGS)
  .filter(([slug]) => slug !== currentSlug)
  .map(([slug, cfg]) => ({
    slug,
    platform: cfg.platform,
    href: `/${slug}/`,
    tagline: SIBLING_TAGLINES[slug] ?? "",
  }));

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=platform_bottom";
const WOOCOMMERCE_DOWNLOAD =
  "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";

const pillars = [
  {
    image: "/img/pages/home/recommend-right-products.svg",
    title: "Recommend the right products",
    body:
      "Shoppable quizzes drive sales, advise customers on finding the right products for them, and help them make confident purchasing decisions.",
  },
  {
    image: "/img/pages/home/know-your-customers.svg",
    title: "Know your customers",
    body:
      "Quizzes let you collect actionable data by asking your customers targeted questions. Segment and tag your shoppers based on their responses.",
  },
  {
    image: "/img/pages/home/grow-your-audience.svg",
    title: "Grow your audience",
    body:
      "Send captured leads to your mailing list or CRM. Leverage customer profile data to create more personalized, higher ROI marketing campaigns.",
  },
];

const featuredSolutions = FEATURED_SOLUTIONS.map((slug) => SOLUTIONS[slug]!);

const reviews = PLATFORM_REVIEWS[currentSlug] ?? null;

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Home", url: "/" },
    { name: entry.data.title, url: `/${entry.data.legacySlug}/` },
  ]),
  ...(reviews
    ? [
        productWithReviews({
          name: `RevenueHunt Product Recommendation Quiz for ${reviews.platform}`,
          description: entry.data.description ?? SITE.description,
          image: `/og/${currentSlug}.png`,
          url: `/${currentSlug}/`,
          ratingValue: reviews.ratingValue,
          reviewCount: reviews.reviewCount,
          reviews: reviews.reviews.map((r) => ({
            author: r.author,
            quote: r.quote,
            rating: r.rating,
            date: r.date,
          })),
        }),
      ]
    : []),
];

function rel(c: { external?: boolean }) {
  return c.external ? { target: "_blank", rel: "external noopener" } : {};
}
---

<Base
  title={`${entry.data.title} - ${SITE.name}`}
  description={entry.data.description}
  ogImage={entry.data.featuredImage ?? undefined}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-7xl px-6 py-16 lg:py-20">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-slate-700">Home</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">{config.platform}</span>
      </nav>

      <div class={`grid items-center gap-12 ${config.youtubeId ? "lg:grid-cols-2 lg:gap-16" : ""}`}>
        <div>
          <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
            {entry.data.title}
          </h1>
          {entry.data.description && (
            <p class="mt-6 max-w-xl text-lg text-slate-700">{entry.data.description}</p>
          )}
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={config.primary.href}
              {...rel(config.primary)}
              onclick={config.primary.gtagEvent
                ? `window.gtag&&gtag('event','${config.primary.gtagEvent}',{cta_location:'${config.platform}_hero'})`
                : undefined}
              class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
            >
              {config.primary.label}
            </a>
            {config.secondary && (
              <a
                href={config.secondary.href}
                {...rel(config.secondary)}
                class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
              >
                {config.secondary.label}
              </a>
            )}
          </div>
          <p class="mt-4 text-sm text-slate-500">
            Free plan available · 15-day free trial · 30-day money-back guarantee
          </p>
        </div>

        {config.youtubeId && (
          <div>
            <div class="aspect-video overflow-hidden rounded-xl bg-slate-900 shadow-2xl">
              <YouTubeFacade id={config.youtubeId} title={`${entry.data.title} - video tour`} />
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- 3-up pillars -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-16 sm:py-20">
      <div class="grid gap-10 md:grid-cols-3">
        {pillars.map((p) => (
          <div class="text-center">
            <img src={p.image} alt={p.title} width="120" height="120" class="mx-auto h-24 w-24" loading="lazy" />
            <h2 class="mt-6 text-xl font-semibold text-slate-900">{p.title}</h2>
            <p class="mt-3 text-slate-600">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Page body content (from MD) -->
  <div class="mx-auto max-w-5xl px-6 py-16">
    <article class="platform-prose prose prose-slate prose-lg max-w-none
      prose-headings:tracking-tight prose-headings:text-slate-900
      prose-h2:mt-16 prose-h2:text-3xl prose-h2:font-bold prose-h2:border-b prose-h2:border-slate-200 prose-h2:pb-3
      prose-h3:mt-16 prose-h3:text-3xl prose-h3:font-bold prose-h3:border-b prose-h3:border-slate-200 prose-h3:pb-3
      prose-h4:mt-10 prose-h4:text-xl prose-h4:font-semibold
      prose-h5:mt-8 prose-h5:text-base prose-h5:font-semibold prose-h5:uppercase prose-h5:tracking-wider prose-h5:text-slate-500
      prose-h6:mt-8 prose-h6:text-sm prose-h6:font-semibold prose-h6:uppercase prose-h6:tracking-wider prose-h6:text-slate-500
      prose-p:text-slate-700
      prose-img:rounded-lg prose-img:my-6
      prose-a:text-slate-900 prose-a:underline-offset-4 hover:prose-a:text-slate-700
      prose-strong:text-slate-900">
      <Content />
    </article>
  </div>

  {config.showComparison && (
    <section class="bg-white">
      <div class="mx-auto max-w-5xl px-6 py-16">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">How we compare</h2>
        <p class="mt-4 text-slate-700">
          RevenueHunt vs. Octane AI vs. Quiz Kit - the features that matter for serious eCommerce stores.
        </p>
        <div class="mt-8 overflow-x-auto rounded-xl border border-slate-200">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-slate-900">
              <tr>
                <th class="px-4 py-3 font-semibold">Feature</th>
                <th class="px-4 py-3 text-center font-semibold">RevenueHunt</th>
                <th class="px-4 py-3 text-center font-semibold">Quiz Kit</th>
                <th class="px-4 py-3 text-center font-semibold">Octane AI</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 text-slate-700">
              <tr><td class="px-4 py-3">Klaviyo / Mailchimp integration</td><td class="px-4 py-3 text-center">✓</td><td class="px-4 py-3 text-center">✓</td><td class="px-4 py-3 text-center">✓</td></tr>
              <tr><td class="px-4 py-3">Conditional / branching logic</td><td class="px-4 py-3 text-center">✓</td><td class="px-4 py-3 text-center">✓</td><td class="px-4 py-3 text-center">✓</td></tr>
              <tr><td class="px-4 py-3">AI quiz builder (60-second setup)</td><td class="px-4 py-3 text-center">✓</td><td class="px-4 py-3 text-center text-slate-400"> - </td><td class="px-4 py-3 text-center">✓</td></tr>
              <tr><td class="px-4 py-3">Built for Shopify</td><td class="px-4 py-3 text-center">✓</td><td class="px-4 py-3 text-center">✓</td><td class="px-4 py-3 text-center text-slate-400"> - </td></tr>
              <tr><td class="px-4 py-3">Drop-off analytics</td><td class="px-4 py-3 text-center">✓</td><td class="px-4 py-3 text-center text-slate-400"> - </td><td class="px-4 py-3 text-center">✓</td></tr>
              <tr><td class="px-4 py-3">WooCommerce &amp; other platforms</td><td class="px-4 py-3 text-center">✓</td><td class="px-4 py-3 text-center text-slate-400"> - </td><td class="px-4 py-3 text-center text-slate-400"> - </td></tr>
              <tr><td class="px-4 py-3">Free plan available</td><td class="px-4 py-3 text-center">✓</td><td class="px-4 py-3 text-center text-slate-400"> - </td><td class="px-4 py-3 text-center text-slate-400"> - </td></tr>
              <tr><td class="px-4 py-3 font-semibold">Starting price</td><td class="px-4 py-3 text-center font-semibold">Free</td><td class="px-4 py-3 text-center">$59/mo</td><td class="px-4 py-3 text-center">$50/mo</td></tr>
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-xs text-slate-500">Comparison based on publicly available information as of 2026.</p>
      </div>
    </section>
  )}

  <!-- Available for every platform - sibling links -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-16 sm:py-20">
      <div class="max-w-3xl">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          Available for every platform
        </h2>
        <p class="mt-4 text-slate-700">
          Not on {config.platform}? RevenueHunt's product recommendation quiz works wherever you sell - pick your stack.
        </p>
      </div>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {siblings.map((s) => (
          <li>
            <a
              href={s.href}
              class="group block h-full rounded-xl border border-slate-200 bg-white p-6 transition hover:border-[#16161D] hover:shadow-md"
            >
              <h3 class="text-lg font-semibold text-slate-900 group-hover:text-[#16161D]">
                Product recommendation quiz for {s.platform}
              </h3>
              {s.tagline && (
                <p class="mt-2 text-sm text-slate-600">{s.tagline}</p>
              )}
              <span class="mt-4 inline-flex items-center text-sm font-medium text-[#16161D]">
                See {s.platform} page
                <svg
                  class="ml-1 h-4 w-4 transition-transform group-hover:translate-x-0.5"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path fill-rule="evenodd" d="M7.21 4.29a1 1 0 011.42 0l5 5a1 1 0 010 1.42l-5 5a1 1 0 11-1.42-1.42L11.09 10 7.21 6.12a1 1 0 010-1.42z" clip-rule="evenodd" />
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Quiz solutions by industry & quiz type -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-16 sm:py-20">
      <div class="max-w-3xl">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          A quiz for your industry
        </h2>
        <p class="mt-4 text-slate-700">
          However you sell on {config.platform}, build the quiz that fits your catalog. Explore solutions by industry and quiz type.
        </p>
      </div>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {featuredSolutions.map((s) => (
          <li>
            <a
              href={`/solutions/${s.slug}/`}
              class="group block h-full rounded-xl border border-slate-200 bg-white p-5 transition hover:border-[#16161D] hover:shadow-md"
            >
              <h3 class="text-base font-semibold text-slate-900 group-hover:text-[#16161D]">{s.name}</h3>
              <span class="mt-3 inline-flex items-center text-sm font-medium text-[#16161D]">
                View solution
                <svg class="ml-1 h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M7.21 4.29a1 1 0 011.42 0l5 5a1 1 0 010 1.42l-5 5a1 1 0 11-1.42-1.42L11.09 10 7.21 6.12a1 1 0 010-1.42z" clip-rule="evenodd" />
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <a href="/solutions/" class="mt-8 inline-flex items-center text-sm font-semibold text-[#16161D]">
        See all quiz solutions
        <span aria-hidden="true" class="ml-1">→</span>
      </a>
    </div>
  </section>

  {reviews && (
    <Reviews
      data={reviews}
      heading={`Rated ${reviews.ratingValue} by ${config.platform} merchants`}
      bg="bg-slate-50"
    />
  )}

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-white/70">
        Most shoppers leave because they can't find the right product
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Turn shoppers into confident buyers with a Product Recommendation Quiz that drives sales.
      </h2>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SHOPIFY_INSTALL}
          target="_blank"
          rel="external noopener nofollow"
          onclick={`window.gtag&&gtag('event','shopify_app_install',{cta_location:'${config.platform}_bottom'})`}
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          install on Shopify
        </a>
        <a
          href={WOOCOMMERCE_DOWNLOAD}
          target="_blank"
          rel="external noopener nofollow"
          onclick={`window.gtag&&gtag('event','download_woocommerce_plugin',{cta_location:'${config.platform}_bottom'})`}
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          get for WooCommerce
        </a>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  /* The scraped MD body for platform pages opens with an iframe + CTA links
     that duplicate the hero. Hide them in this layout - the hero owns the CTAs. */
  .platform-prose iframe { display: none; }
</style>
