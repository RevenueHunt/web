---
import Base from "../../layouts/Base.astro";
import { organization, breadcrumb, softwareApplication, faqPage } from "../../lib/schema";
import {
  SOLUTIONS_BY_LANG,
  VERTICAL_ORDER,
  USECASE_ORDER,
  type Solution,
} from "../../lib/solutions";
import { t, type Lang, localizedHref } from "../../lib/i18n";
import { LT, fillLT } from "../../lib/content/longtail";

interface Props {
  solution: Solution;
  lang?: Lang;
  translated?: boolean;
}

const { solution, lang = "en", translated = false } = Astro.props;
const s = solution;
const lt = LT[lang];
const lp = (path: string) => localizedHref(path, lang);
const url = lp(`/solutions/${s.slug}/`);
// Lowercase reads naturally in English headings; other languages keep the
// data-provided casing (German nouns must stay capitalized).
const nameLc = lang === "en" ? s.name.toLowerCase() : s.name;

const SHOPIFY_INSTALL = `https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=solutions_${s.slug.replace(/-/g, "_")}`;
// Free WordPress.org plugin (not the WooCommerce.com extension).
const WOO_PLUGIN = "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";
const DEMO_STORE_HOME =
  "https://productrecommendationquiz.com/?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=solutions";
const heroDemoHref = s.demo?.href ?? DEMO_STORE_HOME;

// Sibling solutions of the same type, for the "explore more" grid.
const localeSolutions = SOLUTIONS_BY_LANG[lang];
const siblingSlugs = (s.type === "vertical" ? VERTICAL_ORDER : USECASE_ORDER).filter(
  (slug) => slug !== s.slug,
);
const siblings = siblingSlugs.map((slug) => localeSolutions[slug]!);
const siblingHeading = s.type === "vertical" ? lt.sol_more_industries : lt.sol_more_quiztypes;

// Aggregate proof numbers (product-compendium.md, headline-safe).
const PROOF = [
  { stat: "20,000+", label: lt.sol_proof_brands },
  { stat: "45M+", label: lt.sol_proof_quizzes },
  { stat: "$370M+", label: lt.sol_proof_revenue },
  { stat: "4.9★", label: lt.sol_proof_reviews },
];

// What every RevenueHunt quiz includes (shared capability band).
const CAPABILITIES = lt.sol_caps;

const jsonLd = [
  organization(),
  softwareApplication(),
  breadcrumb([
    { name: t[lang].breadcrumb_home, url: lp("/") },
    { name: lt.sol_breadcrumb, url: lp("/solutions/") },
    { name: s.name, url },
  ]),
  faqPage(s.faqs),
];
---

<Base
  title={s.title}
  description={s.description}
  ogImage={`/og/solutions-${s.slug}.png`}
  jsonLd={jsonLd}
  lang={lang}
  translated={translated}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={lp("/")} class="hover:text-slate-700">{t[lang].breadcrumb_home}</a>
        <span class="mx-2 text-slate-300">/</span>
        <a href={lp("/solutions/")} class="hover:text-slate-700">{lt.sol_breadcrumb}</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">{s.name}</span>
      </nav>
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">
          {lt.sol_eyebrow} · {s.chip}
        </p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">{s.h1}</h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">{s.heroSubtitle}</p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
          <a
            href={SHOPIFY_INSTALL}
            target="_blank"
            rel="external noopener nofollow"
            data-install={`solutions_${s.slug}`}
            class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
          >
            {lt.cta_start_shopify}
          </a>
          <a
            href={heroDemoHref}
            target="_blank"
            rel="external noopener"
            class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
          >
            {lt.sol_cta_demo}
          </a>
        </div>
        <p class="mt-4 text-sm text-slate-500">
          {lt.trial_note}
        </p>
      </div>
    </div>
  </section>

  <!-- Proof band -->
  <section class="border-y border-slate-200 bg-white">
    <dl class="mx-auto grid max-w-5xl grid-cols-2 gap-px bg-slate-200 sm:grid-cols-4">
      {PROOF.map((p) => (
        <div class="bg-white px-6 py-8 text-center">
          <dt class="text-3xl font-bold tracking-tight text-slate-900">{p.stat}</dt>
          <dd class="mt-1 text-sm text-slate-600">{p.label}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Intro / answer-first framing -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-6 py-14">
      <div class="space-y-5 text-lg text-slate-700">
        {s.intro.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <!-- Popular quiz types -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        {fillLT(lt.sol_quiztypes_h2, { name: nameLc })}
      </h2>
      <p class="mt-4 text-slate-700">{lt.sol_quiztypes_sub}</p>
      <div class="mt-10 grid gap-8 md:grid-cols-2">
        {s.quizTypes.map((q) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6">
            <h3 class="text-lg font-semibold text-slate-900">{q.title}</h3>
            <p class="mt-3 text-slate-600">{q.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it helps -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        {fillLT(lt.sol_howhelps_h2, { name: nameLc })}
      </h2>
      <div class="mt-8 space-y-5 text-lg text-slate-700">
        {s.howItHelps.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <!-- Live demo -->
  {s.demo && (
    <section class="bg-slate-50">
      <div class="mx-auto max-w-3xl px-6 py-14">
        <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center">
          <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">{lt.sol_seeitlive}</p>
          <p class="mt-3 text-lg text-slate-700">{s.demo.blurb}</p>
          <a
            href={s.demo.href}
            target="_blank"
            rel="external noopener"
            class="mt-6 inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
          >
            {s.demo.label}
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- Capability band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        {lt.sol_caps_h2}
      </h2>
      <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {CAPABILITIES.map((c) => (
          <div class="rounded-xl border border-slate-200 p-6">
            <h3 class="text-lg font-semibold text-slate-900">{c.title}</h3>
            <p class="mt-3 text-sm text-slate-600">{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900">{lt.faq_h2}</h2>
      <div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
        {s.faqs.map((faq) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-lg font-semibold text-slate-900 [&::-webkit-details-marker]:hidden">
              <span>{faq.question}</span>
              <svg
                class="h-5 w-5 flex-shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <p class="pb-5 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Related + siblings -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">{lt.sol_related_h2}</h2>
      <ul class="mt-8 flex flex-wrap gap-3" role="list">
        {s.related.map((r) => (
          <li>
            <a
              href={r.href}
              {...(r.external ? { target: "_blank", rel: "external noopener" } : {})}
              class="inline-flex items-center rounded-full border border-slate-200 px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-[#16161D] hover:text-[#16161D]"
            >
              {r.label}
            </a>
          </li>
        ))}
      </ul>

      <h2 class="mt-14 text-2xl font-bold tracking-tight text-slate-900">{siblingHeading}</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {siblings.map((sib) => (
          <li>
            <a
              href={lp(`/solutions/${sib.slug}/`)}
              class="group block h-full rounded-xl border border-slate-200 p-6 transition hover:border-[#16161D] hover:shadow-md"
            >
              <h3 class="text-base font-semibold text-slate-900 group-hover:text-[#16161D]">{sib.name}</h3>
              <span class="mt-3 inline-flex items-center text-sm font-medium text-[#16161D]">
                {lt.sol_view}
                <svg class="ms-1 h-4 w-4 transition-transform group-hover:translate-x-0.5 rtl:-scale-x-100" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M7.21 4.29a1 1 0 011.42 0l5 5a1 1 0 010 1.42l-5 5a1 1 0 11-1.42-1.42L11.09 10 7.21 6.12a1 1 0 010-1.42z" clip-rule="evenodd" />
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-white/70">
        {lt.cta_kicker}
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        {lt.cta_h2}
      </h2>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SHOPIFY_INSTALL}
          target="_blank"
          rel="external noopener nofollow"
          data-install={`solutions_${s.slug}_bottom`}
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          {lt.cta_start_shopify}
        </a>
        <a
          href={WOO_PLUGIN}
          target="_blank"
          rel="external noopener nofollow"
          onclick={`window.gtag&&gtag('event','woocommerce_plugin_click',{event_label:'solutions_${s.slug}_bottom'})`}
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          {lt.cta_start_woo}
        </a>
      </div>
    </div>
  </section>
</Base>
