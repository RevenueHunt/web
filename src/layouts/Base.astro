---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, ogImageForPath } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: unknown;
  /** Set false on landing pages that have their own chrome. */
  showChrome?: boolean;
}

const {
  title,
  description = SITE.description,
  ogImage = ogImageForPath(Astro.url.pathname) ?? "/og-default.png",
  noindex = false,
  jsonLd,
  showChrome = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.site_url).href;

// Analytics only on the production domain - keeps the web.revenuehunt.com
// staging build out of GA4/GTM. Matches prod wiring: GA4 via gtag.js
// (G-62LE891EM2, was Google Site Kit) + GTM container (GTM-TDNVZDJ).
const isProd = SITE.site_url === "https://revenuehunt.com";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(ogImage, SITE.site_url).href} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, SITE.site_url).href} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} blog`} href="/feed.xml" />

    {jsonLd && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    {isProd && (
      <>
        <!-- Google tag (gtag.js) - GA4 -->
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-62LE891EM2"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag("js", new Date());
          gtag("config", "G-62LE891EM2");
        </script>
        <!-- Google Tag Manager -->
        <script is:inline>
          (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({"gtm.start":new Date().getTime(),event:"gtm.js"});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!="dataLayer"?"&l="+l:"";j.async=true;j.src="https://www.googletagmanager.com/gtm.js?id="+i+dl;f.parentNode.insertBefore(j,f);})(window,document,"script","dataLayer","GTM-TDNVZDJ");
        </script>
      </>
    )}
  </head>
  <body class="font-sans bg-white text-slate-900 antialiased">
    {isProd && (
      <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TDNVZDJ" height="0" width="0" style="display:none;visibility:hidden"></iframe>
      </noscript>
    )}
    {showChrome && <Header />}
    <slot />
    {showChrome && <Footer />}

    <script>
      // Generic carousel - mirrors the legacy theme's initCarousel: native
      // scroll-snap, one-slide paging, JS-built dots, autoplay + cycle.
      // Markup: .rh-carousel > [data-carousel] (track) + [data-carousel-dots].
      // Slide widths + dot styles live in global.css. Optional data-autoplay (ms).
      // Without JS the strip still scrolls - dots + autoplay are enhancement.
      function initRhCarousels() {
        document.querySelectorAll<HTMLElement>(".rh-carousel").forEach((root) => {
          if (root.dataset.carouselReady) return;
          const track = root.querySelector<HTMLElement>("[data-carousel]");
          const dots = root.querySelector<HTMLElement>("[data-carousel-dots]");
          const slides = track ? ([...track.children] as HTMLElement[]) : [];
          if (!track || !slides.length) return;
          root.dataset.carouselReady = "1";

          const autoplayMs = Number(root.dataset.autoplay) || 8000;
          const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          let pages = -1;
          let timer: ReturnType<typeof setInterval> | undefined;

          const gap = () => parseFloat(getComputedStyle(track).columnGap) || 0;
          const slideWidth = () => slides[0].offsetWidth + gap();
          const visibleCount = () => Math.max(1, Math.round(track.clientWidth / slideWidth()));
          const activeIndex = () => Math.round(track.scrollLeft / slideWidth());

          const sync = () => {
            if (!dots) return;
            const a = activeIndex();
            [...dots.children].forEach((d, i) => d.classList.toggle("is-active", i === a));
          };
          const goTo = (i: number) =>
            track.scrollTo({ left: i * slideWidth(), behavior: "smooth" });
          const advance = () => {
            const last = slides.length - visibleCount();
            const i = activeIndex();
            goTo(i < last ? i + 1 : 0);
          };
          const stop = () => {
            if (timer) clearInterval(timer);
            timer = undefined;
          };
          const start = () => {
            stop();
            if (!reduceMotion && pages > 1) timer = setInterval(advance, autoplayMs);
          };
          const build = () => {
            const n = Math.max(1, slides.length - visibleCount() + 1);
            if (n !== pages) {
              pages = n;
              if (dots) {
                dots.innerHTML = "";
                for (let i = 0; i < n; i++) {
                  const b = document.createElement("button");
                  b.type = "button";
                  b.className = "rh-carousel__dot";
                  b.setAttribute("aria-label", `Go to slide ${i + 1}`);
                  b.addEventListener("click", () => {
                    goTo(i);
                    start();
                  });
                  dots.appendChild(b);
                }
              }
            }
            sync();
          };

          track.addEventListener("scroll", () => requestAnimationFrame(sync), { passive: true });
          window.addEventListener("resize", build);
          root.addEventListener("pointerenter", stop);
          root.addEventListener("pointerleave", start);
          root.addEventListener("focusin", stop);
          root.addEventListener("focusout", start);
          track.addEventListener("touchstart", stop, { passive: true });

          build();
          start();
        });
      }
      initRhCarousels();
    </script>
  </body>
</html>
