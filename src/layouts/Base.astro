---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, ogImageForPath } from "../lib/site";
import { type Lang, LANGS, OG_LOCALE, altLangUrl } from "../lib/i18n";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: unknown;
  /** Set false on landing pages that have their own chrome. */
  showChrome?: boolean;
  /** Page locale. Drives <html lang>, og:locale, and the header/footer copy. */
  lang?: Lang;
  /** True when this page has equivalents in every locale (in-scope pages). Emits
   *  hreflang alternates + x-default. Leave false for English-only pages (blog,
   *  legal) so we never advertise URLs that don't exist. */
  translated?: boolean;
}

const {
  title,
  description = SITE.description,
  ogImage = ogImageForPath(Astro.url.pathname) ?? "/og-default.png",
  noindex = false,
  jsonLd,
  showChrome = true,
  lang = "en",
  translated = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.site_url).href;

// hreflang alternates: one per locale (incl. self) plus x-default → English.
const alternates = translated
  ? LANGS.map((l) => ({
      lang: l,
      href: new URL(altLangUrl(Astro.url.pathname, l), SITE.site_url).href,
    }))
  : [];
const xDefault = translated
  ? new URL(altLangUrl(Astro.url.pathname, "en"), SITE.site_url).href
  : null;

// Index + analytics are ON by default - site_url defaults to the production
// domain (lib/site.ts), so a live build is indexable without any env var.
// A staging build opts OUT by setting PUBLIC_SITE_URL to its own host
// (e.g. https://web.revenuehunt.com). import.meta.env.PROD keeps `astro dev`
// out of GA4/GTM. Prod wiring: GA4 gtag.js (G-62LE891EM2) + GTM (GTM-TDNVZDJ).
const isProd = import.meta.env.PROD && SITE.site_url === "https://revenuehunt.com";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Language memory + auto-detect (mirrors MetricSpot). On inner pages the
        visited URL wins and we just remember its locale in the rh_lang cookie.
        On the apex (/) only, redirect to the saved / browser-preferred locale.
        Runs early so the homepage redirect happens before paint. hreflang and
        per-page canonicals are unaffected. */}
    <script is:inline>
      (function () {
        var SUPPORTED = ["en", "es", "fr", "de", "pt", "it"];
        var PREFIXES = { en: "", es: "/es", fr: "/fr", de: "/de", pt: "/pt", it: "/it" };
        function readCookie(name) {
          var m = document.cookie.match(new RegExp("(?:^|; )" + name + "=([^;]+)"));
          return m ? decodeURIComponent(m[1]) : null;
        }
        function writeCookie(value) {
          var attrs = "rh_lang=" + value + "; Path=/; Max-Age=31536000; SameSite=Lax";
          if (location.protocol === "https:") attrs += "; Secure";
          document.cookie = attrs;
        }
        function currentLocale(path) {
          for (var i = 0; i < SUPPORTED.length; i++) {
            var l = SUPPORTED[i];
            if (l === "en") continue;
            var p = PREFIXES[l];
            if (path === p || path === p + "/" || path.indexOf(p + "/") === 0) return l;
          }
          return "en";
        }
        function swapLocale(path, target) {
          var stripped = path;
          for (var i = 0; i < SUPPORTED.length; i++) {
            var l = SUPPORTED[i];
            if (l === "en") continue;
            var p = PREFIXES[l];
            if (stripped === p) { stripped = "/"; break; }
            if (stripped.indexOf(p + "/") === 0) { stripped = stripped.slice(p.length); break; }
          }
          if (target === "en") return stripped === "" ? "/" : stripped;
          var tp = PREFIXES[target];
          return stripped === "/" ? tp + "/" : tp + stripped;
        }
        function detectFromBrowser() {
          var langs = (navigator.languages && navigator.languages.length) ? navigator.languages : [navigator.language || "en"];
          for (var i = 0; i < langs.length; i++) {
            var tag = (langs[i] || "").toLowerCase().split("-")[0];
            if (SUPPORTED.indexOf(tag) !== -1) return tag;
          }
          return "en";
        }
        var path = location.pathname;
        var current = currentLocale(path);
        var cookie = readCookie("rh_lang");
        if (path !== "/" && path !== "") {
          if (cookie !== current) writeCookie(current);
          return;
        }
        var preferred = (cookie && SUPPORTED.indexOf(cookie) !== -1) ? cookie : detectFromBrowser();
        if (preferred !== "en") {
          writeCookie(preferred);
          location.replace(swapLocale(path, preferred) + location.search + location.hash);
          return;
        }
        if (!cookie) writeCookie("en");
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {(noindex || !isProd) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.lang} href={a.href} />
    ))}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <meta name="google-site-verification" content="ndBR1A0ofVyaMGneJb5xHEqI1BFSKBZZPUzM8DdGDiE" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(ogImage, SITE.site_url).href} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, SITE.site_url).href} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#16161D" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} blog`} href="/feed.xml" />

    {jsonLd && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    {isProd && (
      <>
        <!-- Google tag (gtag.js) - GA4 -->
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-62LE891EM2"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag("js", new Date());
          gtag("config", "G-62LE891EM2");
          gtag("config", "AW-391009741");
        </script>
        <!-- Google Tag Manager -->
        <script is:inline>
          (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({"gtm.start":new Date().getTime(),event:"gtm.js"});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!="dataLayer"?"&l="+l:"";j.async=true;j.src="https://www.googletagmanager.com/gtm.js?id="+i+dl;f.parentNode.insertBefore(j,f);})(window,document,"script","dataLayer","GTM-TDNVZDJ");
        </script>
      </>
    )}
  </head>
  <body class="font-sans bg-white text-slate-900 antialiased">
    {isProd && (
      <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TDNVZDJ" height="0" width="0" style="display:none;visibility:hidden"></iframe>
      </noscript>
    )}
    {showChrome && <Header lang={lang} translated={translated} />}
    <main>
      <slot />
    </main>
    {showChrome && <Footer lang={lang} />}

    <script>
      // Generic carousel - mirrors the legacy theme's initCarousel: native
      // scroll-snap, one-slide paging, JS-built dots, autoplay + cycle.
      // Markup: .rh-carousel > [data-carousel] (track) + [data-carousel-dots].
      // Slide widths + dot styles live in global.css. Optional data-autoplay (ms).
      // Without JS the strip still scrolls - dots + autoplay are enhancement.
      function initRhCarousels() {
        document.querySelectorAll<HTMLElement>(".rh-carousel").forEach((root) => {
          if (root.dataset.carouselReady) return;
          const track = root.querySelector<HTMLElement>("[data-carousel]");
          const dots = root.querySelector<HTMLElement>("[data-carousel-dots]");
          const slides = track ? ([...track.children] as HTMLElement[]) : [];
          if (!track || !slides.length) return;
          root.dataset.carouselReady = "1";

          const autoplayMs = Number(root.dataset.autoplay) || 8000;
          const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          let pages = -1;
          let timer: ReturnType<typeof setInterval> | undefined;

          const gap = () => parseFloat(getComputedStyle(track).columnGap) || 0;
          const slideWidth = () => slides[0].offsetWidth + gap();
          const visibleCount = () => Math.max(1, Math.round(track.clientWidth / slideWidth()));
          const activeIndex = () => Math.round(track.scrollLeft / slideWidth());

          const sync = () => {
            if (!dots) return;
            const a = activeIndex();
            [...dots.children].forEach((d, i) => d.classList.toggle("is-active", i === a));
          };
          const goTo = (i: number) =>
            track.scrollTo({ left: i * slideWidth(), behavior: "smooth" });
          const advance = () => {
            const last = slides.length - visibleCount();
            const i = activeIndex();
            goTo(i < last ? i + 1 : 0);
          };
          const stop = () => {
            if (timer) clearInterval(timer);
            timer = undefined;
          };
          const start = () => {
            stop();
            if (!reduceMotion && pages > 1) timer = setInterval(advance, autoplayMs);
          };
          const build = () => {
            const n = Math.max(1, slides.length - visibleCount() + 1);
            if (n !== pages) {
              pages = n;
              if (dots) {
                dots.innerHTML = "";
                for (let i = 0; i < n; i++) {
                  const b = document.createElement("button");
                  b.type = "button";
                  b.className = "rh-carousel__dot";
                  b.setAttribute("aria-label", `Go to slide ${i + 1}`);
                  b.addEventListener("click", () => {
                    goTo(i);
                    start();
                  });
                  dots.appendChild(b);
                }
              }
            }
            sync();
          };

          track.addEventListener("scroll", () => requestAnimationFrame(sync), { passive: true });
          window.addEventListener("resize", build);
          root.addEventListener("pointerenter", stop);
          root.addEventListener("pointerleave", start);
          root.addEventListener("focusin", stop);
          root.addEventListener("focusout", start);
          track.addEventListener("touchstart", stop, { passive: true });

          build();
          start();
        });
      }
      initRhCarousels();

      // YouTube facades (hero + in-content): swap the poster for the real
      // nocookie embed on click. Markup is emitted by YouTubeFacade.astro and
      // by the migrated blog markdown; this handler is global so both work.
      document.querySelectorAll<HTMLButtonElement>("button.yt-facade").forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = btn.dataset.ytId;
          if (!id) return;
          const iframe = document.createElement("iframe");
          iframe.src = `https://www.youtube-nocookie.com/embed/${id}?rel=0&autoplay=1`;
          iframe.title =
            btn.getAttribute("aria-label")?.replace(/^Play video:?\s*/, "") || "YouTube video";
          iframe.allow =
            "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
          iframe.allowFullscreen = true;
          iframe.className = "h-full w-full";
          btn.replaceWith(iframe);
        });
      });
    </script>
  </body>
</html>
