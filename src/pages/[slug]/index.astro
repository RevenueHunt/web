---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { article, breadcrumb, organization } from "../../lib/schema";
import { SITE } from "../../lib/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  const pages = await getCollection("pages", ({ data }) => !data.draft);

  const postPaths = posts.map((post) => ({
    params: { slug: post.data.legacySlug },
    props: { entry: post, kind: "blog" as const },
  }));
  // Pages that are explicitly handled by hand-built Astro routes elsewhere.
  const explicitlyOverridden = new Set(["home", "blog"]);
  const pagePaths = pages
    .filter((p) => !explicitlyOverridden.has(p.data.legacySlug))
    .map((page) => ({
      params: { slug: page.data.legacySlug },
      props: { entry: page, kind: "page" as const },
    }));
  return [...postPaths, ...pagePaths];
}

const { entry, kind } = Astro.props;
const { Content } = await render(entry);

const url = `${SITE.site_url}/${entry.data.legacySlug}/`;
const jsonLd =
  kind === "blog"
    ? [
        article({
          title: entry.data.title,
          description: entry.data.description ?? "",
          url,
          image: entry.data.featuredImage,
          datePublished: entry.data.pubDate,
          dateModified: entry.data.updatedDate ?? entry.data.pubDate,
          author: entry.data.author,
          tags: entry.data.tags,
        }),
        breadcrumb([
          { name: "Home", url: "/" },
          { name: "Blog", url: "/blog/" },
          { name: entry.data.title, url: `/${entry.data.legacySlug}/` },
        ]),
      ]
    : [organization(), breadcrumb([
        { name: "Home", url: "/" },
        { name: entry.data.title, url: `/${entry.data.legacySlug}/` },
      ])];

function fmt(d: Date) {
  return d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
}
---

<Base
  title={`${entry.data.title} — ${SITE.name}`}
  description={entry.data.description}
  ogImage={entry.data.featuredImage ?? undefined}
  jsonLd={jsonLd}
>
  <main class="mx-auto max-w-3xl px-6 py-16">
    {kind === "blog" && (
      <p class="mb-4 text-sm font-medium uppercase tracking-wider text-slate-500">
        <a href="/blog/" class="hover:text-slate-700">← Blog</a>
      </p>
    )}
    <article>
      <header class="mb-10">
        <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">{entry.data.title}</h1>
        {entry.data.description && (
          <p class="mt-4 text-xl text-slate-600">{entry.data.description}</p>
        )}
        {kind === "blog" && "pubDate" in entry.data && (
          <p class="mt-4 text-sm text-slate-500">
            {fmt(entry.data.pubDate as Date)}
            {"author" in entry.data && entry.data.author && ` · ${entry.data.author}`}
          </p>
        )}
        {entry.data.featuredImage && (
          <img
            src={entry.data.featuredImage}
            alt=""
            class="mt-8 w-full rounded-lg object-cover"
          />
        )}
      </header>
      <div class="prose prose-slate max-w-none prose-img:rounded-lg prose-a:text-slate-900 prose-a:underline-offset-4 hover:prose-a:text-slate-700">
        <Content />
      </div>
    </article>
  </main>
</Base>
