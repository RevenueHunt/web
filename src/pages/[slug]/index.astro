---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import ContentPage from "../../components/pages/ContentPage.astro";
import ResourceCards from "../../components/ResourceCards.astro";
import { article, breadcrumb } from "../../lib/schema";
import { SITE } from "../../lib/site";
import {
  categoryHref,
  normalizeName,
  postHref,
  prevNext,
  readingTime,
  relatedPosts,
  tagHref,
} from "../../lib/blog";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  const allPages = await getCollection("pages", ({ data }) => !data.draft);
  // English pages render here; translations render under their /<lang>/[slug] route.
  const pages = allPages.filter((p) => p.data.lang === "en");
  // A slug is "translated" when a non-English version of it exists → its English
  // page advertises hreflang alternates.
  const translatedSlugs = new Set(
    allPages.filter((p) => p.data.lang !== "en").map((p) => p.data.legacySlug),
  );

  const sorted = posts
    .slice()
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

  const postPaths = posts.map((post) => ({
    params: { slug: post.data.legacySlug },
    props: { entry: post, kind: "blog" as const, allPosts: sorted, translated: false },
  }));
  // Pages with hand-built bespoke routes elsewhere - skip in the catch-all.
  const explicitlyOverridden = new Set([
    "home",
    "blog",
    "integrations",
    "pricing",
    "demo",
    "newsletter",
    "sign-up",
    "message-sent",
    "jobs",
    // Job postings render under their /jobs/<slug>/ route (src/pages/jobs/).
    "technical-customer-support",
    "marketing-sales-funnel-architect",
    "whats-new",
    "why-your-traffic-isnt-converting",
    "testimonials",
    "templates",
    "for-beauty-brands",
    "partners",
    "contact",
    "quiz-readiness-assessment",
    "ecommerce-quiz",
  ]);
  const pagePaths = pages
    .filter((p) => !explicitlyOverridden.has(p.data.legacySlug))
    .map((page) => ({
      params: { slug: page.data.legacySlug },
      props: {
        entry: page,
        kind: "page" as const,
        allPosts: [],
        translated: translatedSlugs.has(page.data.legacySlug),
      },
    }));
  return [...postPaths, ...pagePaths];
}

const { entry, kind, allPosts, translated = false } = Astro.props;

// Blog posts render their full article in this file; non-blog `pages` entries
// delegate to <ContentPage> (which also handles the bespoke platform layout).
const isBlog = kind === "blog";
const { Content, headings } = await render(entry);

const url = `${SITE.site_url}/${entry.data.legacySlug}/`;

// Blog-specific derived data
const blogEntry = isBlog ? entry : null;
const primaryCategoryRaw = blogEntry?.data.categories?.[0] ?? null;
const primaryCategory = primaryCategoryRaw ? normalizeName(primaryCategoryRaw) : null;
const blogRaw = isBlog ? blogEntry!.body ?? "" : "";
const minutes = isBlog ? readingTime(blogRaw) : 0;
const related = isBlog ? relatedPosts(blogEntry!, allPosts as Awaited<ReturnType<typeof getCollection<"blog">>>, 3) : [];
const navAdj = isBlog ? prevNext(blogEntry!, allPosts as Awaited<ReturnType<typeof getCollection<"blog">>>) : { prev: null, next: null };
const tocHeadings = isBlog ? (headings ?? []).filter((h) => h.depth === 2 || h.depth === 3) : [];

// Author initials - placeholder avatar until real avatars exist.
function initials(name: string): string {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((p) => p[0]!.toUpperCase())
    .join("");
}

function fmt(d: Date) {
  return d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
}

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=footer_cta";
const WOOCOMMERCE_DOWNLOAD =
  "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";

// JSON-LD for blog posts (non-blog `pages` build their own in <ContentPage>).
// BreadcrumbList includes category for blog posts when available.
const breadcrumbItems = isBlog
  ? [
      { name: "Home", url: "/" },
      { name: "Blog", url: "/blog/" },
      ...(primaryCategory
        ? [{ name: primaryCategory, url: categoryHref(primaryCategory) }]
        : []),
      { name: blogEntry!.data.title, url: `/${blogEntry!.data.legacySlug}/` },
    ]
  : [];

const jsonLd = isBlog
  ? [
      article({
        title: blogEntry!.data.title,
        description: blogEntry!.data.description ?? "",
        url,
        image: blogEntry!.data.featuredImage,
        datePublished: blogEntry!.data.pubDate,
        dateModified: blogEntry!.data.updatedDate ?? blogEntry!.data.pubDate,
        author: blogEntry!.data.author,
        tags: blogEntry!.data.tags,
      }),
      breadcrumb(breadcrumbItems),
    ]
  : [];

// Share URLs
const shareUrl = url;
const shareTitle = isBlog ? blogEntry!.data.title : entry.data.title;
const xShare = `https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(shareTitle)}`;
const linkedinShare = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`;
---

{isBlog ? (
  <Base
    title={`${entry.data.title} - ${SITE.name}`}
    description={entry.data.description}
    ogImage={entry.data.featuredImage ?? undefined}
    ogType="article"
    jsonLd={jsonLd}
  >
      <article
        data-pagefind-body
        data-pagefind-meta={`date:${blogEntry!.data.pubDate.toISOString().slice(0, 10)}`}
        data-pagefind-filter={`category:${primaryCategory ?? "Uncategorized"}`}
      >
        <header class="bg-gradient-to-b from-slate-50 to-white">
          <div class="mx-auto max-w-6xl px-6 pt-14 pb-10">
            <div class="max-w-3xl">
            <nav class="mb-6 text-left text-sm text-slate-500" aria-label="Breadcrumb">
              <a href="/" class="hover:text-slate-700">Home</a>
              <span class="mx-2 text-slate-300">/</span>
              <a href="/blog/" class="hover:text-slate-700">Blog</a>
              {primaryCategory && (
                <>
                  <span class="mx-2 text-slate-300">/</span>
                  <a href={categoryHref(primaryCategory)} class="hover:text-slate-700">{primaryCategory}</a>
                </>
              )}
            </nav>

            {primaryCategory && (
              <a
                href={categoryHref(primaryCategory)}
                class="inline-flex items-center rounded-full bg-[#16161D] px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white transition hover:bg-[#26262e]"
              >
                {primaryCategory}
              </a>
            )}

            <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">{blogEntry!.data.title}</h1>

            {blogEntry!.data.description && (
              <p class="mt-4 text-xl text-slate-600">{blogEntry!.data.description}</p>
            )}

            <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-3 text-sm text-slate-600">
              <span class="flex items-center gap-2">
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-[#16161D] text-xs font-semibold text-white" aria-hidden="true">{initials(blogEntry!.data.author)}</span>
                <span class="font-medium text-slate-900">{blogEntry!.data.author}</span>
              </span>
              <span class="text-slate-300" aria-hidden="true">·</span>
              <time datetime={blogEntry!.data.pubDate.toISOString()}>{fmt(blogEntry!.data.pubDate)}</time>
              <span class="text-slate-300" aria-hidden="true">·</span>
              <span>{minutes} min read</span>
            </div>
            </div>
          </div>
        </header>

        <div class="mx-auto max-w-6xl px-6 py-12">
          <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_220px] lg:gap-12">
            <div class="min-w-0">
              <div class="max-w-3xl">
                <div class="prose prose-slate prose-lg max-w-none
                  prose-headings:scroll-mt-24 prose-headings:tracking-tight prose-headings:text-slate-900
                  prose-h2:mt-12 prose-h2:text-2xl prose-h2:font-bold
                  prose-h3:mt-8 prose-h3:text-xl prose-h3:font-semibold
                  prose-p:text-slate-700
                  prose-img:rounded-lg
                  prose-a:text-[#16161D] prose-a:underline-offset-4 hover:prose-a:text-slate-700
                  prose-strong:text-slate-900
                  prose-li:my-1">
                  <Content />
                </div>

                {/* Tags */}
                {blogEntry!.data.tags && blogEntry!.data.tags.length > 0 && (
                  <div class="mt-12 border-t border-slate-200 pt-8">
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Tagged</p>
                    <ul class="mt-3 flex flex-wrap gap-2">
                      {blogEntry!.data.tags.map((t) => (
                        <li>
                          <a
                            href={tagHref(t)}
                            class="inline-flex items-center rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-medium text-slate-700 transition hover:border-[#16161D] hover:text-[#16161D]"
                          >#{normalizeName(t)}</a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {/* Share */}
                <div class="mt-10 flex flex-wrap items-center gap-3 border-t border-slate-200 pt-8">
                  <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Share</span>
                  <a
                    href={xShare}
                    target="_blank"
                    rel="external noopener nofollow"
                    aria-label="Share on X"
                    class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 text-slate-700 transition hover:border-[#16161D] hover:text-[#16161D]"
                  >
                    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817-5.97 6.817H1.677l7.73-8.835L1.254 2.25h6.829l4.713 6.231 5.448-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z"/></svg>
                  </a>
                  <a
                    href={linkedinShare}
                    target="_blank"
                    rel="external noopener nofollow"
                    aria-label="Share on LinkedIn"
                    class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 text-slate-700 transition hover:border-[#16161D] hover:text-[#16161D]"
                  >
                    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M20.452 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.356V9h3.414v1.561h.046c.476-.9 1.637-1.852 3.368-1.852 3.6 0 4.268 2.37 4.268 5.455v6.288ZM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.063 2.063 0 0 1 0 4.125ZM7.114 20.452H3.558V9h3.556v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003Z"/></svg>
                  </a>
                  <button
                    type="button"
                    data-copy-link={shareUrl}
                    aria-label="Copy link"
                    class="inline-flex h-9 items-center gap-2 rounded-full border border-slate-200 px-3 text-xs font-medium text-slate-700 transition hover:border-[#16161D] hover:text-[#16161D]"
                  >
                    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 1 0-7.07-7.07L11.5 4.5"/><path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 1 0 7.07 7.07L12.5 19.5"/></svg>
                    <span data-copy-label>Copy link</span>
                  </button>
                </div>

                {/* Prev / next */}
                {(navAdj.prev || navAdj.next) && (
                  <nav class="mt-12 grid gap-4 border-t border-slate-200 pt-8 sm:grid-cols-2" aria-label="Adjacent posts">
                    {navAdj.prev ? (
                      <a href={postHref(navAdj.prev)} class="group rounded-lg border border-slate-200 p-4 transition hover:border-[#16161D]">
                        <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">← Previous</p>
                        <p class="mt-2 font-semibold text-slate-900 group-hover:text-[#16161D]">{navAdj.prev.data.title}</p>
                      </a>
                    ) : <span class="hidden sm:block" />}
                    {navAdj.next ? (
                      <a href={postHref(navAdj.next)} class="group rounded-lg border border-slate-200 p-4 text-right transition hover:border-[#16161D]">
                        <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Next →</p>
                        <p class="mt-2 font-semibold text-slate-900 group-hover:text-[#16161D]">{navAdj.next.data.title}</p>
                      </a>
                    ) : <span class="hidden sm:block" />}
                  </nav>
                )}
              </div>
            </div>

            {tocHeadings.length >= 3 && (
              <aside class="hidden lg:block">
                <div class="sticky top-24">
                  <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">On this page</p>
                  <ul class="mt-3 space-y-2 border-l border-slate-200">
                    {tocHeadings.map((h) => (
                      <li>
                        <a
                          href={`#${h.slug}`}
                          class:list={[
                            "block border-l-2 -ml-px py-1 pl-3 text-sm transition",
                            h.depth === 3 ? "pl-6 text-slate-500" : "text-slate-700",
                            "border-transparent hover:border-[#16161D] hover:text-[#16161D]",
                          ]}
                        >{h.text}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              </aside>
            )}
          </div>
        </div>

        {/* Free tools & data (ROI calculator + benchmark report) */}
        <ResourceCards />

        {/* Related posts */}
        {related.length > 0 && (
          <section class="border-t border-slate-200 bg-slate-50">
            <div class="mx-auto max-w-6xl px-6 py-16">
              <h2 class="text-2xl font-bold tracking-tight text-slate-900">Related posts</h2>
              <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {related.map((p) => (
                  <li>
                    <a href={postHref(p)} class="group block overflow-hidden rounded-lg border border-slate-200 bg-white transition hover:border-[#16161D]">
                      {p.data.featuredImage ? (
                        <img src={p.data.featuredImage} alt={p.data.title} loading="lazy" class="h-40 w-full object-cover" />
                      ) : (
                        <div class="h-40 w-full bg-slate-100" />
                      )}
                      <div class="p-5">
                        <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">{fmt(p.data.pubDate)}</p>
                        <h3 class="mt-2 line-clamp-2 font-semibold text-slate-900 group-hover:text-[#16161D]">{p.data.title}</h3>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )}

        {/* Bottom CTA */}
        <section class="bg-[#16161D]">
          <div class="mx-auto max-w-4xl px-6 py-20 text-center">
            <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-white/70">
              Most shoppers leave because they can't find the right product
            </p>
            <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
              Turn shoppers into confident buyers with a Product Recommendation Quiz that drives sales.
            </h2>
            <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
              <a
                href={SHOPIFY_INSTALL}
                target="_blank"
                rel="external noopener nofollow"
                class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
              >
                Install on Shopify
              </a>
              <a
                href={WOOCOMMERCE_DOWNLOAD}
                target="_blank"
                rel="external noopener nofollow"
                class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
              >
                Get for WooCommerce
              </a>
            </div>
          </div>
        </section>

        <script is:inline>
          document.querySelectorAll("[data-copy-link]").forEach((btn) => {
            btn.addEventListener("click", async () => {
              const url = btn.getAttribute("data-copy-link") || "";
              try { await navigator.clipboard.writeText(url); } catch {}
              const label = btn.querySelector("[data-copy-label]");
              if (label) {
                const prev = label.textContent;
                label.textContent = "Copied!";
                setTimeout(() => { label.textContent = prev; }, 1500);
              }
            });
          });
        </script>

        {/* Collapse long code blocks (12+ lines) behind a "Show all code" toggle.
            Native, no extra network; code stays in the DOM so crawlers/LLMs read it. */}
        <style is:global>
          .code-collapse { position: relative; }
          .code-collapse > pre { max-height: 10rem !important; overflow: hidden !important; }
          .code-collapse.is-open > pre { max-height: none !important; overflow: auto !important; }
          .code-collapse-toggle {
            display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 0.5rem;
            padding: 0.4rem 0.85rem; font-size: 0.8rem; font-weight: 600; color: #0f172a;
            background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 0.375rem; cursor: pointer;
          }
          .code-collapse-toggle:hover { background: #e2e8f0; }
        </style>
        <script is:inline>
          (function () {
            function init() {
              try {
                var blocks = document.querySelectorAll("article .prose pre");
                blocks.forEach(function (pre) {
                  if (pre.closest(".code-collapse")) return;
                  var lines = pre.querySelectorAll(".line").length;
                  if (!lines) lines = (pre.textContent || "").replace(/\n+$/, "").split("\n").length;
                  if (lines < 10) return;
                  var wrap = document.createElement("div");
                  wrap.className = "code-collapse";
                  pre.parentNode.insertBefore(wrap, pre);
                  wrap.appendChild(pre);
                  var btn = document.createElement("button");
                  btn.type = "button";
                  btn.className = "code-collapse-toggle";
                  btn.textContent = "Show all code (" + lines + " lines)";
                  btn.setAttribute("aria-expanded", "false");
                  wrap.appendChild(btn);
                  btn.addEventListener("click", function () {
                    var open = wrap.classList.toggle("is-open");
                    btn.textContent = open ? "Hide code" : "Show all code (" + lines + " lines)";
                    btn.setAttribute("aria-expanded", open ? "true" : "false");
                  });
                });
              } catch (e) {}
            }
            if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init);
            else init();
          })();
        </script>
      </article>
  </Base>
) : (
  <ContentPage entry={entry} lang="en" translated={translated} />
)}
