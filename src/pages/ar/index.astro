---
import Base from "../../layouts/Base.astro";
import PlanCards from "../../components/pages/PlanCards.astro";
import YouTubeFacade from "../../components/YouTubeFacade.astro";
import { organization, website, softwareApplication } from "../../lib/schema";
import { SITE } from "../../lib/site";
import { localizedHref } from "../../lib/i18n";

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=bfs_badge_hero";
const WOOCOMMERCE_DOWNLOAD =
  "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";
const YOUTUBE_ID = "fJqpGJUzZNE";

const stats = [
  { value: "+20,000", label: "علامات تجارية تستخدم RevenueHunt" },
  { value: "+45M", label: "اختبار مكتمل" },
  { value: "+370M USD", label: "إيرادات للتجار" },
  { value: "4.9 ★", label: "أكثر من 550 تقييماً بخمس نجوم" },
];

const pillars = [
  {
    image: "/img/pages/home/recommend-right-products.svg",
    title: "أوصِ بالمنتجات المناسبة",
    body:
      "الاختبارات القابلة للشراء تدفع المبيعات، وترشد العملاء إلى إيجاد المنتجات المناسبة لهم، وتساعدهم على اتخاذ قرارات شراء بثقة.",
  },
  {
    image: "/img/pages/home/know-your-customers.svg",
    title: "تعرّف على عملائك",
    body:
      "تتيح لك الاختبارات جمع بيانات قابلة للتنفيذ من خلال طرح أسئلة مستهدفة على عملائك. قسّم وصنّف المتسوقين بناءً على إجاباتهم.",
  },
  {
    image: "/img/pages/home/grow-your-audience.svg",
    title: "نمِّ جمهورك",
    body:
      "أرسل العملاء المحتملين الذين تم جمعهم إلى قائمتك البريدية أو نظام CRM الخاص بك. استفد من بيانات ملف العميل لإنشاء حملات تسويقية أكثر تخصيصاً وأعلى عائداً على الاستثمار ROI.",
  },
];

const features = [
  {
    kicker: "مساعد الاختبار الذكي بالـ AI",
    title: "أنشئ اختباراً في 60 ثانية بالـ AI",
    body:
      "صِف متجرك، ويقوم مساعدنا الذكي بالـ AI بإنشاء اختبار مكتمل الإعداد - الأسئلة والمنطق وربط المنتجات - جاهز للنشر.",
  },
  {
    kicker: "المنطق الشرطي",
    title: "منطق التفرّع بالسحب والإفلات",
    body:
      "أظهر أو أخفِ الأسئلة بناءً على الإجابات السابقة. وجّه كل متسوق عبر المسار الذي ينتهي بعملية شراء - دون الحاجة إلى أي كود.",
  },
  {
    kicker: "تصميم الاختبار",
    title: "اجعله خاصاً بك - دون الحاجة إلى أي كود",
    body:
      "خصّص الألوان والخطوط والصور والتخطيط ليتناسب مع علامتك التجارية. يبدو اختبارك جزءاً من متجرك، لا أداة من طرف ثالث.",
  },
  {
    kicker: "صفحة النتائج",
    title: "صفحة نتائج جاهزة للدفع تحقق التحويل",
    body:
      "اعرض اختيارات منتجات مخصصة مجمّعة حسب خطوة الروتين - مع الصور والأسعار وأزرار الإضافة إلى السلة. يشتري المتسوقون مباشرة من صفحة النتائج.",
  },
  {
    kicker: "تحليلات التسرّب",
    title: "اعرف بالضبط أين يغادر المتسوقون",
    body:
      "اطّلع على معدلات التسرّب سؤالاً بسؤال، والوجهات، والنتائج. عالِج نقاط الاحتكاك، وحسّن معدلات الإكمال، واسترجع الإيرادات المفقودة.",
  },
  {
    kicker: "تكاملات الطرف الثالث",
    title: "اربط منظومة التسويق بأكملها",
    body:
      "أرسل بيانات الاختبار إلى Google Analytics، وأطلق أحداث Meta Pixel لإعادة الاستهداف، وزامن العملاء المحتملين مع Klaviyo - كل ذلك من صفحة إعدادات واحدة. دون كود، دون وسيط برمجي.",
  },
];

const steps = [
  {
    title: "ثبّت التطبيق",
    body: "تثبيت بنقرة واحدة من Shopify App Store أو دليل إضافات WordPress.",
  },
  {
    title: "أنشئ اختبارك",
    body: "استخدم المساعد الذكي بالـ AI أو محرر السحب والإفلات. أضف أسئلتك، وحدّد منطقك.",
  },
  {
    title: "اربط منتجاتك",
    body: "اربط إجابات الاختبار بكتالوج منتجاتك. أوصِ بأفضل تطابق لكل نتيجة.",
  },
  {
    title: "انشر وروّج",
    body: "ضمّنه في أي صفحة، أو اعرضه كنافذة منبثقة عند نية المغادرة، أو اربطه من إعلاناتك.",
  },
];

const testimonials = [
  {
    quote:
      "انتقلت من Octane. كانت عملية التصميم أكثر سلاسة وأكثر متعة بصرياً. وعندما واجهت مشكلة مع Klaviyo، رد الدعم بسرعة البرق وبأسلوب ودود ومنفتح للغاية.",
    author: "Kae Paché",
  },
  {
    quote:
      "كان Eric صبوراً للغاية وملمّاً ودقيقاً - يرشدني خطوة بخطوة عبر إعداد الاختبار. دعم كهذا نادر.",
    author: "Marcelle",
  },
  {
    quote:
      "التطبيق نفسه ممتاز: ميزات قوية وسهولة استخدام بديهية. أنشأ الفريق شرحاً تفصيلياً مخصصاً لنا. استخدمناه لأكثر من 3 سنوات.",
    author: "Didymos",
  },
  {
    quote:
      "أفضل تطبيق اختبار وتوصية بالمنتجات جربته على Shopify بفارق كبير. خصص الفريق وقتاً للبحث وشرح كل خطوة بوضوح والإرشاد حتى حُلّت المشكلة بالكامل.",
    author: "REYNA",
  },
  {
    quote:
      "كان خامس تطبيق اختبار أجربه وكان الوحيد الذي دعم بالكامل ما احتجته. تمكنت من إنشاء أول اختبار لي بسرعة كبيرة.",
    author: "CCA Printing",
  },
  {
    quote:
      "خدمة العملاء متميزة - سجّل أحد الوكلاء مقطع فيديو وشرح لي الحل خطوة بخطوة. سريع الاستجابة ومفيد للغاية.",
    author: "The Love U Collective",
  },
];

const verticals = [
  { icon: "💄", title: "الجمال والعناية بالبشرة", body: "محددات نوع البشرة، ومطابقة الدرجات اللونية، ومنشئو الروتين." },
  { icon: "💊", title: "المكملات الغذائية", body: "اختبارات الأهداف الصحية التي توصي بالمجموعة المناسبة." },
  { icon: "👗", title: "الأزياء", body: "اختبارات الأناقة التي تكشف المقاس واللون والقصة المناسبة." },
  { icon: "🐾", title: "الحيوانات الأليفة", body: "توصيات منتجات خاصة بكل سلالة لكل مالك." },
  { icon: "🍵", title: "الأطعمة والمشروبات", body: "اختبارات ملف النكهة التي تحوّل المتصفحين إلى مشتركين." },
  { icon: "🏋️", title: "اللياقة البدنية", body: "مسارات قائمة على الأهداف للمعدات والملابس والبرامج." },
  { icon: "🏠", title: "المنزل والديكور", body: "اختبارات الأناقة التي تطابق الأثاث مع كل مساحة معيشة." },
  { icon: "🌿", title: "الصديق للبيئة والمستدام", body: "اختبارات مطابقة القيم للمستهلك الواعي." },
];

const brands = [
  "Olaplex", "Madluvv", "Mattel", "Alt", "Baia", "Bare", "Biktrix",
  "Dermocracy", "Diego", "Gisou", "Laura", "Nuxe", "Olcay",
  "Salad Code", "Salugea", "Sunday", "Tushy", "Tiege",
];

const SHOPIFY_REVIEWS =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/reviews?ratings%5B%5D=5&sort_by=relevance";
const WOOCOMMERCE_REVIEWS =
  "https://wordpress.org/support/plugin/product-recommendation-quiz-for-ecommerce/reviews/?filter=5";
---

<Base
  lang="ar"
  translated={true}
  title={`اختبار التوصية بالمنتجات - ${SITE.name}`}
  description="حوّل المتصفحين إلى مشترين باختبار توصية بالمنتجات. أكثر من 20,000 علامة تجارية، 4.9★، أكثر من 550 مراجعة. ارفع معدل التحويل والتقط zero-party data باختبار للمنتجات."
  jsonLd={[organization(), website(), softwareApplication()]}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-7xl px-6 py-16 lg:py-24">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:items-start lg:gap-16">
        <div>
          <a
            href={SHOPIFY_INSTALL}
            rel="external nofollow"
            data-install="home_hero_badge"
            class="mb-6 inline-block"
          >
            <img
              src="/img/home/bfs-badge.webp"
              alt="Built for Shopify"
              width="120"
              height="38"
              class="h-8 w-auto"
              loading="eager"
            />
          </a>
          <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
            اختبار التوصية بالمنتجات الذي يحوّل المتصفحين إلى مشترين
          </h1>
          <p class="mt-6 max-w-xl text-lg text-slate-700">
            الإعلانات المدفوعة تجلب النقرات - واختباراتنا تحوّلها إلى مبيعات. يرشد RevenueHunt المتسوقين إلى المنتجات المناسبة،
            ويجمع البيانات، ويدفع التحويلات. سهل التثبيت، دون الحاجة إلى أي كود.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={SHOPIFY_INSTALL}
              rel="external nofollow"
              data-install="home_hero"
              class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
            >
              التثبيت على Shopify
            </a>
            <a
              href={WOOCOMMERCE_DOWNLOAD}
              rel="external nofollow"
              onclick="window.gtag&&gtag('event','download_woocommerce_plugin',{event_label:'home_hero'})"
              class="inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-6 py-3 text-base font-semibold text-slate-900 transition hover:border-slate-400 hover:bg-slate-50"
            >
              الحصول عليه لـ WooCommerce
            </a>
          </div>
          <p class="mt-4 text-sm text-slate-500">
            خطة مجانية متاحة · تجربة مجانية لمدة 15 يوماً · ضمان استرداد الأموال خلال 30 يوماً
          </p>
        </div>

        <div class="relative lg:mt-14">
          <div class="aspect-video overflow-hidden rounded-xl bg-slate-900 shadow-2xl">
            <YouTubeFacade
              id={YOUTUBE_ID}
              title="RevenueHunt - اختبار التوصية بالمنتجات"
              poster="/img/home/video-poster.webp"
              alt="عرض توضيحي لاختبار التوصية بالمنتجات من RevenueHunt لمتاجر Shopify وWooCommerce"
              eager
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats / proof bar -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <p class="text-center text-sm font-semibold uppercase tracking-wider text-white/70">
        لماذا تختار RevenueHunt؟ أثرنا يتحدث عن نفسه
      </p>
      <dl class="mt-8 grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-4">
        {stats.map((s) => (
          <div class="text-center">
            <dt class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{s.value}</dt>
            <dd class="mt-2 text-sm text-white/70">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Problem framing -->
  <section class="mx-auto max-w-4xl px-6 py-20 text-center">
    <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
      لا يعرف المتسوقون دائماً ماذا يشترون - وهذا يعني مبيعات مفقودة.
    </h2>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-700">
      يرشد <a href={localizedHref("/product-recommendation-quiz/", "ar")} class="font-semibold text-slate-900 underline underline-offset-4 hover:text-slate-700">اختبار التوصية بالمنتجات</a> الخاص بنا كل عميل عبر رحلته، مساعداً إياه على اكتشاف وشراء المنتجات المناسبة له.
    </p>
  </section>

  <!-- 3-up pillars -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="grid gap-10 md:grid-cols-3">
        {pillars.map((p) => (
          <div class="text-center">
            <img src={p.image} alt={p.title} width="120" height="120" class="mx-auto h-24 w-24" loading="lazy" />
            <h3 class="mt-6 text-xl font-semibold text-slate-900">{p.title}</h3>
            <p class="mt-3 text-slate-600">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features grid -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">كل ما تحتاجه للبيع بذكاء أكبر</h2>
      </div>
      <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {features.map((f) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">{f.kicker}</p>
            <h3 class="mt-2 text-xl font-semibold text-slate-900">{f.title}</h3>
            <p class="mt-3 text-slate-600">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4-step setup -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">جاهز في 4 خطوات. في أقل من 15 دقيقة.</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          دون مطوّرين. دون كود. مجرد اختبار سيحبه عملاؤك.
        </p>
      </div>
      <ol class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <li class="rounded-xl border border-slate-200 bg-white p-6">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-[#16161D] text-sm font-bold text-white">{i + 1}</span>
            <h3 class="mt-4 text-lg font-semibold text-slate-900">{s.title}</h3>
            <p class="mt-2 text-slate-600">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          اكتشف لماذا يحب التجار اختبار التوصية بالمنتجات
        </h2>
        <p class="mx-auto mt-4 max-w-3xl text-lg text-slate-700">
          موثوق به من قِبل أكثر من 20,000 علامة تجارية ومدعوم بأكثر من 550 تقييماً بخمس نجوم عبر Shopify وWooCommerce وغيرها -
          RevenueHunt هو تطبيق الاختبار المفضل لدفع المبيعات عبر التخصيص. لكن لا تأخذ بكلامنا فحسب.
        </p>
        <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap text-sm">
          <a href={SHOPIFY_REVIEWS} rel="external nofollow" class="font-semibold text-[#16161D] underline-offset-4 hover:underline">
            التقييمات على Shopify →
          </a>
          <a href={WOOCOMMERCE_REVIEWS} rel="external nofollow" class="font-semibold text-[#16161D] underline-offset-4 hover:underline">
            التقييمات على WooCommerce →
          </a>
        </div>
      </div>

      <h3 class="mt-16 text-center text-xl font-semibold text-slate-900">ماذا يقول التجار</h3>
      <div class="rh-carousel mt-8">
        <ul data-carousel class="rh-carousel__track" aria-label="شهادات التجار">
          {testimonials.map((t) => (
            <li class="rounded-xl border border-slate-200 bg-white p-6">
              <p class="text-amber-500" aria-label="5 من 5 نجوم">★★★★★</p>
              <blockquote class="mt-3 text-slate-700">"{t.quote}"</blockquote>
              <p class="mt-4 text-sm font-semibold text-slate-900"> - {t.author}</p>
            </li>
          ))}
        </ul>
        <div data-carousel-dots class="rh-carousel__dots"></div>
      </div>
    </div>
  </section>

  <!-- Verticals -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">مصمم لكل قطاع من قطاعات eCommerce</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          سواء كنت تبيع منتجات العناية بالبشرة أو المكملات الغذائية أو الأرائك - فإن اختباراً يساعد المتسوقين على إيجاد المنتج المناسب يحقق تحويلاً أفضل من أي صفحة مجموعة.
        </p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {verticals.map((v) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6">
            <span class="block text-3xl" aria-hidden="true">{v.icon}</span>
            <h3 class="mt-3 text-base font-semibold text-slate-900">{v.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Brand logos -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-white sm:text-3xl">نمكّن أفضل العلامات التجارية في eCommerce</h2>
      <div class="brands-marquee mt-10">
        <ul class="brands-marquee__track" aria-label="شعارات العلامات التجارية للعملاء">
          {brands.map((b) => (
            <li class="brands-marquee__item">
              <img
                src={`/img/brands/${b.toLowerCase().replace(/ /g, "-")}.svg`}
                alt={b}
                loading="lazy"
                width="160"
                height="40"
              />
            </li>
          ))}
          {brands.map((b) => (
            <li class="brands-marquee__item" aria-hidden="true">
              <img
                src={`/img/brands/${b.toLowerCase().replace(/ /g, "-")}.svg`}
                alt={`${b} logo`}
                loading="lazy"
                width="160"
                height="40"
              />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <style>
    .brands-marquee {
      overflow: hidden;
      -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
      mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    }
    .brands-marquee__track {
      display: flex;
      align-items: center;
      width: max-content;
      list-style: none;
      padding: 0;
      margin: 0;
      animation: brands-marquee 40s linear infinite;
    }
    .brands-marquee:hover .brands-marquee__track {
      animation-play-state: paused;
    }
    .brands-marquee__item {
      flex-shrink: 0;
      padding: 10px 24px;
      height: 64px;
      display: flex;
      align-items: center;
