---
import Base from "../../../layouts/Base.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import { organization, breadcrumb, softwareApplication } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

interface Integration {
  name: string;
  category: string;
  logo: string;
  href: string;
}

const groups: { heading: string; emoji: string; intro: string; items: Integration[] }[] = [
  {
    heading: "التحليلات والتتبع",
    emoji: "📊",
    intro:
      "قِس أداء الاختبار، وتتبّع التحويلات، وحسّن مسارك. اكتشف بالضبط أي الأسئلة تولّد المبيعات وأين يغادر العملاء.",
    items: [
      { name: "Google Analytics", category: "البيانات", logo: "/img/pages/integrations/ganalytics.webp", href: "https://docs.revenuehunt.com/how-to-guides/integrate-google-analytics/" },
      { name: "Meta Pixel", category: "البيانات", logo: "/img/pages/integrations/metapixel.webp", href: "https://docs.revenuehunt.com/how-to-guides/integrate-meta-pixel/" },
      { name: "TikTok Pixel", category: "البيانات", logo: "/img/pages/integrations/tiktoklog.webp", href: "https://docs.revenuehunt.com/how-to-guides/integrate-tiktok-pixel/" },
      { name: "Webhooks", category: "البيانات", logo: "/img/pages/integrations/webhooklog.webp", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-webhooks/" },
      { name: "Google Product Feed", category: "المنتجات", logo: "/img/pages/integrations/googleproductfeed.webp", href: "/product-recommendation-quiz-standalone-google-product-feed/" },
    ],
  },
  {
    heading: "التسويق والأتمتة",
    emoji: "✉️",
    intro:
      "زامن العملاء المحتملين من الاختبار مع منصة بريدك الإلكتروني أو نظام CRM الخاص بك. أرسل متابعات مخصصة، وقسّم العملاء حسب إجاباتهم، وحوّل العملاء المحتملين إلى مشترين أوفياء تلقائياً.",
    items: [
      { name: "Klaviyo", category: "التسويق عبر البريد الإلكتروني", logo: "/img/pages/integrations/klaviyolog.webp", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-klaviyo/" },
      { name: "ActiveCampaign", category: "الأتمتة", logo: "/img/pages/integrations/activecampaignlog.webp", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-activecampaign/" },
      { name: "Mailchimp", category: "التسويق عبر البريد الإلكتروني", logo: "/img/pages/integrations/mailchimplog.webp", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-mailchimp/" },
      { name: "Omnisend", category: "التسويق عبر البريد الإلكتروني", logo: "/img/pages/integrations/omnisendlog.webp", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-omnisend/" },
      { name: "Zapier", category: "الأتمتة", logo: "/img/pages/integrations/zapierlog.webp", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-zapier/" },
      { name: "HubSpot", category: "CRM", logo: "/img/pages/integrations/hubspotlog.webp", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-hubspot/" },
      { name: "Shopify Customers", category: "CRM", logo: "/img/pages/integrations/shopifylog.webp", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-shopify-customers/" },
    ],
  },
  {
    heading: "المبيعات والدليل الاجتماعي",
    emoji: "⭐",
    intro:
      "صنّف العملاء في Shopify، وأوصِ بالاشتراكات، واعرض التقييمات، كل ذلك انطلاقاً من إجابات الاختبار، حتى يرى كل متسوق بالضبط الدليل والعرض المهمين بالنسبة له.",
    items: [
      { name: "ReCharge", category: "الاشتراكات", logo: "/img/pages/integrations/rechargelog.webp", href: "https://docs.revenuehunt.com/how-to-guides/recommend-subscriptions/" },
      { name: "Shopify Reviews", category: "الدليل الاجتماعي", logo: "/img/pages/integrations/shopifyreviews.webp", href: "https://docs.revenuehunt.com/how-to-guides/show-product-reviews/" },
      { name: "Stamped", category: "الدليل الاجتماعي", logo: "/img/pages/integrations/stampedlog.webp", href: "https://docs.revenuehunt.com/how-to-guides/show-product-reviews/" },
      { name: "Judge.me", category: "الدليل الاجتماعي", logo: "/img/pages/integrations/judgemelog.webp", href: "https://docs.revenuehunt.com/how-to-guides/show-product-reviews/" },
      { name: "Rivyo Reviews", category: "الدليل الاجتماعي", logo: "/img/pages/integrations/rivyolog.webp", href: "https://docs.revenuehunt.com/how-to-guides/show-product-reviews/" },
      { name: "POS Tablet Stands", category: "المبيعات داخل المتجر", logo: "/img/pages/integrations/poslog.webp", href: "/product-recommendation-quiz-pos-tablet-stands/" },
      { name: "Shop App", category: "المبيعات عبر الهاتف المحمول", logo: "/img/pages/integrations/shopapplog.webp", href: "https://docs.revenuehunt.com/how-to-guides/show-quiz-in-shop-app/" },
    ],
  },
];

const pillars = [
  {
    emoji: "📊",
    title: "قِس كل شيء",
    body: "اتصل بـ Google Analytics وMeta Pixel وTikTok لقياس أداء الاختبار وتحسين حملاتك.",
  },
  {
    emoji: "✉️",
    title: "أتمتة المتابعات",
    body: "زامن العملاء المحتملين من الاختبار مع Klaviyo أو Mailchimp أو ActiveCampaign لإرسال توصيات منتجات مخصصة تلقائياً.",
  },
  {
    emoji: "💰",
    title: "ارفع إيراداتك",
    body: "صنّف العملاء في Shopify، وأوصِ بالاشتراكات عبر ReCharge، واعرض الدليل الاجتماعي مع تطبيقات التقييمات.",
  },
];

const stats = [
  { value: "20+", label: "تكاملات أصلية" },
  { value: "5 min", label: "متوسط وقت الإعداد" },
  { value: "صفر", label: "كود مطلوب" },
];

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=integrations";
const WOOCOMMERCE_DOWNLOAD =
  "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";

const jsonLd = [
  organization(),
  softwareApplication(),
  breadcrumb([
    { name: "الرئيسية", url: "/" },
    { name: "التكاملات", url: "/integrations/" },
  ]),
];

function isExternal(href: string) {
  return /^https?:\/\//.test(href);
}
---

<Base
  title="التكاملات - RevenueHunt"
  description="اربط اختبار RevenueHunt الخاص بك مع Klaviyo وMeta Pixel وMailchimp وOmnisend وGA4 وغيرها. زامن العملاء المحتملين والردود خلال 5 دقائق، دون كود."
  jsonLd={jsonLd}
  lang="ar"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
      <Breadcrumb items={[{ label: "الرئيسية", href: localizedHref("/", "ar") }, { label: "التكاملات" }]} />
      <Eyebrow>التكاملات</Eyebrow>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        تكاملات سلسة تعزز نتائج اختبارك
      </h1>
      <p class="mt-6 max-w-3xl text-xl text-slate-600">
        حوّل إجابات الاختبار إلى إيرادات بتكاملات قوية. اربط RevenueHunt بمنظومة التسويق الحالية لديك لأتمتة المتابعات، وتخصيص الحملات، وقياس الأداء، وتحويل المزيد من المتصفحين إلى مشترين. <strong class="text-slate-900">دون الحاجة إلى أي برمجة.</strong>
      </p>
    </div>
  </section>

  <!-- 3-up pillars -->
  <section class="border-y border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="grid gap-10 md:grid-cols-3">
        {pillars.map((p) => (
          <div>
            <div class="flex items-center gap-3">
              <span class="text-3xl" aria-hidden="true">{p.emoji}</span>
              <h2 class="text-xl font-semibold text-slate-900">{p.title}</h2>
            </div>
            <p class="mt-3 text-slate-600">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats bar -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-5xl px-6 py-14">
      <dl class="grid grid-cols-3 gap-x-8 gap-y-8">
        {stats.map((s) => (
          <div class="text-center">
            <dt class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{s.value}</dt>
            <dd class="mt-2 text-sm text-white/70">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Integration library -->
  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">استكشف مكتبة تكاملاتنا</h2>
      <p class="mx-auto mt-4 max-w-2xl text-slate-600">
        انقر على أي تكامل لعرض دليل إعداده في مركز المساعدة لدينا.
      </p>
    </div>

    {groups.map((g) => (
      <div class="mt-16">
        <div class="mb-6 flex items-baseline gap-3">
          <span class="text-2xl" aria-hidden="true">{g.emoji}</span>
          <h3 class="text-2xl font-semibold tracking-tight text-slate-900">{g.heading}</h3>
        </div>
        <p class="max-w-3xl text-slate-600">{g.intro}</p>

        <ul class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
          {g.items.map((it) => (
            <li>
              <a
                href={it.href}
                {...(isExternal(it.href) ? { target: "_blank", rel: "external noopener" } : {})}
                class="flex h-full flex-col items-center gap-3 rounded-xl border border-slate-200 bg-white p-5 text-center transition hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md"
              >
                <img
                  src={it.logo}
                  alt={`شعار ${it.name}`}
                  width="80"
                  height="80"
                  loading="lazy"
                  class="h-14 w-14 object-contain"
                />
                <div>
                  <p class="text-base font-semibold text-slate-900">{it.name}</p>
                  <p class="mt-1 text-xs uppercase tracking-wider text-slate-500">{it.category}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        هل أنت مستعد لربط اختبارك بمنظومة التسويق الخاصة بك؟
      </h2>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SHOPIFY_INSTALL}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          التثبيت على Shopify
        </a>
        <a
          href={WOOCOMMERCE_DOWNLOAD}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          التنزيل لـ WooCommerce
        </a>
      </div>
    </div>
  </section>
</Base>
