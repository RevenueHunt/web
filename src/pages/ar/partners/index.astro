---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

interface Partner {
  name: string;
  url: string;
  logo: string;
  description: string;
}

const groups: { heading: string; emoji: string; intro: string; items: Partner[] }[] = [
  {
    heading: "تطبيقات Shopify",
    emoji: "🧩",
    intro: "تطبيقات Shopify التي تتكامل بسلاسة مع RevenueHunt لتنمية متجرك.",
    items: [
      { name: "Orbe Shopify Geolocation", url: "https://orbe.app/", logo: "/img/pages/partners/orbe-removebg-preview.webp", description: "حقّق أقصى مبيعات عالمية بتحديد الموقع الجغرافي المتقدم في Shopify. خصّص المنتجات والأسعار والعملة والمحتوى لكل بلد ووجّه العملاء نحو تجربة التسوّق المناسبة مع Orbe." },
      { name: "WC Wishlist Club", url: "https://apps.shopify.com/wishlist-club?utm_source=revenuehunt&utm_medium=website&utm_campaign=partnership", logo: "/img/pages/partners/wishlist-club-150-150-px-logo.webp", description: "يتيح WC Wishlist Club لعملائك حفظ منتجاتهم المفضلة، ومشاركة قوائم الرغبات، والشراء لاحقاً، مما يزيد التفاعل والمبيعات. سهل الإعداد، محسّن للهاتف المحمول، ومثالي لتحويل المتصفحين إلى مشترين أوفياء." },
      { name: "Langwill: Language Translate", url: "https://apps.shopify.com/localiser", logo: "/img/pages/partners/1.webp", description: "وسّع نطاق وصولك العالمي مع Langwill: ترجم متجر Shopify الخاص بك إلى 138 لغة وحوّل العملات تلقائياً لتجربة تسوّق سلسة ومحلية." },
      { name: "Customer Dashboard Pro", url: "https://apps.shopify.com/customer-dashboard-pro?utm_source=revenuehunt", logo: "/img/pages/partners/CustomerDashboard.webp", description: "Customer Dashboard Pro هو التطبيق الوحيد الذي يوفر دعماً سلساً لكل من Customer Accounts الجديدة في Shopify وClassic Customer Accounts." },
      { name: "ToastiBar – Sales Popup", url: "https://makeprosimp.com/partnership/revenuehunt", logo: "/img/pages/partners/toastibarlogo_fgaiv9.webp", description: "ارفع ثقة العملاء وادفع المبيعات بعرض دليل اجتماعي في الوقت الفعلي: المبيعات، والسلة، والزوار، وتقييمات المنتجات، وتنبيهات المخزون." },
      { name: "UpPromote: Affiliate & Referral", url: "https://partners.secomapp.com/apps/affiliate/SHOPQUIZ_APP", logo: "/img/pages/partners/NEW_logo-1.webp", description: "UpPromote هو تطبيق التسويق بالعمولة/الإحالة الأكثر توصية في Shopify App Store. حل شامل لإنشاء وإدارة حملاتك التسويقية، مناسب للشركات من جميع الأحجام." },
      { name: "Essential Free Shipping Bar", url: "https://apps.shopify.com/essential-order-value-booster", logo: "/img/pages/partners/freeshippingbarlogo.webp", description: "ارفع المبيعات ومتوسط قيمة الطلب AOV بإعداد أشرطة شحن مجاني غير محدودة بأهداف متعددة لقيمة السلة لتحفيز المتسوقين على إضافة المزيد من المنتجات." },
      { name: "iCart Cart Drawer Cart Upsell", url: "https://apps.shopify.com/icart/?campaign=promotion&medium=in-app-banner&source=revenuehunt", logo: "/img/pages/partners/iCart-Cart-Drawer-Cart-Upsell-logo.webp", description: "تطبيق Shopify شامل لتخصيص درج السلة وصفحة السلة الكاملة مع upsell، وتوصيات المنتجات، وشريط التقدم، وحزم المنتجات، والخصومات." },
      { name: "Kaching Bundle Quantity Deals", url: "https://apps.shopify.com/bundle-deals?utm_source=partnership&utm_medium=web&utm_campaign=REVENUEH", logo: "/img/pages/partners/Kaching-Logo-1024x1024.webp", description: "ادفع المبيعات مع Kaching Bundle Quantity Deals: أنشئ عروض حزم مباشرة على صفحة منتجك. استخدم الرمز REVENUEH20 للحصول على خصم حصري بنسبة 20%." },
      { name: "PDF Invoice Generator", url: "https://apps.shopify.com/fordeer-invoice-order-printer?utm_source=ShopQuizProductRecommender&utm_medium=comarketing&utm_campaign=partner", logo: "/img/pages/partners/fordeer-data-export-1024x1024.webp", description: "مولّد فواتير Shopify من Fordeer مرن، ومتوافق مع المعايير العالمية، ويخدم B2C وB2B والبيع بالجملة. قوالب PDF قابلة للتخصيص، وطباعة دفعية، ودعم عبر الدردشة المباشرة على مدار الساعة طوال أيام الأسبوع." },
      { name: "AI SEO Optimizer", url: "https://share.seoant.com/app/1165b75b7ce1524D5J", logo: "/img/pages/partners/SEOAnt-_-AI-SEO-Optimizer_Channelwill-.webp", description: "أفضل تطبيق SEO لـ Shopify: حسّن الكلمات المفتاحية، وطوّر الـ meta tags، وأتقن بنية الموقع. تحليل للأداء وسرعة الـ SEO مدعومان بالـ AI." },
      { name: "BSS: B2B/Wholesale Solution", url: "https://apps.shopify.com/b2b-solution-custom-pricing?utm_source=RevenueHunt&utm_medium=partner-listing&utm_campaign=partnership-2024", logo: "/img/pages/partners/BSS-Commerce_logo_150.webp", description: "حل بيع بالجملة متكامل. تجربة تسوّق B2B سلسة تساعد التجار أيضاً على إدارة عملاء الجملة لديهم والحصول على رؤى عنهم." },
      { name: "PreOrder Now WOD", url: "https://apps.shopify.com/preorder-now?utm_source=+revenuehunt&utm_medium=web&utm_campaign=partner&utm_id=crosspromo", logo: "/img/pages/partners/PreOrder-Now-Logo.webp", description: "حوّل حالات نفاد المخزون إلى فرص للطلب المسبق. مثالي لشركات الطباعة عند الطلب: التقط اهتمام العملاء دون مخزون أولي." },
    ],
  },
  {
    heading: "الشحن والتوريد",
    emoji: "📦",
    intro: "شركاء التوريد وتنفيذ الطلبات والخدمات اللوجستية للشحن بشكل أسرع والتوسع عالميًا.",
    items: [
      { name: "Fulfillman", url: "https://www.fulfillman.com/", logo: "/img/pages/partners/fulfillmanlogo.webp", description: "Fulfillman رائد عالمي في التوريد والتنفيذ والخدمات اللوجستية للتجارة الإلكترونية، يقدّم شحناً سريعاً وموثوقاً عبر خدمات خط خاص مخصصة." },
      { name: "HyperSKU", url: "https://www.hypersku.com/", logo: "/img/pages/partners/150150-logo.webp", description: "يقدّم HyperSKU حلاً متكاملاً لسلسلة التوريد. أكثر من مليون منتج، وبيع الحزم، وأخذ العينات، وفحص الجودة، وتخصيص العلامة التجارية، وتنفيذ الطلبات الآلي." },
      { name: "Service Points", url: "https://www.servicepoints.eu/en/w2/smart-dropshipping-1?utm_source=revenuehunt&utm_medium=app&utm_id=31", logo: "/img/pages/partners/Logo-Black-background.webp", description: "تقدّم Service Points حل SMART Dropshipping: دروبشيبينغ آلي وقرارات سلسلة توريد قائمة على البيانات للتوسّع بلا حدود." },
    ],
  },
  {
    heading: "القوالب والتصميم",
    emoji: "🎨",
    intro: "قوالب احترافية وتصميم يجعل متجرك يتألق.",
    items: [
      { name: "SalesHunterThemes", url: "https://saleshunterthemes.com/?utm_source=app-providers&utm_medium=revenuehunt&utm_campaign=partnership-app&utm_content=website", logo: "/img/pages/partners/saleshunterthemes-logo.webp", description: "عزّز متجرك بقوالب Shopify المميزة من SalesHunterThemes. تصاميم عصرية ومتجاوبة تحسّن الأداء وتجربة المستخدم، مع خيارات تخصيص واسعة." },
    ],
  },
  {
    heading: "المنصات والأدلة",
    emoji: "🧭",
    intro: "منصات وأدلة تساعد التجار على اكتشاف الأدوات المناسبة.",
    items: [
      { name: "Taranker", url: "https://taranker.com/", logo: "/img/pages/partners/Icon512.webp", description: "Taranker منصة مبتكرة مكرّسة لمساعدة شركات التجارة الإلكترونية على إيجاد أفضل الأدوات لتحسين عملياتها. متخصصة في توصيات التطبيقات، ومراجعات الخبراء، ومجموعات التطبيقات المنتقاة." },
    ],
  },
];

const perks = [
  { title: "عمولات الإحالة", body: "اجلب عملاء جدداً لـ RevenueHunt واحصل على عمولة مدى الحياة بنسبة 20% من جميع الإيرادات التي يولّدونها." },
  { title: "روابط التسويق بالعمولة", body: "أضف روابط التسويق بالعمولة الخاصة بك في مقالاتك ونشراتك الإخبارية ومنشوراتك على وسائل التواصل الاجتماعي. اربط مباشرة بتطبيقاتنا على Shopify وWooCommerce وBigCommerce وMagento وstandalone." },
  { title: "مدير شراكات خاص بك", body: "احصل على نصائح حول كيفية إنشاء مسارات بيع آلية بأداتنا وحيل لبيع حلنا لعملائك." },
  { title: "محتوى حصري", body: "تواصل معنا للحصول على نصائح حول كيفية إنشاء مسارات بيع آلية لعملائك باستخدام RevenueHunt وأدوات أخرى." },
  { title: "مكان في Partner Directory الخاص بنا", body: "سيجدك مستخدمونا في Partner Directory الخاص بنا وسيتواصلون معك للتعاقد على خدماتك." },
];

const faqs = [
  { q: "كم تكلفة أن تصبح شريكاً؟", a: "التسجيل مجاني تماماً. صفر. لا شيء." },
  { q: "هل يجب أن أكون عميلاً لـ RevenueHunt؟", a: "لا، لست مضطراً لأن تكون عميلاً لـ RevenueHunt لتصبح شريكاً." },
  { q: "كيف سيتم الدفع لي؟", a: "ندفع الأرباح شهرياً. تُرسل المدفوعات عبر PayPal." },
  { q: "كيف يمكنني تتبّع إحالاتي؟", a: "يمكنك الاطّلاع على إحصاءاتك في Partner Dashboard الخاص بك." },
];

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "الرئيسية", url: "/" },
    { name: "الشركاء والمسوّقون بالعمولة", url: "/partners/" },
  ]),
];
---

<Base
  title="برنامج الشركاء - RevenueHunt"
  description="أحِل عملاءك. اكسب المال. احصل على عمولة مدى الحياة بنسبة 20% من العملاء الذين تحيلهم إلى RevenueHunt. سجّل مجاناً في برنامج الشركاء الخاص بنا."
  jsonLd={jsonLd}
  lang="ar"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20 text-center">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={localizedHref("/", "ar")} class="hover:text-slate-700">الرئيسية</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">الشركاء والمسوّقون بالعمولة</span>
      </nav>
      <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">برنامج الشركاء</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        أحِل عملاءك. اكسب المال.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-xl text-slate-600">
        اكسب عمولة مدى الحياة بنسبة 20% من العملاء الذين تحيلهم إلينا. سجّل اليوم مجاناً في برنامج الشركاء الخاص بنا.
      </p>
      <p class="mx-auto mt-6 max-w-3xl text-slate-600">
        إذا كنت <strong class="font-semibold text-slate-900">وكالة تسويق رقمي</strong> أو
        <strong class="font-semibold text-slate-900">متخصصاً في التجارة الإلكترونية</strong> وترغب في تنمية عملك،
        فإن برنامج الشركاء الخاص بنا مناسب لك. اصنع تجارب رائعة لعملائك مع RevenueHunt.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
        >
          ابدأ الآن
        </a>
        <a
          href="#partners"
          class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
        >
          شاهد شركاءنا
        </a>
      </div>
    </div>
  </section>

  <!-- Who you are + perks -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-1">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">من أنت</h2>
        <p class="mt-4 text-slate-600">
          أنت وكالة تسويق رقمي أو مستشار للتجارة الإلكترونية شغوف بالتصميم ومهووس بـ
          <strong class="font-semibold text-slate-900">تحقيق أفضل النتائج</strong> لعملائك. تنمّي
          عملك بدفع عجلة عمل الآخرين.
        </p>
      </div>
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">ماذا تحصل منا</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {perks.map((p) => (
            <li class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="text-base font-semibold text-slate-900">{p.title}</h3>
              <p class="mt-2 text-sm text-slate-600">{p.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Partner directory -->
  <section id="partners" class="mx-auto max-w-7xl px-6 py-16 scroll-mt-24">
    <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">شركاؤنا</h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
      تطبيقات ووكالات موثوقة تتكامل بسلاسة مع RevenueHunt لخدمة عملائك.
    </p>
    <div class="mt-12 space-y-16">
      {groups.map((g) => (
        <div>
          <div class="mb-2 flex items-baseline gap-3">
            <span class="text-2xl" aria-hidden="true">{g.emoji}</span>
            <h3 class="text-2xl font-semibold tracking-tight text-slate-900">{g.heading}</h3>
          </div>
          <p class="max-w-3xl text-slate-600">{g.intro}</p>
          <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {g.items.map((p) => (
        <li>
          <a
            href={p.url}
            target="_blank"
            rel="external noopener nofollow"
            class="group flex h-full flex-col items-center rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm transition hover:border-slate-300 hover:shadow-md"
          >
            <img
              src={p.logo}
              alt={`شعار ${p.name}`}
              loading="lazy"
              width="120"
              height="120"
              class="h-24 w-24 rounded-full object-cover"
            />
            <h3 class="mt-5 text-lg font-semibold text-slate-900 group-hover:text-[#16161D]">{p.name}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{p.description}</p>
            <span class="mt-5 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wider text-slate-500 group-hover:text-[#16161D]">
              زيارة الموقع <span aria-hidden="true">↗</span>
            </span>
          </a>
        </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">الأسئلة الشائعة</h2>
      <div class="mx-auto mt-8 max-w-2xl">
        {faqs.map((f) => (
          <details class="border-b border-slate-200">
            <summary class="py-4 text-base font-semibold text-slate-900">{f.q}</summary>
            <p class="pb-4 text-slate-600">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        كن شريكاً لـ RevenueHunt
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        أحِل عملاءك، وأنشئ مسارات بيع آلية، واكسب عمولة مدى الحياة بنسبة 20% من كل ما ينفقونه.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          ابدأ الآن
        </a>
        <a
          href={localizedHref("/demo/", "ar")}
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          احجز عرضاً توضيحياً
        </a>
      </div>
    </div>
  </section>
</Base>
