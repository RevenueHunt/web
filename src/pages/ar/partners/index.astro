---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

interface Partner {
  name: string;
  url: string;
  logo: string;
  description: string;
}

const groups: { heading: string; emoji: string; intro: string; items: Partner[] }[] = [
  {
    heading: "التوطين",
    emoji: "🌍",
    intro: "بِع عبر الحدود مع تحديد الموقع الجغرافي والترجمة ودعم العملات المتعددة المدمج.",
    items: [
      { name: "Orbe Shopify Geolocation", url: "https://apps.shopify.com/orbe?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/orbe-removebg-preview.webp", description: "حقّق أقصى مبيعات عالمية بتحديد الموقع الجغرافي المتقدم في Shopify. خصّص المنتجات والأسعار والعملة والمحتوى لكل بلد ووجّه العملاء نحو تجربة التسوّق المناسبة مع Orbe." },
      { name: "Langwill: Language Translate", url: "https://apps.shopify.com/localiser?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/1.webp", description: "وسّع نطاق وصولك العالمي مع Langwill: ترجم متجر Shopify الخاص بك إلى 138 لغة وحوّل العملات تلقائياً لتجربة تسوّق سلسة ومحلية." },
    ],
  },
  {
    heading: "الدردشة والدعم",
    emoji: "💬",
    intro: "أدوات حساب العملاء التي تجعل الخدمة الذاتية والدعم سهلين.",
    items: [
      { name: "Dondy WhatsApp Marketing & Chat", url: "https://apps.shopify.com/dondy-marketing-ai?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/dondy-logo.webp", description: "حوّل الزيارات المفقودة إلى إيرادات من خلال تدفقات WhatsApp الآلية للاسترداد والتأكيد والاحتفاظ، بالإضافة إلى وكيل ذكاء اصطناعي يتولى دعم العملاء بدلاً من فريقك." },
      { name: "Customer Dashboard Pro", url: "https://apps.shopify.com/customer-dashboard-pro?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/CustomerDashboard.webp", description: "Customer Dashboard Pro هو التطبيق الوحيد الذي يوفر دعماً سلساً لكل من Customer Accounts الجديدة في Shopify وClassic Customer Accounts." },
    ],
  },
  {
    heading: "البيع الإضافي والتوصيات",
    emoji: "🎯",
    intro: "ارفع متوسط قيمة الطلب من خلال العروض الإضافية في السلة وقوائم الرغبات والطلبات المسبقة.",
    items: [
      { name: "WC Wishlist Club", url: "https://apps.shopify.com/wishlist-club?utm_source=RevenueHunt&utm_medium=partnership&utm_campaign=partnership", logo: "/img/pages/partners/wishlist-club-150-150-px-logo.webp", description: "يتيح WC Wishlist Club لعملائك حفظ منتجاتهم المفضلة، ومشاركة قوائم الرغبات، والشراء لاحقاً، مما يزيد التفاعل والمبيعات. سهل الإعداد، محسّن للهاتف المحمول، ومثالي لتحويل المتصفحين إلى مشترين أوفياء." },
      { name: "iCart Cart Drawer Cart Upsell", url: "https://apps.shopify.com/icart/?campaign=promotion&medium=in-app-banner&source=revenuehunt&utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/iCart-Cart-Drawer-Cart-Upsell-logo.webp", description: "تطبيق Shopify شامل لتخصيص درج السلة وصفحة السلة الكاملة مع upsell، وتوصيات المنتجات، وشريط التقدم، وحزم المنتجات، والخصومات." },
      { name: "PreOrder Now WOD", url: "https://apps.shopify.com/preorder-now?utm_source=RevenueHunt&utm_medium=partnership&utm_campaign=partner&utm_id=crosspromo", logo: "/img/pages/partners/PreOrder-Now-Logo.webp", description: "حوّل حالات نفاد المخزون إلى فرص للطلب المسبق. مثالي لشركات الطباعة عند الطلب: التقط اهتمام العملاء دون مخزون أولي." },
    ],
  },
  {
    heading: "التسعير والخصومات",
    emoji: "🏷️",
    intro: "حزم وخصومات الكمية وأسعار B2B التي تكافئ السلال الأكبر.",
    items: [
      { name: "Kaching Bundle Quantity Deals", url: "https://apps.shopify.com/bundle-deals?utm_source=RevenueHunt&utm_medium=partnership&utm_campaign=REVENUEH", logo: "/img/pages/partners/Kaching-Logo-1024x1024.webp", description: "ادفع المبيعات مع Kaching Bundle Quantity Deals: أنشئ عروض حزم مباشرة على صفحة منتجك. استخدم الرمز REVENUEH20 للحصول على خصم حصري بنسبة 20%." },
      { name: "BSS: B2B/Wholesale Solution", url: "https://apps.shopify.com/b2b-solution-custom-pricing?utm_source=RevenueHunt&utm_medium=partnership&utm_campaign=partnership-2024", logo: "/img/pages/partners/BSS-Commerce_logo_150.webp", description: "حل بيع بالجملة متكامل. تجربة تسوّق B2B سلسة تساعد التجار أيضاً على إدارة عملاء الجملة لديهم والحصول على رؤى عنهم." },
    ],
  },
  {
    heading: "التسويق والنوافذ المنبثقة",
    emoji: "📣",
    intro: "الدليل الاجتماعي وبرامج الإحالة وحملات الموقع التي تعزز المبيعات.",
    items: [
      { name: "ToastiBar – Sales Popup", url: "https://makeprosimp.com/partnership/revenuehunt", logo: "/img/pages/partners/toastibarlogo_fgaiv9.webp", description: "ارفع ثقة العملاء وادفع المبيعات بعرض دليل اجتماعي في الوقت الفعلي: المبيعات، والسلة، والزوار، وتقييمات المنتجات، وتنبيهات المخزون." },
      { name: "UpPromote: Affiliate & Referral", url: "https://partners.secomapp.com/apps/affiliate/SHOPQUIZ_APP", logo: "/img/pages/partners/NEW_logo-1.webp", description: "UpPromote هو تطبيق التسويق بالعمولة/الإحالة الأكثر توصية في Shopify App Store. حل شامل لإنشاء وإدارة حملاتك التسويقية، مناسب للشركات من جميع الأحجام." },
    ],
  },
  {
    heading: "الشحن والخدمات اللوجستية",
    emoji: "📦",
    intro: "التوريد والخدمات اللوجستية وحوافز الشحن المجاني للشحن بشكل أسرع والتوسع.",
    items: [
      { name: "Essential Free Shipping Bar", url: "https://apps.shopify.com/essential-order-value-booster?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/freeshippingbarlogo.webp", description: "ارفع المبيعات ومتوسط قيمة الطلب AOV بإعداد أشرطة شحن مجاني غير محدودة بأهداف متعددة لقيمة السلة لتحفيز المتسوقين على إضافة المزيد من المنتجات." },
      { name: "HyperSKU", url: "https://apps.shopify.com/hypersku?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/150150-logo.webp", description: "يقدّم HyperSKU حلاً متكاملاً لسلسلة التوريد. أكثر من مليون منتج، وبيع الحزم، وأخذ العينات، وفحص الجودة، وتخصيص العلامة التجارية، وتنفيذ الطلبات الآلي." },
    ],
  },
  {
    heading: "التحليلات والتقارير",
    emoji: "📊",
    intro: "رؤى تحسين محركات البحث وبيانات الطلبات لقياس ما ينجح وإعداد التقارير عنه.",
    items: [
      { name: "PDF Invoice Generator", url: "https://apps.shopify.com/fordeer-invoice-order-printer?utm_source=RevenueHunt&utm_medium=partnership&utm_campaign=partner", logo: "/img/pages/partners/fordeer-data-export-1024x1024.webp", description: "مولّد فواتير Shopify من Fordeer مرن، ومتوافق مع المعايير العالمية، ويخدم B2C وB2B والبيع بالجملة. قوالب PDF قابلة للتخصيص، وطباعة دفعية، ودعم عبر الدردشة المباشرة على مدار الساعة طوال أيام الأسبوع." },
      { name: "AI SEO Optimizer", url: "https://share.seoant.com/app/1165b75b7ce1524D5J", logo: "/img/pages/partners/SEOAnt-_-AI-SEO-Optimizer_Channelwill-.webp", description: "أفضل تطبيق SEO لـ Shopify: حسّن الكلمات المفتاحية، وطوّر الـ meta tags، وأتقن بنية الموقع. تحليل للأداء وسرعة الـ SEO مدعومان بالـ AI." },
    ],
  },
  {
    heading: "تصميم المتجر والقوالب",
    emoji: "🎨",
    intro: "قوالب Shopify احترافية مصمّمة لزيادة التحويل وجعل متجرك يتألق.",
    items: [
      { name: "eComX", url: "https://ecomx.co/?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/ecomx-logo.webp", description: "تطوّر eComX قوالب Shopify احترافية مصمّمة لزيادة التحويل. اختر من بين أكثر من 16 تصميمًا مخصّصًا حسب المجال، محسّنة بناءً على بيانات تحويل حقيقية ومبنية للسرعة، لتحويل المزيد من الزوّار إلى مشترين." },
    ],
  },
];

const perks = [
  { title: "عمولات الإحالة", body: "اجلب عملاء جدداً لـ RevenueHunt واحصل على عمولة مدى الحياة بنسبة 20% من جميع الإيرادات التي يولّدونها." },
  { title: "روابط التسويق بالعمولة", body: "أضف روابط التسويق بالعمولة الخاصة بك في مقالاتك ونشراتك الإخبارية ومنشوراتك على وسائل التواصل الاجتماعي. اربط مباشرة بتطبيقاتنا على Shopify وWooCommerce وBigCommerce وMagento وstandalone." },
  { title: "مدير شراكات خاص بك", body: "احصل على نصائح حول كيفية إنشاء مسارات بيع آلية بأداتنا وحيل لبيع حلنا لعملائك." },
  { title: "محتوى حصري", body: "تواصل معنا للحصول على نصائح حول كيفية إنشاء مسارات بيع آلية لعملائك باستخدام RevenueHunt وأدوات أخرى." },
  { title: "مكان في Partner Directory الخاص بنا", body: "سيجدك مستخدمونا في Partner Directory الخاص بنا وسيتواصلون معك للتعاقد على خدماتك." },
];

const faqs = [
  { q: "كم تكلفة أن تصبح شريكاً؟", a: "التسجيل مجاني تماماً. صفر. لا شيء." },
  { q: "هل يجب أن أكون عميلاً لـ RevenueHunt؟", a: "لا، لست مضطراً لأن تكون عميلاً لـ RevenueHunt لتصبح شريكاً." },
  { q: "كيف سيتم الدفع لي؟", a: "ندفع الأرباح شهرياً. تُرسل المدفوعات عبر PayPal." },
  { q: "كيف يمكنني تتبّع إحالاتي؟", a: "يمكنك الاطّلاع على إحصاءاتك في <a href='https://admin.revenuehunt.com/' target='_blank' rel='external noopener' class='font-semibold text-[#16161D] underline'>Partner Dashboard</a> الخاص بك." },
];

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "الرئيسية", url: "/" },
    { name: "الشركاء والمسوّقون بالعمولة", url: "/partners/" },
  ]),
];
---

<Base
  title="برنامج الشركاء - RevenueHunt"
  description="أحِل عملاءك. اكسب المال. احصل على عمولة مدى الحياة بنسبة 20% من العملاء الذين تحيلهم إلى RevenueHunt. سجّل مجاناً في برنامج الشركاء الخاص بنا."
  jsonLd={jsonLd}
  lang="ar"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20 text-center">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={localizedHref("/", "ar")} class="hover:text-slate-700">الرئيسية</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">الشركاء والمسوّقون بالعمولة</span>
      </nav>
      <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">برنامج الشركاء</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        أحِل عملاءك. اكسب المال.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-xl text-slate-600">
        اكسب عمولة مدى الحياة بنسبة 20% من العملاء الذين تحيلهم إلينا. سجّل اليوم مجاناً في برنامج الشركاء الخاص بنا.
      </p>
      <p class="mx-auto mt-6 max-w-3xl text-slate-600">
        إذا كنت <strong class="font-semibold text-slate-900">وكالة تسويق رقمي</strong> أو
        <strong class="font-semibold text-slate-900">متخصصاً في التجارة الإلكترونية</strong> وترغب في تنمية عملك،
        فإن برنامج الشركاء الخاص بنا مناسب لك. اصنع تجارب رائعة لعملائك مع RevenueHunt.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
        >
          ابدأ الآن
        </a>
        <a
          href="#partners"
          class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
        >
          شاهد شركاءنا
        </a>
      </div>
    </div>
  </section>

  <!-- Who you are + perks -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-1">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">من أنت</h2>
        <p class="mt-4 text-slate-600">
          أنت وكالة تسويق رقمي أو مستشار للتجارة الإلكترونية شغوف بالتصميم ومهووس بـ
          <strong class="font-semibold text-slate-900">تحقيق أفضل النتائج</strong> لعملائك. تنمّي
          عملك بدفع عجلة عمل الآخرين.
        </p>
      </div>
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">ماذا تحصل منا</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {perks.map((p) => (
            <li class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="text-base font-semibold text-slate-900">{p.title}</h3>
              <p class="mt-2 text-sm text-slate-600">{p.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Partner directory -->
  <section id="partners" class="mx-auto max-w-7xl px-6 py-16 scroll-mt-24">
    <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">شركاؤنا</h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
      تطبيقات ووكالات موثوقة تتكامل بسلاسة مع RevenueHunt لخدمة عملائك.
    </p>
    <div class="mt-12 space-y-16">
      {groups.map((g) => (
        <div>
          <div class="mb-2 flex items-baseline gap-3">
            <span class="text-2xl" aria-hidden="true">{g.emoji}</span>
            <h3 class="text-2xl font-semibold tracking-tight text-slate-900">{g.heading}</h3>
          </div>
          <p class="max-w-3xl text-slate-600">{g.intro}</p>
          <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {g.items.map((p) => (
        <li>
          <a
            href={p.url}
            target="_blank"
            rel="external noopener nofollow"
            class="group flex h-full flex-col items-center rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm transition hover:border-slate-300 hover:shadow-md"
          >
            <img
              src={p.logo}
              alt={`شعار ${p.name}`}
              loading="lazy"
              width="120"
              height="120"
              class="h-24 w-24 rounded-lg object-cover"
            />
            <h3 class="mt-5 text-lg font-semibold text-slate-900 group-hover:text-[#16161D]">{p.name}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{p.description}</p>
            <span class="mt-5 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wider text-slate-500 group-hover:text-[#16161D]">
              زيارة الموقع <span aria-hidden="true">↗</span>
            </span>
          </a>
        </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">الأسئلة الشائعة</h2>
      <div class="mx-auto mt-8 max-w-2xl">
        {faqs.map((f) => (
          <details class="border-b border-slate-200">
            <summary class="py-4 text-base font-semibold text-slate-900">{f.q}</summary>
            <p class="pb-4 text-slate-600" set:html={f.a}></p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        كن شريكاً لـ RevenueHunt
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        أحِل عملاءك، وأنشئ مسارات بيع آلية، واكسب عمولة مدى الحياة بنسبة 20% من كل ما ينفقونه.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          ابدأ الآن
        </a>
        <a
          href={localizedHref("/demo/", "ar")}
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          احجز عرضاً توضيحياً
        </a>
      </div>
    </div>
  </section>
</Base>
