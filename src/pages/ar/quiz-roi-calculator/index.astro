---
import Base from "../../../layouts/Base.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import { organization, breadcrumb, softwareApplication, faqPage } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=roi_calculator";
// Free WordPress.org plugin (not the WooCommerce.com extension).
const WOO_PLUGIN = "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";

// Inputs. The quiz-taker conversion rate carries a benchmark flag (RevenueHunt
// data badge + helper note) and is editable. The AOV uplift is NOT a visible
// input: it is set by the sector dropdown (hidden #aovlift field) from the
// within-store paired result (median +11% to +15%, concentrated in skincare/
// beauty/supplements, flat in a few categories) and folded into the math.
// Everything else is the merchant's own number.
// (Data: PRD-Octane-AI-SEO-Reverse-Engineering W7 deep-dive note.)
const controls = [
  { id: "visitors", label: "زوار المتجر الشهريون", min: 500, max: 500000, step: 500, value: 10000, suffix: "" },
  { id: "engage", label: "نسبة الزوار الذين يجرون الاختبار", min: 1, max: 100, step: 1, value: 20, suffix: "%" },
  { id: "aov", label: "متوسط قيمة الطلب لديك", min: 10, max: 1000, step: 5, value: 60, suffix: "$" },
  { id: "cvr", label: "معدل التحويل الحالي لديك", min: 0.1, max: 15, step: 0.1, value: 2, suffix: "%" },
  { id: "quizcvr", label: "معدل تحويل من يجري الاختبار", min: 1, max: 50, step: 0.5, value: 5.5, suffix: "%", benchmark: true, note: "محمّل مسبقاً بمعيارنا المقاس: في المتوسط، 1 من كل 18 شخصاً يجرون الاختبار يقدّمون طلباً. حرّره ليتطابق مع متجرك." },
];

// Sector presets for the "what do you sell?" selector. Each sets the quiz-taker
// conversion rate and AOV uplift from measured RevenueHunt data, plus a "% of the
// average store" figure (quiz rate / a 2% average). "All sectors" is the 5.5%
// platform average (= 275%, the brand stat). "Other sectors" is the honest
// residual (everything except the consumable stars), measured at ~3.6% (~180%).
// Selecting a sector pre-fills quizcvr + aovlift; both stay editable.
// (Data: PRD-Octane-AI-SEO-Reverse-Engineering W7 deep-dive note.)
const SECTORS = [
  { id: "all", label: "جميع القطاعات (المتوسط)", quizcvr: 5.5, aovlift: 10, pct: 275 },
  { id: "haircare", label: "العناية بالشعر", quizcvr: 7, aovlift: 15, pct: 350 },
  { id: "fragrance", label: "العطور", quizcvr: 7, aovlift: 0, pct: 350 },
  { id: "beauty", label: "الجمال والعناية بالبشرة", quizcvr: 6, aovlift: 20, pct: 300 },
  { id: "supplements", label: "المكملات الغذائية والصحة", quizcvr: 6, aovlift: 10, pct: 300 },
  { id: "coffee", label: "القهوة والشاي", quizcvr: 5, aovlift: 0, pct: 250 },
  { id: "other", label: "قطاعات أخرى", quizcvr: 3.6, aovlift: 10, pct: 180 },
];

// Per-vertical conversion (response to order), measured in RevenueHunt data and
// rounded down. The 5.5% benchmark is a platform average; consumable categories
// run higher. Shown as a "conversion by category" proof block.
const BY_VERTICAL = [
  { v: "العناية بالشعر", pct: "350%", lift: "+15% AOV" },
  { v: "العطور", pct: "350%", lift: "AOV دون تغيير" },
  { v: "العناية بالبشرة والجمال", pct: "300%", lift: "+20% AOV" },
  { v: "المكملات الغذائية", pct: "300%", lift: "+10% AOV" },
  { v: "القهوة والشاي", pct: "250%", lift: "AOV دون تغيير" },
  { v: "قطاعات أخرى", pct: "180%", lift: "+10% AOV" },
];

// Real, data-backed proof points shown on the page. The 275% is the measured
// 5.5% quiz-taker conversion (1 in 18) expressed against a typical 2% store
// rate: 5.5 / 2 = 2.75x = 275% of baseline (accurate as "of", not "+lift").
const PROOF = [
  { stat: "45M+", label: "إجابة اختبار تم تحليلها" },
  { stat: "275%", label: "من متوسط معدل التحويل" },
  { stat: "$370M+", label: "إيرادات تم توليدها للتجار" },
  { stat: "20,000+", label: "علامة تجارية تستخدم RevenueHunt" },
];

const faqs: { question: string; answer: string; answerHtml?: string }[] = [
  {
    question: "من أين يأتي معدل تحويل الاختبار؟",
    answer:
      "إنه معيار من بيانات RevenueHunt الحقيقية. في مجموعة إجابات الاختبار، فإن 5.5% من المتسوقين الذين يكملون اختباراً (حوالي 1 من كل 18) ينتهي بهم الأمر بتقديم طلب مقاس. الحقل محمّل مسبقاً بذلك المعيار، ويمكنك تحريره ليتطابق مع متجرك الخاص.",
  },
  {
    question: "كيف تُحسب الإيرادات الإضافية؟",
    answer:
      "تأخذ الآلة الحاسبة نسبة زوارك الذين يكملون الاختبار، وتطبق عليهم معدل تحويل من يجري الاختبار، وتقارنها بالتحويل الذي سيحققه هؤلاء الزوار أنفسهم وفق المعدل الحالي لموقعك. الفرق، مضروباً في متوسط قيمة طلبك، هو الإيرادات الإضافية المقدّرة.",
  },
  {
    question: "هل ينفق المتسوقون الذين يجرون الاختبار أكثر لكل طلب؟",
    answer:
      "في المتوسط، نعم، عند المقارنة بالمثل. داخل المتجر نفسه، تكون الطلبات التي وصلت عبر اختبار أعلى بحوالي 10% من تلك التي لم تصل عبره. ليس الأمر متساوياً في كل مكان: أقوى في فئات مثل العناية بالبشرة والجمال والمكملات الغذائية، وتقريباً دون تغيير في فئات أخرى. تأخذ الآلة الحاسبة ذلك في الاعتبار تلقائياً وفقاً للقطاع الذي تختاره.",
  },
  {
    question: "هل يستند هذا إلى بيانات حقيقية أم إلى مضاعفات مختلقة؟",
    answer:
      "بيانات حقيقية. معيار تحويل الاختبار مقاس على أكثر من 45 مليون إجابة اختبار وأكثر من 370 مليون دولار من الإيرادات المولّدة للتجار. زوارك ومتوسط قيمة طلبك ومعدل التحويل الحالي لديك هي أرقامك الخاصة. النتيجة تقدير، لا ضمان.",
  },
  {
    question: "أين يمكنني الاطّلاع على جميع البيانات وراء هذه المعايير؟",
    answer:
      "في تقرير معايير اختبارات التجارة الإلكترونية الخاص بنا. يفصّل التحويل حسب الفئة، وزيادة متوسط قيمة الطلب، والإكمال، والإسناد عبر أكثر من 45M إجابة اختبار حقيقية. معيار الـ 5.5% والأرقام حسب القطاع في هذه الآلة الحاسبة مأخوذة منه مباشرة.",
    answerHtml:
      "في <a href=\"" + localizedHref("/state-of-product-recommendation-quizzes/", "ar") + "\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">تقرير معايير اختبارات التجارة الإلكترونية الخاص بنا</a>. يفصّل التحويل حسب الفئة، وزيادة متوسط قيمة الطلب، والإكمال، والإسناد عبر أكثر من 45M إجابة اختبار حقيقية. معيار الـ 5.5% والأرقام حسب القطاع في هذه الآلة الحاسبة مأخوذة منه مباشرة.",
  },
  {
    question: "هل الآلة الحاسبة مجانية؟",
    answer:
      "نعم. إنها مجانية وبلا حواجز، لا حاجة إلى بريد إلكتروني. RevenueHunt نفسه لديه أيضاً خطة مجانية بـ 100 إجابة اختبار شهرياً، حتى تتمكن من قياس الزيادة الحقيقية في متجرك الخاص.",
  },
];

const jsonLd = [
  organization(),
  softwareApplication(),
  breadcrumb([
    { name: "الرئيسية", url: "/" },
    { name: "حاسبة ROI الاختبار", url: "/quiz-roi-calculator/" },
  ]),
  faqPage(faqs),
];
---

<Base
  title="حاسبة ROI الاختبار للتجارة الإلكترونية"
  description="حاسبة ROI الاختبار مجانية مبنية على بيانات حقيقية: 5.5% ممن يجرون الاختبار يقدّمون طلباً. قدّر الإيرادات الإضافية والـ ROI الذي يمكن أن يحققه اختبار لمتجرك."
  ogImage="/og/quiz-roi-calculator.png"
  jsonLd={jsonLd}
  lang="ar"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <Breadcrumb items={[{ label: "الرئيسية", href: localizedHref("/", "ar") }, { label: "حاسبة ROI الاختبار" }]} />
      <div class="text-center">
        <Eyebrow>أداة مجانية</Eyebrow>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">حاسبة ROI الاختبار</h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          اكتشف الإيرادات الإضافية التي يمكن أن يحققها اختبار التوصية بالمنتجات لمتجرك. معيار التحويل البالغ 275% حقيقي، <a href={localizedHref("/state-of-product-recommendation-quizzes/", "ar")} class="font-semibold text-[#16161D] underline decoration-2 decoration-[#16161D]/40 underline-offset-2 hover:decoration-[#16161D]">مقاس على أكثر من 45M إجابة اختبار</a>، وليس مضاعفاً مختلقاً. عدّل البيانات لتتطابق مع أرقامك.
        </p>
      </div>
    </div>
  </section>

  <!-- Real-data proof band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-8">
      <div class="rounded-2xl bg-[#16161D] px-6 py-10 sm:px-10">
        <p class="text-center text-sm font-semibold uppercase tracking-wider text-white/50">مبني على بيانات RevenueHunt الحقيقية</p>
        <dl class="mt-6 grid grid-cols-2 gap-8 text-center sm:grid-cols-4">
          {PROOF.map((p) => (
            <div>
              <dt class="text-3xl font-bold tracking-tight text-white">{p.stat}</dt>
              <dd class="mt-1 text-sm text-white/70">{p.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- Calculator -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 pb-8 pt-10">
      <div class="grid gap-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm lg:grid-cols-2 lg:p-8">
        <!-- Inputs -->
        <form id="roi-form" class="space-y-6" aria-label="بيانات ROI الاختبار">
          <div>
            <label for="sector" class="text-sm font-medium text-slate-900">ماذا تبيع؟</label>
            <select
              id="sector"
              class="mt-2 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-900 focus:border-[#16161D] focus:outline-none focus:ring-1 focus:ring-[#16161D]"
            >
              {SECTORS.map((s) => (
                <option value={s.id} data-quizcvr={s.quizcvr} data-aovlift={s.aovlift} data-pct={s.pct}>{s.label}</option>
              ))}
            </select>
            <p class="mt-2 rounded-md bg-[#D8F0FE] px-3 py-2 text-xs text-[#2c81b2] ring-1 ring-inset ring-[#2c81b2]/20">
              <span id="sector-note">في مجموعة اختبارات RevenueHunt، يحوّل من يجرون الاختبار بنحو 275% من المتجر المتوسط ويقدّمون طلبات أكبر بحوالي 10%. اختر قطاعك للحصول على معيار أكثر دقة.</span>
            </p>
          </div>
          {controls.map((c) => (
            <div>
              <div class="flex items-center justify-between gap-3">
                <label for={c.id} class="text-sm font-medium text-slate-900">
                  {c.label}
                </label>
                <div class="flex items-center gap-1 text-sm">
                  {c.suffix === "$" && <span class="text-slate-500">$</span>}
                  <input
                    type="number"
                    id={c.id}
                    min={c.min}
                    max={c.max}
                    step={c.step}
                    value={c.value}
                    class="w-24 rounded-md border border-slate-300 px-2 py-1 text-right font-semibold text-slate-900 focus:border-[#16161D] focus:outline-none focus:ring-1 focus:ring-[#16161D]"
                  />
                  {c.suffix === "%" && <span class="text-slate-500">%</span>}
                </div>
              </div>
              <input
                type="range"
                id={`${c.id}-range`}
                min={c.min}
                max={c.max}
                step={c.step}
                value={c.value}
                class="mt-3 w-full accent-[#16161D]"
                aria-label={`${c.label} slider`}
              />
              {c.note && (
                <p class="mt-2 text-xs text-slate-500">
                  <span id={`${c.id}-note`}>{c.note}</span>
                  {c.benchmark && (
                    <>
                      {" "}
                      <button
                        type="button"
                        id={`${c.id}-reset`}
                        class="hidden font-medium text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-[#16161D]"
                      >
                        إعادة التعيين إلى بيانات RevenueHunt
                      </button>
                    </>
                  )}
                </p>
              )}
            </div>
          ))}
          <!-- AOV uplift is not user-editable: the sector dropdown sets it. -->
          <input type="hidden" id="aovlift" value="10" />
        </form>

        <!-- Results -->
        <div class="flex flex-col gap-4 rounded-xl bg-slate-50 p-6">
          <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">الأثر المقدّر</p>
          <div>
            <p class="text-sm text-slate-600">إيرادات إضافية شهرياً</p>
            <p id="out-monthly" class="mt-1 text-4xl font-bold tracking-tight text-[#16161D]">$0</p>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div class="rounded-lg border border-slate-200 bg-white p-4">
              <p class="text-xs text-slate-600">إيرادات إضافية سنوياً</p>
              <p id="out-annual" class="mt-1 text-xl font-bold text-slate-900">$0</p>
            </div>
            <div class="rounded-lg border border-slate-200 bg-white p-4">
              <p class="text-xs text-slate-600">طلبات إضافية شهرياً</p>
              <p id="out-orders" class="mt-1 text-xl font-bold text-slate-900">0</p>
            </div>
          </div>
          <dl class="mt-2 space-y-1 text-sm text-slate-600">
            <div class="flex justify-between">
              <dt>الأشخاص الذين يجرون الاختبار شهرياً</dt>
              <dd id="out-takers" class="font-medium text-slate-900">0</dd>
            </div>
            <div class="flex justify-between">
              <dt>طلبات الاختبار شهرياً</dt>
              <dd id="out-quizorders" class="font-medium text-slate-900">0</dd>
            </div>
            <div class="flex justify-between">
              <dt>الإيرادات الشهرية الأساسية</dt>
              <dd id="out-baseline" class="font-medium text-slate-900">$0</dd>
            </div>
            <div class="flex justify-between">
              <dt>مع اختبار</dt>
              <dd id="out-withquiz" class="font-medium text-slate-900">$0</dd>
            </div>
          </dl>
          <a
            href={SHOPIFY_INSTALL}
            target="_blank"
            rel="external noopener nofollow"
            onclick="window.gtag&&gtag('event','shopify_app_install',{event_label:'roi_calculator'})"
            class="mt-2 inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
          >
            التثبيت على Shopify
          </a>
          <a
            href={WOO_PLUGIN}
            target="_blank"
            rel="external noopener nofollow"
            onclick="window.gtag&&gtag('event','woocommerce_plugin_click',{event_label:'roi_calculator'})"
            class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
          >
            التثبيت على WooCommerce
          </a>
        </div>
      </div>
      <p class="mt-4 text-xs text-slate-500">
        معدل تحويل من يجري الاختبار هو معيار يمكنك تحريره، وتُطبّق زيادة الـ AOV تلقائياً وفقاً لقطاعك؛ كلاهما يأتي من بيانات RevenueHunt الحقيقية وسيختلف متجرك. الزوار ومتوسط قيمة الطلب ومعدل التحويل الحالي هي أرقامك الخاصة. هذا تقدير، لا ضمان، والنتائج الفعلية تعتمد على متجرك وحركة مرورك واختبارك.
      </p>
    </div>
  </section>

  <!-- Recommended plan + ROI -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 pb-14">
      <div class="rounded-2xl border-2 border-[#16161D] bg-slate-50 p-6 sm:p-8">
        <p class="text-center text-sm font-semibold uppercase tracking-wider text-slate-500">خطتك الموصى بها والـ ROI</p>
        <div class="mt-5 grid gap-6 sm:grid-cols-3">
          <div class="rounded-xl border border-slate-200 bg-white p-5">
            <p class="text-xs text-slate-600">إجابات الاختبار المقدّرة / شهر</p>
            <p id="out-responses" class="mt-1 text-3xl font-bold tracking-tight text-slate-900">0</p>
          </div>
          <div class="rounded-xl border border-slate-200 bg-white p-5">
            <p class="text-xs text-slate-600">الخطة الموصى بها</p>
            <p id="out-plan" class="mt-1 text-3xl font-bold tracking-tight text-slate-900">Free Plan</p>
            <p id="out-plancost" class="text-sm text-slate-600">مجاني</p>
          </div>
          <div class="rounded-xl border border-slate-200 bg-white p-5">
            <p class="text-xs text-slate-600">العائد على تكلفة الخطة</p>
            <p id="out-roi" class="mt-1 text-3xl font-bold tracking-tight text-emerald-600">-</p>
            <p id="out-net" class="text-sm text-slate-600"></p>
          </div>
        </div>
        <p class="mt-5 text-center text-sm text-slate-700"><span id="plan-note"></span> <a href={localizedHref("/pricing/", "ar")} class="font-medium text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-[#16161D]">شاهد جميع الخطط</a>.</p>
        <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
          <a
            href={SHOPIFY_INSTALL}
            target="_blank"
            rel="external noopener nofollow"
            onclick="window.gtag&&gtag('event','shopify_app_install',{event_label:'roi_calculator_plan'})"
            class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
          >
            ابدأ مجاناً على Shopify
          </a>
          <a
            href={WOO_PLUGIN}
            target="_blank"
            rel="external noopener nofollow"
            onclick="window.gtag&&gtag('event','woocommerce_plugin_click',{event_label:'roi_calculator_plan'})"
            class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
          >
            ابدأ مجاناً على WooCommerce
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Conversion by category -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 pb-14">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
        <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">زيادة معدل التحويل حسب القطاع</h2>
        <p class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
          مقارنةً بمتجر نموذجي بمعدل 2%، يحوّل من يجرون اختبار RevenueHunt أضعافاً عدة. إليك كل فئة كنسبة مئوية من ذلك المتوسط، مع زيادة قيمة الطلب حيثما نراها.
        </p>
        <dl class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-xl bg-slate-200 sm:grid-cols-3 lg:grid-cols-6">
          {BY_VERTICAL.map((b) => (
            <div class="bg-white px-4 py-6 text-center">
              <dt class="text-3xl font-bold tracking-tight text-[#16161D]">{b.pct}</dt>
              <dd class="mt-1 text-sm text-slate-600">{b.v}</dd>
              <dd class={`mt-2 text-xs font-medium ${b.lift.startsWith("+") ? "text-emerald-700" : "text-slate-400"}`}>{b.lift}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-4 text-center text-xs text-slate-500">
          معروض كنسبة مئوية من معدل تحويل متجر نموذجي بنسبة 2%، مقاس في بياناتنا. سيختلف متجرك.
        </p>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">كيف تعمل الآلة الحاسبة</h2>
      <div class="mt-8 space-y-5 text-lg text-slate-700">
        <p>
          النموذج بسيط وصادق عن قصد. يأخذ نسبة زوارك الذين يكملون الاختبار، ويحوّلهم بمعدل من يجري الاختبار، ويقارنه بما كان سيفعله هؤلاء الزوار أنفسهم وفق <a href="/glossary/conversion-rate-optimization/" class="font-medium text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-[#16161D]">معدل التحويل</a> الحالي لموقعك. الفرق هو الإيرادات الإضافية المقدّرة.
        </p>
        <p>
          وفقاً للبيانات المجمّعة عبر أكثر من 45 مليون إجابة اختبار حقيقية، فإن 5.5% من المتسوقين الذين يكملون اختبار RevenueHunt (حوالي 1 من كل 18) يقدّمون طلباً مقاساً. مقابل معدل تحويل متجر نموذجي بنسبة 2%، فإن ذلك 2.75x، نحو 275% مما يحوّله المتجر عادة. نحمّل ذلك الرقم مسبقاً ونترك لك تحريره.
        </p>
        <p>
          حلّلنا أيضاً قيمة الطلب. عند المقارنة بالمثل، داخل المتجر نفسه، تكون طلبات الاختبار أعلى بحوالي 10% من الطلبات دون اختبار. الزيادة أقوى في فئات مثل العناية بالبشرة والجمال والمكملات الغذائية، وتقريباً دون تغيير في بعض الفئات الأخرى. تطبّق الآلة الحاسبة زيادة متحفظة ومدعومة بالبيانات وفقاً للقطاع الذي تختاره، حتى لا تضطر إلى التخمين.
        </p>
        <p>
          تستخدم الآلة الحاسبة <a href="/glossary/average-order-value/" class="font-medium text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-[#16161D]">متوسط قيمة طلبك</a> الخاص وتتجاهل العملاء المحتملين عبر البريد الإلكتروني وبيانات zero-party التي يلتقطها الاختبار، والتي تتراكم بمرور الوقت، لذا فهي تميل إلى التقليل من القيمة الإجمالية.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900">الأسئلة الشائعة</h2>
      <div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
        {faqs.map((faq) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-lg font-semibold text-slate-900 [&::-webkit-details-marker]:hidden">
              <span>{faq.question}</span>
              <svg
                class="h-5 w-5 flex-shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <p class="pb-5 text-slate-700" set:html={faq.answerHtml ?? faq.answer} />
