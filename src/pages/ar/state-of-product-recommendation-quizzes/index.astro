---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb, article, faqPage } from "../../../lib/schema";
import { SITE } from "../../../lib/site";
import { localizedHref } from "../../../lib/i18n";
import {
  REPORT,
  DATASET,
  HEADLINE,
  VERTICAL_CONVERSION,
  AOV_UPLIFT,
  ATTRIBUTION,
  BASELINES,
} from "../../../lib/quiz-benchmarks";

const pageUrl = new URL(`/${REPORT.slug}/`, SITE.site_url).href;
const ogImage = `/og/${REPORT.slug}.png`;

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=state_of_product_quizzes";
// Free WordPress.org plugin (not the WooCommerce.com extension).
const WOO_PLUGIN =
  "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";

const formatN = (n: number | null) =>
  n === null ? "" : n.toLocaleString("en-US");

// Conversion expressed against a typical 2% store: 6.9% / 2% = 345%.
const boost = (rate: number) => Math.round((rate / HEADLINE.baselinePct) * 100);

// Translated methodology + FAQ (the shared data module stays English for the PDF
// and stat cards). Defined before jsonLd so faqPage(FAQ) uses the translated set.
const METHODOLOGY = [
  "المصدر: منصة RevenueHunt نفسها، عبر كل منصة تجارة إلكترونية ندعمها. مجمّعة ومجهّلة الهوية: لا يمكن التعرّف على أي متجر فردي، ومتاجرنا التجريبية مستبعدة في كل مكان.",
  "التحويل معدل لكل شخص يجري الاختبار: الطلبات المنسوبة إلى إجابة اختبار، مقسومة على الاختبارات المكتملة. وهو ليس معدلاً على مستوى الموقع بالكامل. من يجرون الاختبار يختارون أنفسهم وأكثر تفاعلاً من الزائر المتوسط، لذا فهذه ليست مقارنة متكافئة مع معدل التحويل الإجمالي للمتجر. ونقول ذلك أينما أجرينا المقارنة.",
  "تُشتق الفئة من اسم الاختبار الذي كتبه التاجر (مثل \"اختبار العناية بالبشرة\"، \"اختبار طعام الكلاب\"). نحو 78% من الإجابات تأتي من اختبارات عامة أو بلا اسم وتُستبعد من كل رقم حسب الفئة.",
  "تُقاس الزيادة في average order value داخل المتجر: وسيط قيمة طلب الاختبار في المتجر نفسه مقابل وسيط قيمة طلبه دون اختبار. وهذا متين أمام العملة ويزيل تحيّز مزيج المتاجر الذي يطمس الأثر في متوسط ساذج على مستوى المنصة بأكملها.",
  "كل رقم تحويل هو حد أدنى. لا يزال الإسناد يتراكم مع مزامنة التجار للطلبات (9% من الطلبات الأولى تصل بعد أكثر من 30 يوماً من الاختبار)، والطلبات عبر الأجهزة أو غير المتعقَّبة لا تُسند أبداً. الأرقام الفعلية أعلى، لا أدنى.",
];

const FAQ = [
  {
    question: "كيف يُقاس تحويل الاختبار؟",
    answer:
      "الطلبات المنسوبة إلى إجابة اختبار، مقسومة على الاختبارات المكتملة. عبر المنصة، 5.5% من المتسوقين الذين ينهون اختباراً (نحو 1 من كل 18) يقدّمون طلباً متعقَّباً. وهو معدل لكل شخص يجري الاختبار، لا معدل على مستوى الموقع بالكامل: من يجرون الاختبار أكثر تفاعلاً من الزائر المتوسط، لذا فهو غير قابل للمقارنة مباشرةً مع معدل التحويل الإجمالي للمتجر.",
  },
  {
    question: "لماذا معدل تحويل الاختبار أعلى بكثير من المتجر المتوسط؟",
    answer:
      "سببان. أولاً، الاختبار نفسه: يستبدل كتالوجاً مُربكاً بمحادثة قصيرة وتوصية واضحة، مما يزيل التردد الذي يُسرّب المبيعات. ثانياً، ما يحدث بعد وصول الإجابات: كل اختبار يلتقط zero-party data ويصنّف المتسوق، مما يشغّل تدفقات متابعة مقسّمة وإعادة استهداف. تكسب الحملات المقسّمة أكثر من 3 أضعاف الإيرادات لكل مستلم مقارنة بالإرسالات العامة (معيار التقسيم من Klaviyo)، لذا يظل الاختبار يحقق التحويل عبر البريد الإلكتروني والإعلانات المخصصة، لا في صفحة النتائج فقط.",
    answerHtml:
      "سببان. أولاً، الاختبار نفسه: يستبدل كتالوجاً مُربكاً بمحادثة قصيرة وتوصية واضحة، مما يزيل التردد الذي يُسرّب المبيعات. ثانياً، ما يحدث بعد وصول الإجابات: كل اختبار يلتقط zero-party data ويصنّف المتسوق، مما يشغّل تدفقات متابعة مقسّمة وإعادة استهداف. تكسب الحملات المقسّمة أكثر من 3 أضعاف الإيرادات لكل مستلم مقارنة بالإرسالات العامة (<a href=\"https://www.klaviyo.com/marketing-resources/segmentation-benchmark-report\" target=\"_blank\" rel=\"external noopener nofollow\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">معيار التقسيم من Klaviyo</a>)، لذا يظل الاختبار يحقق التحويل عبر البريد الإلكتروني والإعلانات المخصصة، لا في صفحة النتائج فقط.",
  },
  {
    question: "هل ينفق متسوقو الاختبار فعلاً أكثر لكل طلب؟",
    answer:
      "في المتوسط، نعم، مقاساً بشكل متكافئ. داخل المتجر نفسه، تكون الطلبات التي جاءت عبر اختبار أكبر بنحو 11% إلى 15% من الطلبات التي لم تأتِ عبره، وهذا يصمد في نحو 7 من كل 10 متاجر. لكنه ليس شاملاً: أقوى في الجمال والعناية بالبشرة (نحو +20%)، وأكثر استواءً في فئات مثل العطور والقهوة.",
  },
  {
    question: "كيف تنطبق هذه المعايير على متجري؟",
    answer:
      "أدخل حركة المرور الخاصة بك، ومتوسط قيمة الطلب، ومعدل التحويل الحالي في حاسبة ROI الاختبار الخاصة بنا. تشغّل هذه المعايير نفسها (معدل 5.5% لكل شخص يجري الاختبار، والتحويل حسب الفئة، والزيادة في AOV) مقابل أرقامك لتقدير الإيراد الإضافي الذي يمكن أن يضيفه اختبار.",
    answerHtml:
      "أدخل حركة المرور الخاصة بك، ومتوسط قيمة الطلب، ومعدل التحويل الحالي في <a href=\"/ar/quiz-roi-calculator/\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">حاسبة ROI الاختبار</a> الخاصة بنا. تشغّل هذه المعايير نفسها (معدل 5.5% لكل شخص يجري الاختبار، والتحويل حسب الفئة، والزيادة في AOV) مقابل أرقامك لتقدير الإيراد الإضافي الذي يمكن أن يضيفه اختبار.",
  },
  {
    question: "هل البيانات مجهّلة الهوية؟",
    answer:
      "نعم. كل رقم مجمّع وموحّد عبر ملايين الإجابات وآلاف المتاجر. لا يمكن التعرّف على أي متجر فردي. يوجد التقرير لمشاركة ما تقوله البيانات، لا لكشف أي تاجر.",
  },
  {
    question: "هل يمكنني استخدام هذه الأرقام؟",
    answer:
      "نعم. اذكرها مع رابط إلى هذه الصفحة. التقرير مجاني وغير محجوب، ويمكن تنزيل ملف PDF، والأرقام البارزة متاحة كبطاقات قابلة للمشاركة.",
  },
];

const pageTitle = "حالة اختبارات التوصية بالمنتجات: تقرير المقارنة المعيارية 2026";
const pageDescription = "كيف تؤدي اختبارات التوصية بالمنتجات فعليًا: التحويل والإكمال ومتوسط قيمة الطلب، استنادًا إلى أكثر من 45 مليون إجابة حقيقية عبر أكثر من 20,000 متجر للتجارة الإلكترونية.";

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "الرئيسية", url: localizedHref("/", "ar") },
    { name: "حالة اختبارات التوصية بالمنتجات", url: localizedHref(`/${REPORT.slug}/`, "ar") },
  ]),
  article({
    title: pageTitle,
    description: pageDescription,
    url: pageUrl,
    image: ogImage,
    datePublished: REPORT.datePublished,
    dateModified: REPORT.dateModified,
    author: "RevenueHunt",
    tags: [
      "معايير اختبار التوصية بالمنتجات",
      "quiz conversion rate",
      "ecommerce personalization",
      "average order value",
    ],
  }),
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "RevenueHunt معايير اختبار التوصية بالمنتجات 2026",
    description: pageDescription,
    url: pageUrl,
    creator: organization(),
    license: "https://creativecommons.org/licenses/by/4.0/",
    isAccessibleForFree: true,
    datePublished: REPORT.datePublished,
    keywords: [
      "اختبار التوصية بالمنتجات",
      "conversion rate",
      "average order value",
      "ecommerce",
      "Shopify",
    ],
    distribution: {
      "@type": "DataDownload",
      encodingFormat: "application/pdf",
      contentUrl: new URL(REPORT.pdfPath, SITE.site_url).href,
    },
  },
  faqPage(FAQ),
];

const publishedLabel = new Date(REPORT.datePublished).toLocaleDateString("ar", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

// Category/vertical labels and the two long table notes, translated. Numbers stay
// from the shared data module; only the human-readable labels/notes are localized.
const VERT_LABEL: Record<string, string> = {
  "Fragrance": "العطور",
  "Haircare": "العناية بالشعر",
  "Supplements & health": "المكمّلات والصحة",
  "Beauty & skincare": "الجمال والعناية بالبشرة",
  "Coffee & tea": "القهوة والشاي",
  "CBD": "CBD",
  "Other sectors": "قطاعات أخرى",
  "All quiz categories (pooled)": "كل فئات الاختبار (موحّدة)",
};
const GROUPED_NOTE =
  "كل ما هو خارج الفئات المسمّاة، بما في ذلك الاختبارات العامة والأعلى تفكيراً. مقاس عند نحو 3.6%، أي نحو 180% من متجر نموذجي.";
const POOLED_NOTE =
  "عنوان المنصة الرئيسي: 5.5% (1 من كل 18)، أي نحو 275% من متجر نموذجي بنسبة 2%. الاختبارات العامة بلا اسم (~78% من الإجابات) مستبعدة من صفوف الفئات وتجرّ الرقم الإجمالي إلى الأسفل نحو 4%.";
const SCOPE: Record<string, string> = {
  "Statista": "عالمي، 2025",
  "IRP Commerce": "بيانات تجار حيّة في المملكة المتحدة/أيرلندا، 2025",
  "Dynamic Yield": "أكثر من 400 علامة متوسطة إلى كبيرة، 2025",
  "Shopify": "الإرشادات المنشورة من Shopify نفسها",
};
const tr = <T extends { vertical: string }>(r: T) => ({ ...r, vertical: VERT_LABEL[r.vertical] ?? r.vertical });
const consumable = VERTICAL_CONVERSION.filter((r) => r.kind === "consumable").map(tr);
const considered = VERTICAL_CONVERSION.filter((r) => r.kind === "considered").map(tr);
const grouped = { ...tr(VERTICAL_CONVERSION.find((r) => r.kind === "grouped")!), note: GROUPED_NOTE };
const pooled = { ...tr(VERTICAL_CONVERSION.find((r) => r.kind === "total")!), note: POOLED_NOTE };
const aovRows = AOV_UPLIFT.perVertical.map(tr);
const baselines = BASELINES.map((b) => ({ ...b, scope: SCOPE[b.source] ?? b.scope }));
---

<Base
  title={pageTitle}
  description={pageDescription}
  ogImage={ogImage}
  jsonLd={jsonLd}
  lang="ar"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={localizedHref("/", "ar")} class="hover:text-slate-700">الرئيسية</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">حالة اختبارات التوصية بالمنتجات</span>
      </nav>
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">
          تقرير معايير · {publishedLabel}
        </p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          حالة اختبارات التوصية بالمنتجات
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          1 من كل 18 متسوقاً ينهون اختبار توصية بالمنتجات يقدّم طلباً، <strong>2.75 مرة أكثر من متجر إلكتروني نموذجي</strong>. يفصّل هذا التقرير أي الفئات تحوّل أكثر، وكم ينفق متسوقو الاختبار أكثر، ولكم من الوقت يظل اختبار واحد يحقق عائداً. مبني على بيانات حقيقية من <strong>{DATASET.responses} إجابة اختبار</strong> عبر {DATASET.brands} متجراً.
        </p>
        {/* TODO: restore hero CTAs ("Download the PDF" + "Read the findings")
            once a peer reviews the PDF design. Removed 2026-06-08 to hold the
            PDF download until that review. The PDF is still generated and the
            "Cite this report" section's download link is also held (see below). */}
      </div>
    </div>
  </section>

  <!-- Dataset band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-2xl bg-[#16161D] px-6 py-10 sm:px-10">
        <p class="text-center text-sm font-semibold uppercase tracking-wider text-white/50">
          مجموعة البيانات
        </p>
        <dl class="mt-6 grid grid-cols-1 gap-8 text-center sm:grid-cols-3">
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.responses}</dt>
            <dd class="mt-1 text-sm text-white/70">إجابة اختبار جرى تحليلها</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.revenue}</dt>
            <dd class="mt-1 text-sm text-white/70">من الإيرادات التي تحققت للتجار</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.brands}</dt>
            <dd class="mt-1 text-sm text-white/70">متجر تجارة إلكترونية</dd>
          </div>
        </dl>
        <p class="mx-auto mt-6 max-w-3xl text-center text-sm text-white/60">
          مجمّعة ومجهّلة الهوية، عبر Shopify و WooCommerce و BigCommerce و Magento ومنصات مستقلة. لا يمكن التعرّف على أي متجر فردي. كل رقم أدناه هو حد أدنى: لا يزال الإسناد يتراكم، لذا فإن الأرقام الفعلية أعلى.
        </p>
      </div>
    </div>
  </section>

  <!-- Key findings (stat cards) -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">الأرقام البارزة</h2>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">{HEADLINE.completedConv}%</p>
          <p class="mt-2 font-medium text-slate-900">من المتسوقين الذين ينهون اختباراً يقدّمون طلباً</p>
          <p class="mt-2 text-sm text-slate-600">حوالي 1 من كل {HEADLINE.completedOneIn}، نحو {HEADLINE.multiple} مرة متجراً نموذجياً بنسبة {HEADLINE.baselinePct}%.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">+{AOV_UPLIFT.headlineLow}-{AOV_UPLIFT.headlineHigh}%</p>
          <p class="mt-2 font-medium text-slate-900">زيادة في average order value، داخل المتجر نفسه</p>
          <p class="mt-2 text-sm text-slate-600">مقاسة بشكل متكافئ، حاضرة في نحو 7 من كل 10 متاجر.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">{HEADLINE.completionRate}%</p>
          <p class="mt-2 font-medium text-slate-900">من المتسوقين الذين يبدؤون اختباراً ينهونه</p>
          <p class="mt-2 text-sm text-slate-600">حوالي 7 من كل 10 يصلون إلى صفحة النتائج. والـ {HEADLINE.abandonRate}% يغادرون قبل ذلك.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">1 من كل 5</p>
          <p class="mt-2 font-medium text-slate-900">طلبات منسوبة إلى الاختبار تصل بعد أكثر من 30 يوماً</p>
          <p class="mt-2 text-sm text-slate-600">يظل الاختبار يولّد إيرادات لأشهر بعد إجرائه.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Conversion by category -->
  <section id="conversion" class="scroll-mt-20 bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">التحويل حسب الفئة</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        يُخفي متوسط المنصة تشتتاً واسعاً. <strong>الفئات الاستهلاكية والقابلة لإعادة التعبئة تحوّل من مرتين إلى ثلاث مرات أكثر</strong> من المتجر الإلكتروني المتوسط. أما المشتريات عالية السعر وعالية التفكير فتحوّل بدرجة أقل بمقدار كبير: هناك يدفع الاختبار الاكتشاف، لكن البيع يأتي لاحقاً، خارج الجلسة.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">الفئة</th>
              <th class="py-3 pr-4 text-right font-semibold">التحويل</th>
              <th class="py-3 pr-4 text-right font-semibold">زيادة تحويل الاختبار</th>
              <th class="py-3 text-right font-semibold">الإجابات</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {consumable.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{r.rate}%</td>
                <td class="py-3 pr-4 text-right tabular-nums text-slate-600">{boost(r.rate)}%</td>
                <td class="py-3 text-right tabular-nums text-slate-500">{formatN(r.n)}</td>
              </tr>
            ))}
            {considered.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{r.rate}%</td>
                <td class="py-3 pr-4 text-right tabular-nums text-slate-600">{boost(r.rate)}%</td>
                <td class="py-3 text-right tabular-nums text-slate-500">{formatN(r.n)}</td>
              </tr>
            ))}
            <tr class="border-b border-slate-200">
              <td class="py-3 pr-4 font-medium">{grouped.vertical}</td>
              <td class="py-3 pr-4 text-right font-semibold tabular-nums">~{grouped.rate}%</td>
              <td class="py-3 pr-4 text-right tabular-nums text-slate-600">~{boost(grouped.rate)}%</td>
              <td class="py-3 text-right tabular-nums text-slate-500">{formatN(grouped.n)}</td>
            </tr>
            <tr class="border-t-2 border-slate-300">
              <td class="py-3 pr-4 font-semibold">{pooled.vertical}</td>
              <td class="py-3 pr-4 text-right font-bold tabular-nums">{pooled.rate}%</td>
              <td class="py-3 pr-4 text-right font-bold tabular-nums text-slate-600">{boost(pooled.rate)}%</td>
              <td class="py-3 text-right tabular-nums text-slate-500">الكل</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        {grouped.note}
      </p>
      <p class="mx-auto mt-2 max-w-3xl text-sm text-slate-500 text-center">
        {pooled.note}
      </p>
    </div>
  </section>

  <!-- AOV uplift -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">هل ينفق متسوقو الاختبار أكثر؟</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        <strong>مقاسةً داخل المتجر نفسه</strong>، تكون طلبات الاختبار <strong>أكبر بنسبة {AOV_UPLIFT.headlineLow}% إلى {AOV_UPLIFT.headlineHigh}%</strong> من الطلبات دون اختبار، وذلك يصمد في {AOV_UPLIFT.storesUpLow}% إلى {AOV_UPLIFT.storesUpHigh}% من المتاجر. ليس الأمر شاملاً: أقوى حيث يمكن للاختبار تجميع مجموعة أو روتين، وتقريباً دون تغيير حيث يكون الشراء عنصراً واحداً.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">الفئة</th>
              <th class="py-3 pr-4 text-right font-semibold">زيادة AOV داخل المتجر</th>
              <th class="py-3 text-right font-semibold">المتاجر التي شهدت زيادة</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {aovRows.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">
                  {r.uplift === null ? "دون تغيير" : `+${r.uplift}%`}
                </td>
                <td class="py-3 text-right tabular-nums text-slate-500">
                  {r.storesUp === null ? "غير متاح" : `${r.storesUp}%`}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        مقاسة داخل المتجر (المتجر نفسه، طلبات الاختبار مقابل الطلبات دون اختبار)، لذا فهي متينة أمام العملة وتضبط مزيج المتجر. مثلّثة عبر ثلاث عينات مستقلة بوسيط +11% و+15% و+14%. الفئات ذات العينات الصغيرة تُحذف بدلاً من المبالغة فيها.
      </p>
    </div>
  </section>

  <!-- Attribution / LTV -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">يظل الاختبار يحقق عائداً بعد الجلسة</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        تحكم معظم لوحات الإسناد على الاختبار من خلال طلبات اليوم نفسه وتتوقف عند ذلك. وهذا يغفل معظم القيمة. <strong>{ATTRIBUTION.sameDay}% من أوائل الطلبات المنسوبة إلى الاختبار تحدث في اليوم نفسه</strong>، لكن الذيل طويل.
      </p>
      <div class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-4">
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.sameDay}%</p>
          <p class="mt-1 text-sm text-slate-600">في اليوم نفسه</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.within7}%</p>
          <p class="mt-1 text-sm text-slate-600">خلال 7 أيام</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.within30}%</p>
          <p class="mt-1 text-sm text-slate-600">خلال 30 يوماً</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">1 من كل 5</p>
          <p class="mt-1 text-sm text-slate-600">تصل بعد أكثر من 30 يوماً</p>
        </div>
      </div>
      <p class="mx-auto mt-6 max-w-3xl text-slate-700 text-center">
        حوالي <strong>1 من كل 5 من جميع الطلبات المنسوبة إلى الاختبار يصل بعد أكثر من 30 يوماً من الاختبار</strong>. الاختبار ليس مجرد دفعة نحو الدفع: كل إجابة هي zero-party data تصنّف المتسوق وتغذّي تدفقات متابعة مقسّمة وإعادة استهداف. <a href="https://www.klaviyo.com/marketing-resources/segmentation-benchmark-report" target="_blank" rel="external noopener nofollow" class="font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]">تولّد الحملات المقسّمة أكثر من 3 أضعاف الإيرادات لكل مستلم</a> مقارنة بالإرسالات العامة، لذا فإن اختباراً واحداً يظل يحقق التحويل عبر البريد الإلكتروني والإعلانات المخصصة لأشهر.
      </p>
    </div>
  </section>

  <!-- Baseline context -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">ما الذي يُعدّ "المتجر المتوسط"</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        لا يوجد رقم وحيد صحيح للتحويل في التجارة الإلكترونية: يتأرجح مع المنهجية والعينة. النطاق الصادق هو نحو 1.6% إلى 2.9%. نقارن مع <strong>{HEADLINE.baselinePct}%</strong> دائري، الطرف الأدنى المتحفظ، مما يضع من يجرون الاختبار عند نحو <strong>{HEADLINE.multiple} مرة</strong> المتجر المتوسط.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">المصدر</th>
              <th class="py-3 pr-4 text-right font-semibold">متوسط التحويل</th>
              <th class="py-3 font-semibold">النطاق</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {baselines.map((b) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">
                  <a href={b.href} target="_blank" rel="external noopener nofollow" class="text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-slate-500">{b.source}</a>
                </td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{b.rate}</td>
                <td class="py-3 text-sm text-slate-600">{b.scope}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        مهم: الـ 5.5% لدينا معدل لكل شخص يجري الاختبار (طلبات لكل اختبار مكتمل)، بينما كل رقم أعلاه هو معدل على مستوى الموقع بالكامل (طلبات لكل زائر). من يجرون الاختبار يختارون أنفسهم، لذا فإن جزءاً من الفرق هو المسار، لا الاختبار وحده. نعرض المقارنة بشكل مباشر بدلاً من تزيينها.
      </p>
    </div>
  </section>

  <!-- Methodology -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">المنهجية</h2>
      <ul class="mt-8 space-y-5" role="list">
        {METHODOLOGY.map((m) => (
          <li class="flex gap-3">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400" aria-hidden="true"></span>
            <p class="text-slate-700">{m}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">الأسئلة الشائعة</h2>
      <div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
        {FAQ.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-lg font-semibold text-slate-900 [&::-webkit-details-marker]:hidden">
              <span>{f.question}</span>
              <svg
                class="h-5 w-5 flex-shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <p class="pb-5 text-slate-700" set:html={f.answerHtml ?? f.answer} />
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* TODO: restore the entire "Cite this report" section (PDF download +
      shareable stat-card links) once a designer reviews the report + PDF + card
      designs. Removed 2026-06-08 to hold the downloadable assets until review.
      The PDF and card PNGs are still generated by `bun run report`. */}

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        قِس الزيادة في متجرك الخاص.
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-white/70">
        RevenueHunt مجاني للبدء، مع 100 إجابة اختبار شهرياً. أنشئ اختباراً، ووجّه إليه حركة المرور، واقرأ أرقامك الخاصة.
      </p>
      <p class="mx-auto mt-4 max-w-2xl text-white/60">
        شاهد ما يمكن أن تضيفه هذه المعايير إلى متجرك مع <a href={localizedHref("/quiz-roi-calculator/", "ar")} class="font-medium text-white underline decoration-white/40 underline-offset-2 hover:decoration-white">حاسبة ROI الاختبار</a> الخاصة بنا.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SHOPIFY_INSTALL}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          ابدأ مجاناً على Shopify
        </a>
        <a
          href={WOO_PLUGIN}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          ابدأ مجاناً على WooCommerce
        </a>
      </div>
    </div>
  </section>
</Base>
