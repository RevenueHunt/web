---
import Base from "../../../layouts/Base.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import { organization, breadcrumb, article, faqPage } from "../../../lib/schema";
import { SITE } from "../../../lib/site";
import { localizedHref } from "../../../lib/i18n";
import {
  REPORT,
  SOURCE,
  HEADLINE,
  GROWTH,
  REVIEWS,
  REVENUE,
  PRICING,
  GEOGRAPHY,
  NICHES,
  QUIZ_LANE,
} from "../../../lib/app-economy";

const pageUrl = new URL(`/ar/${REPORT.slug}/`, SITE.site_url).href;
const ogImage = `/og/${REPORT.slug}.png`;

const publishedLabel = new Date(REPORT.datePublished).toLocaleDateString("ar", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const title = "حالة اقتصاد تطبيقات Shopify";
const description =
  "هناك 22,546 تطبيقاً نشطاً في Shopify App Store، وتقريباً لا أحد منها يصل إلى أي مكان. تقرير بيانات عن النمو والمراجعات وتركّز الإيرادات والأسعار ومن يبنيها، انطلاقاً من لقطة لكل تطبيق نشط.";

// Methodology + FAQ, translated. The lead clause of each methodology note is
// bolded inline (the English source bolded it via string replace, which cannot
// match translated text). Defined before jsonLd so faqPage(FAQ) can use it.
const METHODOLOGY = [
  "<strong>المصدر:</strong> لقطة من Shopify App Store العام، 22,546 بطاقة تطبيق نشط، أُخذت في يونيو 2026. كل حقل مأخوذ من البطاقة العامة، لا من بيانات Shopify الداخلية أو حساب أي تاجر.",
  "<strong>الإيرادات مقدّرة، لا مقيسة.</strong> هي مُنمذجة من مستويات الأسعار المنشورة لكل تطبيق مع إشارات المراجعات والتثبيتات. تعامل مع أرقام الإيرادات كنموذج اتجاهي لمدى تركّز الأرباح، لا كبيانات فوترة. وهي موسومة بـ\"مقدّرة\" أينما ظهرت.",
  "<strong>يعتمد النمو على تاريخ الإطلاق المنشور لكل بطاقة.</strong> جمّع المصدر نحو 2,800 تاريخ إطلاق في مايو 2026، لذا تُقرأ المنحنى كتطبيقات نشطة متراكمة حسب السنة (نقطة النهاية هي الإجمالي الحالي الحقيقي)، ورقم \"أكثر من 6,000 في آخر 12 شهراً\" يزيل تشوّه ذلك الشهر الوحيد.",
  "<strong>المراجعات وكيل عن الجذب</strong>، لا وكيل مثالي: قد يكون التطبيق الرائع جديداً، وأعداد المراجعات تتأخر عن الاستخدام الحقيقي. نستخدمها لأنها أوضح إشارة علنية وقابلة للمقارنة عن قاعدة تجار حقيقية عبر 22,546 تطبيقاً.",
  "الفئات في App Store هي وسوم ميزات يمكن للتطبيق أن يضعها لنفسه، وكثير من التطبيقات تحمل عدة وسوم أو لا تحمل أيًّا. لعرض القطاعات نجمع الوسوم المتقاربة في مسارات عريضة ونزيل تكرار التطبيقات داخل كل منها؛ قد ينتمي التطبيق إلى أكثر من واحد، لذا تتداخل القطاعات وليست حصرية، ونقرأها كمؤشّر اتجاه. وفي كل ما عدا ذلك نعتمد على التقسيمات الواضحة (المراجعات، الأسعار، تاريخ الإطلاق، بلد المطوّر).",
];

const FAQ = [
  {
    question: "كم عدد التطبيقات في Shopify App Store؟",
    answer:
      "22,546 تطبيقاً نشطاً في لقطة يونيو 2026 هذه. تضاعف المتجر نحو 10 مرات منذ 2020 وأضاف أكثر من 6,000 تطبيق في آخر 12 شهراً وحدها، أي نحو 1 من كل 4 من كل ما هو نشط اليوم. حوّل التطوير بمساعدة الذكاء الاصطناعي ما كان بناءً يستغرق ستة أشهر إلى عطلة نهاية أسبوع.",
  },
  {
    question: "لماذا تفشل معظم تطبيقات Shopify؟",
    answer:
      "لم يعد البناء هو القيد، لذا يغرق المتجر بتطبيقات لا تجد قاعدة تجار قط. 51% ليس لها أي مراجعة و 81% لها أقل من 10. النادر هو التوزيع والثقة: الرد على الدعم، وكسب المراجعات تاجراً تلو الآخر، والحضور لسنوات. هذا هو الجزء الذي لا يستطيع الذكاء الاصطناعي القيام به بدلاً عنك.",
  },
  {
    question: "كم تكسب تطبيقات Shopify؟",
    answer:
      "الأرباح متركّزة للغاية. وفق تقديرنا، يحصل الـ 1% الأعلى من التطبيقات (225 منها) على نحو 72% من كل إيرادات التطبيقات، والعشرة الأولى وحدها تحصل على نحو 30%. نحو 36% فقط من التطبيقات يبدو أنها تكسب أي شيء. الإيرادات هنا مقدّرة من الأسعار العامة وإشارات الاستخدام، لا من بيانات الفوترة.",
  },
  {
    question: "هل معظم تطبيقات Shopify مجانية؟",
    answer:
      "عملياً، نعم. 46.9% مجانية و 48.6% أخرى تبدأ بتجربة مجانية؛ 4.5% فقط تتقاضى المال مقدّماً. 57% من التطبيقات المدفوعة تقدّم خطة مجانية. في Shopify App Store، نقطة الدخول المجانية ليست تكتيك نمو، بل هي التوقّع الأساسي.",
  },
  {
    question: "أين يمكنني رؤية البيانات الأساسية؟",
    answer:
      "الأرقام مأخوذة من لقطة نحتفظ بها لكل تطبيق Shopify نشط: تواريخ الإطلاق، والمراجعات، والأسعار، وشارة Built for Shopify، ودولة المطوّر. إذا كنت تبني على Shopify وتريد التقرير الكامل، تواصل معنا.",
    answerHtml:
      "الأرقام مأخوذة من لقطة نحتفظ بها لكل تطبيق Shopify نشط: تواريخ الإطلاق، والمراجعات، والأسعار، وشارة Built for Shopify، ودولة المطوّر. إذا كنت تبني على Shopify وتريد التقرير الكامل، <a href=\"/ar/contact/\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">تواصل معنا</a>.",
  },
];

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "الرئيسية", url: localizedHref("/", "ar") },
    { name: title, url: localizedHref(`/${REPORT.slug}/`, "ar") },
  ]),
  article({
    title,
    description,
    url: pageUrl,
    image: ogImage,
    datePublished: REPORT.datePublished,
    dateModified: REPORT.dateModified,
    author: "RevenueHunt",
    tags: [
      "Shopify app store",
      "مطورو تطبيقات Shopify",
      "إحصاءات متجر التطبيقات",
      "اقتصاد التطبيقات",
    ],
  }),
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "حالة اقتصاد تطبيقات Shopify 2026",
    description,
    url: pageUrl,
    creator: organization(),
    license: "https://creativecommons.org/licenses/by/4.0/",
    isAccessibleForFree: true,
    datePublished: REPORT.datePublished,
    keywords: [
      "Shopify app store",
      "مطورو التطبيقات",
      "إيرادات التطبيقات",
      "مراجعات التطبيقات",
      "ecommerce",
    ],
  },
  faqPage(FAQ),
];

// Section eyebrows for the editorial "field notes" feel.
const E = (n: string, label: string) => `${n} · ${label}`;

// Translated headline cards. Stats stay from the shared data module (HEADLINE[i].stat).
const headlineT = [
  { label: "تطبيق نشط في المتجر", note: "تضاعف نحو 10 مرات منذ 2020." },
  { label: "ليس لها أي مراجعة", note: "أربعة من كل خمسة لها أقل من 10." },
  { label: "من الإيرادات يحصل عليها الـ 1% الأعلى", note: "225 تطبيقاً. تقديري." },
  { label: "تتقاضى المال مقدّماً", note: "1 فقط من كل 20. نحو النصف مجانية." },
];

// Growth caption with the lead phrase bolded.
const growthCaptionHtml =
  "تطبيقات نشطة متراكمة حسب سنة الإطلاق. <strong>تضاعف Shopify App Store نحو 10 مرات منذ 2020</strong> وأضاف أكثر من 6,000 تطبيق في آخر 12 شهراً وحدها، أي نحو 1 من كل 4 من كل ما هو نشط اليوم.";

// Quiz-lane paragraphs (translated), with the live search link and the load-bearing
// lines bolded inline. Caption text mirrors the English source's meaning.
const quizParas = [
  `فئتنا نفسها تثبت الأمر ذاته. <a href="${QUIZ_LANE.searchUrl}" target="_blank" rel="external noopener nofollow" class="font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]">يُرجع بحث "اختبارات" في Shopify</a> 149 تطبيقاً، لكن الثقة هنا تتراكم في القمة تماماً كما في المتجر بأكمله. التطبيقات الثلاثة التي وصلت أولاً ولم تغادر قط، RevenueHunt و Octane AI و Quiz Kit، تستحوذ على 45% من كل مراجعات الفئة؛ <strong>RevenueHunt وحدها لها نحو الرّبع</strong>، والنصف الأدنى ليس له أي مراجعة.`,
  `لم نصل إلى القمة بالبرمجة. <strong>المراجعات هي عَرَضُ الكدّ التشغيلي</strong> الذي يقف خلفها: ست سنوات من الرد على الدعم، والتحدث هاتفياً مع تجار لن يدفعوا أبداً، وكسب الثقة متجراً تلو الآخر. قامت Octane AI و Quiz Kit بالعمل الشاق نفسه على مدى سنوات، <strong>ونحترمهما على ذلك</strong>. تنويه بالشرف لـ Lantern و Quizell، ولكلٍّ منهما ما يزيد قليلاً على 120 مراجعة.`,
];

// Methodology bullets carry their own inline <strong>; render as-is.
const methodologyHtml = METHODOLOGY;
---

<Base
  title={`${title} - تقرير بيانات 2026`}
  description={description}
  ogImage={ogImage}
  jsonLd={jsonLd}
  lang="ar"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <Breadcrumb items={[{ label: "الرئيسية", href: localizedHref("/", "ar") }, { label: "حالة اقتصاد تطبيقات Shopify" }]} />
      <div class="text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">
          ملاحظات ميدانية · {publishedLabel}
        </p>
        <Eyebrow>حالة اقتصاد تطبيقات Shopify</Eyebrow>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          حالة اقتصاد تطبيقات Shopify
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          <strong>هناك 22,546 تطبيقاً نشطاً في Shopify App Store، وتقريباً لا أحد منها يصل إلى أي مكان.</strong> أخذنا لقطة لكل تطبيق نشط، ثم قرأنا البيانات عن النمو والمراجعات والإيرادات والأسعار ومن يبنيها. تروي قصة واحدة: بناء التطبيق لم يكن قطّ الجزء الصعب.
        </p>
      </div>
    </div>
  </section>

  <!-- Source band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-2xl bg-[#16161D] px-6 py-10 sm:px-10">
        <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#4dcaff]">
          اللقطة
        </p>
        <dl class="mt-6 grid grid-cols-2 gap-8 text-center sm:grid-cols-4">
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.apps}</dt>
            <dd class="mt-1 text-sm text-white/70">تطبيق نشط في اللقطة</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.countries}</dt>
            <dd class="mt-1 text-sm text-white/70">دولة تبنيها</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.reviewless}</dt>
            <dd class="mt-1 text-sm text-white/70">دون أي مراجعة</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.free}</dt>
            <dd class="mt-1 text-sm text-white/70">مجانية تماماً، دون خطة مدفوعة</dd>
          </div>
        </dl>
        <p class="mx-auto mt-6 max-w-3xl text-center text-sm text-white/60">
          كل رقم أدناه مأخوذ من البطاقة العامة في App Store للتطبيقات الـ 22,546 النشطة، يونيو 2026. الإيرادات مقدّرة من الأسعار المنشورة وإشارات الاستخدام، لا من بيانات الفوترة، وهي موسومة بذلك في كل أنحاء التقرير.
        </p>
      </div>
    </div>
  </section>

  <!-- Headline cards -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">الأرقام البارزة</h2>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        {HEADLINE.map((c, i) => (
          <div class="rounded-xl border border-slate-200 p-7">
            <p class="text-4xl font-bold tracking-tight text-[#16161D]">{c.stat}</p>
            <p class="mt-2 font-medium text-slate-900">{headlineT[i].label}</p>
            <p class="mt-2 text-sm text-slate-600">{headlineT[i].note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 01 Growth -->
  <section class="scroll-mt-20 bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("01", "النمو")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">تضاعف 10 مرات منذ 2020</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center" set:html={growthCaptionHtml} />
      <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
        <div class="h-72 sm:h-80"><canvas id="c-growth" aria-label="تطبيقات Shopify النشطة المتراكمة حسب السنة" role="img"></canvas></div>
      </div>
    </div>
  </section>

  <!-- 02 Traction -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("02", "الجذب")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">معظم التطبيقات لا تحصل على مراجعة أبداً</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">نصف Shopify App Store لم يكسب قطّ مراجعة واحدة. أربعة من كل خمسة تطبيقات لها أقل من 10. المراجعة هي أوضح مؤشر علني على تاجر حقيقي ومحتفَظ به، ومعظم التطبيقات لا تحصل على أي منها أبداً.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-center text-sm font-semibold text-slate-900">التطبيقات حسب عدد المراجعات</p>
          <div class="h-72 sm:h-80"><canvas id="c-reviews" aria-label="توزيع المراجعات عبر كل التطبيقات النشطة" role="img"></canvas></div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">81%</p>
            <p class="mt-1 text-slate-700">لها أقل من 10 مراجعات</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="font-bold text-[#16161D]"><span class="text-3xl">{REVIEWS.medianReviews}</span> <span class="text-sm font-medium text-slate-500">مراجعة</span></p>
            <p class="mt-1 text-slate-700">الوسيط، بين التطبيقات التي لها واحدة على الأقل</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="font-bold text-[#16161D]"><span class="text-amber-400">★</span> <span class="text-3xl">{REVIEWS.avgRating}</span> <span class="text-sm font-medium text-slate-500">نجمة</span></p>
            <p class="mt-1 text-slate-700">متوسط التقييم، بين الـ {REVIEWS.ratedCount} تطبيقاً التي لها واحد</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 Revenue -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("03", "الإيرادات · تقديري")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">المال يتجمّع في القمة تماماً</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">الإيرادات الشهرية المقدّرة متركّزة بقسوة في الأعلى. الـ 1% الأعلى من التطبيقات (225 منها) يحصل على 72% تقديري، و10 فقط من هذه التطبيقات تحصل وحدها على نحو 30% من إجمالي إيرادات التطبيقات. نحو 36% فقط من التطبيقات يبدو أنها تكسب أي شيء على الإطلاق. كما يتركّز جغرافياً: <strong>تستحوذ الولايات المتحدة وكندا وحدهما على نحو 57% مقدّرة</strong> من إيرادات متجر تطبيقات Shopify.</p>
      <p class="mx-auto mt-3 max-w-3xl text-sm italic text-slate-500 text-center">اسم واحد يعلو فوق المنظومة كلها: تطبيق يجني نحو 78% من إيراداته السنوية البالغة قرابة مليار دولار من تجار يستخدمون Shopify. نعم، نقصدك أنت، <a href='https://www.sec.gov/Archives/edgar/data/1835830/000162828023030618/klaviyoincs-1.htm' target='_blank' rel='external noopener nofollow' class='font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]'>Klaviyo</a>.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-center text-sm font-semibold text-slate-900">توزيع الإيرادات</p>
          <div class="h-64 sm:h-72"><canvas id="c-revenue-donut" aria-label="توزيع الإيرادات المقدّرة: أفضل 10 تطبيقات، وبقية أعلى 1%، والـ99% الأخرى" role="img"></canvas></div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-center text-sm font-semibold text-slate-900">الإيرادات المقدّرة حسب الدولة</p>
          <div class="h-64 sm:h-72"><canvas id="c-revenue-countries" aria-label="الإيرادات المقدّرة حسب الدولة" role="img"></canvas></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 Pricing -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("04", "الأسعار")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">تقريباً لا أحد يتقاضى المال مقدّماً</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">نحو نصف المتجر لا يتقاضى شيئاً مقدّماً، وأقل من 1 من كل 20 تطبيقاً يطلب المال قبل أول تثبيت. 57% من التطبيقات المدفوعة تقدّم خطة مجانية. الفريميوم هنا ليس استراتيجية، بل هو الحد الأدنى للدخول.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
