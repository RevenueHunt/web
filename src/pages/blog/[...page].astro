---
import type { GetStaticPaths, Page } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { categoryHref, postHref, sortByDate, topCategories } from "../../lib/blog";
import { SITE } from "../../lib/site";
import { breadcrumb, organization, website } from "../../lib/schema";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const all = await getCollection("blog", ({ data }) => !data.draft);
  const posts = sortByDate(all);
  const cats = topCategories(posts, 6);
  return paginate(posts, { pageSize: 10, props: { cats } });
};

type Props = {
  page: Page<CollectionEntry<"blog">>;
  cats: ReturnType<typeof topCategories>;
};
const { page, cats } = Astro.props as Props;

function fmt(d: Date) {
  return d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
}

const isFirstPage = page.currentPage === 1;
const titleSuffix = isFirstPage ? "" : ` - page ${page.currentPage}`;

const jsonLd = [
  organization(),
  website(),
  breadcrumb([
    { name: "Home", url: "/" },
    { name: "Blog", url: "/blog/" },
  ]),
];
---

<Base
  title={`Blog${titleSuffix} - ${SITE.name}`}
  description="Product recommendation quiz strategies, case studies, and updates from the RevenueHunt team."
  jsonLd={jsonLd}
>
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-6xl px-6 py-14 sm:py-16">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-slate-700">Home</a>
        <span class="mx-2 text-slate-300">/</span>
        {isFirstPage ? (
          <span class="text-slate-700">Blog</span>
        ) : (
          <>
            <a href="/blog/" class="hover:text-slate-700">Blog</a>
            <span class="mx-2 text-slate-300">/</span>
            <span class="text-slate-700">Page {page.currentPage}</span>
          </>
        )}
      </nav>
      <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
      <div class="grid items-start gap-8 lg:grid-cols-2 lg:gap-12">
        <div>
          <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">Blog</h1>
          <p class="mt-4 text-lg text-slate-600">Strategies, case studies, and product updates for ecommerce stores running quizzes.</p>
        </div>
        <div class="relative lg:mt-16">
          <div id="blog-search" class="rh-blog-search"></div>
          <noscript>
            <p class="text-sm text-slate-500">Search needs JavaScript - browse posts below.</p>
          </noscript>
        </div>
      </div>

      {cats.length > 0 && (
        <ul class="mt-8 flex flex-wrap gap-2">
          <li>
            <span class="inline-flex items-center rounded-full bg-[#16161D] px-4 py-1.5 text-sm font-semibold text-white">All posts</span>
          </li>
          {cats.map((c) => (
            <li>
              <a
                href={categoryHref(c.name)}
                class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-1.5 text-sm font-medium text-slate-700 transition hover:border-[#16161D] hover:text-[#16161D]"
              >{c.name}<span class="ml-2 text-xs text-slate-400">{c.count}</span></a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <div class="mx-auto max-w-4xl px-6 py-12 sm:py-16">
    <ul class="divide-y divide-slate-200">
      {page.data.map((post) => (
        <li>
          <a href={postHref(post)} class="group flex gap-6 py-6 sm:gap-8">
            {post.data.featuredImage ? (
              <div class="flex aspect-square h-32 w-32 flex-shrink-0 items-center justify-center overflow-hidden rounded-lg bg-slate-50 sm:h-40 sm:w-40">
                <img
                  src={post.data.featuredImage}
                  alt={post.data.title}
                  loading="lazy"
                  class="max-h-full max-w-full object-contain"
                />
              </div>
            ) : (
              <div class="aspect-square h-32 w-32 flex-shrink-0 rounded-lg bg-slate-100 sm:h-40 sm:w-40" />
            )}
            <div class="min-w-0 flex-1">
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
                {fmt(post.data.pubDate)}
                {post.data.author && ` · ${post.data.author}`}
              </p>
              <h2 class="mt-2 text-xl font-semibold text-slate-900 group-hover:text-[#16161D]">{post.data.title}</h2>
              {post.data.description && (
                <p class="mt-2 line-clamp-2 text-sm text-slate-600 sm:text-base">{post.data.description}</p>
              )}
            </div>
          </a>
        </li>
      ))}
    </ul>

    {page.lastPage > 1 && (
      <nav class="mt-12 flex items-center justify-between gap-4 border-t border-slate-200 pt-8" aria-label="Pagination">
        {page.url.prev ? (
          <a
            href={page.url.prev}
            rel="prev"
            class="inline-flex items-center gap-2 rounded-md border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-[#16161D] hover:text-[#16161D]"
          >
            <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4 6 10l6 6"/></svg>
            Previous
          </a>
        ) : <span aria-hidden="true" />}

        <p class="text-sm text-slate-500">Page {page.currentPage} of {page.lastPage}</p>

        {page.url.next ? (
          <a
            href={page.url.next}
            rel="next"
            class="inline-flex items-center gap-2 rounded-md border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-[#16161D] hover:text-[#16161D]"
          >
            Next
            <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 4 6 6-6 6"/></svg>
          </a>
        ) : <span aria-hidden="true" />}
      </nav>
    )}
  </div>

  <style is:global>
    .rh-blog-search {
      --pagefind-ui-primary: #16161D;
      --pagefind-ui-text: #0f172a;
      --pagefind-ui-background: #ffffff;
      --pagefind-ui-border: #e2e8f0;
      --pagefind-ui-tag: #f1f5f9;
      --pagefind-ui-border-width: 1px;
      --pagefind-ui-border-radius: 8px;
      --pagefind-ui-font: inherit;
    }
    .rh-blog-search .pagefind-ui__form { margin: 0; }
    /* Float the results drawer over the page so it doesn't push the
       blog list down as the user types. */
    .rh-blog-search .pagefind-ui__drawer:not(.pagefind-ui__drawer--empty) {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 30;
      margin-top: 0.5rem;
      max-height: 70vh;
      overflow-y: auto;
      padding: 1rem;
      border: 1px solid var(--pagefind-ui-border);
      border-radius: 12px;
      background: #ffffff;
      box-shadow: 0 20px 40px -10px rgba(15, 23, 42, 0.2);
    }
    .rh-blog-search .pagefind-ui__drawer--empty { display: none; }
  </style>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const mount = document.getElementById("blog-search");
      if (!mount) return;
      const init = () => {
        if (typeof window.PagefindUI !== "function") {
          mount.innerHTML = '<p class="text-sm text-slate-500">Search bundle loaded but PagefindUI is missing.</p>';
          return;
        }
        new window.PagefindUI({
          element: "#blog-search",
          showSubResults: true,
          showImages: true,
          resetStyles: false,
          showEmptyFilters: false,
          placeholder: "Search the blog...",
        });
      };
      // pagefind-ui.js is an IIFE that hangs PagefindUI on window - load it as
      // a regular <script>, not via dynamic import (which would succeed but
      // return an empty module namespace).
      if (typeof window.PagefindUI === "function") {
        init();
        return;
      }
      const s = document.createElement("script");
      s.src = "/pagefind/pagefind-ui.js";
      s.onload = init;
      s.onerror = () => {
        mount.innerHTML = '<p class="text-sm text-slate-500">Search is unavailable in dev mode - run <code>bun run build &amp;&amp; bun run preview</code>.</p>';
      };
      document.head.appendChild(s);
    });
  </script>

  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-white/70">
        Most shoppers leave because they can't find the right product
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Turn shoppers into confident buyers with a Product Recommendation Quiz that drives sales.
      </h2>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a
          href="/demo/"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >Book a demo</a>
        <a
          href="/pricing/"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >See pricing</a>
      </div>
    </div>
  </section>
</Base>
