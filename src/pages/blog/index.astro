---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { categoryHref, postHref, sortByDate, topCategories } from "../../lib/blog";
import { SITE } from "../../lib/site";
import { breadcrumb, organization, website } from "../../lib/schema";

const all = await getCollection("blog", ({ data }) => !data.draft);
const posts = sortByDate(all);
const featured = posts[0];
const rest = posts.slice(1);
const cats = topCategories(posts, 6);

function fmt(d: Date) {
  return d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
}

const jsonLd = [
  organization(),
  website(),
  breadcrumb([
    { name: "Home", url: "/" },
    { name: "Blog", url: "/blog/" },
  ]),
];
---

<Base
  title={`Blog — ${SITE.name}`}
  description="Product recommendation quiz strategies, case studies, and updates from the RevenueHunt team."
  jsonLd={jsonLd}
>
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-6xl px-6 py-14 sm:py-16">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-slate-700">Home</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Blog</span>
      </nav>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">Blog</h1>
      <p class="mt-4 max-w-2xl text-lg text-slate-600">Strategies, case studies, and product updates for ecommerce stores running quizzes.</p>

      {cats.length > 0 && (
        <ul class="mt-8 flex flex-wrap gap-2">
          <li>
            <span class="inline-flex items-center rounded-full bg-[#16161D] px-4 py-1.5 text-sm font-semibold text-white">All posts</span>
          </li>
          {cats.map((c) => (
            <li>
              <a
                href={categoryHref(c.name)}
                class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-1.5 text-sm font-medium text-slate-700 transition hover:border-[#16161D] hover:text-[#16161D]"
              >{c.name}<span class="ml-2 text-xs text-slate-400">{c.count}</span></a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <main class="mx-auto max-w-6xl px-6 py-12 sm:py-16">
    {featured && (
      <section class="mb-12">
        <a href={postHref(featured)} class="group grid gap-6 overflow-hidden rounded-2xl border border-slate-200 bg-white transition hover:border-[#16161D] md:grid-cols-2">
          {featured.data.featuredImage ? (
            <img
              src={featured.data.featuredImage}
              alt=""
              class="h-64 w-full object-cover md:h-full"
            />
          ) : (
            <div class="h-64 w-full bg-slate-100 md:h-full" />
          )}
          <div class="flex flex-col justify-center p-6 sm:p-8">
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Featured · {fmt(featured.data.pubDate)}</p>
            <h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-900 group-hover:text-[#16161D] sm:text-3xl">{featured.data.title}</h2>
            {featured.data.description && (
              <p class="mt-3 line-clamp-3 text-slate-600">{featured.data.description}</p>
            )}
            <p class="mt-4 text-sm text-slate-500">{featured.data.author}</p>
          </div>
        </a>
      </section>
    )}

    <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {rest.map((post) => (
        <li>
          <a href={postHref(post)} class="group block overflow-hidden rounded-lg border border-slate-200 bg-white transition hover:border-[#16161D]">
            {post.data.featuredImage ? (
              <img
                src={post.data.featuredImage}
                alt=""
                loading="lazy"
                class="h-44 w-full object-cover"
              />
            ) : (
              <div class="h-44 w-full bg-slate-100" />
            )}
            <div class="p-5">
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
                {fmt(post.data.pubDate)}
                {post.data.author && ` · ${post.data.author}`}
              </p>
              <h2 class="mt-2 text-lg font-semibold text-slate-900 group-hover:text-[#16161D]">{post.data.title}</h2>
              {post.data.description && (
                <p class="mt-2 line-clamp-2 text-sm text-slate-600">{post.data.description}</p>
              )}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </main>

  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Turn shoppers into confident buyers with a Product Recommendation Quiz that drives sales.
      </h2>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a
          href="/demo/"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >Book a demo</a>
        <a
          href="/pricing/"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >See pricing</a>
      </div>
    </div>
  </section>
</Base>
