---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

function fmt(d: Date) {
  return d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
}
---

<Base title="Blog — RevenueHunt" description="Product recommendation quiz strategies, case studies, and updates from the RevenueHunt team.">
  <main class="mx-auto max-w-4xl px-6 py-16">
    <header class="mb-12">
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">Blog</h1>
      <p class="mt-3 text-lg text-slate-600">Strategies, case studies, and product updates for ecommerce stores running quizzes.</p>
    </header>

    <ul class="divide-y divide-slate-200">
      {posts.map((post) => (
        <li class="py-6">
          <a href={`/${post.data.legacySlug}/`} class="group flex flex-col gap-4 sm:flex-row">
            {post.data.featuredImage && (
              <img
                src={post.data.featuredImage}
                alt=""
                loading="lazy"
                class="h-32 w-full rounded-md object-cover sm:h-24 sm:w-40"
              />
            )}
            <div class="flex-1">
              <h2 class="text-xl font-semibold text-slate-900 group-hover:text-slate-700">{post.data.title}</h2>
              {post.data.description && (
                <p class="mt-1 text-sm text-slate-600 line-clamp-2">{post.data.description}</p>
              )}
              <p class="mt-2 text-xs uppercase tracking-wider text-slate-500">
                {fmt(post.data.pubDate)}
                {post.data.author && ` · ${post.data.author}`}
              </p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Base>
