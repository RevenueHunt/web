---
import Base from "../../layouts/Base.astro";
import { organization, breadcrumb } from "../../lib/schema";

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Home", url: "/" },
    { name: "Call scheduled", url: "/call-scheduled/" },
  ]),
];
---

<Base
  title="Call scheduled - RevenueHunt"
  description="Your call with the RevenueHunt team is booked. You'll get a calendar invite and a confirmation email with the joining details."
  noindex={true}
  jsonLd={jsonLd}
>
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-3xl px-6 py-20 text-center sm:py-24">
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100">
        <svg class="h-8 w-8 text-emerald-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7 7a1 1 0 01-1.4 0l-4-4a1 1 0 011.4-1.4l3.3 3.3 6.3-6.3a1 1 0 011.4 0z" clip-rule="evenodd"/>
        </svg>
      </div>
      <h1 id="cs-heading" class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">Your call is booked!</h1>
      <p class="mt-6 text-lg text-slate-700">
        We've sent a calendar invite and a confirmation email with the joining link. Check your inbox - and your spam folder, just in case.
      </p>

      <div id="cs-details" class="mx-auto mt-10 hidden max-w-md rounded-2xl border border-slate-200 bg-white p-6 text-left">
        <dl class="space-y-4">
          <div data-row="meeting">
            <dt class="text-sm font-semibold uppercase tracking-wider text-slate-500">Meeting</dt>
            <dd id="cs-meeting" class="mt-1 text-base text-slate-900"></dd>
          </div>
          <div data-row="when">
            <dt class="text-sm font-semibold uppercase tracking-wider text-slate-500">When</dt>
            <dd id="cs-when" class="mt-1 text-base text-slate-900"></dd>
          </div>
          <div data-row="host">
            <dt class="text-sm font-semibold uppercase tracking-wider text-slate-500">With</dt>
            <dd id="cs-host" class="mt-1 text-base text-slate-900"></dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 pb-20">
    <div class="grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-slate-200 bg-white p-6">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500">Before the call</h2>
        <p class="mt-3 text-slate-700">
          Get a head start by browsing our help guides on setting up a quiz, installing integrations, and customizing the design.
        </p>
        <a
          href="https://docs.revenuehunt.com/"
          target="_blank"
          rel="external noopener"
          class="mt-4 inline-flex items-center text-sm font-semibold text-slate-900 underline underline-offset-4 hover:text-slate-700"
        >
          Open the help center ↗
        </a>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-6">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500">Need to reschedule?</h2>
        <p class="mt-3 text-slate-700">
          Use the reschedule or cancel link in your confirmation email. Questions before then?
        </p>
        <a href="mailto:team@revenuehunt.com" class="mt-1 inline-flex text-base font-semibold text-slate-900 underline underline-offset-4 hover:text-slate-700">team@revenuehunt.com</a>
      </div>
    </div>
    <div class="mt-10 text-center">
      <a
        href="/"
        class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
      >
        Back to home
      </a>
    </div>
  </section>

  <script is:inline>
    // Calendly appends booking details as query params when it redirects here.
    // Use them to personalize the confirmation; fall back to the generic copy
    // (the details card stays hidden) when they're missing.
    (function () {
      const p = new URLSearchParams(window.location.search);
      const firstName = (p.get("invitee_first_name") || "").trim();
      const fullName = (p.get("invitee_full_name") || "").trim();
      const meeting = (p.get("event_type_name") || "").trim();
      const host = (p.get("assigned_to") || "").trim();
      const start = p.get("event_start_time");
      const end = p.get("event_end_time");

      const name = firstName || fullName.split(" ")[0];
      if (name) {
        const h = document.getElementById("cs-heading");
        if (h) h.textContent = "You're booked, " + name + "!";
      }

      let shown = false;
      const setRow = (id, value) => {
        const row = document.querySelector('[data-row="' + id + '"]');
        const el = document.getElementById("cs-" + id);
        if (value && el && row) {
          el.textContent = value;
          shown = true;
        } else if (row) {
          row.classList.add("hidden");
        }
      };

      let when = "";
      if (start) {
        const d = new Date(start);
        if (!isNaN(d.getTime())) {
          const date = d.toLocaleDateString(undefined, {
            weekday: "long", month: "long", day: "numeric", year: "numeric",
          });
          const timeOpts = { hour: "numeric", minute: "2-digit", timeZoneName: "short" };
          let time = d.toLocaleTimeString(undefined, timeOpts);
          if (end) {
            const e = new Date(end);
            if (!isNaN(e.getTime())) {
              time = d.toLocaleTimeString(undefined, { hour: "numeric", minute: "2-digit" }) +
                " – " + e.toLocaleTimeString(undefined, timeOpts);
            }
          }
          when = date + " at " + time;
        }
      }

      setRow("meeting", meeting);
      setRow("when", when);
      setRow("host", host);

      if (shown) {
        document.getElementById("cs-details").classList.remove("hidden");
      }
    })();
  </script>
</Base>
