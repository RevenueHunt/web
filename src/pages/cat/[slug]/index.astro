---
import { getCollection } from "astro:content";
import BlogArchive from "../../../components/pages/BlogArchive.astro";
import { normalizeName, slugify } from "../../../lib/blog";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  const buckets = new Map<string, { name: string; posts: typeof posts }>();
  for (const post of posts) {
    for (const cat of post.data.categories ?? []) {
      const slug = slugify(cat);
      if (!slug) continue;
      const existing = buckets.get(slug);
      if (existing) existing.posts.push(post);
      else buckets.set(slug, { name: normalizeName(cat), posts: [post] });
    }
  }
  return Array.from(buckets.entries()).map(([slug, b]) => ({
    params: { slug },
    props: { name: b.name, posts: b.posts },
  }));
}

const { slug } = Astro.params;
const { name, posts } = Astro.props;
---

<BlogArchive kind="category" name={name} slug={slug!} posts={posts} />
