---
import Base from "../../layouts/Base.astro";
import { organization, breadcrumb } from "../../lib/schema";
import { SITE } from "../../lib/site";
import { COMPETITORS, COMPETITOR_ORDER } from "../../lib/competitors";

const items = COMPETITOR_ORDER.map((slug) => COMPETITORS[slug]!);

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=compare_index";

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Home", url: "/" },
    { name: "Compare", url: "/compare/" },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    itemListElement: items.map((c, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: `RevenueHunt vs ${c.name}`,
      url: new URL(`/compare/${c.slug}/`, SITE.site_url).href,
    })),
  },
];
---

<Base
  title="RevenueHunt vs the alternatives — compare quiz tools"
  description="See how RevenueHunt compares to Octane AI, Typeform, Zoovu, Nosto, Jebbit, and Tolstoy on pricing, features, and platforms for product recommendation quizzes."
  ogImage="/og/compare.png"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-slate-700">Home</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Compare</span>
      </nav>
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">Comparisons</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          RevenueHunt vs the alternatives
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          How RevenueHunt stacks up against other product quiz, guided-selling, and personalization tools — on pricing, features, and the platforms you sell on. Honest, up-to-date comparisons.
        </p>
      </div>
    </div>
  </section>

  <!-- Comparison cards -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <ul class="grid gap-4 sm:grid-cols-2" role="list">
        {items.map((c) => (
          <li>
            <a
              href={`/compare/${c.slug}/`}
              class="group block h-full rounded-xl border border-slate-200 p-6 transition hover:border-[#16161D] hover:shadow-md"
            >
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">{c.category}</p>
              <h2 class="mt-2 text-lg font-semibold text-slate-900 group-hover:text-[#16161D]">
                RevenueHunt vs {c.name}
              </h2>
              <p class="mt-2 text-sm text-slate-600">{c.heroSubtitle}</p>
              <span class="mt-4 inline-flex items-center text-sm font-medium text-[#16161D]">
                See comparison
                <svg class="ml-1 h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M7.21 4.29a1 1 0 011.42 0l5 5a1 1 0 010 1.42l-5 5a1 1 0 11-1.42-1.42L11.09 10 7.21 6.12a1 1 0 010-1.42z" clip-rule="evenodd" />
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        See why 20,000+ brands choose RevenueHunt.
      </h2>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a
          href={SHOPIFY_INSTALL}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          install on Shopify
        </a>
        <a
          href="/pricing/"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          see pricing
        </a>
      </div>
    </div>
  </section>
</Base>
