---
import Base from "../../layouts/Base.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import YouTubeFacade from "../../components/YouTubeFacade.astro";
import { organization, breadcrumb } from "../../lib/schema";

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Home", url: "/" },
    { name: "Contact", url: "/contact/" },
  ]),
];

const channels = [
  {
    label: "Read the help guides",
    href: "https://docs.revenuehunt.com/",
    note: "Self-serve documentation, integrations, troubleshooting.",
    external: true,
  },
  {
    label: "Email support & sales",
    href: "mailto:team@revenuehunt.com",
    note: "team@revenuehunt.com - see response times below.",
  },
  {
    label: "Check system status",
    href: "https://status.revenuehunt.com/",
    note: "Real-time service health and incident history. 99.98%+ uptime.",
    external: true,
  },
];

const responseTiers = [
  {
    label: "Critical - production down, security, data integrity",
    sla: "30-minute first response, 24/7 worldwide",
  },
  {
    label: "High - major feature impacted, multiple users affected",
    sla: "12-hour first response",
  },
  {
    label: "Standard - questions, configuration help",
    sla: "1 business day",
  },
  {
    label: "Low priority - feedback, feature requests",
    sla: "Up to 3 business days",
  },
];
---

<Base translated={true}
  title="Contact us - RevenueHunt"
  description="Get in touch with the RevenueHunt support team. Read the help guides, watch the tutorial, or take the support quiz to get a personalized answer in minutes."
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20 text-center">
      <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Contact" }]} />
      <Eyebrow>Contact</Eyebrow>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Get in touch
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600">
        Read the help guides, watch the tutorial, or take our support quiz below - the sharpest and friendliest
        support team in ecommerce will get back to you.
      </p>
    </div>
  </section>

  <!-- Two-column: video + channels -->
  <section class="mx-auto max-w-7xl px-6 py-12">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Start with the tutorial</h2>
        <p class="mt-3 text-slate-600">
          Most questions are answered in the 3-minute walk-through. Have a quick watch before reaching out.
        </p>
        <div class="mt-6 aspect-video overflow-hidden rounded-xl bg-slate-900 shadow-xl">
          <YouTubeFacade id="oL1DnBd6N1U" title="RevenueHunt support tutorial" />
        </div>
      </div>
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Ways to reach us</h2>
        <ul class="mt-6 space-y-3">
          {channels.map((c) => (
            <li>
              <a
                href={c.href}
                target={c.external ? "_blank" : undefined}
                rel={c.external ? "external noopener" : undefined}
                class="group flex items-start justify-between gap-4 rounded-xl border border-slate-200 bg-white p-5 transition hover:border-slate-300 hover:shadow-md"
              >
                <div>
                  <p class="text-base font-semibold text-slate-900 group-hover:text-[#16161D]">{c.label}</p>
                  <p class="mt-1 text-sm text-slate-600">{c.note}</p>
                </div>
                <span class="mt-1 shrink-0 text-slate-400 transition group-hover:text-[#16161D]" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Support quiz -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Take our support quiz</h2>
      <p class="mx-auto mt-3 max-w-2xl text-slate-600">
        Answer a few quick questions and we'll route you to the right help - docs, tutorial, or a real human reply.
      </p>
      <div class="mx-auto mt-8 max-w-4xl overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <iframe
          src="https://admin.revenuehunt.com/public/quiz/ZAHJoMM"
          title="RevenueHunt support quiz"
          loading="lazy"
          class="block h-[600px] w-full"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Response times — moved here from the right column so it sits under
       the quiz, since that's where visitors land after asking for help. -->
  <section class="mx-auto max-w-4xl px-6 py-16">
    <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm sm:p-10">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Response times</h2>
      <p class="mt-3 text-slate-600">
        Tiered support SLA for all merchants, with priority for Shopify Plus and enterprise accounts.
      </p>
      <dl class="mt-6 grid gap-4 sm:grid-cols-2">
        {responseTiers.map((t) => (
          <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
            <dt class="text-sm font-semibold text-slate-900">{t.label}</dt>
            <dd class="mt-1 text-sm text-slate-600">{t.sla}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Base>
