---
import Base from "../../../layouts/Base.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import YouTubeFacade from "../../../components/YouTubeFacade.astro";
import { organization, breadcrumb } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Domů", url: "/" },
    { name: "Kontakt", url: "/contact/" },
  ]),
];

const channels = [
  {
    label: "Přečti si průvodce nápovědou",
    href: "https://docs.revenuehunt.com/",
    note: "Samoobslužná dokumentace, integrace, řešení problémů.",
    external: true,
  },
  {
    label: "Podpora a prodej e-mailem",
    href: "mailto:team@revenuehunt.com",
    note: "team@revenuehunt.com - časy odezvy najdeš níže.",
  },
  {
    label: "Zkontroluj stav systému",
    href: "https://status.revenuehunt.com/",
    note: "Stav služby v reálném čase a historie incidentů. Dostupnost 99,98 %+.",
    external: true,
  },
];

const responseTiers = [
  {
    label: "Kritické - výpadek produkce, bezpečnost, integrita dat",
    sla: "První odpověď do 30 minut, 24/7 po celém světě",
  },
  {
    label: "Vysoké - postižena důležitá funkce, dotčeno více uživatelů",
    sla: "První odpověď do 12 hodin",
  },
  {
    label: "Standardní - dotazy, pomoc s nastavením",
    sla: "1 pracovní den",
  },
  {
    label: "Nízká priorita - zpětná vazba, požadavky na funkce",
    sla: "Až 3 pracovní dny",
  },
];
---

<Base
  title="Kontakt - RevenueHunt"
  description="Spoj se s týmem podpory RevenueHunt. Přečti si průvodce nápovědou, podívej se na tutoriál nebo vyplň kvíz podpory a získej personalizovanou odpověď během pár minut."
  jsonLd={jsonLd}
  lang="cs"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20 text-center">
      <Breadcrumb items={[{ label: "Domů", href: localizedHref("/", "cs") }, { label: "Kontakt" }]} />
      <Eyebrow>Ozvi se nám</Eyebrow>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Spoj se s námi
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600">
        Přečti si průvodce nápovědou, podívej se na tutoriál nebo vyplň náš kvíz podpory tady níže - ozve se ti
        nejbystřejší a nejpřívětivější tým podpory v ecommerce.
      </p>
    </div>
  </section>

  <!-- Two-column: video + channels -->
  <section class="mx-auto max-w-7xl px-6 py-12">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Začni tutoriálem</h2>
        <p class="mt-3 text-slate-600">
          Většina dotazů se vyřeší pomocí 3minutového průvodce. Mrkni na něj, než nám napíšeš.
        </p>
        <div class="mt-6 aspect-video overflow-hidden rounded-xl bg-slate-900 shadow-xl">
          <YouTubeFacade id="oL1DnBd6N1U" title="Tutoriál podpory RevenueHunt" />
        </div>
      </div>
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Jak nás kontaktovat</h2>
        <ul class="mt-6 space-y-3">
          {channels.map((c) => (
            <li>
              <a
                href={c.href}
                target={c.external ? "_blank" : undefined}
                rel={c.external ? "external noopener" : undefined}
                class="group flex items-start justify-between gap-4 rounded-xl border border-slate-200 bg-white p-5 transition hover:border-slate-300 hover:shadow-md"
              >
                <div>
                  <p class="text-base font-semibold text-slate-900 group-hover:text-[#16161D]">{c.label}</p>
                  <p class="mt-1 text-sm text-slate-600">{c.note}</p>
                </div>
                <span class="mt-1 shrink-0 text-slate-400 transition group-hover:text-[#16161D]" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Support quiz -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Vyplň náš kvíz podpory</h2>
      <p class="mx-auto mt-3 max-w-2xl text-slate-600">
        Odpověz na pár rychlých otázek a nasměrujeme tě ke správné pomoci - dokumentaci, tutoriálu nebo odpovědi od skutečného člověka.
      </p>
      <div class="mx-auto mt-8 max-w-4xl overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <iframe
          src="https://admin.revenuehunt.com/public/quiz/ZAHJoMM"
          title="Kvíz podpory RevenueHunt"
          loading="lazy"
          class="block h-[600px] w-full"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Response times — moved here from the right column so it sits under
       the quiz, since that's where visitors land after asking for help. -->
  <section class="mx-auto max-w-4xl px-6 py-16">
    <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm sm:p-10">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Časy odezvy</h2>
      <p class="mt-3 text-slate-600">
        Víceúrovňové SLA podpory pro všechny obchodníky, s prioritou pro účty Shopify Plus a enterprise.
      </p>
      <dl class="mt-6 grid gap-4 sm:grid-cols-2">
        {responseTiers.map((t) => (
          <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
            <dt class="text-sm font-semibold text-slate-900">{t.label}</dt>
            <dd class="mt-1 text-sm text-slate-600">{t.sla}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Base>
