---
import Base from "../../layouts/Base.astro";
import PlanCards from "../../components/pages/PlanCards.astro";
import YouTubeFacade from "../../components/YouTubeFacade.astro";
import { organization, website, softwareApplication } from "../../lib/schema";
import { SITE } from "../../lib/site";
import { localizedHref } from "../../lib/i18n";

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=bfs_badge_hero";
const WOOCOMMERCE_DOWNLOAD =
  "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";
const YOUTUBE_ID = "fJqpGJUzZNE";

const stats = [
  { value: "+20,000", label: "Značek používá RevenueHunt" },
  { value: "+45M", label: "Dokončených kvízů" },
  { value: "+370M USD", label: "Tržby pro obchodníky" },
  { value: "4.9 ★", label: "Více než 550 pětihvězdičkových recenzí" },
];

const pillars = [
  {
    image: "/img/pages/home/recommend-right-products.svg",
    title: "Doporuč ty správné produkty",
    body:
      "Kvízy s integrovanými produkty zvyšují prodeje, pomáhají zákazníkům najít produkty, které jsou pro ně ty pravé, a pomáhají jim rozhodovat se o nákupu s jistotou.",
  },
  {
    image: "/img/pages/home/know-your-customers.svg",
    title: "Poznej své zákazníky",
    body:
      "Kvízy ti umožní sbírat využitelná data tak, že svým zákazníkům kladeš konkrétní otázky. Segmentuj a označuj své kupující podle jejich odpovědí.",
  },
  {
    image: "/img/pages/home/grow-your-audience.svg",
    title: "Rozšiř své publikum",
    body:
      "Posílej zachycené leady do svého e-mailového seznamu nebo CRM. Využij data z profilu zákazníka k vytváření osobnějších marketingových kampaní s vyšším ROI.",
  },
];

const features = [
  {
    kicker: "Copilot pro kvízy s AI",
    title: "Vytvoř kvíz za 60 sekund pomocí AI",
    body:
      "Popiš svůj obchod a náš copilot s AI vygeneruje plně nakonfigurovaný kvíz - otázky, logiku a přiřazení produktů - připravený k publikování.",
  },
  {
    kicker: "Podmíněná logika",
    title: "Větvená logika pomocí přetahování",
    body:
      "Zobraz nebo skryj otázky podle předchozích odpovědí. Proveď každého kupujícího cestou, která končí nákupem - bez nutnosti programovat.",
  },
  {
    kicker: "Design kvízu",
    title: "Udělej si ho podle sebe - bez nutnosti programovat",
    body:
      "Přizpůsob barvy, fonty, obrázky a rozvržení tak, aby ladily s tvojí značkou. Tvůj kvíz vypadá jako součást tvého obchodu, ne jako widget od třetí strany.",
  },
  {
    kicker: "Stránka s výsledky",
    title: "Stránka s výsledky kvízu, která konvertuje",
    body:
      "Zobraz personalizovaná doporučení produktů seskupená podle kroku rutiny - s obrázky, cenami a tlačítky pro přidání do košíku. Kupující nakupují přímo ze stránky s výsledky.",
  },
  {
    kicker: "Analytika opouštění",
    title: "Zjisti přesně, kde kupující odcházejí",
    body:
      "Sleduj míry opouštění otázku po otázce, výstupy i výsledky. Oprav místa tření, zlepši dokončení a získej zpět ztracené tržby.",
  },
  {
    kicker: "Integrace třetích stran",
    title: "Propoj celý svůj marketingový stack",
    body:
      "Posílej data z kvízu do Google Analytics, spouštěj události Meta Pixelu pro retargeting a synchronizuj leady s Klaviyo - to vše z jediné stránky nastavení. Bez kódu, bez middlewaru.",
  },
];

const steps = [
  {
    title: "Nainstaluj si aplikaci",
    body: "Instalace na jedno kliknutí ze Shopify App Store nebo z adresáře pluginů WordPressu.",
  },
  {
    title: "Vytvoř si kvíz",
    body: "Použij copilot s AI nebo editor s přetahováním. Přidej své otázky, nastav svou logiku.",
  },
  {
    title: "Přiřaď své produkty",
    body: "Propoj odpovědi z kvízu se svým katalogem produktů. Doporuč nejlepší shodu pro každý výsledek.",
  },
  {
    title: "Publikuj a propaguj",
    body: "Vlož ho na jakoukoli stránku, zobraz ho jako pop-up při detekci úmyslu odejít nebo na něj odkazuj ze svých reklam.",
  },
];

const testimonials = [
  {
    quote:
      "Přešla jsem z Octane. Proces designu byl mnohem intuitivnější a vizuálně příjemnější. Když jsem měla problém s Klaviyo, podpora odpověděla rychlostí blesku a se super vstřícným a otevřeným přístupem.",
    author: "Kae Paché",
  },
  {
    quote:
      "Eric byl nesmírně trpělivý, schopný a důkladný - krok za krokem mě provedl nastavením kvízu. Taková podpora je vzácná.",
    author: "Marcelle",
  },
  {
    quote:
      "Samotná aplikace je vynikající: výkonné funkce, intuitivní použitelnost. Tým nám vytvořil personalizovaný průvodce na míru. Používáme ji už přes 3 roky.",
    author: "Didymos",
  },
  {
    quote:
      "Jednoznačně nejlepší aplikace pro kvízy a doporučování produktů, jakou jsem na Shopify zkoušela. Tým si dal čas na to, aby věc prozkoumal, srozumitelně vysvětlil každý krok a vedl mě, dokud nebyl problém zcela vyřešen.",
    author: "REYNA",
  },
  {
    quote:
      "Byla to už 5. aplikace pro kvízy, kterou jsem zkoušel, a jako jediná plně podporovala to, co jsem potřeboval. Svůj první kvíz jsem dokázal vytvořit hodně rychle.",
    author: "CCA Printing",
  },
  {
    quote:
      "Zákaznická podpora vyniká - agent natočil video a vysvětlil mi řešení krok za krokem. Velmi vstřícný a super nápomocný.",
    author: "The Love U Collective",
  },
];

const verticals = [
  { icon: "💄", title: "Krása a péče o pleť", body: "Vyhledávače typu pleti, výběr odstínu, tvůrci rutin." },
  { icon: "💊", title: "Doplňky stravy", body: "Kvízy zdravotních cílů, které doporučí ten správný stack." },
  { icon: "👗", title: "Móda", body: "Stylové kvízy, které odhalí správnou velikost, barvu i střih." },
  { icon: "🐾", title: "Mazlíčci", body: "Doporučení produktů podle plemene pro každého majitele." },
  { icon: "🍵", title: "Jídlo a nápoje", body: "Kvízy chuťového profilu, které z těch zvědavých udělají odběratele." },
  { icon: "🏋️", title: "Fitness", body: "Trychtýře založené na cílech pro vybavení, oblečení i programy." },
  { icon: "🏠", title: "Domov a dekorace", body: "Stylové kvízy, které spárují nábytek s každým prostorem domova." },
  { icon: "🌿", title: "Eko a udržitelné", body: "Kvízy, které propojí hodnoty pro uvědomělého spotřebitele." },
];

const brands = [
  "Olaplex", "Madluvv", "Mattel", "Alt", "Baia", "Bare", "Biktrix",
  "Dermocracy", "Diego", "Gisou", "Laura", "Nuxe", "Olcay",
  "Salad Code", "Salugea", "Sunday", "Tushy", "Tiege",
];

const SHOPIFY_REVIEWS =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/reviews?ratings%5B%5D=5&sort_by=relevance";
const WOOCOMMERCE_REVIEWS =
  "https://wordpress.org/support/plugin/product-recommendation-quiz-for-ecommerce/reviews/?filter=5";
---

<Base
  lang="cs"
  translated={true}
  title={`Kvíz s doporučením produktů - ${SITE.name}`}
  description="Proměň zvědavce, kteří jen prohlížejí, v kupující díky kvízu s doporučením produktů. Více než 20 000 značek, 4,9★, více než 550 recenzí. Zvyš konverzi a zachyť zero-party data díky kvízu s produkty."
  jsonLd={[organization(), website(), softwareApplication()]}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-7xl px-6 py-16 lg:py-24">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:items-start lg:gap-16">
        <div>
          <a
            href={SHOPIFY_INSTALL}
            rel="external nofollow"
            data-install="home_hero_badge"
            class="mb-6 inline-block"
          >
            <img
              src="/img/home/bfs-badge.webp"
              alt="Built for Shopify"
              width="120"
              height="38"
              class="h-8 w-auto"
              loading="eager"
            />
          </a>
          <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
            Kvíz s doporučením produktů, který promění zvědavce v kupující
          </h1>
          <p class="mt-6 max-w-xl text-lg text-slate-700">
            Placené reklamy přivedou prokliky - náš produktový kvíz je promění v prodeje. Kvízy RevenueHunt vedou kupující k těm správným produktům,
            sbírají data a zvyšují konverze. Snadná instalace, bez kódu.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={SHOPIFY_INSTALL}
              rel="external nofollow"
              data-install="home_hero"
              class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
            >
              nainstalovat na Shopify
            </a>
            <a
              href={WOOCOMMERCE_DOWNLOAD}
              rel="external nofollow"
              onclick="window.gtag&&gtag('event','download_woocommerce_plugin',{event_label:'home_hero'})"
              class="inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-6 py-3 text-base font-semibold text-slate-900 transition hover:border-slate-400 hover:bg-slate-50"
            >
              získat pro WooCommerce
            </a>
          </div>
          <p class="mt-4 text-sm text-slate-500">
            K dispozici bezplatný plán · 15denní zkušební verze zdarma · 30denní záruka vrácení peněz
          </p>
        </div>

        <div class="relative lg:mt-14">
          <div class="aspect-video overflow-hidden rounded-xl bg-slate-900 shadow-2xl">
            <YouTubeFacade
              id={YOUTUBE_ID}
              title="RevenueHunt - kvíz s doporučením produktů"
              poster="/img/home/video-poster.webp"
              alt="Demo kvízu s doporučením produktů od RevenueHunt pro obchody Shopify a WooCommerce"
              eager
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats / proof bar -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <p class="text-center text-sm font-semibold uppercase tracking-wider text-white/70">
        Proč zvolit RevenueHunt? Náš dopad hovoří sám za sebe
      </p>
      <dl class="mt-8 grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-4">
        {stats.map((s) => (
          <div class="text-center">
            <dt class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{s.value}</dt>
            <dd class="mt-2 text-sm text-white/70">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Problem framing -->
  <section class="mx-auto max-w-4xl px-6 py-20 text-center">
    <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
      Kupující ne vždy vědí, co koupit - a to znamená ztracené prodeje.
    </h2>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-700">
      Náš <a href={localizedHref("/product-recommendation-quiz/", "cs")} class="font-semibold text-slate-900 underline underline-offset-4 hover:text-slate-700">kvíz s doporučením produktů</a> provede každého zákazníka jeho cestou a pomůže mu objevit a koupit produkty, které jsou pro něj ty pravé.
    </p>
  </section>

  <!-- 3-up pillars -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="grid gap-10 md:grid-cols-3">
        {pillars.map((p) => (
          <div class="text-center">
            <img src={p.image} alt={p.title} width="120" height="120" class="mx-auto h-24 w-24" loading="lazy" />
            <h3 class="mt-6 text-xl font-semibold text-slate-900">{p.title}</h3>
            <p class="mt-3 text-slate-600">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features grid -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Vše, co potřebuješ, abys prodával chytřeji</h2>
      </div>
      <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {features.map((f) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">{f.kicker}</p>
            <h3 class="mt-2 text-xl font-semibold text-slate-900">{f.title}</h3>
            <p class="mt-3 text-slate-600">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4-step setup -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Spuštěno ve 4 krocích. Za méně než 15 minut.</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          Bez vývojářů. Bez kódu. Jen kvíz, který si tví zákazníci zamilují.
        </p>
      </div>
      <ol class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <li class="rounded-xl border border-slate-200 bg-white p-6">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-[#16161D] text-sm font-bold text-white">{i + 1}</span>
            <h3 class="mt-4 text-lg font-semibold text-slate-900">{s.title}</h3>
            <p class="mt-2 text-slate-600">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          Zjisti, proč obchodníci milují kvíz s doporučením produktů
        </h2>
        <p class="mx-auto mt-4 max-w-3xl text-lg text-slate-700">
          S důvěrou více než 20 000 značek a podpořen více než 550 pětihvězdičkovými recenzemi na Shopify, WooCommerce a dalších -
          RevenueHunt je špičková aplikace pro kvízy, jak zvýšit prodeje pomocí personalizace. Ale nevěř jen našemu slovu.
        </p>
        <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap text-sm">
          <a href={SHOPIFY_REVIEWS} rel="external nofollow" class="font-semibold text-[#16161D] underline-offset-4 hover:underline">
            Recenze na Shopify →
          </a>
          <a href={WOOCOMMERCE_REVIEWS} rel="external nofollow" class="font-semibold text-[#16161D] underline-offset-4 hover:underline">
            Recenze na WooCommerce →
          </a>
        </div>
      </div>

      <h3 class="mt-16 text-center text-xl font-semibold text-slate-900">Co říkají obchodníci</h3>
      <div class="rh-carousel mt-8">
        <ul data-carousel class="rh-carousel__track" aria-label="Reference obchodníků">
          {testimonials.map((t) => (
            <li class="rounded-xl border border-slate-200 bg-white p-6">
              <p class="text-amber-500" aria-label="5 z 5 hvězd">★★★★★</p>
              <blockquote class="mt-3 text-slate-700">"{t.quote}"</blockquote>
              <p class="mt-4 text-sm font-semibold text-slate-900"> - {t.author}</p>
            </li>
          ))}
        </ul>
        <div data-carousel-dots class="rh-carousel__dots"></div>
      </div>
    </div>
  </section>

  <!-- Verticals -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Vytvořeno pro každou vertikálu eCommerce</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          Ať prodáváš péči o pleť, doplňky stravy nebo pohovky - kvíz, který kupujícím pomáhá najít ten správný produkt, konvertuje lépe než jakákoli stránka kolekce.
        </p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {verticals.map((v) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6">
            <span class="block text-3xl" aria-hidden="true">{v.icon}</span>
            <h3 class="mt-3 text-base font-semibold text-slate-900">{v.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Brand logos -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-white sm:text-3xl">Poháníme nejlepší značky eCommerce</h2>
      <div class="brands-marquee mt-10">
        <ul class="brands-marquee__track" aria-label="Loga zákaznických značek">
          {brands.map((b) => (
            <li class="brands-marquee__item">
              <img
                src={`/img/brands/${b.toLowerCase().replace(/ /g, "-")}.svg`}
                alt={b}
                loading="lazy"
                width="160"
                height="40"
              />
            </li>
          ))}
          {brands.map((b) => (
            <li class="brands-marquee__item" aria-hidden="true">
              <img
                src={`/img/brands/${b.toLowerCase().replace(/ /g, "-")}.svg`}
                alt={`${b} logo`}
                loading="lazy"
                width="160"
                height="40"
              />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <style>
    .brands-marquee {
      overflow: hidden;
      -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
      mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    }
    .brands-marquee__track {
      display: flex;
      align-items: center;
      width: max-content;
      list-style: none;
      padding: 0;
      margin: 0;
      animation: brands-marquee 40s linear infinite;
    }
    .brands-marquee:hover .brands-marquee__track {
      animation-play-state: paused;
    }
    .brands-marquee__item {
      flex-shrink: 0;
      padding: 10px 24px;
      height: 64px;
      display: flex;
      align-items: center;
    }
    .brands-marquee__item img {
      height: 100%;
      width: auto;
      max-width: 160px;
      object-fit: contain;
      /* Normalize mixed-fill SVGs to white on the dark strip. */
      filter: brightness(0) invert(1);
      opacity: 0.85;
    }
    @keyframes brands-marquee {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }
    @media (prefers-reduced-motion: reduce) {
      .brands-marquee__track { animation: none; }
    }
  </style>

  <!-- Plans summary -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Vyber ten nejlepší plán pro svůj eCommerce</h2>
        <p class="mt-4 text-base text-slate-700 sm:text-lg">
          K dispozici bezplatný plán. 15denní zkušební verze zdarma s neomezenými odpověďmi v kvízu a všemi funkcemi. 30denní záruka vrácení peněz.
        </p>
      </div>

      <div class="mt-12">
        <PlanCards lang="cs" />
      </div>
    </div>
  </section>

  <!-- Multi-platform strip -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-16 text-center">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Funguje na více platformách eCommerce</h2>
      <!-- Logos are white SVGs (built for a dark bg); brightness-0 inverts them to dark for this white section. -->
      <ul class="mt-10 flex flex-wrap items-center justify-center gap-x-14 gap-y-8">
        <li>
          <a href={localizedHref("/product-recommendation-quiz-shopify/", "cs")} aria-label="Kvíz s doporučením produktů pro Shopify">
            <img src="/img/logos/shopify_monotone_white.svg" alt="Shopify" class="h-8 w-auto opacity-60 brightness-0 transition hover:opacity-100" />
          </a>
        </li>
        <li>
