---
import Base from "../../../layouts/Base.astro";
import PageHero from "../../../components/PageHero.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import { organization, breadcrumb, softwareApplication, faqPage } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=roi_calculator";
// Free WordPress.org plugin (not the WooCommerce.com extension).
const WOO_PLUGIN = "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";

// Inputs. The quiz-taker conversion rate carries a benchmark flag (RevenueHunt
// data badge + helper note) and is editable. The AOV uplift is NOT a visible
// input: it is set by the sector dropdown (hidden #aovlift field) from the
// within-store paired result (median +11% to +15%, concentrated in skincare/
// beauty/supplements, flat in a few categories) and folded into the math.
// Everything else is the merchant's own number.
// (Data: PRD-Octane-AI-SEO-Reverse-Engineering W7 deep-dive note.)
const controls = [
  { id: "visitors", label: "Měsíční návštěvníci obchodu", min: 500, max: 500000, step: 500, value: 10000, suffix: "" },
  { id: "engage", label: "Procento návštěvníků, kteří vyplní kvíz", min: 1, max: 100, step: 1, value: 15, suffix: "%" },
  { id: "aov", label: "Tvá průměrná hodnota objednávky", min: 10, max: 1000, step: 5, value: 60, suffix: "$" },
  { id: "cvr", label: "Tvá aktuální míra konverze", min: 0.1, max: 15, step: 0.1, value: 2, suffix: "%" },
  { id: "quizcvr", label: "Míra konverze toho, kdo vyplní kvíz", min: 1, max: 50, step: 0.5, value: 5.5, suffix: "%", benchmark: true, note: "Předvyplněno naším naměřeným benchmarkem: v průměru 1 z 18 lidí, kteří vyplní kvíz, provede objednávku. Uprav ho, aby odpovídal tvému obchodu." },
];

// Sector presets for the "what do you sell?" selector. Each sets the quiz-taker
// conversion rate and AOV uplift from measured RevenueHunt data, plus a "% of the
// average store" figure (quiz rate / a 2% average). "All sectors" is the 5.5%
// platform average (= 275%, the brand stat). "Other sectors" is the honest
// residual (everything except the consumable stars), measured at ~3.6% (~180%).
// Selecting a sector pre-fills quizcvr + aovlift; both stay editable.
// (Data: PRD-Octane-AI-SEO-Reverse-Engineering W7 deep-dive note.)
const SECTORS = [
  { id: "all", label: "Všechny obory (průměr)", quizcvr: 5.5, aovlift: 10, pct: 275 },
  { id: "haircare", label: "Péče o vlasy", quizcvr: 7, aovlift: 15, pct: 350 },
  { id: "fragrance", label: "Parfémy", quizcvr: 7, aovlift: 0, pct: 350 },
  { id: "beauty", label: "Krása a péče o pleť", quizcvr: 6, aovlift: 20, pct: 300 },
  { id: "supplements", label: "Doplňky stravy a zdraví", quizcvr: 6, aovlift: 10, pct: 300 },
  { id: "coffee", label: "Káva a čaj", quizcvr: 5, aovlift: 0, pct: 250 },
  { id: "other", label: "Ostatní obory", quizcvr: 3.6, aovlift: 10, pct: 180 },
];

// Per-vertical conversion (response to order), measured in RevenueHunt data and
// rounded down. The 5.5% benchmark is a platform average; consumable categories
// run higher. Shown as a "conversion by category" proof block.
const BY_VERTICAL = [
  { v: "Péče o vlasy", pct: "350%", lift: "+15% AOV" },
  { v: "Parfémy", pct: "350%", lift: "AOV beze změny" },
  { v: "Péče o pleť a krása", pct: "300%", lift: "+20% AOV" },
  { v: "Doplňky stravy", pct: "300%", lift: "+10% AOV" },
  { v: "Káva a čaj", pct: "250%", lift: "AOV beze změny" },
  { v: "Ostatní obory", pct: "180%", lift: "+10% AOV" },
];

// Real, data-backed proof points shown on the page. The 275% is the measured
// 5.5% quiz-taker conversion (1 in 18) expressed against a typical 2% store
// rate: 5.5 / 2 = 2.75x = 275% of baseline (accurate as "of", not "+lift").
const PROOF = [
  { stat: "45M+", label: "analyzovaných odpovědí v kvízu" },
  { stat: "275%", label: "průměrné míry konverze" },
  { stat: "$370M+", label: "tržeb vygenerovaných pro obchodníky" },
  { stat: "20 000+", label: "značek používá RevenueHunt" },
];

const faqs: { question: string; answer: string; answerHtml?: string }[] = [
  {
    question: "Odkud se bere míra konverze kvízu?",
    answer:
      "Je to benchmark ze skutečných dat RevenueHunt. V souboru odpovědí z kvízů 5,5 % kupujících, kteří kvíz dokončí (zhruba 1 z 18), nakonec provede naměřenou objednávku. Pole je tímto benchmarkem předvyplněno a ty ho můžeš upravit, aby odpovídal tvému vlastnímu obchodu.",
  },
  {
    question: "Jak se počítají tržby navíc?",
    answer:
      "Kalkulačka vezme procento tvých návštěvníků, kteří kvíz dokončí, aplikuje na ně míru konverze toho, kdo vyplní kvíz, a porovná ji s konverzí, kterou by ti samí návštěvníci měli při aktuální míře tvého webu. Tento rozdíl vynásobený tvou průměrnou hodnotou objednávky představuje odhadované tržby navíc.",
  },
  {
    question: "Utrácejí kupující, kteří vyplní kvíz, na objednávku víc?",
    answer:
      "V průměru ano, při srovnání srovnatelného se srovnatelným. V rámci jednoho obchodu jsou objednávky, které přišly přes kvíz, zhruba o 10 % vyšší než ty ostatní. Není to všude stejné: silnější je to v kategoriích jako péče o pleť, krása a doplňky stravy a téměř beze změny v jiných. Kalkulačka to automaticky zohlední podle oboru, který si zvolíš.",
  },
  {
    question: "Je to založené na skutečných datech, nebo na vymyšlených násobcích?",
    answer:
      "Na skutečných datech. Benchmark konverze kvízu je naměřen na více než 45 milionech odpovědí z kvízů a více než 370 milionech dolarů v tržbách vygenerovaných pro obchodníky. Tví návštěvníci, tvá průměrná hodnota objednávky a tvá aktuální míra konverze jsou tvá vlastní čísla. Výsledek je odhad, ne záruka.",
  },
  {
    question: "Kde si můžu prohlédnout všechna data za těmito benchmarky?",
    answer:
      "V naší benchmarkové zprávě o ecommerce kvízech. Rozebírá konverzi podle kategorie, nárůst průměrné hodnoty objednávky, dokončení a atribuci napříč více než 45M skutečných odpovědí z kvízů. Benchmark 5,5 % a čísla podle oboru v této kalkulačce pocházejí přímo z ní.",
    answerHtml:
      "V naší <a href=\"" + localizedHref("/state-of-product-recommendation-quizzes/", "cs") + "\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">benchmarkové zprávě o ecommerce kvízech</a>. Rozebírá konverzi podle kategorie, nárůst průměrné hodnoty objednávky, dokončení a atribuci napříč více než 45M skutečných odpovědí z kvízů. Benchmark 5,5 % a čísla podle oboru v této kalkulačce pocházejí přímo z ní.",
  },
  {
    question: "Je kalkulačka zdarma?",
    answer:
      "Ano. Je zdarma a bez bariér, není potřeba e-mail. Samotný RevenueHunt má také bezplatný plán se 100 odpověďmi v kvízu měsíčně, takže si můžeš změřit skutečný nárůst ve svém vlastním obchodě.",
  },
];

const jsonLd = [
  organization(),
  softwareApplication(),
  breadcrumb([
    { name: "Domů", url: "/" },
    { name: "Kalkulačka ROI kvízu", url: "/quiz-roi-calculator/" },
  ]),
  faqPage(faqs),
];
---

<Base
  title="Kalkulačka ROI kvízu pro ecommerce"
  description="Bezplatná kalkulačka ROI kvízu založená na skutečných datech: 5,5 % těch, kdo vyplní kvíz, provede objednávku. Odhadni tržby navíc a ROI, které by kvíz mohl tvému obchodu přinést."
  ogImage="/og/quiz-roi-calculator.png"
  jsonLd={jsonLd}
  lang="cs"
  translated={true}
>
  <!-- Hero -->
  <PageHero>
      <Breadcrumb items={[{ label: "Domů", href: localizedHref("/", "cs") }, { label: "Kalkulačka ROI kvízu" }]} />
      <div class="text-center">
        <Eyebrow>Nástroj zdarma</Eyebrow>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">Kalkulačka ROI kvízu</h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          Zjisti, kolik tržeb navíc by tvému obchodu mohl přinést kvíz s doporučením produktů. Konverzní benchmark 275 % je skutečný, <a href={localizedHref("/state-of-product-recommendation-quizzes/", "cs")} class="font-semibold text-[#16161D] underline decoration-2 decoration-[#16161D]/40 underline-offset-2 hover:decoration-[#16161D]">naměřený na více než 45M odpovědích z kvízů</a>, ne vymyšlený násobek. Uprav data tak, aby odpovídala tvým číslům.
        </p>
      </div>
  </PageHero>

  <!-- Real-data proof band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-8">
      <div class="rounded-2xl bg-[#16161D] px-6 py-10 sm:px-10">
        <p class="text-center text-sm font-semibold uppercase tracking-wider text-white/50">Založeno na skutečných datech RevenueHunt</p>
        <dl class="mt-6 grid grid-cols-2 gap-8 text-center sm:grid-cols-4">
          {PROOF.map((p) => (
            <div>
              <dt class="text-3xl font-bold tracking-tight text-white">{p.stat}</dt>
              <dd class="mt-1 text-sm text-white/70">{p.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- Calculator -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 pb-8 pt-10">
      <div class="grid gap-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm lg:grid-cols-2 lg:p-8">
        <!-- Inputs -->
        <form id="roi-form" class="space-y-6" aria-label="Data ROI kvízu">
          <div>
            <label for="sector" class="text-sm font-medium text-slate-900">Co prodáváš?</label>
            <select
              id="sector"
              class="mt-2 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-900 focus:border-[#16161D] focus:outline-none focus:ring-1 focus:ring-[#16161D]"
            >
              {SECTORS.map((s) => (
                <option value={s.id} data-quizcvr={s.quizcvr} data-aovlift={s.aovlift} data-pct={s.pct}>{s.label}</option>
              ))}
            </select>
            <p class="mt-2 rounded-md bg-[#D8F0FE] px-3 py-2 text-xs text-[#2c81b2] ring-1 ring-inset ring-[#2c81b2]/20">
              <span id="sector-note">V souboru kvízů RevenueHunt ti, kdo vyplní kvíz, konvertují na zhruba 275 % průměrného obchodu a provádějí objednávky zhruba o 10 % větší. Vyber svůj obor pro přesnější benchmark.</span>
            </p>
          </div>
          {controls.map((c) => (
            <div>
              <div class="flex items-center justify-between gap-3">
                <label for={c.id} class="text-sm font-medium text-slate-900">
                  {c.label}
                </label>
                <div class="flex items-center gap-1 text-sm">
                  {c.suffix === "$" && <span class="text-slate-500">$</span>}
                  <input
                    type="number"
                    id={c.id}
                    min={c.min}
                    max={c.max}
                    step={c.step}
                    value={c.value}
                    class="w-24 rounded-md border border-slate-300 px-2 py-1 text-right font-semibold text-slate-900 focus:border-[#16161D] focus:outline-none focus:ring-1 focus:ring-[#16161D]"
                  />
                  {c.suffix === "%" && <span class="text-slate-500">%</span>}
                </div>
              </div>
              <input
                type="range"
                id={`${c.id}-range`}
                min={c.min}
                max={c.max}
                step={c.step}
                value={c.value}
                class="mt-3 w-full accent-[#16161D]"
                aria-label={`${c.label} slider`}
              />
              {c.note && (
                <p class="mt-2 text-xs text-slate-500">
                  <span id={`${c.id}-note`}>{c.note}</span>
                  {c.benchmark && (
                    <>
                      {" "}
                      <button
                        type="button"
                        id={`${c.id}-reset`}
                        class="hidden font-medium text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-[#16161D]"
                      >
                        Obnovit na data RevenueHunt
                      </button>
                    </>
                  )}
                </p>
              )}
            </div>
          ))}
          <!-- AOV uplift is not user-editable: the sector dropdown sets it. -->
          <input type="hidden" id="aovlift" value="10" />
        </form>

        <!-- Results -->
        <div class="flex flex-col gap-4 rounded-xl bg-slate-50 p-6">
          <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">Odhadovaný dopad</p>
          <div>
            <p class="text-sm text-slate-600">Tržby navíc měsíčně</p>
            <p id="out-monthly" class="mt-1 text-4xl font-bold tracking-tight text-[#16161D]">$0</p>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div class="rounded-lg border border-slate-200 bg-white p-4">
              <p class="text-xs text-slate-600">Tržby navíc ročně</p>
              <p id="out-annual" class="mt-1 text-xl font-bold text-slate-900">$0</p>
            </div>
            <div class="rounded-lg border border-slate-200 bg-white p-4">
              <p class="text-xs text-slate-600">Objednávky navíc měsíčně</p>
              <p id="out-orders" class="mt-1 text-xl font-bold text-slate-900">0</p>
            </div>
          </div>
          <dl class="mt-2 space-y-1 text-sm text-slate-600">
            <div class="flex justify-between">
              <dt>Lidé, kteří vyplní kvíz, měsíčně</dt>
              <dd id="out-takers" class="font-medium text-slate-900">0</dd>
            </div>
            <div class="flex justify-between">
              <dt>Objednávky z kvízu měsíčně</dt>
              <dd id="out-quizorders" class="font-medium text-slate-900">0</dd>
            </div>
            <div class="flex justify-between">
              <dt>Základní měsíční tržby</dt>
              <dd id="out-baseline" class="font-medium text-slate-900">$0</dd>
            </div>
            <div class="flex justify-between">
              <dt>S kvízem</dt>
              <dd id="out-withquiz" class="font-medium text-slate-900">$0</dd>
            </div>
          </dl>
          <a
            href={SHOPIFY_INSTALL}
            target="_blank"
            rel="external noopener nofollow"
            data-install="roi_calculator"
            class="mt-2 inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
          >
            nainstalovat na Shopify
          </a>
          <a
            href={WOO_PLUGIN}
            target="_blank"
            rel="external noopener nofollow"
            onclick="window.gtag&&gtag('event','woocommerce_plugin_click',{event_label:'roi_calculator'})"
            class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
          >
            nainstalovat na WooCommerce
          </a>
        </div>
      </div>
      <p class="mt-4 text-xs text-slate-500">
        Míra konverze toho, kdo vyplní kvíz, je benchmark, který můžeš upravit, a nárůst AOV se aplikuje automaticky podle tvého oboru; oba pocházejí ze skutečných dat RevenueHunt a tvůj obchod se bude lišit. Návštěvníci, průměrná hodnota objednávky a aktuální míra konverze jsou tvá vlastní čísla. Toto je odhad, ne záruka, a skutečné výsledky závisí na tvém obchodě, tvé návštěvnosti a tvém kvízu.
      </p>
    </div>
  </section>

  <!-- Recommended plan + ROI -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 pb-14">
      <div class="rounded-2xl border-2 border-[#16161D] bg-slate-50 p-6 sm:p-8">
        <p class="text-center text-sm font-semibold uppercase tracking-wider text-slate-500">Tvůj doporučený plán a ROI</p>
        <div class="mt-5 grid gap-6 sm:grid-cols-3">
          <div class="rounded-xl border border-slate-200 bg-white p-5">
            <p class="text-xs text-slate-600">Odhadované odpovědi v kvízu / měsíc</p>
            <p id="out-responses" class="mt-1 text-3xl font-bold tracking-tight text-slate-900">0</p>
          </div>
          <div class="rounded-xl border border-slate-200 bg-white p-5">
            <p class="text-xs text-slate-600">Doporučený plán</p>
            <p id="out-plan" class="mt-1 text-3xl font-bold tracking-tight text-slate-900">Free Plan</p>
            <p id="out-plancost" class="text-sm text-slate-600">Zdarma</p>
          </div>
          <div class="rounded-xl border border-slate-200 bg-white p-5">
            <p class="text-xs text-slate-600">Návratnost vůči ceně plánu</p>
            <p id="out-roi" class="mt-1 text-3xl font-bold tracking-tight text-emerald-600">-</p>
            <p id="out-net" class="text-sm text-slate-600"></p>
          </div>
        </div>
        <p class="mt-5 text-center text-sm text-slate-700"><span id="plan-note"></span> <a href={localizedHref("/pricing/", "cs")} class="font-medium text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-[#16161D]">Zobrazit všechny plány</a>.</p>
        <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
          <a
            href={SHOPIFY_INSTALL}
            target="_blank"
            rel="external noopener nofollow"
            data-install="roi_calculator_plan"
            class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
          >
            začít zdarma na Shopify
          </a>
          <a
            href={WOO_PLUGIN}
            target="_blank"
            rel="external noopener nofollow"
            onclick="window.gtag&&gtag('event','woocommerce_plugin_click',{event_label:'roi_calculator_plan'})"
            class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
          >
            začít zdarma na WooCommerce
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Conversion by category -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 pb-14">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
        <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Nárůst míry konverze podle oboru</h2>
        <p class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
          Ve srovnání s typickým obchodem se 2 % ti, kdo vyplní kvíz RevenueHunt, konvertují několikanásobně víc. Tady je každá kategorie jako procento tohoto průměru, s nárůstem hodnoty objednávky tam, kde ho vidíme.
        </p>
        <dl class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-xl bg-slate-200 sm:grid-cols-3 lg:grid-cols-6">
          {BY_VERTICAL.map((b) => (
            <div class="bg-white px-4 py-6 text-center">
              <dt class="text-3xl font-bold tracking-tight text-[#16161D]">{b.pct}</dt>
              <dd class="mt-1 text-sm text-slate-600">{b.v}</dd>
              <dd class={`mt-2 text-xs font-medium ${b.lift.startsWith("+") ? "text-emerald-700" : "text-slate-400"}`}>{b.lift}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-4 text-center text-xs text-slate-500">
          Zobrazeno jako procento typické míry konverze obchodu ve výši 2 %, naměřené v našich datech. Tvůj obchod se bude lišit.
        </p>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Jak kalkulačka funguje</h2>
      <div class="mt-8 space-y-5 text-lg text-slate-700">
        <p>
          Model je záměrně jednoduchý a poctivý. Vezme procento tvých návštěvníků, kteří kvíz dokončí, převede je na míru toho, kdo vyplní kvíz, a porovná to s tím, co by ti samí návštěvníci udělali při aktuální <a href="/glossary/conversion-rate-optimization/" class="font-medium text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-[#16161D]">míře konverze</a> tvého webu. Tento rozdíl představuje odhadované tržby navíc.
        </p>
        <p>
          Podle dat shromážděných napříč více než 45 miliony skutečných odpovědí z kvízů provede 5,5 % kupujících, kteří dokončí kvíz RevenueHunt (zhruba 1 z 18), naměřenou objednávku. Oproti typické míře konverze obchodu ve výši 2 % je to 2,75x, zhruba 275 % toho, co obchod obvykle zkonvertuje. Toto číslo předvyplníme a necháme tě ho upravit.
        </p>
        <p>
          Analyzovali jsme také hodnotu objednávky. Při srovnání srovnatelného se srovnatelným, v rámci jednoho obchodu, jsou objednávky z kvízu zhruba o 10 % vyšší než objednávky bez kvízu. Nárůst je silnější v kategoriích jako péče o pleť, krása a doplňky stravy a téměř beze změny v některých jiných. Kalkulačka aplikuje konzervativní a datově podložený nárůst podle oboru, který si zvolíš, takže nemusíš hádat.
        </p>
        <p>
          Kalkulačka používá tvou vlastní <a href="/glossary/average-order-value/" class="font-medium text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-[#16161D]">průměrnou hodnotu objednávky</a> a ignoruje e-mailové leady a zero-party data, která kvíz zachytí a která se v čase hromadí, takže má sklon celkovou hodnotu podceňovat.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900">Časté dotazy</h2>
      <div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
        {faqs.map((faq) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-lg font-semibold text-slate-900 [&::-webkit-details-marker]:hidden">
              <span>{faq.question}</span>
              <svg
                class="h-5 w-5 flex-shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <p class="pb-5 text-slate-700" set:html={faq.answerHtml ?? faq.answer} />
          </details>
        ))}
      </div>
    </div>
