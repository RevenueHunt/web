---
import Base from "../../../layouts/Base.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import { organization, breadcrumb, article, faqPage } from "../../../lib/schema";
import { SITE } from "../../../lib/site";
import { localizedHref } from "../../../lib/i18n";
import {
  REPORT,
  DATASET,
  HEADLINE,
  VERTICAL_CONVERSION,
  AOV_UPLIFT,
  ATTRIBUTION,
  BASELINES,
} from "../../../lib/quiz-benchmarks";

const pageUrl = new URL(`/${REPORT.slug}/`, SITE.site_url).href;
const ogImage = `/og/${REPORT.slug}.png`;

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=state_of_product_quizzes";
// Free WordPress.org plugin (not the WooCommerce.com extension).
const WOO_PLUGIN =
  "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";

const formatN = (n: number | null) =>
  n === null ? "" : n.toLocaleString("en-US");

// Conversion expressed against a typical 2% store: 6.9% / 2% = 345%.
const boost = (rate: number) => Math.round((rate / HEADLINE.baselinePct) * 100);

// Přeložená metodika + FAQ (sdílený datový modul zůstává anglicky kvůli PDF
// a stat kartám). Definováno před jsonLd, aby faqPage(FAQ) použilo přeloženou sadu.
const METHODOLOGY = [
  "Zdroj: vlastní platforma RevenueHunt, napříč každou ecommerce platformou, kterou podporujeme. Agregované a anonymizované: žádný jednotlivý obchod není identifikovatelný a naše vlastní demo obchody jsou všude vyloučeny.",
  "Konverze je míra na osobu, která vyplní kvíz: objednávky přiřazené odpovědi v kvízu, vydělené dokončenými kvízy. Není to míra za celý web. Ti, kdo vyplní kvíz, se sami vybírají a jsou angažovanější než průměrný návštěvník, takže to není srovnání jedna ku jedné s celkovou konverzí obchodu. Říkáme to všude, kde to srovnání děláme.",
  "Kategorie se odvozuje z názvu kvízu, který napsal obchodník (například „Kvíz na péči o pleť“, „Kvíz na krmivo pro psy“). Zhruba 78 % odpovědí pochází z generických nebo nepojmenovaných kvízů a je vyloučeno z každého čísla podle kategorie.",
  "Nárůst average order value se měří v rámci jednoho obchodu: medián hodnoty objednávky z kvízu daného obchodu oproti jeho mediánu hodnoty objednávky bez kvízu. To je robustní vůči měně a odstraňuje to zkreslení mixem obchodů, které ten efekt rozmělní v naivním průměru přes celou platformu.",
  "Každé číslo konverze je minimum. Atribuce se stále hromadí, jak obchodníci synchronizují objednávky (9 % prvních objednávek přichází více než 30 dní po kvízu), a objednávky napříč zařízeními nebo nesledované se nepřipojí nikdy. Skutečná čísla jsou vyšší, ne nižší.",
];

const FAQ = [
  {
    question: "Jak se měří konverze kvízu?",
    answer:
      "Objednávky přiřazené odpovědi v kvízu, vydělené dokončenými kvízy. Napříč platformou 5,5 % kupujících, kteří dokončí kvíz (zhruba 1 z 18), provede sledovanou objednávku. Je to míra na osobu, která vyplní kvíz, ne míra za celý web: ti, kdo vyplní kvíz, jsou angažovanější než průměrný návštěvník, takže to není přímo srovnatelné s celkovou konverzí obchodu.",
  },
  {
    question: "Proč je konverze kvízu tolik vyšší než u průměrného obchodu?",
    answer:
      "Dva důvody. Zaprvé samotný kvíz: nahrazuje zahlcující katalog krátkou konverzací a jasným doporučením, což odstraňuje nerozhodnost, která prosakuje prodeje. Zadruhé to, co se děje poté, co dorazí odpovědi: každý kvíz zachytí zero-party data a označí kupujícího, což pohání segmentované follow-up toky a retargeting. Segmentované kampaně generují více než 3krát vyšší tržby na příjemce než plošná rozesílání (segmentační benchmark Klaviyo), takže kvíz dál konvertuje prostřednictvím personalizovaného e-mailu a reklam, ne jen na stránce s výsledky.",
    answerHtml:
      "Dva důvody. Zaprvé samotný kvíz: nahrazuje zahlcující katalog krátkou konverzací a jasným doporučením, což odstraňuje nerozhodnost, která prosakuje prodeje. Zadruhé to, co se děje poté, co dorazí odpovědi: každý kvíz zachytí zero-party data a označí kupujícího, což pohání segmentované follow-up toky a retargeting. Segmentované kampaně generují více než 3krát vyšší tržby na příjemce než plošná rozesílání (<a href=\"https://www.klaviyo.com/marketing-resources/segmentation-benchmark-report\" target=\"_blank\" rel=\"external noopener nofollow\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">segmentační benchmark Klaviyo</a>), takže kvíz dál konvertuje prostřednictvím personalizovaného e-mailu a reklam, ne jen na stránce s výsledky.",
  },
  {
    question: "Utrácejí kupující z kvízu opravdu víc na objednávku?",
    answer:
      "V průměru ano, měřeno srovnatelně. V rámci stejného obchodu jsou objednávky, které přišly přes kvíz, zhruba o 11 % až 15 % vyšší než ty, které ne, a to platí zhruba v 7 z 10 obchodů. Není to univerzální: nejsilnější je to v kráse a péči o pleť (zhruba +20 %), plošší v kategoriích jako parfémy a káva.",
  },
  {
    question: "Jak se tyto benchmarky vztahují na můj obchod?",
    answer:
      "Zadej svou vlastní návštěvnost, average order value a aktuální konverzi do naší kalkulačky ROI kvízu. Ta prožene tytéž benchmarky (míru 5,5 % na osobu, která vyplní kvíz, konverzi podle kategorie, nárůst AOV) tvými čísly, aby odhadla, kolik tržeb navíc by kvíz mohl přidat.",
    answerHtml:
      "Zadej svou vlastní návštěvnost, average order value a aktuální konverzi do naší <a href=\"/cs/quiz-roi-calculator/\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">kalkulačky ROI kvízu</a>. Ta prožene tytéž benchmarky (míru 5,5 % na osobu, která vyplní kvíz, konverzi podle kategorie, nárůst AOV) tvými čísly, aby odhadla, kolik tržeb navíc by kvíz mohl přidat.",
  },
  {
    question: "Jsou data anonymizovaná?",
    answer:
      "Ano. Každé číslo je agregované a sdružené přes miliony odpovědí a tisíce obchodů. Žádný jednotlivý obchod není identifikovatelný. Report existuje proto, aby sdílel, co data říkají, ne aby odhalil kteréhokoli obchodníka.",
  },
  {
    question: "Můžu tato čísla použít?",
    answer:
      "Ano. Cituj je s odkazem na tuto stránku. Report je zdarma a bez bran, PDF je ke stažení a klíčová čísla jsou k dispozici jako karty ke sdílení.",
  },
];

const pageTitle = "Stav kvízů s doporučením produktů: benchmarkový report 2026";
const pageDescription = "Jak si kvízy s doporučením produktů opravdu vedou: konverze, dokončení a průměrná hodnota objednávky, na základě více než 45M reálných odpovědí z více než 20 000 e-commerce obchodů.";

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Domů", url: localizedHref("/", "cs") },
    { name: "Stav kvízů s doporučením produktů", url: localizedHref(`/${REPORT.slug}/`, "cs") },
  ]),
  article({
    title: pageTitle,
    description: pageDescription,
    url: pageUrl,
    image: ogImage,
    datePublished: REPORT.datePublished,
    dateModified: REPORT.dateModified,
    author: "RevenueHunt",
    tags: [
      "kvíz s doporučením produktů benchmark",
      "quiz conversion rate",
      "ecommerce personalization",
      "average order value",
    ],
  }),
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "RevenueHunt benchmarky kvízu s doporučením produktů 2026",
    description: pageDescription,
    url: pageUrl,
    creator: organization(),
    license: "https://creativecommons.org/licenses/by/4.0/",
    isAccessibleForFree: true,
    datePublished: REPORT.datePublished,
    keywords: [
      "kvíz s doporučením produktů",
      "conversion rate",
      "average order value",
      "ecommerce",
      "Shopify",
    ],
    distribution: {
      "@type": "DataDownload",
      encodingFormat: "application/pdf",
      contentUrl: new URL(REPORT.pdfPath, SITE.site_url).href,
    },
  },
  faqPage(FAQ),
];

const publishedLabel = new Date(REPORT.datePublished).toLocaleDateString("cs-CZ", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

// Popisky kategorií a dvě dlouhé poznámky pod tabulkou, přeloženo. Čísla zůstávají
// ze sdíleného datového modulu; lokalizují se jen čitelné popisky/poznámky.
const VERT_LABEL: Record<string, string> = {
  "Fragrance": "Parfémy",
  "Haircare": "Péče o vlasy",
  "Supplements & health": "Doplňky a zdraví",
  "Beauty & skincare": "Krása a péče o pleť",
  "Coffee & tea": "Káva a čaj",
  "CBD": "CBD",
  "Other sectors": "Ostatní obory",
  "All quiz categories (pooled)": "Všechny kategorie kvízů (sdruženo)",
};
const GROUPED_NOTE =
  "Vše mimo pojmenované kategorie, včetně generických kvízů a kvízů s vyšší mírou zvažování. Naměřeno zhruba 3,6 %, asi 180 % typického obchodu.";
const POOLED_NOTE =
  "Titulní číslo platformy: 5,5 % (1 z 18), asi 275 % typického obchodu se 2 %. Generické, nepojmenované kvízy (~78 % odpovědí) jsou vyloučeny z řádků podle kategorií a stahují celkové číslo dolů na ~4 %.";
const SCOPE: Record<string, string> = {
  "Statista": "Globálně, 2025",
  "IRP Commerce": "Živá data obchodníků UK/IE, 2025",
  "Dynamic Yield": "400+ středně velkých až velkých značek, 2025",
  "Shopify": "Vlastní zveřejněné doporučení Shopify",
};
const tr = <T extends { vertical: string }>(r: T) => ({ ...r, vertical: VERT_LABEL[r.vertical] ?? r.vertical });
const consumable = VERTICAL_CONVERSION.filter((r) => r.kind === "consumable").map(tr);
const considered = VERTICAL_CONVERSION.filter((r) => r.kind === "considered").map(tr);
const grouped = { ...tr(VERTICAL_CONVERSION.find((r) => r.kind === "grouped")!), note: GROUPED_NOTE };
const pooled = { ...tr(VERTICAL_CONVERSION.find((r) => r.kind === "total")!), note: POOLED_NOTE };
const aovRows = AOV_UPLIFT.perVertical.map(tr);
const baselines = BASELINES.map((b) => ({ ...b, scope: SCOPE[b.source] ?? b.scope }));
---

<Base
  title={pageTitle}
  description={pageDescription}
  ogImage={ogImage}
  jsonLd={jsonLd}
  lang="cs"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <Breadcrumb items={[{ label: "Domů", href: localizedHref("/", "cs") }, { label: "Stav kvízů s doporučením produktů" }]} />
      <div class="text-center">
        <Eyebrow>Benchmarková zpráva · {publishedLabel}</Eyebrow>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          Stav kvízů s doporučením produktů
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          1 z 18 kupujících, kteří dokončí kvíz s doporučením produktů, provede objednávku, <strong>2,75krát víc než typický online obchod</strong>. Tato zpráva rozebírá, které kategorie konvertují nejvíc, o kolik víc utrácejí kupující z kvízu a jak dlouho jediný kvíz dál přináší výsledky. Založeno na skutečných datech z <strong>{DATASET.responses} odpovědí v kvízu</strong> v {DATASET.brands} obchodech.
        </p>
        {/* TODO: restore hero CTAs ("Download the PDF" + "Read the findings")
            once a peer reviews the PDF design. Removed 2026-06-08 to hold the
            PDF download until that review. The PDF is still generated and the
            "Cite this report" section's download link is also held (see below). */}
      </div>
    </div>
  </section>

  <!-- Dataset band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-2xl bg-[#16161D] px-6 py-10 sm:px-10">
        <p class="text-center text-sm font-semibold uppercase tracking-wider text-white/50">
          Datový soubor
        </p>
        <dl class="mt-6 grid grid-cols-1 gap-8 text-center sm:grid-cols-3">
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.responses}</dt>
            <dd class="mt-1 text-sm text-white/70">analyzovaných odpovědí v kvízu</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.revenue}</dt>
            <dd class="mt-1 text-sm text-white/70">tržeb vygenerovaných obchodníkům</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.brands}</dt>
            <dd class="mt-1 text-sm text-white/70">ecommerce obchodů</dd>
          </div>
        </dl>
        <p class="mx-auto mt-6 max-w-3xl text-center text-sm text-white/60">
          Agregováno a anonymizováno, napříč platformami Shopify, WooCommerce, BigCommerce, Magento a samostatnými řešeními. Žádný jednotlivý obchod není identifikovatelný. Každé číslo níže je minimum: atribuce se stále hromadí, takže skutečná čísla jsou vyšší.
        </p>
      </div>
    </div>
  </section>

  <!-- Key findings (stat cards) -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Klíčová čísla</h2>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">{HEADLINE.completedConv}%</p>
          <p class="mt-2 font-medium text-slate-900">kupujících, kteří dokončí kvíz, provede objednávku</p>
          <p class="mt-2 text-sm text-slate-600">Zhruba 1 z {HEADLINE.completedOneIn}, přibližně {HEADLINE.multiple}krát víc než typický obchod s {HEADLINE.baselinePct} %.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">+{AOV_UPLIFT.headlineLow}-{AOV_UPLIFT.headlineHigh}%</p>
          <p class="mt-2 font-medium text-slate-900">vyšší average order value, v rámci jednoho obchodu</p>
          <p class="mt-2 text-sm text-slate-600">Měřeno srovnatelně, přítomné zhruba v 7 z 10 obchodů.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">{HEADLINE.completionRate}%</p>
          <p class="mt-2 font-medium text-slate-900">kupujících, kteří kvíz začnou, ho dokončí</p>
          <p class="mt-2 text-sm text-slate-600">Zhruba 7 z 10 se dostane na stránku s výsledky. {HEADLINE.abandonRate} % odejde dříve.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">1 z 5</p>
          <p class="mt-2 font-medium text-slate-900">objednávek přiřazených kvízu přichází více než 30 dní poté</p>
          <p class="mt-2 text-sm text-slate-600">Kvíz dál generuje tržby měsíce po jeho vyplnění.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Conversion by category -->
  <section id="conversion" class="scroll-mt-20 bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Konverze podle kategorie</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        Průměr platformy skrývá velký rozptyl. <strong>Spotřební a doplňovatelné kategorie konvertují dvakrát až třikrát víc</strong> než průměrný online obchod. Nákupy s vysokou cenou a vysokou mírou zvažování konvertují o řád níže: tam kvíz pohání objevování, ale prodej přichází později, mimo relaci.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">Kategorie</th>
              <th class="py-3 pr-4 text-right font-semibold">Konverze</th>
              <th class="py-3 pr-4 text-right font-semibold">Nárůst konverze kvízu</th>
              <th class="py-3 text-right font-semibold">Odpovědi</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {consumable.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{r.rate}%</td>
                <td class="py-3 pr-4 text-right tabular-nums text-slate-600">{boost(r.rate)}%</td>
                <td class="py-3 text-right tabular-nums text-slate-500">{formatN(r.n)}</td>
              </tr>
            ))}
            {considered.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{r.rate}%</td>
                <td class="py-3 pr-4 text-right tabular-nums text-slate-600">{boost(r.rate)}%</td>
                <td class="py-3 text-right tabular-nums text-slate-500">{formatN(r.n)}</td>
              </tr>
            ))}
            <tr class="border-b border-slate-200">
              <td class="py-3 pr-4 font-medium">{grouped.vertical}</td>
              <td class="py-3 pr-4 text-right font-semibold tabular-nums">~{grouped.rate}%</td>
              <td class="py-3 pr-4 text-right tabular-nums text-slate-600">~{boost(grouped.rate)}%</td>
              <td class="py-3 text-right tabular-nums text-slate-500">{formatN(grouped.n)}</td>
            </tr>
            <tr class="border-t-2 border-slate-300">
              <td class="py-3 pr-4 font-semibold">{pooled.vertical}</td>
              <td class="py-3 pr-4 text-right font-bold tabular-nums">{pooled.rate}%</td>
              <td class="py-3 pr-4 text-right font-bold tabular-nums text-slate-600">{boost(pooled.rate)}%</td>
              <td class="py-3 text-right tabular-nums text-slate-500">všechny</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        {grouped.note}
      </p>
      <p class="mx-auto mt-2 max-w-3xl text-sm text-slate-500 text-center">
        {pooled.note}
      </p>
    </div>
  </section>

  <!-- AOV uplift -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Utrácejí kupující z kvízu víc?</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        <strong>Měřeno v rámci jednoho obchodu</strong> jsou objednávky z kvízu <strong>o {AOV_UPLIFT.headlineLow} % až {AOV_UPLIFT.headlineHigh} % větší</strong> než objednávky bez kvízu, a to platí v {AOV_UPLIFT.storesUpLow} % až {AOV_UPLIFT.storesUpHigh} % obchodů. Není to univerzální: silnější tam, kde kvíz dokáže sestavit set nebo rutinu, téměř ploché tam, kde je nákup jediná položka.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">Kategorie</th>
              <th class="py-3 pr-4 text-right font-semibold">Nárůst AOV v rámci obchodu</th>
              <th class="py-3 text-right font-semibold">Obchody s nárůstem</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {aovRows.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">
                  {r.uplift === null ? "Ploché" : `+${r.uplift}%`}
                </td>
                <td class="py-3 text-right tabular-nums text-slate-500">
                  {r.storesUp === null ? "n/d" : `${r.storesUp}%`}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        Měřeno v rámci obchodu (stejný obchod, objednávky z kvízu oproti objednávkám bez kvízu), takže je to robustní vůči měně a kontroluje mix obchodu. Triangulováno mezi třemi nezávislými vzorky s mediánem +11 %, +15 % a +14 %. Kategorie s malými vzorky se vynechávají, místo aby se přeháněly.
      </p>
    </div>
  </section>

  <!-- Attribution / LTV -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Kvíz přináší výsledky i po skončení relace</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        Většina atribučních dashboardů posuzuje kvíz podle objednávek ve stejný den a tím to končí. To přehlíží většinu hodnoty. <strong>{ATTRIBUTION.sameDay} % prvních objednávek přiřazených kvízu nastane ve stejný den</strong>, ale ocas je dlouhý.
      </p>
      <div class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-4">
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.sameDay}%</p>
          <p class="mt-1 text-sm text-slate-600">ve stejný den</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.within7}%</p>
          <p class="mt-1 text-sm text-slate-600">do 7 dní</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.within30}%</p>
          <p class="mt-1 text-sm text-slate-600">do 30 dní</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">1 z 5</p>
          <p class="mt-1 text-sm text-slate-600">přichází více než 30 dní poté</p>
        </div>
      </div>
      <p class="mx-auto mt-6 max-w-3xl text-slate-700 text-center">
        Zhruba <strong>1 z 5 všech objednávek přiřazených kvízu přichází více než 30 dní po vyplnění kvízu</strong>. Kvíz není jen popostrčení k checkoutu: každá odpověď je zero-party data, která označí kupujícího a živí segmentované follow-up toky a retargeting. <a href="https://www.klaviyo.com/marketing-resources/segmentation-benchmark-report" target="_blank" rel="external noopener nofollow" class="font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]">Segmentované kampaně generují více než 3krát vyšší tržby na příjemce</a> než plošná rozesílání, takže jediný kvíz dál konvertuje prostřednictvím e-mailu a personalizovaných reklam celé měsíce.
      </p>
    </div>
  </section>

  <!-- Baseline context -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Co se počítá jako "průměrný obchod"</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        Pro konverzi v ecommerce neexistuje jediné pravdivé číslo: kolísá podle metodiky a vzorku. Poctivý rozsah je zhruba 1,6 % až 2,9 %. Benchmarkujeme oproti zaokrouhleným <strong>{HEADLINE.baselinePct} %</strong>, konzervativnímu spodnímu okraji, což staví ty, kdo vyplní kvíz, na zhruba <strong>{HEADLINE.multiple}krát</strong> víc než průměrný obchod.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">Zdroj</th>
              <th class="py-3 pr-4 text-right font-semibold">Průměrná konverze</th>
              <th class="py-3 font-semibold">Rozsah</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {baselines.map((b) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">
                  <a href={b.href} target="_blank" rel="external noopener nofollow" class="text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-slate-500">{b.source}</a>
                </td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{b.rate}</td>
                <td class="py-3 text-sm text-slate-600">{b.scope}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        Důležité: naše 5,5 % je míra na osobu, která vyplní kvíz (objednávky na dokončený kvíz), zatímco každé číslo výše je míra za celý web (objednávky na návštěvníka). Ti, kdo vyplní kvíz, se sami vybírají, takže část rozdílu tvoří trychtýř, ne jen kvíz. Srovnání prezentujeme přímočaře, místo abychom ho přikrášlovali.
      </p>
    </div>
  </section>

  <!-- Methodology -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Metodika</h2>
      <ul class="mt-8 space-y-5" role="list">
        {METHODOLOGY.map((m) => (
          <li class="flex gap-3">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400" aria-hidden="true"></span>
            <p class="text-slate-700">{m}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Časté dotazy</h2>
      <div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
        {FAQ.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-lg font-semibold text-slate-900 [&::-webkit-details-marker]:hidden">
              <span>{f.question}</span>
              <svg
                class="h-5 w-5 flex-shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <p class="pb-5 text-slate-700" set:html={f.answerHtml ?? f.answer} />
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* TODO: restore the entire "Cite this report" section (PDF download +
      shareable stat-card links) once a designer reviews the report + PDF + card
      designs. Removed 2026-06-08 to hold the downloadable assets until review.
      The PDF and card PNGs are still generated by `bun run report`. */}

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Změř ten nárůst ve svém vlastním obchodě.
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-white/70">
        RevenueHunt je zdarma na začátek, se 100 odpověďmi v kvízu měsíčně. Vytvoř kvíz, pošli skrz něj návštěvnost a přečti si svá vlastní čísla.
      </p>
      <p class="mx-auto mt-4 max-w-2xl text-white/60">
        Podívej se, co by tyto benchmarky mohly tvému obchodu přidat, pomocí naší <a href={localizedHref("/quiz-roi-calculator/", "cs")} class="font-medium text-white underline decoration-white/40 underline-offset-2 hover:decoration-white">kalkulačky ROI kvízu</a>.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SHOPIFY_INSTALL}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          začni zdarma na Shopify
        </a>
        <a
          href={WOO_PLUGIN}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          začni zdarma na WooCommerce
        </a>
      </div>
    </div>
  </section>
</Base>
