---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb, article, faqPage } from "../../../lib/schema";
import { SITE } from "../../../lib/site";
import { localizedHref } from "../../../lib/i18n";
import {
  REPORT,
  SOURCE,
  HEADLINE,
  GROWTH,
  REVIEWS,
  REVENUE,
  PRICING,
  GEOGRAPHY,
  NICHES,
  QUIZ_LANE,
} from "../../../lib/app-economy";

const pageUrl = new URL(`/cs/${REPORT.slug}/`, SITE.site_url).href;
const ogImage = `/og/${REPORT.slug}.png`;

const publishedLabel = new Date(REPORT.datePublished).toLocaleDateString("cs-CZ", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const title = "Stav ekonomiky aplikací Shopify";
const description =
  "Na Shopify App Store je 22 546 aktivních aplikací a téměř žádná se nikam nedostane. Datový report o růstu, recenzích, koncentraci příjmů, cenách a o tom, kdo je tvoří, na základě snímku každé aktivní aplikace.";

// Metodika + FAQ, přeloženo. Úvodní věta každé poznámky metodiky je
// zvýrazněna inline (anglický zdroj ji zvýrazňoval přes string replace, který
// neumí zachytit přeložený text). Definováno před jsonLd, aby faqPage(FAQ) mohlo použít.
const METHODOLOGY = [
  "<strong>Zdroj:</strong> snímek veřejného Shopify App Store, 22 546 aktivních karet aplikací, pořízený v červnu 2026. Každá hodnota pochází z veřejné karty, ne z interních dat Shopify ani z účtu některého obchodníka.",
  "<strong>Příjmy jsou odhadované, ne změřené.</strong> Jsou modelované ze zveřejněných cenových úrovní každé aplikace spolu se signály z recenzí a instalací. Ber čísla příjmů jako směrový model toho, jak koncentrované výdělky jsou, ne jako fakturační data. Všude, kde se objevují, jsou označeny jako „odhadované“.",
  "<strong>Růst vychází ze zveřejněného data spuštění každé karty.</strong> Zdroj nakupil zhruba 2 800 dat spuštění do května 2026, takže se křivka čte jako kumulativní počet aktivních aplikací podle roku (koncový bod je skutečný aktuální součet) a údaj „6 000+ za posledních 12 měsíců“ tento artefakt jediného měsíce odstraňuje.",
  "<strong>Recenze jsou ukazatel trakce</strong>, ne dokonalý: skvělá aplikace může být nová a počty recenzí zaostávají za skutečným používáním. Používáme je, protože jsou nejjasnějším veřejným a srovnatelným signálem skutečné základny obchodníků napříč 22 546 aplikacemi.",
  "Kategorie na App Store jsou štítky funkcí, které si aplikace může sama přidělit, a mnoho aplikací jich nese několik nebo žádný. Pro pohled po sektorech seskupujeme příbuzné štítky do širokých pruhů a deduplikujeme aplikace v každém z nich; aplikace může patřit do více než jednoho, takže se sektory překrývají a nevylučují, a čteme je jako orientační. Všude jinde se opíráme o jednoznačné řezy (recenze, ceny, datum spuštění, země vývojáře).",
];

const FAQ = [
  {
    question: "Kolik aplikací je na Shopify App Store?",
    answer:
      "22 546 aktivních aplikací v tomto snímku z června 2026. Store od roku 2020 zhruba zdesetinásobil svou velikost a jen za posledních 12 měsíců přibylo přes 6 000 aplikací, tedy zhruba 1 ze 4 ze všeho, co je dnes aktivní. Vývoj s pomocí AI proměnil to, co dřív byla půlroční práce, ve víkend.",
  },
  {
    question: "Proč většina aplikací Shopify selže?",
    answer:
      "Vytvořit aplikaci už není to omezení, takže se store zaplavuje aplikacemi, které nikdy nenajdou základnu obchodníků. 51 % nemá jedinou recenzi a 81 % jich má méně než 10. Vzácnost je distribuce a důvěra: odpovídat na podporu, získávat recenze obchod po obchodu, být tu roky. To je ta část, kterou za tebe AI neudělá.",
  },
  {
    question: "Kolik aplikace Shopify vydělávají?",
    answer:
      "Výdělky jsou extrémně koncentrované. Podle našeho odhadu si horní 1 % aplikací (225 z nich) bere zhruba 72 % všech příjmů z aplikací a jen prvních 10 si bere téměř 30 %. Zdá se, že vůbec něco vydělává jen kolem 36 % aplikací. Příjmy tady jsou odhadnuté z veřejných cen a signálů o používání, ne z fakturačních dat.",
  },
  {
    question: "Je většina aplikací Shopify zdarma?",
    answer:
      "Fakticky ano. 46,9 % je zdarma a dalších 48,6 % začíná zkušební verzí zdarma; jen 4,5 % si účtuje peníze předem. Téměř 45 % nabízí trvale bezplatný plán. Na Shopify App Store není bezplatný vstupní bod růstová taktika, je to základní očekávání.",
  },
  {
    question: "Kde si můžu prohlédnout zdrojová data?",
    answer:
      "Čísla pocházejí ze snímku, který udržujeme, každé aktivní aplikace Shopify: data spuštění, recenze, ceny, odznak Built for Shopify a země vývojáře. Pokud stavíš na Shopify a chceš konkrétní řez, ozvi se nám.",
    answerHtml:
      "Čísla pocházejí ze snímku, který udržujeme, každé aktivní aplikace Shopify: data spuštění, recenze, ceny, odznak Built for Shopify a země vývojáře. Pokud stavíš na Shopify a chceš konkrétní řez, <a href=\"/cs/contact/\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">ozvi se nám</a>.",
  },
];

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Domů", url: localizedHref("/", "cs") },
    { name: title, url: localizedHref(`/${REPORT.slug}/`, "cs") },
  ]),
  article({
    title,
    description,
    url: pageUrl,
    image: ogImage,
    datePublished: REPORT.datePublished,
    dateModified: REPORT.dateModified,
    author: "RevenueHunt",
    tags: [
      "Shopify app store",
      "vývojáři aplikací pro Shopify",
      "statistiky app store",
      "ekonomika aplikací",
    ],
  }),
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "Stav ekonomiky aplikací Shopify 2026",
    description,
    url: pageUrl,
    creator: organization(),
    license: "https://creativecommons.org/licenses/by/4.0/",
    isAccessibleForFree: true,
    datePublished: REPORT.datePublished,
    keywords: [
      "Shopify app store",
      "vývojáři aplikací",
      "příjmy aplikací",
      "recenze aplikací",
      "ecommerce",
    ],
  },
  faqPage(FAQ),
];

// Section eyebrows for the editorial "field notes" feel.
const E = (n: string, label: string) => `${n} · ${label}`;

// Translated headline cards. Stats stay from the shared data module (HEADLINE[i].stat).
const headlineT = [
  { label: "aktivních aplikací ve storu", note: "Zhruba 10× více než v roce 2020." },
  { label: "nemá jedinou recenzi", note: "Čtyři z pěti mají méně než 10." },
  { label: "příjmů si bere horní 1 %", note: "225 aplikací. Odhad." },
  { label: "si účtuje předem", note: "Jen 1 z 20. Téměř polovina je zdarma." },
];

// Growth caption with the lead phrase bolded.
const growthCaptionHtml =
  "Kumulativní počet aktivních aplikací podle roku spuštění. <strong>Shopify App Store od roku 2020 zhruba zdesetinásobil svou velikost</strong> a jen za posledních 12 měsíců přibylo přes 6 000 aplikací, tedy zhruba 1 ze 4 ze všeho, co je dnes aktivní.";

// Quiz-lane paragraphs (translated), with the live search link and the load-bearing
// lines bolded inline. Caption text mirrors the English source's meaning.
const quizParas = [
  `Naše vlastní kategorie dokazuje to samé. <a href="${QUIZ_LANE.searchUrl}" target="_blank" rel="external noopener nofollow" class="font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]">vyhledávání „quiz“ na Shopify</a> vrátí 149 aplikací, ale i tady se důvěra hromadí na špici úplně stejně jako v celém storu. Tři aplikace, které dorazily jako první a nikdy neodešly, RevenueHunt, Octane AI a Quiz Kit, drží 45 % všech recenzí v kategorii; <strong>samotný RevenueHunt jich má zhruba čtvrtinu</strong> a spodní polovina nemá ani jednu.`,
  `Na špici jsme se nedostali díky kódu. <strong>Recenze jsou pozůstatkem provozní jizevnaté tkáně</strong>, která za nimi stojí: šest let odpovídání na podporu, telefonování s obchody, které by nikdy nezaplatily, a budování důvěry obchod po obchodu. Octane AI a Quiz Kit dělaly tu samou dřinu po léta <strong>a my je za to respektujeme</strong>. Čestná zmínka patří Lantern a Quizell, obě mají něco přes 120 recenzí.`,
];

// Methodology bullets carry their own inline <strong>; render as-is.
const methodologyHtml = METHODOLOGY;
---

<Base
  title={`${title} - datový report 2026`}
  description={description}
  ogImage={ogImage}
  jsonLd={jsonLd}
  lang="cs"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={localizedHref("/", "cs")} class="hover:text-slate-700">Domů</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Stav ekonomiky aplikací Shopify</span>
      </nav>
      <div class="text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">
          Poznámky z terénu · {publishedLabel}
        </p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          Stav ekonomiky aplikací Shopify
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          <strong>Na Shopify App Store je 22 546 aktivních aplikací a téměř žádná se nikam nedostane.</strong> Pořídili jsme snímek každé aktivní aplikace a pak jsme si přečetli data o růstu, recenzích, příjmech, cenách a o tom, kdo je tvoří. Vyprávějí jediný příběh: vytvořit aplikaci nikdy nebyla ta těžká část.
        </p>
      </div>
    </div>
  </section>

  <!-- Source band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-2xl bg-[#16161D] px-6 py-10 sm:px-10">
        <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#4dcaff]">
          Snímek
        </p>
        <dl class="mt-6 grid grid-cols-2 gap-8 text-center sm:grid-cols-4">
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.apps}</dt>
            <dd class="mt-1 text-sm text-white/70">aktivních aplikací ve snímku</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.countries}</dt>
            <dd class="mt-1 text-sm text-white/70">zemí, které je tvoří</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.reviewless}</dt>
            <dd class="mt-1 text-sm text-white/70">bez jediné recenze</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.free}</dt>
            <dd class="mt-1 text-sm text-white/70">zcela zdarma, bez placeného plánu</dd>
          </div>
        </dl>
        <p class="mx-auto mt-6 max-w-3xl text-center text-sm text-white/60">
          Každé číslo níže pochází z veřejné karty na App Store u všech 22 546 aktivních aplikací, červen 2026. Příjmy jsou odhadnuté ze zveřejněných cen a signálů o používání, ne z fakturačních dat, a v celém reportu jsou takto označeny.
        </p>
      </div>
    </div>
  </section>

  <!-- Headline cards -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Klíčová čísla</h2>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        {HEADLINE.map((c, i) => (
          <div class="rounded-xl border border-slate-200 p-7">
            <p class="text-4xl font-bold tracking-tight text-[#16161D]">{c.stat}</p>
            <p class="mt-2 font-medium text-slate-900">{headlineT[i].label}</p>
            <p class="mt-2 text-sm text-slate-600">{headlineT[i].note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 01 Growth -->
  <section class="scroll-mt-20 bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("01", "Růst")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">10× více od roku 2020</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center" set:html={growthCaptionHtml} />
      <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
        <div class="h-72 sm:h-80"><canvas id="c-growth" aria-label="Kumulativní počet aktivních aplikací Shopify podle roku" role="img"></canvas></div>
      </div>
    </div>
  </section>

  <!-- 02 Traction -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("02", "Trakce")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Většina aplikací nikdy nezíská recenzi</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">Polovina Shopify App Store nikdy nezískala jedinou recenzi. Čtyři z pěti aplikací mají méně než 10. Recenze je nejjasnější veřejný ukazatel skutečného a udrženého obchodu a většina aplikací nikdy žádnou nezíská.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-center text-sm font-semibold text-slate-700">Aplikace podle počtu recenzí</p>
          <div class="h-72 sm:h-80"><canvas id="c-reviews" aria-label="Rozložení recenzí napříč všemi aktivními aplikacemi" role="img"></canvas></div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">81%</p>
            <p class="mt-1 text-slate-700">má méně než 10 recenzí</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="font-bold text-[#16161D]"><span class="text-3xl">{REVIEWS.medianReviews}</span> <span class="text-sm font-medium text-slate-500">recenzí</span></p>
            <p class="mt-1 text-slate-700">medián mezi aplikacemi, které mají alespoň jednu</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="font-bold text-[#16161D]"><span class="text-amber-400">★</span> <span class="text-3xl">{REVIEWS.avgRating}</span> <span class="text-sm font-medium text-slate-500">hvězdy</span></p>
            <p class="mt-1 text-slate-700">průměrné hodnocení mezi {REVIEWS.ratedCount} aplikacemi, které nějaké mají</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 Revenue -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("03", "Příjmy · odhad")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Peníze se hromadí úplně na špici</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">Odhadované měsíční příjmy jsou brutálně koncentrované na špici. Horní 1 % aplikací (225 z nich) si bere odhadem 72 %, a jen 10 z těchto aplikací si samo bere téměř 30 % všech příjmů aplikací. Zdá se, že vůbec něco vydělává sotva 36 % aplikací. Soustředí se i geograficky: <strong>samotné USA a Kanada si berou odhadem 57 %</strong> příjmů ze Shopify App Store.</p>
      <p class="mx-auto mt-3 max-w-3xl text-sm italic text-slate-500 text-center">Jedno jméno se tyčí nad celým ekosystémem: aplikace, která získává odhadem 78 % svého ročního obratu kolem 1 miliardy dolarů od obchodníků na Shopify. Ano, díváme se na tebe, <a href='https://www.sec.gov/Archives/edgar/data/1835830/000162828023030618/klaviyoincs-1.htm' target='_blank' rel='external noopener nofollow' class='font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]'>Klaviyo</a>.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-sm font-medium text-slate-500">Rozložení příjmů</p>
          <div class="h-64 sm:h-72"><canvas id="c-revenue-donut" aria-label="Rozdělení odhadovaných příjmů: prvních 10 aplikací, zbytek z 1% nejlepších a zbylých 99%" role="img"></canvas></div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-sm font-medium text-slate-500">Odhadovaný příjem podle země</p>
          <div class="h-64 sm:h-72"><canvas id="c-revenue-countries" aria-label="Odhadovaný příjem podle země" role="img"></canvas></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 Pricing -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("04", "Ceny")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Téměř nikdo si neúčtuje předem</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">Téměř polovina storu si neúčtuje nic předem a méně než 1 z 20 aplikací chce peníze před první instalací. Téměř 45 % nabízí trvale bezplatný plán. Freemium tady není strategie, je to minimum pro vstup.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="text-sm font-semibold text-slate-900">Vstupní ceny napříč všemi 22 546 aktivními aplikacemi</p>
          <p class="mt-0.5 text-xs text-slate-500">Čtyři vzájemně se vylučující úrovně podle toho, co aplikace chce předem.</p>
          <div class="mt-4 h-72 sm:h-80"><canvas id="c-pricing" aria-label="Rozdělení cenového modelu napříč všemi aktivními aplikacemi" role="img"></canvas></div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">{PRICING.permanentFree}</p>
            <p class="mt-1 text-slate-700">nabízí trvale bezplatný plán, ne jen zkušební verzi</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">{PRICING.completelyFree}</p>
            <p class="mt-1 text-slate-700">je zcela zdarma, bez jakéhokoli placeného plánu</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">1 z 20</p>
            <p class="mt-1 text-slate-700">aplikací si účtuje peníze při instalaci</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 Who builds them -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("05", "Kdo je tvoří")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Signál versus šum</h2>
