---
import Base from "../../../layouts/Base.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import { organization, breadcrumb, softwareApplication } from "../../../lib/schema";
import { SITE } from "../../../lib/site";
import { SOLUTIONS, FEATURED_SOLUTIONS } from "../../../lib/solutions";
import { localizedHref } from "../../../lib/i18n";

const lang = "cs";
const lp = (path: string) => localizedHref(path, lang);

const featuredSolutions = FEATURED_SOLUTIONS.map((slug) => SOLUTIONS[slug]!);

interface Template {
  title: string;
  description: string;
  image: string;
  demo: string;
}

interface TemplateGroup {
  id: string;
  label: string;
  items: Template[];
}

const groups: TemplateGroup[] = [
  {
    id: "skincare",
    label: "Péče o pleť, vlasy a kosmetika",
    items: [
      { title: "Kvíz typu pleti + rutina", description: "Identifikuje typ pleti a doporučí kompletní rutinu.", image: "/img/pages/templates/skinquiz1.webp", demo: "https://productrecommendationquiz.com/pages/skin-analysis" },
      { title: "Najdi svůj make-up", description: "Výběr správného make-upu by neměl být otázkou hádání.", image: "/img/pages/templates/foundation5.webp", demo: "https://productrecommendationquiz.com/pages/foundation-match" },
      { title: "Vyhledávač odstínů rtěnky", description: "Najde každému zákazníkovi dokonalý odstín rtěnky podle jeho tónu pleti a stylu.", image: "/img/pages/templates/lips1-e1768405685573.webp", demo: "https://productrecommendationquiz.com/pages/lipstick-shade-finder" },
      { title: "Kvíz péče o vlasy", description: "Doporučí šampony, kondicionéry a péči podle vlasových cílů každého člověka.", image: "/img/pages/templates/hairquiz4.webp", demo: "https://productrecommendationquiz.com/pages/haircare-quiz" },
    ],
  },
  {
    id: "food",
    label: "Výživa a zdraví",
    items: [
      { title: "Kvíz kávy", description: "Provede tvé zákazníky až k ideální kávové směsi podle jejich chuti a životního stylu.", image: "/img/pages/templates/coffee2.webp", demo: "https://productrecommendationquiz.com/pages/coffee-quiz" },
      { title: "Kvíz doplňků stravy", description: "Doporučí vitaminy a doplňky stravy v souladu s jejich zdravotními cíli.", image: "/img/pages/templates/supplements3.webp", demo: "https://productrecommendationquiz.com/pages/supplements-quiz" },
      { title: "Vyhledávač CBD produktů", description: "Navrhne správné CBD produkty pro relaxaci, spánek nebo soustředění.", image: "/img/pages/templates/cbd1.webp", demo: "https://productrecommendationquiz.com/pages/cbd-product-finder" },
      { title: "Kvíz krmiva pro psy", description: "Najde dokonalé krmivo pro tvého psa podle jeho specifických potřeb a preferencí.", image: "/img/pages/templates/dogquiz3.webp", demo: "https://productrecommendationquiz.com/pages/dog-food" },
    ],
  },
  {
    id: "clothes",
    label: "Sport, oblečení a móda",
    items: [
      { title: "Kvíz šperků", description: "Pomůže tvým kupujícím najít dokonalý šperk pro jejich styl.", image: "/img/pages/templates/jewellery1-e1768405517428.webp", demo: "https://productrecommendationquiz.com/pages/jewellery-quiz" },
      { title: "Kvíz oděvního stylu", description: "Objev svou módní osobnost a získej personalizovaná doporučení.", image: "/img/pages/templates/style1.webp", demo: "https://productrecommendationquiz.com/pages/clothing-style-quiz" },
      { title: "Kvíz jízdních kol", description: "Najde každému zákazníkovi to správné kolo podle jeho stylu jízdy a potřeb.", image: "/img/pages/templates/bike2.webp", demo: "https://productrecommendationquiz.com/pages/bicycle-quiz" },
    ],
  },
];

const gallery = [
  "Screenshot-2020-09-29-at-20.20.43.webp",
  "Screenshot-2020-09-29-at-20.33.39.webp",
  "Screenshot-2020-09-29-at-20.34.03.webp",
  "Screenshot-2020-09-29-at-20.34.16.webp",
  "Screenshot-2020-10-20-at-11.31.49.webp",
  "Screenshot-2020-10-20-at-11.32.06.webp",
  "Screenshot-2020-10-20-at-11.33.20.webp",
  "Screenshot-2020-10-20-at-11.33.57.webp",
  "Screenshot-2020-10-20-at-11.39.39.webp",
  "Screenshot-2020-10-20-at-11.41.15.webp",
  "Screenshot-2020-10-20-at-11.41.36.webp",
  "Screenshot-2020-10-20-at-11.41.51.webp",
  "Screenshot-2020-10-20-at-11.44.30.webp",
  "Screenshot-2020-10-20-at-11.45.11.webp",
  "Screenshot-2020-10-20-at-11.45.42.webp",
  "Screenshot-2020-11-16-at-14.34.09.webp",
  "Screenshot-2020-11-16-at-14.34.22.webp",
  "Screenshot-2020-11-16-at-14.34.34.webp",
  "Screenshot-2020-11-16-at-14.36.54.webp",
  "Screenshot-2020-12-04-at-08.38.54.webp",
  "Screenshot-2020-12-04-at-08.39.14.webp",
  "Screenshot-2020-12-04-at-08.39.25.webp",
  "Screenshot-2020-12-04-at-08.39.35.webp",
  "Screenshot-2021-04-14-at-04.13.10.webp",
  "Screenshot-2021-04-14-at-04.13.50.webp",
  "Screenshot-2021-04-14-at-04.14.16.webp",
  "Screenshot-2021-05-13-at-22.49.10.webp",
];

const reasons = [
  { emoji: "🚀", title: "Rychlé nastavení pro Shopify a WooCommerce", body: "Šablony se bezproblémově integrují s Shopify, WooCommerce, BigCommerce i samostatnými weby. Bez programování: nainstaluj aplikaci, vyber šablonu a přizpůsob ji své značce." },
  { emoji: "💡", title: "Předpřipravená logika a otázky kvízu", body: "Každá šablona obsahuje otázky vytvořené experty, podmíněnou logiku a algoritmy doporučení produktů. Postavené na ověřených rámcích, které zvyšují konverze v oblasti krásy, wellness, péče o mazlíčky i lifestylu." },
  { emoji: "📊", title: "Zvyš konverze a AOV", body: "Personalizovaná doporučení proměňují ty, kdo jen prohlížejí, v kupující. Šablony jsou optimalizované pro vyšší míry konverze, větší košíky a kvalifikovanější leady." },
  { emoji: "🎨", title: "Plně přizpůsobitelné HTML", body: "Uprav texty, design, branding i logiku bez zásahu do kódu. Pro pokročilý vývoj je každá šablona také plně přístupná pomocí vlastního HTML, CSS a JS." },
  { emoji: "📧", title: "Sbírej zero-party data", body: "Zachyť preference, záměr i segmentační data přímo od kupujícího a poté je synchronizuj s Klaviyo, Omnisend, Meta nebo GA4, abys posílil svůj následný marketing." },
  { emoji: "⚡", title: "Responzivní a optimalizované pro mobil", body: "Každá šablona je dodávána s mobile-first přístupem. Rychlé, přístupné a navržené tak, aby působily nativně na mobilech, tabletech i počítačích." },
];

const jsonLd = [
  organization(),
  softwareApplication(),
  breadcrumb([
    { name: "Domů", url: "/" },
    { name: "Šablony kvízů", url: "/templates/" },
  ]),
];
---

<Base
  title="Šablony kvízů - RevenueHunt"
  description="Šablony produktových kvízů pro Shopify, WooCommerce, BigCommerce a samostatné obchody. Péče o pleť, krása, doplňky stravy, krmivo pro mazlíčky, oblečení, sport a další: předpřipravené otázky, podmíněná logika a algoritmy doporučení produktů."
  jsonLd={jsonLd}
  lang="cs"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20 text-center">
      <Breadcrumb items={[{ label: "Domů", href: lp("/") }, { label: "Šablony kvízů" }]} />
      <Eyebrow>Šablony kvízů</Eyebrow>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Šablony produktových kvízů pro Shopify a WooCommerce
      </h1>
      <p class="mt-4 text-xl font-semibold text-slate-700">
        Interaktivní šablony kvízu s doporučením produktů: připravené k použití
      </p>
      <p class="mx-auto mt-6 max-w-3xl text-slate-600">
        Objev naši kolekci <strong class="font-semibold text-slate-900">bezplatných šablon kvízů</strong> navržených pro ecommerce obchody.
        Od kvízů péče o pleť a krásy až po doplňky stravy, krmivo pro mazlíčky a lifestyle produkty - každá šablona je vytvořena tak, aby ti pomohla nabídnout
        personalizovaný nákupní zážitek, který konvertuje. Ideální pro <strong class="font-semibold text-slate-900">Shopify</strong>,
        <strong class="font-semibold text-slate-900">WooCommerce</strong>, <strong class="font-semibold text-slate-900">BigCommerce</strong>,
        a <strong class="font-semibold text-slate-900">samostatné</strong> obchody.
      </p>
      <p class="mx-auto mt-4 max-w-3xl text-slate-600">
        Tyto šablony kvízů v přizpůsobitelném HTML obsahují již připravené otázky, podmíněnou logiku a algoritmy doporučení produktů.
        Vyber šablonu, propoj své produkty, přizpůsob design a publikuj. Klikni na jakoukoli šablonu níže a podívej se na živou demo verzi.
      </p>
    </div>
  </section>

  <!-- Top CTA banner -->
  <section class="mx-auto max-w-7xl px-6 pb-8">
    <div class="overflow-hidden rounded-2xl bg-[#16161D] px-8 py-12 text-center text-white">
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Vyzkoušej naše šablony produktových kvízů naživo</h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        Vyzkoušej plně funkční kvízy s doporučením produktů v našem živém demo obchodu Shopify. Otestuj různé typy kvízů,
        prozkoumej podmíněnou logiku, větvené otázky a personalizovaná doporučení produktů v akci.
      </p>
      <a
        href="https://productrecommendationquiz.com/"
        target="_blank"
        rel="external noopener nofollow"
        class="mt-8 inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
      >
        Prozkoumat živá dema kvízů
      </a>
    </div>
  </section>

  <!-- Category nav -->
  <nav class="sticky top-[60px] z-30 border-y border-slate-200 bg-white/95 backdrop-blur" aria-label="Template categories">
    <ul class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-2 px-6 py-3">
      {groups.map((g) => (
        <li>
          <a
            href={`#${g.id}`}
            class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-[#16161D] hover:text-[#16161D]"
          >
            {g.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href="#gallery"
          class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-[#16161D] hover:text-[#16161D]"
        >
          Galerie ukázek kvízů
        </a>
      </li>
    </ul>
  </nav>

  <!-- Template grids -->
  <section class="mx-auto max-w-7xl px-6 py-12">
    {groups.map((g) => (
      <div id={g.id} class="mb-16 scroll-mt-32 last:mb-0">
        <h2 class="mb-8 text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">{g.label}</h2>
        <ul class="grid gap-6 md:grid-cols-2">
          {g.items.map((t) => (
            <li class="flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md">
              <a
                href={t.demo}
                target="_blank"
                rel="external noopener nofollow"
                class="block aspect-[321/217] overflow-hidden bg-slate-50"
              >
                <img src={t.image} alt={t.title} loading="lazy" class="h-full w-full object-cover" />
              </a>
              <div class="flex flex-1 flex-col p-5">
                <h3 class="text-lg font-semibold text-slate-900">{t.title}</h3>
                <p class="mt-2 text-sm text-slate-600">{t.description}</p>
                <div class="mt-5 flex flex-wrap gap-2">
                  <a
                    href={t.demo}
                    target="_blank"
                    rel="external noopener nofollow"
                    class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#26262e]"
                  >
                    Demo
                  </a>
                  <a
                    href={lp("/product-recommendation-quiz/")}
                    class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-4 py-2 text-sm font-semibold text-[#16161D] transition hover:bg-slate-50"
                  >
                    Získat tuto šablonu
                  </a>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <!-- Examples gallery -->
    <div id="gallery" class="scroll-mt-32">
      <h2 class="mb-8 text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Galerie ukázek kvízů</h2>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {gallery.map((file) => (
          <li class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
            <a href={`/img/pages/templates/${file}`} target="_blank" rel="noopener" class="block aspect-video overflow-hidden bg-slate-50">
              <img src={`/img/pages/templates/${file}`} alt="Ukázka kvízu" loading="lazy" class="h-full w-full object-cover" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Solutions cross-link -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 pb-4">
      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-8">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Nevíš, jaký kvíz vytvořit?</h2>
        <p class="mt-3 text-slate-700">
          Naše kvízová řešení vysvětlují nejlepší typ kvízu pro tvůj obor, od rutin péče o pleť až po vyhledávače dárků, s příklady a častými dotazy.
        </p>
        <ul class="mt-6 flex flex-wrap gap-3" role="list">
          {featuredSolutions.map((s) => (
            <li>
              <a
                href={`/solutions/${s.slug}/`}
                class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-[#16161D] hover:text-[#16161D]"
              >
                {s.name}
              </a>
            </li>
          ))}
          <li>
            <a
              href={lp("/solutions/")}
              class="inline-flex items-center rounded-full bg-[#16161D] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#26262e]"
            >
              Všechna řešení →
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Why use templates -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Proč ve svém ecommerce obchodu používat šablony produktových kvízů?
      </h2>
      <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {reasons.map((r) => (
          <li class="rounded-xl border border-slate-200 bg-white p-6">
            <div class="text-2xl">{r.emoji}</div>
            <h3 class="mt-3 text-lg font-semibold text-slate-900">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{r.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Začni vytvářet svůj produktový kvíz ještě dnes
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        Vytvoř pro svůj obchod Shopify nebo WooCommerce poutavé kvízy s doporučením produktů během pár minut. Bez programování.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SITE.signup_url}
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          Vyzkoušej šablony kvízů zdarma
        </a>
        <a
          href={lp("/demo/")}
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          Rezervovat demo
        </a>
      </div>
    </div>
  </section>
</Base>
