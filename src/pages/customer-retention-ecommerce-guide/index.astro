          <g><rect x="220" y="510" width="350" height="170" rx="14" fill="#1F1F29" stroke="rgba(255,255,255,0.10)" stroke-width="1"/><text x="240" y="548" fill="#6B7384" font-size="20" font-weight="800" letter-spacing="2">09</text><text x="395" y="595" text-anchor="middle" fill="#F5F7FA" font-size="17" font-weight="800">Referral programs</text><text x="395" y="640" text-anchor="middle" fill="#A7AFBF" font-size="14">Lowest CAC + highest LTV at once</text></g>
