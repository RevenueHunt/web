---
import Base from "../../../layouts/Base.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import YouTubeFacade from "../../../components/YouTubeFacade.astro";
import { organization, breadcrumb } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Start", url: "/" },
    { name: "Kontakt", url: "/contact/" },
  ]),
];

const channels = [
  {
    label: "Hilfe-Guides lesen",
    href: "https://docs.revenuehunt.com/",
    note: "Self-Service-Dokumentation, Integrationen, Fehlerbehebung.",
    external: true,
  },
  {
    label: "Support & Vertrieb per E-Mail",
    href: "mailto:team@revenuehunt.com",
    note: "team@revenuehunt.com - siehe Reaktionszeiten unten.",
  },
  {
    label: "Systemstatus prüfen",
    href: "https://status.revenuehunt.com/",
    note: "Service-Zustand in Echtzeit und Störungsverlauf. 99,98 %+ Verfügbarkeit.",
    external: true,
  },
];

const responseTiers = [
  {
    label: "Kritisch - Produktion ausgefallen, Sicherheit, Datenintegrität",
    sla: "Erste Reaktion in 30 Minuten, 24/7 weltweit",
  },
  {
    label: "Hoch - wichtige Funktion betroffen, mehrere Nutzer betroffen",
    sla: "Erste Reaktion in 12 Stunden",
  },
  {
    label: "Standard - Fragen, Hilfe bei der Konfiguration",
    sla: "1 Werktag",
  },
  {
    label: "Niedrige Priorität - Feedback, Funktionswünsche",
    sla: "Bis zu 3 Werktage",
  },
];
---

<Base
  title="Kontakt - RevenueHunt"
  description="Nimm Kontakt mit dem RevenueHunt-Support-Team auf. Lies die Hilfe-Guides, sieh dir das Tutorial an oder mach das Support-Quiz, um in wenigen Minuten eine persönliche Antwort zu erhalten."
  jsonLd={jsonLd}
  lang="de"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20 text-center">
      <Breadcrumb items={[{ label: "Start", href: localizedHref("/", "de") }, { label: "Kontakt" }]} />
      <Eyebrow>Melde dich</Eyebrow>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Nimm Kontakt auf
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600">
        Lies die Hilfe-Guides, sieh dir das Tutorial an oder mach unten unser Support-Quiz - das schärfste und
        freundlichste Support-Team im E-Commerce meldet sich bei dir.
      </p>
    </div>
  </section>

  <!-- Two-column: video + channels -->
  <section class="mx-auto max-w-7xl px-6 py-12">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Starte mit dem Tutorial</h2>
        <p class="mt-3 text-slate-600">
          Die meisten Fragen werden im 3-minütigen Walk-through beantwortet. Sieh es dir kurz an, bevor du dich meldest.
        </p>
        <div class="mt-6 aspect-video overflow-hidden rounded-xl bg-slate-900 shadow-xl">
          <YouTubeFacade id="oL1DnBd6N1U" title="RevenueHunt Support-Tutorial" />
        </div>
      </div>
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">So erreichst du uns</h2>
        <ul class="mt-6 space-y-3">
          {channels.map((c) => (
            <li>
              <a
                href={c.href}
                target={c.external ? "_blank" : undefined}
                rel={c.external ? "external noopener" : undefined}
                class="group flex items-start justify-between gap-4 rounded-xl border border-slate-200 bg-white p-5 transition hover:border-slate-300 hover:shadow-md"
              >
                <div>
                  <p class="text-base font-semibold text-slate-900 group-hover:text-[#16161D]">{c.label}</p>
                  <p class="mt-1 text-sm text-slate-600">{c.note}</p>
                </div>
                <span class="mt-1 shrink-0 text-slate-400 transition group-hover:text-[#16161D]" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Support quiz -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Mach unser Support-Quiz</h2>
      <p class="mx-auto mt-3 max-w-2xl text-slate-600">
        Beantworte ein paar kurze Fragen und wir leiten dich zur richtigen Hilfe - Docs, Tutorial oder eine echte Antwort von einem Menschen.
      </p>
      <div class="mx-auto mt-8 max-w-4xl overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <iframe
          src="https://admin.revenuehunt.com/public/quiz/ZAHJoMM"
          title="RevenueHunt Support-Quiz"
          loading="lazy"
          class="block h-[600px] w-full"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Response times — moved here from the right column so it sits under
       the quiz, since that's where visitors land after asking for help. -->
  <section class="mx-auto max-w-4xl px-6 py-16">
    <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm sm:p-10">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Reaktionszeiten</h2>
      <p class="mt-3 text-slate-600">
        Gestaffeltes Support-SLA für alle Merchants, mit Priorität für Shopify Plus und Enterprise-Konten.
      </p>
      <dl class="mt-6 grid gap-4 sm:grid-cols-2">
        {responseTiers.map((t) => (
          <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
            <dt class="text-sm font-semibold text-slate-900">{t.label}</dt>
            <dd class="mt-1 text-sm text-slate-600">{t.sla}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Base>
