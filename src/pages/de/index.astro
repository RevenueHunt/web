---
import Base from "../../layouts/Base.astro";
import PlanCards from "../../components/pages/PlanCards.astro";
import YouTubeFacade from "../../components/YouTubeFacade.astro";
import { organization, website, softwareApplication } from "../../lib/schema";
import { SITE } from "../../lib/site";
import { localizedHref } from "../../lib/i18n";

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=bfs_badge_hero";
const WOOCOMMERCE_DOWNLOAD =
  "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";
const YOUTUBE_ID = "fJqpGJUzZNE";

const stats = [
  { value: "+20,000", label: "Marken nutzen RevenueHunt" },
  { value: "+45M", label: "Abgeschlossene Quizze" },
  { value: "+370M USD", label: "Umsatz für Händler" },
  { value: "4.9 ★", label: "450+ Fünf-Sterne-Bewertungen" },
];

const pillars = [
  {
    image: "/img/pages/home/recommend-right-products.svg",
    title: "Empfiehl die richtigen Produkte",
    body:
      "Shoppable Quizze steigern den Umsatz, beraten Kunden bei der Auswahl der für sie passenden Produkte und helfen ihnen, sichere Kaufentscheidungen zu treffen.",
  },
  {
    image: "/img/pages/home/know-your-customers.svg",
    title: "Kenne deine Kunden",
    body:
      "Mit Quizzen sammelst du verwertbare Daten, indem du deinen Kunden gezielte Fragen stellst. Segmentiere und markiere deine Shopper anhand ihrer Antworten.",
  },
  {
    image: "/img/pages/home/grow-your-audience.svg",
    title: "Vergrößere deine Audience",
    body:
      "Schicke gewonnene Leads an deine Mailingliste oder dein CRM. Nutze Kundenprofildaten, um personalisiertere Marketingkampagnen mit höherem ROI zu erstellen.",
  },
];

const features = [
  {
    kicker: "AI quiz copilot",
    title: "Erstelle ein Quiz in 60 Sekunden mit AI",
    body:
      "Beschreibe deinen Store, und unser AI-Copilot erstellt ein vollständig konfiguriertes Quiz - Fragen, Logik und Produktzuordnungen - bereit zur Veröffentlichung.",
  },
  {
    kicker: "Conditional logic",
    title: "Verzweigungslogik per Drag-and-drop",
    body:
      "Zeige oder verberge Fragen abhängig von vorherigen Antworten. Führe jeden Shopper auf den Pfad, der im Kauf endet - ganz ohne Code.",
  },
  {
    kicker: "Quiz design",
    title: "Mach es zu deinem - ganz ohne Code",
    body:
      "Passe Farben, Schriften, Bilder und Layout an deine Marke an. Dein Quiz wirkt wie ein Teil deines Stores, nicht wie ein Drittanbieter-Widget.",
  },
  {
    kicker: "Results page",
    title: "Eine checkout-fertige Ergebnisseite, die konvertiert",
    body:
      "Zeige personalisierte Produktempfehlungen, gruppiert nach Routine-Schritt - mit Bildern, Preisen und Add-to-Cart-Buttons. Shopper kaufen direkt von der Ergebnisseite.",
  },
  {
    kicker: "Drop-off analytics",
    title: "Wisse genau, wo Shopper abspringen",
    body:
      "Sieh dir Abbruchraten, Zielorte und Ergebnisse Frage für Frage an. Behebe Reibungspunkte, verbessere Abschlüsse und hole verlorenen Umsatz zurück.",
  },
  {
    kicker: "Third-party integrations",
    title: "Verbinde deinen gesamten Marketing-Stack",
    body:
      "Schicke Quiz-Daten an Google Analytics, löse Meta-Pixel-Events fürs Retargeting aus und synchronisiere Leads mit Klaviyo - alles von einer einzigen Einstellungsseite. Kein Code, keine Middleware.",
  },
];

const steps = [
  {
    title: "Installiere die App",
    body: "Ein-Klick-Installation aus dem Shopify App Store oder dem WordPress-Plugin-Verzeichnis.",
  },
  {
    title: "Erstelle dein Quiz",
    body: "Nutze den AI-Copilot oder den Drag-and-drop-Builder. Füge deine Fragen hinzu, lege deine Logik fest.",
  },
  {
    title: "Ordne deine Produkte zu",
    body: "Verbinde Quiz-Antworten mit deinem Produktkatalog. Empfiehl die beste Übereinstimmung pro Ergebnis.",
  },
  {
    title: "Veröffentliche und bewirb",
    body: "Binde es auf jeder Seite ein, blende es bei Exit-Intent ein oder verlinke darauf aus deinen Anzeigen.",
  },
];

const testimonials = [
  {
    quote:
      "Ich bin von Octane gewechselt. Der Designprozess war viel intuitiver und visuell ansprechender. Als ich bei Klaviyo hängenblieb, antwortete der Support blitzschnell und mit einer super lockeren, offenen Art.",
    author: "Kae Paché",
  },
  {
    quote:
      "Eric war äußerst geduldig, kompetent und gründlich - er führte mich Schritt für Schritt durch die Quiz-Einrichtung. Support wie dieser ist selten.",
    author: "Marcelle",
  },
  {
    quote:
      "Die App selbst ist hervorragend: starke Funktionen, intuitive Bedienung. Das Team hat für uns ein personalisiertes Walkthrough-Tutorial erstellt. Seit über 3 Jahren im Einsatz.",
    author: "Didymos",
  },
  {
    quote:
      "Mit Abstand die beste Quiz- und Produktempfehlungs-App, die ich auf Shopify getestet habe. Das Team nahm sich Zeit, alles zu untersuchen, jeden Schritt klar zu erklären und zu begleiten, bis das Problem vollständig gelöst war.",
    author: "REYNA",
  },
  {
    quote:
      "Es war die 5. Quiz-App, die ich ausprobiert habe, und die einzige, die voll und ganz das unterstützte, was ich brauchte. Mein erstes Quiz hatte ich sehr schnell erstellt.",
    author: "CCA Printing",
  },
  {
    quote:
      "Der Kundenservice sticht heraus - ein Mitarbeiter nahm ein Video auf und führte mich Schritt für Schritt durch die Lösung. Sehr reaktionsschnell und super hilfsbereit.",
    author: "The Love U Collective",
  },
];

const verticals = [
  { icon: "💄", title: "Beauty & Hautpflege", body: "Hauttyp-Finder, Farbtonabgleich, Routine-Builder." },
  { icon: "💊", title: "Nahrungsergänzung", body: "Quizze zu Gesundheitszielen, die den richtigen Stack empfehlen." },
  { icon: "👗", title: "Mode", body: "Stil-Quizze, die die richtige Passform, Farbe und Schnittform finden." },
  { icon: "🐾", title: "Haustiere", body: "Rassespezifische Produktempfehlungen für jeden Halter." },
  { icon: "🍵", title: "Essen & Getränke", body: "Geschmacksprofil-Quizze, die Stöberer zu Abonnenten machen." },
  { icon: "🏋️", title: "Fitness", body: "Zielbasierte Funnels für Equipment, Bekleidung und Programme." },
  { icon: "🏠", title: "Wohnen & Deko", body: "Stil-Quizze, die Möbel zu jedem Wohnraum passen lassen." },
  { icon: "🌿", title: "Öko & nachhaltig", body: "Werte-Matching-Quizze für den bewussten Konsumenten." },
];

const brands = [
  "Olaplex", "Madluvv", "Mattel", "Alt", "Baia", "Bare", "Biktrix",
  "Dermocracy", "Diego", "Gisou", "Laura", "Nuxe", "Olcay",
  "Salad Code", "Salugea", "Sunday", "Tushy", "Tiege",
];

const SHOPIFY_REVIEWS =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/reviews?ratings%5B%5D=5&sort_by=relevance";
const WOOCOMMERCE_REVIEWS =
  "https://wordpress.org/support/plugin/product-recommendation-quiz-for-ecommerce/reviews/?filter=5";
---

<Base translated={true}
  lang="de"
  title={`${SITE.name} - Product Recommendation Quiz, das konvertiert`}
  description="Mach aus passiven Stöberern Käufer mit einem geführten Product Recommendation Quiz. Erfasse zero-party data, empfiehl das richtige Produkt, steigere die Conversion. Kein Code."
  jsonLd={[organization(), website(), softwareApplication()]}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-7xl px-6 py-16 lg:py-24">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:items-start lg:gap-16">
        <div>
          <a
            href={SHOPIFY_INSTALL}
            rel="external nofollow"
            onclick="window.gtag&&gtag('event','shopify_app_install',{event_label:'home_hero_badge'})"
            class="mb-6 inline-block"
          >
            <img
              src="/img/home/bfs-badge.webp"
              alt="Built for Shopify"
              width="120"
              height="38"
              class="h-8 w-auto"
              loading="eager"
            />
          </a>
          <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
            Das Product Recommendation Quiz, das Stöberer zu Käufern macht
          </h1>
          <p class="mt-6 max-w-xl text-lg text-slate-700">
            Bezahlte Anzeigen bringen Klicks - unsere Quizze machen daraus Verkäufe. RevenueHunt führt Shopper zu den richtigen Produkten,
            sammelt Daten und steigert Conversions. Einfach zu installieren, kein Code nötig.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={SHOPIFY_INSTALL}
              rel="external nofollow"
              onclick="window.gtag&&gtag('event','shopify_app_install',{event_label:'home_hero'})"
              class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
            >
              auf Shopify installieren
            </a>
            <a
              href={WOOCOMMERCE_DOWNLOAD}
              rel="external nofollow"
              onclick="window.gtag&&gtag('event','download_woocommerce_plugin',{event_label:'home_hero'})"
              class="inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-6 py-3 text-base font-semibold text-slate-900 transition hover:border-slate-400 hover:bg-slate-50"
            >
              für WooCommerce holen
            </a>
          </div>
          <p class="mt-4 text-sm text-slate-500">
            Gratis-Plan verfügbar · 15 Tage kostenlos testen · 30 Tage Geld-zurück-Garantie
          </p>
        </div>

        <div class="relative lg:mt-14">
          <div class="aspect-video overflow-hidden rounded-xl bg-slate-900 shadow-2xl">
            <YouTubeFacade
              id={YOUTUBE_ID}
              title="RevenueHunt - Product Recommendation Quiz"
              poster="/img/home/video-poster.webp"
              alt="RevenueHunt Product Recommendation Quiz Demo für Shopify- und WooCommerce-Stores"
              eager
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats / proof bar -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <p class="text-center text-sm font-semibold uppercase tracking-wider text-white/70">
        Warum RevenueHunt? Unsere Wirkung spricht für sich
      </p>
      <dl class="mt-8 grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-4">
        {stats.map((s) => (
          <div class="text-center">
            <dt class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{s.value}</dt>
            <dd class="mt-2 text-sm text-white/70">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Problem framing -->
  <section class="mx-auto max-w-4xl px-6 py-20 text-center">
    <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
      Shopper wissen nicht immer, was sie kaufen sollen - und das bedeutet verlorene Verkäufe.
    </h2>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-700">
      Unser <a href={localizedHref("/product-recommendation-quiz/", "de")} class="font-semibold text-slate-900 underline underline-offset-4 hover:text-slate-700">Product Recommendation Quiz</a> begleitet jeden Kunden durch seine Journey und hilft ihm, die für ihn richtigen Produkte zu entdecken und zu kaufen.
    </p>
  </section>

  <!-- 3-up pillars -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="grid gap-10 md:grid-cols-3">
        {pillars.map((p) => (
          <div class="text-center">
            <img src={p.image} alt={p.title} width="120" height="120" class="mx-auto h-24 w-24" loading="lazy" />
            <h3 class="mt-6 text-xl font-semibold text-slate-900">{p.title}</h3>
            <p class="mt-3 text-slate-600">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features grid -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Alles, was du brauchst, um smarter zu verkaufen</h2>
      </div>
      <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {features.map((f) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">{f.kicker}</p>
            <h3 class="mt-2 text-xl font-semibold text-slate-900">{f.title}</h3>
            <p class="mt-3 text-slate-600">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4-step setup -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">In 4 Schritten live. In unter 15 Minuten.</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          Keine Entwickler. Kein Code. Nur ein Quiz, das deine Kunden lieben werden.
        </p>
      </div>
      <ol class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <li class="rounded-xl border border-slate-200 bg-white p-6">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-[#16161D] text-sm font-bold text-white">{i + 1}</span>
            <h3 class="mt-4 text-lg font-semibold text-slate-900">{s.title}</h3>
            <p class="mt-2 text-slate-600">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          Sieh, warum Händler das Product Recommendation Quiz lieben
        </h2>
        <p class="mx-auto mt-4 max-w-3xl text-lg text-slate-700">
          Von über 20.000 Marken genutzt und durch 450+ Fünf-Sterne-Bewertungen auf Shopify, WooCommerce und mehr gestützt -
          RevenueHunt ist die Quiz-App der Wahl, um über Personalisierung Verkäufe anzukurbeln. Aber verlass dich nicht nur auf unser Wort.
        </p>
        <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap text-sm">
          <a href={SHOPIFY_REVIEWS} rel="external nofollow" class="font-semibold text-[#16161D] underline-offset-4 hover:underline">
            Bewertungen auf Shopify →
          </a>
          <a href={WOOCOMMERCE_REVIEWS} rel="external nofollow" class="font-semibold text-[#16161D] underline-offset-4 hover:underline">
            Bewertungen auf WooCommerce →
          </a>
        </div>
      </div>

      <h3 class="mt-16 text-center text-xl font-semibold text-slate-900">Was Händler sagen</h3>
      <div class="rh-carousel mt-8">
        <ul data-carousel class="rh-carousel__track" aria-label="Erfahrungsberichte von Händlern">
          {testimonials.map((t) => (
            <li class="rounded-xl border border-slate-200 bg-white p-6">
              <p class="text-amber-500" aria-label="5 von 5 Sternen">★★★★★</p>
              <blockquote class="mt-3 text-slate-700">"{t.quote}"</blockquote>
              <p class="mt-4 text-sm font-semibold text-slate-900"> - {t.author}</p>
            </li>
          ))}
        </ul>
        <div data-carousel-dots class="rh-carousel__dots"></div>
      </div>
    </div>
  </section>

  <!-- Verticals -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Für jede eCommerce-Branche gemacht</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          Ob du Hautpflege, Nahrungsergänzung oder Sofas verkaufst - ein Quiz, das Shoppern hilft, das richtige Produkt zu finden, konvertiert besser als jede Kollektionsseite.
        </p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {verticals.map((v) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6">
            <span class="block text-3xl" aria-hidden="true">{v.icon}</span>
            <h3 class="mt-3 text-base font-semibold text-slate-900">{v.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Brand logos -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-white sm:text-3xl">Wir treiben Top-eCommerce-Marken an</h2>
      <div class="brands-marquee mt-10">
        <ul class="brands-marquee__track" aria-label="Logos von Kundenmarken">
          {brands.map((b) => (
            <li class="brands-marquee__item">
              <img
                src={`/img/brands/${b.toLowerCase().replace(/ /g, "-")}.svg`}
                alt={b}
                loading="lazy"
                width="160"
                height="40"
              />
            </li>
          ))}
          {brands.map((b) => (
            <li class="brands-marquee__item" aria-hidden="true">
              <img
                src={`/img/brands/${b.toLowerCase().replace(/ /g, "-")}.svg`}
                alt={`${b} logo`}
                loading="lazy"
                width="160"
                height="40"
              />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <style>
    .brands-marquee {
      overflow: hidden;
      -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
      mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    }
    .brands-marquee__track {
      display: flex;
      align-items: center;
      width: max-content;
      list-style: none;
      padding: 0;
      margin: 0;
      animation: brands-marquee 40s linear infinite;
    }
    .brands-marquee:hover .brands-marquee__track {
      animation-play-state: paused;
    }
    .brands-marquee__item {
      flex-shrink: 0;
      padding: 10px 24px;
      height: 64px;
      display: flex;
      align-items: center;
    }
    .brands-marquee__item img {
      height: 100%;
      width: auto;
      max-width: 160px;
      object-fit: contain;
      /* Normalize mixed-fill SVGs to white on the dark strip. */
      filter: brightness(0) invert(1);
      opacity: 0.85;
    }
    @keyframes brands-marquee {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }
    @media (prefers-reduced-motion: reduce) {
      .brands-marquee__track { animation: none; }
    }
  </style>

  <!-- Plans summary -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Wähle den besten Plan für dein eCommerce</h2>
        <p class="mt-4 text-base text-slate-700 sm:text-lg">
          Gratis-Plan verfügbar. 15 Tage kostenlos testen mit unbegrenzten Quiz-Antworten &amp; allen Funktionen. 30 Tage Geld-zurück-Garantie.
        </p>
      </div>

      <div class="mt-12">
        <PlanCards lang="de" />
      </div>
    </div>
  </section>

  <!-- Multi-platform strip -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-16 text-center">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Funktioniert auf mehreren eCommerce-Plattformen</h2>
      <!-- Logos are white SVGs (built for a dark bg); brightness-0 inverts them to dark for this white section. -->
      <ul class="mt-10 flex flex-wrap items-center justify-center gap-x-14 gap-y-8">
        <li>
          <a href="/product-recommendation-quiz-shopify/" aria-label="Product Recommendation Quiz für Shopify">
            <img src="/img/logos/shopify_monotone_white.svg" alt="Shopify" class="h-8 w-auto opacity-60 brightness-0 transition hover:opacity-100" />
          </a>
        </li>
        <li>
          <a href="/product-recommendation-quiz-woocommerce/" aria-label="Product Recommendation Quiz für WooCommerce">
            <img src="/img/logos/woo_logo_white.svg" alt="WooCommerce" class="h-8 w-auto opacity-60 brightness-0 transition hover:opacity-100" />
          </a>
        </li>
        <li>
          <a href="/product-recommendation-quiz-bigcommerce/" aria-label="Product Recommendation Quiz für BigCommerce">
            <img src="/img/logos/bigcommerce_logo_white.svg" alt="BigCommerce" class="h-7 w-auto opacity-60 brightness-0 transition hover:opacity-100" />
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-white/70">
        Die meisten Shopper gehen, weil sie das richtige Produkt nicht finden
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Mach aus Shoppern selbstsichere Käufer mit einem Product Recommendation Quiz, das Verkäufe antreibt.
      </h2>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SHOPIFY_INSTALL}
          rel="external nofollow"
          onclick="window.gtag&&gtag('event','shopify_app_install',{event_label:'home_bottom'})"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          auf Shopify installieren
        </a>
        <a
          href={WOOCOMMERCE_DOWNLOAD}
          rel="external nofollow"
          onclick="window.gtag&&gtag('event','download_woocommerce_plugin',{event_label:'home_bottom'})"
