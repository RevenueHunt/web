---
import Base from "../../../layouts/Base.astro";
import PageHero from "../../../components/PageHero.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import PartnerCard from "../../../components/PartnerCard.astro";
import { organization, breadcrumb } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

interface Partner {
  name: string;
  url: string;
  logo: string;
  description: string;
}

const groups: { heading: string; emoji: string; intro: string; items: Partner[] }[] = [
  {
    heading: "Lokalisierung",
    emoji: "🌍",
    intro: "Verkaufe international mit integrierter Geolokalisierung, Übersetzung und Mehrwährungsfunktion.",
    items: [
      { name: "Orbe Shopify Geolocation", url: "https://apps.shopify.com/orbe?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/orbe-removebg-preview.webp", description: "Maximiere globale Umsätze mit fortschrittlicher Shopify-Geolokalisierung. Passe Produkte, Preise, Währung und Inhalte für jedes Land an und führe Kunden mit Orbe zum richtigen Einkaufserlebnis." },
    ],
  },
  {
    heading: "Chat & Support",
    emoji: "💬",
    intro: "Kundenkonto-Tools, die Self-Service und Support mühelos machen.",
    items: [
      { name: "Dondy WhatsApp Marketing & Chat", url: "https://apps.shopify.com/dondy-marketing-ai?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/dondy-logo.webp", description: "Verwandle verlorenen Traffic in Umsatz mit automatisierten WhatsApp-Flows für Rückgewinnung, Bestätigung und Bindung – plus einem KI-Agenten, der den Kundensupport übernimmt, damit dein Team es nicht tun muss." },
    ],
  },
  {
    heading: "Upselling & Empfehlungen",
    emoji: "🎯",
    intro: "Steigere den durchschnittlichen Bestellwert mit Cart-Upsells, Wunschlisten und Vorbestellungen.",
    items: [
      { name: "Smart Size Chart & Fit Finder", url: "https://smartsize.io/?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/smartsize-logo.webp", description: "Erstelle KI-gestützte Größentabellen, Größenratgeber und 'Finde meine Größe'-Quizze in Minuten - reduziere Größenfragen und Retouren und steigere die Conversion." },
      { name: "WC Wishlist Club", url: "https://apps.shopify.com/wishlist-club?utm_source=RevenueHunt&utm_medium=partnership&utm_campaign=partnership", logo: "/img/pages/partners/wishlist-club-150-150-px-logo.webp", description: "Mit WC Wishlist Club können deine Kunden ihre Lieblingsprodukte speichern, Wunschlisten teilen und später einkaufen - das steigert Engagement und Umsatz. Einfach einzurichten, mobilfreundlich und perfekt, um aus Stöbernden treue Käufer zu machen." },
      { name: "iCart Cart Drawer Cart Upsell", url: "https://apps.shopify.com/icart/?campaign=promotion&medium=in-app-banner&source=revenuehunt&utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/iCart-Cart-Drawer-Cart-Upsell-logo.webp", description: "All-in-one-Shopify-App, um einen Cart Drawer und eine komplette Warenkorbseite mit Upsell, Produktempfehlungen, Fortschrittsleiste, Produkt-Bundle und Rabatten anzupassen." },
    ],
  },
  {
    heading: "Preise & Rabatte",
    emoji: "🏷️",
    intro: "Bundles, Mengenrabatte und B2B-Preise, die größere Warenkörbe belohnen.",
    items: [
      { name: "Kaching Bundle Quantity Deals", url: "https://apps.shopify.com/bundle-deals?utm_source=RevenueHunt&utm_medium=partnership&utm_campaign=REVENUEH", logo: "/img/pages/partners/Kaching-Logo-1024x1024.webp", description: "Steigere den Umsatz mit Kaching Bundle Quantity Deals - erstelle Bundle-Angebote direkt auf deiner Produktseite. Nutze den Code REVENUEH20 für einen exklusiven Rabatt von 20%." },
      { name: "BSS: B2B/Wholesale Solution", url: "https://apps.shopify.com/b2b-solution-custom-pricing?utm_source=RevenueHunt&utm_medium=partnership&utm_campaign=partnership-2024", logo: "/img/pages/partners/BSS-Commerce_logo_150.webp", description: "All-in-one-Wholesale-Lösung. Ein nahtloses B2B-Einkaufserlebnis, das Händlern zugleich hilft, ihre Wholesale-Kunden zu verwalten und Insights über sie zu gewinnen." },
    ],
  },
  {
    heading: "Marketing & Pop-ups",
    emoji: "📣",
    intro: "Social Proof, Affiliate-Programme und Onsite-Kampagnen, die den Verkauf ankurbeln.",
    items: [
      { name: "UpPromote: Affiliate & Referral", url: "https://partners.secomapp.com/apps/affiliate/SHOPQUIZ_APP", logo: "/img/pages/partners/NEW_logo-1.webp", description: "UpPromote ist die meistempfohlene Affiliate-/Referral-App im Shopify App Store. Eine All-in-one-Lösung, um deine Marketingkampagnen aufzubauen und zu verwalten, geeignet für jede Unternehmensgröße." },
    ],
  },
  {
    heading: "Versand & Fulfillment",
    emoji: "📦",
    intro: "Sourcing, Logistik und Gratisversand-Anreize, um schneller zu versenden und zu skalieren.",
    items: [
      { name: "Essential Free Shipping Bar", url: "https://apps.shopify.com/essential-order-value-booster?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/freeshippingbarlogo.webp", description: "Steigere Umsatz und AOV, indem du unbegrenzt Gratis-Versand-Leisten mit mehreren Warenkorbwert-Zielen einrichtest, um Käufer dazu zu motivieren, mehr Produkte hinzuzufügen." },
      { name: "HyperSKU", url: "https://apps.shopify.com/hypersku?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/150150-logo.webp", description: "HyperSKU bietet eine All-in-one-Lieferkettenlösung. Über 1 Mio. Produkte, Bundle-Verkauf, Sampling, Qualitätsprüfung, Markenanpassung und automatisierte Auftragsabwicklung." },
    ],
  },
  {
    heading: "Analyse & Reporting",
    emoji: "📊",
    intro: "SEO-Einblicke und Bestelldaten, um zu messen, was funktioniert, und darüber zu berichten.",
    items: [
      { name: "AI SEO Optimizer", url: "https://share.seoant.com/app/1165b75b7ce1524D5J", logo: "/img/pages/partners/SEOAnt-_-AI-SEO-Optimizer_Channelwill-.webp", description: "Beste SEO-App für Shopify - optimiere Keywords, verbessere Meta-Tags und perfektioniere die Seitenstruktur. AI-gestützte SEO-Performance- und Speed-Checks." },
    ],
  },
];

const perks = [
  { title: "Empfehlungsprovisionen", body: "Gewinne neue RevenueHunt-Kunden und kassiere eine lebenslange Provision von 20% auf alle Umsätze, die sie generieren." },
  { title: "Affiliate-Links", body: "Füge deine Affiliate-Links in deine Artikel, Newsletter und Social-Media-Posts ein. Verlinke direkt auf unsere Apps für Shopify, WooCommerce, BigCommerce, Magento und unsere Standalone-Apps." },
  { title: "Dein eigener Partner-Manager", body: "Erhalte Beratung dazu, wie du mit unserem Tool automatisierte Sales-Funnels aufbaust, sowie Tipps, wie du unsere Lösung an deine Kunden verkaufst." },
  { title: "Exklusive Inhalte", body: "Melde dich für Beratung dazu, wie du mit RevenueHunt und anderen Tools automatisierte Sales-Funnels für deine Kunden aufbaust." },
  { title: "Ein Platz in unserem Partner Directory", body: "Unsere Nutzer finden dich in unserem Partner Directory und wenden sich für deine Dienstleistungen an dich." },
];

const faqs = [
  { q: "Was kostet es, Partner zu werden?", a: "Die Anmeldung ist völlig kostenlos. Null. Nada." },
  { q: "Muss ich RevenueHunt-Kunde sein?", a: "Nein, du musst kein Kunde von RevenueHunt sein, um Partner zu werden." },
  { q: "Wie werde ich bezahlt?", a: "Wir zahlen die Einnahmen monatlich aus. Die Zahlungen erfolgen über PayPal." },
  { q: "Wie kann ich meine Empfehlungen verfolgen?", a: "Du siehst deine Statistiken in deinem <a href='https://admin.revenuehunt.com/' target='_blank' rel='external noopener' class='font-semibold text-[#16161D] underline'>Partner Dashboard</a>." },
];

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Start", url: "/" },
    { name: "Partner & Affiliates", url: "/partners/" },
  ]),
];
---

<Base
  title="Partnerprogramm - RevenueHunt"
  description="Empfiehl deine Kunden. Verdiene Geld. Erhalte eine lebenslange Provision von 20% von Kunden, die du an RevenueHunt empfiehlst. Melde dich kostenlos für unser Partnerprogramm an."
  jsonLd={jsonLd}
  lang="de"
  translated={true}
>
  <!-- Hero -->
  <PageHero center>
      <Breadcrumb items={[{ label: "Start", href: localizedHref("/", "de") }, { label: "Partner & Affiliates" }]} />
      <Eyebrow>Partnerprogramm</Eyebrow>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Empfiehl deine Kunden. Verdiene Geld.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-xl text-slate-600">
        Erhalte eine <strong class="font-semibold text-slate-900">lebenslange Provision von 20%</strong> von Kunden, die du an uns empfiehlst. Melde dich noch heute kostenlos für unser Partnerprogramm an.
      </p>
      <p class="mx-auto mt-6 max-w-3xl text-slate-600">
        Wenn du eine <strong class="font-semibold text-slate-900">Digital-Marketing-Agentur</strong> oder ein
        <strong class="font-semibold text-slate-900">Ecommerce-Spezialist</strong> bist und dein Geschäft ausbauen möchtest,
        ist unser Partnerprogramm genau das Richtige für dich. Schaffe großartige Erlebnisse für deine Kunden mit RevenueHunt.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
        >
          Jetzt loslegen
        </a>
        <a
          href="#partners"
          class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
        >
          Unsere Partner ansehen
        </a>
      </div>
  </PageHero>

  <!-- Who you are + perks -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-1">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Wer du bist</h2>
        <p class="mt-4 text-slate-600">
          Du bist eine Digital-Marketing-Agentur oder ein Ecommerce-Berater, der für Design brennt und davon besessen ist,
          <strong class="font-semibold text-slate-900">die besten Ergebnisse zu erzielen</strong> für deine Kunden. Du baust
          dein Geschäft aus, indem du andere Unternehmen stärkst.
        </p>
      </div>
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Was du von uns bekommst</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {perks.map((p) => (
            <li class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="text-base font-semibold text-slate-900">{p.title}</h3>
              <p class="mt-2 text-sm text-slate-600">{p.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Partner directory -->
  <section id="partners" class="mx-auto max-w-7xl px-6 py-16 scroll-mt-24">
    <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Unsere Partner</h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
      Vertrauenswürdige Apps und Agenturen, die sich wunderbar mit RevenueHunt für deine Kunden kombinieren lassen.
    </p>
    <div class="mt-12 space-y-16">
      {groups.map((g) => (
        <div>
          <div class="mb-2 flex items-baseline gap-3">
            <span class="text-2xl" aria-hidden="true">{g.emoji}</span>
            <h3 class="text-2xl font-semibold tracking-tight text-slate-900">{g.heading}</h3>
          </div>
          <p class="max-w-3xl text-slate-600">{g.intro}</p>
          <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {g.items.map((p) => (
        <PartnerCard {...p} alt={`Logo von ${p.name}`} cta="App installieren" />
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Häufig gestellte Fragen</h2>
      <div class="mx-auto mt-8 max-w-2xl">
        {faqs.map((f) => (
          <details class="border-b border-slate-200">
            <summary class="py-4 text-base font-semibold text-slate-900">{f.q}</summary>
            <p class="pb-4 text-slate-600" set:html={f.a}></p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Werde RevenueHunt-Partner
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        Empfiehl deine Kunden, baue automatisierte Sales-Funnels auf und verdiene eine lebenslange Provision von 20% auf alles, was sie ausgeben.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          Jetzt loslegen
        </a>
        <a
          href={localizedHref("/demo/", "de")}
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          Demo buchen
        </a>
      </div>
    </div>
  </section>
</Base>
