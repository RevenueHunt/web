---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

interface Partner {
  name: string;
  url: string;
  logo: string;
  description: string;
}

const groups: { heading: string; emoji: string; intro: string; items: Partner[] }[] = [
  {
    heading: "Shopify-Apps",
    emoji: "🧩",
    intro: "Shopify-Apps, die perfekt mit RevenueHunt harmonieren, um deinen Shop wachsen zu lassen.",
    items: [
      { name: "Orbe Shopify Geolocation", url: "https://orbe.app/", logo: "/img/pages/partners/orbe-removebg-preview.webp", description: "Maximiere globale Umsätze mit fortschrittlicher Shopify-Geolokalisierung. Passe Produkte, Preise, Währung und Inhalte für jedes Land an und führe Kunden mit Orbe zum richtigen Einkaufserlebnis." },
      { name: "WC Wishlist Club", url: "https://apps.shopify.com/wishlist-club?utm_source=revenuehunt&utm_medium=website&utm_campaign=partnership", logo: "/img/pages/partners/wishlist-club-150-150-px-logo.webp", description: "Mit WC Wishlist Club können deine Kunden ihre Lieblingsprodukte speichern, Wunschlisten teilen und später einkaufen - das steigert Engagement und Umsatz. Einfach einzurichten, mobilfreundlich und perfekt, um aus Stöbernden treue Käufer zu machen." },
      { name: "Langwill: Language Translate", url: "https://apps.shopify.com/localiser", logo: "/img/pages/partners/1.webp", description: "Erweitere deine globale Reichweite mit Langwill - übersetze deinen Shopify-Store in 138 Sprachen und konvertiere Währungen automatisch für ein nahtloses, lokalisiertes Einkaufserlebnis." },
      { name: "Customer Dashboard Pro", url: "https://apps.shopify.com/customer-dashboard-pro?utm_source=revenuehunt", logo: "/img/pages/partners/CustomerDashboard.webp", description: "Customer Dashboard Pro ist die einzige App, die nahtlose Unterstützung sowohl für die New Customer Accounts von Shopify als auch für die Classic Customer Accounts bietet." },
      { name: "ToastiBar – Sales Popup", url: "https://makeprosimp.com/partnership/revenuehunt", logo: "/img/pages/partners/toastibarlogo_fgaiv9.webp", description: "Stärke das Vertrauen deiner Kunden und steigere den Umsatz, indem du Social Proof in Echtzeit zeigst: Verkäufe, Warenkorb, Besucher, Produkt-Reviews und Bestandshinweise." },
      { name: "UpPromote: Affiliate & Referral", url: "https://partners.secomapp.com/apps/affiliate/SHOPQUIZ_APP", logo: "/img/pages/partners/NEW_logo-1.webp", description: "UpPromote ist die meistempfohlene Affiliate-/Referral-App im Shopify App Store. Eine All-in-one-Lösung, um deine Marketingkampagnen aufzubauen und zu verwalten, geeignet für jede Unternehmensgröße." },
      { name: "Essential Free Shipping Bar", url: "https://apps.shopify.com/essential-order-value-booster", logo: "/img/pages/partners/freeshippingbarlogo.webp", description: "Steigere Umsatz und AOV, indem du unbegrenzt Gratis-Versand-Leisten mit mehreren Warenkorbwert-Zielen einrichtest, um Käufer dazu zu motivieren, mehr Produkte hinzuzufügen." },
      { name: "iCart Cart Drawer Cart Upsell", url: "https://apps.shopify.com/icart/?campaign=promotion&medium=in-app-banner&source=revenuehunt", logo: "/img/pages/partners/iCart-Cart-Drawer-Cart-Upsell-logo.webp", description: "All-in-one-Shopify-App, um einen Cart Drawer und eine komplette Warenkorbseite mit Upsell, Produktempfehlungen, Fortschrittsleiste, Produkt-Bundle und Rabatten anzupassen." },
      { name: "Kaching Bundle Quantity Deals", url: "https://apps.shopify.com/bundle-deals?utm_source=partnership&utm_medium=web&utm_campaign=REVENUEH", logo: "/img/pages/partners/Kaching-Logo-1024x1024.webp", description: "Steigere den Umsatz mit Kaching Bundle Quantity Deals - erstelle Bundle-Angebote direkt auf deiner Produktseite. Nutze den Code REVENUEH20 für einen exklusiven Rabatt von 20%." },
      { name: "PDF Invoice Generator", url: "https://apps.shopify.com/fordeer-invoice-order-printer?utm_source=ShopQuizProductRecommender&utm_medium=comarketing&utm_campaign=partner", logo: "/img/pages/partners/fordeer-data-export-1024x1024.webp", description: "Der Shopify-Rechnungsgenerator von Fordeer ist flexibel, global konform und für B2C, B2B und Wholesale geeignet. Anpassbare PDF-Vorlagen, Stapeldruck, Live-Chat-Support rund um die Uhr." },
      { name: "AI SEO Optimizer", url: "https://share.seoant.com/app/1165b75b7ce1524D5J", logo: "/img/pages/partners/SEOAnt-_-AI-SEO-Optimizer_Channelwill-.webp", description: "Beste SEO-App für Shopify - optimiere Keywords, verbessere Meta-Tags und perfektioniere die Seitenstruktur. AI-gestützte SEO-Performance- und Speed-Checks." },
      { name: "BSS: B2B/Wholesale Solution", url: "https://apps.shopify.com/b2b-solution-custom-pricing?utm_source=RevenueHunt&utm_medium=partner-listing&utm_campaign=partnership-2024", logo: "/img/pages/partners/BSS-Commerce_logo_150.webp", description: "All-in-one-Wholesale-Lösung. Ein nahtloses B2B-Einkaufserlebnis, das Händlern zugleich hilft, ihre Wholesale-Kunden zu verwalten und Insights über sie zu gewinnen." },
      { name: "PreOrder Now WOD", url: "https://apps.shopify.com/preorder-now?utm_source=+revenuehunt&utm_medium=web&utm_campaign=partner&utm_id=crosspromo", logo: "/img/pages/partners/PreOrder-Now-Logo.webp", description: "Verwandle Out-of-Stock-Situationen in Vorbestell-Chancen. Perfekt für Print-on-Demand-Unternehmen - sichere dir das Interesse der Kunden ohne anfänglichen Bestand." },
    ],
  },
  {
    heading: "Fulfillment & Sourcing",
    emoji: "📦",
    intro: "Partner für Sourcing, Fulfillment und Logistik, um schneller zu versenden und global zu skalieren.",
    items: [
      { name: "HyperSKU", url: "https://apps.shopify.com/hypersku", logo: "/img/pages/partners/150150-logo.webp", description: "HyperSKU bietet eine All-in-one-Lieferkettenlösung. Über 1 Mio. Produkte, Bundle-Verkauf, Sampling, Qualitätsprüfung, Markenanpassung und automatisierte Auftragsabwicklung." },
      { name: "Service Points", url: "https://www.servicepoints.eu/en/w2/smart-dropshipping-1?utm_source=revenuehunt&utm_medium=app&utm_id=31", logo: "/img/pages/partners/Logo-Black-background.webp", description: "Service Points stellt SMART Dropshipping vor: automatisiertes Dropshipping und datenbasierte Lieferkettenentscheidungen, um unbegrenzt zu skalieren." },
    ],
  },
  {
    heading: "Themes & Design",
    emoji: "🎨",
    intro: "Premium-Themes und Design, damit dein Shop glänzt.",
    items: [
      { name: "eComX", url: "https://ecomx.co/", logo: "/img/pages/partners/ecomx-logo.webp", description: "eComX entwickelt Premium-Shopify-Themes, die auf Conversion ausgelegt sind. Wähle aus über 16 nischenspezifischen Designs, optimiert mit echten Conversion-Daten und auf Geschwindigkeit getrimmt, um mehr Besucher in Käufer zu verwandeln." },
    ],
  },
];

const perks = [
  { title: "Empfehlungsprovisionen", body: "Gewinne neue RevenueHunt-Kunden und kassiere eine lebenslange Provision von 20% auf alle Umsätze, die sie generieren." },
  { title: "Affiliate-Links", body: "Füge deine Affiliate-Links in deine Artikel, Newsletter und Social-Media-Posts ein. Verlinke direkt auf unsere Apps für Shopify, WooCommerce, BigCommerce, Magento und unsere Standalone-Apps." },
  { title: "Dein eigener Partner-Manager", body: "Erhalte Beratung dazu, wie du mit unserem Tool automatisierte Sales-Funnels aufbaust, sowie Tipps, wie du unsere Lösung an deine Kunden verkaufst." },
  { title: "Exklusive Inhalte", body: "Melde dich für Beratung dazu, wie du mit RevenueHunt und anderen Tools automatisierte Sales-Funnels für deine Kunden aufbaust." },
  { title: "Ein Platz in unserem Partner Directory", body: "Unsere Nutzer finden dich in unserem Partner Directory und wenden sich für deine Dienstleistungen an dich." },
];

const faqs = [
  { q: "Was kostet es, Partner zu werden?", a: "Die Anmeldung ist völlig kostenlos. Null. Nada." },
  { q: "Muss ich RevenueHunt-Kunde sein?", a: "Nein, du musst kein Kunde von RevenueHunt sein, um Partner zu werden." },
  { q: "Wie werde ich bezahlt?", a: "Wir zahlen die Einnahmen monatlich aus. Die Zahlungen erfolgen über PayPal." },
  { q: "Wie kann ich meine Empfehlungen verfolgen?", a: "Du siehst deine Statistiken in deinem Partner Dashboard." },
];

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Start", url: "/" },
    { name: "Partner & Affiliates", url: "/partners/" },
  ]),
];
---

<Base
  title="Partnerprogramm - RevenueHunt"
  description="Empfiehl deine Kunden. Verdiene Geld. Erhalte eine lebenslange Provision von 20% von Kunden, die du an RevenueHunt empfiehlst. Melde dich kostenlos für unser Partnerprogramm an."
  jsonLd={jsonLd}
  lang="de"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20 text-center">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={localizedHref("/", "de")} class="hover:text-slate-700">Start</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Partner &amp; Affiliates</span>
      </nav>
      <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">Partnerprogramm</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Empfiehl deine Kunden. Verdiene Geld.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-xl text-slate-600">
        Erhalte eine lebenslange Provision von 20% von Kunden, die du an uns empfiehlst. Melde dich noch heute kostenlos für unser Partnerprogramm an.
      </p>
      <p class="mx-auto mt-6 max-w-3xl text-slate-600">
        Wenn du eine <strong class="font-semibold text-slate-900">Digital-Marketing-Agentur</strong> oder ein
        <strong class="font-semibold text-slate-900">Ecommerce-Spezialist</strong> bist und dein Geschäft ausbauen möchtest,
        ist unser Partnerprogramm genau das Richtige für dich. Schaffe großartige Erlebnisse für deine Kunden mit RevenueHunt.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
        >
          Jetzt loslegen
        </a>
        <a
          href="#partners"
          class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
        >
          Unsere Partner ansehen
        </a>
      </div>
    </div>
  </section>

  <!-- Who you are + perks -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-1">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Wer du bist</h2>
        <p class="mt-4 text-slate-600">
          Du bist eine Digital-Marketing-Agentur oder ein Ecommerce-Berater, der für Design brennt und davon besessen ist,
          <strong class="font-semibold text-slate-900">die besten Ergebnisse zu erzielen</strong> für deine Kunden. Du baust
          dein Geschäft aus, indem du andere Unternehmen stärkst.
        </p>
      </div>
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Was du von uns bekommst</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {perks.map((p) => (
            <li class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="text-base font-semibold text-slate-900">{p.title}</h3>
              <p class="mt-2 text-sm text-slate-600">{p.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Partner directory -->
  <section id="partners" class="mx-auto max-w-7xl px-6 py-16 scroll-mt-24">
    <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Unsere Partner</h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
      Vertrauenswürdige Apps und Agenturen, die sich wunderbar mit RevenueHunt für deine Kunden kombinieren lassen.
    </p>
    <div class="mt-12 space-y-16">
      {groups.map((g) => (
        <div>
          <div class="mb-2 flex items-baseline gap-3">
            <span class="text-2xl" aria-hidden="true">{g.emoji}</span>
            <h3 class="text-2xl font-semibold tracking-tight text-slate-900">{g.heading}</h3>
          </div>
          <p class="max-w-3xl text-slate-600">{g.intro}</p>
          <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {g.items.map((p) => (
        <li>
          <a
            href={p.url}
            target="_blank"
            rel="external noopener nofollow"
            class="group flex h-full flex-col items-center rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm transition hover:border-slate-300 hover:shadow-md"
          >
            <img
              src={p.logo}
              alt={`Logo von ${p.name}`}
              loading="lazy"
              width="120"
              height="120"
              class="h-24 w-24 rounded-full object-cover"
            />
            <h3 class="mt-5 text-lg font-semibold text-slate-900 group-hover:text-[#16161D]">{p.name}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{p.description}</p>
            <span class="mt-5 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wider text-slate-500 group-hover:text-[#16161D]">
              Website besuchen <span aria-hidden="true">↗</span>
            </span>
          </a>
        </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Häufig gestellte Fragen</h2>
      <div class="mx-auto mt-8 max-w-2xl">
        {faqs.map((f) => (
          <details class="border-b border-slate-200">
            <summary class="py-4 text-base font-semibold text-slate-900">{f.q}</summary>
            <p class="pb-4 text-slate-600">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Werde RevenueHunt-Partner
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        Empfiehl deine Kunden, baue automatisierte Sales-Funnels auf und verdiene eine lebenslange Provision von 20% auf alles, was sie ausgeben.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          Jetzt loslegen
        </a>
        <a
          href={localizedHref("/demo/", "de")}
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          Demo buchen
        </a>
      </div>
    </div>
  </section>
</Base>
