---
import Base from "../../../layouts/Base.astro";
import PageHero from "../../../components/PageHero.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import { organization, breadcrumb, article, faqPage } from "../../../lib/schema";
import { SITE } from "../../../lib/site";
import { localizedHref } from "../../../lib/i18n";
import {
  REPORT,
  DATASET,
  HEADLINE,
  VERTICAL_CONVERSION,
  AOV_UPLIFT,
  ATTRIBUTION,
  BASELINES,
} from "../../../lib/quiz-benchmarks";

const pageUrl = new URL(`/${REPORT.slug}/`, SITE.site_url).href;
const ogImage = `/og/${REPORT.slug}.png`;

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=state_of_product_quizzes";
// Free WordPress.org plugin (not the WooCommerce.com extension).
const WOO_PLUGIN =
  "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";

const formatN = (n: number | null) =>
  n === null ? "" : n.toLocaleString("en-US");

// Conversion expressed against a typical 2% store: 6.9% / 2% = 345%.
const boost = (rate: number) => Math.round((rate / HEADLINE.baselinePct) * 100);

// Übersetzte Methodik + FAQ (das geteilte Datenmodul bleibt Englisch für das PDF
// und die Stat-Karten). Vor jsonLd definiert, damit faqPage(FAQ) die übersetzte
// Fassung nutzt.
const METHODOLOGY = [
  "Quelle: die eigene Plattform von RevenueHunt, über jede Ecommerce-Plattform hinweg, die wir unterstützen. Aggregiert und anonymisiert: kein einzelner Shop ist identifizierbar, und unsere eigenen Demo-Shops sind überall ausgeschlossen.",
  "Die Conversion ist eine Rate pro Quiz-Teilnehmer: Bestellungen, die einer Quiz-Antwort zugeordnet werden, geteilt durch abgeschlossene Quizze. Es ist keine seitenweite Rate. Quiz-Teilnehmer sind selbstselektiert und engagierter als der durchschnittliche Besucher, daher ist das kein Eins-zu-eins-Vergleich mit der Gesamt-Conversion eines Shops. Wir sagen das überall dort, wo wir den Vergleich ziehen.",
  "Die Kategorie wird aus dem vom Händler vergebenen Quiz-Namen abgeleitet (zum Beispiel \"Hautpflege-Quiz\", \"Hundefutter-Quiz\"). Rund 78 % der Antworten stammen aus generischen oder namenlosen Quizzen und sind aus jeder Kennzahl pro Kategorie ausgeschlossen.",
  "Die Steigerung des average order value wird innerhalb des Shops gemessen: der mediane Quiz-Bestellwert desselben Shops gegen seinen medianen Bestellwert ohne Quiz. Das ist währungsrobust und entfernt die Shop-Mix-Verzerrung, die den Effekt in einem naiven plattformweiten Durchschnitt verwässert.",
  "Jede Conversion-Zahl ist ein Mindestwert. Die Attribution wird noch zugeordnet, während Händler Bestellungen synchronisieren (9 % der ersten Bestellungen kommen mehr als 30 Tage nach dem Quiz), und geräteübergreifende oder ungetrackte Bestellungen werden nie zugeordnet. Die echten Zahlen sind höher, nicht niedriger.",
];

const FAQ = [
  {
    question: "Wie wird die Quiz-Conversion gemessen?",
    answer:
      "Bestellungen, die einer Quiz-Antwort zugeordnet werden, geteilt durch abgeschlossene Quizze. Über die Plattform hinweg geben 5,5 % der Käufer, die ein Quiz abschließen (etwa 1 von 18), eine getrackte Bestellung auf. Es ist eine Rate pro Quiz-Teilnehmer, keine seitenweite Rate: Quiz-Teilnehmer sind engagierter als der durchschnittliche Besucher, daher ist sie nicht direkt mit der Gesamt-Conversion eines Shops vergleichbar.",
  },
  {
    question: "Warum ist die Quiz-Conversion-Rate so viel höher als die des durchschnittlichen Shops?",
    answer:
      "Zwei Gründe. Erstens das Quiz selbst: es ersetzt einen überwältigenden Katalog durch ein kurzes Gespräch und eine klare Empfehlung, was die Unentschlossenheit beseitigt, die Verkäufe verliert. Zweitens, was passiert, nachdem die Antworten eingetroffen sind: jedes Quiz erfasst zero-party data und markiert den Käufer, was segmentierte Follow-up-Flows und Retargeting antreibt. Segmentierte Kampagnen erzielen mehr als das 3-Fache des Umsatzes pro Empfänger gegenüber generischen Aussendungen (Klaviyo segmentation benchmark), sodass ein Quiz über personalisierte E-Mails und Anzeigen weiter konvertiert, nicht nur auf der Ergebnisseite.",
    answerHtml:
      "Zwei Gründe. Erstens das Quiz selbst: es ersetzt einen überwältigenden Katalog durch ein kurzes Gespräch und eine klare Empfehlung, was die Unentschlossenheit beseitigt, die Verkäufe verliert. Zweitens, was passiert, nachdem die Antworten eingetroffen sind: jedes Quiz erfasst zero-party data und markiert den Käufer, was segmentierte Follow-up-Flows und Retargeting antreibt. Segmentierte Kampagnen erzielen mehr als das 3-Fache des Umsatzes pro Empfänger gegenüber generischen Aussendungen (<a href=\"https://www.klaviyo.com/marketing-resources/segmentation-benchmark-report\" target=\"_blank\" rel=\"external noopener nofollow\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">Klaviyo segmentation benchmark</a>), sodass ein Quiz über personalisierte E-Mails und Anzeigen weiter konvertiert, nicht nur auf der Ergebnisseite.",
  },
  {
    question: "Geben Quiz-Käufer wirklich mehr pro Bestellung aus?",
    answer:
      "Im Durchschnitt ja, vergleichbar gemessen. Innerhalb desselben Shops sind Bestellungen, die über ein Quiz kamen, etwa 11 % bis 15 % höher als solche, die es nicht waren, und das gilt in rund 7 von 10 Shops. Es ist allerdings nicht universell: am stärksten in Beauty und Hautpflege (etwa +20 %), flacher in Kategorien wie Parfum und Kaffee.",
  },
  {
    question: "Wie lassen sich diese Benchmarks auf meinen Shop übertragen?",
    answer:
      "Gib deinen eigenen Traffic, average order value und deine aktuelle Conversion-Rate in unseren Quiz-ROI-Rechner ein. Er lässt dieselben Benchmarks (die 5,5%-Rate pro Quiz-Teilnehmer, die Conversion pro Kategorie, die AOV-Steigerung) gegen deine Zahlen laufen, um den zusätzlichen Umsatz zu schätzen, den ein Quiz bringen könnte.",
    answerHtml:
      "Gib deinen eigenen Traffic, average order value und deine aktuelle Conversion-Rate in unseren <a href=\"/de/quiz-roi-calculator/\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">Quiz-ROI-Rechner</a> ein. Er lässt dieselben Benchmarks (die 5,5%-Rate pro Quiz-Teilnehmer, die Conversion pro Kategorie, die AOV-Steigerung) gegen deine Zahlen laufen, um den zusätzlichen Umsatz zu schätzen, den ein Quiz bringen könnte.",
  },
  {
    question: "Sind die Daten anonymisiert?",
    answer:
      "Ja. Jede Zahl ist aggregiert und über Millionen von Antworten und Tausende von Shops zusammengefasst. Kein einzelner Shop ist identifizierbar. Der Report existiert, um zu teilen, was der Datensatz aussagt, nicht um einen Händler bloßzustellen.",
  },
  {
    question: "Darf ich diese Zahlen verwenden?",
    answer:
      "Ja. Zitiere sie mit einem Link zu dieser Seite. Der Report ist kostenlos und frei zugänglich, das PDF ist herunterladbar, und die wichtigsten Zahlen sind als teilbare Karten verfügbar.",
  },
];

const pageTitle = "Der Stand der Produktempfehlungs-Quizze: Benchmark-Report 2026";
const pageDescription = "Wie Produktempfehlungs-Quizze wirklich abschneiden: Conversion, Abschlussrate und durchschnittlicher Bestellwert, gebenchmarkt aus über 45 Mio. echten Quiz-Antworten in über 20.000 E-Commerce-Shops.";

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Startseite", url: localizedHref("/", "de") },
    { name: "Der Stand der Produktempfehlungs-Quizze", url: localizedHref(`/${REPORT.slug}/`, "de") },
  ]),
  article({
    title: pageTitle,
    description: pageDescription,
    url: pageUrl,
    image: ogImage,
    datePublished: REPORT.datePublished,
    dateModified: REPORT.dateModified,
    author: "RevenueHunt",
    tags: [
      "Produktempfehlungs-Quiz benchmark",
      "quiz conversion rate",
      "ecommerce personalization",
      "average order value",
    ],
  }),
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "RevenueHunt Produktempfehlungs-Quiz benchmarks 2026",
    description: pageDescription,
    url: pageUrl,
    creator: organization(),
    license: "https://creativecommons.org/licenses/by/4.0/",
    isAccessibleForFree: true,
    datePublished: REPORT.datePublished,
    keywords: [
      "Produktempfehlungs-Quiz",
      "conversion rate",
      "average order value",
      "ecommerce",
      "Shopify",
    ],
    distribution: {
      "@type": "DataDownload",
      encodingFormat: "application/pdf",
      contentUrl: new URL(REPORT.pdfPath, SITE.site_url).href,
    },
  },
  faqPage(FAQ),
];

const publishedLabel = new Date(REPORT.datePublished).toLocaleDateString("de-DE", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

// Category/vertical labels and the two long table notes, translated. Numbers stay
// from the shared data module; only the human-readable labels/notes are localized.
const VERT_LABEL: Record<string, string> = {
  "Fragrance": "Parfum",
  "Haircare": "Haarpflege",
  "Supplements & health": "Nahrungsergänzung & Gesundheit",
  "Beauty & skincare": "Beauty & Hautpflege",
  "Coffee & tea": "Kaffee & Tee",
  "CBD": "CBD",
  "Other sectors": "Andere Sektoren",
  "All quiz categories (pooled)": "Alle Quiz-Kategorien (zusammengefasst)",
};
const GROUPED_NOTE =
  "Alles außerhalb der benannten Kategorien, einschließlich generischer und stärker erwägender Quizze. Gemessen bei etwa 3,6 %, rund 180 % eines typischen Shops.";
const POOLED_NOTE =
  "Die Plattform-Schlagzeile: 5,5 % (1 von 18), etwa 275 % eines typischen 2%-Shops. Generische, namenlose Quizze (~78 % der Antworten) sind aus den Zeilen pro Kategorie ausgeschlossen und ziehen die Gesamtzahl auf ~4 % herunter.";
const SCOPE: Record<string, string> = {
  "Statista": "Weltweit, 2025",
  "IRP Commerce": "Live-Händlerdaten UK/IE, 2025",
  "Dynamic Yield": "400+ mittelgroße bis große Marken, 2025",
  "Shopify": "Shopifys eigene veröffentlichte Richtwerte",
};
const tr = <T extends { vertical: string }>(r: T) => ({ ...r, vertical: VERT_LABEL[r.vertical] ?? r.vertical });
const consumable = VERTICAL_CONVERSION.filter((r) => r.kind === "consumable").map(tr);
const considered = VERTICAL_CONVERSION.filter((r) => r.kind === "considered").map(tr);
const grouped = { ...tr(VERTICAL_CONVERSION.find((r) => r.kind === "grouped")!), note: GROUPED_NOTE };
const pooled = { ...tr(VERTICAL_CONVERSION.find((r) => r.kind === "total")!), note: POOLED_NOTE };
const aovRows = AOV_UPLIFT.perVertical.map(tr);
const baselines = BASELINES.map((b) => ({ ...b, scope: SCOPE[b.source] ?? b.scope }));
---

<Base
  title={pageTitle}
  description={pageDescription}
  ogImage={ogImage}
  jsonLd={jsonLd}
  lang="de"
  translated={true}
>
  <!-- Hero -->
  <PageHero>
      <Breadcrumb items={[{ label: "Startseite", href: localizedHref("/", "de") }, { label: "Der Stand der Produktempfehlungs-Quizze" }]} />
      <div class="text-center">
        <Eyebrow>Benchmark-Report · {publishedLabel}</Eyebrow>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          Der Stand der Produktempfehlungs-Quizze
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          1 von 18 Käufern, die ein Produktempfehlungs-Quiz abschließen, gibt eine Bestellung auf - <strong>das 2,75-Fache eines typischen Onlineshops</strong>. Dieser Report zeigt auf, welche Kategorien am stärksten konvertieren, wie viel mehr Quiz-Käufer ausgeben und wie lange ein einzelnes Quiz weiter Erträge bringt. Auf Basis echter Daten aus <strong>{DATASET.responses} Quiz-Antworten</strong> in {DATASET.brands} Shops.
        </p>
        {/* TODO: restore hero CTAs ("Download the PDF" + "Read the findings")
            once a peer reviews the PDF design. Removed 2026-06-08 to hold the
            PDF download until that review. The PDF is still generated and the
            "Cite this report" section's download link is also held (see below). */}
      </div>
  </PageHero>

  <!-- Dataset band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-2xl bg-[#16161D] px-6 py-10 sm:px-10">
        <p class="text-center text-sm font-semibold uppercase tracking-wider text-white/50">
          Der Datensatz
        </p>
        <dl class="mt-6 grid grid-cols-1 gap-8 text-center sm:grid-cols-3">
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.responses}</dt>
            <dd class="mt-1 text-sm text-white/70">analysierte Quiz-Antworten</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.revenue}</dt>
            <dd class="mt-1 text-sm text-white/70">an für Händler generiertem Umsatz</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.brands}</dt>
            <dd class="mt-1 text-sm text-white/70">Ecommerce-Shops</dd>
          </div>
        </dl>
        <p class="mx-auto mt-6 max-w-3xl text-center text-sm text-white/60">
          Aggregiert und anonymisiert, über Shopify, WooCommerce, BigCommerce, Magento und Standalone hinweg. Kein einzelner Shop ist identifizierbar. Jede Zahl unten ist ein Mindestwert: die Attribution wird noch zugeordnet, also sind die echten Zahlen höher.
        </p>
      </div>
    </div>
  </section>

  <!-- Key findings (stat cards) -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Die wichtigsten Zahlen</h2>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">{HEADLINE.completedConv}%</p>
          <p class="mt-2 font-medium text-slate-900">der Käufer, die ein Quiz abschließen, geben eine Bestellung auf</p>
          <p class="mt-2 text-sm text-slate-600">Etwa 1 von {HEADLINE.completedOneIn}, rund das {HEADLINE.multiple}-Fache eines typischen {HEADLINE.baselinePct}%-Shops.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">+{AOV_UPLIFT.headlineLow}-{AOV_UPLIFT.headlineHigh}%</p>
          <p class="mt-2 font-medium text-slate-900">höherer average order value, innerhalb desselben Shops</p>
          <p class="mt-2 text-sm text-slate-600">Vergleichbar gemessen, vorhanden in rund 7 von 10 Shops.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">{HEADLINE.completionRate}%</p>
          <p class="mt-2 font-medium text-slate-900">der Käufer, die ein Quiz starten, schließen es ab</p>
          <p class="mt-2 text-sm text-slate-600">Etwa 7 von 10 erreichen die Ergebnisseite. {HEADLINE.abandonRate}% brechen vorher ab.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">1 von 5</p>
          <p class="mt-2 font-medium text-slate-900">dem Quiz zugeordnete Bestellungen kommen 30+ Tage später</p>
          <p class="mt-2 text-sm text-slate-600">Das Quiz generiert noch monatelang nach der Teilnahme Umsatz.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Conversion by category -->
  <section id="conversion" class="scroll-mt-20 bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Conversion nach Kategorie</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        Der Plattformdurchschnitt verbirgt eine große Streuung. <strong>Verbrauchs- und Nachkaufkategorien konvertieren zwei- bis dreimal höher</strong> als der durchschnittliche Onlineshop. Hochpreisige und stark erwägende Käufe konvertieren eine Größenordnung niedriger: dort treibt das Quiz die Entdeckung an, aber der Verkauf erfolgt später, außerhalb der Sitzung.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">Kategorie</th>
              <th class="py-3 pr-4 text-right font-semibold">Conversion</th>
              <th class="py-3 pr-4 text-right font-semibold">Conversion-Steigerung durch das Quiz</th>
              <th class="py-3 text-right font-semibold">Antworten</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {consumable.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{r.rate}%</td>
                <td class="py-3 pr-4 text-right tabular-nums text-slate-600">{boost(r.rate)}%</td>
                <td class="py-3 text-right tabular-nums text-slate-500">{formatN(r.n)}</td>
              </tr>
            ))}
            {considered.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{r.rate}%</td>
                <td class="py-3 pr-4 text-right tabular-nums text-slate-600">{boost(r.rate)}%</td>
                <td class="py-3 text-right tabular-nums text-slate-500">{formatN(r.n)}</td>
              </tr>
            ))}
            <tr class="border-b border-slate-200">
              <td class="py-3 pr-4 font-medium">{grouped.vertical}</td>
              <td class="py-3 pr-4 text-right font-semibold tabular-nums">~{grouped.rate}%</td>
              <td class="py-3 pr-4 text-right tabular-nums text-slate-600">~{boost(grouped.rate)}%</td>
              <td class="py-3 text-right tabular-nums text-slate-500">{formatN(grouped.n)}</td>
            </tr>
            <tr class="border-t-2 border-slate-300">
              <td class="py-3 pr-4 font-semibold">{pooled.vertical}</td>
              <td class="py-3 pr-4 text-right font-bold tabular-nums">{pooled.rate}%</td>
              <td class="py-3 pr-4 text-right font-bold tabular-nums text-slate-600">{boost(pooled.rate)}%</td>
              <td class="py-3 text-right tabular-nums text-slate-500">alle</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        {grouped.note}
      </p>
      <p class="mx-auto mt-2 max-w-3xl text-sm text-slate-500 text-center">
        {pooled.note}
      </p>
    </div>
  </section>

  <!-- AOV uplift -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Geben Quiz-Käufer mehr aus?</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        <strong>Innerhalb desselben Shops gemessen</strong>, sind Quiz-Bestellungen <strong>{AOV_UPLIFT.headlineLow}% bis {AOV_UPLIFT.headlineHigh}% größer</strong> als Bestellungen ohne Quiz, und das gilt in {AOV_UPLIFT.storesUpLow}% bis {AOV_UPLIFT.storesUpHigh}% der Shops. Es ist nicht universell: am stärksten, wo das Quiz ein Set oder eine Routine zusammenstellen kann, nahezu flach, wo der Kauf ein einzelner Artikel ist.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">Kategorie</th>
              <th class="py-3 pr-4 text-right font-semibold">AOV-Steigerung innerhalb des Shops</th>
              <th class="py-3 text-right font-semibold">Shops mit einer Steigerung</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {aovRows.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">
                  {r.uplift === null ? "Flach" : `+${r.uplift}%`}
                </td>
                <td class="py-3 text-right tabular-nums text-slate-500">
                  {r.storesUp === null ? "n.v." : `${r.storesUp}%`}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        Innerhalb des Shops gemessen (derselbe Shop, Quiz-Bestellungen vs. Bestellungen ohne Quiz), daher währungsrobust und um den Shop-Mix bereinigt. Über drei unabhängige Stichproben trianguliert mit einem Median von +11%, +15% und +14%. Kategorien mit kleinen Stichproben werden weggelassen statt überzeichnet.
      </p>
    </div>
  </section>

  <!-- Attribution / LTV -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Ein Quiz zahlt sich auch nach der Sitzung weiter aus</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        Die meisten Attributions-Dashboards beurteilen ein Quiz anhand der Bestellungen am selben Tag und hören dort auf. Das übersieht den Großteil des Werts. <strong>{ATTRIBUTION.sameDay}% der ersten dem Quiz zugeordneten Bestellungen erfolgen am selben Tag</strong>, aber der Ausläufer ist lang.
      </p>
      <div class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-4">
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.sameDay}%</p>
          <p class="mt-1 text-sm text-slate-600">am selben Tag</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.within7}%</p>
          <p class="mt-1 text-sm text-slate-600">innerhalb von 7 Tagen</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.within30}%</p>
          <p class="mt-1 text-sm text-slate-600">innerhalb von 30 Tagen</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">1 von 5</p>
          <p class="mt-1 text-sm text-slate-600">kommen 30+ Tage später</p>
        </div>
      </div>
      <p class="mx-auto mt-6 max-w-3xl text-slate-700 text-center">
        Rund <strong>1 von 5 aller dem Quiz zugeordneten Bestellungen kommt mehr als 30 Tage nach dem Quiz</strong>. Das Quiz ist nicht nur ein Anstoß zum Checkout: jede Antwort ist zero-party data, die den Käufer markiert und segmentierte Follow-up-Flows und Retargeting speist. <a href="https://www.klaviyo.com/marketing-resources/segmentation-benchmark-report" target="_blank" rel="external noopener nofollow" class="font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]">Segmentierte Kampagnen erzielen mehr als das 3-Fache des Umsatzes pro Empfänger</a> gegenüber generischen Aussendungen, sodass ein einzelnes Quiz monatelang über personalisierte E-Mails und Anzeigen weiter konvertiert.
      </p>
    </div>
  </section>

  <!-- Baseline context -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Was als "der durchschnittliche Shop" zählt</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        Es gibt keine einzige wahre Zahl für die Ecommerce-Conversion: sie schwankt mit Methodik und Stichprobe. Die ehrliche Spanne liegt bei rund 1,6% bis 2,9%. Wir benchmarken gegen runde <strong>{HEADLINE.baselinePct}%</strong>, das konservative untere Ende, was Quiz-Teilnehmer bei etwa dem <strong>{HEADLINE.multiple}-Fachen</strong> des durchschnittlichen Shops einordnet.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">Quelle</th>
              <th class="py-3 pr-4 text-right font-semibold">Durchschnittliche Conversion</th>
              <th class="py-3 font-semibold">Umfang</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {baselines.map((b) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">
                  <a href={b.href} target="_blank" rel="external noopener nofollow" class="text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-slate-500">{b.source}</a>
                </td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{b.rate}</td>
                <td class="py-3 text-sm text-slate-600">{b.scope}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        Wichtig: unsere 5,5% sind eine Rate pro Quiz-Teilnehmer (Bestellungen pro abgeschlossenem Quiz), während jede Zahl oben eine seitenweite Rate ist (Bestellungen pro Besucher). Quiz-Teilnehmer sind selbstselektiert, also ist ein Teil der Differenz der Funnel und nicht nur das Quiz. Wir berichten den Vergleich unverblümt, statt ihn aufzuhübschen.
      </p>
    </div>
  </section>

  <!-- Methodology -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Methodik</h2>
      <ul class="mt-8 space-y-5" role="list">
        {METHODOLOGY.map((m) => (
          <li class="flex gap-3">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400" aria-hidden="true"></span>
            <p class="text-slate-700">{m}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Häufig gestellte Fragen</h2>
      <div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
        {FAQ.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-lg font-semibold text-slate-900 [&::-webkit-details-marker]:hidden">
              <span>{f.question}</span>
              <svg
                class="h-5 w-5 flex-shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <p class="pb-5 text-slate-700" set:html={f.answerHtml ?? f.answer} />
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* TODO: restore the entire "Cite this report" section (PDF download +
      shareable stat-card links) once a designer reviews the report + PDF + card
      designs. Removed 2026-06-08 to hold the downloadable assets until review.
      The PDF and card PNGs are still generated by `bun run report`. */}

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Miss die Steigerung in deinem eigenen Shop.
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-white/70">
        RevenueHunt ist kostenlos zum Starten, mit 100 Quiz-Antworten pro Monat. Erstelle ein Quiz, leite Traffic hindurch und lies deine eigenen Zahlen.
      </p>
      <p class="mx-auto mt-4 max-w-2xl text-white/60">
        Sieh dir mit unserem <a href={localizedHref("/quiz-roi-calculator/", "de")} class="font-medium text-white underline decoration-white/40 underline-offset-2 hover:decoration-white">Quiz-ROI-Rechner</a> an, was diese Benchmarks deinem Shop bringen könnten.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SHOPIFY_INSTALL}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          kostenlos auf Shopify starten
        </a>
        <a
          href={WOO_PLUGIN}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          kostenlos auf WooCommerce starten
        </a>
      </div>
    </div>
  </section>
</Base>
