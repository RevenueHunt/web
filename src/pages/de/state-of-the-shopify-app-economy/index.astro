---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb, article, faqPage } from "../../../lib/schema";
import { SITE } from "../../../lib/site";
import { localizedHref } from "../../../lib/i18n";
import {
  REPORT,
  SOURCE,
  HEADLINE,
  GROWTH,
  REVIEWS,
  REVENUE,
  PRICING,
  GEOGRAPHY,
  QUIZ_LANE,
} from "../../../lib/app-economy";

const pageUrl = new URL(`/de/${REPORT.slug}/`, SITE.site_url).href;
const ogImage = `/og/${REPORT.slug}.png`;

const publishedLabel = new Date(REPORT.datePublished).toLocaleDateString("de-DE", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const title = "Der Stand der Shopify-App-Ökonomie";
const description =
  "Es gibt 22.546 aktive Apps im Shopify App Store, und fast keine davon kommt irgendwohin. Ein Datenreport über Wachstum, Bewertungen, Umsatzkonzentration, Preise und wer sie baut, auf Basis einer Momentaufnahme jeder aktiven App.";

// Methodik + FAQ, übersetzt. Die einleitende Aussage jeder Methodik-Notiz ist
// inline fett (die englische Quelle hat sie per String-Ersetzung fett gesetzt,
// was übersetzten Text nicht treffen kann). Vor jsonLd definiert, damit
// faqPage(FAQ) sie nutzen kann.
const METHODOLOGY = [
  "<strong>Quelle:</strong> eine Momentaufnahme des öffentlichen Shopify App Store, 22.546 aktive App-Einträge, aufgenommen im Juni 2026. Jedes Feld stammt aus dem öffentlichen Eintrag, nicht aus den internen Daten von Shopify oder dem Konto eines Händlers.",
  "<strong>Der Umsatz ist geschätzt, nicht gemessen.</strong> Er wird aus den veröffentlichten Preisstufen jeder App zusammen mit Bewertungs- und Installationssignalen modelliert. Behandle die Umsatzzahlen als richtungsweisendes Modell dafür, wie konzentriert die Erträge sind, nicht als Abrechnungsdaten. Sie sind überall, wo sie auftauchen, als \"geschätzt\" gekennzeichnet.",
  "<strong>Das Wachstum nutzt das veröffentlichte Launch-Datum jedes Eintrags.</strong> Die Quelle hat rund 2.800 Launch-Daten im Mai 2026 gebündelt, also wird die Kurve als kumulierte aktive Apps pro Jahr gelesen (der Endpunkt ist die tatsächliche aktuelle Gesamtzahl), und die Zahl \"über 6.000 in den letzten 12 Monaten\" bereinigt diesen Einzelmonats-Artefakt.",
  "<strong>Bewertungen sind ein Indikator für Traktion</strong>, kein perfekter: eine großartige App kann neu sein, und Bewertungszahlen hinken der echten Nutzung hinterher. Wir nutzen sie, weil sie das klarste öffentliche, vergleichbare Signal für eine echte Händlerbasis über 22.546 Apps hinweg sind.",
  "Kategorien im App Store sind Feature-Tags, die eine App sich selbst zuweisen kann, und viele Apps tragen mehrere oder keine, daher berichten wir die eindeutigen Auswertungen (Bewertungen, Preise, Launch-Datum, Entwicklerland) und vermeiden eine Überinterpretation der Tag-Taxonomie.",
];

const FAQ = [
  {
    question: "Wie viele Apps gibt es im Shopify App Store?",
    answer:
      "22.546 aktive Apps in dieser Momentaufnahme vom Juni 2026. Der Store ist seit 2020 etwa um das Zehnfache gewachsen und hat allein in den letzten 12 Monaten über 6.000 Apps hinzugewonnen, rund 1 von 4 von allem, was heute aktiv ist. KI-gestützte Entwicklung hat aus dem, was früher ein halbjähriges Projekt war, ein Wochenende gemacht.",
  },
  {
    question: "Warum scheitern die meisten Shopify-Apps?",
    answer:
      "Das Bauen ist nicht mehr der Engpass, also wird der Store mit Apps überschwemmt, die nie eine Händlerbasis finden. 51 % haben keine einzige Bewertung und 81 % haben weniger als 10. Das Knappe ist Distribution und Vertrauen: Support beantworten, Bewertungen Händler für Händler verdienen, jahrelang präsent sein. Genau das ist der Teil, den KI dir nicht abnehmen kann.",
  },
  {
    question: "Wie viel verdienen Shopify-Apps?",
    answer:
      "Die Erträge sind extrem konzentriert. Nach unserer Schätzung holt sich das oberste 1 % der Apps (225 davon) rund 72 % des gesamten App-Umsatzes, und allein die ersten 10 holen sich fast ein Drittel. Nur etwa 36 % der Apps scheinen überhaupt etwas zu verdienen. Der Umsatz ist hier aus öffentlichen Preisen und Nutzungssignalen geschätzt, nicht aus Abrechnungsdaten.",
  },
  {
    question: "Sind die meisten Shopify-Apps kostenlos?",
    answer:
      "Faktisch ja. 46,9 % sind kostenlos und weitere 48,6 % starten mit einer kostenlosen Testphase; nur 4,5 % verlangen Geld im Voraus. Fast 45 % bieten einen dauerhaft kostenlosen Plan. Im Shopify App Store ist ein kostenloser Einstieg keine Wachstumstaktik, er ist die Grunderwartung.",
  },
  {
    question: "Wo kann ich die zugrunde liegenden Daten sehen?",
    answer:
      "Dieser Report ist der Voll-Daten-Begleiter zu unserer LinkedIn-Feldnotiz über die App-Ökonomie. Die Zahlen stammen aus einer Momentaufnahme, die wir von jeder aktiven Shopify-App pflegen: Launch-Daten, Bewertungen, Preise, das Built-for-Shopify-Abzeichen und Entwicklerland. Wenn du auf Shopify baust und eine bestimmte Auswertung möchtest, nimm Kontakt auf.",
    answerHtml:
      "Dieser Report ist der Voll-Daten-Begleiter zu unserer LinkedIn-Feldnotiz über die App-Ökonomie. Die Zahlen stammen aus einer Momentaufnahme, die wir von jeder aktiven Shopify-App pflegen: Launch-Daten, Bewertungen, Preise, das Built-for-Shopify-Abzeichen und Entwicklerland. Wenn du auf Shopify baust und eine bestimmte Auswertung möchtest, <a href=\"/de/contact/\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">nimm Kontakt auf</a>.",
  },
];

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Startseite", url: localizedHref("/", "de") },
    { name: title, url: localizedHref(`/${REPORT.slug}/`, "de") },
  ]),
  article({
    title,
    description,
    url: pageUrl,
    image: ogImage,
    datePublished: REPORT.datePublished,
    dateModified: REPORT.dateModified,
    author: "RevenueHunt",
    tags: [
      "Shopify app store",
      "Shopify-App-Entwickler",
      "App-Store-Statistiken",
      "App-Ökonomie",
    ],
  }),
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "Der Stand der Shopify-App-Ökonomie 2026",
    description,
    url: pageUrl,
    creator: organization(),
    license: "https://creativecommons.org/licenses/by/4.0/",
    isAccessibleForFree: true,
    datePublished: REPORT.datePublished,
    keywords: [
      "Shopify app store",
      "App-Entwickler",
      "App-Umsatz",
      "App-Bewertungen",
      "ecommerce",
    ],
  },
  faqPage(FAQ),
];

// Section eyebrows for the editorial "field notes" feel.
const E = (n: string, label: string) => `${n} · ${label}`;

// Translated headline cards. Stats stay from the shared data module (HEADLINE[i].stat).
const headlineT = [
  { label: "aktive Apps im Store", note: "Etwa verzehnfacht seit 2020." },
  { label: "haben keine einzige Bewertung", note: "Vier von fünf haben weniger als 10." },
  { label: "des Umsatzes geht an das oberste 1 %", note: "225 Apps. Geschätzt." },
  { label: "verlangen Geld im Voraus", note: "Nur 1 von 20. Fast die Hälfte ist kostenlos." },
];

// Growth caption with the lead phrase bolded.
const growthCaptionHtml =
  "Aktive Apps kumuliert nach Launch-Jahr. <strong>Der Shopify App Store hat sich seit 2020 etwa verzehnfacht</strong> und allein in den letzten 12 Monaten über 6.000 Apps hinzugewonnen, rund 1 von 4 von allem, was heute aktiv ist.";

// Quiz-lane paragraphs (translated), with the live search link and the load-bearing
// lines bolded inline. Caption text mirrors the English source's meaning.
const quizParas = [
  `Unsere eigene Kategorie zeigt dasselbe. <a href="${QUIZ_LANE.searchUrl}" target="_blank" rel="external noopener nofollow" class="font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]">die Quiz-Suche von Shopify</a> liefert 149 Apps, aber hier sammelt sich das Vertrauen an der Spitze genau wie im gesamten Store. Die drei Apps, die zuerst da waren und nie wieder gingen, RevenueHunt, Octane AI und Quiz Kit, vereinen 45 % aller Bewertungen der Kategorie auf sich; <strong>RevenueHunt allein hält rund ein Viertel</strong>, und die untere Hälfte hat keine einzige.`,
  `Wir kamen nicht über den Code an die Spitze. <strong>Bewertungen sind das Residuum des operativen Narbengewebes</strong> dahinter: sechs Jahre Support beantworten, mit Händlern telefonieren, die nie zahlen würden, und Vertrauen Shop für Shop verdienen. Octane AI und Quiz Kit haben dieselbe harte Arbeit über Jahre geleistet, <strong>und dafür respektieren wir sie</strong>. Ehrenvolle Erwähnung für Lantern und Quizell, beide mit etwas über 120 Bewertungen.`,
];

// Methodology bullets carry their own inline <strong>; render as-is.
const methodologyHtml = METHODOLOGY;
---

<Base
  title={`${title} - Datenreport 2026`}
  description={description}
  ogImage={ogImage}
  jsonLd={jsonLd}
  lang="de"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={localizedHref("/", "de")} class="hover:text-slate-700">Startseite</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Der Stand der Shopify-App-Ökonomie</span>
      </nav>
      <div class="text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">
          Feldnotizen · {publishedLabel}
        </p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          Der Stand der Shopify-App-Ökonomie
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          <strong>Es gibt 22.546 aktive Apps im Shopify App Store, und fast keine davon kommt irgendwohin.</strong> Wir haben eine Momentaufnahme jeder aktiven App gemacht und dann die Daten zu Wachstum, Bewertungen, Umsatz, Preisen und dazu, wer sie baut, gelesen. Sie erzählen eine einzige Geschichte: Die App zu bauen war nie der schwierige Teil.
        </p>
      </div>
    </div>
  </section>

  <!-- Source band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-2xl bg-[#16161D] px-6 py-10 sm:px-10">
        <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#4dcaff]">
          Die Momentaufnahme
        </p>
        <dl class="mt-6 grid grid-cols-2 gap-8 text-center sm:grid-cols-4">
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.apps}</dt>
            <dd class="mt-1 text-sm text-white/70">aktive Apps in der Momentaufnahme</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.countries}</dt>
            <dd class="mt-1 text-sm text-white/70">Länder, die sie bauen</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.reviewless}</dt>
            <dd class="mt-1 text-sm text-white/70">ohne eine einzige Bewertung</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.free}</dt>
            <dd class="mt-1 text-sm text-white/70">komplett kostenlos, ohne bezahlten Plan</dd>
          </div>
        </dl>
        <p class="mx-auto mt-6 max-w-3xl text-center text-sm text-white/60">
          Jede Zahl unten stammt aus dem öffentlichen App-Store-Eintrag aller 22.546 aktiven Apps, Juni 2026. Der Umsatz wird aus veröffentlichten Preisen und Nutzungssignalen geschätzt, nicht aus Abrechnungsdaten, und ist im gesamten Report als solcher gekennzeichnet.
        </p>
      </div>
    </div>
  </section>

  <!-- Headline cards -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Die wichtigsten Zahlen</h2>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        {HEADLINE.map((c, i) => (
          <div class="rounded-xl border border-slate-200 p-7">
            <p class="text-4xl font-bold tracking-tight text-[#16161D]">{c.stat}</p>
            <p class="mt-2 font-medium text-slate-900">{headlineT[i].label}</p>
            <p class="mt-2 text-sm text-slate-600">{headlineT[i].note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 01 Growth -->
  <section class="scroll-mt-20 bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("01", "Wachstum")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Verzehnfacht seit 2020</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center" set:html={growthCaptionHtml} />
      <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
        <div class="h-72 sm:h-80"><canvas id="c-growth" aria-label="Kumulierte aktive Shopify-Apps nach Jahr" role="img"></canvas></div>
      </div>
    </div>
  </section>

  <!-- 02 Traction -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("02", "Traktion")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Die meisten Apps bekommen nie eine Bewertung</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">Die Hälfte des Shopify App Store hat nie eine einzige Bewertung verdient. Vier von fünf Apps haben weniger als 10. Eine Bewertung ist der klarste öffentliche Indikator für einen echten, gehaltenen Händler, und die meisten Apps bekommen nie eine.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-center text-sm font-semibold text-slate-700">Apps nach Bewertungsanzahl</p>
          <div class="h-72 sm:h-80"><canvas id="c-reviews" aria-label="Bewertungsverteilung über alle aktiven Apps" role="img"></canvas></div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">81%</p>
            <p class="mt-1 text-slate-700">haben weniger als 10 Bewertungen</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="font-bold text-[#16161D]"><span class="text-3xl">{REVIEWS.medianReviews}</span> <span class="text-sm font-medium text-slate-500">Bewertungen</span></p>
            <p class="mt-1 text-slate-700">im Median, über die Apps, die eine haben</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="font-bold text-[#16161D]"><span class="text-amber-400">★</span> <span class="text-3xl">{REVIEWS.avgRating}</span> <span class="text-sm font-medium text-slate-500">Sterne</span></p>
            <p class="mt-1 text-slate-700">durchschnittliche Bewertung, über die {REVIEWS.ratedCount} Apps, die eine haben</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 Revenue -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("03", "Umsatz · geschätzt")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Das Geld sammelt sich ganz oben</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">Die geschätzten monatlichen Umsätze sind brutal an der Spitze konzentriert. Das oberste 1 % der Apps (225 davon) holt sich geschätzte 72 %; allein die ersten 10 holen sich fast ein Drittel. Nur etwa 36 % der Apps scheinen überhaupt etwas zu verdienen. Er ballt sich auch geografisch: allein die USA und Kanada holen sich geschätzte 57 %.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-sm font-medium text-slate-500">Umsatzverteilung</p>
          <div class="h-64 sm:h-72"><canvas id="c-revenue-donut" aria-label="Anteil des geschätzten Umsatzes, der auf das oberste 1 % der Apps entfällt" role="img"></canvas></div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-sm font-medium text-slate-500">Geschätzter Umsatz nach Land</p>
          <div class="h-64 sm:h-72"><canvas id="c-revenue-countries" aria-label="Geschätzter Umsatz nach Land" role="img"></canvas></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 Pricing -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("04", "Preise")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Fast niemand verlangt Geld im Voraus</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">Fast die Hälfte des Stores verlangt nichts im Voraus, und weniger als 1 von 20 Apps verlangt Geld vor der ersten Installation. Fast 45 % bieten einen dauerhaft kostenlosen Plan. Freemium ist hier keine Strategie, es ist das Minimum, um überhaupt mitzuspielen.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <div class="h-72 sm:h-80"><canvas id="c-pricing" aria-label="Verteilung der Preismodelle über alle aktiven Apps" role="img"></canvas></div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">{PRICING.permanentFree}</p>
            <p class="mt-1 text-slate-700">bieten einen dauerhaft kostenlosen Plan, nicht nur eine Testphase</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">1 von 20</p>
            <p class="mt-1 text-slate-700">Apps verlangen Geld vor der ersten Installation</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 Who builds them -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("05", "Wer sie baut")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Gebaut in 115 Ländern, dominiert von zweien</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">Die Apps kommen aus 115 Ländern, aber zwei dominieren: die USA (16 %) und Indien (9 %) bauen zusammen ein Viertel des Stores. Und nach Jahren, in denen Shopify den Standard vorangetrieben hat, tragen nur 6,7 % der aktiven Apps (rund 1.500) das Built-for-Shopify-Abzeichen.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <div class="h-72 sm:h-80"><canvas id="c-geography" aria-label="Wichtigste Entwicklerländer nach Anzahl der Apps" role="img"></canvas></div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">{GEOGRAPHY.builtForShopify}</p>
            <p class="mt-1 text-slate-700">tragen das Built-for-Shopify-Abzeichen ({GEOGRAPHY.builtForShopifyCount} Apps), Jahre nachdem Shopify begann, den Standard voranzutreiben</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">25%</p>
            <p class="mt-1 text-slate-700">des gesamten Stores werden allein in den USA und Indien gebaut</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 The quiz lane -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("06", "Das Quiz-Segment")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Unsere eigene Kategorie aus der Nähe</h2>
      {quizParas.map((html) => (
        <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center" set:html={html} />
      ))}
      <div class="mx-auto mt-8 grid max-w-3xl grid-cols-3 gap-4 text-center">
        <a
          href="https://apps.shopify.com/product-recommendation-quiz-revenuehunt"
          target="_blank"
          rel="external noopener"
          class="block rounded-xl border border-[#616eff]/60 p-6 shadow-[0_0_28px_-4px_rgba(97,110,255,0.55)] transition hover:border-[#616eff] hover:shadow-[0_0_32px_-2px_rgba(97,110,255,0.7)]"
        >
          <p class="text-sm font-semibold text-slate-900">RevenueHunt</p>
          <p class="mt-1 font-bold text-[#16161D]"><span class="text-3xl">{QUIZ_LANE.revenueHuntReviews}</span> <span class="text-sm font-medium text-slate-500">Bewertungen</span></p>
          <p class="mt-1 text-xs font-semibold text-slate-600"><span class="text-amber-400">★</span> 4,9 Sterne</p>
        </a>
        <div class="rounded-xl border border-slate-200 p-6">
          <p class="text-sm font-medium text-slate-700">Octane AI</p>
          <p class="mt-1 font-bold text-slate-500"><span class="text-3xl">{QUIZ_LANE.octaneReviews}</span> <span class="text-sm font-medium text-slate-500">Bewertungen</span></p>
          <p class="mt-1 text-xs font-semibold text-slate-600"><span class="text-amber-400">★</span> 4,8 Sterne</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-6">
          <p class="text-sm font-medium text-slate-700">Quiz Kit</p>
          <p class="mt-1 font-bold text-slate-500"><span class="text-3xl">{QUIZ_LANE.quizKitReviews}</span> <span class="text-sm font-medium text-slate-500">Bewertungen</span></p>
          <p class="mt-1 text-xs font-semibold text-slate-600"><span class="text-amber-400">★</span> 4,8 Sterne</p>
        </div>
