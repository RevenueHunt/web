---
import Base from "../../../layouts/Base.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import YouTubeFacade from "../../../components/YouTubeFacade.astro";
import { organization, breadcrumb } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Inicio", url: "/" },
    { name: "Contacto", url: "/contact/" },
  ]),
];

const channels = [
  {
    label: "Lee las guías de ayuda",
    href: "https://docs.revenuehunt.com/",
    note: "Documentación de autoservicio, integraciones, resolución de problemas.",
    external: true,
  },
  {
    label: "Soporte y ventas por email",
    href: "mailto:team@revenuehunt.com",
    note: "team@revenuehunt.com - consulta los tiempos de respuesta más abajo.",
  },
  {
    label: "Consulta el estado del sistema",
    href: "https://status.revenuehunt.com/",
    note: "Salud del servicio en tiempo real e historial de incidencias. 99,98%+ de disponibilidad.",
    external: true,
  },
];

const responseTiers = [
  {
    label: "Crítico - producción caída, seguridad, integridad de datos",
    sla: "Primera respuesta en 30 minutos, 24/7 en todo el mundo",
  },
  {
    label: "Alto - función importante afectada, varios usuarios afectados",
    sla: "Primera respuesta en 12 horas",
  },
  {
    label: "Estándar - preguntas, ayuda con la configuración",
    sla: "1 día laborable",
  },
  {
    label: "Baja prioridad - feedback, peticiones de funciones",
    sla: "Hasta 3 días laborables",
  },
];
---

<Base
  title="Contacto - RevenueHunt"
  description="Ponte en contacto con el equipo de soporte de RevenueHunt. Lee las guías de ayuda, mira el tutorial o haz el quiz de soporte para obtener una respuesta personalizada en minutos."
  jsonLd={jsonLd}
  lang="es"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20 text-center">
      <Breadcrumb items={[{ label: "Inicio", href: localizedHref("/", "es") }, { label: "Contacto" }]} />
      <Eyebrow>Escríbenos</Eyebrow>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Ponte en contacto
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600">
        Lee las guías de ayuda, mira el tutorial o haz nuestro quiz de soporte aquí abajo - el equipo de soporte más
        avispado y amable del ecommerce te responderá.
      </p>
    </div>
  </section>

  <!-- Two-column: video + channels -->
  <section class="mx-auto max-w-7xl px-6 py-12">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Empieza por el tutorial</h2>
        <p class="mt-3 text-slate-600">
          La mayoría de las dudas se resuelven en la guía de 3 minutos. Échale un vistazo rápido antes de escribirnos.
        </p>
        <div class="mt-6 aspect-video overflow-hidden rounded-xl bg-slate-900 shadow-xl">
          <YouTubeFacade id="oL1DnBd6N1U" title="Tutorial de soporte de RevenueHunt" />
        </div>
      </div>
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Cómo contactarnos</h2>
        <ul class="mt-6 space-y-3">
          {channels.map((c) => (
            <li>
              <a
                href={c.href}
                target={c.external ? "_blank" : undefined}
                rel={c.external ? "external noopener" : undefined}
                class="group flex items-start justify-between gap-4 rounded-xl border border-slate-200 bg-white p-5 transition hover:border-slate-300 hover:shadow-md"
              >
                <div>
                  <p class="text-base font-semibold text-slate-900 group-hover:text-[#16161D]">{c.label}</p>
                  <p class="mt-1 text-sm text-slate-600">{c.note}</p>
                </div>
                <span class="mt-1 shrink-0 text-slate-400 transition group-hover:text-[#16161D]" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Support quiz -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Haz nuestro quiz de soporte</h2>
      <p class="mx-auto mt-3 max-w-2xl text-slate-600">
        Responde unas preguntas rápidas y te dirigiremos a la ayuda adecuada - documentación, tutorial o una respuesta de una persona real.
      </p>
      <div class="mx-auto mt-8 max-w-4xl overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <iframe
          src="https://admin.revenuehunt.com/public/quiz/ZAHJoMM"
          title="Quiz de soporte de RevenueHunt"
          loading="lazy"
          class="block h-[600px] w-full"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Response times — moved here from the right column so it sits under
       the quiz, since that's where visitors land after asking for help. -->
  <section class="mx-auto max-w-4xl px-6 py-16">
    <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm sm:p-10">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Tiempos de respuesta</h2>
      <p class="mt-3 text-slate-600">
        SLA de soporte por niveles para todos los comerciantes, con prioridad para cuentas de Shopify Plus y enterprise.
      </p>
      <dl class="mt-6 grid gap-4 sm:grid-cols-2">
        {responseTiers.map((t) => (
          <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
            <dt class="text-sm font-semibold text-slate-900">{t.label}</dt>
            <dd class="mt-1 text-sm text-slate-600">{t.sla}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Base>
