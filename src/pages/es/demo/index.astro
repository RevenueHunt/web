---
import Base from "../../../layouts/Base.astro";
import PageHero from "../../../components/PageHero.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import { organization, breadcrumb } from "../../../lib/schema";
import { SITE } from "../../../lib/site";
import { localizedHref } from "../../../lib/i18n";

const QUIZ_URL = "https://admin.revenuehunt.com/public/quiz/8qHyAD6";

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Inicio", url: "/" },
    { name: "Reservar una demo", url: "/demo/" },
  ]),
];
---

<Base
  title="Reservar una demo - RevenueHunt"
  description="Mira RevenueHunt en acción. Reserva una llamada de 30 minutos con nuestro equipo para recorrer el producto, hacer preguntas y planificar tu embudo de quiz."
  jsonLd={jsonLd}
  lang="es"
  translated={true}
>
  <PageHero>
      <Breadcrumb items={[{ label: "Inicio", href: localizedHref("/", "es") }, { label: "Reservar una demo" }]} />
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          <Eyebrow>Míralo en acción</Eyebrow>
          <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
            Reserva una demo con nuestro equipo
          </h1>
          <p class="mt-6 text-lg text-slate-700">
            La mayoría de los compradores se van porque no encuentran el producto adecuado. Te mostraremos cómo lo soluciona un Quiz de recomendación de productos - en directo sobre una tienda Shopify real, con tus preguntas en primer plano.
          </p>
          <ul class="mt-8 space-y-3 text-slate-700">
            <li class="flex gap-3">
              <svg class="mt-1 h-5 w-5 flex-shrink-0 text-emerald-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7 7a1 1 0 01-1.4 0l-4-4a1 1 0 011.4-1.4l3.3 3.3 6.3-6.3a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>
              Recorrido de 30 minutos por el constructor de quiz, la página de resultados y las integraciones
            </li>
            <li class="flex gap-3">
              <svg class="mt-1 h-5 w-5 flex-shrink-0 text-emerald-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7 7a1 1 0 01-1.4 0l-4-4a1 1 0 011.4-1.4l3.3 3.3 6.3-6.3a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>
              Adaptado al tamaño de tu catálogo, tu fuente de tráfico y tus objetivos de segmentación
            </li>
            <li class="flex gap-3">
              <svg class="mt-1 h-5 w-5 flex-shrink-0 text-emerald-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7 7a1 1 0 01-1.4 0l-4-4a1 1 0 011.4-1.4l3.3 3.3 6.3-6.3a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>
              Sin presión para comprometerte - te mostramos lo que es posible y luego la decisión es tuya
            </li>
          </ul>
          <div class="mt-10 flex flex-wrap gap-3">
            <a
              href="https://docs.revenuehunt.com/"
              target="_blank"
              rel="external noopener"
              class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
            >
              Explorar el centro de ayuda ↗
            </a>
          </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-1 shadow-lg">
          <iframe
            src={QUIZ_URL}
            title="Reserva una demo con RevenueHunt"
            loading="lazy"
            class="h-[600px] w-full rounded-xl"
          ></iframe>
        </div>
      </div>
  </PageHero>

  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        ¿Prefieres explorarlo por tu cuenta? Empieza gratis.
      </h2>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SITE.signup_url}
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          Regístrate
        </a>
      </div>
    </div>
  </section>
</Base>
