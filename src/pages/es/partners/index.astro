---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

interface Partner {
  name: string;
  url: string;
  logo: string;
  description: string;
}

const groups: { heading: string; emoji: string; intro: string; items: Partner[] }[] = [
  {
    heading: "Apps de Shopify",
    emoji: "🧩",
    intro: "Apps de Shopify que combinan a la perfección con RevenueHunt para hacer crecer tu tienda.",
    items: [
      { name: "Orbe Shopify Geolocation", url: "https://orbe.app/", logo: "/img/pages/partners/orbe-removebg-preview.webp", description: "Maximiza las ventas globales con geolocalización avanzada de Shopify. Personaliza productos, precios, divisa y contenido para cada país y guía a los clientes hacia la experiencia de compra adecuada con Orbe." },
      { name: "WC Wishlist Club", url: "https://apps.shopify.com/wishlist-club?utm_source=revenuehunt&utm_medium=website&utm_campaign=partnership", logo: "/img/pages/partners/wishlist-club-150-150-px-logo.webp", description: "WC Wishlist Club permite a tus clientes guardar sus productos favoritos, compartir listas de deseos y comprar más tarde, aumentando la interacción y las ventas. Fácil de configurar, optimizado para móvil y perfecto para convertir a los que solo miran en compradores fieles." },
      { name: "Langwill: Language Translate", url: "https://apps.shopify.com/localiser", logo: "/img/pages/partners/1.webp", description: "Amplía tu alcance global con Langwill: traduce tu tienda de Shopify a 138 idiomas y convierte divisas automáticamente para una experiencia de compra fluida y localizada." },
      { name: "Customer Dashboard Pro", url: "https://apps.shopify.com/customer-dashboard-pro?utm_source=revenuehunt", logo: "/img/pages/partners/CustomerDashboard.webp", description: "Customer Dashboard Pro es la única app que ofrece soporte fluido tanto para las nuevas Customer Accounts de Shopify como para las Classic Customer Accounts." },
      { name: "ToastiBar – Sales Popup", url: "https://makeprosimp.com/partnership/revenuehunt", logo: "/img/pages/partners/toastibarlogo_fgaiv9.webp", description: "Aumenta la confianza de los clientes e impulsa las ventas mostrando prueba social en tiempo real: ventas, carrito, visitantes, reseñas de productos y alertas de inventario." },
      { name: "UpPromote: Affiliate & Referral", url: "https://partners.secomapp.com/apps/affiliate/SHOPQUIZ_APP", logo: "/img/pages/partners/NEW_logo-1.webp", description: "UpPromote es la app de afiliación/referidos más recomendada de la Shopify App Store. Solución integral para crear y gestionar tus campañas de marketing, adecuada para negocios de cualquier tamaño." },
      { name: "Essential Free Shipping Bar", url: "https://apps.shopify.com/essential-order-value-booster", logo: "/img/pages/partners/freeshippingbarlogo.webp", description: "Aumenta las ventas y el AOV configurando barras de envío gratis ilimitadas con múltiples objetivos de valor de carrito para motivar a los compradores a añadir más productos." },
      { name: "iCart Cart Drawer Cart Upsell", url: "https://apps.shopify.com/icart/?campaign=promotion&medium=in-app-banner&source=revenuehunt", logo: "/img/pages/partners/iCart-Cart-Drawer-Cart-Upsell-logo.webp", description: "App integral de Shopify para personalizar un cart drawer y la página completa del carrito con upsell, recomendaciones de productos, barra de progreso, bundles de productos y descuentos." },
      { name: "Kaching Bundle Quantity Deals", url: "https://apps.shopify.com/bundle-deals?utm_source=partnership&utm_medium=web&utm_campaign=REVENUEH", logo: "/img/pages/partners/Kaching-Logo-1024x1024.webp", description: "Impulsa las ventas con Kaching Bundle Quantity Deals: crea ofertas de bundles directamente en la página de tu producto. Usa el código REVENUEH20 para un descuento exclusivo del 20%." },
      { name: "PDF Invoice Generator", url: "https://apps.shopify.com/fordeer-invoice-order-printer?utm_source=ShopQuizProductRecommender&utm_medium=comarketing&utm_campaign=partner", logo: "/img/pages/partners/fordeer-data-export-1024x1024.webp", description: "El generador de facturas de Shopify de Fordeer es flexible, cumple con la normativa global y atiende a B2C, B2B y mayoristas. Plantillas PDF personalizables, impresión por lotes y soporte por chat en vivo 24/7." },
      { name: "AI SEO Optimizer", url: "https://share.seoant.com/app/1165b75b7ce1524D5J", logo: "/img/pages/partners/SEOAnt-_-AI-SEO-Optimizer_Channelwill-.webp", description: "La mejor app de SEO para Shopify: optimiza keywords, mejora las meta tags y perfecciona la estructura del sitio. Análisis de rendimiento y velocidad de SEO impulsados por AI." },
      { name: "BSS: B2B/Wholesale Solution", url: "https://apps.shopify.com/b2b-solution-custom-pricing?utm_source=RevenueHunt&utm_medium=partner-listing&utm_campaign=partnership-2024", logo: "/img/pages/partners/BSS-Commerce_logo_150.webp", description: "Solución mayorista integral. Una experiencia de compra B2B fluida que además ayuda a los comerciantes a gestionar a sus clientes mayoristas y obtener insights sobre ellos." },
      { name: "PreOrder Now WOD", url: "https://apps.shopify.com/preorder-now?utm_source=+revenuehunt&utm_medium=web&utm_campaign=partner&utm_id=crosspromo", logo: "/img/pages/partners/PreOrder-Now-Logo.webp", description: "Convierte las situaciones de falta de stock en oportunidades de pre-pedido. Perfecto para negocios de print-on-demand: capta el interés del cliente sin stock inicial." },
    ],
  },
  {
    heading: "Logística y aprovisionamiento",
    emoji: "📦",
    intro: "Socios de aprovisionamiento, fulfillment y logística para enviar más rápido y escalar globalmente.",
    items: [
      { name: "Fulfillman", url: "https://www.fulfillman.com/", logo: "/img/pages/partners/fulfillmanlogo.webp", description: "Fulfillman es un líder global en sourcing, fulfillment y logística para ecommerce, que ofrece envíos rápidos y fiables a través de servicios dedicados de línea privada." },
      { name: "HyperSKU", url: "https://www.hypersku.com/", logo: "/img/pages/partners/150150-logo.webp", description: "HyperSKU ofrece una solución integral de cadena de suministro. Más de 1M de productos, venta de bundles, muestreo, inspección de calidad, personalización de marca y fulfillment automatizado de pedidos." },
      { name: "Service Points", url: "https://www.servicepoints.eu/en/w2/smart-dropshipping-1?utm_source=revenuehunt&utm_medium=app&utm_id=31", logo: "/img/pages/partners/Logo-Black-background.webp", description: "Service Points presenta SMART Dropshipping: dropshipping automatizado y decisiones de cadena de suministro basadas en datos para escalar de forma infinita." },
    ],
  },
  {
    heading: "Temas y diseño",
    emoji: "🎨",
    intro: "Temas premium y diseño para que tu tienda luzca espectacular.",
    items: [
      { name: "SalesHunterThemes", url: "https://saleshunterthemes.com/?utm_source=app-providers&utm_medium=revenuehunt&utm_campaign=partnership-app&utm_content=website", logo: "/img/pages/partners/saleshunterthemes-logo.webp", description: "Impulsa tu tienda con los themes premium de Shopify de SalesHunterThemes. Diseños modernos y responsive que optimizan el rendimiento y la experiencia de usuario, con amplias opciones de personalización." },
    ],
  },
  {
    heading: "Plataformas y directorios",
    emoji: "🧭",
    intro: "Plataformas y directorios que ayudan a los comerciantes a descubrir las herramientas adecuadas.",
    items: [
      { name: "Taranker", url: "https://taranker.com/", logo: "/img/pages/partners/Icon512.webp", description: "Taranker es una plataforma innovadora dedicada a ayudar a los negocios de ecommerce a encontrar las mejores herramientas para optimizar sus operaciones. Especializada en recomendaciones de apps, reseñas de expertos y selecciones de apps curadas." },
    ],
  },
];

const perks = [
  { title: "Comisiones por referidos", body: "Capta nuevos clientes para RevenueHunt y cobra una comisión vitalicia del 20% de todos los ingresos que generen." },
  { title: "Enlaces de afiliado", body: "Añade tus enlaces de afiliado en tus artículos, newsletters y publicaciones en redes sociales. Enlaza directamente a nuestras apps de Shopify, WooCommerce, BigCommerce, Magento y standalone." },
  { title: "Tu propio partner manager", body: "Recibe consejos sobre cómo crear embudos de venta automatizados con nuestra herramienta y trucos para vender nuestra solución a tus clientes." },
  { title: "Contenido exclusivo", body: "Contáctanos para recibir consejos sobre cómo crear embudos de venta automatizados para tus clientes usando RevenueHunt y otras herramientas." },
  { title: "Un lugar en nuestro Partner Directory", body: "Nuestros usuarios te encontrarán en nuestro Partner Directory y se pondrán en contacto contigo para contratar tus servicios." },
];

const faqs = [
  { q: "¿Cuánto cuesta convertirse en partner?", a: "Registrarse es completamente gratis. Cero. Nada." },
  { q: "¿Tengo que ser cliente de RevenueHunt?", a: "No, no tienes que ser cliente de RevenueHunt para convertirte en partner." },
  { q: "¿Cómo me pagarán?", a: "Pagamos las ganancias mensualmente. Los pagos se envían vía PayPal." },
  { q: "¿Cómo puedo hacer seguimiento de mis referidos?", a: "Puedes ver tus estadísticas en tu Partner Dashboard." },
];

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Inicio", url: "/" },
    { name: "Partners y afiliados", url: "/partners/" },
  ]),
];
---

<Base
  title="Programa de partners - RevenueHunt"
  description="Recomienda a tus clientes. Gana dinero. Obtén una comisión vitalicia del 20% de los clientes que recomiendes a RevenueHunt. Regístrate gratis en nuestro Programa de Partners."
  jsonLd={jsonLd}
  lang="es"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20 text-center">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={localizedHref("/", "es")} class="hover:text-slate-700">Inicio</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Partners y afiliados</span>
      </nav>
      <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">Programa de partners</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Recomienda a tus clientes. Gana dinero.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-xl text-slate-600">
        Gana una comisión vitalicia del 20% de los clientes que nos recomiendes. Regístrate hoy gratis en nuestro Programa de Partners.
      </p>
      <p class="mx-auto mt-6 max-w-3xl text-slate-600">
        Si eres una <strong class="font-semibold text-slate-900">agencia de marketing digital</strong> o un
        <strong class="font-semibold text-slate-900">especialista en ecommerce</strong> y quieres hacer crecer tu negocio,
        nuestro Programa de Partners es para ti. Crea experiencias increíbles para tus clientes con RevenueHunt.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
        >
          Empieza ahora
        </a>
        <a
          href="#partners"
          class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
        >
          Ver nuestros partners
        </a>
      </div>
    </div>
  </section>

  <!-- Who you are + perks -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-1">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Quién eres</h2>
        <p class="mt-4 text-slate-600">
          Eres una agencia de marketing digital o un consultor de ecommerce apasionado por el diseño y obsesionado con
          <strong class="font-semibold text-slate-900">conseguir los mejores resultados</strong> para tus clientes. Haces crecer
          tu negocio impulsando el de otros.
        </p>
      </div>
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Qué obtienes de nosotros</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {perks.map((p) => (
            <li class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="text-base font-semibold text-slate-900">{p.title}</h3>
              <p class="mt-2 text-sm text-slate-600">{p.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Partner directory -->
  <section id="partners" class="mx-auto max-w-7xl px-6 py-16 scroll-mt-24">
    <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Nuestros partners</h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
      Apps y agencias de confianza que combinan a la perfección con RevenueHunt para tus clientes.
    </p>
    <div class="mt-12 space-y-16">
      {groups.map((g) => (
        <div>
          <div class="mb-2 flex items-baseline gap-3">
            <span class="text-2xl" aria-hidden="true">{g.emoji}</span>
            <h3 class="text-2xl font-semibold tracking-tight text-slate-900">{g.heading}</h3>
          </div>
          <p class="max-w-3xl text-slate-600">{g.intro}</p>
          <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {g.items.map((p) => (
        <li>
          <a
            href={p.url}
            target="_blank"
            rel="external noopener nofollow"
            class="group flex h-full flex-col items-center rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm transition hover:border-slate-300 hover:shadow-md"
          >
            <img
              src={p.logo}
              alt={`Logo de ${p.name}`}
              loading="lazy"
              width="120"
              height="120"
              class="h-24 w-24 rounded-full object-cover"
            />
            <h3 class="mt-5 text-lg font-semibold text-slate-900 group-hover:text-[#16161D]">{p.name}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{p.description}</p>
            <span class="mt-5 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wider text-slate-500 group-hover:text-[#16161D]">
              Visitar sitio <span aria-hidden="true">↗</span>
            </span>
          </a>
        </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Preguntas frecuentes</h2>
      <div class="mx-auto mt-8 max-w-2xl">
        {faqs.map((f) => (
          <details class="border-b border-slate-200">
            <summary class="py-4 text-base font-semibold text-slate-900">{f.q}</summary>
            <p class="pb-4 text-slate-600">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Conviértete en partner de RevenueHunt
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        Recomienda a tus clientes, crea embudos de venta automatizados y gana una comisión vitalicia del 20% de todo lo que gasten.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          Empieza ahora
        </a>
        <a
          href={localizedHref("/demo/", "es")}
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          Reserva una demo
        </a>
      </div>
    </div>
  </section>
</Base>
