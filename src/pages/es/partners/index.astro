---
import Base from "../../../layouts/Base.astro";
import PageHero from "../../../components/PageHero.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import PartnerCard from "../../../components/PartnerCard.astro";
import { organization, breadcrumb } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

interface Partner {
  name: string;
  url: string;
  logo: string;
  description: string;
}

const groups: { heading: string; emoji: string; intro: string; items: Partner[] }[] = [
  {
    heading: "Localización",
    emoji: "🌍",
    intro: "Vende a nivel internacional con geolocalización, traducción y multidivisa integradas.",
    items: [
      { name: "Orbe Shopify Geolocation", url: "https://apps.shopify.com/orbe?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/orbe-removebg-preview.webp", description: "Maximiza las ventas globales con geolocalización avanzada de Shopify. Personaliza productos, precios, divisa y contenido para cada país y guía a los clientes hacia la experiencia de compra adecuada con Orbe." },
      { name: "Langwill: Language Translate", url: "https://apps.shopify.com/localiser?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/1.webp", description: "Amplía tu alcance global con Langwill: traduce tu tienda de Shopify a 138 idiomas y convierte divisas automáticamente para una experiencia de compra fluida y localizada." },
    ],
  },
  {
    heading: "Chat y soporte",
    emoji: "💬",
    intro: "Herramientas de cuenta de cliente que hacen el autoservicio y el soporte muy fáciles.",
    items: [
      { name: "Dondy WhatsApp Marketing & Chat", url: "https://apps.shopify.com/dondy-marketing-ai?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/dondy-logo.webp", description: "Convierte el tráfico perdido en ingresos con flujos automatizados de WhatsApp para recuperación, confirmación y retención, además de un agente de IA que gestiona la atención al cliente para que tu equipo no tenga que hacerlo." },
      { name: "Customer Dashboard Pro", url: "https://apps.shopify.com/customer-dashboard-pro?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/CustomerDashboard.webp", description: "Customer Dashboard Pro es la única app que ofrece soporte fluido tanto para las nuevas Customer Accounts de Shopify como para las Classic Customer Accounts." },
    ],
  },
  {
    heading: "Upsell y recomendaciones",
    emoji: "🎯",
    intro: "Aumenta el valor medio del pedido con upsells en el carrito, listas de deseos y pre-pedidos.",
    items: [
      { name: "WC Wishlist Club", url: "https://apps.shopify.com/wishlist-club?utm_source=RevenueHunt&utm_medium=partnership&utm_campaign=partnership", logo: "/img/pages/partners/wishlist-club-150-150-px-logo.webp", description: "WC Wishlist Club permite a tus clientes guardar sus productos favoritos, compartir listas de deseos y comprar más tarde, aumentando la interacción y las ventas. Fácil de configurar, optimizado para móvil y perfecto para convertir a los que solo miran en compradores fieles." },
      { name: "iCart Cart Drawer Cart Upsell", url: "https://apps.shopify.com/icart/?campaign=promotion&medium=in-app-banner&source=revenuehunt&utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/iCart-Cart-Drawer-Cart-Upsell-logo.webp", description: "App integral de Shopify para personalizar un cart drawer y la página completa del carrito con upsell, recomendaciones de productos, barra de progreso, bundles de productos y descuentos." },
      { name: "PreOrder Now WOD", url: "https://apps.shopify.com/preorder-now?utm_source=RevenueHunt&utm_medium=partnership&utm_campaign=partner&utm_id=crosspromo", logo: "/img/pages/partners/PreOrder-Now-Logo.webp", description: "Convierte las situaciones de falta de stock en oportunidades de pre-pedido. Perfecto para negocios de print-on-demand: capta el interés del cliente sin stock inicial." },
      { name: "Smart Size Chart & Fit Finder", url: "https://apps.shopify.com/smartsize?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/smartsize-logo.webp", description: "Crea tablas de tallas, guías de tallas y cuestionarios 'cuál es mi talla' con IA en minutos: reduce las dudas sobre tallas y las devoluciones mientras aumentas la conversión." },
    ],
  },
  {
    heading: "Precios y descuentos",
    emoji: "🏷️",
    intro: "Packs, descuentos por volumen y precios B2B que premian carritos más grandes.",
    items: [
      { name: "Kaching Bundle Quantity Deals", url: "https://apps.shopify.com/bundle-deals?utm_source=RevenueHunt&utm_medium=partnership&utm_campaign=REVENUEH", logo: "/img/pages/partners/Kaching-Logo-1024x1024.webp", description: "Impulsa las ventas con Kaching Bundle Quantity Deals: crea ofertas de bundles directamente en la página de tu producto. Usa el código REVENUEH20 para un descuento exclusivo del 20%." },
      { name: "BSS: B2B/Wholesale Solution", url: "https://apps.shopify.com/b2b-solution-custom-pricing?utm_source=RevenueHunt&utm_medium=partnership&utm_campaign=partnership-2024", logo: "/img/pages/partners/BSS-Commerce_logo_150.webp", description: "Solución mayorista integral. Una experiencia de compra B2B fluida que además ayuda a los comerciantes a gestionar a sus clientes mayoristas y obtener insights sobre ellos." },
    ],
  },
  {
    heading: "Marketing y pop-ups",
    emoji: "📣",
    intro: "Prueba social, programas de afiliados y campañas en la tienda que impulsan las ventas.",
    items: [
      { name: "ToastiBar – Sales Popup", url: "https://makeprosimp.com/partnership/revenuehunt", logo: "/img/pages/partners/toastibarlogo_fgaiv9.webp", description: "Aumenta la confianza de los clientes e impulsa las ventas mostrando prueba social en tiempo real: ventas, carrito, visitantes, reseñas de productos y alertas de inventario." },
      { name: "UpPromote: Affiliate & Referral", url: "https://partners.secomapp.com/apps/affiliate/SHOPQUIZ_APP", logo: "/img/pages/partners/NEW_logo-1.webp", description: "UpPromote es la app de afiliación/referidos más recomendada de la Shopify App Store. Solución integral para crear y gestionar tus campañas de marketing, adecuada para negocios de cualquier tamaño." },
    ],
  },
  {
    heading: "Envío y logística",
    emoji: "📦",
    intro: "Aprovisionamiento, logística e incentivos de envío gratis para enviar más rápido y escalar.",
    items: [
      { name: "Essential Free Shipping Bar", url: "https://apps.shopify.com/essential-order-value-booster?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/freeshippingbarlogo.webp", description: "Aumenta las ventas y el AOV configurando barras de envío gratis ilimitadas con múltiples objetivos de valor de carrito para motivar a los compradores a añadir más productos." },
      { name: "HyperSKU", url: "https://apps.shopify.com/hypersku?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/150150-logo.webp", description: "HyperSKU ofrece una solución integral de cadena de suministro. Más de 1M de productos, venta de bundles, muestreo, inspección de calidad, personalización de marca y fulfillment automatizado de pedidos." },
    ],
  },
  {
    heading: "Analítica e informes",
    emoji: "📊",
    intro: "Datos de SEO y de pedidos para medir lo que funciona e informar sobre ello.",
    items: [
      { name: "PDF Invoice Generator", url: "https://apps.shopify.com/fordeer-invoice-order-printer?utm_source=RevenueHunt&utm_medium=partnership&utm_campaign=partner", logo: "/img/pages/partners/fordeer-data-export-1024x1024.webp", description: "El generador de facturas de Shopify de Fordeer es flexible, cumple con la normativa global y atiende a B2C, B2B y mayoristas. Plantillas PDF personalizables, impresión por lotes y soporte por chat en vivo 24/7." },
      { name: "AI SEO Optimizer", url: "https://share.seoant.com/app/1165b75b7ce1524D5J", logo: "/img/pages/partners/SEOAnt-_-AI-SEO-Optimizer_Channelwill-.webp", description: "La mejor app de SEO para Shopify: optimiza keywords, mejora las meta tags y perfecciona la estructura del sitio. Análisis de rendimiento y velocidad de SEO impulsados por AI." },
    ],
  },
  {
    heading: "Diseño y temas",
    emoji: "🎨",
    intro: "Themes premium de Shopify diseñados para convertir y lucir espectaculares.",
    items: [
      { name: "eComX", url: "https://ecomx.co/?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/ecomx-logo.webp", description: "eComX crea themes premium de Shopify diseñados para convertir. Elige entre más de 16 diseños específicos por nicho, optimizados con datos reales de conversión y pensados para la velocidad, para convertir más visitantes en compradores." },
    ],
  },
];

const perks = [
  { title: "Comisiones por referidos", body: "Capta nuevos clientes para RevenueHunt y cobra una comisión vitalicia del 20% de todos los ingresos que generen." },
  { title: "Enlaces de afiliado", body: "Añade tus enlaces de afiliado en tus artículos, newsletters y publicaciones en redes sociales. Enlaza directamente a nuestras apps de Shopify, WooCommerce, BigCommerce, Magento y standalone." },
  { title: "Tu propio partner manager", body: "Recibe consejos sobre cómo crear embudos de venta automatizados con nuestra herramienta y trucos para vender nuestra solución a tus clientes." },
  { title: "Contenido exclusivo", body: "Contáctanos para recibir consejos sobre cómo crear embudos de venta automatizados para tus clientes usando RevenueHunt y otras herramientas." },
  { title: "Un lugar en nuestro Partner Directory", body: "Nuestros usuarios te encontrarán en nuestro Partner Directory y se pondrán en contacto contigo para contratar tus servicios." },
];

const faqs = [
  { q: "¿Cuánto cuesta convertirse en partner?", a: "Registrarse es completamente gratis. Cero. Nada." },
  { q: "¿Tengo que ser cliente de RevenueHunt?", a: "No, no tienes que ser cliente de RevenueHunt para convertirte en partner." },
  { q: "¿Cómo me pagarán?", a: "Pagamos las ganancias mensualmente. Los pagos se envían vía PayPal." },
  { q: "¿Cómo puedo hacer seguimiento de mis referidos?", a: "Puedes ver tus estadísticas en tu <a href='https://admin.revenuehunt.com/' target='_blank' rel='external noopener' class='font-semibold text-[#16161D] underline'>Partner Dashboard</a>." },
];

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Inicio", url: "/" },
    { name: "Partners y afiliados", url: "/partners/" },
  ]),
];
---

<Base
  title="Programa de partners - RevenueHunt"
  description="Recomienda a tus clientes. Gana dinero. Obtén una comisión vitalicia del 20% de los clientes que recomiendes a RevenueHunt. Regístrate gratis en nuestro Programa de Partners."
  jsonLd={jsonLd}
  lang="es"
  translated={true}
>
  <!-- Hero -->
  <PageHero center>
      <Breadcrumb items={[{ label: "Inicio", href: localizedHref("/", "es") }, { label: "Partners y afiliados" }]} />
      <Eyebrow>Programa de partners</Eyebrow>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Recomienda a tus clientes. Gana dinero.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-xl text-slate-600">
        Gana una <strong class="font-semibold text-slate-900">comisión vitalicia del 20%</strong> de los clientes que nos recomiendes. Regístrate hoy gratis en nuestro Programa de Partners.
      </p>
      <p class="mx-auto mt-6 max-w-3xl text-slate-600">
        Si eres una <strong class="font-semibold text-slate-900">agencia de marketing digital</strong> o un
        <strong class="font-semibold text-slate-900">especialista en ecommerce</strong> y quieres hacer crecer tu negocio,
        nuestro Programa de Partners es para ti. Crea experiencias increíbles para tus clientes con RevenueHunt.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
        >
          Empieza ahora
        </a>
        <a
          href="#partners"
          class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
        >
          Ver nuestros partners
        </a>
      </div>
  </PageHero>

  <!-- Who you are + perks -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-1">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Quién eres</h2>
        <p class="mt-4 text-slate-600">
          Eres una agencia de marketing digital o un consultor de ecommerce apasionado por el diseño y obsesionado con
          <strong class="font-semibold text-slate-900">conseguir los mejores resultados</strong> para tus clientes. Haces crecer
          tu negocio impulsando el de otros.
        </p>
      </div>
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Qué obtienes de nosotros</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {perks.map((p) => (
            <li class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="text-base font-semibold text-slate-900">{p.title}</h3>
              <p class="mt-2 text-sm text-slate-600">{p.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Partner directory -->
  <section id="partners" class="mx-auto max-w-7xl px-6 py-16 scroll-mt-24">
    <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Nuestros partners</h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
      Apps y agencias de confianza que combinan a la perfección con RevenueHunt para tus clientes.
    </p>
    <div class="mt-12 space-y-16">
      {groups.map((g) => (
        <div>
          <div class="mb-2 flex items-baseline gap-3">
            <span class="text-2xl" aria-hidden="true">{g.emoji}</span>
            <h3 class="text-2xl font-semibold tracking-tight text-slate-900">{g.heading}</h3>
          </div>
          <p class="max-w-3xl text-slate-600">{g.intro}</p>
          <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {g.items.map((p) => (
        <PartnerCard {...p} alt={`Logo de ${p.name}`} cta={g.heading === "Diseño y temas" ? "Visitar sitio" : "Instalar app"} />
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Preguntas frecuentes</h2>
      <div class="mx-auto mt-8 max-w-2xl">
        {faqs.map((f) => (
          <details class="border-b border-slate-200">
            <summary class="py-4 text-base font-semibold text-slate-900">{f.q}</summary>
            <p class="pb-4 text-slate-600" set:html={f.a}></p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Conviértete en partner de RevenueHunt
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        Recomienda a tus clientes, crea embudos de venta automatizados y gana una comisión vitalicia del 20% de todo lo que gasten.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          Empieza ahora
        </a>
        <a
          href={localizedHref("/demo/", "es")}
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          Reserva una demo
        </a>
      </div>
    </div>
  </section>
</Base>
