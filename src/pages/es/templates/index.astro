---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb, softwareApplication } from "../../../lib/schema";
import { SITE } from "../../../lib/site";
import { SOLUTIONS, FEATURED_SOLUTIONS } from "../../../lib/solutions";
import { localizedHref } from "../../../lib/i18n";

const lang = "es";
const lp = (path: string) => localizedHref(path, lang);

const featuredSolutions = FEATURED_SOLUTIONS.map((slug) => SOLUTIONS[slug]!);

interface Template {
  title: string;
  description: string;
  image: string;
  demo: string;
}

interface TemplateGroup {
  id: string;
  label: string;
  items: Template[];
}

const groups: TemplateGroup[] = [
  {
    id: "skincare",
    label: "Cuidado de la piel, del cabello y cosmética",
    items: [
      { title: "Quiz de tipo de piel + rutina", description: "Identifica el tipo de piel y recomienda una rutina completa.", image: "/img/pages/templates/skinquiz1.webp", demo: "https://productrecommendationquiz.com/pages/skin-analysis" },
      { title: "Encuentra tu base de maquillaje", description: "Elegir la base de maquillaje adecuada no debería ser cuestión de adivinar.", image: "/img/pages/templates/foundation5.webp", demo: "https://productrecommendationquiz.com/pages/foundation-match" },
      { title: "Buscador de tonos de pintalabios", description: "Encuentra para cada cliente el tono de pintalabios perfecto según su tono de piel y estilo.", image: "/img/pages/templates/lips1-e1768405685573.webp", demo: "https://productrecommendationquiz.com/pages/lipstick-shade-finder" },
      { title: "Quiz de cuidado del cabello", description: "Recomienda champús, acondicionadores y tratamientos según los objetivos capilares de cada persona.", image: "/img/pages/templates/hairquiz4.webp", demo: "https://productrecommendationquiz.com/pages/haircare-quiz" },
    ],
  },
  {
    id: "food",
    label: "Nutrición y salud",
    items: [
      { title: "Quiz de café", description: "Guía a tus clientes hasta la mezcla de café ideal según su gusto y estilo de vida.", image: "/img/pages/templates/coffee2.webp", demo: "https://productrecommendationquiz.com/pages/coffee-quiz" },
      { title: "Quiz de suplementos", description: "Recomienda vitaminas y suplementos alineados con sus objetivos de salud.", image: "/img/pages/templates/supplements3.webp", demo: "https://productrecommendationquiz.com/pages/supplements-quiz" },
      { title: "Buscador de productos de CBD", description: "Sugiere los productos de CBD adecuados para relajarse, dormir o concentrarse.", image: "/img/pages/templates/cbd1.webp", demo: "https://productrecommendationquiz.com/pages/cbd-product-finder" },
      { title: "Quiz de comida para perros", description: "Encuentra la comida perfecta para tu perro según sus necesidades y preferencias específicas.", image: "/img/pages/templates/dogquiz3.webp", demo: "https://productrecommendationquiz.com/pages/dog-food" },
    ],
  },
  {
    id: "clothes",
    label: "Deporte, ropa y moda",
    items: [
      { title: "Quiz de joyería", description: "Ayuda a tus compradores a encontrar la pieza de joyería perfecta para su estilo.", image: "/img/pages/templates/jewellery1-e1768405517428.webp", demo: "https://productrecommendationquiz.com/pages/jewellery-quiz" },
      { title: "Quiz de estilo de ropa", description: "Descubre tu personalidad de moda y recibe recomendaciones personalizadas.", image: "/img/pages/templates/style1.webp", demo: "https://productrecommendationquiz.com/pages/clothing-style-quiz" },
      { title: "Quiz de bicicletas", description: "Encuentra para cada cliente la bicicleta adecuada según su estilo de conducción y sus necesidades.", image: "/img/pages/templates/bike2.webp", demo: "https://productrecommendationquiz.com/pages/bicycle-quiz" },
    ],
  },
];

const gallery = [
  "Screenshot-2020-09-29-at-20.20.43.webp",
  "Screenshot-2020-09-29-at-20.33.39.webp",
  "Screenshot-2020-09-29-at-20.34.03.webp",
  "Screenshot-2020-09-29-at-20.34.16.webp",
  "Screenshot-2020-10-20-at-11.31.49.webp",
  "Screenshot-2020-10-20-at-11.32.06.webp",
  "Screenshot-2020-10-20-at-11.33.20.webp",
  "Screenshot-2020-10-20-at-11.33.57.webp",
  "Screenshot-2020-10-20-at-11.39.39.webp",
  "Screenshot-2020-10-20-at-11.41.15.webp",
  "Screenshot-2020-10-20-at-11.41.36.webp",
  "Screenshot-2020-10-20-at-11.41.51.webp",
  "Screenshot-2020-10-20-at-11.44.30.webp",
  "Screenshot-2020-10-20-at-11.45.11.webp",
  "Screenshot-2020-10-20-at-11.45.42.webp",
  "Screenshot-2020-11-16-at-14.34.09.webp",
  "Screenshot-2020-11-16-at-14.34.22.webp",
  "Screenshot-2020-11-16-at-14.34.34.webp",
  "Screenshot-2020-11-16-at-14.36.54.webp",
  "Screenshot-2020-12-04-at-08.38.54.webp",
  "Screenshot-2020-12-04-at-08.39.14.webp",
  "Screenshot-2020-12-04-at-08.39.25.webp",
  "Screenshot-2020-12-04-at-08.39.35.webp",
  "Screenshot-2021-04-14-at-04.13.10.webp",
  "Screenshot-2021-04-14-at-04.13.50.webp",
  "Screenshot-2021-04-14-at-04.14.16.webp",
  "Screenshot-2021-05-13-at-22.49.10.webp",
];

const reasons = [
  { emoji: "🚀", title: "Configuración rápida para Shopify y WooCommerce", body: "Las plantillas se integran sin problemas con Shopify, WooCommerce, BigCommerce y webs independientes. Sin programar: instala la app, elige una plantilla y personalízala para que encaje con tu marca." },
  { emoji: "💡", title: "Lógica y preguntas de quiz prediseñadas", body: "Cada plantilla incluye preguntas elaboradas por expertos, lógica condicional y algoritmos de recomendación de productos. Construidas sobre marcos probados que impulsan las conversiones en belleza, bienestar, cuidado de mascotas y lifestyle." },
  { emoji: "📊", title: "Aumenta las conversiones y el AOV", body: "Las recomendaciones personalizadas convierten a quienes navegan en compradores. Las plantillas están optimizadas para mayores tasas de conversión, cestas más grandes y leads mejor cualificados." },
  { emoji: "🎨", title: "HTML totalmente personalizable", body: "Edita textos, diseño, marca y lógica sin tocar código. Para desarrollos avanzados, cada plantilla también es totalmente accesible mediante HTML, CSS y JS personalizados." },
  { emoji: "📧", title: "Recopila zero-party data", body: "Captura preferencias, intención y datos de segmentación directamente del comprador, y luego sincronízalos con Klaviyo, Omnisend, Meta o GA4 para potenciar tu marketing posterior." },
  { emoji: "⚡", title: "Responsive y optimizadas para móvil", body: "Cada plantilla se entrega con enfoque mobile-first. Rápidas, accesibles y diseñadas para sentirse nativas en móviles, tablets y ordenadores." },
];

const jsonLd = [
  organization(),
  softwareApplication(),
  breadcrumb([
    { name: "Inicio", url: "/" },
    { name: "Plantillas de quiz", url: "/templates/" },
  ]),
];
---

<Base
  title="Plantillas de quiz - RevenueHunt"
  description="Plantillas de quiz de productos para Shopify, WooCommerce, BigCommerce y tiendas independientes. Cuidado de la piel, belleza, suplementos, comida para mascotas, ropa, deporte y más: preguntas prediseñadas, lógica condicional y algoritmos de recomendación de productos."
  jsonLd={jsonLd}
  lang="es"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20 text-center">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={lp("/")} class="hover:text-slate-700">Inicio</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Plantillas de quiz</span>
      </nav>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Plantillas de quiz de productos para Shopify y WooCommerce
      </h1>
      <p class="mt-4 text-xl font-semibold text-slate-700">
        Plantillas interactivas de Product Recommendation Quiz: listas para usar
      </p>
      <p class="mx-auto mt-6 max-w-3xl text-slate-600">
        Descubre nuestra colección de <strong class="font-semibold text-slate-900">plantillas de quiz gratuitas</strong> diseñadas para tiendas de ecommerce.
        Desde quizzes de cuidado de la piel y belleza hasta suplementos, comida para mascotas y productos de lifestyle: cada plantilla está creada para ayudarte a ofrecer
        una experiencia de compra personalizada que convierte. Perfectas para <strong class="font-semibold text-slate-900">Shopify</strong>,
        <strong class="font-semibold text-slate-900">WooCommerce</strong>, <strong class="font-semibold text-slate-900">BigCommerce</strong>,
        y tiendas <strong class="font-semibold text-slate-900">independientes</strong>.
      </p>
      <p class="mx-auto mt-4 max-w-3xl text-slate-600">
        Estas plantillas de quiz en HTML personalizable incluyen preguntas ya redactadas, lógica condicional y algoritmos de recomendación de productos.
        Elige una plantilla, conecta tus productos, personaliza el diseño y publica. Haz clic en cualquier plantilla de abajo para ver una demo en vivo.
      </p>
    </div>
  </section>

  <!-- Top CTA banner -->
  <section class="mx-auto max-w-7xl px-6 pb-8">
    <div class="overflow-hidden rounded-2xl bg-[#16161D] px-8 py-12 text-center text-white">
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Prueba nuestras plantillas de quiz de productos en vivo</h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        Experimenta quizzes de recomendación de productos totalmente funcionales en nuestra tienda demo en vivo de Shopify. Prueba distintos tipos de quiz,
        explora la lógica condicional, las preguntas con ramificaciones y las recomendaciones de productos personalizadas en acción.
      </p>
      <a
        href="https://productrecommendationquiz.com/"
        target="_blank"
        rel="external noopener nofollow"
        class="mt-8 inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
      >
        Explorar las demos de quiz en vivo
      </a>
    </div>
  </section>

  <!-- Category nav -->
  <nav class="sticky top-[60px] z-30 border-y border-slate-200 bg-white/95 backdrop-blur" aria-label="Template categories">
    <ul class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-2 px-6 py-3">
      {groups.map((g) => (
        <li>
          <a
            href={`#${g.id}`}
            class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-[#16161D] hover:text-[#16161D]"
          >
            {g.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href="#gallery"
          class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-[#16161D] hover:text-[#16161D]"
        >
          Galería de ejemplos de quiz
        </a>
      </li>
    </ul>
  </nav>

  <!-- Template grids -->
  <section class="mx-auto max-w-7xl px-6 py-12">
    {groups.map((g) => (
      <div id={g.id} class="mb-16 scroll-mt-32 last:mb-0">
        <h2 class="mb-8 text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">{g.label}</h2>
        <ul class="grid gap-6 md:grid-cols-2">
          {g.items.map((t) => (
            <li class="flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md">
              <a
                href={t.demo}
                target="_blank"
                rel="external noopener nofollow"
                class="block aspect-[321/217] overflow-hidden bg-slate-50"
              >
                <img src={t.image} alt={t.title} loading="lazy" class="h-full w-full object-cover" />
              </a>
              <div class="flex flex-1 flex-col p-5">
                <h3 class="text-lg font-semibold text-slate-900">{t.title}</h3>
                <p class="mt-2 text-sm text-slate-600">{t.description}</p>
                <div class="mt-5 flex flex-wrap gap-2">
                  <a
                    href={t.demo}
                    target="_blank"
                    rel="external noopener nofollow"
                    class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#26262e]"
                  >
                    Demo
                  </a>
                  <a
                    href={lp("/product-recommendation-quiz/")}
                    class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-4 py-2 text-sm font-semibold text-[#16161D] transition hover:bg-slate-50"
                  >
                    Conseguir esta plantilla
                  </a>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <!-- Examples gallery -->
    <div id="gallery" class="scroll-mt-32">
      <h2 class="mb-8 text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Galería de ejemplos de quiz</h2>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {gallery.map((file) => (
          <li class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
            <a href={`/img/pages/templates/${file}`} target="_blank" rel="noopener" class="block aspect-video overflow-hidden bg-slate-50">
              <img src={`/img/pages/templates/${file}`} alt="Ejemplo de quiz" loading="lazy" class="h-full w-full object-cover" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Solutions cross-link -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 pb-4">
      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-8">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">¿No sabes qué quiz crear?</h2>
        <p class="mt-3 text-slate-700">
          Nuestras soluciones de quiz explican el mejor tipo de quiz para tu sector, desde rutinas de cuidado de la piel hasta buscadores de regalos, con ejemplos y FAQs.
        </p>
        <ul class="mt-6 flex flex-wrap gap-3" role="list">
          {featuredSolutions.map((s) => (
            <li>
              <a
                href={`/solutions/${s.slug}/`}
                class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-[#16161D] hover:text-[#16161D]"
              >
                {s.name}
              </a>
            </li>
          ))}
          <li>
            <a
              href={lp("/solutions/")}
              class="inline-flex items-center rounded-full bg-[#16161D] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#26262e]"
            >
              Todas las soluciones →
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Why use templates -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        ¿Por qué usar plantillas de quiz de productos en tu tienda de ecommerce?
      </h2>
      <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {reasons.map((r) => (
          <li class="rounded-xl border border-slate-200 bg-white p-6">
            <div class="text-2xl">{r.emoji}</div>
            <h3 class="mt-3 text-lg font-semibold text-slate-900">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{r.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Empieza a crear tu quiz de productos hoy
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        Crea quizzes de recomendación de productos atractivos para tu tienda de Shopify o WooCommerce en minutos. Sin programar.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SITE.signup_url}
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          Prueba las plantillas de quiz gratis
        </a>
        <a
          href={lp("/demo/")}
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          Reservar una demo
        </a>
      </div>
    </div>
  </section>
</Base>
