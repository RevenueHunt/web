---
import ComparePage from "../../../../components/pages/ComparePage.astro";
import { COMPETITORS_BY_LANG } from "../../../../lib/competitors";

export function getStaticPaths() {
  return Object.values(COMPETITORS_BY_LANG["fi"]).map((competitor) => ({
    params: { slug: competitor.slug },
    props: { competitor },
  }));
}
const { competitor } = Astro.props;
---

<ComparePage competitor={competitor} lang="fi" translated={true} />
