---
import Base from "../../../layouts/Base.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import YouTubeFacade from "../../../components/YouTubeFacade.astro";
import { organization, breadcrumb } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Etusivu", url: "/" },
    { name: "Yhteystiedot", url: "/contact/" },
  ]),
];

const channels = [
  {
    label: "Lue ohjeoppaat",
    href: "https://docs.revenuehunt.com/",
    note: "Itsepalvelun dokumentaatio, integraatiot, ongelmanratkaisu.",
    external: true,
  },
  {
    label: "Tuki ja myynti sähköpostitse",
    href: "mailto:team@revenuehunt.com",
    note: "team@revenuehunt.com - katso vastausajat alta.",
  },
  {
    label: "Tarkista järjestelmän tila",
    href: "https://status.revenuehunt.com/",
    note: "Palvelun reaaliaikainen kunto ja häiriöhistoria. 99,98 %+ käytettävyys.",
    external: true,
  },
];

const responseTiers = [
  {
    label: "Kriittinen - tuotanto kaatunut, tietoturva, datan eheys",
    sla: "Ensimmäinen vastaus 30 minuutissa, 24/7 ympäri maailman",
  },
  {
    label: "Korkea - tärkeä toiminto häiriintynyt, useita käyttäjiä koskettava",
    sla: "Ensimmäinen vastaus 12 tunnissa",
  },
  {
    label: "Vakio - kysymykset, apu määrityksessä",
    sla: "1 työpäivä",
  },
  {
    label: "Matala prioriteetti - palaute, toivetoiminnot",
    sla: "Enintään 3 työpäivää",
  },
];
---

<Base
  title="Yhteystiedot - RevenueHunt"
  description="Ota yhteyttä RevenueHuntin tukitiimiin. Lue ohjeoppaat, katso tutoriaali tai tee tukikysely saadaksesi henkilökohtaisen vastauksen minuuteissa."
  jsonLd={jsonLd}
  lang="fi"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20 text-center">
      <Breadcrumb items={[{ label: "Etusivu", href: localizedHref("/", "fi") }, { label: "Yhteystiedot" }]} />
      <Eyebrow>Yhteystiedot</Eyebrow>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Ota yhteyttä
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600">
        Lue ohjeoppaat, katso tutoriaali tai tee tukikyselymme alta - eCommercen terävin ja
        ystävällisin tukitiimi vastaa sinulle.
      </p>
    </div>
  </section>

  <!-- Two-column: video + channels -->
  <section class="mx-auto max-w-7xl px-6 py-12">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Aloita tutoriaalista</h2>
        <p class="mt-3 text-slate-600">
          Useimmat kysymykset ratkeavat 3 minuutin oppaalla. Vilkaise se nopeasti ennen kuin kirjoitat meille.
        </p>
        <div class="mt-6 aspect-video overflow-hidden rounded-xl bg-slate-900 shadow-xl">
          <YouTubeFacade id="oL1DnBd6N1U" title="RevenueHuntin tukitutoriaali" />
        </div>
      </div>
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Miten ottaa meihin yhteyttä</h2>
        <ul class="mt-6 space-y-3">
          {channels.map((c) => (
            <li>
              <a
                href={c.href}
                target={c.external ? "_blank" : undefined}
                rel={c.external ? "external noopener" : undefined}
                class="group flex items-start justify-between gap-4 rounded-xl border border-slate-200 bg-white p-5 transition hover:border-slate-300 hover:shadow-md"
              >
                <div>
                  <p class="text-base font-semibold text-slate-900 group-hover:text-[#16161D]">{c.label}</p>
                  <p class="mt-1 text-sm text-slate-600">{c.note}</p>
                </div>
                <span class="mt-1 shrink-0 text-slate-400 transition group-hover:text-[#16161D]" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Support quiz -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Tee tukikyselymme</h2>
      <p class="mx-auto mt-3 max-w-2xl text-slate-600">
        Vastaa muutamaan nopeaan kysymykseen, niin ohjaamme sinut oikean avun luo - dokumentaatioon, tutoriaaliin tai oikean ihmisen vastaukseen.
      </p>
      <div class="mx-auto mt-8 max-w-4xl overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <iframe
          src="https://admin.revenuehunt.com/public/quiz/ZAHJoMM"
          title="RevenueHuntin tukikysely"
          loading="lazy"
          class="block h-[600px] w-full"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Response times — moved here from the right column so it sits under
       the quiz, since that's where visitors land after asking for help. -->
  <section class="mx-auto max-w-4xl px-6 py-16">
    <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm sm:p-10">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Vastausajat</h2>
      <p class="mt-3 text-slate-600">
        Porrastettu tuen SLA kaikille kauppiaille, etusijalla Shopify Plus- ja enterprise-tilit.
      </p>
      <dl class="mt-6 grid gap-4 sm:grid-cols-2">
        {responseTiers.map((t) => (
          <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
            <dt class="text-sm font-semibold text-slate-900">{t.label}</dt>
            <dd class="mt-1 text-sm text-slate-600">{t.sla}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Base>
