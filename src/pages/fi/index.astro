---
import Base from "../../layouts/Base.astro";
import PlanCards from "../../components/pages/PlanCards.astro";
import YouTubeFacade from "../../components/YouTubeFacade.astro";
import { organization, website, softwareApplication } from "../../lib/schema";
import { SITE } from "../../lib/site";
import { localizedHref } from "../../lib/i18n";

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=bfs_badge_hero";
const WOOCOMMERCE_DOWNLOAD =
  "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";
const YOUTUBE_ID = "fJqpGJUzZNE";

const stats = [
  { value: "+20,000", label: "Brändiä käyttää RevenueHuntia" },
  { value: "+45M", label: "Suoritettua kyselyä" },
  { value: "+370M USD", label: "Liikevaihtoa kauppiaille" },
  { value: "4.9 ★", label: "Yli 550 viiden tähden arvostelua" },
];

const pillars = [
  {
    image: "/img/pages/home/recommend-right-products.svg",
    title: "Suosittele oikeita tuotteita",
    body:
      "Tuotteet integroivat kyselyt vauhdittavat myyntiä, auttavat asiakkaita löytämään juuri heille sopivat tuotteet ja tukevat varmoissa ostopäätöksissä.",
  },
  {
    image: "/img/pages/home/know-your-customers.svg",
    title: "Tunne asiakkaasi",
    body:
      "Kyselyiden avulla keräät käyttökelpoista dataa esittämällä asiakkaillesi konkreettisia kysymyksiä. Segmentoi ja merkitse ostajat heidän vastaustensa perusteella.",
  },
  {
    image: "/img/pages/home/grow-your-audience.svg",
    title: "Kasvata yleisöäsi",
    body:
      "Lähetä kerätyt liidit sähköpostilistallesi tai CRM:ään. Hyödynnä asiakasprofiilin dataa ja luo henkilökohtaisempia, paremman ROI:n markkinointikampanjoita.",
  },
];

const features = [
  {
    kicker: "Tekoälykyselyn copilot",
    title: "Luo kysely 60 sekunnissa tekoälyllä",
    body:
      "Kuvaile kauppasi, ja tekoälycopilotimme luo täysin valmiin kyselyn - kysymykset, logiikan ja tuotteiden kohdistuksen - julkaisuvalmiina.",
  },
  {
    kicker: "Ehdollinen logiikka",
    title: "Haarautuva logiikka vedä ja pudota -tyylillä",
    body:
      "Näytä tai piilota kysymyksiä aiempien vastausten perusteella. Ohjaa jokainen ostaja polulle, joka päättyy ostoon - ilman koodia.",
  },
  {
    kicker: "Kyselyn ulkoasu",
    title: "Tee siitä omasi - ilman koodia",
    body:
      "Mukauta värit, fontit, kuvat ja ulkoasu brändiisi sopiviksi. Kyselysi näyttää osalta kauppaasi, ei kolmannen osapuolen widgetiltä.",
  },
  {
    kicker: "Tulossivu",
    title: "Kyselyn tulossivu, joka konvertoi",
    body:
      "Näytä henkilökohtaiset tuotesuositukset ryhmiteltyinä rutiinin vaiheiden mukaan - kuvineen, hintoineen ja lisää koriin -painikkeineen. Ostajat ostavat suoraan tulossivulta.",
  },
  {
    kicker: "Keskeyttämisanalytiikka",
    title: "Tiedä tarkalleen, missä ostajat keskeyttävät",
    body:
      "Tarkastele keskeyttämisprosentteja kysymys kysymykseltä, kohteita ja tuloksia. Korjaa kitkakohdat, paranna suorituksia ja palauta menetetty liikevaihto.",
  },
  {
    kicker: "Kolmannen osapuolen integraatiot",
    title: "Yhdistä koko markkinointipinosi",
    body:
      "Lähetä kyselyn data Google Analyticsiin, laukaise Meta Pixel -tapahtumia uudelleenmarkkinointia varten ja synkronoi liidit Klaviyoon - kaikki yhdeltä asetussivulta. Ilman koodia, ilman middlewarea.",
  },
];

const steps = [
  {
    title: "Asenna sovellus",
    body: "Yhden klikkauksen asennus Shopify App Storesta tai WordPressin liitännäishakemistosta.",
  },
  {
    title: "Luo kyselysi",
    body: "Käytä tekoälycopilotia tai vedä ja pudota -editoria. Lisää kysymyksesi ja määritä logiikkasi.",
  },
  {
    title: "Kohdista tuotteesi",
    body: "Yhdistä kyselyn vastaukset tuotekatalogiisi. Suosittele paras osuma jokaiselle tulokselle.",
  },
  {
    title: "Julkaise ja markkinoi",
    body: "Upota se mille tahansa sivulle, näytä pop-upina poistumisaikeen tunnistuksessa tai linkitä siihen mainoksistasi.",
  },
];

const testimonials = [
  {
    quote:
      "Vaihdoin Octanesta. Suunnitteluprosessi oli paljon intuitiivisempi ja visuaalisesti miellyttävämpi. Kun minulla oli ongelma Klaviyon kanssa, tuki vastasi salamannopeasti ja todella lämpimällä, avoimella asenteella.",
    author: "Kae Paché",
  },
  {
    quote:
      "Eric oli äärimmäisen kärsivällinen, osaava ja perusteellinen - opasti minut vaihe vaiheelta kyselyn määrityksen läpi. Tällainen tuki on harvinaista.",
    author: "Marcelle",
  },
  {
    quote:
      "Itse sovellus on erinomainen: tehokkaita toimintoja, intuitiivinen käytettävyys. Tiimi loi meille räätälöidyn opastetun tutoriaalin. Olemme käyttäneet sitä yli 3 vuotta.",
    author: "Didymos",
  },
  {
    quote:
      "Ylivoimaisesti paras kysely- ja tuotesuositussovellus, jota olen kokeillut Shopifyssa. Tiimi otti aikaa selvittää asian, selitti jokaisen vaiheen selkeästi ja opasti minua, kunnes ongelma oli täysin ratkaistu.",
    author: "REYNA",
  },
  {
    quote:
      "Tämä oli 5. kyselysovellus, jota kokeilin, ja ainoa, joka tuki täysin sitä mitä tarvitsin. Pystyin luomaan ensimmäisen kyselyni todella nopeasti.",
    author: "CCA Printing",
  },
  {
    quote:
      "Asiakaspalvelu erottuu edukseen - agentti nauhoitti videon ja selitti minulle ratkaisun vaihe vaiheelta. Erittäin vastaanottavainen ja todella avulias.",
    author: "The Love U Collective",
  },
];

const verticals = [
  { icon: "💄", title: "Kauneus ja ihonhoito", body: "Ihotyypin selvittäjät, sävyn valinta, rutiinien rakentajat." },
  { icon: "💊", title: "Lisäravinteet", body: "Terveystavoitekyselyt, jotka suosittelevat oikean kokonaisuuden." },
  { icon: "👗", title: "Muoti", body: "Tyylikyselyt, jotka löytävät oikean koon, värin ja mallin." },
  { icon: "🐾", title: "Lemmikit", body: "Rotukohtaiset tuotesuositukset jokaiselle omistajalle." },
  { icon: "🍵", title: "Ruoka ja juoma", body: "Makuprofiilikyselyt, jotka muuttavat uteliaat tilaajiksi." },
  { icon: "🏋️", title: "Fitness", body: "Tavoitepohjaiset suppilot varusteille, vaatteille ja ohjelmille." },
  { icon: "🏠", title: "Koti ja sisustus", body: "Tyylikyselyt, jotka sovittavat huonekalut jokaiseen kodin tilaan." },
  { icon: "🌿", title: "Eko ja kestävä", body: "Arvoja yhdistävät kyselyt tiedostavalle kuluttajalle." },
];

const brands = [
  "Olaplex", "Madluvv", "Mattel", "Alt", "Baia", "Bare", "Biktrix",
  "Dermocracy", "Diego", "Gisou", "Laura", "Nuxe", "Olcay",
  "Salad Code", "Salugea", "Sunday", "Tushy", "Tiege",
];

const SHOPIFY_REVIEWS =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/reviews?ratings%5B%5D=5&sort_by=relevance";
const WOOCOMMERCE_REVIEWS =
  "https://wordpress.org/support/plugin/product-recommendation-quiz-for-ecommerce/reviews/?filter=5";
---

<Base
  lang="fi"
  translated={true}
  title={`Tuotesuosittelukysely - ${SITE.name}`}
  description="Muuta pelkät katselijat ostajiksi tuotesuosittelukyselyllä. Yli 20 000 brändiä, 4,9★, yli 550 arvostelua. Kasvata konversiota ja kerää zero-party-dataa tuotekyselyllä."
  jsonLd={[organization(), website(), softwareApplication()]}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-7xl px-6 py-16 lg:py-24">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:items-start lg:gap-16">
        <div>
          <a
            href={SHOPIFY_INSTALL}
            rel="external nofollow"
            data-install="home_hero_badge"
            class="mb-6 inline-block"
          >
            <img
              src="/img/home/bfs-badge.webp"
              alt="Built for Shopify"
              width="120"
              height="38"
              class="h-8 w-auto"
              loading="eager"
            />
          </a>
          <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
            Tuotesuosittelukysely, joka muuttaa uteliaat ostajiksi
          </h1>
          <p class="mt-6 max-w-xl text-lg text-slate-700">
            Maksetut mainokset tuovat klikkauksia - tuotekyselymme muuttaa ne myynniksi. RevenueHuntin kyselyt ohjaavat ostajat oikeiden tuotteiden luo,
            keräävät dataa ja vauhdittavat konversioita. Helppo asentaa, ilman koodia.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={SHOPIFY_INSTALL}
              rel="external nofollow"
              data-install="home_hero"
              class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
            >
              asenna Shopifyyn
            </a>
            <a
              href={WOOCOMMERCE_DOWNLOAD}
              rel="external nofollow"
              onclick="window.gtag&&gtag('event','download_woocommerce_plugin',{event_label:'home_hero'})"
              class="inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-6 py-3 text-base font-semibold text-slate-900 transition hover:border-slate-400 hover:bg-slate-50"
            >
              hanki WooCommerceen
            </a>
          </div>
          <p class="mt-4 text-sm text-slate-500">
            Ilmainen paketti saatavilla · 15 päivän ilmainen kokeilu · 30 päivän rahat takaisin -takuu
          </p>
        </div>

        <div class="relative lg:mt-14">
          <div class="aspect-video overflow-hidden rounded-xl bg-slate-900 shadow-2xl">
            <YouTubeFacade
              id={YOUTUBE_ID}
              title="RevenueHunt - tuotesuosittelukysely"
              poster="/img/home/video-poster.webp"
              alt="RevenueHuntin tuotesuosittelukyselyn demo Shopify- ja WooCommerce-kaupoille"
              eager
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats / proof bar -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <p class="text-center text-sm font-semibold uppercase tracking-wider text-white/70">
        Miksi valita RevenueHunt? Vaikutuksemme puhuu puolestaan
      </p>
      <dl class="mt-8 grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-4">
        {stats.map((s) => (
          <div class="text-center">
            <dt class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{s.value}</dt>
            <dd class="mt-2 text-sm text-white/70">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Problem framing -->
  <section class="mx-auto max-w-4xl px-6 py-20 text-center">
    <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
      Ostajat eivät aina tiedä mitä ostaa - ja se tarkoittaa menetettyä myyntiä.
    </h2>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-700">
      <a href={localizedHref("/product-recommendation-quiz/", "fi")} class="font-semibold text-slate-900 underline underline-offset-4 hover:text-slate-700">Tuotesuosittelukyselymme</a> opastaa jokaisen asiakkaan koko ostopolun läpi ja auttaa häntä löytämään ja ostamaan juuri hänelle sopivat tuotteet.
    </p>
  </section>

  <!-- 3-up pillars -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="grid gap-10 md:grid-cols-3">
        {pillars.map((p) => (
          <div class="text-center">
            <img src={p.image} alt={p.title} width="120" height="120" class="mx-auto h-24 w-24" loading="lazy" />
            <h3 class="mt-6 text-xl font-semibold text-slate-900">{p.title}</h3>
            <p class="mt-3 text-slate-600">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features grid -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Kaikki mitä tarvitset älykkäämpään myyntiin</h2>
      </div>
      <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {features.map((f) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">{f.kicker}</p>
            <h3 class="mt-2 text-xl font-semibold text-slate-900">{f.title}</h3>
            <p class="mt-3 text-slate-600">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4-step setup -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Käyntiin 4 vaiheessa. Alle 15 minuutissa.</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          Ilman kehittäjiä. Ilman koodia. Vain kysely, jota asiakkaasi rakastavat.
        </p>
      </div>
      <ol class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <li class="rounded-xl border border-slate-200 bg-white p-6">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-[#16161D] text-sm font-bold text-white">{i + 1}</span>
            <h3 class="mt-4 text-lg font-semibold text-slate-900">{s.title}</h3>
            <p class="mt-2 text-slate-600">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          Lue, miksi kauppiaat rakastavat tuotesuosittelukyselyä
        </h2>
        <p class="mx-auto mt-4 max-w-3xl text-lg text-slate-700">
          Yli 20 000 brändin luottamuksella ja yli 550 viiden tähden arvostelun tukemana Shopifyssa, WooCommercessa ja muualla -
          RevenueHunt on suosituin kyselysovellus myynnin vauhdittamiseen personoinnin avulla. Mutta älä luota pelkkään sanaamme.
        </p>
        <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap text-sm">
          <a href={SHOPIFY_REVIEWS} rel="external nofollow" class="font-semibold text-[#16161D] underline-offset-4 hover:underline">
            Arvostelut Shopifyssa →
          </a>
          <a href={WOOCOMMERCE_REVIEWS} rel="external nofollow" class="font-semibold text-[#16161D] underline-offset-4 hover:underline">
            Arvostelut WooCommercessa →
          </a>
        </div>
      </div>

      <h3 class="mt-16 text-center text-xl font-semibold text-slate-900">Mitä kauppiaat sanovat</h3>
      <div class="rh-carousel mt-8">
        <ul data-carousel class="rh-carousel__track" aria-label="Kauppiaiden suosittelut">
          {testimonials.map((t) => (
            <li class="rounded-xl border border-slate-200 bg-white p-6">
              <p class="text-amber-500" aria-label="5 / 5 tähteä">★★★★★</p>
              <blockquote class="mt-3 text-slate-700">"{t.quote}"</blockquote>
              <p class="mt-4 text-sm font-semibold text-slate-900"> - {t.author}</p>
            </li>
          ))}
        </ul>
        <div data-carousel-dots class="rh-carousel__dots"></div>
      </div>
    </div>
  </section>

  <!-- Verticals -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Tehty jokaiselle eCommerce-toimialalle</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          Myitpä sitten ihonhoitoa, lisäravinteita tai sohvia - kysely, joka auttaa ostajia löytämään oikean tuotteen, konvertoi paremmin kuin mikään kokoelmasivu.
        </p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {verticals.map((v) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6">
            <span class="block text-3xl" aria-hidden="true">{v.icon}</span>
            <h3 class="mt-3 text-base font-semibold text-slate-900">{v.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Brand logos -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-white sm:text-3xl">Vauhdittamassa parhaita eCommerce-brändejä</h2>
      <div class="brands-marquee mt-10">
        <ul class="brands-marquee__track" aria-label="Asiakasbrändien logot">
          {brands.map((b) => (
            <li class="brands-marquee__item">
              <img
                src={`/img/brands/${b.toLowerCase().replace(/ /g, "-")}.svg`}
                alt={b}
                loading="lazy"
                width="160"
                height="40"
              />
            </li>
          ))}
          {brands.map((b) => (
            <li class="brands-marquee__item" aria-hidden="true">
              <img
                src={`/img/brands/${b.toLowerCase().replace(/ /g, "-")}.svg`}
                alt={`${b} logo`}
                loading="lazy"
                width="160"
                height="40"
              />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <style>
    .brands-marquee {
      overflow: hidden;
      -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
      mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    }
    .brands-marquee__track {
      display: flex;
      align-items: center;
      width: max-content;
      list-style: none;
      padding: 0;
      margin: 0;
      animation: brands-marquee 40s linear infinite;
    }
    .brands-marquee:hover .brands-marquee__track {
      animation-play-state: paused;
    }
    .brands-marquee__item {
      flex-shrink: 0;
      padding: 10px 24px;
      height: 64px;
      display: flex;
      align-items: center;
    }
    .brands-marquee__item img {
      height: 100%;
      width: auto;
      max-width: 160px;
      object-fit: contain;
      /* Normalize mixed-fill SVGs to white on the dark strip. */
      filter: brightness(0) invert(1);
      opacity: 0.85;
    }
    @keyframes brands-marquee {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }
    @media (prefers-reduced-motion: reduce) {
      .brands-marquee__track { animation: none; }
    }
  </style>

  <!-- Plans summary -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Valitse paras paketti eCommercellesi</h2>
        <p class="mt-4 text-base text-slate-700 sm:text-lg">
          Ilmainen paketti saatavilla. 15 päivän ilmainen kokeilu rajattomilla kyselyvastauksilla ja kaikilla toiminnoilla. 30 päivän rahat takaisin -takuu.
        </p>
      </div>

      <div class="mt-12">
        <PlanCards lang="fi" />
      </div>
    </div>
  </section>

  <!-- Multi-platform strip -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-16 text-center">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Toimii useilla eCommerce-alustoilla</h2>
      <!-- Logos are white SVGs (built for a dark bg); brightness-0 inverts them to dark for this white section. -->
      <ul class="mt-10 flex flex-wrap items-center justify-center gap-x-14 gap-y-8">
        <li>
          <a href={localizedHref("/product-recommendation-quiz-shopify/", "fi")} aria-label="Tuotesuosittelukysely Shopifylle">
            <img src="/img/logos/shopify_monotone_white.svg" alt="Shopify" class="h-8 w-auto opacity-60 brightness-0 transition hover:opacity-100" />
          </a>
        </li>
        <li>
          <a href={localizedHref("/product-recommendation-quiz-woocommerce/", "fi")} aria-label="Tuotesuosittelukysely WooCommercelle">
            <img src="/img/logos/woo_logo_white.svg" alt="WooCommerce" class="h-8 w-auto opacity-60 brightness-0 transition hover:opacity-100" />
          </a>
        </li>
        <li>
          <a href={localizedHref("/product-recommendation-quiz-bigcommerce/", "fi")} aria-label="Tuotesuosittelukysely BigCommercelle">
            <img src="/img/logos/bigcommerce_logo_white.svg" alt="BigCommerce" class="h-7 w-auto opacity-60 brightness-0 transition hover:opacity-100" />
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-white/70">
