---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

interface Partner {
  name: string;
  url: string;
  logo: string;
  description: string;
}

const groups: { heading: string; emoji: string; intro: string; items: Partner[] }[] = [
  {
    heading: "Shopify-sovellukset",
    emoji: "🧩",
    intro: "Shopify-sovelluksia, jotka toimivat saumattomasti RevenueHuntin kanssa kasvattaaksesi kauppaasi.",
    items: [
      { name: "Orbe Shopify Geolocation", url: "https://orbe.app/", logo: "/img/pages/partners/orbe-removebg-preview.webp", description: "Maksimoi globaali myynti edistyneellä Shopify-geopaikannuksella. Mukauta tuotteet, hinnat, valuutta ja sisältö jokaiselle maalle ja ohjaa asiakkaat oikeaan ostokokemukseen Orbella." },
      { name: "WC Wishlist Club", url: "https://apps.shopify.com/wishlist-club?utm_source=revenuehunt&utm_medium=website&utm_campaign=partnership", logo: "/img/pages/partners/wishlist-club-150-150-px-logo.webp", description: "WC Wishlist Club antaa asiakkaidesi tallentaa suosikkituotteensa, jakaa toivelistoja ja ostaa myöhemmin, lisäten sitoutumista ja myyntiä. Helppo asentaa, mobiiliystävällinen ja täydellinen pelkkien katselijoiden muuttamiseen uskollisiksi ostajiksi." },
      { name: "Langwill: Language Translate", url: "https://partner.channelwill.com/ceq5ql", logo: "/img/pages/partners/1.webp", description: "Laajenna globaalia tavoittavuuttasi Langwillilla: käännä Shopify-kauppasi 138 kielelle ja muunna valuutat automaattisesti saumatonta, lokalisoitua ostokokemusta varten." },
      { name: "Checkout Extensions Pro", url: "https://apps.shopify.com/checkout-extensions-pro?utm_source=drip", logo: "/img/pages/partners/CHECKOUT-Extension-Pro-logo_0101.webp", description: "Tehosta Shopify Plus -kassaasi räätälöidyillä upsell-alennuksilla, AI-upselleilla, ilmaisen toimituksen palkilla, oston jälkeisillä tarjouksilla, luottamusmerkeillä, arvosteluilla ja paljon muulla." },
      { name: "Customer Dashboard Pro", url: "https://apps.shopify.com/customer-dashboard-pro?utm_source=revenuehunt", logo: "/img/pages/partners/CustomerDashboard.webp", description: "Customer Dashboard Pro on ainoa sovellus, joka tarjoaa saumattoman tuen sekä Shopifyn uusille Customer Accountseille että Classic Customer Accountseille." },
      { name: "WISS Bundle", url: "https://apps.shopify.com/wiss-bundle", logo: "/img/pages/partners/Logo-9.webp", description: "Kasvata Shopify-kauppasi liikevaihtoa ja AOV:ta yksinkertaisella ja mukautettavalla tuotepakettisovelluksella. Tarjoa joustavia alennusvaihtoehtoja: arvopohjaiset alennukset, ilmainen toimitus paketoiduille tuotteille tai osta X ja saa Y." },
      { name: "ToastiBar – Sales Popup", url: "https://makeprosimp.com/partnership/revenuehunt", logo: "/img/pages/partners/toastibarlogo_fgaiv9.webp", description: "Lisää asiakkaiden luottamusta ja vauhdita myyntiä näyttämällä reaaliaikaista sosiaalista todistetta: myynnit, ostoskori, kävijät, tuotearvostelut ja varastohälytykset." },
      { name: "UpPromote: Affiliate & Referral", url: "https://partners.secomapp.com/apps/affiliate/SHOPQUIZ_APP", logo: "/img/pages/partners/NEW_logo-1.webp", description: "UpPromote on Shopify App Storen suositelluin affiliate-/suosittelusovellus. Kattava ratkaisu markkinointikampanjoidesi luomiseen ja hallintaan, sopii kaiken kokoisille yrityksille." },
      { name: "Essential Free Shipping Bar", url: "https://essential-apps.com/essential-shopify-free-shipping-bar-application/", logo: "/img/pages/partners/freeshippingbarlogo.webp", description: "Kasvata myyntiä ja AOV:ta luomalla rajattomasti ilmaisen toimituksen palkkeja useilla ostoskorin arvotavoitteilla kannustaaksesi ostajia lisäämään tuotteita." },
      { name: "iCart Cart Drawer Cart Upsell", url: "https://apps.shopify.com/icart/?campaign=promotion&medium=in-app-banner&source=revenuehunt", logo: "/img/pages/partners/iCart-Cart-Drawer-Cart-Upsell-logo.webp", description: "Kattava Shopify-sovellus ostoskorilaatikon ja koko ostoskorisivun mukauttamiseen upsellillä, tuotesuosituksilla, edistymispalkilla, tuotepaketeilla ja alennuksilla." },
      { name: "Kaching Bundle Quantity Deals", url: "https://apps.shopify.com/bundle-deals?utm_source=partnership&utm_medium=web&utm_campaign=REVENUEH", logo: "/img/pages/partners/Kaching-Logo-1024x1024.webp", description: "Vauhdita myyntiä Kaching Bundle Quantity Dealsilla: luo pakettitarjouksia suoraan tuotesivullasi. Käytä koodia REVENUEH20 saadaksesi eksklusiivisen 20 %:n alennuksen." },
      { name: "PDF Invoice Generator", url: "https://apps.shopify.com/fordeer-invoice-order-printer?utm_source=ShopQuizProductRecommender&utm_medium=comarketing&utm_campaign=partner", logo: "/img/pages/partners/fordeer-data-export-1024x1024.webp", description: "Fordeerin Shopify-laskugeneraattori on joustava, noudattaa globaalia sääntelyä ja palvelee B2C-, B2B- ja tukkuasiakkaita. Mukautettavat PDF-mallit, erätulostus ja 24/7 live-chat-tuki." },
      { name: "AI SEO Optimizer", url: "https://share.seoant.com/app/1165b75b7ce1524D5J", logo: "/img/pages/partners/SEOAnt-_-AI-SEO-Optimizer_Channelwill-.webp", description: "Paras SEO-sovellus Shopifylle: optimoi avainsanat, paranna meta-tageja ja viimeistele sivuston rakenne. AI-pohjainen SEO-suorituskyvyn ja -nopeuden analyysi." },
      { name: "BSS: B2B/Wholesale Solution", url: "https://apps.shopify.com/b2b-solution-custom-pricing?utm_source=RevenueHunt&utm_medium=partner-listing&utm_campaign=partnership-2024", logo: "/img/pages/partners/BSS-Commerce_logo_150.webp", description: "Kattava tukkuratkaisu. Saumaton B2B-ostokokemus, joka auttaa kauppiaita myös hallitsemaan tukkuasiakkaitaan ja saamaan heistä oivalluksia." },
      { name: "PreOrder Now WOD", url: "https://apps.shopify.com/preorder-now?utm_source=+revenuehunt&utm_medium=web&utm_campaign=partner&utm_id=crosspromo", logo: "/img/pages/partners/PreOrder-Now-Logo.webp", description: "Muuta loppuunmyydyt tilanteet ennakkotilausmahdollisuuksiksi. Täydellinen print-on-demand-yrityksille: kerää asiakkaan kiinnostus ilman alkuvarastoa." },
    ],
  },
  {
    heading: "Toimitus ja hankinta",
    emoji: "📦",
    intro: "Hankinnan, toimituksen ja logistiikan kumppaneita nopeampaan toimitukseen ja globaaliin skaalaukseen.",
    items: [
      { name: "Fulfillman", url: "https://www.fulfillman.com/", logo: "/img/pages/partners/fulfillmanlogo.webp", description: "Fulfillman on maailmanlaajuinen johtaja verkkokaupan hankinnassa, toimituksessa ja logistiikassa, tarjoten nopeita ja luotettavia toimituksia omistautuneiden private line -palveluiden kautta." },
      { name: "HyperSKU", url: "https://www.hypersku.com/", logo: "/img/pages/partners/150150-logo.webp", description: "HyperSKU tarjoaa kattavan toimitusketjuratkaisun. Yli 1M tuotetta, pakettimyynti, näytteenotto, laaduntarkastus, brändin räätälöinti ja automatisoitu tilausten toimitus." },
      { name: "Service Points", url: "https://www.servicepoints.eu/en/w2/smart-dropshipping-1?utm_source=revenuehunt&utm_medium=app&utm_id=31", logo: "/img/pages/partners/Logo-Black-background.webp", description: "Service Points esittelee SMART Dropshippingin: automatisoitu dropshipping ja dataan perustuvat toimitusketjupäätökset rajattomaan skaalaukseen." },
    ],
  },
  {
    heading: "Teemat ja design",
    emoji: "🎨",
    intro: "Premium-teemoja ja designia, jotka saavat kauppasi loistamaan.",
    items: [
      { name: "SalesHunterThemes", url: "https://saleshunterthemes.com/?utm_source=app-providers&utm_medium=revenuehunt&utm_campaign=partnership-app&utm_content=website", logo: "/img/pages/partners/saleshunterthemes-logo.webp", description: "Tehosta kauppaasi SalesHunterThemesin premium Shopify -teemoilla. Modernit ja responsiiviset ulkoasut, jotka optimoivat suorituskyvyn ja käyttäjäkokemuksen laajoilla mukautusvaihtoehdoilla." },
    ],
  },
  {
    heading: "Alustat ja hakemistot",
    emoji: "🧭",
    intro: "Alustoja ja hakemistoja, jotka auttavat kauppiaita löytämään oikeat työkalut.",
    items: [
      { name: "Taranker", url: "https://taranker.com/", logo: "/img/pages/partners/Icon512.webp", description: "Taranker on innovatiivinen alusta, joka auttaa verkkokauppoja löytämään parhaat työkalut toimintojensa optimointiin. Erikoistunut sovellussuosituksiin, asiantuntija-arvioihin ja kuratoituihin sovellusvalintoihin." },
    ],
  },
];

const perks = [
  { title: "Suosittelupalkkiot", body: "Hanki uusia asiakkaita RevenueHuntille ja ansaitse elinikäinen 20 %:n palkkio kaikesta heidän tuottamastaan liikevaihdosta." },
  { title: "Affiliate-linkit", body: "Lisää affiliate-linkkisi artikkeleihisi, uutiskirjeisiisi ja sosiaalisen median julkaisuihisi. Linkitä suoraan Shopify-, WooCommerce-, BigCommerce-, Magento- ja standalone-sovelluksiimme." },
  { title: "Oma partner manager", body: "Saat vinkkejä automatisoitujen myyntisuppiloiden luomiseen työkalullamme ja niksejä ratkaisumme myymiseen asiakkaillesi." },
  { title: "Eksklusiivista sisältöä", body: "Ota meihin yhteyttä saadaksesi vinkkejä automatisoitujen myyntisuppiloiden luomiseen asiakkaillesi RevenueHuntin ja muiden työkalujen avulla." },
  { title: "Paikka Partner Directoryssämme", body: "Käyttäjämme löytävät sinut Partner Directorystamme ja ottavat sinuun yhteyttä palkatakseen palvelusi." },
];

const faqs = [
  { q: "Paljonko partneriksi ryhtyminen maksaa?", a: "Rekisteröityminen on täysin ilmaista. Nolla. Ei mitään." },
  { q: "Pitääkö minun olla RevenueHuntin asiakas?", a: "Ei, sinun ei tarvitse olla RevenueHuntin asiakas tullaksesi partneriksi." },
  { q: "Miten minulle maksetaan?", a: "Maksamme ansiot kuukausittain. Maksut lähetetään PayPalin kautta." },
  { q: "Miten voin seurata suositteluitani?", a: "Voit nähdä tilastosi Partner Dashboardissasi." },
];

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Etusivu", url: "/" },
    { name: "Partnerit ja affiliatet", url: "/partners/" },
  ]),
];
---

<Base
  title="Partneriohjelma - RevenueHunt"
  description="Suosittele asiakkaillesi. Ansaitse rahaa. Saat elinikäisen 20 %:n palkkion asiakkaista, jotka suosittelet RevenueHuntille. Rekisteröidy ilmaiseksi partneriohjelmaamme."
  jsonLd={jsonLd}
  lang="fi"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20 text-center">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={localizedHref("/", "fi")} class="hover:text-slate-700">Etusivu</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Partnerit ja affiliatet</span>
      </nav>
      <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">Partneriohjelma</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Suosittele asiakkaillesi. Ansaitse rahaa.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-xl text-slate-600">
        Ansaitse elinikäinen 20 %:n palkkio asiakkaista, jotka suosittelet meille. Rekisteröidy ilmaiseksi partneriohjelmaamme jo tänään.
      </p>
      <p class="mx-auto mt-6 max-w-3xl text-slate-600">
        Jos olet <strong class="font-semibold text-slate-900">digitaalisen markkinoinnin toimisto</strong> tai
        <strong class="font-semibold text-slate-900">eCommerce-asiantuntija</strong> ja haluat kasvattaa liiketoimintaasi,
        partneriohjelmamme on sinua varten. Luo upeita kokemuksia asiakkaillesi RevenueHuntin avulla.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
        >
          Aloita nyt
        </a>
        <a
          href="#partners"
          class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
        >
          Katso partnerimme
        </a>
      </div>
    </div>
  </section>

  <!-- Who you are + perks -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-1">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Kuka olet</h2>
        <p class="mt-4 text-slate-600">
          Olet digitaalisen markkinoinnin toimisto tai eCommerce-konsultti, joka on intohimoinen suunnittelusta ja pakkomielteinen
          <strong class="font-semibold text-slate-900">parhaiden tulosten saavuttamiseen</strong> asiakkaillesi. Kasvatat
          liiketoimintaasi vauhdittamalla muiden liiketoimintaa.
        </p>
      </div>
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Mitä saat meiltä</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {perks.map((p) => (
            <li class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="text-base font-semibold text-slate-900">{p.title}</h3>
              <p class="mt-2 text-sm text-slate-600">{p.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Partner directory -->
  <section id="partners" class="mx-auto max-w-7xl px-6 py-16 scroll-mt-24">
    <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Partnerimme</h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
      Luotettavia sovelluksia ja toimistoja, jotka sopivat täydellisesti yhteen RevenueHuntin kanssa asiakkaillesi.
    </p>
    <div class="mt-12 space-y-16">
      {groups.map((g) => (
        <div>
          <div class="mb-2 flex items-baseline gap-3">
            <span class="text-2xl" aria-hidden="true">{g.emoji}</span>
            <h3 class="text-2xl font-semibold tracking-tight text-slate-900">{g.heading}</h3>
          </div>
          <p class="max-w-3xl text-slate-600">{g.intro}</p>
          <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {g.items.map((p) => (
        <li>
          <a
            href={p.url}
            target="_blank"
            rel="external noopener nofollow"
            class="group flex h-full flex-col items-center rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm transition hover:border-slate-300 hover:shadow-md"
          >
            <img
              src={p.logo}
              alt={`${p.name} logo`}
              loading="lazy"
              width="120"
              height="120"
              class="h-24 w-24 rounded-full object-cover"
            />
            <h3 class="mt-5 text-lg font-semibold text-slate-900 group-hover:text-[#16161D]">{p.name}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{p.description}</p>
            <span class="mt-5 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wider text-slate-500 group-hover:text-[#16161D]">
              Vieraile sivustolla <span aria-hidden="true">↗</span>
            </span>
          </a>
        </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Usein kysytyt kysymykset</h2>
      <div class="mx-auto mt-8 max-w-2xl">
        {faqs.map((f) => (
          <details class="border-b border-slate-200">
            <summary class="py-4 text-base font-semibold text-slate-900">{f.q}</summary>
            <p class="pb-4 text-slate-600">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Tule RevenueHuntin partneriksi
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        Suosittele asiakkaillesi, luo automatisoituja myyntisuppiloita ja ansaitse elinikäinen 20 %:n palkkio kaikesta, mitä he kuluttavat.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          Aloita nyt
        </a>
        <a
          href={localizedHref("/demo/", "fi")}
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          Varaa demo
        </a>
      </div>
    </div>
  </section>
</Base>
