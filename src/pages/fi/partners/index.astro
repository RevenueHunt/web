---
import Base from "../../../layouts/Base.astro";
import PageHero from "../../../components/PageHero.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import PartnerCard from "../../../components/PartnerCard.astro";
import { organization, breadcrumb } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

interface Partner {
  name: string;
  url: string;
  logo: string;
  description: string;
}

const groups: { heading: string; emoji: string; intro: string; items: Partner[] }[] = [
  {
    heading: "Lokalisointi",
    emoji: "🌍",
    intro: "Myy rajojen yli sisäänrakennetulla paikannuksella, käännöksillä ja monivaluuttatuella.",
    items: [
      { name: "Orbe Shopify Geolocation", url: "https://apps.shopify.com/orbe?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/orbe-removebg-preview.webp", description: "Maksimoi globaali myynti edistyneellä Shopify-geopaikannuksella. Mukauta tuotteet, hinnat, valuutta ja sisältö jokaiselle maalle ja ohjaa asiakkaat oikeaan ostokokemukseen Orbella." },
    ],
  },
  {
    heading: "Chat ja tuki",
    emoji: "💬",
    intro: "Asiakastilityökaluja, jotka tekevät itsepalvelusta ja tuesta vaivatonta.",
    items: [
      { name: "Dondy WhatsApp Marketing & Chat", url: "https://apps.shopify.com/dondy-marketing-ai?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/dondy-logo.webp", description: "Muuta menetetty liikenne tuotoiksi automatisoiduilla WhatsApp-virtauksilla palautukseen, vahvistukseen ja sitouttamiseen – sekä tekoälyagentilla, joka hoitaa asiakaspalvelun tiimisi puolesta." },
    ],
  },
  {
    heading: "Lisämyynti ja suositukset",
    emoji: "🎯",
    intro: "Kasvata keskiostosta ostoskorin lisämyynnillä, toivelistoilla ja ennakkotilauksilla.",
    items: [
      { name: "Smart Size Chart & Fit Finder", url: "https://smartsize.io/?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/smartsize-logo.webp", description: "Luo tekoälypohjaisia kokotaulukoita, koko-oppaita ja 'löydä kokoni' -kyselyitä minuuteissa - vähennä kokokysymyksiä ja palautuksia ja paranna konversiota." },
      { name: "WC Wishlist Club", url: "https://apps.shopify.com/wishlist-club?utm_source=RevenueHunt&utm_medium=partnership&utm_campaign=partnership", logo: "/img/pages/partners/wishlist-club-150-150-px-logo.webp", description: "WC Wishlist Club antaa asiakkaidesi tallentaa suosikkituotteensa, jakaa toivelistoja ja ostaa myöhemmin, lisäten sitoutumista ja myyntiä. Helppo asentaa, mobiiliystävällinen ja täydellinen pelkkien katselijoiden muuttamiseen uskollisiksi ostajiksi." },
      { name: "iCart Cart Drawer Cart Upsell", url: "https://apps.shopify.com/icart/?campaign=promotion&medium=in-app-banner&source=revenuehunt&utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/iCart-Cart-Drawer-Cart-Upsell-logo.webp", description: "Kattava Shopify-sovellus ostoskorilaatikon ja koko ostoskorisivun mukauttamiseen upsellillä, tuotesuosituksilla, edistymispalkilla, tuotepaketeilla ja alennuksilla." },
    ],
  },
  {
    heading: "Hinnoittelu ja alennukset",
    emoji: "🏷️",
    intro: "Paketit, määräalennukset ja B2B-hinnat, jotka palkitsevat suuremmista ostoskoreista.",
    items: [
      { name: "Kaching Bundle Quantity Deals", url: "https://apps.shopify.com/bundle-deals?utm_source=RevenueHunt&utm_medium=partnership&utm_campaign=REVENUEH", logo: "/img/pages/partners/Kaching-Logo-1024x1024.webp", description: "Vauhdita myyntiä Kaching Bundle Quantity Dealsilla: luo pakettitarjouksia suoraan tuotesivullasi. Käytä koodia REVENUEH20 saadaksesi eksklusiivisen 20 %:n alennuksen." },
      { name: "BSS: B2B/Wholesale Solution", url: "https://apps.shopify.com/b2b-solution-custom-pricing?utm_source=RevenueHunt&utm_medium=partnership&utm_campaign=partnership-2024", logo: "/img/pages/partners/BSS-Commerce_logo_150.webp", description: "Kattava tukkuratkaisu. Saumaton B2B-ostokokemus, joka auttaa kauppiaita myös hallitsemaan tukkuasiakkaitaan ja saamaan heistä oivalluksia." },
    ],
  },
  {
    heading: "Markkinointi ja ponnahdusikkunat",
    emoji: "📣",
    intro: "Sosiaalinen todiste, kumppanuusohjelmat ja sivuston kampanjat, jotka kasvattavat myyntiä.",
    items: [
      { name: "UpPromote: Affiliate & Referral", url: "https://partners.secomapp.com/apps/affiliate/SHOPQUIZ_APP", logo: "/img/pages/partners/NEW_logo-1.webp", description: "UpPromote on Shopify App Storen suositelluin affiliate-/suosittelusovellus. Kattava ratkaisu markkinointikampanjoidesi luomiseen ja hallintaan, sopii kaiken kokoisille yrityksille." },
    ],
  },
  {
    heading: "Kanta-asiakkuus ja sitouttaminen",
    emoji: "💎",
    intro: "Kanta-asiakasohjelmat, palkinnot ja myymäläkrediitit, jotka muuttavat ensiostajat palaaviksi asiakkaiksi.",
    items: [
      { name: "Flits Loyalty Rewards Program", url: "https://apps.shopify.com/flits?utm_source=revenuehunt&utm_medium=website&utm_id=app-partnership&utm_content=partner-page", logo: "/img/pages/partners/flits-logo.webp", description: "Flits rakentaa kanta-asiakas- ja palkinto-ohjelman, jossa on pisteet, VIP-tasot, suosittelut ja myymäläkrediitit, mikä parantaa asiakaspysyvyyttä ja elinkaaren arvoa. Ei koodia, toimii jokaisella sivulla ja laitteella." },
    ],
  },
  {
    heading: "Toimitus ja logistiikka",
    emoji: "📦",
    intro: "Hankinta, logistiikka ja ilmaisen toimituksen kannustimet nopeampaan toimitukseen ja skaalaukseen.",
    items: [
      { name: "Essential Free Shipping Bar", url: "https://apps.shopify.com/essential-order-value-booster?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/freeshippingbarlogo.webp", description: "Kasvata myyntiä ja AOV:ta luomalla rajattomasti ilmaisen toimituksen palkkeja useilla ostoskorin arvotavoitteilla kannustaaksesi ostajia lisäämään tuotteita." },
      { name: "HyperSKU", url: "https://apps.shopify.com/hypersku?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/150150-logo.webp", description: "HyperSKU tarjoaa kattavan toimitusketjuratkaisun. Yli 1M tuotetta, pakettimyynti, näytteenotto, laaduntarkastus, brändin räätälöinti ja automatisoitu tilausten toimitus." },
    ],
  },
  {
    heading: "Analytiikka ja raportointi",
    emoji: "📊",
    intro: "SEO-tietoja ja tilausdataa, joilla mittaat mikä toimii ja raportoit siitä.",
    items: [
      { name: "AI SEO Optimizer", url: "https://share.seoant.com/app/1165b75b7ce1524D5J", logo: "/img/pages/partners/SEOAnt-_-AI-SEO-Optimizer_Channelwill-.webp", description: "Paras SEO-sovellus Shopifylle: optimoi avainsanat, paranna meta-tageja ja viimeistele sivuston rakenne. AI-pohjainen SEO-suorituskyvyn ja -nopeuden analyysi." },
    ],
  },
];

const perks = [
  { title: "Suosittelupalkkiot", body: "Hanki uusia asiakkaita RevenueHuntille ja ansaitse elinikäinen 20 %:n palkkio kaikesta heidän tuottamastaan liikevaihdosta." },
  { title: "Affiliate-linkit", body: "Lisää affiliate-linkkisi artikkeleihisi, uutiskirjeisiisi ja sosiaalisen median julkaisuihisi. Linkitä suoraan Shopify-, WooCommerce-, BigCommerce-, Magento- ja standalone-sovelluksiimme." },
  { title: "Oma partner manager", body: "Saat vinkkejä automatisoitujen myyntisuppiloiden luomiseen työkalullamme ja niksejä ratkaisumme myymiseen asiakkaillesi." },
  { title: "Eksklusiivista sisältöä", body: "Ota meihin yhteyttä saadaksesi vinkkejä automatisoitujen myyntisuppiloiden luomiseen asiakkaillesi RevenueHuntin ja muiden työkalujen avulla." },
  { title: "Paikka Partner Directoryssämme", body: "Käyttäjämme löytävät sinut Partner Directorystamme ja ottavat sinuun yhteyttä palkatakseen palvelusi." },
];

const faqs = [
  { q: "Paljonko partneriksi ryhtyminen maksaa?", a: "Rekisteröityminen on täysin ilmaista. Nolla. Ei mitään." },
  { q: "Pitääkö minun olla RevenueHuntin asiakas?", a: "Ei, sinun ei tarvitse olla RevenueHuntin asiakas tullaksesi partneriksi." },
  { q: "Miten minulle maksetaan?", a: "Maksamme ansiot kuukausittain. Maksut lähetetään PayPalin kautta." },
  { q: "Miten voin seurata suositteluitani?", a: "Voit nähdä tilastosi <a href='https://admin.revenuehunt.com/' target='_blank' rel='external noopener' class='font-semibold text-[#16161D] underline'>Partner Dashboardissasi</a>." },
];

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Etusivu", url: "/" },
    { name: "Partnerit ja affiliatet", url: "/partners/" },
  ]),
];
---

<Base
  title="Partneriohjelma - RevenueHunt"
  description="Suosittele asiakkaillesi. Ansaitse rahaa. Saat elinikäisen 20 %:n palkkion asiakkaista, jotka suosittelet RevenueHuntille. Rekisteröidy ilmaiseksi partneriohjelmaamme."
  jsonLd={jsonLd}
  lang="fi"
  translated={true}
>
  <!-- Hero -->
  <PageHero center>
      <Breadcrumb items={[{ label: "Etusivu", href: localizedHref("/", "fi") }, { label: "Partnerit ja affiliatet" }]} />
      <Eyebrow>Partneriohjelma</Eyebrow>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Suosittele asiakkaillesi. Ansaitse rahaa.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-xl text-slate-600">
        Ansaitse <strong class="font-semibold text-slate-900">elinikäinen 20 %:n palkkio</strong> asiakkaista, jotka suosittelet meille. Rekisteröidy ilmaiseksi partneriohjelmaamme jo tänään.
      </p>
      <p class="mx-auto mt-6 max-w-3xl text-slate-600">
        Jos olet <strong class="font-semibold text-slate-900">digitaalisen markkinoinnin toimisto</strong> tai
        <strong class="font-semibold text-slate-900">eCommerce-asiantuntija</strong> ja haluat kasvattaa liiketoimintaasi,
        partneriohjelmamme on sinua varten. Luo upeita kokemuksia asiakkaillesi RevenueHuntin avulla.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
        >
          Aloita nyt
        </a>
        <a
          href="#partners"
          class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
        >
          Katso partnerimme
        </a>
      </div>
  </PageHero>

  <!-- Who you are + perks -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-1">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Kuka olet</h2>
        <p class="mt-4 text-slate-600">
          Olet digitaalisen markkinoinnin toimisto tai eCommerce-konsultti, joka on intohimoinen suunnittelusta ja pakkomielteinen
          <strong class="font-semibold text-slate-900">parhaiden tulosten saavuttamiseen</strong> asiakkaillesi. Kasvatat
          liiketoimintaasi vauhdittamalla muiden liiketoimintaa.
        </p>
      </div>
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Mitä saat meiltä</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {perks.map((p) => (
            <li class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="text-base font-semibold text-slate-900">{p.title}</h3>
              <p class="mt-2 text-sm text-slate-600">{p.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Partner directory -->
  <section id="partners" class="mx-auto max-w-7xl px-6 py-16 scroll-mt-24">
    <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Partnerimme</h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
      Luotettavia sovelluksia ja toimistoja, jotka sopivat täydellisesti yhteen RevenueHuntin kanssa asiakkaillesi.
    </p>
    <div class="mt-12 space-y-16">
      {groups.map((g) => (
        <div>
          <div class="mb-2 flex items-baseline gap-3">
            <span class="text-2xl" aria-hidden="true">{g.emoji}</span>
            <h3 class="text-2xl font-semibold tracking-tight text-slate-900">{g.heading}</h3>
          </div>
          <p class="max-w-3xl text-slate-600">{g.intro}</p>
          <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {g.items.map((p) => (
        <PartnerCard {...p} alt={`${p.name} logo`} cta="Asenna sovellus" />
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Usein kysytyt kysymykset</h2>
      <div class="mx-auto mt-8 max-w-2xl">
        {faqs.map((f) => (
          <details class="border-b border-slate-200">
            <summary class="py-4 text-base font-semibold text-slate-900">{f.q}</summary>
            <p class="pb-4 text-slate-600" set:html={f.a}></p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Tule RevenueHuntin partneriksi
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        Suosittele asiakkaillesi, luo automatisoituja myyntisuppiloita ja ansaitse elinikäinen 20 %:n palkkio kaikesta, mitä he kuluttavat.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          Aloita nyt
        </a>
        <a
          href={localizedHref("/demo/", "fi")}
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          Varaa demo
        </a>
      </div>
    </div>
  </section>
</Base>
