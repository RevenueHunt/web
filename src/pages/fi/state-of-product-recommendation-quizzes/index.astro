---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb, article, faqPage } from "../../../lib/schema";
import { SITE } from "../../../lib/site";
import { localizedHref } from "../../../lib/i18n";
import {
  REPORT,
  DATASET,
  HEADLINE,
  VERTICAL_CONVERSION,
  AOV_UPLIFT,
  ATTRIBUTION,
  BASELINES,
  METHODOLOGY,
  FAQ,
} from "../../../lib/quiz-benchmarks";

const pageUrl = new URL(`/${REPORT.slug}/`, SITE.site_url).href;
const ogImage = `/og/${REPORT.slug}.png`;

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=state_of_product_quizzes";
// Free WordPress.org plugin (not the WooCommerce.com extension).
const WOO_PLUGIN =
  "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";

const formatN = (n: number | null) =>
  n === null ? "" : n.toLocaleString("en-US");

// Conversion expressed against a typical 2% store: 6.9% / 2% = 345%.
const boost = (rate: number) => Math.round((rate / HEADLINE.baselinePct) * 100);

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Etusivu", url: localizedHref("/", "fi") },
    { name: "Tuotesuosittelukyselyiden tila", url: localizedHref(`/${REPORT.slug}/`, "fi") },
  ]),
  article({
    title: `${REPORT.title}: ${REPORT.subtitle}`,
    description: REPORT.description,
    url: pageUrl,
    image: ogImage,
    datePublished: REPORT.datePublished,
    dateModified: REPORT.dateModified,
    author: "RevenueHunt",
    tags: [
      "tuotesuosittelukysely benchmark",
      "quiz conversion rate",
      "ecommerce personalization",
      "average order value",
    ],
  }),
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "RevenueHunt tuotesuosittelukysely benchmarks 2026",
    description: REPORT.description,
    url: pageUrl,
    creator: organization(),
    license: "https://creativecommons.org/licenses/by/4.0/",
    isAccessibleForFree: true,
    datePublished: REPORT.datePublished,
    keywords: [
      "tuotesuosittelukysely",
      "conversion rate",
      "average order value",
      "ecommerce",
      "Shopify",
    ],
    distribution: {
      "@type": "DataDownload",
      encodingFormat: "application/pdf",
      contentUrl: new URL(REPORT.pdfPath, SITE.site_url).href,
    },
  },
  faqPage(FAQ),
];

const publishedLabel = new Date(REPORT.datePublished).toLocaleDateString("fi-FI", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const consumable = VERTICAL_CONVERSION.filter((r) => r.kind === "consumable");
const considered = VERTICAL_CONVERSION.filter((r) => r.kind === "considered");
const grouped = VERTICAL_CONVERSION.find((r) => r.kind === "grouped")!;
const pooled = VERTICAL_CONVERSION.find((r) => r.kind === "total")!;
---

<Base
  title={`${REPORT.title}: ${REPORT.subtitle}`}
  description={REPORT.description}
  ogImage={ogImage}
  jsonLd={jsonLd}
  lang="fi"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={localizedHref("/", "fi")} class="hover:text-slate-700">Etusivu</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Tuotesuosittelukyselyiden tila</span>
      </nav>
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">
          Benchmark-raportti · {publishedLabel}
        </p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          Tuotesuosittelukyselyiden tila
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          1 jokaisesta 18 ostajasta, joka suorittaa tuotesuosittelukyselyn, tekee tilauksen, <strong>2,75 kertaa enemmän kuin tyypillinen verkkokauppa</strong>. Tämä raportti erittelee, mitkä kategoriat konvertoivat eniten, kuinka paljon enemmän kyselyn tekijät käyttävät rahaa ja kuinka kauan yksittäinen kysely tuottaa tulosta. Perustuu aitoon dataan: <strong>{DATASET.responses} kyselyvastausta</strong> {DATASET.brands} kaupassa.
        </p>
        {/* TODO: restore hero CTAs ("Download the PDF" + "Read the findings")
            once a peer reviews the PDF design. Removed 2026-06-08 to hold the
            PDF download until that review. The PDF is still generated and the
            "Cite this report" section's download link is also held (see below). */}
      </div>
    </div>
  </section>

  <!-- Dataset band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-2xl bg-[#16161D] px-6 py-10 sm:px-10">
        <p class="text-center text-sm font-semibold uppercase tracking-wider text-white/50">
          Tietoaineisto
        </p>
        <dl class="mt-6 grid grid-cols-1 gap-8 text-center sm:grid-cols-3">
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.responses}</dt>
            <dd class="mt-1 text-sm text-white/70">{DATASET.responsesNote}</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.revenue}</dt>
            <dd class="mt-1 text-sm text-white/70">{DATASET.revenueNote}</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.brands}</dt>
            <dd class="mt-1 text-sm text-white/70">{DATASET.brandsNote}</dd>
          </div>
        </dl>
        <p class="mx-auto mt-6 max-w-3xl text-center text-sm text-white/60">
          Koottu ja anonymisoitu, lähteistä {DATASET.platforms}. Yksittäistä kauppaa ei voi tunnistaa. Jokainen alla oleva luku on vähimmäismäärä: attribuutio kertyy edelleen, joten todelliset luvut ovat korkeampia.
        </p>
      </div>
    </div>
  </section>

  <!-- Key findings (stat cards) -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Tärkeimmät luvut</h2>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">{HEADLINE.completedConv}%</p>
          <p class="mt-2 font-medium text-slate-900">kyselyn suorittavista ostajista tekee tilauksen</p>
          <p class="mt-2 text-sm text-slate-600">Noin 1 jokaisesta {HEADLINE.completedOneIn}, noin {HEADLINE.multiple} kertaa tyypillinen {HEADLINE.baselinePct}%:n kauppa.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">+{AOV_UPLIFT.headlineLow}-{AOV_UPLIFT.headlineHigh}%</p>
          <p class="mt-2 font-medium text-slate-900">enemmän average order valueta, saman kaupan sisällä</p>
          <p class="mt-2 text-sm text-slate-600">Mitattu vastaavalla tavalla, läsnä noin 7 kaupassa 10:stä.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">{HEADLINE.completionRate}%</p>
          <p class="mt-2 font-medium text-slate-900">kyselyn aloittavista ostajista suorittaa sen loppuun</p>
          <p class="mt-2 text-sm text-slate-600">Noin 7 jokaisesta 10:stä pääsee tulossivulle. {HEADLINE.abandonRate}% keskeyttää aiemmin.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">1 / 5</p>
          <p class="mt-2 font-medium text-slate-900">kyselylle attribuoiduista tilauksista saapuu yli 30 päivää myöhemmin</p>
          <p class="mt-2 text-sm text-slate-600">Kysely tuottaa liikevaihtoa kuukausia sen suorittamisen jälkeen.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Conversion by category -->
  <section id="conversion" class="scroll-mt-20 bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Konversio kategorioittain</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        Alustan keskiarvo kätkee laajan hajonnan. <strong>Kulutus- ja täydennystavarakategoriat konvertoivat kaksin- tai kolminkertaisesti</strong> verrattuna keskimääräiseen verkkokauppaan. Kalliit, paljon harkintaa vaativat ostot konvertoivat suuruusluokkaa alempana: siellä kysely vauhdittaa löytämistä, mutta myynti tapahtuu myöhemmin, istunnon ulkopuolella.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">Kategoria</th>
              <th class="py-3 pr-4 text-right font-semibold">Konversio</th>
              <th class="py-3 pr-4 text-right font-semibold">Kyselyn konversion kasvu</th>
              <th class="py-3 text-right font-semibold">Vastaukset</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {consumable.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{r.rate}%</td>
                <td class="py-3 pr-4 text-right tabular-nums text-slate-600">{boost(r.rate)}%</td>
                <td class="py-3 text-right tabular-nums text-slate-500">{formatN(r.n)}</td>
              </tr>
            ))}
            {considered.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{r.rate}%</td>
                <td class="py-3 pr-4 text-right tabular-nums text-slate-600">{boost(r.rate)}%</td>
                <td class="py-3 text-right tabular-nums text-slate-500">{formatN(r.n)}</td>
              </tr>
            ))}
            <tr class="border-b border-slate-200">
              <td class="py-3 pr-4 font-medium">{grouped.vertical}</td>
              <td class="py-3 pr-4 text-right font-semibold tabular-nums">~{grouped.rate}%</td>
              <td class="py-3 pr-4 text-right tabular-nums text-slate-600">~{boost(grouped.rate)}%</td>
              <td class="py-3 text-right tabular-nums text-slate-500">{formatN(grouped.n)}</td>
            </tr>
            <tr class="border-t-2 border-slate-300">
              <td class="py-3 pr-4 font-semibold">{pooled.vertical}</td>
              <td class="py-3 pr-4 text-right font-bold tabular-nums">{pooled.rate}%</td>
              <td class="py-3 pr-4 text-right font-bold tabular-nums text-slate-600">{boost(pooled.rate)}%</td>
              <td class="py-3 text-right tabular-nums text-slate-500">kaikki</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        {grouped.note}
      </p>
      <p class="mx-auto mt-2 max-w-3xl text-sm text-slate-500 text-center">
        {pooled.note}
      </p>
    </div>
  </section>

  <!-- AOV uplift -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Käyttävätkö kyselyn tekijät enemmän rahaa?</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        <strong>Saman kaupan sisällä mitattuna</strong> kyselyn tilaukset ovat <strong>{AOV_UPLIFT.headlineLow}%:sta {AOV_UPLIFT.headlineHigh}%:iin suurempia</strong> kuin tilaukset ilman kyselyä, ja se pätee {AOV_UPLIFT.storesUpLow}%:sta {AOV_UPLIFT.storesUpHigh}%:iin kaupoista. Se ei ole universaalia: vahvempaa siellä, missä kysely voi koota setin tai rutiinin, lähes ennallaan siellä, missä osto on yksittäinen tuote.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">Kategoria</th>
              <th class="py-3 pr-4 text-right font-semibold">AOV:n kasvu kaupan sisällä</th>
              <th class="py-3 text-right font-semibold">Kaupat, joissa kasvua</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {AOV_UPLIFT.perVertical.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">
                  {r.uplift === null ? "Ennallaan" : `+${r.uplift}%`}
                </td>
                <td class="py-3 text-right tabular-nums text-slate-500">
                  {r.storesUp === null ? "ei tiet." : `${r.storesUp}%`}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        Mitattu kaupan sisällä (sama kauppa, kyselyn tilaukset vs. tilaukset ilman kyselyä), joten se on vakaa valuutan suhteen ja kontrolloi kaupan tuotemixin. Kolmiomitattu kolmesta riippumattomasta otoksesta mediaaneilla +11%, +15% ja +14%. Pieniotoksiset kategoriat jätetään pois sen sijaan, että niitä liioiteltaisiin.
      </p>
    </div>
  </section>

  <!-- Attribution / LTV -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Kysely tuottaa tulosta istunnon jälkeenkin</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        Useimmat attribuutiodashboardit arvioivat kyselyä saman päivän tilausten perusteella ja jäävät siihen. Se sivuuttaa suurimman osan arvosta. <strong>{ATTRIBUTION.sameDay}% ensimmäisistä kyselylle attribuoiduista tilauksista tapahtuu samana päivänä</strong>, mutta häntä on pitkä.
      </p>
      <div class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-4">
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.sameDay}%</p>
          <p class="mt-1 text-sm text-slate-600">samana päivänä</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.within7}%</p>
          <p class="mt-1 text-sm text-slate-600">7 päivän sisällä</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.within30}%</p>
          <p class="mt-1 text-sm text-slate-600">30 päivän sisällä</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">1 / 5</p>
          <p class="mt-1 text-sm text-slate-600">saapuu yli 30 päivää myöhemmin</p>
        </div>
      </div>
      <p class="mx-auto mt-6 max-w-3xl text-slate-700 text-center">
        Noin <strong>1 jokaisesta 5:stä kaikista kyselylle attribuoiduista tilauksista saapuu yli 30 päivää kyselyn jälkeen</strong>. Kysely ei ole pelkkä tönäisy kassalle: jokainen vastaus on zero-party-dataa, joka merkitsee ostajan ja syöttää segmentoituja jatkovirtoja ja uudelleenmarkkinointia. <a href="https://www.klaviyo.com/marketing-resources/segmentation-benchmark-report" target="_blank" rel="external noopener nofollow" class="font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]">Segmentoidut kampanjat tuottavat yli 3 kertaa enemmän liikevaihtoa vastaanottajaa kohden</a> kuin geneeriset lähetykset, joten yksittäinen kysely jatkaa konvertointia sähköpostin ja personoitujen mainosten kautta kuukausia.
      </p>
    </div>
  </section>

  <!-- Baseline context -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Mikä lasketaan "keskimääräiseksi kaupaksi"</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        eCommerce-konversiolle ei ole yhtä ainoaa totuudenmukaista lukua: se vaihtelee menetelmän ja otoksen mukaan. Rehellinen vaihteluväli on noin 1,6%:sta 2,9%:iin. Vertaamme pyöreään <strong>{HEADLINE.baselinePct}%</strong>:iin, konservatiiviseen alapäähän, mikä sijoittaa kyselyn tekijät noin <strong>{HEADLINE.multiple} kertaa</strong> keskimääräisen kaupan tasolle.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">Lähde</th>
              <th class="py-3 pr-4 text-right font-semibold">Keskimääräinen konversio</th>
              <th class="py-3 font-semibold">Laajuus</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {BASELINES.map((b) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">
                  <a href={b.href} target="_blank" rel="external noopener nofollow" class="text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-slate-500">{b.source}</a>
                </td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{b.rate}</td>
                <td class="py-3 text-sm text-slate-600">{b.scope}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        Tärkeää: 5,5%:mme on kyselyn tekijää kohden laskettu prosentti (tilaukset suoritettua kyselyä kohden), kun taas jokainen yllä oleva luku on koko sivuston prosentti (tilaukset kävijää kohden). Kyselyn tekijät valikoituvat itse, joten osa erosta on suppilo, ei pelkkä kysely. Esitämme vertailun suoraan sen sijaan, että kaunistelisimme sitä.
      </p>
    </div>
  </section>

  <!-- Methodology -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Menetelmä</h2>
      <ul class="mt-8 space-y-5" role="list">
        {METHODOLOGY.map((m) => (
          <li class="flex gap-3">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400" aria-hidden="true"></span>
            <p class="text-slate-700">{m}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Usein kysytyt kysymykset</h2>
      <div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
        {FAQ.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-lg font-semibold text-slate-900 [&::-webkit-details-marker]:hidden">
              <span>{f.question}</span>
              <svg
                class="h-5 w-5 flex-shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <p class="pb-5 text-slate-700" set:html={f.answerHtml ?? f.answer} />
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* TODO: restore the entire "Cite this report" section (PDF download +
      shareable stat-card links) once a designer reviews the report + PDF + card
      designs. Removed 2026-06-08 to hold the downloadable assets until review.
      The PDF and card PNGs are still generated by `bun run report`. */}

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Mittaa kasvu omassa kaupassasi.
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-white/70">
        RevenueHunt on ilmainen aloittaa, 100 kyselyvastauksella kuukaudessa. Luo kysely, ohjaa liikennettä sen läpi ja lue omat lukusi.
      </p>
      <p class="mx-auto mt-4 max-w-2xl text-white/60">
        Katso, mitä nämä benchmarkit voisivat tuoda kauppaasi <a href={localizedHref("/quiz-roi-calculator/", "fi")} class="font-medium text-white underline decoration-white/40 underline-offset-2 hover:decoration-white">kyselyn ROI-laskurillamme</a>.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SHOPIFY_INSTALL}
          target="_blank"
          rel="external noopener nofollow"
