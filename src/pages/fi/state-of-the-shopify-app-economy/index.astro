</Base>

<script>
  import Chart from "chart.js/auto";
  import { GROWTH, REVIEWS, REVENUE, PRICING, GEOGRAPHY, NICHES, COLORS, CHART_LABELS } from "../../../lib/app-economy";

  Chart.defaults.font.family =
    "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif";
  Chart.defaults.color = "#475569";
  Chart.defaults.font.size = 13;

  const el = (id: string) => document.getElementById(id) as HTMLCanvasElement | null;
  const grid = "#eef0f2";
  const kfmt = (v: number) => (v >= 1000 ? v / 1000 + "K" : "" + v);
  const L = CHART_LABELS[document.documentElement.lang] ?? CHART_LABELS.en;

  const growth = el("c-growth");
  if (growth)
    new Chart(growth, {
      type: "line",
      data: {
        labels: GROWTH.labels,
        datasets: [
          {
            data: GROWTH.cumulative,
            borderColor: COLORS.primary,
            backgroundColor: "rgba(97,110,255,0.10)",
            fill: true,
            tension: 0.35,
            borderWidth: 2.5,
            pointRadius: 3,
            pointHoverRadius: 5,
            pointBackgroundColor: COLORS.primary,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: { callbacks: { label: (c) => Number(c.parsed.y).toLocaleString() + " apps live" } },
        },
        scales: {
          y: { beginAtZero: true, grid: { color: grid }, ticks: { callback: (v) => kfmt(Number(v)) } },
          x: { grid: { display: false } },
        },
      },
    });

  const donutOpts = (suffix: string) => ({
    responsive: true,
    maintainAspectRatio: false,
    cutout: "62%",
    plugins: {
      legend: { position: "bottom" as const, labels: { boxWidth: 12, boxHeight: 12, padding: 16 } },
      tooltip: { callbacks: { label: (c: any) => `${c.label}: ${c.parsed}${suffix}` } },
    },
  });

  const reviews = el("c-reviews");
  if (reviews)
    new Chart(reviews, {
      type: "doughnut",
      data: { labels: L.reviews, datasets: [{ data: REVIEWS.values, backgroundColor: REVIEWS.colors, borderWidth: 0 }] },
      options: {
        ...donutOpts("%"),
        plugins: {
          legend: { position: "bottom" as const, labels: { boxWidth: 12, boxHeight: 12, padding: 16 } },
          tooltip: {
            callbacks: {
              title: (it: any) => L.reviewsTip.title.replace("{x}", it[0].label),
              label: (c: any) => L.reviewsTip.body.replace("{n}", REVIEWS.counts[c.dataIndex].toLocaleString()).replace("{p}", c.parsed),
            },
          },
        },
      },
    });

  const revDonut = el("c-revenue-donut");
  if (revDonut)
    new Chart(revDonut, {
      type: "doughnut",
      data: { labels: L.revenueDonut, datasets: [{ data: REVENUE.donut.values, backgroundColor: REVENUE.donut.colors, borderWidth: 0 }] },
      options: donutOpts("%"),
    });

  const revCountries = el("c-revenue-countries");
  if (revCountries)
    new Chart(revCountries, {
      type: "doughnut",
      data: { labels: L.revenueCountries, datasets: [{ data: REVENUE.countries.values, backgroundColor: REVENUE.countries.colors, borderWidth: 0 }] },
      options: {
        ...donutOpts("%"),
        plugins: {
          legend: { position: "bottom" as const, labels: { boxWidth: 12, boxHeight: 12, padding: 16 } },
          tooltip: { callbacks: { title: (it: any) => L.revenueCountriesFull[it[0].dataIndex], label: (c: any) => `${L.revenueCountriesFull[c.dataIndex]}: ${c.parsed}%` } },
        },
      },
    });

  const pricing = el("c-pricing");
  if (pricing)
    new Chart(pricing, {
      type: "doughnut",
      data: { labels: L.pricing, datasets: [{ data: PRICING.values, backgroundColor: PRICING.colors, borderWidth: 0 }] },
      options: donutOpts("%"),
    });

  // The "by review tier" chart shows the top 10 builders by whatever tiers are
  // toggled on, drawn from the full GEOGRAPHY.builders pool (16 countries). So
  // toggling tiers can swap countries in and out: showing only "0 reviews"
  // surfaces the biggest noise generators (Pakistan), only "10+" surfaces Israel
  // and Singapore. geoTopTen ranks the pool for a given tier visibility
  // [zero, low, mid, high, vhigh]; applyGeoTop pushes the result into the chart.
  const geoCountry = (en: string) => L.geoCountries?.[en] ?? en;
  const geoPool = GEOGRAPHY.builders.labels.map((label: string, i: number) => ({
    label: geoCountry(label),
    tiers: [GEOGRAPHY.builders.zero[i], GEOGRAPHY.builders.low[i], GEOGRAPHY.builders.mid[i], GEOGRAPHY.builders.high[i], GEOGRAPHY.builders.vhigh[i]],
  }));
  const geoTopTen = (vis: boolean[]) =>
    geoPool
      .map((c: any) => ({
        ...c,
        sum: c.tiers.reduce((s: number, v: number, t: number) => s + (vis[t] ? v : 0), 0),
      }))
      .sort((a: any, b: any) => b.sum - a.sum)
      .slice(0, 10);
  const applyGeoTop = (chart: any) => {
    const top = geoTopTen([0, 1, 2, 3, 4].map((t) => chart.isDatasetVisible(t)));
    chart.data.labels = top.map((c: any) => c.label);
    [0, 1, 2, 3, 4].forEach((t) => {
      chart.data.datasets[t].data = top.map((c: any) => c.tiers[t]);
    });
  };

  const geoTiers = L.geoTiers ?? CHART_LABELS.en.geoTiers!;
  const geoInit = geoTopTen([true, true, true, true, true]);
  const geo = el("c-geography");
  if (geo)
    new Chart(geo, {
      type: "bar",
      data: {
        labels: geoInit.map((c: any) => c.label),
        datasets: [
          { label: geoTiers[0], data: geoInit.map((c: any) => c.tiers[0]), backgroundColor: "#e2e8f0", borderWidth: 0 },
          { label: geoTiers[1], data: geoInit.map((c: any) => c.tiers[1]), backgroundColor: COLORS.gray, borderWidth: 0 },
          { label: geoTiers[2], data: geoInit.map((c: any) => c.tiers[2]), backgroundColor: COLORS.secondary, borderWidth: 0 },
          { label: geoTiers[3], data: geoInit.map((c: any) => c.tiers[3]), backgroundColor: "#579cff", borderWidth: 0 },
          { label: geoTiers[4], data: geoInit.map((c: any) => c.tiers[4]), backgroundColor: COLORS.primary, borderWidth: 0 },
        ],
      },
      options: {
        indexAxis: "y",
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: "bottom" as const,
            labels: { boxWidth: 12, boxHeight: 12, padding: 14 },
            onClick(_e, item, legend) {
              const ch = legend.chart;
              const i = item.datasetIndex ?? 0;
              ch.setDatasetVisibility(i, !ch.isDatasetVisible(i));
              applyGeoTop(ch);
              ch.update();
            },
          },
          tooltip: { callbacks: { label: (c) => `${c.dataset.label}: ${Number(c.parsed.x).toLocaleString()}` } },
        },
        scales: {
          x: { stacked: true, beginAtZero: true, grid: { color: grid }, ticks: { callback: (v) => kfmt(Number(v)) } },
          y: { stacked: true, grid: { display: false } },
        },
      },
    });

  // Sectors: every sector's apps stacked by the 5 review tiers, bar length = the
  // sector's total app count. Same absolute view as the geography chart, and like
  // it the bars re-sort (largest first) by the visible total whenever a tier is
  // toggled in the legend. nicheSorted ranks the pool for a tier-visibility mask;
  // applyNicheSort pushes the result (labels + per-tier data) into the chart.
  const nicheLabels = L.niches ?? CHART_LABELS.en.niches!;
  const nichePool = NICHES.tiers.map((tiers: number[], i: number) => ({ label: nicheLabels[i], tiers }));
  const nicheSorted = (vis: boolean[]) =>
    nichePool
      .map((r: any) => ({ ...r, sum: r.tiers.reduce((s: number, v: number, t: number) => s + (vis[t] ? v : 0), 0) }))
      .sort((a: any, b: any) => b.sum - a.sum);
  const nicheRowLabel = (r: any) => r.label;
  const applyNicheSort = (chart: any) => {
    const rows = nicheSorted([0, 1, 2, 3, 4].map((t) => chart.isDatasetVisible(t)));
    chart.data.labels = rows.map(nicheRowLabel);
    [0, 1, 2, 3, 4].forEach((t) => {
      chart.data.datasets[t].data = rows.map((r: any) => r.tiers[t]);
    });
  };
  const niches = el("c-niches");
  if (niches) {
    const nicheInit = nicheSorted([true, true, true, true, true]);
    new Chart(niches, {
      type: "bar",
      data: {
        labels: nicheInit.map(nicheRowLabel),
        datasets: [0, 1, 2, 3, 4].map((t) => ({
          label: geoTiers[t],
          data: nicheInit.map((r: any) => r.tiers[t]),
          backgroundColor: REVIEWS.colors[t],
          borderWidth: 0,
        })),
      },
      options: {
        indexAxis: "y",
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: "bottom" as const,
            labels: { boxWidth: 12, boxHeight: 12, padding: 14 },
            onClick(_e, item, legend) {
              const ch = legend.chart;
              const i = item.datasetIndex ?? 0;
              ch.setDatasetVisibility(i, !ch.isDatasetVisible(i));
              applyNicheSort(ch);
              ch.update();
            },
          },
          tooltip: {
            callbacks: {
              label: (c) => {
                const v = Number(c.parsed.x);
                const tot = c.chart.data.datasets.reduce((s: number, d: any, t: number) => s + (c.chart.isDatasetVisible(t) ? Number(d.data[c.dataIndex]) : 0), 0);
                return `${c.dataset.label}: ${v.toLocaleString()} (${tot ? Math.round((100 * v) / tot) : 0}%)`;
              },
            },
          },
        },
        scales: {
          x: { stacked: true, beginAtZero: true, grid: { color: grid }, ticks: { callback: (v) => kfmt(Number(v)) } },
          y: { stacked: true, grid: { display: false } },
        },
      },
    });
  }
</script>
