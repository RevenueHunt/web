---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb, article, faqPage } from "../../../lib/schema";
import { SITE } from "../../../lib/site";
import { localizedHref } from "../../../lib/i18n";
import {
  REPORT,
  SOURCE,
  HEADLINE,
  GROWTH,
  REVIEWS,
  REVENUE,
  PRICING,
  GEOGRAPHY,
  NICHES,
  QUIZ_LANE,
} from "../../../lib/app-economy";

const pageUrl = new URL(`/fi/${REPORT.slug}/`, SITE.site_url).href;
const ogImage = `/og/${REPORT.slug}.png`;

const publishedLabel = new Date(REPORT.datePublished).toLocaleDateString("fi-FI", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const title = "Shopifyn sovellustalouden tila";
const description =
  "Shopify App Storessa on 22 546 aktiivista sovellusta, eivätkä lähes mitkään niistä pääse mihinkään. Datapohjainen raportti kasvusta, arvosteluista, tulojen keskittymisestä, hinnoittelusta ja siitä, kuka ne tekee - pohjautuen tilannekuvaan jokaisesta aktiivisesta sovelluksesta.";

// Methodology + FAQ, translated. The lead clause of each methodology note is
// bolded inline (the English source bolded it via string replace, which cannot
// match translated text). Defined before jsonLd so faqPage(FAQ) can use it.
const METHODOLOGY = [
  "<strong>Lähde:</strong> tilannekuva julkisesta Shopify App Storesta, 22 546 aktiivista sovelluslistausta, otettu kesäkuussa 2026. Jokainen kenttä on peräisin julkisesta listauksesta, ei Shopifyn sisäisestä datasta eikä minkään kauppiaan tililtä.",
  "<strong>Tulot on arvioitu, ei mitattu.</strong> Ne on mallinnettu kunkin sovelluksen julkaistuista hinnoittelutasoista yhdessä arvostelu- ja asennussignaalien kanssa. Käsittele tuloluvut suuntaa antavana mallina siitä, kuinka keskittyneitä ansiot ovat, älä laskutusdatana. Ne on merkitty sanalla \"arvioitu\" kaikkialla, missä ne esiintyvät.",
  "<strong>Kasvu pohjautuu kunkin listauksen julkaistuun julkaisupäivään.</strong> Lähteeseen kasaantui noin 2 800 julkaisupäivää toukokuussa 2026, joten käyrä luetaan aktiivisten sovellusten kumulatiivisena määränä vuoden mukaan (päätepiste on todellinen nykyinen kokonaismäärä), ja luku \"6 000+ viimeisen 12 kuukauden aikana\" karsii tuon yhden kuukauden vääristymän.",
  "<strong>Arvostelut ovat vetovoiman mittari, eivät täydellinen sellainen:</strong> loistava sovellus voi olla uusi, ja arvostelumäärät laahaavat todellisen käytön perässä. Käytämme niitä, koska ne ovat selkein julkinen, vertailukelpoinen signaali todellisesta kauppiaspohjasta kaikkien 22 546 sovelluksen joukossa.",
  "App Storen kategoriat ovat ominaisuustunnisteita, jotka sovellus voi lisätä itselleen, ja monella sovelluksella niitä on useita tai ei lainkaan. Sektorinäkymää varten ryhmittelemme sukulaistunnisteet laajoiksi kaistoiksi ja deduplikoimme sovellukset kunkin sisällä; sovellus voi kuulua useampaan, joten sektorit menevät päällekkäin eivätkä ole toisensa poissulkevia, ja luemme ne suuntaa-antavina. Kaikkialla muualla nojaamme yksiselitteisiin leikkauksiin (arvostelut, hinnat, julkaisupäivä, kehittäjän maa).",
];

const FAQ = [
  {
    question: "Kuinka monta sovellusta Shopify App Storessa on?",
    answer:
      "22 546 aktiivista sovellusta tässä kesäkuun 2026 tilannekuvassa. Store on kasvanut noin 10-kertaiseksi vuodesta 2020 ja kasvanut yli 6 000 sovelluksella pelkästään viimeisen 12 kuukauden aikana, noin 1 jokaisesta 4:stä kaikesta tällä hetkellä aktiivisesta. Tekoälyavusteinen kehitys muutti aiemmin puolen vuoden rakennusurakan viikonlopun työksi.",
  },
  {
    question: "Miksi useimmat Shopify-sovellukset epäonnistuvat?",
    answer:
      "Rakentaminen ei ole enää pullonkaula, joten store tulvii sovelluksia, jotka eivät koskaan löydä kauppiaspohjaa. 51 %:lla on nolla arvostelua ja 81 %:lla alle 10. Harvinaista on jakelu ja luottamus: tukikysymyksiin vastaaminen, arvostelujen ansaitseminen kauppias kerrallaan, paikalla oleminen vuosikausia. Sitä osaa tekoäly ei voi tehdä puolestasi.",
  },
  {
    question: "Kuinka paljon Shopify-sovellukset ansaitsevat?",
    answer:
      "Ansiot ovat äärimmäisen keskittyneitä. Arviomme mukaan sovellusten ylin 1 % (225 niistä) vie noin 72 % kaikista sovellustuloista, ja pelkästään 10 parasta vie lähes 30 %. Vain noin 36 % sovelluksista näyttää ansaitsevan yhtään mitään. Tulot on tässä arvioitu julkisesta hinnoittelusta ja käyttösignaaleista, ei laskutusdatasta.",
  },
  {
    question: "Ovatko useimmat Shopify-sovellukset ilmaisia?",
    answer:
      "Käytännössä kyllä. 46,9 % on ilmaisia ja toiset 48,6 % aloittavat ilmaisella kokeilulla; vain 4,5 % veloittaa rahaa etukäteen. Lähes 45 % tarjoaa pysyvästi ilmaisen tason. Shopify App Storessa ilmainen sisäänpääsy ei ole kasvutaktiikka, vaan perusodotus.",
  },
  {
    question: "Mistä voin nähdä taustalla olevan datan?",
    answer:
      "Luvut ovat peräisin tilannekuvasta, jota ylläpidämme jokaisesta aktiivisesta Shopify-sovelluksesta: julkaisupäivät, arvostelut, hinnoittelu, Built for Shopify -merkki ja kehittäjän maa. Jos rakennat Shopifyn päälle ja haluat tietyn leikkauksen, ota yhteyttä.",
    answerHtml:
      "Luvut ovat peräisin tilannekuvasta, jota ylläpidämme jokaisesta aktiivisesta Shopify-sovelluksesta: julkaisupäivät, arvostelut, hinnoittelu, Built for Shopify -merkki ja kehittäjän maa. Jos rakennat Shopifyn päälle ja haluat tietyn leikkauksen, <a href=\"/fi/contact/\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">ota yhteyttä</a>.",
  },
];

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Etusivu", url: localizedHref("/", "fi") },
    { name: title, url: localizedHref(`/${REPORT.slug}/`, "fi") },
  ]),
  article({
    title,
    description,
    url: pageUrl,
    image: ogImage,
    datePublished: REPORT.datePublished,
    dateModified: REPORT.dateModified,
    author: "RevenueHunt",
    tags: [
      "Shopify app store",
      "Shopify-sovelluskehittäjät",
      "app store -tilastot",
      "sovellustalous",
    ],
  }),
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "Shopifyn sovellustalouden tila 2026",
    description,
    url: pageUrl,
    creator: organization(),
    license: "https://creativecommons.org/licenses/by/4.0/",
    isAccessibleForFree: true,
    datePublished: REPORT.datePublished,
    keywords: [
      "Shopify app store",
      "sovelluskehittäjät",
      "sovellusten tulot",
      "sovellusarvostelut",
      "ecommerce",
    ],
  },
  faqPage(FAQ),
];

// Section eyebrows for the editorial "field notes" feel.
const E = (n: string, label: string) => `${n} · ${label}`;

// Translated headline cards. Stats stay from the shared data module (HEADLINE[i].stat).
const headlineT = [
  { label: "aktiivista sovellusta storessa", note: "Noin 10-kertaistunut vuodesta 2020." },
  { label: "ilman yhtäkään arvostelua", note: "Neljällä viidestä on alle 10." },
  { label: "tuloista menee ylimmälle 1 %:lle", note: "225 sovellusta. Arvio." },
  { label: "veloittaa etukäteen", note: "Vain 1 jokaisesta 20:stä. Lähes puolet ovat ilmaisia." },
];

// Growth caption with the lead phrase bolded.
const growthCaptionHtml =
  "Aktiiviset sovellukset kumulatiivisesti julkaisuvuoden mukaan. <strong>Shopify App Store on noin 10-kertaistunut vuodesta 2020</strong> ja kasvanut yli 6 000 sovelluksella pelkästään viimeisen 12 kuukauden aikana, noin 1 jokaisesta 4:stä kaikesta tällä hetkellä aktiivisesta.";

// Quiz-lane paragraphs (translated), with the live search link and the load-bearing
// lines bolded inline. Caption text mirrors the English source's meaning.
const quizParas = [
  `Oma kategoriamme osoittaa saman asian. <a href="${QUIZ_LANE.searchUrl}" target="_blank" rel="external noopener nofollow" class="font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]">Shopifyn "quiz"-haku</a> palauttaa 149 sovellusta, mutta täälläkin luottamus kasaantuu huipulle täsmälleen samalla tavalla kuin koko storessa. Kolme sovellusta, jotka tulivat ensimmäisinä eivätkä koskaan lähteneet - RevenueHunt, Octane AI ja Quiz Kit - keräävät 45 % kaikista kategorian arvosteluista; <strong>pelkästään RevenueHuntilla on niistä noin neljäsosa</strong>, ja alemmalla puoliskolla ei ole yhtäkään.`,
  `Emme päässeet huipulle koodaamalla. <strong>Arvostelut ovat oire operatiivisesta puurtamisesta</strong>, joka on niiden takana: kuusi vuotta tukikysymyksiin vastaamista, puhelimeen tarttumista kauppiaiden kanssa, jotka eivät koskaan maksaisi, ja luottamuksen ansaitsemista kauppa kerrallaan. Octane AI ja Quiz Kit tekivät saman kovan työn vuosien ajan, <strong>ja kunnioitamme heitä siitä</strong>. Kunniamaininta Lanternille ja Quizellille, joilla molemmilla on hieman yli 120 arvostelua.`,
];

// Methodology bullets carry their own inline <strong>; render as-is.
const methodologyHtml = METHODOLOGY;
---

<Base
  title={`${title} - datapohjainen raportti 2026`}
  description={description}
  ogImage={ogImage}
  jsonLd={jsonLd}
  lang="fi"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={localizedHref("/", "fi")} class="hover:text-slate-700">Etusivu</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Shopifyn sovellustalouden tila</span>
      </nav>
      <div class="text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">
          Kenttämuistiinpanot · {publishedLabel}
        </p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          Shopifyn sovellustalouden tila
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          <strong>Shopify App Storessa on 22 546 aktiivista sovellusta, eivätkä lähes mitkään niistä pääse mihinkään.</strong> Otimme tilannekuvan jokaisesta aktiivisesta sovelluksesta ja luimme datan kasvusta, arvosteluista, tuloista, hinnoittelusta ja siitä, kuka ne tekee. Ne kertovat yhtä ainoaa tarinaa: sovelluksen tekeminen ei koskaan ollut se vaikea osa.
        </p>
      </div>
    </div>
  </section>

  <!-- Source band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-2xl bg-[#16161D] px-6 py-10 sm:px-10">
        <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#4dcaff]">
          Tilannekuva
        </p>
        <dl class="mt-6 grid grid-cols-2 gap-8 text-center sm:grid-cols-4">
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.apps}</dt>
            <dd class="mt-1 text-sm text-white/70">aktiivista sovellusta tilannekuvassa</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.countries}</dt>
            <dd class="mt-1 text-sm text-white/70">maata, jotka tekevät niitä</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.reviewless}</dt>
            <dd class="mt-1 text-sm text-white/70">ilman yhtäkään arvostelua</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.free}</dt>
            <dd class="mt-1 text-sm text-white/70">täysin ilmaisia, ei maksullista pakettia</dd>
          </div>
        </dl>
        <p class="mx-auto mt-6 max-w-3xl text-center text-sm text-white/60">
          Jokainen alla oleva luku on peräisin kaikkien 22 546 aktiivisen sovelluksen julkisesta App Store -listauksesta, kesäkuu 2026. Tulot on arvioitu julkaistuista hinnoista ja käyttösignaaleista, ei laskutusdatasta, ja ne on merkitty sellaisiksi läpi koko raportin.
        </p>
      </div>
    </div>
  </section>

  <!-- Headline cards -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Tärkeimmät luvut</h2>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        {HEADLINE.map((c, i) => (
          <div class="rounded-xl border border-slate-200 p-7">
            <p class="text-4xl font-bold tracking-tight text-[#16161D]">{c.stat}</p>
            <p class="mt-2 font-medium text-slate-900">{headlineT[i].label}</p>
            <p class="mt-2 text-sm text-slate-600">{headlineT[i].note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 01 Growth -->
  <section class="scroll-mt-20 bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("01", "Kasvu")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">10-kertaistunut vuodesta 2020</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center" set:html={growthCaptionHtml} />
      <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
        <div class="h-72 sm:h-80"><canvas id="c-growth" aria-label="Aktiiviset Shopify-sovellukset kumulatiivisesti vuoden mukaan" role="img"></canvas></div>
      </div>
    </div>
  </section>

  <!-- 02 Traction -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("02", "Vetovoima")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Useimmat sovellukset eivät koskaan saa arvostelua</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">Puolet Shopify App Storesta ei ole koskaan ansainnut yhtäkään arvostelua. Neljällä viidestä sovelluksesta on alle 10. Arvostelu on selkein julkinen merkki todellisesta, säilyneestä kauppiaasta, eivätkä useimmat sovellukset koskaan saa yhtäkään.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-center text-sm font-semibold text-slate-900">Sovellukset arvostelujen määrän mukaan</p>
          <div class="h-72 sm:h-80"><canvas id="c-reviews" aria-label="Arvostelujen jakauma kaikkien aktiivisten sovellusten kesken" role="img"></canvas></div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">81%</p>
            <p class="mt-1 text-slate-700">on alle 10 arvostelua</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="font-bold text-[#16161D]"><span class="text-3xl">{REVIEWS.medianReviews}</span> <span class="text-sm font-medium text-slate-500">arvostelua</span></p>
            <p class="mt-1 text-slate-700">mediaani niissä sovelluksissa, joilla on vähintään yksi arvostelu</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="font-bold text-[#16161D]"><span class="text-amber-400">★</span> <span class="text-3xl">{REVIEWS.avgRating}</span> <span class="text-sm font-medium text-slate-500">tähteä</span></p>
            <p class="mt-1 text-slate-700">keskiarvosana niiden {REVIEWS.ratedCount} sovelluksen joukossa, joilla on sellainen</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 Revenue -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("03", "Tulot · arvio")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Raha kasaantuu aivan huipulle</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">Arvioidut kuukausitulot ovat raa'asti keskittyneet huipulle. Sovellusten ylin 1 % (225 niistä) vie arviolta 72 %, ja vain 10 näistä sovelluksista vie lähes 30 % kaikista sovellustuloista. Vain noin 36 % sovelluksista näyttää ansaitsevan yhtään mitään. Ja se kasaantuu maantieteellisesti: <strong>pelkästään USA ja Kanada vievät arviolta 57 %</strong> Shopify App Storen tuloista.</p>
      <p class="mx-auto mt-3 max-w-3xl text-sm italic text-slate-500 text-center">Yksi nimi kohoaa yli koko ekosysteemin: sovellus, joka saa arviolta 78 % noin miljardin dollarin vuosiliikevaihdostaan Shopify-kauppiailta. Kyllä, sinua katsomme, <a href='https://www.sec.gov/Archives/edgar/data/1835830/000162828023030618/klaviyoincs-1.htm' target='_blank' rel='external noopener nofollow' class='font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]'>Klaviyo</a>.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-center text-sm font-semibold text-slate-900">Tulojen jakauma</p>
          <div class="h-64 sm:h-72"><canvas id="c-revenue-donut" aria-label="Arvioitujen tulojen jakauma: 10 parasta sovellusta, loput top 1%:sta ja loput 99%" role="img"></canvas></div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-center text-sm font-semibold text-slate-900">Arvioitu liikevaihto maittain</p>
          <div class="h-64 sm:h-72"><canvas id="c-revenue-countries" aria-label="Arvioitu liikevaihto maittain" role="img"></canvas></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 Pricing -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("04", "Hinnoittelu")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Lähes kukaan ei veloita etukäteen</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">Lähes puolet storesta ei veloita mitään etukäteen, ja alle 1 jokaisesta 20:stä sovelluksesta pyytää rahaa ennen ensimmäistä asennusta. Lähes 45 % tarjoaa pysyvästi ilmaisen paketin. Täällä freemium ei ole strategia, vaan vähimmäisvaatimus mukaan pääsemiseksi.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="text-center text-sm font-semibold text-slate-900">Sisäänpääsyhinnat kaikkien 22 546 aktiivisen sovelluksen kesken</p>
          <p class="mt-0.5 text-center text-xs text-slate-500">Neljä toisensa poissulkevaa tasoa sen mukaan, mitä sovellus pyytää etukäteen.</p>
          <div class="mt-4 h-72 sm:h-80"><canvas id="c-pricing" aria-label="Hinnoittelumallin jakauma kaikkien aktiivisten sovellusten kesken, sisäänpääsytason mukaan" role="img"></canvas></div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">{PRICING.permanentFree}</p>
            <p class="mt-1 text-slate-700">tarjoaa pysyvästi ilmaisen paketin, ei pelkkää kokeilua</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">{PRICING.completelyFree}</p>
            <p class="mt-1 text-slate-700">on täysin ilmaisia, ilman lainkaan maksullista pakettia</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">1 jokaisesta 20:stä</p>
            <p class="mt-1 text-slate-700">sovelluksesta veloittaa rahaa asennettaessa</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 Who builds them -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("05", "Kuka ne tekee")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Signaali vastaan kohina</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">Kaksi hallitsee: <strong>Yhdysvallat (24 %) ja Intia (15 %) tekevät yhdessä kaksi viidestä</strong> storen sovelluksesta. Mutta <strong>volyymi ei ole vetovoimaa</strong>. Kun maat järjestetään vain niiden sovellusten mukaan, jotka ovat ylittäneet 10+ arvostelua, sijoitus piirtyy uudelleen - <strong>Vietnam</strong>, keskikokoinen kehittäjä, tuottaa enemmän todellista vetovoimaa saaneita sovelluksia kuin sen koko antaisi olettaa, kun taas <strong>Japani ja Kiina putoavat pois</strong>.</p>
      <div class="mt-8 grid gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="text-center text-sm font-semibold text-slate-900">Kaikki sovellukset, arvostelutason mukaan</p>
