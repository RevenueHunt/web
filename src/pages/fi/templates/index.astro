---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb, softwareApplication } from "../../../lib/schema";
import { SITE } from "../../../lib/site";
import { SOLUTIONS, FEATURED_SOLUTIONS } from "../../../lib/solutions";
import { localizedHref } from "../../../lib/i18n";

const lang = "fi";
const lp = (path: string) => localizedHref(path, lang);

const featuredSolutions = FEATURED_SOLUTIONS.map((slug) => SOLUTIONS[slug]!);

interface Template {
  title: string;
  description: string;
  image: string;
  demo: string;
}

interface TemplateGroup {
  id: string;
  label: string;
  items: Template[];
}

const groups: TemplateGroup[] = [
  {
    id: "skincare",
    label: "Ihonhoito, hiustenhoito ja kosmetiikka",
    items: [
      { title: "Ihotyyppi + rutiini -kysely", description: "Tunnista ihotyyppi ja suosittele täydellinen rutiini.", image: "/img/pages/templates/skinquiz1.webp", demo: "https://productrecommendationquiz.com/pages/skin-analysis" },
      { title: "Löydä meikkivoiteesi", description: "Oikean meikkivoiteen valinta ei pitäisi olla arvailua.", image: "/img/pages/templates/foundation5.webp", demo: "https://productrecommendationquiz.com/pages/foundation-match" },
      { title: "Huulipunan sävyn etsijä", description: "Löydä jokaiselle asiakkaalle täydellinen huulipunan sävy hänen ihonsävynsä ja tyylinsä mukaan.", image: "/img/pages/templates/lips1-e1768405685573.webp", demo: "https://productrecommendationquiz.com/pages/lipstick-shade-finder" },
      { title: "Hiustenhoitokysely", description: "Suosittele shampoita, hoitoaineita ja hoitoja kunkin hiustavoitteiden mukaan.", image: "/img/pages/templates/hairquiz4.webp", demo: "https://productrecommendationquiz.com/pages/haircare-quiz" },
    ],
  },
  {
    id: "food",
    label: "Ravitsemus ja terveys",
    items: [
      { title: "Kahvikysely", description: "Ohjaa asiakkaasi ihanteelliseen kahvisekoitukseen makunsa ja elämäntapansa mukaan.", image: "/img/pages/templates/coffee2.webp", demo: "https://productrecommendationquiz.com/pages/coffee-quiz" },
      { title: "Lisäravinnekysely", description: "Suosittele vitamiineja ja lisäravinteita, jotka vastaavat heidän terveystavoitteitaan.", image: "/img/pages/templates/supplements3.webp", demo: "https://productrecommendationquiz.com/pages/supplements-quiz" },
      { title: "CBD-tuotteiden etsijä", description: "Ehdota oikeita CBD-tuotteita rentoutumiseen, uneen tai keskittymiseen.", image: "/img/pages/templates/cbd1.webp", demo: "https://productrecommendationquiz.com/pages/cbd-product-finder" },
      { title: "Koiranruokakysely", description: "Löydä täydellinen ruoka koirallesi sen erityistarpeiden ja mieltymysten mukaan.", image: "/img/pages/templates/dogquiz3.webp", demo: "https://productrecommendationquiz.com/pages/dog-food" },
    ],
  },
  {
    id: "clothes",
    label: "Urheilu, vaatteet ja muoti",
    items: [
      { title: "Korukysely", description: "Auta ostajiasi löytämään täydellinen korukappale tyyliinsä.", image: "/img/pages/templates/jewellery1-e1768405517428.webp", demo: "https://productrecommendationquiz.com/pages/jewellery-quiz" },
      { title: "Vaatetyylikysely", description: "Selvitä muotipersoonallisuutesi ja saa henkilökohtaisia suosituksia.", image: "/img/pages/templates/style1.webp", demo: "https://productrecommendationquiz.com/pages/clothing-style-quiz" },
      { title: "Polkupyöräkysely", description: "Löydä jokaiselle asiakkaalle oikea polkupyörä hänen ajotyylinsä ja tarpeidensa mukaan.", image: "/img/pages/templates/bike2.webp", demo: "https://productrecommendationquiz.com/pages/bicycle-quiz" },
    ],
  },
];

const gallery = [
  "Screenshot-2020-09-29-at-20.20.43.webp",
  "Screenshot-2020-09-29-at-20.33.39.webp",
  "Screenshot-2020-09-29-at-20.34.03.webp",
  "Screenshot-2020-09-29-at-20.34.16.webp",
  "Screenshot-2020-10-20-at-11.31.49.webp",
  "Screenshot-2020-10-20-at-11.32.06.webp",
  "Screenshot-2020-10-20-at-11.33.20.webp",
  "Screenshot-2020-10-20-at-11.33.57.webp",
  "Screenshot-2020-10-20-at-11.39.39.webp",
  "Screenshot-2020-10-20-at-11.41.15.webp",
  "Screenshot-2020-10-20-at-11.41.36.webp",
  "Screenshot-2020-10-20-at-11.41.51.webp",
  "Screenshot-2020-10-20-at-11.44.30.webp",
  "Screenshot-2020-10-20-at-11.45.11.webp",
  "Screenshot-2020-10-20-at-11.45.42.webp",
  "Screenshot-2020-11-16-at-14.34.09.webp",
  "Screenshot-2020-11-16-at-14.34.22.webp",
  "Screenshot-2020-11-16-at-14.34.34.webp",
  "Screenshot-2020-11-16-at-14.36.54.webp",
  "Screenshot-2020-12-04-at-08.38.54.webp",
  "Screenshot-2020-12-04-at-08.39.14.webp",
  "Screenshot-2020-12-04-at-08.39.25.webp",
  "Screenshot-2020-12-04-at-08.39.35.webp",
  "Screenshot-2021-04-14-at-04.13.10.webp",
  "Screenshot-2021-04-14-at-04.13.50.webp",
  "Screenshot-2021-04-14-at-04.14.16.webp",
  "Screenshot-2021-05-13-at-22.49.10.webp",
];

const reasons = [
  { emoji: "🚀", title: "Nopea asennus Shopifylle ja WooCommercelle", body: "Mallit integroituvat saumattomasti Shopifyn, WooCommercen, BigCommercen ja standalone-sivustojen kanssa. Ilman ohjelmointia: asenna sovellus, valitse malli ja mukauta se brändiisi sopivaksi." },
  { emoji: "💡", title: "Valmiit kyselyn kysymykset ja logiikka", body: "Jokainen malli sisältää asiantuntijoiden laatimat kysymykset, ehdollisen logiikan ja tuotesuositusalgoritmit. Rakennettu todistettujen viitekehysten päälle, jotka vauhdittavat konversioita kauneudessa, hyvinvoinnissa, lemmikkienhoidossa ja lifestylessa." },
  { emoji: "📊", title: "Kasvata konversioita ja AOV:ta", body: "Henkilökohtaiset suositukset muuttavat selailijat ostajiksi. Mallit on optimoitu korkeampiin konversioprosentteihin, suurempiin ostoskoreihin ja paremmin kvalifioituihin liideihin." },
  { emoji: "🎨", title: "Täysin mukautettava HTML", body: "Muokkaa tekstejä, ulkoasua, brändäystä ja logiikkaa koskematta koodiin. Edistynyttä kehitystä varten jokainen malli on myös täysin käytettävissä mukautetun HTML:n, CSS:n ja JS:n kautta." },
  { emoji: "📧", title: "Kerää zero-party-dataa", body: "Kerää mieltymykset, aikomus ja segmentointidata suoraan ostajalta, ja synkronoi ne sitten Klaviyoon, Omnisendiin, Metaan tai GA4:ään tehostaaksesi jatkomarkkinointiasi." },
  { emoji: "⚡", title: "Responsiiviset ja mobiiliin optimoidut", body: "Jokainen malli toimitetaan mobile-first-lähestymistavalla. Nopeita, saavutettavia ja suunniteltu tuntumaan natiiveilta mobiililaitteilla, tableteilla ja tietokoneilla." },
];

const jsonLd = [
  organization(),
  softwareApplication(),
  breadcrumb([
    { name: "Etusivu", url: "/" },
    { name: "Kyselymallit", url: "/templates/" },
  ]),
];
---

<Base
  title="Kyselymallit - RevenueHunt"
  description="Tuotekyselymallit Shopifylle, WooCommercelle, BigCommercelle ja standalone-kaupoille. Ihonhoito, kauneus, lisäravinteet, lemmikkiruoka, vaatteet, urheilu ja muut: valmiit kysymykset, ehdollinen logiikka ja tuotesuositusalgoritmit."
  jsonLd={jsonLd}
  lang="fi"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20 text-center">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={lp("/")} class="hover:text-slate-700">Etusivu</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Kyselymallit</span>
      </nav>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Tuotekyselymallit Shopifylle ja WooCommercelle
      </h1>
      <p class="mt-4 text-xl font-semibold text-slate-700">
        Interaktiiviset tuotesuosittelukyselyn mallit: valmiina käyttöön
      </p>
      <p class="mx-auto mt-6 max-w-3xl text-slate-600">
        Tutustu <strong class="font-semibold text-slate-900">ilmaisten kyselymalliemme</strong> kokoelmaan, joka on suunniteltu verkkokaupoille.
        Ihonhoito- ja kauneuskyselyistä lisäravinteisiin, lemmikkiruokaan ja lifestyle-tuotteisiin: jokainen malli on luotu auttamaan sinua tarjoamaan
        henkilökohtainen ostokokemus, joka konvertoi. Täydellisiä <strong class="font-semibold text-slate-900">Shopifylle</strong>,
        <strong class="font-semibold text-slate-900">WooCommercelle</strong>, <strong class="font-semibold text-slate-900">BigCommercelle</strong>
        ja <strong class="font-semibold text-slate-900">standalone</strong>-kaupoille.
      </p>
      <p class="mx-auto mt-4 max-w-3xl text-slate-600">
        Nämä mukautettavat HTML-kyselymallit sisältävät valmiiksi kirjoitetut kysymykset, ehdollisen logiikan ja tuotesuositusalgoritmit.
        Valitse malli, yhdistä tuotteesi, mukauta ulkoasu ja julkaise. Klikkaa mitä tahansa alla olevaa mallia nähdäksesi live-demon.
      </p>
    </div>
  </section>

  <!-- Top CTA banner -->
  <section class="mx-auto max-w-7xl px-6 pb-8">
    <div class="overflow-hidden rounded-2xl bg-[#16161D] px-8 py-12 text-center text-white">
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Kokeile tuotekyselymallejamme livenä</h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        Koe täysin toimivat tuotesuosittelukyselyt live-Shopify-demokaupassamme. Kokeile erilaisia kyselytyyppejä,
        tutustu ehdolliseen logiikkaan, haarautuviin kysymyksiin ja henkilökohtaisiin tuotesuosituksiin toiminnassa.
      </p>
      <a
        href="https://productrecommendationquiz.com/"
        target="_blank"
        rel="external noopener nofollow"
        class="mt-8 inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
      >
        Tutustu live-kyselydemoihin
      </a>
    </div>
  </section>

  <!-- Category nav -->
  <nav class="sticky top-[60px] z-30 border-y border-slate-200 bg-white/95 backdrop-blur" aria-label="Template categories">
    <ul class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-2 px-6 py-3">
      {groups.map((g) => (
        <li>
          <a
            href={`#${g.id}`}
            class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-[#16161D] hover:text-[#16161D]"
          >
            {g.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href="#gallery"
          class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-[#16161D] hover:text-[#16161D]"
        >
          Kyselyesimerkkien galleria
        </a>
      </li>
    </ul>
  </nav>

  <!-- Template grids -->
  <section class="mx-auto max-w-7xl px-6 py-12">
    {groups.map((g) => (
      <div id={g.id} class="mb-16 scroll-mt-32 last:mb-0">
        <h2 class="mb-8 text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">{g.label}</h2>
        <ul class="grid gap-6 md:grid-cols-2">
          {g.items.map((t) => (
            <li class="flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md">
              <a
                href={t.demo}
                target="_blank"
                rel="external noopener nofollow"
                class="block aspect-[321/217] overflow-hidden bg-slate-50"
              >
                <img src={t.image} alt={t.title} loading="lazy" class="h-full w-full object-cover" />
              </a>
              <div class="flex flex-1 flex-col p-5">
                <h3 class="text-lg font-semibold text-slate-900">{t.title}</h3>
                <p class="mt-2 text-sm text-slate-600">{t.description}</p>
                <div class="mt-5 flex flex-wrap gap-2">
                  <a
                    href={t.demo}
                    target="_blank"
                    rel="external noopener nofollow"
                    class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#26262e]"
                  >
                    Demo
                  </a>
                  <a
                    href={lp("/product-recommendation-quiz/")}
                    class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-4 py-2 text-sm font-semibold text-[#16161D] transition hover:bg-slate-50"
                  >
                    Hanki tämä malli
                  </a>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <!-- Examples gallery -->
    <div id="gallery" class="scroll-mt-32">
      <h2 class="mb-8 text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Kyselyesimerkkien galleria</h2>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {gallery.map((file) => (
          <li class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
            <a href={`/img/pages/templates/${file}`} target="_blank" rel="noopener" class="block aspect-video overflow-hidden bg-slate-50">
              <img src={`/img/pages/templates/${file}`} alt="Kyselyesimerkki" loading="lazy" class="h-full w-full object-cover" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Solutions cross-link -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 pb-4">
      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-8">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Et tiedä, millaisen kyselyn loisit?</h2>
        <p class="mt-3 text-slate-700">
          Kyselyratkaisumme selittävät parhaan kyselytyypin toimialallesi, ihonhoitorutiineista lahjaetsijöihin, esimerkkien ja UKK:n kera.
        </p>
        <ul class="mt-6 flex flex-wrap gap-3" role="list">
          {featuredSolutions.map((s) => (
            <li>
              <a
                href={`/solutions/${s.slug}/`}
                class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-[#16161D] hover:text-[#16161D]"
              >
                {s.name}
              </a>
            </li>
          ))}
          <li>
            <a
              href={lp("/solutions/")}
              class="inline-flex items-center rounded-full bg-[#16161D] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#26262e]"
            >
              Kaikki ratkaisut →
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Why use templates -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Miksi käyttää tuotekyselymalleja verkkokaupassasi?
      </h2>
      <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {reasons.map((r) => (
          <li class="rounded-xl border border-slate-200 bg-white p-6">
            <div class="text-2xl">{r.emoji}</div>
            <h3 class="mt-3 text-lg font-semibold text-slate-900">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{r.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Aloita tuotekyselysi luominen jo tänään
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        Luo houkuttelevia tuotesuosittelukyselyjä Shopify- tai WooCommerce-kauppaasi minuuteissa. Ilman ohjelmointia.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SITE.signup_url}
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          Kokeile kyselymalleja ilmaiseksi
        </a>
        <a
          href={lp("/demo/")}
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          Varaa demo
        </a>
      </div>
    </div>
  </section>
</Base>
