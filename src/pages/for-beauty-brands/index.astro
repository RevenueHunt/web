---
import Base from "../../layouts/Base.astro";
import YouTubeFacade from "../../components/YouTubeFacade.astro";
import { organization, breadcrumb, softwareApplication } from "../../lib/schema";
import { SITE } from "../../lib/site";

interface Resource {
  title: string;
  body: string;
  href: string;
}

const topics = [
  { label: "Ecommerce tips & tricks", href: "/blog/" },
  { label: "Using the Product Recommendation Quiz", href: "https://docs.revenuehunt.com/" },
  { label: "Marketing tools", href: "/integrations/" },
  { label: "Design tips & tricks", href: "/blog/" },
];

const resources: Resource[] = [
  {
    title: "How to build a funnel that will convert customers on autopilot",
    body: "A healthy sales funnel helps you transform your site visitors from casual browsers into committed customers...",
    href: "/build-sales-funnel-shopify-store/",
  },
  {
    title: "5 ways your store can compete with big marketplaces",
    body: "More than half of online shoppers still start their shopping journey on one of a few popular online marketplaces...",
    href: "/5-ways-d2c-store-compete-big-marketplaces/",
  },
  {
    title: "Skincare quizzes that convert in 2026: guide for Shopify & WooCommerce",
    body: "A well-built skincare quiz can be a real treasure of knowledge - as informative as an in-person consultation, and a much stronger funnel than a category page.",
    href: "/skincare-quiz-shopify-woocommerce/",
  },
  {
    title: "Anti-aging beauty brand quiz funnel - case study",
    body: "How a beauty brand turned cold ad traffic into qualified, segmented leads with a recommendation quiz funnel.",
    href: "/anti-aging-beauty-brand-quiz-funnel-case-study/",
  },
  {
    title: "Product quiz success: why it's necessary to send follow-up emails",
    body: "Almost every ecommerce company uses product recommendation quizzes to increase sales. However, not many companies send the follow-up emails necessary to make sure that customers actually buy the products they are recommended.",
    href: "/product-quiz-success-why-its-necessary-to-send-follow-up-emails/",
  },
];

const jsonLd = [
  organization(),
  softwareApplication(),
  breadcrumb([
    { name: "Home", url: "/" },
    { name: "For beauty brands", url: "/for-beauty-brands/" },
  ]),
];
---

<Base
  title="For beauty brands - RevenueHunt"
  description="Resources for beauty brands: marketing strategies, design tips, how to use the RevenueHunt Product Recommendation Quiz, and third-party tool tutorials."
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-slate-700">Home</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">For beauty brands</span>
      </nav>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        For <em class="italic text-[#16161D]">beauty brands</em>
      </h1>
      <p class="mt-6 max-w-3xl text-lg text-slate-700">
        <span class="text-slate-400">◻</span> For Beauty Brands is a resource center built to provide
        <strong class="font-semibold text-slate-900">great resources for your ecommerce</strong>.
      </p>
      <p class="mt-4 max-w-3xl text-slate-600">
        Rooted in the belief of always going the extra mile for our customers - and whoever needs the information - 
        you'll find marketing strategies, design tips &amp; tricks, how to best use our Product Recommendation Quiz,
        and even tutorials for third-party tools. Unlock your beauty business' <strong class="font-semibold text-slate-900">real potential</strong>.
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href="https://docs.revenuehunt.com/tutorials/"
          target="_blank"
          rel="external noopener"
          class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
        >
          Check our tutorials
        </a>
        <a
          href="/blog/"
          class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
        >
          Check our top articles
        </a>
      </div>
    </div>
  </section>

  <!-- Topic shortcuts -->
  <section class="border-y border-slate-200 bg-white">
    <ul class="mx-auto grid max-w-7xl gap-px bg-slate-200 sm:grid-cols-2 lg:grid-cols-4">
      {topics.map((t) => (
        <li class="bg-white">
          <a
            href={t.href}
            class="flex h-full items-center justify-center gap-2 px-6 py-8 text-center text-sm font-semibold text-slate-700 transition hover:bg-slate-50 hover:text-[#16161D]"
          >
            <span class="text-slate-400" aria-hidden="true">◇</span>
            <span>{t.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Beauty quiz solutions cross-link -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 pt-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Beauty quiz solutions</h2>
      <p class="mt-3 max-w-3xl text-slate-700">
        The best quiz type for your catalog, with examples and FAQs: skincare routines, shade matching, and more.
      </p>
      <ul class="mt-6 flex flex-wrap gap-3" role="list">
        {[
          { label: "Skincare quiz", href: "/solutions/skincare/" },
          { label: "Beauty & cosmetics quiz", href: "/solutions/beauty/" },
          { label: "Shade finder quiz", href: "/solutions/shade-finder/" },
          { label: "Routine builder quiz", href: "/solutions/routine-builder/" },
          { label: "All solutions", href: "/solutions/" },
        ].map((l) => (
          <li>
            <a
              href={l.href}
              class="inline-flex items-center rounded-full border border-slate-200 px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-[#16161D] hover:text-[#16161D]"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Featured tutorial highlight -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid items-center gap-10 rounded-2xl bg-gradient-to-br from-pink-50 via-slate-50 to-amber-50 p-8 lg:grid-cols-2 lg:p-12">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">
          <span class="inline-block h-2 w-2 bg-[#16161D]" aria-hidden="true"></span> Featured tutorial
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          How to build a <span class="font-extrabold">successful Product Recommendation Quiz</span>
        </h2>
        <p class="mt-6 text-slate-700">
          A practical tutorial explained by our team - how to drive up sales by creating an easy, personalized quiz for your store.
          From the basics of building your first quiz to the tips and tricks that turn it into your own personal shopper, without
          adding someone to the payroll.
        </p>
        <a
          href="https://docs.revenuehunt.com/"
          target="_blank"
          rel="external noopener"
          class="mt-8 inline-flex items-center gap-2 rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
        >
          Read the tutorial <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="aspect-video overflow-hidden rounded-xl bg-white shadow-lg">
        <YouTubeFacade id="fJqpGJUzZNE" title="Product Recommendation Quiz tutorial" />
      </div>
    </div>
  </section>

  <!-- Ecommerce resources -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Ecommerce resources</h2>
      <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {resources.map((r) => (
          <li>
            <a
              href={r.href}
              class="group flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 transition hover:border-slate-300 hover:shadow-md"
            >
              <h3 class="text-lg font-semibold text-slate-900 group-hover:text-[#16161D]">{r.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{r.body}</p>
              <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-[#16161D]">
                Keep reading <span aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-white/70">
        Most shoppers leave because they can't find the right product
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Turn shoppers into confident buyers with a Product Recommendation Quiz that drives sales.
      </h2>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a
          href={SITE.signup_url}
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          Sign up free
        </a>
        <a
          href="/demo/"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          Book a demo
        </a>
      </div>
    </div>
  </section>
</Base>
