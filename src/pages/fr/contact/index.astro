---
import Base from "../../../layouts/Base.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import YouTubeFacade from "../../../components/YouTubeFacade.astro";
import { organization, breadcrumb } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Accueil", url: "/" },
    { name: "Contact", url: "/contact/" },
  ]),
];

const channels = [
  {
    label: "Lisez les guides d'aide",
    href: "https://docs.revenuehunt.com/",
    note: "Documentation en libre-service, intégrations, dépannage.",
    external: true,
  },
  {
    label: "Support et ventes par email",
    href: "mailto:team@revenuehunt.com",
    note: "team@revenuehunt.com - voir les délais de réponse ci-dessous.",
  },
  {
    label: "Consultez l'état du système",
    href: "https://status.revenuehunt.com/",
    note: "Santé du service en temps réel et historique des incidents. 99,98 %+ de disponibilité.",
    external: true,
  },
];

const responseTiers = [
  {
    label: "Critique - production en panne, sécurité, intégrité des données",
    sla: "Première réponse en 30 minutes, 24/7 dans le monde entier",
  },
  {
    label: "Élevé - fonctionnalité majeure impactée, plusieurs utilisateurs affectés",
    sla: "Première réponse en 12 heures",
  },
  {
    label: "Standard - questions, aide à la configuration",
    sla: "1 jour ouvré",
  },
  {
    label: "Faible priorité - retours, demandes de fonctionnalités",
    sla: "Jusqu'à 3 jours ouvrés",
  },
];
---

<Base
  title="Contact - RevenueHunt"
  description="Contactez l'équipe de support de RevenueHunt. Lisez les guides d'aide, regardez le tutoriel ou faites le quiz de support pour obtenir une réponse personnalisée en quelques minutes."
  jsonLd={jsonLd}
  lang="fr"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20 text-center">
      <Breadcrumb items={[{ label: "Accueil", href: localizedHref("/", "fr") }, { label: "Contact" }]} />
      <Eyebrow>Contactez-nous</Eyebrow>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Contactez-nous
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600">
        Lisez les guides d'aide, regardez le tutoriel ou faites notre quiz de support ci-dessous - l'équipe de support
        la plus pointue et la plus sympathique de l'e-commerce vous répondra.
      </p>
    </div>
  </section>

  <!-- Two-column: video + channels -->
  <section class="mx-auto max-w-7xl px-6 py-12">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Commencez par le tutoriel</h2>
        <p class="mt-3 text-slate-600">
          La plupart des questions trouvent leur réponse dans la présentation de 3 minutes. Jetez-y un coup d'œil avant de nous écrire.
        </p>
        <div class="mt-6 aspect-video overflow-hidden rounded-xl bg-slate-900 shadow-xl">
          <YouTubeFacade id="oL1DnBd6N1U" title="Tutoriel de support RevenueHunt" />
        </div>
      </div>
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Comment nous joindre</h2>
        <ul class="mt-6 space-y-3">
          {channels.map((c) => (
            <li>
              <a
                href={c.href}
                target={c.external ? "_blank" : undefined}
                rel={c.external ? "external noopener" : undefined}
                class="group flex items-start justify-between gap-4 rounded-xl border border-slate-200 bg-white p-5 transition hover:border-slate-300 hover:shadow-md"
              >
                <div>
                  <p class="text-base font-semibold text-slate-900 group-hover:text-[#16161D]">{c.label}</p>
                  <p class="mt-1 text-sm text-slate-600">{c.note}</p>
                </div>
                <span class="mt-1 shrink-0 text-slate-400 transition group-hover:text-[#16161D]" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Support quiz -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Faites notre quiz de support</h2>
      <p class="mx-auto mt-3 max-w-2xl text-slate-600">
        Répondez à quelques questions rapides et nous vous orienterons vers la bonne aide - documentation, tutoriel ou une réponse d'un humain en chair et en os.
      </p>
      <div class="mx-auto mt-8 max-w-4xl overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <iframe
          src="https://admin.revenuehunt.com/public/quiz/ZAHJoMM"
          title="Quiz de support RevenueHunt"
          loading="lazy"
          class="block h-[600px] w-full"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Response times — moved here from the right column so it sits under
       the quiz, since that's where visitors land after asking for help. -->
  <section class="mx-auto max-w-4xl px-6 py-16">
    <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm sm:p-10">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Délais de réponse</h2>
      <p class="mt-3 text-slate-600">
        SLA de support par paliers pour tous les marchands, avec priorité pour les comptes Shopify Plus et enterprise.
      </p>
      <dl class="mt-6 grid gap-4 sm:grid-cols-2">
        {responseTiers.map((t) => (
          <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
            <dt class="text-sm font-semibold text-slate-900">{t.label}</dt>
            <dd class="mt-1 text-sm text-slate-600">{t.sla}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Base>
