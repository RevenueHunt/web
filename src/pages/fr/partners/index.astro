---
import Base from "../../../layouts/Base.astro";
import PageHero from "../../../components/PageHero.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import PartnerCard from "../../../components/PartnerCard.astro";
import { organization, breadcrumb } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

interface Partner {
  name: string;
  url: string;
  logo: string;
  description: string;
}

const groups: { heading: string; emoji: string; intro: string; items: Partner[] }[] = [
  {
    heading: "Localisation",
    emoji: "🌍",
    intro: "Vendez à l'international avec géolocalisation, traduction et multidevise intégrées.",
    items: [
      { name: "Orbe Shopify Geolocation", url: "https://apps.shopify.com/orbe?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/orbe-removebg-preview.webp", description: "Maximisez les ventes mondiales grâce à la géolocalisation avancée de Shopify. Personnalisez les produits, les prix, la devise et le contenu pour chaque pays et guidez les clients vers la bonne expérience d'achat avec Orbe." },
    ],
  },
  {
    heading: "Chat et support",
    emoji: "💬",
    intro: "Des outils de compte client qui rendent le self-service et le support sans effort.",
    items: [
      { name: "Dondy WhatsApp Marketing & Chat", url: "https://apps.shopify.com/dondy-marketing-ai?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/dondy-logo.webp", description: "Transformez le trafic perdu en revenus grâce à des flux WhatsApp automatisés de récupération, de confirmation et de fidélisation, ainsi qu'un agent IA qui gère le support client à la place de votre équipe." },
    ],
  },
  {
    heading: "Upsell et recommandations",
    emoji: "🎯",
    intro: "Augmentez le panier moyen avec des upsells, des listes de souhaits et des précommandes.",
    items: [
      { name: "Smart Size Chart & Fit Finder", url: "https://smartsize.io/?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/smartsize-logo.webp", description: "Créez des guides des tailles et des quiz « trouvez votre taille » propulsés par l'IA en quelques minutes : réduisez les questions sur les tailles et les retours tout en augmentant la conversion." },
      { name: "WC Wishlist Club", url: "https://apps.shopify.com/wishlist-club?utm_source=RevenueHunt&utm_medium=partnership&utm_campaign=partnership", logo: "/img/pages/partners/wishlist-club-150-150-px-logo.webp", description: "WC Wishlist Club permet à vos clients d'enregistrer leurs produits favoris, de partager leurs listes de souhaits et d'acheter plus tard, ce qui stimule l'engagement et les ventes. Facile à configurer, optimisé pour mobile et parfait pour transformer les simples visiteurs en acheteurs fidèles." },
      { name: "iCart Cart Drawer Cart Upsell", url: "https://apps.shopify.com/icart/?campaign=promotion&medium=in-app-banner&source=revenuehunt&utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/iCart-Cart-Drawer-Cart-Upsell-logo.webp", description: "App Shopify tout-en-un pour personnaliser un cart drawer et la page complète du panier avec upsell, recommandations de produits, barre de progression, bundles de produits et remises." },
    ],
  },
  {
    heading: "Prix et remises",
    emoji: "🏷️",
    intro: "Packs, remises sur volume et tarifs B2B qui récompensent les paniers plus grands.",
    items: [
      { name: "Kaching Bundle Quantity Deals", url: "https://apps.shopify.com/bundle-deals?utm_source=RevenueHunt&utm_medium=partnership&utm_campaign=REVENUEH", logo: "/img/pages/partners/Kaching-Logo-1024x1024.webp", description: "Stimulez les ventes avec Kaching Bundle Quantity Deals : créez des offres de bundles directement sur votre page produit. Utilisez le code REVENUEH20 pour une remise exclusive de 20 %." },
      { name: "BSS: B2B/Wholesale Solution", url: "https://apps.shopify.com/b2b-solution-custom-pricing?utm_source=RevenueHunt&utm_medium=partnership&utm_campaign=partnership-2024", logo: "/img/pages/partners/BSS-Commerce_logo_150.webp", description: "Solution wholesale tout-en-un. Une expérience d'achat B2B fluide qui aide aussi les marchands à gérer leurs clients wholesale et à en tirer des insights." },
    ],
  },
  {
    heading: "Marketing et pop-ups",
    emoji: "📣",
    intro: "Preuve sociale, programmes d'affiliation et campagnes sur site qui boostent les ventes.",
    items: [
      { name: "UpPromote: Affiliate & Referral", url: "https://partners.secomapp.com/apps/affiliate/SHOPQUIZ_APP", logo: "/img/pages/partners/NEW_logo-1.webp", description: "UpPromote est l'app d'affiliation/parrainage la plus recommandée sur le Shopify App Store. Une solution tout-en-un pour créer et gérer vos campagnes marketing, adaptée à toutes les tailles d'entreprise." },
    ],
  },
  {
    heading: "Expédition et logistique",
    emoji: "📦",
    intro: "Approvisionnement, logistique et offres de livraison gratuite pour expédier plus vite et passer à l'échelle.",
    items: [
      { name: "Essential Free Shipping Bar", url: "https://apps.shopify.com/essential-order-value-booster?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/freeshippingbarlogo.webp", description: "Augmentez les ventes et l'AOV en configurant des barres de livraison gratuite illimitées avec plusieurs paliers de valeur de panier pour inciter les acheteurs à ajouter plus de produits." },
      { name: "HyperSKU", url: "https://apps.shopify.com/hypersku?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/150150-logo.webp", description: "HyperSKU propose une solution de chaîne d'approvisionnement tout-en-un. Plus de 1M de produits, vente de bundles, échantillonnage, inspection qualité, personnalisation de marque et fulfillment automatisé des commandes." },
    ],
  },
  {
    heading: "Analytique et rapports",
    emoji: "📊",
    intro: "Données SEO et de commandes pour mesurer ce qui marche et en rendre compte.",
    items: [
      { name: "AI SEO Optimizer", url: "https://share.seoant.com/app/1165b75b7ce1524D5J", logo: "/img/pages/partners/SEOAnt-_-AI-SEO-Optimizer_Channelwill-.webp", description: "La meilleure app de SEO pour Shopify : optimisez les mots-clés, améliorez les meta tags et perfectionnez la structure du site. Analyses de performance et de vitesse SEO propulsées par l'AI." },
    ],
  },
];

const perks = [
  { title: "Commissions de parrainage", body: "Inscrivez de nouveaux clients chez RevenueHunt et touchez une commission à vie de 20 % sur tous les revenus qu'ils génèrent." },
  { title: "Liens d'affiliation", body: "Ajoutez vos liens d'affiliation dans vos articles, newsletters et publications sur les réseaux sociaux. Renvoyez directement vers nos apps Shopify, WooCommerce, BigCommerce, Magento et standalone." },
  { title: "Votre propre partner manager", body: "Recevez des conseils pour construire des tunnels de vente automatisés avec notre outil et des astuces pour vendre notre solution à vos clients." },
  { title: "Contenu exclusif", body: "Contactez-nous pour obtenir des conseils sur la création de tunnels de vente automatisés pour vos clients avec RevenueHunt et d'autres outils." },
  { title: "Une place dans notre Partner Directory", body: "Nos utilisateurs vous trouveront dans notre Partner Directory et vous contacteront pour vos services." },
];

const faqs = [
  { q: "Combien coûte le fait de devenir partenaire ?", a: "L'inscription est entièrement gratuite. Zéro. Rien." },
  { q: "Dois-je être client de RevenueHunt ?", a: "Non, vous n'avez pas besoin d'être client de RevenueHunt pour devenir partenaire." },
  { q: "Comment serai-je payé ?", a: "Nous versons les gains chaque mois. Les paiements sont envoyés via PayPal." },
  { q: "Comment puis-je suivre mes parrainages ?", a: "Vous pouvez consulter vos statistiques dans votre <a href='https://admin.revenuehunt.com/' target='_blank' rel='external noopener' class='font-semibold text-[#16161D] underline'>Partner Dashboard</a>." },
];

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Accueil", url: "/" },
    { name: "Partenaires et affiliés", url: "/partners/" },
  ]),
];
---

<Base
  title="Programme partenaires - RevenueHunt"
  description="Recommandez vos clients. Gagnez de l'argent. Touchez une commission à vie de 20 % sur les clients que vous recommandez à RevenueHunt. Inscrivez-vous gratuitement à notre Programme partenaires."
  jsonLd={jsonLd}
  lang="fr"
  translated={true}
>
  <!-- Hero -->
  <PageHero center>
      <Breadcrumb items={[{ label: "Accueil", href: localizedHref("/", "fr") }, { label: "Partenaires et affiliés" }]} />
      <Eyebrow>Programme partenaires</Eyebrow>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Recommandez vos clients. Gagnez de l'argent.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-xl text-slate-600">
        Touchez une <strong class="font-semibold text-slate-900">commission à vie de 20 %</strong> sur les clients que vous nous recommandez. Inscrivez-vous gratuitement à notre Programme partenaires dès aujourd'hui.
      </p>
      <p class="mx-auto mt-6 max-w-3xl text-slate-600">
        Si vous êtes une <strong class="font-semibold text-slate-900">agence de marketing digital</strong> ou un
        <strong class="font-semibold text-slate-900">spécialiste de l'e-commerce</strong> et que vous souhaitez développer votre activité,
        notre Programme partenaires est fait pour vous. Créez des expériences remarquables pour vos clients avec RevenueHunt.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
        >
          Commencez maintenant
        </a>
        <a
          href="#partners"
          class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
        >
          Voir nos partenaires
        </a>
      </div>
  </PageHero>

  <!-- Who you are + perks -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-1">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Qui vous êtes</h2>
        <p class="mt-4 text-slate-600">
          Vous êtes une agence de marketing digital ou un consultant e-commerce passionné par le design et obsédé par
          <strong class="font-semibold text-slate-900">l'obtention des meilleurs résultats</strong> pour vos clients. Vous développez
          votre activité en donnant les moyens à d'autres entreprises de réussir.
        </p>
      </div>
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Ce que vous obtenez de notre part</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {perks.map((p) => (
            <li class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="text-base font-semibold text-slate-900">{p.title}</h3>
              <p class="mt-2 text-sm text-slate-600">{p.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Partner directory -->
  <section id="partners" class="mx-auto max-w-7xl px-6 py-16 scroll-mt-24">
    <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Nos partenaires</h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
      Des apps et des agences de confiance qui s'associent à merveille avec RevenueHunt pour vos clients.
    </p>
    <div class="mt-12 space-y-16">
      {groups.map((g) => (
        <div>
          <div class="mb-2 flex items-baseline gap-3">
            <span class="text-2xl" aria-hidden="true">{g.emoji}</span>
            <h3 class="text-2xl font-semibold tracking-tight text-slate-900">{g.heading}</h3>
          </div>
          <p class="max-w-3xl text-slate-600">{g.intro}</p>
          <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {g.items.map((p) => (
        <PartnerCard {...p} alt={`Logo de ${p.name}`} cta="Installer l'application" />
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Questions fréquentes</h2>
      <div class="mx-auto mt-8 max-w-2xl">
        {faqs.map((f) => (
          <details class="border-b border-slate-200">
            <summary class="py-4 text-base font-semibold text-slate-900">{f.q}</summary>
            <p class="pb-4 text-slate-600" set:html={f.a}></p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Devenez partenaire RevenueHunt
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        Recommandez vos clients, construisez des tunnels de vente automatisés et touchez une commission à vie de 20 % sur tout ce qu'ils dépensent.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          Commencez maintenant
        </a>
        <a
          href={localizedHref("/demo/", "fr")}
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          Réserver une démo
        </a>
      </div>
    </div>
  </section>
</Base>
