---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

interface Partner {
  name: string;
  url: string;
  logo: string;
  description: string;
}

const groups: { heading: string; emoji: string; intro: string; items: Partner[] }[] = [
  {
    heading: "Apps Shopify",
    emoji: "🧩",
    intro: "Des apps Shopify qui s'accordent parfaitement avec RevenueHunt pour développer votre boutique.",
    items: [
      { name: "Orbe Shopify Geolocation", url: "https://orbe.app/", logo: "/img/pages/partners/orbe-removebg-preview.webp", description: "Maximisez les ventes mondiales grâce à la géolocalisation avancée de Shopify. Personnalisez les produits, les prix, la devise et le contenu pour chaque pays et guidez les clients vers la bonne expérience d'achat avec Orbe." },
      { name: "WC Wishlist Club", url: "https://apps.shopify.com/wishlist-club?utm_source=revenuehunt&utm_medium=website&utm_campaign=partnership", logo: "/img/pages/partners/wishlist-club-150-150-px-logo.webp", description: "WC Wishlist Club permet à vos clients d'enregistrer leurs produits favoris, de partager leurs listes de souhaits et d'acheter plus tard, ce qui stimule l'engagement et les ventes. Facile à configurer, optimisé pour mobile et parfait pour transformer les simples visiteurs en acheteurs fidèles." },
      { name: "Langwill: Language Translate", url: "https://apps.shopify.com/localiser", logo: "/img/pages/partners/1.webp", description: "Élargissez votre portée mondiale avec Langwill : traduisez votre boutique Shopify en 138 langues et convertissez automatiquement les devises pour une expérience d'achat fluide et localisée." },
      { name: "Customer Dashboard Pro", url: "https://apps.shopify.com/customer-dashboard-pro?utm_source=revenuehunt", logo: "/img/pages/partners/CustomerDashboard.webp", description: "Customer Dashboard Pro est la seule app à offrir une prise en charge fluide à la fois des New Customer Accounts de Shopify et des Classic Customer Accounts." },
      { name: "ToastiBar – Sales Popup", url: "https://makeprosimp.com/partnership/revenuehunt", logo: "/img/pages/partners/toastibarlogo_fgaiv9.webp", description: "Renforcez la confiance des clients et stimulez les ventes en affichant une preuve sociale en temps réel : ventes, panier, visiteurs, avis produits et alertes de stock." },
      { name: "UpPromote: Affiliate & Referral", url: "https://partners.secomapp.com/apps/affiliate/SHOPQUIZ_APP", logo: "/img/pages/partners/NEW_logo-1.webp", description: "UpPromote est l'app d'affiliation/parrainage la plus recommandée sur le Shopify App Store. Une solution tout-en-un pour créer et gérer vos campagnes marketing, adaptée à toutes les tailles d'entreprise." },
      { name: "Essential Free Shipping Bar", url: "https://apps.shopify.com/essential-order-value-booster", logo: "/img/pages/partners/freeshippingbarlogo.webp", description: "Augmentez les ventes et l'AOV en configurant des barres de livraison gratuite illimitées avec plusieurs paliers de valeur de panier pour inciter les acheteurs à ajouter plus de produits." },
      { name: "iCart Cart Drawer Cart Upsell", url: "https://apps.shopify.com/icart/?campaign=promotion&medium=in-app-banner&source=revenuehunt", logo: "/img/pages/partners/iCart-Cart-Drawer-Cart-Upsell-logo.webp", description: "App Shopify tout-en-un pour personnaliser un cart drawer et la page complète du panier avec upsell, recommandations de produits, barre de progression, bundles de produits et remises." },
      { name: "Kaching Bundle Quantity Deals", url: "https://apps.shopify.com/bundle-deals?utm_source=partnership&utm_medium=web&utm_campaign=REVENUEH", logo: "/img/pages/partners/Kaching-Logo-1024x1024.webp", description: "Stimulez les ventes avec Kaching Bundle Quantity Deals : créez des offres de bundles directement sur votre page produit. Utilisez le code REVENUEH20 pour une remise exclusive de 20 %." },
      { name: "PDF Invoice Generator", url: "https://apps.shopify.com/fordeer-invoice-order-printer?utm_source=ShopQuizProductRecommender&utm_medium=comarketing&utm_campaign=partner", logo: "/img/pages/partners/fordeer-data-export-1024x1024.webp", description: "Le générateur de factures Shopify de Fordeer est flexible, conforme à l'échelle mondiale et adapté au B2C, au B2B et au Wholesale. Modèles PDF personnalisables, impression par lots et support par chat en direct 24/7." },
      { name: "AI SEO Optimizer", url: "https://share.seoant.com/app/1165b75b7ce1524D5J", logo: "/img/pages/partners/SEOAnt-_-AI-SEO-Optimizer_Channelwill-.webp", description: "La meilleure app de SEO pour Shopify : optimisez les mots-clés, améliorez les meta tags et perfectionnez la structure du site. Analyses de performance et de vitesse SEO propulsées par l'AI." },
      { name: "BSS: B2B/Wholesale Solution", url: "https://apps.shopify.com/b2b-solution-custom-pricing?utm_source=RevenueHunt&utm_medium=partner-listing&utm_campaign=partnership-2024", logo: "/img/pages/partners/BSS-Commerce_logo_150.webp", description: "Solution wholesale tout-en-un. Une expérience d'achat B2B fluide qui aide aussi les marchands à gérer leurs clients wholesale et à en tirer des insights." },
      { name: "PreOrder Now WOD", url: "https://apps.shopify.com/preorder-now?utm_source=+revenuehunt&utm_medium=web&utm_campaign=partner&utm_id=crosspromo", logo: "/img/pages/partners/PreOrder-Now-Logo.webp", description: "Transformez les ruptures de stock en opportunités de précommande. Parfait pour les entreprises de print-on-demand : captez l'intérêt des clients sans stock initial." },
    ],
  },
  {
    heading: "Logistique et approvisionnement",
    emoji: "📦",
    intro: "Des partenaires d'approvisionnement, de fulfillment et de logistique pour expédier plus vite et passer à l'échelle mondiale.",
    items: [
      { name: "Fulfillman", url: "https://www.fulfillman.com/", logo: "/img/pages/partners/fulfillmanlogo.webp", description: "Fulfillman est un leader mondial du sourcing, du fulfillment et de la logistique e-commerce, offrant une expédition rapide et fiable grâce à des services de ligne privée dédiés." },
      { name: "HyperSKU", url: "https://www.hypersku.com/", logo: "/img/pages/partners/150150-logo.webp", description: "HyperSKU propose une solution de chaîne d'approvisionnement tout-en-un. Plus de 1M de produits, vente de bundles, échantillonnage, inspection qualité, personnalisation de marque et fulfillment automatisé des commandes." },
      { name: "Service Points", url: "https://www.servicepoints.eu/en/w2/smart-dropshipping-1?utm_source=revenuehunt&utm_medium=app&utm_id=31", logo: "/img/pages/partners/Logo-Black-background.webp", description: "Service Points présente le SMART Dropshipping : un dropshipping automatisé et des décisions de chaîne d'approvisionnement fondées sur les données pour évoluer à l'infini." },
    ],
  },
  {
    heading: "Thèmes et design",
    emoji: "🎨",
    intro: "Des thèmes premium et du design pour sublimer votre boutique.",
    items: [
      { name: "eComX", url: "https://ecomx.co/", logo: "/img/pages/partners/ecomx-logo.webp", description: "eComX conçoit des thèmes Shopify premium pensés pour convertir. Choisissez parmi plus de 16 designs spécifiques à votre niche, optimisés grâce à des données de conversion réelles et conçus pour la vitesse, afin de transformer plus de visiteurs en acheteurs." },
    ],
  },
];

const perks = [
  { title: "Commissions de parrainage", body: "Inscrivez de nouveaux clients chez RevenueHunt et touchez une commission à vie de 20 % sur tous les revenus qu'ils génèrent." },
  { title: "Liens d'affiliation", body: "Ajoutez vos liens d'affiliation dans vos articles, newsletters et publications sur les réseaux sociaux. Renvoyez directement vers nos apps Shopify, WooCommerce, BigCommerce, Magento et standalone." },
  { title: "Votre propre partner manager", body: "Recevez des conseils pour construire des tunnels de vente automatisés avec notre outil et des astuces pour vendre notre solution à vos clients." },
  { title: "Contenu exclusif", body: "Contactez-nous pour obtenir des conseils sur la création de tunnels de vente automatisés pour vos clients avec RevenueHunt et d'autres outils." },
  { title: "Une place dans notre Partner Directory", body: "Nos utilisateurs vous trouveront dans notre Partner Directory et vous contacteront pour vos services." },
];

const faqs = [
  { q: "Combien coûte le fait de devenir partenaire ?", a: "L'inscription est entièrement gratuite. Zéro. Rien." },
  { q: "Dois-je être client de RevenueHunt ?", a: "Non, vous n'avez pas besoin d'être client de RevenueHunt pour devenir partenaire." },
  { q: "Comment serai-je payé ?", a: "Nous versons les gains chaque mois. Les paiements sont envoyés via PayPal." },
  { q: "Comment puis-je suivre mes parrainages ?", a: "Vous pouvez consulter vos statistiques dans votre Partner Dashboard." },
];

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Accueil", url: "/" },
    { name: "Partenaires et affiliés", url: "/partners/" },
  ]),
];
---

<Base
  title="Programme partenaires - RevenueHunt"
  description="Recommandez vos clients. Gagnez de l'argent. Touchez une commission à vie de 20 % sur les clients que vous recommandez à RevenueHunt. Inscrivez-vous gratuitement à notre Programme partenaires."
  jsonLd={jsonLd}
  lang="fr"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20 text-center">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={localizedHref("/", "fr")} class="hover:text-slate-700">Accueil</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Partenaires et affiliés</span>
      </nav>
      <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">Programme partenaires</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Recommandez vos clients. Gagnez de l'argent.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-xl text-slate-600">
        Touchez une commission à vie de 20 % sur les clients que vous nous recommandez. Inscrivez-vous gratuitement à notre Programme partenaires dès aujourd'hui.
      </p>
      <p class="mx-auto mt-6 max-w-3xl text-slate-600">
        Si vous êtes une <strong class="font-semibold text-slate-900">agence de marketing digital</strong> ou un
        <strong class="font-semibold text-slate-900">spécialiste de l'e-commerce</strong> et que vous souhaitez développer votre activité,
        notre Programme partenaires est fait pour vous. Créez des expériences remarquables pour vos clients avec RevenueHunt.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
        >
          Commencez maintenant
        </a>
        <a
          href="#partners"
          class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
        >
          Voir nos partenaires
        </a>
      </div>
    </div>
  </section>

  <!-- Who you are + perks -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-1">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Qui vous êtes</h2>
        <p class="mt-4 text-slate-600">
          Vous êtes une agence de marketing digital ou un consultant e-commerce passionné par le design et obsédé par
          <strong class="font-semibold text-slate-900">l'obtention des meilleurs résultats</strong> pour vos clients. Vous développez
          votre activité en donnant les moyens à d'autres entreprises de réussir.
        </p>
      </div>
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Ce que vous obtenez de notre part</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {perks.map((p) => (
            <li class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="text-base font-semibold text-slate-900">{p.title}</h3>
              <p class="mt-2 text-sm text-slate-600">{p.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Partner directory -->
  <section id="partners" class="mx-auto max-w-7xl px-6 py-16 scroll-mt-24">
    <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Nos partenaires</h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
      Des apps et des agences de confiance qui s'associent à merveille avec RevenueHunt pour vos clients.
    </p>
    <div class="mt-12 space-y-16">
      {groups.map((g) => (
        <div>
          <div class="mb-2 flex items-baseline gap-3">
            <span class="text-2xl" aria-hidden="true">{g.emoji}</span>
            <h3 class="text-2xl font-semibold tracking-tight text-slate-900">{g.heading}</h3>
          </div>
          <p class="max-w-3xl text-slate-600">{g.intro}</p>
          <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {g.items.map((p) => (
        <li>
          <a
            href={p.url}
            target="_blank"
            rel="external noopener nofollow"
            class="group flex h-full flex-col items-center rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm transition hover:border-slate-300 hover:shadow-md"
          >
            <img
              src={p.logo}
              alt={`Logo de ${p.name}`}
              loading="lazy"
              width="120"
              height="120"
              class="h-24 w-24 rounded-full object-cover"
            />
            <h3 class="mt-5 text-lg font-semibold text-slate-900 group-hover:text-[#16161D]">{p.name}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{p.description}</p>
            <span class="mt-5 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wider text-slate-500 group-hover:text-[#16161D]">
              Visiter le site <span aria-hidden="true">↗</span>
            </span>
          </a>
        </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Questions fréquentes</h2>
      <div class="mx-auto mt-8 max-w-2xl">
        {faqs.map((f) => (
          <details class="border-b border-slate-200">
            <summary class="py-4 text-base font-semibold text-slate-900">{f.q}</summary>
            <p class="pb-4 text-slate-600">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Devenez partenaire RevenueHunt
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        Recommandez vos clients, construisez des tunnels de vente automatisés et touchez une commission à vie de 20 % sur tout ce qu'ils dépensent.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          Commencez maintenant
        </a>
        <a
          href={localizedHref("/demo/", "fr")}
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          Réserver une démo
        </a>
      </div>
    </div>
  </section>
</Base>
