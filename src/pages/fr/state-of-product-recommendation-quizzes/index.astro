---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb, article, faqPage } from "../../../lib/schema";
import { SITE } from "../../../lib/site";
import { localizedHref } from "../../../lib/i18n";
import {
  REPORT,
  DATASET,
  HEADLINE,
  VERTICAL_CONVERSION,
  AOV_UPLIFT,
  ATTRIBUTION,
  BASELINES,
} from "../../../lib/quiz-benchmarks";

const pageUrl = new URL(`/${REPORT.slug}/`, SITE.site_url).href;
const ogImage = `/og/${REPORT.slug}.png`;

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=state_of_product_quizzes";
// Free WordPress.org plugin (not the WooCommerce.com extension).
const WOO_PLUGIN =
  "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";

const formatN = (n: number | null) =>
  n === null ? "" : n.toLocaleString("en-US");

// Conversion expressed against a typical 2% store: 6.9% / 2% = 345%.
const boost = (rate: number) => Math.round((rate / HEADLINE.baselinePct) * 100);

// Translated methodology + FAQ (the shared data module stays English for the PDF
// and stat cards). Defined before jsonLd so faqPage(FAQ) uses the translated set.
const METHODOLOGY = [
  "Source : la plateforme de RevenueHunt elle-même, sur l'ensemble des plateformes e-commerce que nous prenons en charge. Agrégé et anonymisé : aucune boutique individuelle n'est identifiable, et nos propres boutiques de démonstration sont exclues partout.",
  "La conversion est un taux par personne ayant fait le quiz : les commandes attribuées à une réponse de quiz, divisées par les quiz complétés. Ce n'est pas un taux à l'échelle du site. Les personnes qui font le quiz s'auto-sélectionnent et sont plus engagées que le visiteur moyen, donc ce n'est pas une comparaison à périmètre égal avec le taux de conversion global d'une boutique. Nous le précisons partout où nous faisons la comparaison.",
  "La catégorie est dérivée du nom de quiz rédigé par le commerçant (par exemple « quiz soin de la peau », « quiz alimentation pour chien »). Environ 78 % des réponses proviennent de quiz génériques ou sans nom et sont exclues de chaque chiffre par catégorie.",
  "Le gain d'average order value est mesuré au sein de la boutique : la valeur de commande médiane du quiz de cette même boutique face à sa valeur de commande médiane hors quiz. C'est robuste face à la devise et cela élimine le biais de mix de boutique qui dilue l'effet dans une moyenne naïve à l'échelle de la plateforme.",
  "Chaque chiffre de conversion est un plancher. L'attribution est encore en cours de rattachement à mesure que les commerçants synchronisent leurs commandes (9 % des premières commandes arrivent plus de 30 jours après le quiz), et les commandes multi-appareils ou non suivies ne se rattachent jamais. Les chiffres réels sont plus élevés, pas plus bas.",
];

const FAQ = [
  {
    question: "Comment la conversion du quiz est-elle mesurée ?",
    answer:
      "Les commandes attribuées à une réponse de quiz, divisées par les quiz complétés. Sur l'ensemble de la plateforme, 5,5 % des acheteurs qui terminent un quiz (environ 1 sur 18) passent une commande suivie. C'est un taux par personne ayant fait le quiz, pas un taux à l'échelle du site : les personnes qui font le quiz sont plus engagées que le visiteur moyen, donc ce n'est pas directement comparable au taux de conversion global d'une boutique.",
  },
  {
    question: "Pourquoi le taux de conversion du quiz est-il tellement plus élevé que celui de la boutique moyenne ?",
    answer:
      "Deux raisons. D'abord, le quiz lui-même : il remplace un catalogue écrasant par une courte conversation et une recommandation claire, ce qui supprime l'indécision qui fait fuir les ventes. Ensuite, ce qui se passe une fois les réponses recueillies : chaque quiz capture des zero-party data et étiquette l'acheteur, ce qui alimente des flux de relance segmentés et le retargeting. Les campagnes segmentées génèrent plus de 3 fois le chiffre d'affaires par destinataire des envois génériques (benchmark de segmentation de Klaviyo), donc un quiz continue de convertir via l'email et la publicité personnalisés, pas seulement sur la page de résultats.",
    answerHtml:
      "Deux raisons. D'abord, le quiz lui-même : il remplace un catalogue écrasant par une courte conversation et une recommandation claire, ce qui supprime l'indécision qui fait fuir les ventes. Ensuite, ce qui se passe une fois les réponses recueillies : chaque quiz capture des zero-party data et étiquette l'acheteur, ce qui alimente des flux de relance segmentés et le retargeting. Les campagnes segmentées génèrent plus de 3 fois le chiffre d'affaires par destinataire des envois génériques (<a href=\"https://www.klaviyo.com/marketing-resources/segmentation-benchmark-report\" target=\"_blank\" rel=\"external noopener nofollow\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">benchmark de segmentation de Klaviyo</a>), donc un quiz continue de convertir via l'email et la publicité personnalisés, pas seulement sur la page de résultats.",
  },
  {
    question: "Les acheteurs qui font le quiz dépensent-ils vraiment plus par commande ?",
    answer:
      "En moyenne, oui, mesuré à périmètre comparable. Au sein de la même boutique, les commandes passées via un quiz sont environ 11 % à 15 % plus élevées que celles qui ne le sont pas, et cela se vérifie dans à peu près 7 boutiques sur 10. Ce n'est pas universel, cependant : c'est le plus marqué en beauté et soin de la peau (environ +20 %), plus plat dans des catégories comme le parfum et le café.",
  },
  {
    question: "Comment ces benchmarks s'appliquent-ils à ma boutique ?",
    answer:
      "Renseignez votre propre trafic, votre average order value et votre taux de conversion actuel dans notre calculateur de ROI du quiz. Il fait tourner ces mêmes benchmarks (le taux de 5,5 % par personne ayant fait le quiz, la conversion par catégorie, le gain d'AOV) face à vos chiffres pour estimer le chiffre d'affaires supplémentaire qu'un quiz pourrait apporter.",
    answerHtml:
      "Renseignez votre propre trafic, votre average order value et votre taux de conversion actuel dans notre <a href=\"/fr/quiz-roi-calculator/\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">calculateur de ROI du quiz</a>. Il fait tourner ces mêmes benchmarks (le taux de 5,5 % par personne ayant fait le quiz, la conversion par catégorie, le gain d'AOV) face à vos chiffres pour estimer le chiffre d'affaires supplémentaire qu'un quiz pourrait apporter.",
  },
  {
    question: "Les données sont-elles anonymisées ?",
    answer:
      "Oui. Chaque chiffre est agrégé et mis en commun sur des millions de réponses et des milliers de boutiques. Aucune boutique individuelle n'est identifiable. Le rapport existe pour partager ce que disent les données, pas pour exposer un commerçant.",
  },
  {
    question: "Puis-je utiliser ces chiffres ?",
    answer:
      "Oui. Citez-les avec un lien vers cette page. Le rapport est gratuit et sans barrière, le PDF est téléchargeable, et les chiffres clés sont disponibles sous forme de cartes à partager.",
  },
];

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Accueil", url: localizedHref("/", "fr") },
    { name: "L'état des quiz de recommandation de produits", url: localizedHref(`/${REPORT.slug}/`, "fr") },
  ]),
  article({
    title: `${REPORT.title}: ${REPORT.subtitle}`,
    description: REPORT.description,
    url: pageUrl,
    image: ogImage,
    datePublished: REPORT.datePublished,
    dateModified: REPORT.dateModified,
    author: "RevenueHunt",
    tags: [
      "quiz de recommandation de produits benchmark",
      "quiz conversion rate",
      "ecommerce personalization",
      "average order value",
    ],
  }),
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "RevenueHunt quiz de recommandation de produits benchmarks 2026",
    description: REPORT.description,
    url: pageUrl,
    creator: organization(),
    license: "https://creativecommons.org/licenses/by/4.0/",
    isAccessibleForFree: true,
    datePublished: REPORT.datePublished,
    keywords: [
      "quiz de recommandation de produits",
      "conversion rate",
      "average order value",
      "ecommerce",
      "Shopify",
    ],
    distribution: {
      "@type": "DataDownload",
      encodingFormat: "application/pdf",
      contentUrl: new URL(REPORT.pdfPath, SITE.site_url).href,
    },
  },
  faqPage(FAQ),
];

const publishedLabel = new Date(REPORT.datePublished).toLocaleDateString("fr-FR", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

// Category/vertical labels and the two long table notes, translated. Numbers stay
// from the shared data module; only the human-readable labels/notes are localized.
const VERT_LABEL: Record<string, string> = {
  "Fragrance": "Parfum",
  "Haircare": "Soin des cheveux",
  "Supplements & health": "Compléments et santé",
  "Beauty & skincare": "Beauté et soin de la peau",
  "Coffee & tea": "Café et thé",
  "CBD": "CBD",
  "Other sectors": "Autres secteurs",
  "All quiz categories (pooled)": "Toutes les catégories de quiz (mises en commun)",
};
const GROUPED_NOTE =
  "Tout ce qui est en dehors des catégories nommées, y compris les quiz génériques et à plus forte réflexion. Mesuré à environ 3,6 %, soit environ 180 % d'une boutique typique.";
const POOLED_NOTE =
  "Le chiffre phare de la plateforme : 5,5 % (1 sur 18), soit environ 275 % d'une boutique typique à 2 %. Les quiz génériques et sans nom (~78 % des réponses) sont exclus des lignes par catégorie et tirent le chiffre global vers le bas, à ~4 %.";
const SCOPE: Record<string, string> = {
  "Statista": "Mondial, 2025",
  "IRP Commerce": "Données de commerçants en direct RU/IRL, 2025",
  "Dynamic Yield": "400+ marques de taille moyenne à grande, 2025",
  "Shopify": "Recommandations publiées par Shopify elle-même",
};
const tr = <T extends { vertical: string }>(r: T) => ({ ...r, vertical: VERT_LABEL[r.vertical] ?? r.vertical });
const consumable = VERTICAL_CONVERSION.filter((r) => r.kind === "consumable").map(tr);
const considered = VERTICAL_CONVERSION.filter((r) => r.kind === "considered").map(tr);
const grouped = { ...tr(VERTICAL_CONVERSION.find((r) => r.kind === "grouped")!), note: GROUPED_NOTE };
const pooled = { ...tr(VERTICAL_CONVERSION.find((r) => r.kind === "total")!), note: POOLED_NOTE };
const aovRows = AOV_UPLIFT.perVertical.map(tr);
const baselines = BASELINES.map((b) => ({ ...b, scope: SCOPE[b.source] ?? b.scope }));
---

<Base
  title={`${REPORT.title}: ${REPORT.subtitle}`}
  description={REPORT.description}
  ogImage={ogImage}
  jsonLd={jsonLd}
  lang="fr"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={localizedHref("/", "fr")} class="hover:text-slate-700">Accueil</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">L'état des quiz de recommandation de produits</span>
      </nav>
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">
          Rapport benchmark · {publishedLabel}
        </p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          L'état des quiz de recommandation de produits
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          1 client sur 18 qui termine un quiz de recommandation de produits passe une commande, soit <strong>2,75 fois plus qu'une boutique en ligne typique</strong>. Ce rapport détaille quelles catégories convertissent le mieux, combien dépensent en plus les clients du quiz et pendant combien de temps un seul quiz continue de rapporter. Basé sur des données réelles de <strong>{DATASET.responses} réponses au quiz</strong> dans {DATASET.brands} boutiques.
        </p>
        {/* TODO: restore hero CTAs ("Download the PDF" + "Read the findings")
            once a peer reviews the PDF design. Removed 2026-06-08 to hold the
            PDF download until that review. The PDF is still generated and the
            "Cite this report" section's download link is also held (see below). */}
      </div>
    </div>
  </section>

  <!-- Dataset band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-2xl bg-[#16161D] px-6 py-10 sm:px-10">
        <p class="text-center text-sm font-semibold uppercase tracking-wider text-white/50">
          Le jeu de données
        </p>
        <dl class="mt-6 grid grid-cols-1 gap-8 text-center sm:grid-cols-3">
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.responses}</dt>
            <dd class="mt-1 text-sm text-white/70">réponses au quiz analysées</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.revenue}</dt>
            <dd class="mt-1 text-sm text-white/70">de chiffre d'affaires généré pour les commerçants</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.brands}</dt>
            <dd class="mt-1 text-sm text-white/70">boutiques e-commerce</dd>
          </div>
        </dl>
        <p class="mx-auto mt-6 max-w-3xl text-center text-sm text-white/60">
          Agrégé et anonymisé, à travers Shopify, WooCommerce, BigCommerce, Magento et en autonome. Aucune boutique individuelle n'est identifiable. Chaque chiffre ci-dessous est un plancher : l'attribution est encore en cours de rattachement, donc les chiffres réels sont plus élevés.
        </p>
      </div>
    </div>
  </section>

  <!-- Key findings (stat cards) -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Les chiffres clés</h2>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">{HEADLINE.completedConv}%</p>
          <p class="mt-2 font-medium text-slate-900">des clients qui terminent un quiz passent une commande</p>
          <p class="mt-2 text-sm text-slate-600">Environ 1 sur {HEADLINE.completedOneIn}, soit à peu près {HEADLINE.multiple} fois une boutique typique à {HEADLINE.baselinePct}%.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">+{AOV_UPLIFT.headlineLow}-{AOV_UPLIFT.headlineHigh}%</p>
          <p class="mt-2 font-medium text-slate-900">d'average order value en plus, au sein de la même boutique</p>
          <p class="mt-2 text-sm text-slate-600">Mesuré à périmètre comparable, présent dans environ 7 boutiques sur 10.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">{HEADLINE.completionRate}%</p>
          <p class="mt-2 font-medium text-slate-900">des clients qui commencent un quiz le terminent</p>
          <p class="mt-2 text-sm text-slate-600">Environ 7 sur 10 atteignent la page de résultats. {HEADLINE.abandonRate}% abandonnent avant.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">1 sur 5</p>
          <p class="mt-2 font-medium text-slate-900">des commandes attribuées au quiz arrivent plus de 30 jours plus tard</p>
          <p class="mt-2 text-sm text-slate-600">Le quiz continue de générer du chiffre d'affaires pendant des mois après l'avoir réalisé.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Conversion by category -->
  <section id="conversion" class="scroll-mt-20 bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Conversion par catégorie</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        La moyenne de la plateforme cache une large dispersion. <strong>Les catégories de produits consommables et à réapprovisionner convertissent deux à trois fois plus</strong> que la boutique en ligne moyenne. Les achats à prix élevé et à forte réflexion convertissent un ordre de grandeur plus bas : là, le quiz favorise la découverte, mais la vente arrive plus tard, hors session.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">Catégorie</th>
              <th class="py-3 pr-4 text-right font-semibold">Conversion</th>
              <th class="py-3 pr-4 text-right font-semibold">Gain de conversion du quiz</th>
              <th class="py-3 text-right font-semibold">Réponses</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {consumable.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{r.rate}%</td>
                <td class="py-3 pr-4 text-right tabular-nums text-slate-600">{boost(r.rate)}%</td>
                <td class="py-3 text-right tabular-nums text-slate-500">{formatN(r.n)}</td>
              </tr>
            ))}
            {considered.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{r.rate}%</td>
                <td class="py-3 pr-4 text-right tabular-nums text-slate-600">{boost(r.rate)}%</td>
                <td class="py-3 text-right tabular-nums text-slate-500">{formatN(r.n)}</td>
              </tr>
            ))}
            <tr class="border-b border-slate-200">
              <td class="py-3 pr-4 font-medium">{grouped.vertical}</td>
              <td class="py-3 pr-4 text-right font-semibold tabular-nums">~{grouped.rate}%</td>
              <td class="py-3 pr-4 text-right tabular-nums text-slate-600">~{boost(grouped.rate)}%</td>
              <td class="py-3 text-right tabular-nums text-slate-500">{formatN(grouped.n)}</td>
            </tr>
            <tr class="border-t-2 border-slate-300">
              <td class="py-3 pr-4 font-semibold">{pooled.vertical}</td>
              <td class="py-3 pr-4 text-right font-bold tabular-nums">{pooled.rate}%</td>
              <td class="py-3 pr-4 text-right font-bold tabular-nums text-slate-600">{boost(pooled.rate)}%</td>
              <td class="py-3 text-right tabular-nums text-slate-500">toutes</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        {grouped.note}
      </p>
      <p class="mx-auto mt-2 max-w-3xl text-sm text-slate-500 text-center">
        {pooled.note}
      </p>
    </div>
  </section>

  <!-- AOV uplift -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Les clients du quiz dépensent-ils plus ?</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        <strong>Mesurées au sein de la même boutique</strong>, les commandes issues du quiz sont <strong>de {AOV_UPLIFT.headlineLow}% à {AOV_UPLIFT.headlineHigh}% plus importantes</strong> que les commandes hors quiz, et cela se vérifie dans {AOV_UPLIFT.storesUpLow}% à {AOV_UPLIFT.storesUpHigh}% des boutiques. Ce n'est pas universel : plus marqué là où le quiz peut composer un ensemble ou une routine, presque nul là où l'achat porte sur un seul article.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">Catégorie</th>
              <th class="py-3 pr-4 text-right font-semibold">Gain d'AOV au sein de la boutique</th>
              <th class="py-3 text-right font-semibold">Boutiques avec un gain</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {aovRows.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">
                  {r.uplift === null ? "Stable" : `+${r.uplift}%`}
                </td>
                <td class="py-3 text-right tabular-nums text-slate-500">
                  {r.storesUp === null ? "n/d" : `${r.storesUp}%`}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        Mesuré au sein de la boutique (même boutique, commandes du quiz vs commandes hors quiz), donc robuste face à la devise et neutralisant le mix de la boutique. Triangulé sur trois échantillons indépendants à +11%, +15% et +14% en médiane. Les catégories à faible échantillon sont omises plutôt que surévaluées.
      </p>
    </div>
  </section>

  <!-- Attribution / LTV -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Un quiz continue de rapporter après la session</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        La plupart des tableaux de bord d'attribution jugent un quiz sur les commandes du jour même et s'arrêtent là. Cela passe à côté de l'essentiel de la valeur. <strong>{ATTRIBUTION.sameDay}% des premières commandes attribuées au quiz ont lieu le jour même</strong>, mais la traîne est longue.
      </p>
      <div class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-4">
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.sameDay}%</p>
          <p class="mt-1 text-sm text-slate-600">le jour même</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.within7}%</p>
          <p class="mt-1 text-sm text-slate-600">sous 7 jours</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.within30}%</p>
          <p class="mt-1 text-sm text-slate-600">sous 30 jours</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">1 sur 5</p>
          <p class="mt-1 text-sm text-slate-600">arrivent plus de 30 jours plus tard</p>
        </div>
      </div>
      <p class="mx-auto mt-6 max-w-3xl text-slate-700 text-center">
        Environ <strong>1 commande attribuée au quiz sur 5 arrive plus de 30 jours après le quiz</strong>. Le quiz n'est pas qu'un coup de pouce vers le paiement : chaque réponse est une zero-party data qui étiquette le client et alimente des flux de relance segmentés et le retargeting. <a href="https://www.klaviyo.com/marketing-resources/segmentation-benchmark-report" target="_blank" rel="external noopener nofollow" class="font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]">Les campagnes segmentées génèrent plus de 3 fois le chiffre d'affaires par destinataire</a> des envois génériques, donc un seul quiz continue de convertir via l'email et la publicité personnalisés pendant des mois.
      </p>
    </div>
  </section>

  <!-- Baseline context -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Ce qui compte comme « la boutique moyenne »</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        Il n'existe pas de chiffre unique et vrai pour la conversion en e-commerce : il varie selon la méthodologie et l'échantillon. La fourchette honnête est d'environ 1,6% à 2,9%. Nous faisons notre benchmark contre un <strong>{HEADLINE.baselinePct}%</strong> rond, le bas de la fourchette conservateur, ce qui place les personnes qui font le quiz à environ <strong>{HEADLINE.multiple} fois</strong> la boutique moyenne.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">Source</th>
              <th class="py-3 pr-4 text-right font-semibold">Conversion moyenne</th>
              <th class="py-3 font-semibold">Périmètre</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {baselines.map((b) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">
                  <a href={b.href} target="_blank" rel="external noopener nofollow" class="text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-slate-500">{b.source}</a>
                </td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{b.rate}</td>
                <td class="py-3 text-sm text-slate-600">{b.scope}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        Important : notre 5,5% est un taux par personne ayant fait le quiz (commandes par quiz complété), alors que chaque chiffre ci-dessus est un taux à l'échelle du site (commandes par visiteur). Les personnes qui font le quiz s'auto-sélectionnent, donc une partie de l'écart relève de l'entonnoir, pas seulement du quiz. Nous présentons la comparaison telle quelle plutôt que de l'enjoliver.
      </p>
    </div>
  </section>

  <!-- Methodology -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Méthodologie</h2>
      <ul class="mt-8 space-y-5" role="list">
        {METHODOLOGY.map((m) => (
          <li class="flex gap-3">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400" aria-hidden="true"></span>
            <p class="text-slate-700">{m}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Questions fréquentes</h2>
      <div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
        {FAQ.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-lg font-semibold text-slate-900 [&::-webkit-details-marker]:hidden">
              <span>{f.question}</span>
              <svg
                class="h-5 w-5 flex-shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <p class="pb-5 text-slate-700" set:html={f.answerHtml ?? f.answer} />
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* TODO: restore the entire "Cite this report" section (PDF download +
      shareable stat-card links) once a designer reviews the report + PDF + card
      designs. Removed 2026-06-08 to hold the downloadable assets until review.
      The PDF and card PNGs are still generated by `bun run report`. */}

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Mesurez le gain sur votre propre boutique.
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-white/70">
        RevenueHunt est gratuit pour démarrer, avec 100 réponses au quiz par mois. Créez un quiz, envoyez-y du trafic et lisez vos propres chiffres.
      </p>
      <p class="mx-auto mt-4 max-w-2xl text-white/60">
        Découvrez ce que ces benchmarks pourraient apporter à votre boutique avec notre <a href={localizedHref("/quiz-roi-calculator/", "fr")} class="font-medium text-white underline decoration-white/40 underline-offset-2 hover:decoration-white">calculateur de ROI du quiz</a>.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SHOPIFY_INSTALL}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          démarrer gratuitement sur Shopify
        </a>
        <a
          href={WOO_PLUGIN}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          démarrer gratuitement sur WooCommerce
        </a>
      </div>
    </div>
  </section>
</Base>
