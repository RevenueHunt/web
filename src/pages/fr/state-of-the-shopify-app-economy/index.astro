---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb, article, faqPage } from "../../../lib/schema";
import { SITE } from "../../../lib/site";
import { localizedHref } from "../../../lib/i18n";
import {
  REPORT,
  SOURCE,
  HEADLINE,
  GROWTH,
  REVIEWS,
  REVENUE,
  PRICING,
  GEOGRAPHY,
  QUIZ_LANE,
  METHODOLOGY,
  FAQ,
} from "../../../lib/app-economy";

const pageUrl = new URL(`/fr/${REPORT.slug}/`, SITE.site_url).href;
const ogImage = `/og/${REPORT.slug}.png`;

const publishedLabel = new Date(REPORT.datePublished).toLocaleDateString("fr-FR", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const title = "L'état de l'économie des apps Shopify";
const description =
  "Il y a 22 546 apps actives sur le Shopify App Store et presque aucune ne va nulle part. Un rapport de données sur la croissance, les avis, la concentration des revenus, les prix et qui les crée, à partir d'un instantané de chaque app active.";

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Accueil", url: localizedHref("/", "fr") },
    { name: title, url: localizedHref(`/${REPORT.slug}/`, "fr") },
  ]),
  article({
    title,
    description,
    url: pageUrl,
    image: ogImage,
    datePublished: REPORT.datePublished,
    dateModified: REPORT.dateModified,
    author: "RevenueHunt",
    tags: [
      "Shopify app store",
      "développeurs d'apps Shopify",
      "statistiques de l'app store",
      "économie des apps",
    ],
  }),
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "L'état de l'économie des apps Shopify 2026",
    description,
    url: pageUrl,
    creator: organization(),
    license: "https://creativecommons.org/licenses/by/4.0/",
    isAccessibleForFree: true,
    datePublished: REPORT.datePublished,
    keywords: [
      "Shopify app store",
      "développeurs d'apps",
      "revenus des apps",
      "avis des apps",
      "ecommerce",
    ],
  },
  faqPage(FAQ),
];

// Section eyebrows for the editorial "field notes" feel.
const E = (n: string, label: string) => `${n} · ${label}`;

// Translated headline cards. Stats stay from the shared data module (HEADLINE[i].stat).
const headlineT = [
  { label: "apps actives sur le store", note: "Multiplié par 10 environ depuis 2020." },
  { label: "n'ont aucun avis", note: "Trois sur quatre en ont moins de cinq." },
  { label: "des revenus reviennent au 1 % du sommet", note: "225 apps. Estimé." },
  { label: "facturent d'avance", note: "Seulement 1 sur 20. Près de la moitié sont gratuites." },
];

// Growth caption with the lead phrase bolded.
const growthCaptionHtml =
  "Apps actives cumulées par année de lancement. <strong>Le Shopify App Store a été multiplié par 10 environ depuis 2020</strong> et a ajouté plus de 6 000 apps rien que sur les 12 derniers mois, soit environ 1 sur 4 de tout ce qui est actif aujourd'hui.";

// Quiz-lane paragraphs (translated), with the live search link and the load-bearing
// lines bolded inline. Caption text mirrors the English source's meaning.
const quizParas = [
  `Notre propre catégorie démontre la même chose. <a href="${QUIZ_LANE.searchUrl}" target="_blank" rel="external noopener nofollow" class="font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]">la recherche de quiz sur Shopify</a> renvoie 149 apps, mais ici la confiance s'accumule au sommet exactement comme dans tout le store. Les trois apps arrivées en premier et jamais reparties, RevenueHunt, Octane AI et Quiz Kit, concentrent 45 % de tous les avis de la catégorie ; <strong>RevenueHunt à elle seule en détient environ un quart</strong>, et la moitié inférieure n'en a aucun.`,
  `Nous ne sommes pas arrivés au sommet à coups de code. <strong>Les avis sont le résidu du tissu cicatriciel opérationnel</strong> qu'il y a derrière : six ans à répondre au support, à décrocher le téléphone avec des commerces qui ne paieraient jamais et à gagner la confiance boutique par boutique. Octane AI et Quiz Kit ont fait le même travail acharné pendant des années, <strong>et nous le respectons</strong>. Mention spéciale pour Lantern et Quizell, toutes deux avec un peu plus de 120 avis.`,
];

// Methodology stays in English (shared data module), with the lead phrase of each note bolded.
const METHOD_BOLD = [
  "Source: ",
  "Revenue is estimated, not measured.",
  "Growth uses each listing's published launch date. ",
  "Reviews are a proxy for traction",
];
const methodologyHtml = METHODOLOGY.map((m) =>
  METHOD_BOLD.reduce((acc, lead) => acc.replace(lead, `<strong>${lead}</strong>`), m),
);
---

<Base
  title={`${title} - rapport de données 2026`}
  description={description}
  ogImage={ogImage}
  jsonLd={jsonLd}
  lang="fr"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={localizedHref("/", "fr")} class="hover:text-slate-700">Accueil</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">L'état de l'économie des apps Shopify</span>
      </nav>
      <div class="text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">
          Notes de terrain · {publishedLabel}
        </p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          L'état de l'économie des apps Shopify
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          <strong>Il y a 22 546 apps actives sur le Shopify App Store, et presque aucune ne va nulle part.</strong> Nous avons pris un instantané de chaque app active, puis lu les données sur la croissance, les avis, les revenus, les prix et qui les crée. Elles racontent une seule histoire : créer l'app n'a jamais été la partie difficile.
        </p>
      </div>
    </div>
  </section>

  <!-- Source band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-2xl bg-[#16161D] px-6 py-10 sm:px-10">
        <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-white/50">
          L'instantané
        </p>
        <dl class="mt-6 grid grid-cols-2 gap-8 text-center sm:grid-cols-4">
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.apps}</dt>
            <dd class="mt-1 text-sm text-white/70">apps actives dans l'instantané</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.countries}</dt>
            <dd class="mt-1 text-sm text-white/70">pays qui les créent</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.reviewless}</dt>
            <dd class="mt-1 text-sm text-white/70">sans aucun avis</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.free}</dt>
            <dd class="mt-1 text-sm text-white/70">entièrement gratuites, sans plan payant</dd>
          </div>
        </dl>
        <p class="mx-auto mt-6 max-w-3xl text-center text-sm text-white/60">
          Chaque chiffre ci-dessous provient de la fiche publique sur l'App Store des 22 546 apps actives, juin 2026. Les revenus sont estimés à partir des prix publiés et de signaux d'usage, pas de données de facturation, et sont signalés comme tels dans tout le rapport.
        </p>
      </div>
    </div>
  </section>

  <!-- Headline cards -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Les chiffres marquants</h2>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        {HEADLINE.map((c, i) => (
          <div class="rounded-xl border border-slate-200 p-7">
            <p class="text-4xl font-bold tracking-tight text-[#16161D]">{c.stat}</p>
            <p class="mt-2 font-medium text-slate-900">{headlineT[i].label}</p>
            <p class="mt-2 text-sm text-slate-600">{headlineT[i].note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 01 Growth -->
  <section class="scroll-mt-20 bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("01", "Croissance")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Multiplié par 10 depuis 2020</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center" set:html={growthCaptionHtml} />
      <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
        <div class="h-72 sm:h-80"><canvas id="c-growth" aria-label="Apps Shopify actives cumulées par année" role="img"></canvas></div>
      </div>
    </div>
  </section>

  <!-- 02 Traction -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("02", "Traction")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">La plupart des apps n'obtiennent jamais d'avis</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">La moitié du Shopify App Store n'a jamais obtenu un seul avis. Trois apps sur quatre en ont moins de cinq. Un avis est l'indicateur public le plus clair d'un commerce réel et fidélisé, et la plupart des apps n'en obtiennent jamais aucun.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <div class="h-72 sm:h-80"><canvas id="c-reviews" aria-label="Répartition des avis parmi toutes les apps actives" role="img"></canvas></div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">74%</p>
            <p class="mt-1 text-slate-700">ont moins de cinq avis</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">{REVIEWS.avgRating}</p>
            <p class="mt-1 text-slate-700">note moyenne, parmi les {REVIEWS.ratedCount} apps qui en ont une</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 Revenue -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("03", "Revenus · estimé")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">L'argent se concentre tout en haut</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">Les revenus mensuels estimés sont brutalement concentrés au sommet. Le 1 % supérieur des apps (225 d'entre elles) capte 72 % estimés ; le top 10 à lui seul en capte près d'un tiers. À peine 36 % des apps semblent gagner quoi que ce soit.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-sm font-medium text-slate-500">Répartition des revenus</p>
          <div class="h-64 sm:h-72"><canvas id="c-revenue-donut" aria-label="Part des revenus estimés captée par le 1 % supérieur des apps" role="img"></canvas></div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-sm font-medium text-slate-500">Part cumulée des revenus estimés</p>
          <div class="h-64 sm:h-72"><canvas id="c-revenue-bars" aria-label="Part cumulée des revenus estimés par les apps en tête" role="img"></canvas></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 Pricing -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("04", "Prix")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Presque personne ne facture d'avance</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">Près de la moitié du store ne facture rien d'avance, et moins de 1 app sur 20 demande de l'argent avant la première installation. Près de 45 % offrent un plan gratuit permanent. Ici le freemium n'est pas une stratégie, c'est le minimum pour entrer.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <div class="h-72 sm:h-80"><canvas id="c-pricing" aria-label="Répartition du modèle de prix parmi toutes les apps actives" role="img"></canvas></div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">{PRICING.permanentFree}</p>
            <p class="mt-1 text-slate-700">offrent un plan gratuit permanent, pas seulement un essai</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">1 sur 20</p>
            <p class="mt-1 text-slate-700">apps facturent de l'argent avant la première installation</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 Who builds them -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("05", "Qui les crée")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Créées dans 115 pays, dominées par deux</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">Les apps viennent de 115 pays, mais deux dominent : les États-Unis (16 %) et l'Inde (9 %) créent à eux deux un quart du store. Et après des années de Shopify poussant le standard, seules 6,7 % des apps actives (environ 1 500) portent le badge Built for Shopify.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <div class="h-72 sm:h-80"><canvas id="c-geography" aria-label="Principaux pays de développeurs par nombre d'apps" role="img"></canvas></div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">{GEOGRAPHY.builtForShopify}</p>
            <p class="mt-1 text-slate-700">portent le badge Built for Shopify ({GEOGRAPHY.builtForShopifyCount} apps), des années après que Shopify a commencé à promouvoir le standard</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">25%</p>
            <p class="mt-1 text-slate-700">de tout le store est créé rien qu'aux États-Unis et en Inde</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 The quiz lane -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("06", "Le couloir des quiz")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Notre propre catégorie, de près</h2>
      {quizParas.map((html) => (
        <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center" set:html={html} />
      ))}
      <div class="mx-auto mt-8 grid max-w-3xl grid-cols-3 gap-4 text-center">
        <a
          href="https://apps.shopify.com/product-recommendation-quiz-revenuehunt"
          target="_blank"
          rel="external noopener"
          class="block rounded-xl border border-[#616eff]/60 p-6 shadow-[0_0_28px_-4px_rgba(97,110,255,0.55)] transition hover:border-[#616eff] hover:shadow-[0_0_32px_-2px_rgba(97,110,255,0.7)]"
        >
          <p class="text-sm font-semibold text-slate-900">RevenueHunt</p>
          <p class="mt-1 font-bold text-[#16161D]"><span class="text-3xl">{QUIZ_LANE.revenueHuntReviews}</span> <span class="text-sm font-medium text-slate-500">avis</span></p>
          <p class="mt-1 text-xs font-semibold text-slate-600"><span class="text-amber-400">★</span> 4,9 étoiles</p>
        </a>
        <div class="rounded-xl border border-slate-200 p-6">
          <p class="text-sm font-medium text-slate-700">Octane AI</p>
          <p class="mt-1 font-bold text-slate-500"><span class="text-3xl">{QUIZ_LANE.octaneReviews}</span> <span class="text-sm font-medium text-slate-500">avis</span></p>
          <p class="mt-1 text-xs font-semibold text-slate-600"><span class="text-amber-400">★</span> 4,8 étoiles</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-6">
          <p class="text-sm font-medium text-slate-700">Quiz Kit</p>
          <p class="mt-1 font-bold text-slate-500"><span class="text-3xl">{QUIZ_LANE.quizKitReviews}</span> <span class="text-sm font-medium text-slate-500">avis</span></p>
          <p class="mt-1 text-xs font-semibold text-slate-600"><span class="text-amber-400">★</span> 4,8 étoiles</p>
        </div>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-center text-sm text-slate-500">Avis sur le Shopify App Store, juin 2026. Octane AI et Quiz Kit sont les véritables concurrents de RevenueHunt dans cette catégorie ; respect pour les deux.</p>
    </div>
  </section>

  <!-- Takeaway -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#4dcaff]">La conclusion</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Créer l'app n'a jamais été la partie difficile.
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-white/75">
        L'IA n'a rien changé à cela. Elle a juste rendu impossible de le cacher. Quand le code devient une marchandise de base, le déluge de nouvelles apps n'est pas la concurrence. La concurrence, c'est la poignée qui est arrivée tôt et n'a jamais cessé de bosser : répondre au support, gagner des avis commerce par commerce, bâtir la confiance.
      </p>
      <p class="mx-auto mt-5 max-w-2xl text-lg font-semibold text-white">
        Distribution et confiance sont le seul coup à l'épreuve de l'IA qu'il reste.
      </p>
      <p class="mx-auto mt-10 max-w-2xl text-lg text-white/85">
        Vous construisez une app Shopify qui marche vraiment ? Je veux rencontrer les fondateurs qui font la partie difficile. Parlons-en.
      </p>
      <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={localizedHref("/contact/", "fr")}
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          Contactez-nous
        </a>
        <a
          href="https://www.linkedin.com/in/revenuehunt/"
          target="_blank"
          rel="external noopener"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          Connectez-vous sur LinkedIn
        </a>
      </div>
      <p class="mx-auto mt-10 max-w-2xl text-white/60">
        Vous avez trouvé cela intéressant ? Nous avons fait la même analyse dans notre propre catégorie dans <a href={localizedHref("/state-of-product-recommendation-quizzes/", "fr")} class="font-medium text-white underline decoration-white/40 underline-offset-2 hover:decoration-white">l'état des quiz de recommandation de produits</a>.
      </p>
    </div>
  </section>

  <!-- Methodology -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Méthodologie</h2>
      <ul class="mt-8 space-y-5" role="list">
        {methodologyHtml.map((m) => (
          <li class="flex gap-3">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400" aria-hidden="true"></span>
            <p class="text-slate-700" set:html={m} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Questions fréquentes</h2>
      <div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
        {FAQ.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-lg font-semibold text-slate-900 [&::-webkit-details-marker]:hidden">
              <span>{f.question}</span>
              <svg class="h-5 w-5 flex-shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <p class="pb-5 text-slate-700" set:html={f.answerHtml ?? f.answer} />
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  import Chart from "chart.js/auto";
  import { GROWTH, REVIEWS, REVENUE, PRICING, GEOGRAPHY, COLORS } from "../../../lib/app-economy";

  Chart.defaults.font.family =
    "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif";
  Chart.defaults.color = "#475569";
  Chart.defaults.font.size = 13;

  const el = (id: string) => document.getElementById(id) as HTMLCanvasElement | null;
  const grid = "#eef0f2";
  const kfmt = (v: number) => (v >= 1000 ? v / 1000 + "K" : "" + v);

  const growth = el("c-growth");
  if (growth)
    new Chart(growth, {
      type: "line",
      data: {
        labels: GROWTH.labels,
        datasets: [
          {
            data: GROWTH.cumulative,
            borderColor: COLORS.primary,
            backgroundColor: "rgba(97,110,255,0.10)",
            fill: true,
            tension: 0.35,
            borderWidth: 2.5,
            pointRadius: 3,
            pointHoverRadius: 5,
            pointBackgroundColor: COLORS.primary,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: { callbacks: { label: (c) => Number(c.parsed.y).toLocaleString() + " apps live" } },
        },
        scales: {
          y: { beginAtZero: true, grid: { color: grid }, ticks: { callback: (v) => kfmt(Number(v)) } },
          x: { grid: { display: false } },
        },
      },
    });

  const donutOpts = (suffix: string) => ({
    responsive: true,
    maintainAspectRatio: false,
    cutout: "62%",
    plugins: {
      legend: { position: "bottom" as const, labels: { boxWidth: 12, boxHeight: 12, padding: 16 } },
      tooltip: { callbacks: { label: (c: any) => `${c.label}: ${c.parsed}${suffix}` } },
    },
  });

  const reviews = el("c-reviews");
  if (reviews)
    new Chart(reviews, {
      type: "doughnut",
      data: { labels: REVIEWS.labels, datasets: [{ data: REVIEWS.values, backgroundColor: REVIEWS.colors, borderWidth: 0 }] },
      options: donutOpts("%"),
    });

  const revDonut = el("c-revenue-donut");
  if (revDonut)
    new Chart(revDonut, {
      type: "doughnut",
      data: { labels: REVENUE.donut.labels, datasets: [{ data: REVENUE.donut.values, backgroundColor: REVENUE.donut.colors, borderWidth: 0 }] },
      options: donutOpts("%"),
    });

  const revBars = el("c-revenue-bars");
  if (revBars)
    new Chart(revBars, {
      type: "bar",
      data: { labels: REVENUE.bars.labels, datasets: [{ data: REVENUE.bars.values, backgroundColor: COLORS.primary, borderRadius: 4, barThickness: 26 }] },
      options: {
        indexAxis: "y",
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: (c) => c.parsed.x + "% of estimated revenue" } } },
        scales: { x: { beginAtZero: true, max: 100, grid: { color: grid }, ticks: { callback: (v) => v + "%" } }, y: { grid: { display: false } } },
      },
    });

  const pricing = el("c-pricing");
  if (pricing)
    new Chart(pricing, {
      type: "doughnut",
      data: { labels: PRICING.labels, datasets: [{ data: PRICING.values, backgroundColor: PRICING.colors, borderWidth: 0 }] },
      options: donutOpts("%"),
    });

  const geo = el("c-geography");
  if (geo)
    new Chart(geo, {
      type: "bar",
      data: { labels: GEOGRAPHY.labels, datasets: [{ data: GEOGRAPHY.values, backgroundColor: GEOGRAPHY.labels.map((_, i) => (i < 2 ? COLORS.primary : COLORS.secondary)), borderRadius: 4 }] },
      options: {
        indexAxis: "y",
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: (c) => Number(c.parsed.x).toLocaleString() + " apps" } } },
        scales: { x: { beginAtZero: true, grid: { color: grid }, ticks: { callback: (v) => kfmt(Number(v)) } }, y: { grid: { display: false } } },
      },
    });
</script>
