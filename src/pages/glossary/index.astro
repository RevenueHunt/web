---
import Base from "../../layouts/Base.astro";
import { organization, breadcrumb, softwareApplication, definedTermSet } from "../../lib/schema";
import {
  GLOSSARY,
  GLOSSARY_ORDER,
  GLOSSARY_RELATED_GUIDES,
} from "../../lib/glossary";

const terms = GLOSSARY_ORDER.map((slug) => GLOSSARY[slug]!);

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=glossary_index";
// Free WordPress.org plugin (not the WooCommerce.com extension).
const WOO_PLUGIN = "https://wordpress.org/plugins/product-recommendation-quiz-for-ecommerce/";

const jsonLd = [
  organization(),
  softwareApplication(),
  breadcrumb([
    { name: "Home", url: "/" },
    { name: "Glossary", url: "/glossary/" },
  ]),
  definedTermSet(
    terms.map((t) => ({ name: t.term, description: t.shortAnswer, url: `/glossary/${t.slug}/` })),
  ),
];
---

<Base
  title="Quiz & personalization glossary"
  description="Plain-English definitions of the quiz and personalization terms in ecommerce: conversational commerce, product discovery, quiz funnels, and more."
  ogImage="/og/glossary.png"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-slate-700">Home</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Glossary</span>
      </nav>
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">Glossary</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          Quiz and personalization glossary
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          Plain-English definitions of the terms behind product quizzes and ecommerce personalization. No jargon, no fluff, just what each one means and why it matters.
        </p>
      </div>
    </div>
  </section>

  <!-- Terms -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Terms</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {terms.map((t) => (
          <li>
            <a
              href={`/glossary/${t.slug}/`}
              class="group block h-full rounded-xl border border-slate-200 p-6 transition hover:border-[#16161D] hover:shadow-md"
            >
              <h3 class="text-lg font-semibold text-slate-900 group-hover:text-[#16161D]">{t.term}</h3>
              <p class="mt-2 text-sm text-slate-600">{t.shortAnswer}</p>
              <span class="mt-4 inline-flex items-center text-sm font-medium text-[#16161D]">
                Read definition
                <svg class="ml-1 h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M7.21 4.29a1 1 0 011.42 0l5 5a1 1 0 010 1.42l-5 5a1 1 0 11-1.42-1.42L11.09 10 7.21 6.12a1 1 0 010-1.42z" clip-rule="evenodd" />
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Related guides -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Guides and tools</h2>
      <p class="mt-3 max-w-3xl text-slate-700">
        Deeper guides on the topics above, and a calculator to size the opportunity for your store.
      </p>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {GLOSSARY_RELATED_GUIDES.map((g) => (
          <li>
            <a
              href={g.href}
              {...(g.external ? { target: "_blank", rel: "external noopener" } : {})}
              class="group block h-full rounded-xl border border-slate-200 bg-white p-6 transition hover:border-[#16161D] hover:shadow-md"
            >
              <h3 class="text-lg font-semibold text-slate-900 group-hover:text-[#16161D]">{g.label}</h3>
              {g.blurb && <p class="mt-2 text-sm text-slate-600">{g.blurb}</p>}
              <span class="mt-4 inline-flex items-center text-sm font-medium text-[#16161D]">
                Read more
                <svg class="ml-1 h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M7.21 4.29a1 1 0 011.42 0l5 5a1 1 0 010 1.42l-5 5a1 1 0 11-1.42-1.42L11.09 10 7.21 6.12a1 1 0 010-1.42z" clip-rule="evenodd" />
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        See why 20,000+ brands choose RevenueHunt.
      </h2>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a
          href={SHOPIFY_INSTALL}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          start free on Shopify
        </a>
        <a
          href={WOO_PLUGIN}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          start free on WooCommerce
        </a>
      </div>
    </div>
  </section>
</Base>
