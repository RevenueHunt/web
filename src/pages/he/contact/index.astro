---
import Base from "../../../layouts/Base.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import YouTubeFacade from "../../../components/YouTubeFacade.astro";
import { organization, breadcrumb } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "דף הבית", url: "/" },
    { name: "צרו קשר", url: "/contact/" },
  ]),
];

const channels = [
  {
    label: "קראו את מדריכי העזרה",
    href: "https://docs.revenuehunt.com/",
    note: "תיעוד בשירות עצמי, אינטגרציות ופתרון תקלות.",
    external: true,
  },
  {
    label: "תמיכה ומכירות באימייל",
    href: "mailto:team@revenuehunt.com",
    note: "team@revenuehunt.com - ראו זמני תגובה למטה.",
  },
  {
    label: "בדקו את סטטוס המערכת",
    href: "https://status.revenuehunt.com/",
    note: "תקינות שירות בזמן אמת והיסטוריית תקלות. זמינות של 99.98%+.",
    external: true,
  },
];

const responseTiers = [
  {
    label: "קריטי - הפקה מושבתת, אבטחה, שלמות נתונים",
    sla: "תגובה ראשונה תוך 30 דקות, 24/7 בכל העולם",
  },
  {
    label: "גבוה - פיצ'ר מרכזי נפגע, מספר משתמשים מושפעים",
    sla: "תגובה ראשונה תוך 12 שעות",
  },
  {
    label: "סטנדרטי - שאלות, עזרה בהגדרות",
    sla: "יום עסקים אחד",
  },
  {
    label: "עדיפות נמוכה - משוב, בקשות לפיצ'רים",
    sla: "עד 3 ימי עסקים",
  },
];
---

<Base
  title="צרו קשר - RevenueHunt"
  description="צרו קשר עם צוות התמיכה של RevenueHunt. קראו את מדריכי העזרה, צפו במדריך או מלאו את חידון התמיכה כדי לקבל תשובה מותאמת אישית תוך דקות."
  jsonLd={jsonLd}
  lang="he"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20 text-center">
      <Breadcrumb items={[{ label: "דף הבית", href: localizedHref("/", "he") }, { label: "צרו קשר" }]} />
      <Eyebrow>דברו איתנו</Eyebrow>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        צרו קשר
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600">
        קראו את מדריכי העזרה, צפו במדריך או מלאו את חידון התמיכה שלנו למטה - צוות התמיכה
        החד והאדיב ביותר באיקומרס יחזור אליכם.
      </p>
    </div>
  </section>

  <!-- Two-column: video + channels -->
  <section class="mx-auto max-w-7xl px-6 py-12">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">התחילו עם המדריך</h2>
        <p class="mt-3 text-slate-600">
          רוב השאלות נענות בסיור של 3 דקות. צפו בו במהירות לפני שאתם פונים אלינו.
        </p>
        <div class="mt-6 aspect-video overflow-hidden rounded-xl bg-slate-900 shadow-xl">
          <YouTubeFacade id="oL1DnBd6N1U" title="מדריך התמיכה של RevenueHunt" />
        </div>
      </div>
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">דרכים ליצור איתנו קשר</h2>
        <ul class="mt-6 space-y-3">
          {channels.map((c) => (
            <li>
              <a
                href={c.href}
                target={c.external ? "_blank" : undefined}
                rel={c.external ? "external noopener" : undefined}
                class="group flex items-start justify-between gap-4 rounded-xl border border-slate-200 bg-white p-5 transition hover:border-slate-300 hover:shadow-md"
              >
                <div>
                  <p class="text-base font-semibold text-slate-900 group-hover:text-[#16161D]">{c.label}</p>
                  <p class="mt-1 text-sm text-slate-600">{c.note}</p>
                </div>
                <span class="mt-1 shrink-0 text-slate-400 transition group-hover:text-[#16161D]" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Support quiz -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">מלאו את חידון התמיכה שלנו</h2>
      <p class="mx-auto mt-3 max-w-2xl text-slate-600">
        ענו על כמה שאלות קצרות ואנחנו ננתב אתכם לעזרה הנכונה - תיעוד, מדריך או תשובה מאדם אמיתי.
      </p>
      <div class="mx-auto mt-8 max-w-4xl overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <iframe
          src="https://admin.revenuehunt.com/public/quiz/ZAHJoMM"
          title="חידון התמיכה של RevenueHunt"
          loading="lazy"
          class="block h-[600px] w-full"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Response times — moved here from the right column so it sits under
       the quiz, since that's where visitors land after asking for help. -->
  <section class="mx-auto max-w-4xl px-6 py-16">
    <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm sm:p-10">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">זמני תגובה</h2>
      <p class="mt-3 text-slate-600">
        SLA תמיכה מדורג לכל הסוחרים, עם עדיפות לחשבונות Shopify Plus ו-enterprise.
      </p>
      <dl class="mt-6 grid gap-4 sm:grid-cols-2">
        {responseTiers.map((t) => (
          <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
            <dt class="text-sm font-semibold text-slate-900">{t.label}</dt>
            <dd class="mt-1 text-sm text-slate-600">{t.sla}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Base>
