---
import Base from "../../layouts/Base.astro";
import PlanCards from "../../components/pages/PlanCards.astro";
import YouTubeFacade from "../../components/YouTubeFacade.astro";
import { organization, website, softwareApplication } from "../../lib/schema";
import { SITE } from "../../lib/site";
import { localizedHref } from "../../lib/i18n";

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=bfs_badge_hero";
const WOOCOMMERCE_DOWNLOAD =
  "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";
const YOUTUBE_ID = "fJqpGJUzZNE";

const stats = [
  { value: "+20,000", label: "מותגים שמשתמשים ב-RevenueHunt" },
  { value: "+45M", label: "חידונים שהושלמו" },
  { value: "+370M USD", label: "הכנסות לסוחרים" },
  { value: "4.9 ★", label: "יותר מ-450 ביקורות חמישה כוכבים" },
];

const pillars = [
  {
    image: "/img/pages/home/recommend-right-products.svg",
    title: "המליצו על המוצרים הנכונים",
    body:
      "חידונים עם מוצרים משולבים מניעים מכירות, מייעצים ללקוחות למצוא את המוצרים הנכונים עבורם ועוזרים להם לקבל החלטות קנייה בביטחון.",
  },
  {
    image: "/img/pages/home/know-your-customers.svg",
    title: "הכירו את הלקוחות שלכם",
    body:
      "חידונים מאפשרים לכם לאסוף נתונים ניתנים לפעולה על ידי שאילת שאלות קונקרטיות ללקוחות שלכם. סגמנטו ותייגו את הקונים שלכם לפי התשובות שלהם.",
  },
  {
    image: "/img/pages/home/grow-your-audience.svg",
    title: "הצמיחו את הקהל שלכם",
    body:
      "שלחו את הלידים שנלכדו לרשימת התפוצה או ל-CRM שלכם. נצלו את נתוני פרופיל הלקוח כדי ליצור קמפיינים שיווקיים מותאמים אישית ועם ROI גבוה יותר.",
  },
];

const features = [
  {
    kicker: "Copilot חידון עם AI",
    title: "צרו חידון תוך 60 שניות עם AI",
    body:
      "תארו את החנות שלכם וה-copilot עם ה-AI שלנו מייצר חידון מוגדר לחלוטין - שאלות, לוגיקה והקצאת מוצרים - מוכן לפרסום.",
  },
  {
    kicker: "לוגיקה מותנית",
    title: "לוגיקת הסתעפות בגרירה ושחרור",
    body:
      "הציגו או הסתירו שאלות לפי התשובות הקודמות. הובילו כל קונה במסלול שמסתיים ברכישה - בלי צורך בקוד.",
  },
  {
    kicker: "עיצוב החידון",
    title: "הפכו אותו לשלכם - בלי צורך בקוד",
    body:
      "התאימו אישית צבעים, גופנים, תמונות ועיצוב שיתאימו למותג שלכם. החידון שלכם נראה כחלק מהחנות שלכם, לא ווידג'ט של צד שלישי.",
  },
  {
    kicker: "עמוד תוצאות",
    title: "עמוד תוצאות מוכן ל-checkout שממיר",
    body:
      "הציגו המלצות מוצרים מותאמות אישית מקובצות לפי שלב בשגרה - עם תמונות, מחירים וכפתורי הוספה לעגלה. הקונים קונים ישירות מעמוד התוצאות.",
  },
  {
    kicker: "אנליטיקת נטישה",
    title: "דעו בדיוק היכן הקונים נוטשים",
    body:
      "עיינו בשיעורי הנטישה שאלה אחר שאלה, ביעדים ובתוצאות. תקנו נקודות חיכוך, שפרו את שיעורי ההשלמה והחזירו הכנסות שאבדו.",
  },
  {
    kicker: "אינטגרציות של צד שלישי",
    title: "חברו את כל סטאק השיווק שלכם",
    body:
      "שלחו את נתוני החידון ל-Google Analytics, הפעילו אירועי Meta Pixel לריטרגטינג וסנכרנו לידים עם Klaviyo - הכול מעמוד הגדרות אחד. בלי קוד, בלי middleware.",
  },
];

const steps = [
  {
    title: "התקינו את האפליקציה",
    body: "התקנה בלחיצה אחת מ-Shopify App Store או מספריית הפלאגינים של WordPress.",
  },
  {
    title: "צרו את החידון שלכם",
    body: "השתמשו ב-copilot עם ה-AI או בעורך הגרירה ושחרור. הוסיפו את השאלות שלכם, הגדירו את הלוגיקה שלכם.",
  },
  {
    title: "הקצו את המוצרים שלכם",
    body: "חברו את תשובות החידון לקטלוג המוצרים שלכם. המליצו על ההתאמה הטובה ביותר לכל תוצאה.",
  },
  {
    title: "פרסמו וקדמו",
    body: "הטמיעו אותו בכל עמוד, הציגו אותו כפופ-אפ בזיהוי כוונת יציאה או קשרו אליו מהמודעות שלכם.",
  },
];

const testimonials = [
  {
    quote:
      "עברתי מ-Octane. תהליך העיצוב היה הרבה יותר אינטואיטיבי ונעים ויזואלית. כשנתקלתי בבעיה עם Klaviyo, התמיכה הגיבה במהירות הבזק ובגישה מאוד נגישה ופתוחה.",
    author: "Kae Paché",
  },
  {
    quote:
      "אריק היה סבלני, מקצועי ויסודי במיוחד - הדריך אותי צעד אחר צעד בהגדרת החידון. תמיכה כזו היא נדירה.",
    author: "Marcelle",
  },
  {
    quote:
      "האפליקציה עצמה מצוינת: פיצ'רים עוצמתיים, שימושיות אינטואיטיבית. הצוות יצר עבורנו מדריך מודרך מותאם אישית. אנחנו משתמשים בה כבר יותר מ-3 שנים.",
    author: "Didymos",
  },
  {
    quote:
      "ללא ספק אפליקציית החידון והמלצת המוצרים הטובה ביותר שניסיתי ב-Shopify. הצוות הקדיש זמן לחקור, להסביר כל שלב בבהירות ולהדריך אותי עד שהבעיה נפתרה לחלוטין.",
    author: "REYNA",
  },
  {
    quote:
      "זו הייתה אפליקציית החידון החמישית שניסיתי והיחידה שתמכה במלואה במה שהייתי צריך. הצלחתי ליצור את החידון הראשון שלי מהר מאוד.",
    author: "CCA Printing",
  },
  {
    quote:
      "שירות הלקוחות בולט - נציג הקליט סרטון והסביר לי את הפתרון צעד אחר צעד. מאוד קשוב וסופר מועיל.",
    author: "The Love U Collective",
  },
];

const verticals = [
  { icon: "💄", title: "יופי וטיפוח עור", body: "מאתרי סוג עור, בחירת גוון, בוני שגרות טיפוח." },
  { icon: "💊", title: "תוספים", body: "חידוני מטרות בריאות שממליצים על הסטאק הנכון." },
  { icon: "👗", title: "אופנה", body: "חידוני סגנון שמגלים את המידה, הצבע והגזרה הנכונים." },
  { icon: "🐾", title: "חיות מחמד", body: "המלצות מוצרים ספציפיות לפי גזע לכל בעלים." },
  { icon: "🍵", title: "מזון ומשקאות", body: "חידוני פרופיל טעם שהופכים סקרנים למנויים." },
  { icon: "🏋️", title: "כושר", body: "משפכים מבוססי מטרות לציוד, ביגוד ותוכניות." },
  { icon: "🏠", title: "בית ועיצוב", body: "חידוני סגנון שמתאימים רהיטים לכל חלל בבית." },
  { icon: "🌿", title: "אקו ובר-קיימא", body: "חידונים שמחברים ערכים לצרכן המודע." },
];

const brands = [
  "Olaplex", "Madluvv", "Mattel", "Alt", "Baia", "Bare", "Biktrix",
  "Dermocracy", "Diego", "Gisou", "Laura", "Nuxe", "Olcay",
  "Salad Code", "Salugea", "Sunday", "Tushy", "Tiege",
];

const SHOPIFY_REVIEWS =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/reviews?ratings%5B%5D=5&sort_by=relevance";
const WOOCOMMERCE_REVIEWS =
  "https://wordpress.org/support/plugin/product-recommendation-quiz-for-ecommerce/reviews/?filter=5";
---

<Base
  lang="he"
  translated={true}
  title={`${SITE.name} - חידון המלצת המוצרים שממיר`}
  description="הפכו סקרנים שרק מסתכלים לרוכשים עם חידון המלצת מוצרים מודרך. לכדו zero-party data, המליצו על המוצר הנכון והגדילו את ההמרה. בלי קוד."
  jsonLd={[organization(), website(), softwareApplication()]}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-7xl px-6 py-16 lg:py-24">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:items-start lg:gap-16">
        <div>
          <a
            href={SHOPIFY_INSTALL}
            rel="external nofollow"
            onclick="window.gtag&&gtag('event','shopify_app_install',{event_label:'home_hero_badge'})"
            class="mb-6 inline-block"
          >
            <img
              src="/img/home/bfs-badge.webp"
              alt="Built for Shopify"
              width="120"
              height="38"
              class="h-8 w-auto"
              loading="eager"
            />
          </a>
          <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
            חידון המלצת המוצרים שהופך סקרנים לרוכשים
          </h1>
          <p class="mt-6 max-w-xl text-lg text-slate-700">
            מודעות בתשלום מביאות קליקים - החידונים שלנו הופכים אותם למכירות. RevenueHunt מובילה את הקונים אל המוצרים הנכונים,
            אוספת נתונים ומניעה המרות. קל להתקנה, בלי קוד.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={SHOPIFY_INSTALL}
              rel="external nofollow"
              onclick="window.gtag&&gtag('event','shopify_app_install',{event_label:'home_hero'})"
              class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
            >
              התקינו ב-Shopify
            </a>
            <a
              href={WOOCOMMERCE_DOWNLOAD}
              rel="external nofollow"
              onclick="window.gtag&&gtag('event','download_woocommerce_plugin',{event_label:'home_hero'})"
              class="inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-6 py-3 text-base font-semibold text-slate-900 transition hover:border-slate-400 hover:bg-slate-50"
            >
              הורידו עבור WooCommerce
            </a>
          </div>
          <p class="mt-4 text-sm text-slate-500">
            תוכנית חינמית זמינה · תקופת ניסיון חינם של 15 יום · החזר כספי תוך 30 יום
          </p>
        </div>

        <div class="relative lg:mt-14">
          <div class="aspect-video overflow-hidden rounded-xl bg-slate-900 shadow-2xl">
            <YouTubeFacade
              id={YOUTUBE_ID}
              title="RevenueHunt - חידון המלצת מוצרים"
              poster="/img/home/video-poster.webp"
              alt="דמו של חידון המלצת המוצרים של RevenueHunt לחנויות Shopify ו-WooCommerce"
              eager
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats / proof bar -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <p class="text-center text-sm font-semibold uppercase tracking-wider text-white/70">
        למה לבחור ב-RevenueHunt? ההשפעה שלנו מדברת בעד עצמה
      </p>
      <dl class="mt-8 grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-4">
        {stats.map((s) => (
          <div class="text-center">
            <dt class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{s.value}</dt>
            <dd class="mt-2 text-sm text-white/70">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Problem framing -->
  <section class="mx-auto max-w-4xl px-6 py-20 text-center">
    <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
      הקונים לא תמיד יודעים מה לקנות - וזה אומר מכירות שאבדו.
    </h2>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-700">
      <a href={localizedHref("/product-recommendation-quiz/", "he")} class="font-semibold text-slate-900 underline underline-offset-4 hover:text-slate-700">חידון המלצת המוצרים</a> שלנו מוביל כל לקוח לאורך המסע שלו, ועוזר לו לגלות ולקנות את המוצרים הנכונים עבורו.
    </p>
  </section>

  <!-- 3-up pillars -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="grid gap-10 md:grid-cols-3">
        {pillars.map((p) => (
          <div class="text-center">
            <img src={p.image} alt={p.title} width="120" height="120" class="mx-auto h-24 w-24" loading="lazy" />
            <h3 class="mt-6 text-xl font-semibold text-slate-900">{p.title}</h3>
            <p class="mt-3 text-slate-600">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features grid -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">כל מה שאתם צריכים כדי למכור בצורה חכמה יותר</h2>
      </div>
      <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {features.map((f) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">{f.kicker}</p>
            <h3 class="mt-2 text-xl font-semibold text-slate-900">{f.title}</h3>
            <p class="mt-3 text-slate-600">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4-step setup -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">עולה לאוויר ב-4 שלבים. בפחות מ-15 דקות.</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          בלי מפתחים. בלי קוד. רק חידון שהלקוחות שלכם יאהבו.
        </p>
      </div>
      <ol class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <li class="rounded-xl border border-slate-200 bg-white p-6">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-[#16161D] text-sm font-bold text-white">{i + 1}</span>
            <h3 class="mt-4 text-lg font-semibold text-slate-900">{s.title}</h3>
            <p class="mt-2 text-slate-600">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          גלו למה הסוחרים אוהבים את חידון המלצת המוצרים
        </h2>
        <p class="mx-auto mt-4 max-w-3xl text-lg text-slate-700">
          זוכה לאמון של יותר מ-20,000 מותגים ומגובה ביותר מ-450 ביקורות חמישה כוכבים ב-Shopify, WooCommerce ועוד -
          RevenueHunt היא אפליקציית החידון המובילה להנעת מכירות באמצעות התאמה אישית. אבל אל תאמינו רק למילה שלנו.
        </p>
        <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap text-sm">
          <a href={SHOPIFY_REVIEWS} rel="external nofollow" class="font-semibold text-[#16161D] underline-offset-4 hover:underline">
            ביקורות ב-Shopify →
          </a>
          <a href={WOOCOMMERCE_REVIEWS} rel="external nofollow" class="font-semibold text-[#16161D] underline-offset-4 hover:underline">
            ביקורות ב-WooCommerce →
          </a>
        </div>
      </div>

      <h3 class="mt-16 text-center text-xl font-semibold text-slate-900">מה הסוחרים אומרים</h3>
      <div class="rh-carousel mt-8">
        <ul data-carousel class="rh-carousel__track" aria-label="המלצות של סוחרים">
          {testimonials.map((t) => (
            <li class="rounded-xl border border-slate-200 bg-white p-6">
              <p class="text-amber-500" aria-label="5 מתוך 5 כוכבים">★★★★★</p>
              <blockquote class="mt-3 text-slate-700">"{t.quote}"</blockquote>
              <p class="mt-4 text-sm font-semibold text-slate-900"> - {t.author}</p>
            </li>
          ))}
        </ul>
        <div data-carousel-dots class="rh-carousel__dots"></div>
      </div>
    </div>
  </section>

  <!-- Verticals -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">נבנה לכל ורטיקל של eCommerce</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          בין אם אתם מוכרים טיפוח עור, תוספים או ספות - חידון שעוזר לקונים למצוא את המוצר הנכון ממיר טוב יותר מכל עמוד קולקציה.
        </p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {verticals.map((v) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6">
            <span class="block text-3xl" aria-hidden="true">{v.icon}</span>
            <h3 class="mt-3 text-base font-semibold text-slate-900">{v.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Brand logos -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-white sm:text-3xl">מניעים את מותגי ה-eCommerce המובילים</h2>
      <div class="brands-marquee mt-10">
        <ul class="brands-marquee__track" aria-label="לוגואים של מותגי לקוחות">
          {brands.map((b) => (
            <li class="brands-marquee__item">
              <img
                src={`/img/brands/${b.toLowerCase().replace(/ /g, "-")}.svg`}
                alt={b}
                loading="lazy"
                width="160"
                height="40"
              />
            </li>
          ))}
          {brands.map((b) => (
            <li class="brands-marquee__item" aria-hidden="true">
              <img
                src={`/img/brands/${b.toLowerCase().replace(/ /g, "-")}.svg`}
                alt={`${b} logo`}
                loading="lazy"
                width="160"
                height="40"
              />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <style>
    .brands-marquee {
      overflow: hidden;
      -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
      mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    }
    .brands-marquee__track {
      display: flex;
      align-items: center;
      width: max-content;
      list-style: none;
      padding: 0;
      margin: 0;
      animation: brands-marquee 40s linear infinite;
    }
    .brands-marquee:hover .brands-marquee__track {
      animation-play-state: paused;
    }
    .brands-marquee__item {
      flex-shrink: 0;
      padding: 10px 24px;
      height: 64px;
      display: flex;
      align-items: center;
    }
    .brands-marquee__item img {
      height: 100%;
      width: auto;
      max-width: 160px;
      object-fit: contain;
      /* Normalize mixed-fill SVGs to white on the dark strip. */
      filter: brightness(0) invert(1);
      opacity: 0.85;
    }
    @keyframes brands-marquee {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }
    @media (prefers-reduced-motion: reduce) {
      .brands-marquee__track { animation: none; }
    }
  </style>

  <!-- Plans summary -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">בחרו את התוכנית הטובה ביותר לאיקומרס שלכם</h2>
        <p class="mt-4 text-base text-slate-700 sm:text-lg">
          תוכנית חינמית זמינה. תקופת ניסיון חינם של 15 יום עם תשובות חידון ללא הגבלה וכל הפיצ'רים. החזר כספי תוך 30 יום.
        </p>
      </div>

      <div class="mt-12">
        <PlanCards lang="he" />
      </div>
    </div>
  </section>

  <!-- Multi-platform strip -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-16 text-center">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">עובד על מגוון פלטפורמות eCommerce</h2>
      <!-- Logos are white SVGs (built for a dark bg); brightness-0 inverts them to dark for this white section. -->
      <ul class="mt-10 flex flex-wrap items-center justify-center gap-x-14 gap-y-8">
        <li>
          <a href={localizedHref("/product-recommendation-quiz-shopify/", "he")} aria-label="חידון המלצת מוצרים ל-Shopify">
            <img src="/img/logos/shopify_monotone_white.svg" alt="Shopify" class="h-8 w-auto opacity-60 brightness-0 transition hover:opacity-100" />
          </a>
        </li>
        <li>
          <a href={localizedHref("/product-recommendation-quiz-woocommerce/", "he")} aria-label="חידון המלצת מוצרים ל-WooCommerce">
            <img src="/img/logos/woo_logo_white.svg" alt="WooCommerce" class="h-8 w-auto opacity-60 brightness-0 transition hover:opacity-100" />
          </a>
        </li>
        <li>
          <a href={localizedHref("/product-recommendation-quiz-bigcommerce/", "he")} aria-label="חידון המלצת מוצרים ל-BigCommerce">
            <img src="/img/logos/bigcommerce_logo_white.svg" alt="BigCommerce" class="h-7 w-auto opacity-60 brightness-0 transition hover:opacity-100" />
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-white/70">
        רוב הקונים עוזבים כי הם לא מוצאים את המוצר הנכון
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        הפכו קונים לרוכשים בטוחים עם חידון המלצת מוצרים שמניע מכירות.
      </h2>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SHOPIFY_INSTALL}
