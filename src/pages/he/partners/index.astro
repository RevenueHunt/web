---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

interface Partner {
  name: string;
  url: string;
  logo: string;
  description: string;
}

const groups: { heading: string; emoji: string; intro: string; items: Partner[] }[] = [
  {
    heading: "לוקליזציה",
    emoji: "🌍",
    intro: "מכרו מעבר לגבולות עם גיאו-לוקיישן, תרגום ותמיכה במטבעות מרובים מובנים.",
    items: [
      { name: "Orbe Shopify Geolocation", url: "https://orbe.app/", logo: "/img/pages/partners/orbe-removebg-preview.webp", description: "מקסמו מכירות גלובליות עם גאו-לוקיישן מתקדם של Shopify. התאימו אישית מוצרים, מחירים, מטבע ותוכן לכל מדינה והובילו לקוחות לחוויית הקנייה הנכונה עם Orbe." },
      { name: "Langwill: Language Translate", url: "https://apps.shopify.com/localiser", logo: "/img/pages/partners/1.webp", description: "הרחיבו את ההגעה הגלובלית שלכם עם Langwill - תרגמו את חנות ה-Shopify שלכם ל-138 שפות והמירו מטבעות אוטומטית לחוויית קנייה חלקה ומקומית." },
    ],
  },
  {
    heading: "צ'אט ותמיכה",
    emoji: "💬",
    intro: "כלי חשבון לקוח שהופכים שירות עצמי ותמיכה לפשוטים.",
    items: [
      { name: "Dondy WhatsApp Marketing & Chat", url: "https://apps.shopify.com/dondy-marketing-ai?utm_source=revenueHunt&utm_medium=partnership", logo: "/img/pages/partners/dondy-logo.webp", description: "הפכו תנועה אבודה להכנסות עם זרימות WhatsApp אוטומטיות לשחזור, אישור ושימור – בתוספת סוכן AI שמטפל בתמיכת הלקוחות, כך שהצוות שלכם לא צריך." },
      { name: "Customer Dashboard Pro", url: "https://apps.shopify.com/customer-dashboard-pro?utm_source=revenuehunt", logo: "/img/pages/partners/CustomerDashboard.webp", description: "Customer Dashboard Pro היא האפליקציה היחידה שמציעה תמיכה חלקה גם ב-Shopify New Customer Accounts וגם ב-Classic Customer Accounts." },
    ],
  },
  {
    heading: "העלאת מכירות והמלצות",
    emoji: "🎯",
    intro: "הגדילו את ערך ההזמנה הממוצע עם אפסל בעגלה, רשימות משאלות והזמנות מוקדמות.",
    items: [
      { name: "WC Wishlist Club", url: "https://apps.shopify.com/wishlist-club?utm_source=revenuehunt&utm_medium=website&utm_campaign=partnership", logo: "/img/pages/partners/wishlist-club-150-150-px-logo.webp", description: "WC Wishlist Club מאפשר ללקוחות שלכם לשמור את המוצרים האהובים עליהם, לשתף רשימות משאלות ולקנות מאוחר יותר - מה שמגביר מעורבות ומכירות. קל להגדרה, מותאם למובייל ומושלם להפיכת גולשים לרוכשים נאמנים." },
      { name: "iCart Cart Drawer Cart Upsell", url: "https://apps.shopify.com/icart/?campaign=promotion&medium=in-app-banner&source=revenuehunt", logo: "/img/pages/partners/iCart-Cart-Drawer-Cart-Upsell-logo.webp", description: "אפליקציית Shopify הכול-באחד להתאמה אישית של cart drawer ועמוד עגלה מלא עם upsell, המלצות מוצרים, סרגל התקדמות, bundle מוצרים והנחות." },
      { name: "PreOrder Now WOD", url: "https://apps.shopify.com/preorder-now?utm_source=+revenuehunt&utm_medium=web&utm_campaign=partner&utm_id=crosspromo", logo: "/img/pages/partners/PreOrder-Now-Logo.webp", description: "הפכו מצבי חוסר מלאי להזדמנויות הזמנה מוקדמת. מושלם לעסקי print-on-demand - לכדו את עניין הלקוח בלי מלאי התחלתי." },
    ],
  },
  {
    heading: "תמחור והנחות",
    emoji: "🏷️",
    intro: "חבילות, הנחות כמות ותמחור B2B שמתגמלים עגלות גדולות יותר.",
    items: [
      { name: "Kaching Bundle Quantity Deals", url: "https://apps.shopify.com/bundle-deals?utm_source=partnership&utm_medium=web&utm_campaign=REVENUEH", logo: "/img/pages/partners/Kaching-Logo-1024x1024.webp", description: "הגבירו מכירות עם Kaching Bundle Quantity Deals - צרו הצעות bundle ישירות בעמוד המוצר שלכם. השתמשו בקוד REVENUEH20 לקבלת הנחה בלעדית של 20%." },
      { name: "BSS: B2B/Wholesale Solution", url: "https://apps.shopify.com/b2b-solution-custom-pricing?utm_source=RevenueHunt&utm_medium=partner-listing&utm_campaign=partnership-2024", logo: "/img/pages/partners/BSS-Commerce_logo_150.webp", description: "פתרון סיטונאות הכול-באחד. חוויית קנייה B2B חלקה שגם עוזרת לסוחרים לנהל את הלקוחות הסיטונאיים שלהם ולקבל תובנות עליהם." },
    ],
  },
  {
    heading: "שיווק וחלונות קופצים",
    emoji: "📣",
    intro: "הוכחה חברתית, תוכניות שותפים וקמפיינים באתר שמניעים מכירות.",
    items: [
      { name: "ToastiBar – Sales Popup", url: "https://makeprosimp.com/partnership/revenuehunt", logo: "/img/pages/partners/toastibarlogo_fgaiv9.webp", description: "הגבירו את אמון הלקוחות והניעו מכירות על ידי הצגת הוכחה חברתית בזמן אמת: מכירות, עגלה, מבקרים, ביקורות מוצרים והתראות מלאי." },
      { name: "UpPromote: Affiliate & Referral", url: "https://partners.secomapp.com/apps/affiliate/SHOPQUIZ_APP", logo: "/img/pages/partners/NEW_logo-1.webp", description: "UpPromote היא אפליקציית האפיליאייט/הפניות המומלצת ביותר ב-Shopify App Store. פתרון הכול-באחד לבניית וניהול קמפיינים שיווקיים, מתאים לעסק בכל גודל." },
    ],
  },
  {
    heading: "משלוח ולוגיסטיקה",
    emoji: "📦",
    intro: "אספקה, לוגיסטיקה ותמריצי משלוח חינם כדי לשלוח מהר יותר ולהתרחב.",
    items: [
      { name: "Essential Free Shipping Bar", url: "https://apps.shopify.com/essential-order-value-booster", logo: "/img/pages/partners/freeshippingbarlogo.webp", description: "הגדילו מכירות ו-AOV על ידי הגדרת סרגלי משלוח חינם ללא הגבלה עם יעדי ערך עגלה מרובים כדי לעודד קונים להוסיף עוד מוצרים." },
      { name: "HyperSKU", url: "https://apps.shopify.com/hypersku", logo: "/img/pages/partners/150150-logo.webp", description: "HyperSKU מציעה פתרון שרשרת אספקה הכול-באחד. יותר מ-1M מוצרים, מכירת bundles, דגימה, בדיקת איכות, התאמה אישית של מותג ו-fulfillment אוטומטי של הזמנות." },
    ],
  },
  {
    heading: "אנליטיקה ודוחות",
    emoji: "📊",
    intro: "תובנות SEO ונתוני הזמנות כדי למדוד מה עובד ולדווח על כך.",
    items: [
      { name: "PDF Invoice Generator", url: "https://apps.shopify.com/fordeer-invoice-order-printer?utm_source=ShopQuizProductRecommender&utm_medium=comarketing&utm_campaign=partner", logo: "/img/pages/partners/fordeer-data-export-1024x1024.webp", description: "מחולל החשבוניות של Fordeer ל-Shopify גמיש, עומד בתקנים גלובליים ומתאים ל-B2C, B2B וסיטונאות. תבניות PDF ניתנות להתאמה אישית, הדפסה בכמות ותמיכת צ'אט חי 24/7." },
      { name: "AI SEO Optimizer", url: "https://share.seoant.com/app/1165b75b7ce1524D5J", logo: "/img/pages/partners/SEOAnt-_-AI-SEO-Optimizer_Channelwill-.webp", description: "אפליקציית ה-SEO הטובה ביותר ל-Shopify - מטבו מילות מפתח, שפרו מטא תגיות ושפרו את מבנה האתר. בדיקות ביצועי SEO ומהירות מבוססות AI." },
    ],
  },
  {
    heading: "עיצוב חנות ותבניות",
    emoji: "🎨",
    intro: "תבניות Shopify פרימיום שנבנו כדי להמיר ולגרום לחנות שלכם לזהור.",
    items: [
      { name: "eComX", url: "https://ecomx.co/", logo: "/img/pages/partners/ecomx-logo.webp", description: "eComX מפתחת תבניות Shopify פרימיום שנבנו כדי להמיר. בחרו מתוך יותר מ-16 עיצובים ייעודיים לנישה, ממוטבים על בסיס נתוני המרה אמיתיים ובנויים למהירות, כדי להפוך יותר מבקרים לקונים." },
    ],
  },
];

const perks = [
  { title: "עמלות הפניה", body: "הביאו לקוחות חדשים ל-RevenueHunt וקבלו עמלה לכל החיים של 20% מכל ההכנסות שהם מייצרים." },
  { title: "קישורי אפיליאייט", body: "הוסיפו את קישורי האפיליאייט שלכם במאמרים, בניוזלטרים ובפוסטים ברשתות החברתיות. קשרו ישירות לאפליקציות שלנו ל-Shopify, WooCommerce, BigCommerce, Magento ולאפליקציה העצמאית." },
  { title: "מנהל פרטנרים משלכם", body: "קבלו ייעוץ כיצד לבנות משפכי מכירה אוטומטיים עם הכלי שלנו וטיפים כיצד למכור את הפתרון שלנו ללקוחות שלכם." },
  { title: "תוכן בלעדי", body: "פנו אלינו לקבלת ייעוץ כיצד לבנות משפכי מכירה אוטומטיים ללקוחות שלכם באמצעות RevenueHunt וכלים נוספים." },
  { title: "מקום ב-Partner Directory שלנו", body: "המשתמשים שלנו ימצאו אתכם ב-Partner Directory שלנו ויפנו אליכם לקבלת השירותים שלכם." },
];

const faqs = [
  { q: "כמה עולה להפוך לפרטנר?", a: "ההרשמה לגמרי בחינם. אפס. כלום." },
  { q: "האם אני צריך להיות לקוח של RevenueHunt?", a: "לא, אתם לא צריכים להיות לקוחות של RevenueHunt כדי להפוך לפרטנרים." },
  { q: "איך אקבל תשלום?", a: "אנחנו משלמים את הרווחים מדי חודש. התשלומים נשלחים דרך PayPal." },
  { q: "איך אני יכול לעקוב אחר ההפניות שלי?", a: "אתם יכולים לראות את הסטטיסטיקות שלכם ב-<a href='https://admin.revenuehunt.com/' target='_blank' rel='external noopener' class='font-semibold text-[#16161D] underline'>Partner Dashboard</a> שלכם." },
];

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "דף הבית", url: "/" },
    { name: "פרטנרים ואפיליאייטים", url: "/partners/" },
  ]),
];
---

<Base
  title="תוכנית הפרטנרים - RevenueHunt"
  description="הפנו את הלקוחות שלכם. הרוויחו כסף. קבלו עמלה לכל החיים של 20% מהלקוחות שאתם מפנים ל-RevenueHunt. הירשמו לתוכנית הפרטנרים שלנו בחינם."
  jsonLd={jsonLd}
  lang="he"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20 text-center">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={localizedHref("/", "he")} class="hover:text-slate-700">דף הבית</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">פרטנרים ואפיליאייטים</span>
      </nav>
      <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">תוכנית הפרטנרים</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        הפנו את הלקוחות שלכם. הרוויחו כסף.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-xl text-slate-600">
        קבלו עמלה לכל החיים של 20% מהלקוחות שאתם מפנים אלינו. הירשמו היום בחינם לתוכנית הפרטנרים שלנו.
      </p>
      <p class="mx-auto mt-6 max-w-3xl text-slate-600">
        אם אתם <strong class="font-semibold text-slate-900">סוכנות שיווק דיגיטלי</strong> או
        <strong class="font-semibold text-slate-900">מומחה איקומרס</strong> ורוצים להצמיח את העסק שלכם,
        תוכנית הפרטנרים שלנו היא בשבילכם. צרו חוויות מעולות ללקוחות שלכם עם RevenueHunt.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
        >
          התחילו עכשיו
        </a>
        <a
          href="#partners"
          class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
        >
          ראו את הפרטנרים שלנו
        </a>
      </div>
    </div>
  </section>

  <!-- Who you are + perks -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-1">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">מי אתם</h2>
        <p class="mt-4 text-slate-600">
          אתם סוכנות שיווק דיגיטלי או יועץ איקומרס שנלהב מעיצוב ואובססיבי לגבי
          <strong class="font-semibold text-slate-900">השגת התוצאות הטובות ביותר</strong> ללקוחות שלכם. אתם מצמיחים
          את העסק שלכם על ידי העצמת עסקים אחרים.
        </p>
      </div>
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">מה אתם מקבלים מאיתנו</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {perks.map((p) => (
            <li class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="text-base font-semibold text-slate-900">{p.title}</h3>
              <p class="mt-2 text-sm text-slate-600">{p.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Partner directory -->
  <section id="partners" class="mx-auto max-w-7xl px-6 py-16 scroll-mt-24">
    <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">הפרטנרים שלנו</h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
      אפליקציות וסוכנויות מהימנות שמשתלבות בצורה מושלמת עם RevenueHunt עבור הלקוחות שלכם.
    </p>
    <div class="mt-12 space-y-16">
      {groups.map((g) => (
        <div>
          <div class="mb-2 flex items-baseline gap-3">
            <span class="text-2xl" aria-hidden="true">{g.emoji}</span>
            <h3 class="text-2xl font-semibold tracking-tight text-slate-900">{g.heading}</h3>
          </div>
          <p class="max-w-3xl text-slate-600">{g.intro}</p>
          <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {g.items.map((p) => (
        <li>
          <a
            href={p.url}
            target="_blank"
            rel="external noopener nofollow"
            class="group flex h-full flex-col items-center rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm transition hover:border-slate-300 hover:shadow-md"
          >
            <img
              src={p.logo}
              alt={`לוגו של ${p.name}`}
              loading="lazy"
              width="120"
              height="120"
              class="h-24 w-24 rounded-lg object-cover"
            />
            <h3 class="mt-5 text-lg font-semibold text-slate-900 group-hover:text-[#16161D]">{p.name}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{p.description}</p>
            <span class="mt-5 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wider text-slate-500 group-hover:text-[#16161D]">
              בקרו באתר <span aria-hidden="true">↗</span>
            </span>
          </a>
        </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">שאלות נפוצות</h2>
      <div class="mx-auto mt-8 max-w-2xl">
        {faqs.map((f) => (
          <details class="border-b border-slate-200">
            <summary class="py-4 text-base font-semibold text-slate-900">{f.q}</summary>
            <p class="pb-4 text-slate-600" set:html={f.a}></p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        הפכו לפרטנרים של RevenueHunt
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        הפנו את הלקוחות שלכם, בנו משפכי מכירה אוטומטיים וקבלו עמלה לכל החיים של 20% מכל מה שהם מוציאים.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          התחילו עכשיו
        </a>
        <a
          href={localizedHref("/demo/", "he")}
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          הזמינו דמו
        </a>
      </div>
    </div>
  </section>
</Base>
