---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb, article, faqPage } from "../../../lib/schema";
import { SITE } from "../../../lib/site";
import { localizedHref } from "../../../lib/i18n";
import {
  REPORT,
  DATASET,
  HEADLINE,
  VERTICAL_CONVERSION,
  AOV_UPLIFT,
  ATTRIBUTION,
  BASELINES,
} from "../../../lib/quiz-benchmarks";

const pageUrl = new URL(`/${REPORT.slug}/`, SITE.site_url).href;
const ogImage = `/og/${REPORT.slug}.png`;

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=state_of_product_quizzes";
// Free WordPress.org plugin (not the WooCommerce.com extension).
const WOO_PLUGIN =
  "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";

const formatN = (n: number | null) =>
  n === null ? "" : n.toLocaleString("en-US");

// Conversion expressed against a typical 2% store: 6.9% / 2% = 345%.
const boost = (rate: number) => Math.round((rate / HEADLINE.baselinePct) * 100);

// Translated methodology + FAQ (the shared data module stays English for the PDF
// and stat cards). Defined before jsonLd so faqPage(FAQ) uses the translated set.
const METHODOLOGY = [
  "מקור: הפלטפורמה של RevenueHunt עצמה, על פני כל פלטפורמת איקומרס שאנחנו תומכים בה. מצרפי ואנונימי: אף חנות בודדת אינה ניתנת לזיהוי, וחנויות הדמו שלנו מוחרגות בכל מקום.",
  "המרה היא שיעור לכל אדם שמבצע את החידון: הזמנות המיוחסות לתשובת חידון, חלקי חידונים שהושלמו. זה לא שיעור של כל האתר. מי שמבצע את החידון בוחרים בעצמם ומעורבים יותר מהמבקר הממוצע, ולכן זו אינה השוואה שווה-בשווה לשיעור ההמרה הכולל של חנות. אנחנו אומרים זאת בכל מקום שבו אנחנו עושים את ההשוואה.",
  "הקטגוריה נגזרת משם החידון שכתב הסוחר (למשל \"חידון טיפוח עור\", \"חידון אוכל לכלבים\"). בערך 78% מהתשובות מגיעות מחידונים גנריים או ללא שם ומוחרגות מכל נתון לפי קטגוריה.",
  "גידול ב-average order value נמדד בתוך החנות: ערך ההזמנה החציוני של אותה חנות בחידון מול ערך ההזמנה החציוני שלה ללא חידון. זה עמיד מול מטבע ומסיר את הטיית מיקס-החנות שמטשטשת את האפקט בממוצע נאיבי על פני כל הפלטפורמה.",
  "כל נתון המרה הוא רצפה. הייחוס עדיין מצטבר ככל שסוחרים מסנכרנים הזמנות (9% מההזמנות הראשונות מגיעות יותר מ-30 יום אחרי החידון), והזמנות חוצות-מכשירים או לא-מנוטרות לעולם אינן מתחברות. המספרים האמיתיים גבוהים יותר, לא נמוכים יותר.",
];

const FAQ = [
  {
    question: "איך נמדדת המרת החידון?",
    answer:
      "הזמנות המיוחסות לתשובת חידון, חלקי חידונים שהושלמו. על פני הפלטפורמה, 5.5% מהקונים שמסיימים חידון (בערך 1 מתוך 18) מבצעים הזמנה מנוטרת. זהו שיעור לכל אדם שמבצע את החידון, לא שיעור של כל האתר: מי שמבצע את החידון מעורבים יותר מהמבקר הממוצע, ולכן זה לא ישיר להשוואה לשיעור ההמרה הכולל של חנות.",
  },
  {
    question: "למה שיעור המרת החידון כל כך גבוה מהחנות הממוצעת?",
    answer:
      "שתי סיבות. ראשית, החידון עצמו: הוא מחליף קטלוג מוצף בשיחה קצרה ובהמלצה ברורה, מה שמסיר את חוסר ההחלטיות שמדליף מכירות. שנית, מה שקורה אחרי שהתשובות מגיעות: כל חידון לוכד zero-party data ומתייג את הקונה, מה שמפעיל זרימות מעקב מסוגמנטות וריטרגטינג. קמפיינים מסוגמנטים מייצרים יותר מפי 3 הכנסות לנמען מאשר שליחות גנריות (benchmark הסגמנטציה של Klaviyo), כך שחידון ממשיך להמיר דרך אימייל ומודעות מותאמים אישית, לא רק בעמוד התוצאות.",
    answerHtml:
      "שתי סיבות. ראשית, החידון עצמו: הוא מחליף קטלוג מוצף בשיחה קצרה ובהמלצה ברורה, מה שמסיר את חוסר ההחלטיות שמדליף מכירות. שנית, מה שקורה אחרי שהתשובות מגיעות: כל חידון לוכד zero-party data ומתייג את הקונה, מה שמפעיל זרימות מעקב מסוגמנטות וריטרגטינג. קמפיינים מסוגמנטים מייצרים יותר מפי 3 הכנסות לנמען מאשר שליחות גנריות (<a href=\"https://www.klaviyo.com/marketing-resources/segmentation-benchmark-report\" target=\"_blank\" rel=\"external noopener nofollow\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">benchmark הסגמנטציה של Klaviyo</a>), כך שחידון ממשיך להמיר דרך אימייל ומודעות מותאמים אישית, לא רק בעמוד התוצאות.",
  },
  {
    question: "האם הקונים שמבצעים את החידון באמת מוציאים יותר להזמנה?",
    answer:
      "בממוצע, כן, מדוד בצורה שקולה. בתוך אותה חנות, הזמנות שהגיעו דרך חידון גדולות בערך ב-11% עד 15% מהזמנות שלא, וזה נשמר בערך ב-7 מתוך 10 חנויות. זה לא אוניברסלי: הכי חזק ביופי וטיפוח עור (בערך +20%), שטוח יותר בקטגוריות כמו בושם וקפה.",
  },
  {
    question: "איך הנתונים האלה חלים על החנות שלי?",
    answer:
      "הכניסו את התנועה, ערך ההזמנה הממוצע ושיעור ההמרה הנוכחי שלכם למחשבון ה-ROI של החידון שלנו. הוא מריץ את אותם נתונים (שיעור 5.5% לכל מבצע חידון, ההמרה לפי קטגוריה, הגידול ב-AOV) מול המספרים שלכם כדי להעריך את ההכנסה הנוספת שחידון יכול להוסיף.",
    answerHtml:
      "הכניסו את התנועה, ערך ההזמנה הממוצע ושיעור ההמרה הנוכחי שלכם ל<a href=\"/he/quiz-roi-calculator/\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">מחשבון ה-ROI של החידון</a> שלנו. הוא מריץ את אותם נתונים (שיעור 5.5% לכל מבצע חידון, ההמרה לפי קטגוריה, הגידול ב-AOV) מול המספרים שלכם כדי להעריך את ההכנסה הנוספת שחידון יכול להוסיף.",
  },
  {
    question: "האם הנתונים אנונימיים?",
    answer:
      "כן. כל נתון הוא מצרפי ומאוחד על פני מיליוני תשובות ואלפי חנויות. אף חנות בודדת אינה ניתנת לזיהוי. הדוח קיים כדי לשתף מה שהנתונים אומרים, לא כדי לחשוף סוחר כלשהו.",
  },
  {
    question: "האם אני יכול להשתמש במספרים האלה?",
    answer:
      "כן. צטטו אותם עם קישור לעמוד הזה. הדוח חינמי וללא חסם, ה-PDF ניתן להורדה, והנתונים הבולטים זמינים ככרטיסים לשיתוף.",
  },
];

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "דף הבית", url: localizedHref("/", "he") },
    { name: "מצב חידוני המלצת המוצרים", url: localizedHref(`/${REPORT.slug}/`, "he") },
  ]),
  article({
    title: `${REPORT.title}: ${REPORT.subtitle}`,
    description: REPORT.description,
    url: pageUrl,
    image: ogImage,
    datePublished: REPORT.datePublished,
    dateModified: REPORT.dateModified,
    author: "RevenueHunt",
    tags: [
      "benchmark חידון המלצת מוצרים",
      "quiz conversion rate",
      "ecommerce personalization",
      "average order value",
    ],
  }),
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "RevenueHunt benchmarks חידון המלצת מוצרים 2026",
    description: REPORT.description,
    url: pageUrl,
    creator: organization(),
    license: "https://creativecommons.org/licenses/by/4.0/",
    isAccessibleForFree: true,
    datePublished: REPORT.datePublished,
    keywords: [
      "חידון המלצת מוצרים",
      "conversion rate",
      "average order value",
      "ecommerce",
      "Shopify",
    ],
    distribution: {
      "@type": "DataDownload",
      encodingFormat: "application/pdf",
      contentUrl: new URL(REPORT.pdfPath, SITE.site_url).href,
    },
  },
  faqPage(FAQ),
];

const publishedLabel = new Date(REPORT.datePublished).toLocaleDateString("he-IL", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

// Category/vertical labels and the two long table notes, translated. Numbers stay
// from the shared data module; only the human-readable labels/notes are localized.
const VERT_LABEL: Record<string, string> = {
  "Fragrance": "בושם",
  "Haircare": "טיפוח שיער",
  "Supplements & health": "תוספים ובריאות",
  "Beauty & skincare": "יופי וטיפוח עור",
  "Coffee & tea": "קפה ותה",
  "CBD": "CBD",
  "Other sectors": "מגזרים אחרים",
  "All quiz categories (pooled)": "כל קטגוריות החידון (מאוחד)",
};
const GROUPED_NOTE =
  "כל מה שמחוץ לקטגוריות הנקובות, כולל חידונים גנריים ובעלי שיקול גבוה יותר. נמדד בערך 3.6%, בערך 180% מחנות טיפוסית.";
const POOLED_NOTE =
  "הכותרת של הפלטפורמה: 5.5% (1 מתוך 18), בערך 275% מחנות טיפוסית של 2%. חידונים גנריים ללא שם (~78% מהתשובות) מוחרגים משורות הקטגוריות וגוררים את המספר הכולל למטה ל-~4%.";
const SCOPE: Record<string, string> = {
  "Statista": "גלובלי, 2025",
  "IRP Commerce": "נתוני סוחרים חיים בבריטניה/אירלנד, 2025",
  "Dynamic Yield": "400+ מותגים בינוניים-גדולים, 2025",
  "Shopify": "ההנחיות המפורסמות של Shopify עצמה",
};
const tr = <T extends { vertical: string }>(r: T) => ({ ...r, vertical: VERT_LABEL[r.vertical] ?? r.vertical });
const consumable = VERTICAL_CONVERSION.filter((r) => r.kind === "consumable").map(tr);
const considered = VERTICAL_CONVERSION.filter((r) => r.kind === "considered").map(tr);
const grouped = { ...tr(VERTICAL_CONVERSION.find((r) => r.kind === "grouped")!), note: GROUPED_NOTE };
const pooled = { ...tr(VERTICAL_CONVERSION.find((r) => r.kind === "total")!), note: POOLED_NOTE };
const aovRows = AOV_UPLIFT.perVertical.map(tr);
const baselines = BASELINES.map((b) => ({ ...b, scope: SCOPE[b.source] ?? b.scope }));
---

<Base
  title={`${REPORT.title}: ${REPORT.subtitle}`}
  description={REPORT.description}
  ogImage={ogImage}
  jsonLd={jsonLd}
  lang="he"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={localizedHref("/", "he")} class="hover:text-slate-700">דף הבית</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">מצב חידוני המלצת המוצרים</span>
      </nav>
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">
          דוח benchmark · {publishedLabel}
        </p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          מצב חידוני המלצת המוצרים
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          1 מתוך 18 קונים שמסיימים חידון המלצת מוצרים מבצע הזמנה, <strong>פי 2.75 מחנות אונליין טיפוסית</strong>. הדוח הזה מפרק אילו קטגוריות ממירות יותר, כמה יותר מוציאים הקונים שמבצעים את החידון ולכמה זמן חידון יחיד ממשיך להניב. מבוסס על נתונים אמיתיים של <strong>{DATASET.responses} תשובות חידון</strong> ב-{DATASET.brands} חנויות.
        </p>
        {/* TODO: restore hero CTAs ("Download the PDF" + "Read the findings")
            once a peer reviews the PDF design. Removed 2026-06-08 to hold the
            PDF download until that review. The PDF is still generated and the
            "Cite this report" section's download link is also held (see below). */}
      </div>
    </div>
  </section>

  <!-- Dataset band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-2xl bg-[#16161D] px-6 py-10 sm:px-10">
        <p class="text-center text-sm font-semibold uppercase tracking-wider text-white/50">
          מאגר הנתונים
        </p>
        <dl class="mt-6 grid grid-cols-1 gap-8 text-center sm:grid-cols-3">
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.responses}</dt>
            <dd class="mt-1 text-sm text-white/70">תשובות חידון שנותחו</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.revenue}</dt>
            <dd class="mt-1 text-sm text-white/70">בהכנסות שנוצרו לסוחרים</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.brands}</dt>
            <dd class="mt-1 text-sm text-white/70">חנויות איקומרס</dd>
          </div>
        </dl>
        <p class="mx-auto mt-6 max-w-3xl text-center text-sm text-white/60">
          מצרפי ואנונימי, לאורך Shopify, WooCommerce, BigCommerce, Magento ועצמאי. אף חנות בודדת אינה ניתנת לזיהוי. כל נתון למטה הוא מינימום: הייחוס עדיין מצטבר, כך שהמספרים האמיתיים גבוהים יותר.
        </p>
      </div>
    </div>
  </section>

  <!-- Key findings (stat cards) -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">הנתונים הבולטים</h2>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">{HEADLINE.completedConv}%</p>
          <p class="mt-2 font-medium text-slate-900">מהקונים שמסיימים חידון מבצעים הזמנה</p>
          <p class="mt-2 text-sm text-slate-600">בערך 1 מתוך {HEADLINE.completedOneIn}, בערך פי {HEADLINE.multiple} מחנות טיפוסית של {HEADLINE.baselinePct}%.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">+{AOV_UPLIFT.headlineLow}-{AOV_UPLIFT.headlineHigh}%</p>
          <p class="mt-2 font-medium text-slate-900">יותר ב-average order value, בתוך אותה חנות</p>
          <p class="mt-2 text-sm text-slate-600">מדוד בצורה שקולה, קיים בערך ב-7 מתוך 10 חנויות.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">{HEADLINE.completionRate}%</p>
          <p class="mt-2 font-medium text-slate-900">מהקונים שמתחילים חידון מסיימים אותו</p>
          <p class="mt-2 text-sm text-slate-600">בערך 7 מתוך 10 מגיעים לעמוד התוצאות. {HEADLINE.abandonRate}% נוטשים קודם.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">1 מתוך 5</p>
          <p class="mt-2 font-medium text-slate-900">הזמנות המיוחסות לחידון מגיעות יותר מ-30 יום לאחר מכן</p>
          <p class="mt-2 text-sm text-slate-600">החידון ממשיך לייצר הכנסות במשך חודשים לאחר ביצועו.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Conversion by category -->
  <section id="conversion" class="scroll-mt-20 bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">המרה לפי קטגוריה</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        הממוצע של הפלטפורמה מסתיר פיזור רחב. <strong>קטגוריות מתכלות וניתנות למילוי מחדש ממירות פי שניים עד שלוש יותר</strong> מהחנות הממוצעת אונליין. רכישות יקרות ובעלות שיקול גבוה ממירות בסדר גודל נמוך יותר: שם החידון מניע גילוי, אבל המכירה מגיעה מאוחר יותר, מחוץ לסשן.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">קטגוריה</th>
              <th class="py-3 pr-4 text-right font-semibold">המרה</th>
              <th class="py-3 pr-4 text-right font-semibold">גידול בהמרת החידון</th>
              <th class="py-3 text-right font-semibold">תשובות</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {consumable.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{r.rate}%</td>
                <td class="py-3 pr-4 text-right tabular-nums text-slate-600">{boost(r.rate)}%</td>
                <td class="py-3 text-right tabular-nums text-slate-500">{formatN(r.n)}</td>
              </tr>
            ))}
            {considered.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{r.rate}%</td>
                <td class="py-3 pr-4 text-right tabular-nums text-slate-600">{boost(r.rate)}%</td>
                <td class="py-3 text-right tabular-nums text-slate-500">{formatN(r.n)}</td>
              </tr>
            ))}
            <tr class="border-b border-slate-200">
              <td class="py-3 pr-4 font-medium">{grouped.vertical}</td>
              <td class="py-3 pr-4 text-right font-semibold tabular-nums">~{grouped.rate}%</td>
              <td class="py-3 pr-4 text-right tabular-nums text-slate-600">~{boost(grouped.rate)}%</td>
              <td class="py-3 text-right tabular-nums text-slate-500">{formatN(grouped.n)}</td>
            </tr>
            <tr class="border-t-2 border-slate-300">
              <td class="py-3 pr-4 font-semibold">{pooled.vertical}</td>
              <td class="py-3 pr-4 text-right font-bold tabular-nums">{pooled.rate}%</td>
              <td class="py-3 pr-4 text-right font-bold tabular-nums text-slate-600">{boost(pooled.rate)}%</td>
              <td class="py-3 text-right tabular-nums text-slate-500">הכול</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        {grouped.note}
      </p>
      <p class="mx-auto mt-2 max-w-3xl text-sm text-slate-500 text-center">
        {pooled.note}
      </p>
    </div>
  </section>

  <!-- AOV uplift -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">האם הקונים שמבצעים את החידון מוציאים יותר?</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        <strong>מדוד בתוך אותה חנות</strong>, הזמנות החידון <strong>גדולות ב-{AOV_UPLIFT.headlineLow}% עד {AOV_UPLIFT.headlineHigh}%</strong> מהזמנות ללא חידון, וזה נשמר ב-{AOV_UPLIFT.storesUpLow}% עד {AOV_UPLIFT.storesUpHigh}% מהחנויות. זה לא אוניברסלי: חזק יותר היכן שהחידון יכול להרכיב סט או שגרה, כמעט שטוח היכן שהרכישה היא פריט בודד.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">קטגוריה</th>
              <th class="py-3 pr-4 text-right font-semibold">גידול ב-AOV בתוך החנות</th>
              <th class="py-3 text-right font-semibold">חנויות עם גידול</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {aovRows.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">
                  {r.uplift === null ? "שטוח" : `+${r.uplift}%`}
                </td>
                <td class="py-3 text-right tabular-nums text-slate-500">
                  {r.storesUp === null ? "לא זמין" : `${r.storesUp}%`}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        מדוד בתוך החנות (אותה חנות, הזמנות חידון מול הזמנות ללא חידון), ולכן הוא עמיד מול מטבע ושולט במיקס של החנות. משולש בין שלוש דגימות עצמאיות עם חציון של +11%, +15% ו-+14%. קטגוריות עם דגימות קטנות מושמטות במקום להיות מוגזמות.
      </p>
    </div>
  </section>

  <!-- Attribution / LTV -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">חידון ממשיך להניב אחרי הסשן</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        רוב דשבורדי הייחוס שופטים חידון לפי הזמנות באותו יום ונעצרים שם. זה מפספס את רוב הערך. <strong>{ATTRIBUTION.sameDay}% מההזמנות הראשונות המיוחסות לחידון מתרחשות באותו יום</strong>, אבל הזנב ארוך.
      </p>
      <div class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-4">
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.sameDay}%</p>
          <p class="mt-1 text-sm text-slate-600">באותו יום</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.within7}%</p>
          <p class="mt-1 text-sm text-slate-600">תוך 7 ימים</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.within30}%</p>
          <p class="mt-1 text-sm text-slate-600">תוך 30 ימים</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">1 מתוך 5</p>
          <p class="mt-1 text-sm text-slate-600">מגיעות יותר מ-30 יום לאחר מכן</p>
        </div>
      </div>
      <p class="mx-auto mt-6 max-w-3xl text-slate-700 text-center">
        בערך <strong>1 מתוך 5 מכל ההזמנות המיוחסות לחידון מגיעה יותר מ-30 יום לאחר החידון</strong>. החידון הוא לא רק דחיפה ל-checkout: כל תשובה היא zero-party data שמתייגת את הקונה ומזינה זרימות מעקב מסוגמנטות וריטרגטינג. <a href="https://www.klaviyo.com/marketing-resources/segmentation-benchmark-report" target="_blank" rel="external noopener nofollow" class="font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]">קמפיינים מסוגמנטים מייצרים יותר מפי 3 הכנסות לנמען</a> מאשר שליחות גנריות, כך שחידון יחיד ממשיך להמיר דרך אימייל ומודעות מותאמות אישית במשך חודשים.
      </p>
    </div>
  </section>

  <!-- Baseline context -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">מה נחשב "החנות הממוצעת"</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        אין מספר אמיתי יחיד להמרה באיקומרס: הוא משתנה עם המתודולוגיה והדגימה. הטווח ההוגן הוא בערך 1.6% עד 2.9%. אנחנו עושים benchmark מול <strong>{HEADLINE.baselinePct}%</strong> עגול, הקצה הנמוך השמרני, מה שממקם את מי שמבצע את החידון בערך פי <strong>{HEADLINE.multiple}</strong> מהחנות הממוצעת.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">מקור</th>
              <th class="py-3 pr-4 text-right font-semibold">המרה ממוצעת</th>
              <th class="py-3 font-semibold">היקף</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {baselines.map((b) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">
                  <a href={b.href} target="_blank" rel="external noopener nofollow" class="text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-slate-500">{b.source}</a>
                </td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{b.rate}</td>
                <td class="py-3 text-sm text-slate-600">{b.scope}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        חשוב: ה-5.5% שלנו הוא שיעור לכל אדם שמבצע את החידון (הזמנות לכל חידון שהושלם), בעוד שכל נתון למעלה הוא שיעור של כל האתר (הזמנות לכל מבקר). מי שמבצע את החידון בוחר בעצמו, ולכן חלק מההפרש הוא המשפך, לא רק החידון. אנחנו מציגים את ההשוואה בצורה ישירה במקום לקשט אותה.
      </p>
    </div>
  </section>

  <!-- Methodology -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">מתודולוגיה</h2>
      <ul class="mt-8 space-y-5" role="list">
        {METHODOLOGY.map((m) => (
          <li class="flex gap-3">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400" aria-hidden="true"></span>
            <p class="text-slate-700">{m}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">שאלות נפוצות</h2>
      <div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
        {FAQ.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-lg font-semibold text-slate-900 [&::-webkit-details-marker]:hidden">
              <span>{f.question}</span>
              <svg
                class="h-5 w-5 flex-shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <p class="pb-5 text-slate-700" set:html={f.answerHtml ?? f.answer} />
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* TODO: restore the entire "Cite this report" section (PDF download +
      shareable stat-card links) once a designer reviews the report + PDF + card
      designs. Removed 2026-06-08 to hold the downloadable assets until review.
      The PDF and card PNGs are still generated by `bun run report`. */}

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        מדדו את הגידול בחנות שלכם.
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-white/70">
        RevenueHunt חינמית להתחלה, עם 100 תשובות חידון בחודש. צרו חידון, שלחו דרכו תנועה וקראו את המספרים שלכם.
      </p>
      <p class="mx-auto mt-4 max-w-2xl text-white/60">
        ראו מה ה-benchmarks האלה יכולים להוסיף לחנות שלכם עם <a href={localizedHref("/quiz-roi-calculator/", "he")} class="font-medium text-white underline decoration-white/40 underline-offset-2 hover:decoration-white">מחשבון ה-ROI של החידון</a> שלנו.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SHOPIFY_INSTALL}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          התחילו בחינם ב-Shopify
        </a>
        <a
          href={WOO_PLUGIN}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          התחילו בחינם ב-WooCommerce
        </a>
      </div>
    </div>
  </section>
</Base>
