---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb, article, faqPage } from "../../../lib/schema";
import { SITE } from "../../../lib/site";
import { localizedHref } from "../../../lib/i18n";
import {
  REPORT,
  SOURCE,
  HEADLINE,
  GROWTH,
  REVIEWS,
  REVENUE,
  PRICING,
  GEOGRAPHY,
  NICHES,
  QUIZ_LANE,
} from "../../../lib/app-economy";

const pageUrl = new URL(`/he/${REPORT.slug}/`, SITE.site_url).href;
const ogImage = `/og/${REPORT.slug}.png`;

const publishedLabel = new Date(REPORT.datePublished).toLocaleDateString("he-IL", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const title = "מצב כלכלת האפליקציות של Shopify";
const description =
  "יש 22,546 אפליקציות פעילות ב-Shopify App Store וכמעט אף אחת מהן לא מגיעה לשום מקום. דוח נתונים על צמיחה, ביקורות, ריכוז הכנסות, תמחור ומי בונה אותן, מתוך תמונת מצב של כל אפליקציה פעילה.";

// Methodology + FAQ, translated. The lead clause of each methodology note is
// bolded inline (the English source bolded it via string replace, which cannot
// match translated text). Defined before jsonLd so faqPage(FAQ) can use it.
const METHODOLOGY = [
  "<strong>מקור:</strong> תמונת מצב של ה-Shopify App Store הציבורי, 22,546 אפליקציות פעילות, שצולמה ביוני 2026. כל שדה מגיע מהדף הציבורי, לא מהנתונים הפנימיים של Shopify או מחשבון של סוחר כלשהו.",
  "<strong>ההכנסות מוערכות, לא נמדדות.</strong> הן ממודלות מתוך מדרגות התמחור המפורסמות של כל אפליקציה יחד עם אותות ביקורות והתקנות. התייחסו למספרי ההכנסות כמודל כיווני של עד כמה הרווחים מרוכזים, לא כנתוני חיוב. הם מסומנים כ\"מוערכים\" בכל מקום שבו הם מופיעים.",
  "<strong>הצמיחה מבוססת על תאריך ההשקה המפורסם של כל אפליקציה.</strong> המקור ריכז בערך 2,800 תאריכי השקה במאי 2026, ולכן העקומה נקראת כאפליקציות פעילות מצטברות לפי שנה (נקודת הסיום היא הסך הנוכחי האמיתי), והנתון של \"6,000+ ב-12 החודשים האחרונים\" מנקה את העיוות של אותו חודש בודד.",
  "<strong>ביקורות הן פרוקסי לאחיזה בשוק</strong>, לא מושלם: אפליקציה מצוינת יכולה להיות חדשה, ומספרי הביקורות מפגרים אחרי השימוש האמיתי. אנחנו משתמשים בהן כי הן האות הציבורי וההשוואתי הברור ביותר לבסיס סוחרים אמיתי על פני 22,546 אפליקציות.",
  "קטגוריות ב-App Store הן תגיות תכונה שאפליקציה יכולה להוסיף לעצמה, ולאפליקציות רבות יש כמה או אף אחת. עבור תצוגת המגזרים אנו מקבצים תגיות קרובות למסלולים רחבים ומסירים כפילויות אפליקציות בתוך כל אחד; אפליקציה יכולה להשתייך ליותר מאחד, כך שהמגזרים חופפים ואינם בלעדיים, ואנו קוראים אותם כמכווני כיוון. בכל מקום אחר אנו נשענים על החתכים החד-משמעיים (ביקורות, מחירים, תאריך השקה, מדינת המפתח).",
];

const FAQ = [
  {
    question: "כמה אפליקציות יש ב-Shopify App Store?",
    answer:
      "22,546 אפליקציות פעילות בתמונת המצב הזו מיוני 2026. ה-store גדל פי 10 בערך מאז 2020 והוסיף יותר מ-6,000 אפליקציות רק ב-12 החודשים האחרונים, בערך 1 מתוך 4 מכל מה שפעיל היום. פיתוח בסיוע AI הפך את מה שפעם היה בנייה של חצי שנה לסוף שבוע.",
  },
  {
    question: "למה רוב אפליקציות Shopify נכשלות?",
    answer:
      "הבנייה כבר אינה המגבלה, ולכן ה-store מוצף באפליקציות שמעולם לא מוצאות בסיס סוחרים. ל-51% אין אף ביקורת ול-81% יש פחות מ-10. הדבר הנדיר הוא הפצה ואמון: מענה לתמיכה, צבירת ביקורות סוחר אחר סוחר, נוכחות לאורך שנים. זה החלק ש-AI לא יכול לעשות בשבילכם.",
  },
  {
    question: "כמה מרוויחות אפליקציות Shopify?",
    answer:
      "הרווחים מרוכזים מאוד. לפי ההערכה שלנו, 1% העליון של האפליקציות (225 מהן) לוקח בערך 72% מכל הכנסות האפליקציות, ועשר המובילות לבדן לוקחות כמעט 30%. רק בערך 36% מהאפליקציות נראות כאילו הן מרוויחות משהו בכלל. ההכנסות כאן מוערכות מתוך תמחור ציבורי ואותות שימוש, לא מנתוני חיוב.",
  },
  {
    question: "האם רוב אפליקציות Shopify בחינם?",
    answer:
      "למעשה, כן. 46.9% בחינם ועוד 48.6% מתחילות בניסיון חינם; רק 4.5% גובות כסף מראש. 57% מהאפליקציות בתשלום מציעות תוכנית חינם. ב-Shopify App Store נקודת כניסה חינמית אינה טקטיקת צמיחה, היא ציפיית הבסיס.",
  },
  {
    question: "איפה אפשר לראות את הנתונים הגולמיים?",
    answer:
      "הנתונים מגיעים מתמונת מצב שאנחנו שומרים של כל אפליקציית Shopify פעילה: תאריכי השקה, ביקורות, תמחור, תג Built for Shopify ומדינת המפתח. אם אתם בונים על Shopify ורוצים את הדוח המלא, צרו קשר.",
    answerHtml:
      "הנתונים מגיעים מתמונת מצב שאנחנו שומרים של כל אפליקציית Shopify פעילה: תאריכי השקה, ביקורות, תמחור, תג Built for Shopify ומדינת המפתח. אם אתם בונים על Shopify ורוצים את הדוח המלא, <a href=\"/he/contact/\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">צרו קשר</a>.",
  },
];

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "דף הבית", url: localizedHref("/", "he") },
    { name: title, url: localizedHref(`/${REPORT.slug}/`, "he") },
  ]),
  article({
    title,
    description,
    url: pageUrl,
    image: ogImage,
    datePublished: REPORT.datePublished,
    dateModified: REPORT.dateModified,
    author: "RevenueHunt",
    tags: [
      "Shopify app store",
      "מפתחי אפליקציות של Shopify",
      "סטטיסטיקות של ה-app store",
      "כלכלת אפליקציות",
    ],
  }),
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "מצב כלכלת האפליקציות של Shopify 2026",
    description,
    url: pageUrl,
    creator: organization(),
    license: "https://creativecommons.org/licenses/by/4.0/",
    isAccessibleForFree: true,
    datePublished: REPORT.datePublished,
    keywords: [
      "Shopify app store",
      "מפתחי אפליקציות",
      "הכנסות אפליקציות",
      "ביקורות אפליקציות",
      "ecommerce",
    ],
  },
  faqPage(FAQ),
];

// Section eyebrows for the editorial "field notes" feel.
const E = (n: string, label: string) => `${n} · ${label}`;

// Translated headline cards. Stats stay from the shared data module (HEADLINE[i].stat).
const headlineT = [
  { label: "אפליקציות פעילות ב-store", note: "פי 10 בערך מאז 2020." },
  { label: "בלי אף ביקורת", note: "ארבע מתוך חמש עם פחות מ-10." },
  { label: "מההכנסות הולכות ל-1% העליון", note: "225 אפליקציות. הערכה." },
  { label: "גובות מראש", note: "רק 1 מתוך 20. כמעט חצי בחינם." },
];

// Growth caption with the lead phrase bolded.
const growthCaptionHtml =
  "אפליקציות פעילות מצטברות לפי שנת השקה. <strong>ה-Shopify App Store גדל פי 10 בערך מאז 2020</strong> והוסיף יותר מ-6,000 אפליקציות רק ב-12 החודשים האחרונים, בערך 1 מתוך 4 מכל מה שפעיל היום.";

// Quiz-lane paragraphs (translated), with the live search link and the load-bearing
// lines bolded inline. Caption text mirrors the English source's meaning.
const quizParas = [
  `הקטגוריה שלנו עצמה מוכיחה את אותו הדבר. <a href="${QUIZ_LANE.searchUrl}" target="_blank" rel="external noopener nofollow" class="font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]">חיפוש "חידונים" ב-Shopify</a> מחזיר 149 אפליקציות, אבל גם כאן האמון מצטבר בפסגה בדיוק כמו בכל ה-store. שלוש האפליקציות שהגיעו ראשונות ומעולם לא עזבו, RevenueHunt, Octane AI ו-Quiz Kit, מרכזות 45% מכל הביקורות בקטגוריה; <strong>ל-RevenueHunt לבדה יש בערך רבע</strong>, ולמחצית התחתונה אין אף אחת.`,
  `לא הגענו לפסגה בזכות הקוד. <strong>הביקורות הן הסימפטום של העמל התפעולי</strong> שמאחוריהן: שש שנים של מענה לתמיכה, של שיחות טלפון עם חנויות שלעולם לא ישלמו ושל בניית אמון חנות אחר חנות. Octane AI ו-Quiz Kit עשו את אותה עבודה קשה במשך שנים, <strong>ואנחנו מכבדים אותם על כך</strong>. ציון לשבח ל-Lantern ול-Quizell, שתיהן עם קצת יותר מ-120 ביקורות.`,
];

// Methodology bullets carry their own inline <strong>; render as-is.
const methodologyHtml = METHODOLOGY;
---

<Base
  title={`${title} - דוח נתונים 2026`}
  description={description}
  ogImage={ogImage}
  jsonLd={jsonLd}
  lang="he"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={localizedHref("/", "he")} class="hover:text-slate-700">דף הבית</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">מצב כלכלת האפליקציות של Shopify</span>
      </nav>
      <div class="text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">
          הערות שטח · {publishedLabel}
        </p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          מצב כלכלת האפליקציות של Shopify
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          <strong>יש 22,546 אפליקציות פעילות ב-Shopify App Store, וכמעט אף אחת מהן לא מגיעה לשום מקום.</strong> לקחנו תמונת מצב של כל אפליקציה פעילה וקראנו את הנתונים על צמיחה, ביקורות, הכנסות, תמחור ומי בונה אותן. הם מספרים סיפור אחד: בניית האפליקציה מעולם לא הייתה החלק הקשה.
        </p>
      </div>
    </div>
  </section>

  <!-- Source band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-2xl bg-[#16161D] px-6 py-10 sm:px-10">
        <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#4dcaff]">
          תמונת המצב
        </p>
        <dl class="mt-6 grid grid-cols-2 gap-8 text-center sm:grid-cols-4">
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.apps}</dt>
            <dd class="mt-1 text-sm text-white/70">אפליקציות פעילות בתמונת המצב</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.countries}</dt>
            <dd class="mt-1 text-sm text-white/70">מדינות שבונות אותן</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.reviewless}</dt>
            <dd class="mt-1 text-sm text-white/70">בלי אף ביקורת</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.free}</dt>
            <dd class="mt-1 text-sm text-white/70">לגמרי בחינם, בלי תוכנית בתשלום</dd>
          </div>
        </dl>
        <p class="mx-auto mt-6 max-w-3xl text-center text-sm text-white/60">
          כל מספר למטה מגיע מהדף הציבורי ב-App Store של כל 22,546 האפליקציות הפעילות, יוני 2026. ההכנסות מוערכות לפי התמחור המפורסם וסיגנלים של שימוש, לא לפי נתוני חיוב, ומסומנות ככאלה לאורך כל הדוח.
        </p>
      </div>
    </div>
  </section>

  <!-- Headline cards -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">המספרים הבולטים</h2>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        {HEADLINE.map((c, i) => (
          <div class="rounded-xl border border-slate-200 p-7">
            <p class="text-4xl font-bold tracking-tight text-[#16161D]">{c.stat}</p>
            <p class="mt-2 font-medium text-slate-900">{headlineT[i].label}</p>
            <p class="mt-2 text-sm text-slate-600">{headlineT[i].note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 01 Growth -->
  <section class="scroll-mt-20 bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("01", "צמיחה")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">פי 10 מאז 2020</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center" set:html={growthCaptionHtml} />
      <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
        <div class="h-72 sm:h-80"><canvas id="c-growth" aria-label="אפליקציות Shopify פעילות מצטברות לפי שנה" role="img"></canvas></div>
      </div>
    </div>
  </section>

  <!-- 02 Traction -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("02", "אחיזה")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">רוב האפליקציות לעולם לא מקבלות ביקורת</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">מחצית מה-Shopify App Store מעולם לא זכתה באף ביקורת אחת. ארבע מתוך חמש אפליקציות עם פחות מ-10. ביקורת היא הסימן הציבורי הברור ביותר לחנות אמיתית ושנשמרת, ורוב האפליקציות לעולם לא מקבלות אף אחת.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-center text-sm font-semibold text-slate-900">אפליקציות לפי מספר ביקורות</p>
          <div class="h-72 sm:h-80"><canvas id="c-reviews" aria-label="התפלגות הביקורות בכל האפליקציות הפעילות" role="img"></canvas></div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">81%</p>
            <p class="mt-1 text-slate-700">עם פחות מ-10 ביקורות</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="font-bold text-[#16161D]"><span class="text-3xl">{REVIEWS.medianReviews}</span> <span class="text-sm font-medium text-slate-500">ביקורות</span></p>
            <p class="mt-1 text-slate-700">החציון, בקרב האפליקציות שיש להן לפחות אחת</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="font-bold text-[#16161D]"><span class="text-amber-400">★</span> <span class="text-3xl">{REVIEWS.avgRating}</span> <span class="text-sm font-medium text-slate-500">כוכבים</span></p>
            <p class="mt-1 text-slate-700">דירוג ממוצע, בקרב {REVIEWS.ratedCount} האפליקציות שיש להן אחד</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 Revenue -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("03", "הכנסות · הערכה")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">הכסף מתרכז בפסגה</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">ההכנסות החודשיות המוערכות מרוכזות באכזריות בפסגה. 1% העליון של האפליקציות (225 מהן) לוקח 72% מוערכים, ורק 10 מהאפליקציות האלה לוקחות לבדן כ-30% מכלל הכנסות האפליקציות. רק בערך 36% מהאפליקציות בכלל נראות מרוויחות משהו. וזה מתרכז גם גאוגרפית: <strong>ארצות הברית וקנדה לבדן לוקחות כ-57% מוערכים</strong> מהכנסות חנות האפליקציות של Shopify.</p>
      <p class="mx-auto mt-3 max-w-3xl text-sm italic text-slate-500 text-center">שם אחד מתנשא מעל כל המערכת: אפליקציה שמושכת כ-78% מההכנסות השנתיות שלה, שעומדות על כמיליארד דולר, מסוחרים של Shopify. כן, אנחנו מסתכלים עליך, <a href='https://www.sec.gov/Archives/edgar/data/1835830/000162828023030618/klaviyoincs-1.htm' target='_blank' rel='external noopener nofollow' class='font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]'>Klaviyo</a>.</p>
