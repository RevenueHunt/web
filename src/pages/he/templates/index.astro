---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb, softwareApplication } from "../../../lib/schema";
import { SITE } from "../../../lib/site";
import { SOLUTIONS, FEATURED_SOLUTIONS } from "../../../lib/solutions";
import { localizedHref } from "../../../lib/i18n";

const lang = "he";
const lp = (path: string) => localizedHref(path, lang);

const featuredSolutions = FEATURED_SOLUTIONS.map((slug) => SOLUTIONS[slug]!);

interface Template {
  title: string;
  description: string;
  image: string;
  demo: string;
}

interface TemplateGroup {
  id: string;
  label: string;
  items: Template[];
}

const groups: TemplateGroup[] = [
  {
    id: "skincare",
    label: "טיפוח עור, טיפוח שיער וקוסמטיקה",
    items: [
      { title: "חידון סוג עור + שגרת טיפוח", description: "זהו את סוג העור והמליצו על שגרת טיפוח מלאה.", image: "/img/pages/templates/skinquiz1.webp", demo: "https://productrecommendationquiz.com/pages/skin-analysis" },
      { title: "מצאו את מייקאפ הבסיס שלכם", description: "בחירת מייקאפ הבסיס הנכון לא צריכה להיות עניין של ניחוש.", image: "/img/pages/templates/foundation5.webp", demo: "https://productrecommendationquiz.com/pages/foundation-match" },
      { title: "מאתר גוון שפתון", description: "התאימו לכל לקוחה את גוון השפתון המושלם לפי גוון העור והסגנון שלה.", image: "/img/pages/templates/lips1-e1768405685573.webp", demo: "https://productrecommendationquiz.com/pages/lipstick-shade-finder" },
      { title: "חידון טיפוח שיער", description: "המליצו על שמפו, מרכך וטיפולים לפי מטרות השיער של כל אחד.", image: "/img/pages/templates/hairquiz4.webp", demo: "https://productrecommendationquiz.com/pages/haircare-quiz" },
    ],
  },
  {
    id: "food",
    label: "תזונה ובריאות",
    items: [
      { title: "חידון קפה", description: "הובילו את הלקוחות שלכם לתערובת הקפה האידיאלית לפי הטעם וסגנון החיים שלהם.", image: "/img/pages/templates/coffee2.webp", demo: "https://productrecommendationquiz.com/pages/coffee-quiz" },
      { title: "חידון תוספים", description: "המליצו על ויטמינים ותוספים שמתאימים למטרות הבריאות שלהם.", image: "/img/pages/templates/supplements3.webp", demo: "https://productrecommendationquiz.com/pages/supplements-quiz" },
      { title: "מאתר מוצרי CBD", description: "הציעו את מוצרי ה-CBD הנכונים להרפיה, שינה או ריכוז.", image: "/img/pages/templates/cbd1.webp", demo: "https://productrecommendationquiz.com/pages/cbd-product-finder" },
      { title: "חידון מזון לכלבים", description: "מצאו את הארוחה המושלמת לכלב שלכם לפי הצרכים וההעדפות הספציפיות שלו.", image: "/img/pages/templates/dogquiz3.webp", demo: "https://productrecommendationquiz.com/pages/dog-food" },
    ],
  },
  {
    id: "clothes",
    label: "ספורט, ביגוד ואופנה",
    items: [
      { title: "חידון תכשיטים", description: "עזרו לקונים שלכם למצוא את התכשיט המושלם שמתאים לסגנון שלהם.", image: "/img/pages/templates/jewellery1-e1768405517428.webp", demo: "https://productrecommendationquiz.com/pages/jewellery-quiz" },
      { title: "חידון סגנון לבוש", description: "גלו את אישיות האופנה שלכם וקבלו המלצות מותאמות אישית.", image: "/img/pages/templates/style1.webp", demo: "https://productrecommendationquiz.com/pages/clothing-style-quiz" },
      { title: "חידון אופניים", description: "התאימו לכל לקוח את האופניים הנכונים לפי סגנון הרכיבה והצרכים שלו.", image: "/img/pages/templates/bike2.webp", demo: "https://productrecommendationquiz.com/pages/bicycle-quiz" },
    ],
  },
];

const gallery = [
  "Screenshot-2020-09-29-at-20.20.43.webp",
  "Screenshot-2020-09-29-at-20.33.39.webp",
  "Screenshot-2020-09-29-at-20.34.03.webp",
  "Screenshot-2020-09-29-at-20.34.16.webp",
  "Screenshot-2020-10-20-at-11.31.49.webp",
  "Screenshot-2020-10-20-at-11.32.06.webp",
  "Screenshot-2020-10-20-at-11.33.20.webp",
  "Screenshot-2020-10-20-at-11.33.57.webp",
  "Screenshot-2020-10-20-at-11.39.39.webp",
  "Screenshot-2020-10-20-at-11.41.15.webp",
  "Screenshot-2020-10-20-at-11.41.36.webp",
  "Screenshot-2020-10-20-at-11.41.51.webp",
  "Screenshot-2020-10-20-at-11.44.30.webp",
  "Screenshot-2020-10-20-at-11.45.11.webp",
  "Screenshot-2020-10-20-at-11.45.42.webp",
  "Screenshot-2020-11-16-at-14.34.09.webp",
  "Screenshot-2020-11-16-at-14.34.22.webp",
  "Screenshot-2020-11-16-at-14.34.34.webp",
  "Screenshot-2020-11-16-at-14.36.54.webp",
  "Screenshot-2020-12-04-at-08.38.54.webp",
  "Screenshot-2020-12-04-at-08.39.14.webp",
  "Screenshot-2020-12-04-at-08.39.25.webp",
  "Screenshot-2020-12-04-at-08.39.35.webp",
  "Screenshot-2021-04-14-at-04.13.10.webp",
  "Screenshot-2021-04-14-at-04.13.50.webp",
  "Screenshot-2021-04-14-at-04.14.16.webp",
  "Screenshot-2021-05-13-at-22.49.10.webp",
];

const reasons = [
  { emoji: "🚀", title: "הגדרה מהירה ל-Shopify ו-WooCommerce", body: "התבניות משתלבות בצורה חלקה עם Shopify, WooCommerce, BigCommerce ואתרים עצמאיים. בלי קוד - התקינו את האפליקציה, בחרו תבנית והתאימו אותה למותג שלכם." },
  { emoji: "💡", title: "לוגיקת חידון ושאלות מובנות מראש", body: "כל תבנית מגיעה עם שאלות שנכתבו על ידי מומחים, לוגיקה מותנית ואלגוריתמי המלצת מוצרים. בנויות על מסגרות מוכחות שמניעות המרות בתחומי יופי, רווחה, טיפוח חיות מחמד ולייפסטייל." },
  { emoji: "📊", title: "הגבירו המרות ו-AOV", body: "המלצות מותאמות אישית הופכות גולשים לרוכשים. התבניות מכוונות לשיעורי המרה גבוהים יותר, סלים גדולים יותר ולידים מוכשרים יותר." },
  { emoji: "🎨", title: "HTML ניתן להתאמה אישית מלאה", body: "ערכו טקסט, עיצוב, מיתוג ולוגיקה בלי לגעת בקוד. לבנייה מתקדמת, כל תבנית נגישה גם במלואה דרך HTML, CSS ו-JS מותאמים אישית." },
  { emoji: "📧", title: "אספו zero-party data", body: "לכדו העדפות, כוונה ונתוני סגמנטציה ישירות מהקונה, ואז סנכרנו ל-Klaviyo, Omnisend, Meta או GA4 כדי להזין את השיווק שלאחר מכן." },
  { emoji: "⚡", title: "רספונסיביות ומותאמות למובייל", body: "כל תבנית מגיעה בגישת mobile-first. מהירות, נגישות ומעוצבות כדי להרגיש נייטיב בטלפונים, טאבלטים ומחשבים." },
];

const jsonLd = [
  organization(),
  softwareApplication(),
  breadcrumb([
    { name: "דף הבית", url: "/" },
    { name: "תבניות חידון", url: "/templates/" },
  ]),
];
---

<Base
  title="תבניות חידון - RevenueHunt"
  description="תבניות חידון מוצרים ל-Shopify, WooCommerce, BigCommerce וחנויות עצמאיות. טיפוח עור, יופי, תוספים, מזון לחיות מחמד, ביגוד, ספורט ועוד - שאלות מובנות מראש, לוגיקה מותנית ואלגוריתמי המלצת מוצרים."
  jsonLd={jsonLd}
  lang="he"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20 text-center">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={lp("/")} class="hover:text-slate-700">דף הבית</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">תבניות חידון</span>
      </nav>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        תבניות חידון מוצרים ל-Shopify ו-WooCommerce
      </h1>
      <p class="mt-4 text-xl font-semibold text-slate-700">
        תבניות אינטראקטיביות של חידון המלצת מוצרים - מוכנות לשימוש
      </p>
      <p class="mx-auto mt-6 max-w-3xl text-slate-600">
        גלו את אוסף <strong class="font-semibold text-slate-900">תבניות החידון החינמיות</strong> שלנו שתוכננו לחנויות איקומרס.
        מחידוני טיפוח עור ויופי ועד תוספים, מזון לחיות מחמד ומוצרי לייפסטייל - כל תבנית בנויה כדי לעזור לכם להעניק
        חוויית קנייה מותאמת אישית שממירה. מושלמות ל-<strong class="font-semibold text-slate-900">Shopify</strong>,
        <strong class="font-semibold text-slate-900">WooCommerce</strong>, <strong class="font-semibold text-slate-900">BigCommerce</strong>,
        ולחנויות <strong class="font-semibold text-slate-900">עצמאיות</strong>.
      </p>
      <p class="mx-auto mt-4 max-w-3xl text-slate-600">
        תבניות חידון אלו ב-HTML ניתן להתאמה אישית מגיעות עם שאלות כתובות מראש, לוגיקה מותנית ואלגוריתמי המלצת מוצרים.
        בחרו תבנית, חברו את המוצרים שלכם, התאימו את העיצוב ופרסמו. לחצו על כל תבנית למטה כדי לראות דמו חי.
      </p>
    </div>
  </section>

  <!-- Top CTA banner -->
  <section class="mx-auto max-w-7xl px-6 pb-8">
    <div class="overflow-hidden rounded-2xl bg-[#16161D] px-8 py-12 text-center text-white">
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">נסו את תבניות חידון המוצרים שלנו בשידור חי</h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        חוו חידוני המלצת מוצרים פונקציונליים לחלוטין בחנות הדמו החיה שלנו ב-Shopify. נסו סוגי חידון שונים,
        חקרו לוגיקה מותנית, שאלות מסתעפות והמלצות מוצרים מותאמות אישית בפעולה.
      </p>
      <a
        href="https://productrecommendationquiz.com/"
        target="_blank"
        rel="external noopener nofollow"
        class="mt-8 inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
      >
        חקרו את הדמו החי של החידונים
      </a>
    </div>
  </section>

  <!-- Category nav -->
  <nav class="sticky top-[60px] z-30 border-y border-slate-200 bg-white/95 backdrop-blur" aria-label="Template categories">
    <ul class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-2 px-6 py-3">
      {groups.map((g) => (
        <li>
          <a
            href={`#${g.id}`}
            class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-[#16161D] hover:text-[#16161D]"
          >
            {g.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href="#gallery"
          class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-[#16161D] hover:text-[#16161D]"
        >
          גלריית דוגמאות חידון
        </a>
      </li>
    </ul>
  </nav>

  <!-- Template grids -->
  <section class="mx-auto max-w-7xl px-6 py-12">
    {groups.map((g) => (
      <div id={g.id} class="mb-16 scroll-mt-32 last:mb-0">
        <h2 class="mb-8 text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">{g.label}</h2>
        <ul class="grid gap-6 md:grid-cols-2">
          {g.items.map((t) => (
            <li class="flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md">
              <a
                href={t.demo}
                target="_blank"
                rel="external noopener nofollow"
                class="block aspect-[321/217] overflow-hidden bg-slate-50"
              >
                <img src={t.image} alt={t.title} loading="lazy" class="h-full w-full object-cover" />
              </a>
              <div class="flex flex-1 flex-col p-5">
                <h3 class="text-lg font-semibold text-slate-900">{t.title}</h3>
                <p class="mt-2 text-sm text-slate-600">{t.description}</p>
                <div class="mt-5 flex flex-wrap gap-2">
                  <a
                    href={t.demo}
                    target="_blank"
                    rel="external noopener nofollow"
                    class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#26262e]"
                  >
                    דמו
                  </a>
                  <a
                    href={lp("/product-recommendation-quiz/")}
                    class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-4 py-2 text-sm font-semibold text-[#16161D] transition hover:bg-slate-50"
                  >
                    קבלו את התבנית הזו
                  </a>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <!-- Examples gallery -->
    <div id="gallery" class="scroll-mt-32">
      <h2 class="mb-8 text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">גלריית דוגמאות חידון</h2>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {gallery.map((file) => (
          <li class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
            <a href={`/img/pages/templates/${file}`} target="_blank" rel="noopener" class="block aspect-video overflow-hidden bg-slate-50">
              <img src={`/img/pages/templates/${file}`} alt="דוגמת חידון" loading="lazy" class="h-full w-full object-cover" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Solutions cross-link -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 pb-4">
      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-8">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">לא בטוחים איזה חידון לבנות?</h2>
        <p class="mt-3 text-slate-700">
          פתרונות החידון שלנו מסבירים מהו סוג החידון הטוב ביותר לתחום שלכם, משגרות טיפוח עור ועד מאתרי מתנות, עם דוגמאות ושאלות נפוצות.
        </p>
        <ul class="mt-6 flex flex-wrap gap-3" role="list">
          {featuredSolutions.map((s) => (
            <li>
              <a
                href={`/solutions/${s.slug}/`}
                class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-[#16161D] hover:text-[#16161D]"
              >
                {s.name}
              </a>
            </li>
          ))}
          <li>
            <a
              href={lp("/solutions/")}
              class="inline-flex items-center rounded-full bg-[#16161D] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#26262e]"
            >
              כל הפתרונות →
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Why use templates -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        למה להשתמש בתבניות חידון מוצרים בחנות האיקומרס שלכם?
      </h2>
      <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {reasons.map((r) => (
          <li class="rounded-xl border border-slate-200 bg-white p-6">
            <div class="text-2xl">{r.emoji}</div>
            <h3 class="mt-3 text-lg font-semibold text-slate-900">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{r.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        התחילו לבנות את חידון המוצרים שלכם היום
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        צרו חידוני המלצת מוצרים מושכים לחנות ה-Shopify או ה-WooCommerce שלכם תוך דקות. בלי קוד.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SITE.signup_url}
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          נסו את תבניות החידון בחינם
        </a>
        <a
          href={lp("/demo/")}
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          הזמינו דמו
        </a>
      </div>
    </div>
  </section>
</Base>
