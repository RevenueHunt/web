---
import Base from "../layouts/Base.astro";
import PlanCards from "../components/pages/PlanCards.astro";
import YouTubeFacade from "../components/YouTubeFacade.astro";
import { organization, website, softwareApplication } from "../lib/schema";
import { SITE } from "../lib/site";

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=bfs_badge_hero";
const WOOCOMMERCE_DOWNLOAD =
  "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";
const YOUTUBE_ID = "fJqpGJUzZNE";

const stats = [
  { value: "+20,000", label: "Brands using RevenueHunt" },
  { value: "+40M", label: "Quizzes completed" },
  { value: "+1.3B USD", label: "Revenue for merchants" },
  { value: "4.9 ★", label: "450+ five-star reviews" },
];

const pillars = [
  {
    image: "/img/pages/home/recommend-right-products.svg",
    title: "Recommend the right products",
    body:
      "Shoppable quizzes drive sales, advise customers on finding the right products for them and help them make confident purchasing decisions.",
  },
  {
    image: "/img/pages/home/know-your-customers.svg",
    title: "Know your customers",
    body:
      "Quizzes let you collect actionable data by asking your customers targeted questions. Segment and tag your shoppers based on their responses.",
  },
  {
    image: "/img/pages/home/grow-your-audience.svg",
    title: "Grow your audience",
    body:
      "Send captured leads to your mailing list or CRM. Leverage customer profile data to create more personalized, higher ROI marketing campaigns.",
  },
];

const features = [
  {
    kicker: "AI quiz copilot",
    title: "Build a quiz in 60 seconds with AI",
    body:
      "Describe your store, and our AI copilot generates a fully-configured quiz - questions, logic, and product mappings - ready to publish.",
  },
  {
    kicker: "Conditional logic",
    title: "Drag-and-drop branching logic",
    body:
      "Show or hide questions based on previous answers. Guide each shopper down the path that ends in a purchase - no code required.",
  },
  {
    kicker: "Quiz design",
    title: "Make it yours - no code required",
    body:
      "Customize colors, fonts, images, and layout to match your brand. Your quiz looks like part of your store, not a third-party widget.",
  },
  {
    kicker: "Results page",
    title: "A checkout-ready results page that converts",
    body:
      "Show personalized product picks grouped by routine step - with images, prices, and add-to-cart buttons. Shoppers buy directly from the results page.",
  },
  {
    kicker: "Drop-off analytics",
    title: "Know exactly where shoppers leave",
    body:
      "See question-by-question drop-off rates, destinations, and outcomes. Fix friction points, improve completions, and recover lost revenue.",
  },
  {
    kicker: "Third-party integrations",
    title: "Connect your entire marketing stack",
    body:
      "Send quiz data to Google Analytics, fire Meta Pixel events for retargeting, and sync leads to Klaviyo - all from one settings page. No code, no middleware.",
  },
];

const steps = [
  {
    title: "Install the app",
    body: "One-click install from the Shopify App Store or WordPress plugin directory.",
  },
  {
    title: "Build your quiz",
    body: "Use the AI copilot or drag-and-drop builder. Add your questions, set your logic.",
  },
  {
    title: "Map your products",
    body: "Connect quiz answers to your product catalogue. Recommend the best match per result.",
  },
  {
    title: "Publish and promote",
    body: "Embed on any page, pop it up on exit intent, or link to it from your ads.",
  },
];

const testimonials = [
  {
    quote:
      "I switched over from Octane. The design process was far more intuitive and visually friendly. When I hit a Klaviyo snag, support answered with lightning speed and a super conversational, open attitude.",
    author: "Kae Paché",
  },
  {
    quote:
      "Eric was extremely patient, knowledgeable, and thorough - guiding me step by step through quiz setup. Support like this is rare.",
    author: "Marcelle",
  },
  {
    quote:
      "The app itself is excellent: powerful features, intuitive usability. The team created a personalized walkthrough tutorial for us. Used it for 3+ years.",
    author: "Didymos",
  },
  {
    quote:
      "By far the best quiz and product recommendation app I've tested on Shopify. The team took time to investigate, explain every step clearly, and guide until the issue was fully resolved.",
    author: "REYNA",
  },
  {
    quote:
      "It was the 5th quiz app I tried and was the only one that fully supported what I needed. I was able to create my first quiz very quickly.",
    author: "CCA Printing",
  },
  {
    quote:
      "The customer service stands out - an agent recorded a video and walked me through the fix step by step. Very responsive and super helpful.",
    author: "The Love U Collective",
  },
];

const verticals = [
  { icon: "💄", title: "Beauty & skincare", body: "Skin type finders, shade matching, routine builders." },
  { icon: "💊", title: "Supplements", body: "Health goal quizzes that recommend the right stack." },
  { icon: "👗", title: "Fashion", body: "Style quizzes that surface the right fit, colour, and cut." },
  { icon: "🐾", title: "Pets", body: "Breed-specific product recommendations for every owner." },
  { icon: "🍵", title: "Food & beverage", body: "Taste profile quizzes that turn browsers into subscribers." },
  { icon: "🏋️", title: "Fitness", body: "Goal-based funnels for gear, apparel, and programs." },
  { icon: "🏠", title: "Home & decor", body: "Style quizzes that match furniture to every living space." },
  { icon: "🌿", title: "Eco & sustainable", body: "Values-matching quizzes for the conscious consumer." },
];

const brands = [
  "Olaplex", "Madluvv", "Mattel", "Alt", "Baia", "Bare", "Biktrix",
  "Dermocracy", "Diego", "Gisou", "Laura", "Nuxe", "Olcay",
  "Salad Code", "Salugea", "Sunday", "Tushy", "Tiege",
];

const SHOPIFY_REVIEWS =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/reviews?ratings%5B%5D=5&sort_by=relevance";
const WOOCOMMERCE_REVIEWS =
  "https://wordpress.org/support/plugin/product-recommendation-quiz-for-ecommerce/reviews/?filter=5";
---

<Base
  title={`${SITE.name} - product recommendation quiz that converts`}
  description="Turn passive browsers into buyers with a guided product recommendation quiz. Capture zero-party data, recommend the right product, lift conversion. No code."
  jsonLd={[organization(), website(), softwareApplication()]}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-7xl px-6 py-16 lg:py-24">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:items-start lg:gap-16">
        <div>
          <a href={SHOPIFY_INSTALL} class="mb-6 inline-block">
            <img
              src="/img/home/bfs-badge.webp"
              alt="Built for Shopify"
              width="120"
              height="38"
              class="h-8 w-auto"
              loading="eager"
            />
          </a>
          <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
            The Product Recommendation Quiz that turns browsers into buyers
          </h1>
          <p class="mt-6 max-w-xl text-lg text-slate-700">
            Paid ads bring clicks - our quizzes turn them into sales. RevenueHunt guides shoppers to the right products,
            collects data, and drives conversions. Easy to install, no code needed.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={SHOPIFY_INSTALL}
              rel="external nofollow"
              onclick="window.gtag&&gtag('event','shopify_app_install',{screen_name:'Home'})"
              class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
            >
              <svg class="mr-2 h-5 w-5" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M27.69 7.43c-.02-.18-.18-.28-.31-.29-.13-.01-2.7-.05-2.7-.05s-2.15-2.09-2.36-2.3c-.21-.21-.62-.15-.78-.1-.02 0-.43.13-1.1.34-.66-1.9-1.82-3.65-3.87-3.65h-.18C15.81.65 15.08.32 14.46.32c-4.84.02-7.16 6.06-7.89 9.13l-3.39 1.05c-1.05.33-1.08.37-1.22 1.36L0 28.78l18.7 3.5L29 30.05S27.7 7.61 27.69 7.43z"/></svg>
              install on Shopify
            </a>
            <a
              href={WOOCOMMERCE_DOWNLOAD}
              rel="external nofollow"
              onclick="window.gtag&&gtag('event','download_woocommerce_plugin',{screen_name:'Home'})"
              class="inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-6 py-3 text-base font-semibold text-slate-900 transition hover:border-slate-400 hover:bg-slate-50"
            >
              get for WooCommerce
            </a>
          </div>
          <p class="mt-4 text-sm text-slate-500">
            Free plan available · 15-day free trial · 30-day money-back guarantee
          </p>
        </div>

        <div class="relative lg:mt-14">
          <div class="aspect-video overflow-hidden rounded-xl bg-slate-900 shadow-2xl">
            <YouTubeFacade id={YOUTUBE_ID} title="RevenueHunt - Product Recommendation Quiz" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats / proof bar -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <p class="text-center text-sm font-semibold uppercase tracking-wider text-white/70">
        Why choose RevenueHunt? Our impact speaks for itself
      </p>
      <dl class="mt-8 grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-4">
        {stats.map((s) => (
          <div class="text-center">
            <dt class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{s.value}</dt>
            <dd class="mt-2 text-sm text-white/70">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Problem framing -->
  <section class="mx-auto max-w-4xl px-6 py-20 text-center">
    <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
      Shoppers don't always know what to buy - and that means lost sales.
    </h2>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-700">
      Our <a href="/product-recommendation-quiz/" class="font-semibold text-slate-900 underline underline-offset-4 hover:text-slate-700">Product Recommendation Quiz</a> guides each customer through their journey, helping them discover and buy the right products for them.
    </p>
  </section>

  <!-- 3-up pillars -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="grid gap-10 md:grid-cols-3">
        {pillars.map((p) => (
          <div class="text-center">
            <img src={p.image} alt={p.title} width="120" height="120" class="mx-auto h-24 w-24" loading="lazy" />
            <h3 class="mt-6 text-xl font-semibold text-slate-900">{p.title}</h3>
            <p class="mt-3 text-slate-600">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features grid -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Everything you need to sell smarter</h2>
      </div>
      <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {features.map((f) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">{f.kicker}</p>
            <h3 class="mt-2 text-xl font-semibold text-slate-900">{f.title}</h3>
            <p class="mt-3 text-slate-600">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4-step setup -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Live in 4 steps. Under 15 minutes.</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          No developers. No code. Just a quiz your customers will love.
        </p>
      </div>
      <ol class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <li class="rounded-xl border border-slate-200 bg-white p-6">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-[#16161D] text-sm font-bold text-white">{i + 1}</span>
            <h3 class="mt-4 text-lg font-semibold text-slate-900">{s.title}</h3>
            <p class="mt-2 text-slate-600">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          See why merchants love Product Recommendation Quiz
        </h2>
        <p class="mx-auto mt-4 max-w-3xl text-lg text-slate-700">
          Trusted by over 20,000 brands and backed by 450+ five-star reviews across Shopify, WooCommerce, and more - 
          RevenueHunt is the go-to quiz app for driving sales through personalization. Just don't take our word for it.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-3 text-sm">
          <a href={SHOPIFY_REVIEWS} rel="external nofollow" class="font-semibold text-[#16161D] underline-offset-4 hover:underline">
            Reviews on Shopify →
          </a>
          <a href={WOOCOMMERCE_REVIEWS} rel="external nofollow" class="font-semibold text-[#16161D] underline-offset-4 hover:underline">
            Reviews on WooCommerce →
          </a>
        </div>
      </div>

      <h3 class="mt-16 text-center text-xl font-semibold text-slate-900">What merchants are saying</h3>
      <div class="rh-carousel mt-8">
        <ul data-carousel class="rh-carousel__track" aria-label="Merchant testimonials">
          {testimonials.map((t) => (
            <li class="rounded-xl border border-slate-200 bg-white p-6">
              <p class="text-amber-500" aria-label="5 out of 5 stars">★★★★★</p>
              <blockquote class="mt-3 text-slate-700">"{t.quote}"</blockquote>
              <p class="mt-4 text-sm font-semibold text-slate-900"> - {t.author}</p>
            </li>
          ))}
        </ul>
        <div data-carousel-dots class="rh-carousel__dots"></div>
      </div>
    </div>
  </section>

  <!-- Verticals -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Built for every eCommerce vertical</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          Whether you sell skincare, supplements, or sofas - a quiz that helps shoppers find the right product converts better than any collection page.
        </p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {verticals.map((v) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6">
            <span class="block text-3xl" aria-hidden="true">{v.icon}</span>
            <h3 class="mt-3 text-base font-semibold text-slate-900">{v.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Brand logos -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-white sm:text-3xl">Powering top eCommerce brands</h2>
      <div class="brands-marquee mt-10">
        <ul class="brands-marquee__track" aria-label="Customer brand logos">
          {brands.map((b) => (
            <li class="brands-marquee__item">
              <img
                src={`/img/brands/${b.toLowerCase().replace(/ /g, "-")}.svg`}
                alt={b}
                loading="lazy"
                width="160"
                height="40"
              />
            </li>
          ))}
          {brands.map((b) => (
            <li class="brands-marquee__item" aria-hidden="true">
              <img
                src={`/img/brands/${b.toLowerCase().replace(/ /g, "-")}.svg`}
                alt=""
                loading="lazy"
                width="160"
                height="40"
              />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <style>
    .brands-marquee {
      overflow: hidden;
      -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
      mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    }
    .brands-marquee__track {
      display: flex;
      align-items: center;
      width: max-content;
      list-style: none;
      padding: 0;
      margin: 0;
      animation: brands-marquee 40s linear infinite;
    }
    .brands-marquee:hover .brands-marquee__track {
      animation-play-state: paused;
    }
    .brands-marquee__item {
      flex-shrink: 0;
      padding: 10px 24px;
      height: 64px;
      display: flex;
      align-items: center;
    }
    .brands-marquee__item img {
      height: 100%;
      width: auto;
      max-width: 160px;
      object-fit: contain;
      /* Normalize mixed-fill SVGs to white on the dark strip. */
      filter: brightness(0) invert(1);
      opacity: 0.85;
    }
    @keyframes brands-marquee {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }
    @media (prefers-reduced-motion: reduce) {
      .brands-marquee__track { animation: none; }
    }
  </style>

  <!-- Plans summary -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Choose the best plan for your eCommerce</h2>
        <p class="mt-4 text-base text-slate-700 sm:text-lg">
          Free plan available. 15-day free trial with unlimited quiz responses &amp; all features. 30-day money back guarantee.
        </p>
      </div>

      <div class="mt-12">
        <PlanCards />
      </div>
    </div>
  </section>

  <!-- Multi-platform strip -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-16 text-center">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Works on multiple eCommerce platforms</h2>
      <!-- Logos are white SVGs (built for a dark bg); brightness-0 inverts them to dark for this white section. -->
      <ul class="mt-10 flex flex-wrap items-center justify-center gap-x-14 gap-y-8">
        <li>
          <a href="/product-recommendation-quiz-shopify/" aria-label="Product Recommendation Quiz for Shopify">
            <img src="/img/logos/shopify_monotone_white.svg" alt="Shopify" class="h-8 w-auto opacity-60 brightness-0 transition hover:opacity-100" />
          </a>
        </li>
        <li>
          <a href="/product-recommendation-quiz-woocommerce/" aria-label="Product Recommendation Quiz for WooCommerce">
            <img src="/img/logos/woo_logo_white.svg" alt="WooCommerce" class="h-8 w-auto opacity-60 brightness-0 transition hover:opacity-100" />
          </a>
        </li>
        <li>
          <a href="/product-recommendation-quiz-bigcommerce/" aria-label="Product Recommendation Quiz for BigCommerce">
            <img src="/img/logos/bigcommerce_logo_white.svg" alt="BigCommerce" class="h-7 w-auto opacity-60 brightness-0 transition hover:opacity-100" />
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-white/70">
        Most shoppers leave because they can't find the right product
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Turn shoppers into confident buyers with a Product Recommendation Quiz that drives sales.
      </h2>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a
          href={SHOPIFY_INSTALL}
          rel="external nofollow"
          onclick="window.gtag&&gtag('event','shopify_app_install',{screen_name:'Home'})"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          install on Shopify
        </a>
        <a
          href={WOOCOMMERCE_DOWNLOAD}
          rel="external nofollow"
          onclick="window.gtag&&gtag('event','download_woocommerce_plugin',{screen_name:'Home'})"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          get for WooCommerce
        </a>
      </div>
    </div>
  </section>
</Base>
