---
import Base from "../layouts/Base.astro";
import { SITE } from "../lib/site";
---

<Base title={`${SITE.name} — product recommendation quizzes for Shopify`}>
  <main class="mx-auto max-w-3xl px-6 py-24">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
      Welcome to {SITE.name}
    </h1>
    <p class="mt-6 text-lg text-slate-600">
      This is the Astro skeleton for revenuehunt.com. Real content lands in Phase 2.
    </p>
    <p class="mt-2 text-sm text-slate-500">
      See <code class="rounded bg-slate-100 px-1.5 py-0.5">PRD-Website-Astro-Migration.md</code> at the project root.
    </p>
  </main>
</Base>
