---
import Base from "../../layouts/Base.astro";
import { organization, breadcrumb } from "../../lib/schema";

interface Integration {
  name: string;
  category: string;
  logo: string;
  href: string;
}

const groups: { heading: string; emoji: string; intro: string; items: Integration[] }[] = [
  {
    heading: "Analytics & tracking",
    emoji: "📊",
    intro:
      "Measure quiz performance, track conversions, and optimize your funnel. See exactly which questions drive sales and where customers drop off.",
    items: [
      { name: "Google Analytics", category: "Data", logo: "/img/pages/integrations/ganalytics.png", href: "https://docs.revenuehunt.com/how-to-guides/integrate-google-analytics/" },
      { name: "Meta Pixel", category: "Data", logo: "/img/pages/integrations/metapixel.png", href: "https://docs.revenuehunt.com/how-to-guides/integrate-meta-pixel/" },
      { name: "TikTok Pixel", category: "Data", logo: "/img/pages/integrations/tiktoklog.png", href: "https://docs.revenuehunt.com/how-to-guides/integrate-tiktok-pixel/" },
      { name: "Webhooks", category: "Data", logo: "/img/pages/integrations/webhooklog.png", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-webhooks/" },
      { name: "Google Product Feed", category: "Products", logo: "/img/pages/integrations/googleproductfeed.png", href: "/product-recommendation-quiz-standalone-google-product-feed/" },
    ],
  },
  {
    heading: "Marketing & automation",
    emoji: "✉️",
    intro:
      "Sync quiz leads to your email platform or CRM. Send personalized follow-ups, segment customers by their responses, and nurture leads into loyal buyers automatically.",
    items: [
      { name: "Klaviyo", category: "Email marketing", logo: "/img/pages/integrations/klaviyolog.png", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-klaviyo/" },
      { name: "ActiveCampaign", category: "Automation", logo: "/img/pages/integrations/activecampaignlog.png", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-activecampaign/" },
      { name: "Mailchimp", category: "Email marketing", logo: "/img/pages/integrations/mailchimplog.png", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-mailchimp/" },
      { name: "Omnisend", category: "Email marketing", logo: "/img/pages/integrations/omnisendlog.png", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-omnisend/" },
      { name: "Zapier", category: "Automation", logo: "/img/pages/integrations/zapierlog.png", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-zapier/" },
      { name: "HubSpot", category: "CRM", logo: "/img/pages/integrations/hubspotlog.png", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-hubspot/" },
      { name: "Shopify Customers", category: "CRM", logo: "/img/pages/integrations/shopifylog.png", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-shopify-customers/" },
    ],
  },
  {
    heading: "Sales & social proof",
    emoji: "⭐",
    intro:
      "Tag customers in Shopify, recommend subscriptions, and surface reviews — all driven by quiz answers — so shoppers see exactly the proof and offer that matters to them.",
    items: [
      { name: "ReCharge", category: "Subscriptions", logo: "/img/pages/integrations/rechargelog.png", href: "https://docs.revenuehunt.com/how-to-guides/recommend-subscriptions/" },
      { name: "Shopify Reviews", category: "Social proof", logo: "/img/pages/integrations/shopifyreviews.png", href: "https://docs.revenuehunt.com/how-to-guides/show-product-reviews/" },
      { name: "Stamped", category: "Social proof", logo: "/img/pages/integrations/stampedlog.png", href: "https://docs.revenuehunt.com/how-to-guides/show-product-reviews/" },
      { name: "Judge.me", category: "Social proof", logo: "/img/pages/integrations/judgemelog.png", href: "https://docs.revenuehunt.com/how-to-guides/show-product-reviews/" },
      { name: "Rivyo Reviews", category: "Social proof", logo: "/img/pages/integrations/rivyolog.png", href: "https://docs.revenuehunt.com/how-to-guides/show-product-reviews/" },
      { name: "POS Tablet Stands", category: "In-store sales", logo: "/img/pages/integrations/poslog.png", href: "/product-recommendation-quiz-pos-tablet-stands/" },
      { name: "Shop App", category: "Mobile sales", logo: "/img/pages/integrations/shopapplog.png", href: "https://docs.revenuehunt.com/how-to-guides/show-quiz-in-shop-app/" },
    ],
  },
];

const pillars = [
  {
    emoji: "📊",
    title: "Track everything",
    body: "Connect with Google Analytics, Meta Pixel, and TikTok to measure quiz performance and optimize your campaigns.",
  },
  {
    emoji: "✉️",
    title: "Automate follow-ups",
    body: "Sync quiz leads with Klaviyo, Mailchimp, or ActiveCampaign to send personalized product recommendations automatically.",
  },
  {
    emoji: "💰",
    title: "Increase revenue",
    body: "Tag customers in Shopify, recommend subscriptions via ReCharge, and display social proof with reviews apps.",
  },
];

const stats = [
  { value: "20+", label: "Native integrations" },
  { value: "5 min", label: "Average setup time" },
  { value: "Zero", label: "Code required" },
];

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=integrations";
const WOOCOMMERCE_DOWNLOAD =
  "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Home", url: "/" },
    { name: "Integrations", url: "/integrations/" },
  ]),
];

function isExternal(href: string) {
  return /^https?:\/\//.test(href);
}
---

<Base
  title="Integrations — RevenueHunt"
  description="Connect your RevenueHunt quiz to Klaviyo, Meta Pixel, Mailchimp, Omnisend, GA4 and more. Sync leads and answers in 5 minutes — no code."
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-slate-700">Home</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Integrations</span>
      </nav>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Seamless integrations that amplify your quiz results
      </h1>
      <p class="mt-6 max-w-3xl text-xl text-slate-600">
        Turn quiz responses into revenue with powerful integrations. Connect RevenueHunt with your existing marketing stack to automate follow-ups, personalize campaigns, track performance, and convert more browsers into buyers. <strong class="text-slate-900">No coding required.</strong>
      </p>
    </div>
  </section>

  <!-- 3-up pillars -->
  <section class="border-y border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="grid gap-10 md:grid-cols-3">
        {pillars.map((p) => (
          <div>
            <div class="text-4xl" aria-hidden="true">{p.emoji}</div>
            <h2 class="mt-4 text-xl font-semibold text-slate-900">{p.title}</h2>
            <p class="mt-3 text-slate-600">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats bar -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-5xl px-6 py-14">
      <dl class="grid grid-cols-3 gap-x-8 gap-y-8">
        {stats.map((s) => (
          <div class="text-center">
            <dt class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{s.value}</dt>
            <dd class="mt-2 text-sm text-white/70">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Integration library -->
  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Explore our integration library</h2>
      <p class="mx-auto mt-4 max-w-2xl text-slate-600">
        Click any integration to see its setup guide in our help center.
      </p>
    </div>

    {groups.map((g) => (
      <div class="mt-16">
        <div class="mb-6 flex items-baseline gap-3">
          <span class="text-2xl" aria-hidden="true">{g.emoji}</span>
          <h3 class="text-2xl font-semibold tracking-tight text-slate-900">{g.heading}</h3>
        </div>
        <p class="max-w-3xl text-slate-600">{g.intro}</p>

        <ul class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
          {g.items.map((it) => (
            <li>
              <a
                href={it.href}
                {...(isExternal(it.href) ? { target: "_blank", rel: "external noopener" } : {})}
                class="flex h-full flex-col items-center gap-3 rounded-xl border border-slate-200 bg-white p-5 text-center transition hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md"
              >
                <img
                  src={it.logo}
                  alt={`${it.name} logo`}
                  width="80"
                  height="80"
                  loading="lazy"
                  class="h-14 w-14 object-contain"
                />
                <div>
                  <p class="text-base font-semibold text-slate-900">{it.name}</p>
                  <p class="mt-1 text-xs uppercase tracking-wider text-slate-500">{it.category}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Ready to connect your quiz to your marketing stack?
      </h2>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a
          href={SHOPIFY_INSTALL}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          install on Shopify
        </a>
        <a
          href={WOOCOMMERCE_DOWNLOAD}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          get for WooCommerce
        </a>
      </div>
    </div>
  </section>
</Base>
