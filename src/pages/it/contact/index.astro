---
import Base from "../../../layouts/Base.astro";
import YouTubeFacade from "../../../components/YouTubeFacade.astro";
import { organization, breadcrumb } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Home", url: "/" },
    { name: "Contatti", url: "/contact/" },
  ]),
];

const channels = [
  {
    label: "Leggi le guide di aiuto",
    href: "https://docs.revenuehunt.com/",
    note: "Documentazione self-service, integrazioni, risoluzione dei problemi.",
    external: true,
  },
  {
    label: "Supporto e vendite via email",
    href: "mailto:team@revenuehunt.com",
    note: "team@revenuehunt.com - vedi i tempi di risposta qui sotto.",
  },
  {
    label: "Controlla lo stato del sistema",
    href: "https://status.revenuehunt.com/",
    note: "Stato del servizio in tempo reale e cronologia degli incidenti. 99,98%+ di uptime.",
    external: true,
  },
];

const responseTiers = [
  {
    label: "Critico - produzione offline, sicurezza, integrità dei dati",
    sla: "Prima risposta entro 30 minuti, 24/7 in tutto il mondo",
  },
  {
    label: "Alto - funzionalità importante compromessa, più utenti coinvolti",
    sla: "Prima risposta entro 12 ore",
  },
  {
    label: "Standard - domande, aiuto con la configurazione",
    sla: "1 giorno lavorativo",
  },
  {
    label: "Bassa priorità - feedback, richieste di funzionalità",
    sla: "Fino a 3 giorni lavorativi",
  },
];
---

<Base
  title="Contatti - RevenueHunt"
  description="Mettiti in contatto con il team di supporto di RevenueHunt. Leggi le guide di aiuto, guarda il tutorial o fai il quiz di supporto per ottenere una risposta personalizzata in pochi minuti."
  jsonLd={jsonLd}
  lang="it"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20 text-center">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={localizedHref("/", "it")} class="hover:text-slate-700">Home</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Contatti</span>
      </nav>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Mettiti in contatto
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600">
        Leggi le guide di aiuto, guarda il tutorial o fai il nostro quiz di supporto qui sotto - il team di supporto più
        sveglio e cordiale dell'e-commerce ti risponderà.
      </p>
    </div>
  </section>

  <!-- Two-column: video + channels -->
  <section class="mx-auto max-w-7xl px-6 py-12">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Inizia dal tutorial</h2>
        <p class="mt-3 text-slate-600">
          La maggior parte delle domande trova risposta nella guida di 3 minuti. Dacci un'occhiata veloce prima di scriverci.
        </p>
        <div class="mt-6 aspect-video overflow-hidden rounded-xl bg-slate-900 shadow-xl">
          <YouTubeFacade id="oL1DnBd6N1U" title="Tutorial di supporto di RevenueHunt" />
        </div>
      </div>
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Come contattarci</h2>
        <ul class="mt-6 space-y-3">
          {channels.map((c) => (
            <li>
              <a
                href={c.href}
                target={c.external ? "_blank" : undefined}
                rel={c.external ? "external noopener" : undefined}
                class="group flex items-start justify-between gap-4 rounded-xl border border-slate-200 bg-white p-5 transition hover:border-slate-300 hover:shadow-md"
              >
                <div>
                  <p class="text-base font-semibold text-slate-900 group-hover:text-[#16161D]">{c.label}</p>
                  <p class="mt-1 text-sm text-slate-600">{c.note}</p>
                </div>
                <span class="mt-1 shrink-0 text-slate-400 transition group-hover:text-[#16161D]" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Support quiz -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Fai il nostro quiz di supporto</h2>
      <p class="mx-auto mt-3 max-w-2xl text-slate-600">
        Rispondi ad alcune domande veloci e ti indirizzeremo all'aiuto giusto - documentazione, tutorial o una risposta di una persona reale.
      </p>
      <div class="mx-auto mt-8 max-w-4xl overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <iframe
          src="https://admin.revenuehunt.com/public/quiz/ZAHJoMM"
          title="Quiz di supporto di RevenueHunt"
          loading="lazy"
          class="block h-[600px] w-full"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Response times — moved here from the right column so it sits under
       the quiz, since that's where visitors land after asking for help. -->
  <section class="mx-auto max-w-4xl px-6 py-16">
    <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm sm:p-10">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Tempi di risposta</h2>
      <p class="mt-3 text-slate-600">
        SLA di supporto a livelli per tutti i merchant, con priorità per gli account Shopify Plus ed enterprise.
      </p>
      <dl class="mt-6 grid gap-4 sm:grid-cols-2">
        {responseTiers.map((t) => (
          <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
            <dt class="text-sm font-semibold text-slate-900">{t.label}</dt>
            <dd class="mt-1 text-sm text-slate-600">{t.sla}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Base>
