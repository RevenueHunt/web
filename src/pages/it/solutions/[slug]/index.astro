---
import SolutionPage from "../../../../components/pages/SolutionPage.astro";
import { SOLUTIONS_BY_LANG } from "../../../../lib/solutions";

export function getStaticPaths() {
  return Object.values(SOLUTIONS_BY_LANG["it"]).map((solution) => ({
    params: { slug: solution.slug },
    props: { solution },
  }));
}
const { solution } = Astro.props;
---

<SolutionPage solution={solution} lang="it" translated={true} />
