---
import Base from "../../../layouts/Base.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import { organization, breadcrumb, article, faqPage } from "../../../lib/schema";
import { SITE } from "../../../lib/site";
import { localizedHref } from "../../../lib/i18n";
import {
  REPORT,
  DATASET,
  HEADLINE,
  VERTICAL_CONVERSION,
  AOV_UPLIFT,
  ATTRIBUTION,
  BASELINES,
} from "../../../lib/quiz-benchmarks";

const pageUrl = new URL(`/${REPORT.slug}/`, SITE.site_url).href;
const ogImage = `/og/${REPORT.slug}.png`;

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=state_of_product_quizzes";
// Free WordPress.org plugin (not the WooCommerce.com extension).
const WOO_PLUGIN =
  "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";

const formatN = (n: number | null) =>
  n === null ? "" : n.toLocaleString("en-US");

// Conversion expressed against a typical 2% store: 6.9% / 2% = 345%.
const boost = (rate: number) => Math.round((rate / HEADLINE.baselinePct) * 100);

// Metodologia + FAQ tradotte (il modulo dati condiviso resta in inglese per il PDF
// e le stat card). Definite prima di jsonLd perché faqPage(FAQ) usi il set tradotto.
const METHODOLOGY = [
  "Fonte: la piattaforma di RevenueHunt stessa, su ogni piattaforma di ecommerce che supportiamo. Aggregata e anonimizzata: nessun singolo negozio è identificabile, e i nostri negozi demo sono esclusi ovunque.",
  "La conversione è un tasso per chi fa il quiz: ordini attribuiti a una risposta del quiz, divisi per i quiz completati. Non è un tasso a livello di sito. Chi fa il quiz si auto-seleziona ed è più coinvolto del visitatore medio, quindi non è un confronto a parità di condizioni con il tasso di conversione complessivo di un negozio. Lo diciamo ovunque facciamo il confronto.",
  "La categoria è derivata dal nome del quiz scritto dal merchant (per esempio \"Quiz skincare\", \"Quiz cibo per cani\"). Circa il 78% delle risposte proviene da quiz generici o senza nome ed è escluso da ogni cifra per categoria.",
  "L'aumento dell'average order value è misurato all'interno del negozio: il valore mediano degli ordini del quiz dello stesso negozio rispetto al valore mediano dei suoi ordini senza quiz. Questo è robusto rispetto alla valuta e rimuove la distorsione del mix di negozi che annacqua l'effetto in una media ingenua su tutta la piattaforma.",
  "Ogni cifra di conversione è un minimo. L'attribuzione si sta ancora consolidando mentre i merchant sincronizzano gli ordini (il 9% dei primi ordini arriva oltre 30 giorni dopo il quiz), e gli ordini cross-device o non tracciati non si attribuiscono mai. I numeri reali sono più alti, non più bassi.",
];

const FAQ = [
  {
    question: "Come si misura la conversione del quiz?",
    answer:
      "Ordini attribuiti a una risposta del quiz, divisi per i quiz completati. Sull'intera piattaforma, il 5,5% degli acquirenti che completa un quiz (circa 1 su 18) effettua un ordine tracciato. È un tasso per chi fa il quiz, non un tasso a livello di sito: chi fa il quiz è più coinvolto del visitatore medio, quindi non è direttamente confrontabile con il tasso di conversione complessivo di un negozio.",
  },
  {
    question: "Perché il tasso di conversione del quiz è così più alto del negozio medio?",
    answer:
      "Due ragioni. Primo, il quiz stesso: sostituisce un catalogo opprimente con una breve conversazione e una raccomandazione chiara, eliminando l'indecisione che fa perdere vendite. Secondo, ciò che succede dopo che arrivano le risposte: ogni quiz cattura zero-party data ed etichetta l'acquirente, alimentando flussi di follow-up segmentati e retargeting. Le campagne segmentate generano oltre 3 volte il fatturato per destinatario rispetto agli invii generici (benchmark di segmentazione di Klaviyo), così un quiz continua a convertire tramite email e annunci personalizzati, non solo nella pagina dei risultati.",
    answerHtml:
      "Due ragioni. Primo, il quiz stesso: sostituisce un catalogo opprimente con una breve conversazione e una raccomandazione chiara, eliminando l'indecisione che fa perdere vendite. Secondo, ciò che succede dopo che arrivano le risposte: ogni quiz cattura zero-party data ed etichetta l'acquirente, alimentando flussi di follow-up segmentati e retargeting. Le campagne segmentate generano oltre 3 volte il fatturato per destinatario rispetto agli invii generici (<a href=\"https://www.klaviyo.com/marketing-resources/segmentation-benchmark-report\" target=\"_blank\" rel=\"external noopener nofollow\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">benchmark di segmentazione di Klaviyo</a>), così un quiz continua a convertire tramite email e annunci personalizzati, non solo nella pagina dei risultati.",
  },
  {
    question: "Gli acquirenti del quiz spendono davvero di più per ordine?",
    answer:
      "In media, sì, misurato a parità di condizioni. All'interno dello stesso negozio, gli ordini arrivati tramite un quiz sono circa dall'11% al 15% più grandi di quelli che non lo sono, e questo vale in circa 7 negozi su 10. Non è universale, però: è più forte nel beauty e skincare (circa +20%), più piatto in categorie come profumi e caffè.",
  },
  {
    question: "Come si applicano questi benchmark al mio negozio?",
    answer:
      "Inserisci il tuo traffico, l'average order value e il tasso di conversione attuale nel nostro calcolatore di ROI del quiz. Esegue questi stessi benchmark (il tasso del 5,5% per chi fa il quiz, la conversione per categoria, l'aumento di AOV) sui tuoi numeri per stimare il fatturato aggiuntivo che un quiz potrebbe portare.",
    answerHtml:
      "Inserisci il tuo traffico, l'average order value e il tasso di conversione attuale nel nostro <a href=\"/it/quiz-roi-calculator/\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">calcolatore di ROI del quiz</a>. Esegue questi stessi benchmark (il tasso del 5,5% per chi fa il quiz, la conversione per categoria, l'aumento di AOV) sui tuoi numeri per stimare il fatturato aggiuntivo che un quiz potrebbe portare.",
  },
  {
    question: "I dati sono anonimizzati?",
    answer:
      "Sì. Ogni cifra è aggregata e raccolta su milioni di risposte e migliaia di negozi. Nessun singolo negozio è identificabile. Il report esiste per condividere cosa dicono i dati, non per esporre alcun merchant.",
  },
  {
    question: "Posso usare questi numeri?",
    answer:
      "Sì. Citali con un link a questa pagina. Il report è gratuito e senza barriere, il PDF è scaricabile e i numeri principali sono disponibili come card da condividere.",
  },
];

const pageTitle = "Lo stato dei quiz di raccomandazione prodotti: report benchmark 2026";
const pageDescription = "Come funzionano davvero i quiz di raccomandazione prodotti: conversione, completamento e valore medio dell'ordine, con benchmark su oltre 45M di risposte reali in più di 20.000 negozi ecommerce.";

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Home", url: localizedHref("/", "it") },
    { name: "Lo stato dei quiz di raccomandazione prodotti", url: localizedHref(`/${REPORT.slug}/`, "it") },
  ]),
  article({
    title: pageTitle,
    description: pageDescription,
    url: pageUrl,
    image: ogImage,
    datePublished: REPORT.datePublished,
    dateModified: REPORT.dateModified,
    author: "RevenueHunt",
    tags: [
      "quiz di raccomandazione dei prodotti benchmark",
      "quiz conversion rate",
      "ecommerce personalization",
      "average order value",
    ],
  }),
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "RevenueHunt quiz di raccomandazione dei prodotti benchmarks 2026",
    description: pageDescription,
    url: pageUrl,
    creator: organization(),
    license: "https://creativecommons.org/licenses/by/4.0/",
    isAccessibleForFree: true,
    datePublished: REPORT.datePublished,
    keywords: [
      "quiz di raccomandazione dei prodotti",
      "conversion rate",
      "average order value",
      "ecommerce",
      "Shopify",
    ],
    distribution: {
      "@type": "DataDownload",
      encodingFormat: "application/pdf",
      contentUrl: new URL(REPORT.pdfPath, SITE.site_url).href,
    },
  },
  faqPage(FAQ),
];

const publishedLabel = new Date(REPORT.datePublished).toLocaleDateString("it-IT", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

// Category/vertical labels and the two long table notes, translated. Numbers stay
// from the shared data module; only the human-readable labels/notes are localized.
const VERT_LABEL: Record<string, string> = {
  "Fragrance": "Profumi",
  "Haircare": "Cura dei capelli",
  "Supplements & health": "Integratori e salute",
  "Beauty & skincare": "Beauty e skincare",
  "Coffee & tea": "Caffè e tè",
  "CBD": "CBD",
  "Other sectors": "Altri settori",
  "All quiz categories (pooled)": "Tutte le categorie di quiz (aggregate)",
};
const GROUPED_NOTE =
  "Tutto ciò che è fuori dalle categorie nominate, inclusi i quiz generici e ad alta valutazione. Misurato a circa il 3,6%, all'incirca il 180% di un negozio tipico.";
const POOLED_NOTE =
  "Il dato principale della piattaforma: 5,5% (1 su 18), circa il 275% di un tipico negozio al 2%. I quiz generici e senza nome (~78% delle risposte) sono esclusi dalle righe per categoria e tirano giù il numero complessivo al ~4%.";
const SCOPE: Record<string, string> = {
  "Statista": "Globale, 2025",
  "IRP Commerce": "Dati di merchant attivi UK/IE, 2025",
  "Dynamic Yield": "400+ brand di medie-grandi dimensioni, 2025",
  "Shopify": "Linee guida pubblicate da Shopify stessa",
};
const tr = <T extends { vertical: string }>(r: T) => ({ ...r, vertical: VERT_LABEL[r.vertical] ?? r.vertical });
const consumable = VERTICAL_CONVERSION.filter((r) => r.kind === "consumable").map(tr);
const considered = VERTICAL_CONVERSION.filter((r) => r.kind === "considered").map(tr);
const grouped = { ...tr(VERTICAL_CONVERSION.find((r) => r.kind === "grouped")!), note: GROUPED_NOTE };
const pooled = { ...tr(VERTICAL_CONVERSION.find((r) => r.kind === "total")!), note: POOLED_NOTE };
const aovRows = AOV_UPLIFT.perVertical.map(tr);
const baselines = BASELINES.map((b) => ({ ...b, scope: SCOPE[b.source] ?? b.scope }));
---

<Base
  title={pageTitle}
  description={pageDescription}
  ogImage={ogImage}
  jsonLd={jsonLd}
  lang="it"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <Breadcrumb items={[{ label: "Home", href: localizedHref("/", "it") }, { label: "Lo stato dei quiz di raccomandazione prodotti" }]} />
      <div class="text-center">
        <Eyebrow>Report benchmark · {publishedLabel}</Eyebrow>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          Lo stato dei quiz di raccomandazione prodotti
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          1 acquirente su 18 che completa un quiz di raccomandazione prodotti effettua un ordine, <strong>2,75 volte un tipico negozio online</strong>. Questo report analizza quali categorie convertono di più, quanto spendono in più gli acquirenti del quiz e per quanto tempo un singolo quiz continua a rendere. Sulla base di dati reali di <strong>{DATASET.responses} risposte al quiz</strong> in {DATASET.brands} negozi.
        </p>
        {/* TODO: restore hero CTAs ("Download the PDF" + "Read the findings")
            once a peer reviews the PDF design. Removed 2026-06-08 to hold the
            PDF download until that review. The PDF is still generated and the
            "Cite this report" section's download link is also held (see below). */}
      </div>
    </div>
  </section>

  <!-- Dataset band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-2xl bg-[#16161D] px-6 py-10 sm:px-10">
        <p class="text-center text-sm font-semibold uppercase tracking-wider text-white/50">
          Il dataset
        </p>
        <dl class="mt-6 grid grid-cols-1 gap-8 text-center sm:grid-cols-3">
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.responses}</dt>
            <dd class="mt-1 text-sm text-white/70">risposte al quiz analizzate</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.revenue}</dt>
            <dd class="mt-1 text-sm text-white/70">di fatturato generato per i merchant</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.brands}</dt>
            <dd class="mt-1 text-sm text-white/70">negozi ecommerce</dd>
          </div>
        </dl>
        <p class="mx-auto mt-6 max-w-3xl text-center text-sm text-white/60">
          Aggregato e anonimizzato, su Shopify, WooCommerce, BigCommerce, Magento e standalone. Nessun singolo negozio è identificabile. Ogni cifra qui sotto è un minimo: l'attribuzione si sta ancora consolidando, quindi i numeri reali sono più alti.
        </p>
      </div>
    </div>
  </section>

  <!-- Key findings (stat cards) -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">I numeri principali</h2>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">{HEADLINE.completedConv}%</p>
          <p class="mt-2 font-medium text-slate-900">degli acquirenti che completano un quiz effettua un ordine</p>
          <p class="mt-2 text-sm text-slate-600">Circa 1 su {HEADLINE.completedOneIn}, all'incirca {HEADLINE.multiple} volte un tipico negozio al {HEADLINE.baselinePct}%.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">+{AOV_UPLIFT.headlineLow}-{AOV_UPLIFT.headlineHigh}%</p>
          <p class="mt-2 font-medium text-slate-900">di average order value in più, all'interno dello stesso negozio</p>
          <p class="mt-2 text-sm text-slate-600">Misurato a parità di condizioni, presente in circa 7 negozi su 10.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">{HEADLINE.completionRate}%</p>
          <p class="mt-2 font-medium text-slate-900">degli acquirenti che iniziano un quiz lo completa</p>
          <p class="mt-2 text-sm text-slate-600">Circa 7 su 10 raggiungono la pagina dei risultati. Il {HEADLINE.abandonRate}% abbandona prima.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">1 su 5</p>
          <p class="mt-2 font-medium text-slate-900">ordini attribuiti al quiz arrivano oltre 30 giorni dopo</p>
          <p class="mt-2 text-sm text-slate-600">Il quiz continua a generare fatturato per mesi dopo averlo fatto.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Conversion by category -->
  <section id="conversion" class="scroll-mt-20 bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Conversione per categoria</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        La media della piattaforma nasconde un'ampia dispersione. <strong>Le categorie di consumo e di riacquisto convertono da due a tre volte di più</strong> rispetto al negozio online medio. Gli acquisti ad alto prezzo e ad alta valutazione convertono di un ordine di grandezza in meno: lì il quiz spinge la scoperta, ma la vendita arriva più tardi, fuori sessione.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">Categoria</th>
              <th class="py-3 pr-4 text-right font-semibold">Conversione</th>
              <th class="py-3 pr-4 text-right font-semibold">Aumento di conversione del quiz</th>
              <th class="py-3 text-right font-semibold">Risposte</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {consumable.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{r.rate}%</td>
                <td class="py-3 pr-4 text-right tabular-nums text-slate-600">{boost(r.rate)}%</td>
                <td class="py-3 text-right tabular-nums text-slate-500">{formatN(r.n)}</td>
              </tr>
            ))}
            {considered.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{r.rate}%</td>
                <td class="py-3 pr-4 text-right tabular-nums text-slate-600">{boost(r.rate)}%</td>
                <td class="py-3 text-right tabular-nums text-slate-500">{formatN(r.n)}</td>
              </tr>
            ))}
            <tr class="border-b border-slate-200">
              <td class="py-3 pr-4 font-medium">{grouped.vertical}</td>
              <td class="py-3 pr-4 text-right font-semibold tabular-nums">~{grouped.rate}%</td>
              <td class="py-3 pr-4 text-right tabular-nums text-slate-600">~{boost(grouped.rate)}%</td>
              <td class="py-3 text-right tabular-nums text-slate-500">{formatN(grouped.n)}</td>
            </tr>
            <tr class="border-t-2 border-slate-300">
              <td class="py-3 pr-4 font-semibold">{pooled.vertical}</td>
              <td class="py-3 pr-4 text-right font-bold tabular-nums">{pooled.rate}%</td>
              <td class="py-3 pr-4 text-right font-bold tabular-nums text-slate-600">{boost(pooled.rate)}%</td>
              <td class="py-3 text-right tabular-nums text-slate-500">tutte</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        {grouped.note}
      </p>
      <p class="mx-auto mt-2 max-w-3xl text-sm text-slate-500 text-center">
        {pooled.note}
      </p>
    </div>
  </section>

  <!-- AOV uplift -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Gli acquirenti del quiz spendono di più?</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        <strong>Misurati all'interno dello stesso negozio</strong>, gli ordini del quiz sono <strong>dal {AOV_UPLIFT.headlineLow}% al {AOV_UPLIFT.headlineHigh}% più grandi</strong> rispetto agli ordini senza quiz, e questo vale nel {AOV_UPLIFT.storesUpLow}%-{AOV_UPLIFT.storesUpHigh}% dei negozi. Non è universale: più forte dove il quiz può comporre un set o una routine, quasi piatto dove l'acquisto è un singolo articolo.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">Categoria</th>
              <th class="py-3 pr-4 text-right font-semibold">Aumento di AOV all'interno del negozio</th>
              <th class="py-3 text-right font-semibold">Negozi con un aumento</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {aovRows.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">
                  {r.uplift === null ? "Piatto" : `+${r.uplift}%`}
                </td>
                <td class="py-3 text-right tabular-nums text-slate-500">
                  {r.storesUp === null ? "n/d" : `${r.storesUp}%`}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        Misurato all'interno del negozio (stesso negozio, ordini del quiz vs. ordini senza quiz), quindi robusto rispetto alla valuta e controllato per il mix del negozio. Triangolato su tre campioni indipendenti con una mediana di +11%, +15% e +14%. Le categorie con campioni piccoli vengono omesse invece che sovrastimate.
      </p>
    </div>
  </section>

  <!-- Attribution / LTV -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Un quiz continua a rendere dopo la sessione</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        La maggior parte delle dashboard di attribuzione giudica un quiz dagli ordini dello stesso giorno e si ferma lì. Così si perde gran parte del valore. <strong>Il {ATTRIBUTION.sameDay}% dei primi ordini attribuiti al quiz avviene lo stesso giorno</strong>, ma la coda è lunga.
      </p>
      <div class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-4">
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.sameDay}%</p>
          <p class="mt-1 text-sm text-slate-600">lo stesso giorno</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.within7}%</p>
          <p class="mt-1 text-sm text-slate-600">entro 7 giorni</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.within30}%</p>
          <p class="mt-1 text-sm text-slate-600">entro 30 giorni</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">1 su 5</p>
          <p class="mt-1 text-sm text-slate-600">arrivano oltre 30 giorni dopo</p>
        </div>
      </div>
      <p class="mx-auto mt-6 max-w-3xl text-slate-700 text-center">
        Circa <strong>1 su 5 di tutti gli ordini attribuiti al quiz arriva oltre 30 giorni dopo il quiz</strong>. Il quiz non è solo una spinta al checkout: ogni risposta è zero-party data che etichetta l'acquirente e alimenta flussi di follow-up segmentati e retargeting. <a href="https://www.klaviyo.com/marketing-resources/segmentation-benchmark-report" target="_blank" rel="external noopener nofollow" class="font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]">Le campagne segmentate generano oltre 3 volte il fatturato per destinatario</a> rispetto agli invii generici, così un singolo quiz continua a convertire tramite email e annunci personalizzati per mesi.
      </p>
    </div>
  </section>

  <!-- Baseline context -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Cosa conta come "il negozio medio"</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        Non esiste un unico numero vero per la conversione nell'ecommerce: oscilla con la metodologia e il campione. L'intervallo onesto è all'incirca dall'1,6% al 2,9%. Facciamo benchmark contro un <strong>{HEADLINE.baselinePct}%</strong> tondo, l'estremo basso conservativo, che colloca chi fa il quiz a circa <strong>{HEADLINE.multiple} volte</strong> il negozio medio.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">Fonte</th>
              <th class="py-3 pr-4 text-right font-semibold">Conversione media</th>
              <th class="py-3 font-semibold">Ambito</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {baselines.map((b) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">
                  <a href={b.href} target="_blank" rel="external noopener nofollow" class="text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-slate-500">{b.source}</a>
                </td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{b.rate}</td>
                <td class="py-3 text-sm text-slate-600">{b.scope}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        Importante: il nostro 5,5% è un tasso per chi fa il quiz (ordini per quiz completato), mentre ogni cifra qui sopra è un tasso a livello di sito (ordini per visitatore). Chi fa il quiz si auto-seleziona, quindi parte del divario è il funnel, non solo il quiz. Riportiamo il confronto in modo schietto invece di abbellirlo.
      </p>
    </div>
  </section>

  <!-- Methodology -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Metodologia</h2>
      <ul class="mt-8 space-y-5" role="list">
        {METHODOLOGY.map((m) => (
          <li class="flex gap-3">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400" aria-hidden="true"></span>
            <p class="text-slate-700">{m}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Domande frequenti</h2>
      <div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
        {FAQ.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-lg font-semibold text-slate-900 [&::-webkit-details-marker]:hidden">
              <span>{f.question}</span>
              <svg
                class="h-5 w-5 flex-shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <p class="pb-5 text-slate-700" set:html={f.answerHtml ?? f.answer} />
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* TODO: restore the entire "Cite this report" section (PDF download +
      shareable stat-card links) once a designer reviews the report + PDF + card
      designs. Removed 2026-06-08 to hold the downloadable assets until review.
      The PDF and card PNGs are still generated by `bun run report`. */}

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Misura l'aumento sul tuo negozio.
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-white/70">
        RevenueHunt è gratuito per iniziare, con 100 risposte al quiz al mese. Crea un quiz, indirizzaci del traffico e leggi i tuoi numeri.
      </p>
      <p class="mx-auto mt-4 max-w-2xl text-white/60">
        Scopri cosa potrebbero aggiungere questi benchmark al tuo negozio con il nostro <a href={localizedHref("/quiz-roi-calculator/", "it")} class="font-medium text-white underline decoration-white/40 underline-offset-2 hover:decoration-white">calcolatore di ROI del quiz</a>.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SHOPIFY_INSTALL}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          inizia gratis su Shopify
        </a>
        <a
          href={WOO_PLUGIN}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          inizia gratis su WooCommerce
        </a>
      </div>
    </div>
  </section>
</Base>
