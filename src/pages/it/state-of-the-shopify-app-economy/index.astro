---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb, article, faqPage } from "../../../lib/schema";
import { SITE } from "../../../lib/site";
import { localizedHref } from "../../../lib/i18n";
import {
  REPORT,
  SOURCE,
  HEADLINE,
  GROWTH,
  REVIEWS,
  REVENUE,
  PRICING,
  GEOGRAPHY,
  QUIZ_LANE,
} from "../../../lib/app-economy";

const pageUrl = new URL(`/it/${REPORT.slug}/`, SITE.site_url).href;
const ogImage = `/og/${REPORT.slug}.png`;

const publishedLabel = new Date(REPORT.datePublished).toLocaleDateString("it-IT", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const title = "Lo stato dell'economia delle app di Shopify";
const description =
  "Ci sono 22.546 app attive sullo Shopify App Store e quasi nessuna arriva da qualche parte. Un report di dati su crescita, recensioni, concentrazione dei ricavi, prezzi e chi le crea, a partire da un'istantanea di ogni app attiva.";

// Metodologia + FAQ, tradotte. La frase iniziale di ogni nota di metodologia
// è in grassetto inline. Definite prima di jsonLd perché faqPage(FAQ) le usi.
const METHODOLOGY = [
  "<strong>Fonte:</strong> un'istantanea dello Shopify App Store pubblico, 22.546 schede di app attive, scattata a giugno 2026. Ogni campo proviene dalla scheda pubblica, non dai dati interni di Shopify né dall'account di alcun merchant.",
  "<strong>I ricavi sono stimati, non misurati.</strong> Sono modellati a partire dai piani di prezzo pubblicati di ogni app insieme ai segnali di recensioni e installazioni. Considera le cifre dei ricavi come un modello direzionale di quanto siano concentrati i guadagni, non come dati di fatturazione. Sono etichettate come \"stimate\" ovunque compaiano.",
  "<strong>La crescita usa la data di lancio pubblicata di ogni scheda.</strong> La fonte ha concentrato circa 2.800 date di lancio a maggio 2026, quindi la curva è letta come app attive cumulate per anno (il punto finale è il vero totale attuale), e la cifra dei \"oltre 6.000 negli ultimi 12 mesi\" elimina quell'artefatto di un singolo mese.",
  "<strong>Le recensioni sono un'approssimazione della trazione</strong>, non perfetta: un'ottima app può essere nuova, e il numero di recensioni è in ritardo rispetto all'utilizzo reale. Le usiamo perché sono il segnale pubblico e comparabile più chiaro di una base merchant reale su 22.546 app.",
  "Le categorie nell'App Store sono tag di funzionalità che un'app può autoassegnarsi, e molte app ne portano diverse o nessuna, quindi riportiamo i tagli che non sono ambigui (recensioni, prezzi, data di lancio, paese dello sviluppatore) ed evitiamo di sovrainterpretare la tassonomia dei tag.",
];

const FAQ = [
  {
    question: "Quante app ci sono sullo Shopify App Store?",
    answer:
      "22.546 app attive in questa istantanea di giugno 2026. Lo store è cresciuto di circa 10 volte dal 2020 e ha aggiunto oltre 6.000 app solo negli ultimi 12 mesi, circa 1 su 4 di tutto ciò che è attivo oggi. Lo sviluppo assistito dall'IA ha trasformato quella che una volta era una creazione di sei mesi in un weekend.",
  },
  {
    question: "Perché la maggior parte delle app di Shopify fallisce?",
    answer:
      "Creare non è più il vincolo, quindi lo store si riempie di app che non trovano mai una base merchant. Il 51% non ha nessuna recensione e l'81% ne ha meno di 10. La cosa rara è la distribuzione e la fiducia: rispondere al supporto, guadagnarsi recensioni un merchant alla volta, esserci per anni. È la parte che l'IA non può fare per te.",
  },
  {
    question: "Quanto guadagnano le app di Shopify?",
    answer:
      "I guadagni sono estremamente concentrati. Secondo la nostra stima, l'1% in cima delle app (225 di esse) si prende circa il 72% di tutti i ricavi delle app, e le prime 10 da sole si prendono quasi un terzo. Solo circa il 36% delle app sembra guadagnare qualcosa. I ricavi qui sono stimati a partire dai prezzi pubblici e dai segnali di utilizzo, non da dati di fatturazione.",
  },
  {
    question: "La maggior parte delle app di Shopify sono gratis?",
    answer:
      "Di fatto, sì. Il 46,9% è gratis e un altro 48,6% parte con una prova gratuita; solo il 4,5% fa pagare in anticipo. Quasi il 45% offre un piano gratis permanente. Sullo Shopify App Store un punto d'ingresso gratuito non è una tattica di crescita, è l'aspettativa di base.",
  },
  {
    question: "Dove posso vedere i dati di base?",
    answer:
      "Questo report è il complemento ricco di dati della nostra nota sul campo su LinkedIn sull'economia delle app. Le cifre provengono da un'istantanea che teniamo di ogni app di Shopify attiva: date di lancio, recensioni, prezzi, il badge Built for Shopify e il paese dello sviluppatore. Se crei su Shopify e vuoi un taglio specifico, contattaci.",
    answerHtml:
      "Questo report è il complemento ricco di dati della nostra nota sul campo su LinkedIn sull'economia delle app. Le cifre provengono da un'istantanea che teniamo di ogni app di Shopify attiva: date di lancio, recensioni, prezzi, il badge Built for Shopify e il paese dello sviluppatore. Se crei su Shopify e vuoi un taglio specifico, <a href=\"/it/contact/\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">contattaci</a>.",
  },
];

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Home", url: localizedHref("/", "it") },
    { name: title, url: localizedHref(`/${REPORT.slug}/`, "it") },
  ]),
  article({
    title,
    description,
    url: pageUrl,
    image: ogImage,
    datePublished: REPORT.datePublished,
    dateModified: REPORT.dateModified,
    author: "RevenueHunt",
    tags: [
      "Shopify app store",
      "sviluppatori di app per Shopify",
      "statistiche dell'app store",
      "economia delle app",
    ],
  }),
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "Lo stato dell'economia delle app di Shopify 2026",
    description,
    url: pageUrl,
    creator: organization(),
    license: "https://creativecommons.org/licenses/by/4.0/",
    isAccessibleForFree: true,
    datePublished: REPORT.datePublished,
    keywords: [
      "Shopify app store",
      "sviluppatori di app",
      "ricavi delle app",
      "recensioni delle app",
      "ecommerce",
    ],
  },
  faqPage(FAQ),
];

// Section eyebrows for the editorial "field notes" feel.
const E = (n: string, label: string) => `${n} · ${label}`;

// Translated headline cards. Stats stay from the shared data module (HEADLINE[i].stat).
const headlineT = [
  { label: "app attive nello store", note: "Circa 10 volte tanto dal 2020." },
  { label: "non hanno nessuna recensione", note: "Quattro su cinque ne hanno meno di 10." },
  { label: "dei ricavi se lo prende l'1% in cima", note: "225 app. Stimato." },
  { label: "fanno pagare in anticipo", note: "Solo 1 su 20. Quasi la metà sono gratis." },
];

// Growth caption with the lead phrase bolded.
const growthCaptionHtml =
  "App attive cumulate per anno di lancio. <strong>Lo Shopify App Store è cresciuto di circa 10 volte dal 2020</strong> e ha aggiunto oltre 6.000 app solo negli ultimi 12 mesi, circa 1 su 4 di tutto ciò che oggi è attivo.";

// Quiz-lane paragraphs (translated), with the live search link and the load-bearing
// lines bolded inline. Caption text mirrors the English source's meaning.
const quizParas = [
  `La nostra stessa categoria dimostra la stessa cosa. <a href="${QUIZ_LANE.searchUrl}" target="_blank" rel="external noopener nofollow" class="font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]">la ricerca di quiz su Shopify</a> restituisce 149 app, ma qui la fiducia si accumula in cima esattamente come in tutto lo store. Le tre app che sono arrivate per prime e non se ne sono mai andate, RevenueHunt, Octane AI e Quiz Kit, concentrano il 45% di tutte le recensioni della categoria; <strong>RevenueHunt da sola ne ha circa un quarto</strong>, e la metà inferiore non ne ha nessuna.`,
  `Non siamo arrivati in cima a forza di codice. <strong>Le recensioni sono il residuo del tessuto cicatriziale operativo</strong> che c'è dietro: sei anni a rispondere al supporto, a metterci al telefono con merchant che non avrebbero mai pagato e a guadagnarci la fiducia negozio per negozio. Octane AI e Quiz Kit hanno fatto lo stesso lavoro duro per anni, <strong>e glielo riconosciamo</strong>. Menzione d'onore per Lantern e Quizell, entrambe con poco più di 120 recensioni.`,
];

// Methodology bullets carry their own inline <strong>; render as-is.
const methodologyHtml = METHODOLOGY;
---

<Base
  title={`${title} - report di dati 2026`}
  description={description}
  ogImage={ogImage}
  jsonLd={jsonLd}
  lang="it"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={localizedHref("/", "it")} class="hover:text-slate-700">Home</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Lo stato dell'economia delle app di Shopify</span>
      </nav>
      <div class="text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">
          Note sul campo · {publishedLabel}
        </p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          Lo stato dell'economia delle app di Shopify
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          <strong>Ci sono 22.546 app attive sullo Shopify App Store, e quasi nessuna arriva da qualche parte.</strong> Abbiamo preso un'istantanea di ogni app attiva e letto i dati su crescita, recensioni, ricavi, prezzi e chi le crea. Raccontano una sola storia: creare l'app non è mai stata la parte difficile.
        </p>
      </div>
    </div>
  </section>

  <!-- Source band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-2xl bg-[#16161D] px-6 py-10 sm:px-10">
        <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#4dcaff]">
          L'istantanea
        </p>
        <dl class="mt-6 grid grid-cols-2 gap-8 text-center sm:grid-cols-4">
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.apps}</dt>
            <dd class="mt-1 text-sm text-white/70">app attive nell'istantanea</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.countries}</dt>
            <dd class="mt-1 text-sm text-white/70">paesi che le creano</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.reviewless}</dt>
            <dd class="mt-1 text-sm text-white/70">senza nessuna recensione</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.free}</dt>
            <dd class="mt-1 text-sm text-white/70">completamente gratis, senza piano a pagamento</dd>
          </div>
        </dl>
        <p class="mx-auto mt-6 max-w-3xl text-center text-sm text-white/60">
          Ogni cifra qui sotto proviene dalla scheda pubblica nell'App Store delle 22.546 app attive, giugno 2026. I ricavi sono stimati a partire dai prezzi pubblicati e dai segnali di utilizzo, non da dati di fatturazione, e sono etichettati come tali in tutto il report.
        </p>
      </div>
    </div>
  </section>

  <!-- Headline cards -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Le cifre principali</h2>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        {HEADLINE.map((c, i) => (
          <div class="rounded-xl border border-slate-200 p-7">
            <p class="text-4xl font-bold tracking-tight text-[#16161D]">{c.stat}</p>
            <p class="mt-2 font-medium text-slate-900">{headlineT[i].label}</p>
            <p class="mt-2 text-sm text-slate-600">{headlineT[i].note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 01 Growth -->
  <section class="scroll-mt-20 bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("01", "Crescita")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Cresciuta di 10 volte dal 2020</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center" set:html={growthCaptionHtml} />
      <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
        <div class="h-72 sm:h-80"><canvas id="c-growth" aria-label="App di Shopify attive cumulate per anno" role="img"></canvas></div>
      </div>
    </div>
  </section>

  <!-- 02 Traction -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("02", "Trazione")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">La maggior parte delle app non ottiene mai una recensione</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">Metà dello Shopify App Store non ha mai guadagnato una sola recensione. Quattro app su cinque ne hanno meno di 10. Una recensione è l'indicatore pubblico più chiaro di un merchant reale e fidelizzato, e la maggior parte delle app non ne ottiene mai nessuna.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-center text-sm font-semibold text-slate-700">App per numero di recensioni</p>
          <div class="h-72 sm:h-80"><canvas id="c-reviews" aria-label="Distribuzione delle recensioni tra tutte le app attive" role="img"></canvas></div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">81%</p>
            <p class="mt-1 text-slate-700">hanno meno di 10 recensioni</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="font-bold text-[#16161D]"><span class="text-3xl">{REVIEWS.medianReviews}</span> <span class="text-sm font-medium text-slate-500">recensioni</span></p>
            <p class="mt-1 text-slate-700">la mediana, tra le app che ne hanno una</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="font-bold text-[#16161D]"><span class="text-amber-400">★</span> <span class="text-3xl">{REVIEWS.avgRating}</span> <span class="text-sm font-medium text-slate-500">stelle</span></p>
            <p class="mt-1 text-slate-700">valutazione media, tra le {REVIEWS.ratedCount} app che ne hanno una</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 Revenue -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("03", "Ricavi · stimato")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Il denaro si concentra in cima</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">I ricavi mensili stimati sono brutalmente concentrati in cima. L'1% in cima delle app (225 di esse) si prende un 72% stimato, e solo 10 di queste app si prendono da sole quasi il 30% di tutti i ricavi delle app. Appena il 36% delle app sembra guadagnare qualcosa. Si concentrano anche geograficamente: <strong>USA e Canada da soli si prendono un 57% stimato</strong> dei ricavi dello Shopify App Store.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-sm font-medium text-slate-500">Distribuzione dei ricavi</p>
          <div class="h-64 sm:h-72"><canvas id="c-revenue-donut" aria-label="Ripartizione dei ricavi stimati: le prime 10 app, il resto del top 1% e l'altro 99%" role="img"></canvas></div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-sm font-medium text-slate-500">Ricavi stimati per paese</p>
          <div class="h-64 sm:h-72"><canvas id="c-revenue-countries" aria-label="Ricavi stimati per paese" role="img"></canvas></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 Pricing -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("04", "Prezzi")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Quasi nessuno fa pagare in anticipo</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">Quasi metà dello store non fa pagare nulla in anticipo, e meno di 1 app su 20 chiede soldi prima della prima installazione. Quasi il 45% offre un piano gratis permanente. Qui il freemium non è una strategia, è il minimo per entrare.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <div class="h-72 sm:h-80"><canvas id="c-pricing" aria-label="Ripartizione del modello di prezzo tra tutte le app attive" role="img"></canvas></div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">{PRICING.permanentFree}</p>
            <p class="mt-1 text-slate-700">offrono un piano gratis permanente, non solo una prova</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">1 su 20</p>
            <p class="mt-1 text-slate-700">app fanno pagare soldi prima della prima installazione</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 Who builds them -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("05", "Chi le crea")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Create in 115 paesi, dominate da due</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">Le app arrivano da 115 paesi, ma due dominano: USA (16%) e India (9%) creano insieme un quarto dello store. E dopo anni in cui Shopify ha spinto lo standard, solo il 6,7% delle app attive (circa 1.500) porta il badge Built for Shopify.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <div class="h-72 sm:h-80"><canvas id="c-geography" aria-label="Principali paesi degli sviluppatori per numero di app" role="img"></canvas></div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">{GEOGRAPHY.builtForShopify}</p>
            <p class="mt-1 text-slate-700">portano il badge Built for Shopify ({GEOGRAPHY.builtForShopifyCount} app), anni dopo che Shopify ha iniziato a spingere lo standard</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">25%</p>
            <p class="mt-1 text-slate-700">di tutto lo store viene creato solo da USA e India</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 The quiz lane -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("06", "La corsia dei quiz")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">La nostra categoria, da vicino</h2>
      {quizParas.map((html) => (
        <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center" set:html={html} />
      ))}
      <div class="mx-auto mt-8 grid max-w-3xl grid-cols-3 gap-4 text-center">
        <a
          href="https://apps.shopify.com/product-recommendation-quiz-revenuehunt"
          target="_blank"
          rel="external noopener"
          class="block rounded-xl border border-[#616eff]/60 p-6 shadow-[0_0_28px_-4px_rgba(97,110,255,0.55)] transition hover:border-[#616eff] hover:shadow-[0_0_32px_-2px_rgba(97,110,255,0.7)]"
        >
          <p class="text-sm font-semibold text-slate-900">RevenueHunt</p>
          <p class="mt-1 font-bold text-[#16161D]"><span class="text-3xl">{QUIZ_LANE.revenueHuntReviews}</span> <span class="text-sm font-medium text-slate-500">recensioni</span></p>
          <p class="mt-1 text-xs font-semibold text-slate-600"><span class="text-amber-400">★</span> 4,9 stelle</p>
        </a>
        <div class="rounded-xl border border-slate-200 p-6">
          <p class="text-sm font-medium text-slate-700">Octane AI</p>
          <p class="mt-1 font-bold text-slate-500"><span class="text-3xl">{QUIZ_LANE.octaneReviews}</span> <span class="text-sm font-medium text-slate-500">recensioni</span></p>
          <p class="mt-1 text-xs font-semibold text-slate-600"><span class="text-amber-400">★</span> 4,8 stelle</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-6">
          <p class="text-sm font-medium text-slate-700">Quiz Kit</p>
          <p class="mt-1 font-bold text-slate-500"><span class="text-3xl">{QUIZ_LANE.quizKitReviews}</span> <span class="text-sm font-medium text-slate-500">recensioni</span></p>
          <p class="mt-1 text-xs font-semibold text-slate-600"><span class="text-amber-400">★</span> 4,8 stelle</p>
        </div>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-center text-sm text-slate-500">Recensioni sullo Shopify App Store, giugno 2026. Octane AI e Quiz Kit sono i veri concorrenti che RevenueHunt ha in questa categoria; rispetto per entrambi.</p>
    </div>
  </section>

  <!-- Takeaway -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#4dcaff]">La conclusione</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Creare l'app non è mai stata la parte difficile.
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-white/75">
        L'IA non ha cambiato questo. Ha solo reso impossibile nasconderlo. Quando il codice diventa un bene di consumo, la valanga di app nuove non è la concorrenza. La concorrenza è il pugno di persone arrivate presto che non hanno mai smesso di lavorare sodo: rispondendo al supporto, guadagnandosi recensioni merchant per merchant, costruendo fiducia.
      </p>
      <p class="mx-auto mt-5 max-w-2xl text-lg font-semibold text-white">
        Distribuzione e fiducia sono l'unica mossa a prova di IA rimasta.
      </p>
      <p class="mx-auto mt-10 max-w-2xl text-lg text-white/85">
        Stai costruendo un'app di Shopify che funziona davvero? Voglio conoscere i fondatori che fanno la parte difficile. Parliamone.
      </p>
      <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={localizedHref("/contact/", "it")}
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          Contattaci
        </a>
        <a
          href="https://www.linkedin.com/in/revenuehunt/"
          target="_blank"
          rel="external noopener"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          Connettiti su LinkedIn
        </a>
      </div>
      <p class="mx-auto mt-10 max-w-2xl text-white/60">
        L'hai trovato interessante? Abbiamo fatto la stessa analisi sulla nostra categoria in <a href={localizedHref("/state-of-product-recommendation-quizzes/", "it")} class="font-medium text-white underline decoration-white/40 underline-offset-2 hover:decoration-white">lo stato dei quiz di raccomandazione prodotti</a>.
      </p>
    </div>
  </section>

  <!-- Methodology -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Metodologia</h2>
      <ul class="mt-8 space-y-5" role="list">
        {methodologyHtml.map((m) => (
          <li class="flex gap-3">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400" aria-hidden="true"></span>
            <p class="text-slate-700" set:html={m} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Domande frequenti</h2>
      <div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
        {FAQ.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-lg font-semibold text-slate-900 [&::-webkit-details-marker]:hidden">
              <span>{f.question}</span>
              <svg class="h-5 w-5 flex-shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <p class="pb-5 text-slate-700" set:html={f.answerHtml ?? f.answer} />
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  import Chart from "chart.js/auto";
  import { GROWTH, REVIEWS, REVENUE, PRICING, GEOGRAPHY, COLORS, CHART_LABELS } from "../../../lib/app-economy";

  Chart.defaults.font.family =
    "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif";
  Chart.defaults.color = "#475569";
  Chart.defaults.font.size = 13;

  const el = (id: string) => document.getElementById(id) as HTMLCanvasElement | null;
  const grid = "#eef0f2";
  const kfmt = (v: number) => (v >= 1000 ? v / 1000 + "K" : "" + v);
  const L = CHART_LABELS[document.documentElement.lang] ?? CHART_LABELS.en;

  const growth = el("c-growth");
  if (growth)
    new Chart(growth, {
      type: "line",
      data: {
        labels: GROWTH.labels,
        datasets: [
          {
            data: GROWTH.cumulative,
            borderColor: COLORS.primary,
            backgroundColor: "rgba(97,110,255,0.10)",
            fill: true,
            tension: 0.35,
            borderWidth: 2.5,
            pointRadius: 3,
            pointHoverRadius: 5,
            pointBackgroundColor: COLORS.primary,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: { callbacks: { label: (c) => Number(c.parsed.y).toLocaleString() + " apps live" } },
        },
        scales: {
          y: { beginAtZero: true, grid: { color: grid }, ticks: { callback: (v) => kfmt(Number(v)) } },
          x: { grid: { display: false } },
        },
      },
    });

  const donutOpts = (suffix: string) => ({
    responsive: true,
    maintainAspectRatio: false,
    cutout: "62%",
    plugins: {
      legend: { position: "bottom" as const, labels: { boxWidth: 12, boxHeight: 12, padding: 16 } },
      tooltip: { callbacks: { label: (c: any) => `${c.label}: ${c.parsed}${suffix}` } },
    },
  });

  const reviews = el("c-reviews");
  if (reviews)
    new Chart(reviews, {
      type: "doughnut",
      data: { labels: L.reviews, datasets: [{ data: REVIEWS.values, backgroundColor: REVIEWS.colors, borderWidth: 0 }] },
      options: {
        ...donutOpts("%"),
        plugins: {
          legend: { position: "bottom" as const, labels: { boxWidth: 12, boxHeight: 12, padding: 16 } },
          tooltip: {
            callbacks: {
              title: (it: any) => L.reviewsTip.title.replace("{x}", it[0].label),
              label: (c: any) => L.reviewsTip.body.replace("{n}", REVIEWS.counts[c.dataIndex].toLocaleString()).replace("{p}", c.parsed),
            },
          },
        },
      },
    });

  const revDonut = el("c-revenue-donut");
  if (revDonut)
    new Chart(revDonut, {
      type: "doughnut",
      data: { labels: L.revenueDonut, datasets: [{ data: REVENUE.donut.values, backgroundColor: REVENUE.donut.colors, borderWidth: 0 }] },
      options: donutOpts("%"),
    });

  const revCountries = el("c-revenue-countries");
  if (revCountries)
    new Chart(revCountries, {
      type: "doughnut",
      data: { labels: L.revenueCountries, datasets: [{ data: REVENUE.countries.values, backgroundColor: REVENUE.countries.colors, borderWidth: 0 }] },
      options: {
        ...donutOpts("%"),
        plugins: {
          legend: { position: "bottom" as const, labels: { boxWidth: 12, boxHeight: 12, padding: 16 } },
          tooltip: { callbacks: { title: (it: any) => L.revenueCountriesFull[it[0].dataIndex], label: (c: any) => `${L.revenueCountriesFull[c.dataIndex]}: ${c.parsed}%` } },
        },
      },
    });

  const pricing = el("c-pricing");
  if (pricing)
    new Chart(pricing, {
      type: "doughnut",
      data: { labels: L.pricing, datasets: [{ data: PRICING.values, backgroundColor: PRICING.colors, borderWidth: 0 }] },
      options: donutOpts("%"),
    });

  const geo = el("c-geography");
  if (geo)
    new Chart(geo, {
      type: "bar",
      data: { labels: L.geography, datasets: [{ data: GEOGRAPHY.values, backgroundColor: GEOGRAPHY.labels.map((_, i) => (i < 2 ? COLORS.primary : COLORS.secondary)), borderRadius: 4 }] },
      options: {
        indexAxis: "y",
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: (c) => Number(c.parsed.x).toLocaleString() + " apps" } } },
        scales: { x: { beginAtZero: true, grid: { color: grid }, ticks: { callback: (v) => kfmt(Number(v)) } }, y: { grid: { display: false } } },
      },
    });
</script>
