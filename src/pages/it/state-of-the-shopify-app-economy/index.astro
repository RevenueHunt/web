---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb, article, faqPage } from "../../../lib/schema";
import { SITE } from "../../../lib/site";
import { localizedHref } from "../../../lib/i18n";
import {
  REPORT,
  SOURCE,
  HEADLINE,
  GROWTH,
  REVIEWS,
  REVENUE,
  PRICING,
  GEOGRAPHY,
  NICHES,
  QUIZ_LANE,
} from "../../../lib/app-economy";

const pageUrl = new URL(`/it/${REPORT.slug}/`, SITE.site_url).href;
const ogImage = `/og/${REPORT.slug}.png`;

const publishedLabel = new Date(REPORT.datePublished).toLocaleDateString("it-IT", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const title = "Lo stato dell'economia delle app di Shopify";
const description =
  "Ci sono 22.546 app attive sullo Shopify App Store e quasi nessuna arriva da qualche parte. Un report di dati su crescita, recensioni, concentrazione dei ricavi, prezzi e chi le crea, a partire da un'istantanea di ogni app attiva.";

// Metodologia + FAQ, tradotte. La frase iniziale di ogni nota di metodologia
// è in grassetto inline. Definite prima di jsonLd perché faqPage(FAQ) le usi.
const METHODOLOGY = [
  "<strong>Fonte:</strong> un'istantanea dello Shopify App Store pubblico, 22.546 schede di app attive, scattata a giugno 2026. Ogni campo proviene dalla scheda pubblica, non dai dati interni di Shopify né dall'account di alcun merchant.",
  "<strong>I ricavi sono stimati, non misurati.</strong> Sono modellati a partire dai piani di prezzo pubblicati di ogni app insieme ai segnali di recensioni e installazioni. Considera le cifre dei ricavi come un modello direzionale di quanto siano concentrati i guadagni, non come dati di fatturazione. Sono etichettate come \"stimate\" ovunque compaiano.",
  "<strong>La crescita usa la data di lancio pubblicata di ogni scheda.</strong> La fonte ha concentrato circa 2.800 date di lancio a maggio 2026, quindi la curva è letta come app attive cumulate per anno (il punto finale è il vero totale attuale), e la cifra dei \"oltre 6.000 negli ultimi 12 mesi\" elimina quell'artefatto di un singolo mese.",
  "<strong>Le recensioni sono un'approssimazione della trazione</strong>, non perfetta: un'ottima app può essere nuova, e il numero di recensioni è in ritardo rispetto all'utilizzo reale. Le usiamo perché sono il segnale pubblico e comparabile più chiaro di una base merchant reale su 22.546 app.",
  "Le categorie sull'App Store sono tag di funzionalità che un'app può autoassegnarsi, e molte app ne portano diversi o nessuno. Per la vista per settori raggruppiamo i tag affini in grandi corsie e deduplichiamo le app all'interno di ciascuna; un'app può appartenere a più di uno, quindi i settori si sovrappongono e non sono esclusivi, e li leggiamo come indicativi. Ovunque altrove ci affidiamo ai tagli non ambigui (recensioni, prezzi, data di lancio, paese dello sviluppatore).",
];

const FAQ = [
  {
    question: "Quante app ci sono sullo Shopify App Store?",
    answer:
      "22.546 app attive in questa istantanea di giugno 2026. Lo store è cresciuto di circa 10 volte dal 2020 e ha aggiunto oltre 6.000 app solo negli ultimi 12 mesi, circa 1 su 4 di tutto ciò che è attivo oggi. Lo sviluppo assistito dall'IA ha trasformato quella che una volta era una creazione di sei mesi in un weekend.",
  },
  {
    question: "Perché la maggior parte delle app di Shopify fallisce?",
    answer:
      "Creare non è più il vincolo, quindi lo store si riempie di app che non trovano mai una base merchant. Il 51% non ha nessuna recensione e l'81% ne ha meno di 10. La cosa rara è la distribuzione e la fiducia: rispondere al supporto, guadagnarsi recensioni un merchant alla volta, esserci per anni. È la parte che l'IA non può fare per te.",
  },
  {
    question: "Quanto guadagnano le app di Shopify?",
    answer:
      "I guadagni sono estremamente concentrati. Secondo la nostra stima, l'1% in cima delle app (225 di esse) si prende circa il 72% di tutti i ricavi delle app, e le prime 10 da sole si prendono quasi il 30%. Solo circa il 36% delle app sembra guadagnare qualcosa. I ricavi qui sono stimati a partire dai prezzi pubblici e dai segnali di utilizzo, non da dati di fatturazione.",
  },
  {
    question: "La maggior parte delle app di Shopify sono gratis?",
    answer:
      "Di fatto, sì. Il 46,9% è gratis e un altro 48,6% parte con una prova gratuita; solo il 4,5% fa pagare in anticipo. Quasi il 45% offre un piano gratis permanente. Sullo Shopify App Store un punto d'ingresso gratuito non è una tattica di crescita, è l'aspettativa di base.",
  },
  {
    question: "Dove posso vedere i dati di base?",
    answer:
      "Le cifre provengono da un'istantanea che teniamo di ogni app di Shopify attiva: date di lancio, recensioni, prezzi, il badge Built for Shopify e il paese dello sviluppatore. Se crei su Shopify e vuoi un taglio specifico, contattaci.",
    answerHtml:
      "Le cifre provengono da un'istantanea che teniamo di ogni app di Shopify attiva: date di lancio, recensioni, prezzi, il badge Built for Shopify e il paese dello sviluppatore. Se crei su Shopify e vuoi un taglio specifico, <a href=\"/it/contact/\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">contattaci</a>.",
  },
];

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Home", url: localizedHref("/", "it") },
    { name: title, url: localizedHref(`/${REPORT.slug}/`, "it") },
  ]),
  article({
    title,
    description,
    url: pageUrl,
    image: ogImage,
    datePublished: REPORT.datePublished,
    dateModified: REPORT.dateModified,
    author: "RevenueHunt",
    tags: [
      "Shopify app store",
      "sviluppatori di app per Shopify",
      "statistiche dell'app store",
      "economia delle app",
    ],
  }),
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "Lo stato dell'economia delle app di Shopify 2026",
    description,
    url: pageUrl,
    creator: organization(),
    license: "https://creativecommons.org/licenses/by/4.0/",
    isAccessibleForFree: true,
    datePublished: REPORT.datePublished,
    keywords: [
      "Shopify app store",
      "sviluppatori di app",
      "ricavi delle app",
      "recensioni delle app",
      "ecommerce",
    ],
  },
  faqPage(FAQ),
];

// Section eyebrows for the editorial "field notes" feel.
const E = (n: string, label: string) => `${n} · ${label}`;

// Translated headline cards. Stats stay from the shared data module (HEADLINE[i].stat).
const headlineT = [
  { label: "app attive nello store", note: "Circa 10 volte tanto dal 2020." },
  { label: "non hanno nessuna recensione", note: "Quattro su cinque ne hanno meno di 10." },
  { label: "dei ricavi se lo prende l'1% in cima", note: "225 app. Stimato." },
  { label: "fanno pagare in anticipo", note: "Solo 1 su 20. Quasi la metà sono gratis." },
];

// Growth caption with the lead phrase bolded.
const growthCaptionHtml =
  "App attive cumulate per anno di lancio. <strong>Lo Shopify App Store è cresciuto di circa 10 volte dal 2020</strong> e ha aggiunto oltre 6.000 app solo negli ultimi 12 mesi, circa 1 su 4 di tutto ciò che oggi è attivo.";

// Quiz-lane paragraphs (translated), with the live search link and the load-bearing
// lines bolded inline. Caption text mirrors the English source's meaning.
const quizParas = [
  `La nostra stessa categoria dimostra la stessa cosa. <a href="${QUIZ_LANE.searchUrl}" target="_blank" rel="external noopener nofollow" class="font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]">la ricerca di "quiz" su Shopify</a> restituisce 149 app, ma qui la fiducia si accumula in cima esattamente come in tutto lo store. Le tre app che sono arrivate per prime e non se ne sono mai andate, RevenueHunt, Octane AI e Quiz Kit, concentrano il 45% di tutte le recensioni della categoria; <strong>RevenueHunt da sola ne ha circa un quarto</strong>, e la metà inferiore non ne ha nessuna.`,
  `Non siamo arrivati in cima a forza di codice. <strong>Le recensioni sono il sintomo della fatica operativa</strong> che c'è dietro: sei anni a rispondere al supporto, a metterci al telefono con merchant che non avrebbero mai pagato e a guadagnarci la fiducia negozio per negozio. Octane AI e Quiz Kit hanno fatto lo stesso lavoro duro per anni, <strong>e glielo riconosciamo</strong>. Menzione d'onore per Lantern e Quizell, entrambe con poco più di 120 recensioni.`,
];

// Methodology bullets carry their own inline <strong>; render as-is.
const methodologyHtml = METHODOLOGY;
---

<Base
  title={`${title} - report di dati 2026`}
  description={description}
  ogImage={ogImage}
  jsonLd={jsonLd}
  lang="it"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={localizedHref("/", "it")} class="hover:text-slate-700">Home</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Lo stato dell'economia delle app di Shopify</span>
      </nav>
      <div class="text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">
          Note sul campo · {publishedLabel}
        </p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          Lo stato dell'economia delle app di Shopify
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          <strong>Ci sono 22.546 app attive sullo Shopify App Store, e quasi nessuna arriva da qualche parte.</strong> Abbiamo preso un'istantanea di ogni app attiva e letto i dati su crescita, recensioni, ricavi, prezzi e chi le crea. Raccontano una sola storia: creare l'app non è mai stata la parte difficile.
        </p>
      </div>
    </div>
  </section>

  <!-- Source band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-2xl bg-[#16161D] px-6 py-10 sm:px-10">
        <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#4dcaff]">
          L'istantanea
        </p>
        <dl class="mt-6 grid grid-cols-2 gap-8 text-center sm:grid-cols-4">
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.apps}</dt>
            <dd class="mt-1 text-sm text-white/70">app attive nell'istantanea</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.countries}</dt>
            <dd class="mt-1 text-sm text-white/70">paesi che le creano</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.reviewless}</dt>
            <dd class="mt-1 text-sm text-white/70">senza nessuna recensione</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.free}</dt>
            <dd class="mt-1 text-sm text-white/70">completamente gratis, senza piano a pagamento</dd>
          </div>
        </dl>
        <p class="mx-auto mt-6 max-w-3xl text-center text-sm text-white/60">
          Ogni cifra qui sotto proviene dalla scheda pubblica nell'App Store delle 22.546 app attive, giugno 2026. I ricavi sono stimati a partire dai prezzi pubblicati e dai segnali di utilizzo, non da dati di fatturazione, e sono etichettati come tali in tutto il report.
        </p>
      </div>
    </div>
  </section>

  <!-- Headline cards -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Le cifre principali</h2>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        {HEADLINE.map((c, i) => (
          <div class="rounded-xl border border-slate-200 p-7">
            <p class="text-4xl font-bold tracking-tight text-[#16161D]">{c.stat}</p>
            <p class="mt-2 font-medium text-slate-900">{headlineT[i].label}</p>
            <p class="mt-2 text-sm text-slate-600">{headlineT[i].note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 01 Growth -->
  <section class="scroll-mt-20 bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("01", "Crescita")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Cresciuta di 10 volte dal 2020</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center" set:html={growthCaptionHtml} />
      <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
        <div class="h-72 sm:h-80"><canvas id="c-growth" aria-label="App di Shopify attive cumulate per anno" role="img"></canvas></div>
      </div>
    </div>
  </section>

  <!-- 02 Traction -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("02", "Trazione")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">La maggior parte delle app non ottiene mai una recensione</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">Metà dello Shopify App Store non ha mai guadagnato una sola recensione. Quattro app su cinque ne hanno meno di 10. Una recensione è l'indicatore pubblico più chiaro di un merchant reale e fidelizzato, e la maggior parte delle app non ne ottiene mai nessuna.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-center text-sm font-semibold text-slate-900">App per numero di recensioni</p>
          <div class="h-72 sm:h-80"><canvas id="c-reviews" aria-label="Distribuzione delle recensioni tra tutte le app attive" role="img"></canvas></div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">81%</p>
            <p class="mt-1 text-slate-700">hanno meno di 10 recensioni</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="font-bold text-[#16161D]"><span class="text-3xl">{REVIEWS.medianReviews}</span> <span class="text-sm font-medium text-slate-500">recensioni</span></p>
            <p class="mt-1 text-slate-700">la mediana, tra le app che ne hanno almeno una</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="font-bold text-[#16161D]"><span class="text-amber-400">★</span> <span class="text-3xl">{REVIEWS.avgRating}</span> <span class="text-sm font-medium text-slate-500">stelle</span></p>
            <p class="mt-1 text-slate-700">valutazione media, tra le {REVIEWS.ratedCount} app che ne hanno una</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 Revenue -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("03", "Ricavi · stimato")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Il denaro si concentra in cima</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">I ricavi mensili stimati sono brutalmente concentrati in cima. L'1% in cima delle app (225 di esse) si prende un 72% stimato, e solo 10 di queste app si prendono da sole quasi il 30% di tutti i ricavi delle app. Appena il 36% delle app sembra guadagnare qualcosa. Si concentrano anche geograficamente: <strong>USA e Canada da soli si prendono un 57% stimato</strong> dei ricavi dello Shopify App Store.</p>
      <p class="mx-auto mt-3 max-w-3xl text-sm italic text-slate-500 text-center">Un nome svetta su tutto l'ecosistema: un'app che ricava un 78% stimato del suo fatturato annuo di circa 1 miliardo di dollari dai merchant di Shopify. Sì, dico a te, <a href='https://www.sec.gov/Archives/edgar/data/1835830/000162828023030618/klaviyoincs-1.htm' target='_blank' rel='external noopener nofollow' class='font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]'>Klaviyo</a>.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-center text-sm font-semibold text-slate-900">Distribuzione dei ricavi</p>
          <div class="h-64 sm:h-72"><canvas id="c-revenue-donut" aria-label="Ripartizione dei ricavi stimati: le prime 10 app, il resto del top 1% e l'altro 99%" role="img"></canvas></div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-center text-sm font-semibold text-slate-900">Ricavi stimati per paese</p>
          <div class="h-64 sm:h-72"><canvas id="c-revenue-countries" aria-label="Ricavi stimati per paese" role="img"></canvas></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 Pricing -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("04", "Prezzi")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Quasi nessuno fa pagare in anticipo</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">Quasi metà dello store non fa pagare nulla in anticipo, e meno di 1 app su 20 chiede soldi prima della prima installazione. Quasi il 45% offre un piano gratis permanente. Qui il freemium non è una strategia, è il minimo per entrare.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="text-center text-sm font-semibold text-slate-900">Prezzi d'ingresso su tutte le 22.546 app attive</p>
          <p class="mt-0.5 text-center text-xs text-slate-500">Quattro fasce che si escludono a vicenda, in base a ciò che l'app chiede in anticipo.</p>
          <div class="mt-4 h-72 sm:h-80"><canvas id="c-pricing" aria-label="Ripartizione del modello di prezzo tra tutte le app attive, per fascia d'ingresso" role="img"></canvas></div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">{PRICING.permanentFree}</p>
            <p class="mt-1 text-slate-700">offrono un piano gratis permanente, non solo una prova</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">{PRICING.completelyFree}</p>
            <p class="mt-1 text-slate-700">sono completamente gratis, senza alcun piano a pagamento</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">1 su 20</p>
            <p class="mt-1 text-slate-700">app fanno pagare soldi all'installazione</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 Who builds them -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("05", "Chi le crea")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Segnale contro rumore</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">Due dominano: <strong>USA (24%) e India (15%) creano insieme due app su cinque</strong> dello store. Ma <strong>il volume non è trazione</strong>. Se ordini i paesi solo per le app che hanno superato le 10+ recensioni, la classifica si ridisegna - il <strong>Vietnam</strong>, uno sviluppatore di medie dimensioni, piazza più app con trazione reale di quanto la sua dimensione suggerisca, mentre <strong>Giappone e Cina scivolano in basso</strong>.</p>
      <div class="mt-8 grid gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="text-center text-sm font-semibold text-slate-900">Tutte le app, per fascia di recensioni</p>
          <p class="mt-0.5 text-center text-xs text-slate-500">Top 10 sviluppatori per numero di app. Clicca una fascia per mostrarla o nasconderla - nascondi le fasce 0 e 1–9 e la classifica si riordina per trazione: Vietnam, Israele e Singapore salgono.</p>
          <div class="mt-4 h-80 sm:h-96"><canvas id="c-geography" aria-label="Principali paesi degli sviluppatori per numero di app, suddivisi per fascia di recensioni" role="img"></canvas></div>
        </div>
        <div class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
          <div class="flex flex-col justify-center rounded-2xl border border-slate-200 bg-white p-6">
            <p class="text-3xl font-bold text-[#16161D]">{GEOGRAPHY.builtForShopify}</p>
            <p class="mt-1 text-sm text-slate-700">portano il badge Built for Shopify ({GEOGRAPHY.builtForShopifyCount} app), anni dopo che Shopify ha iniziato a spingere lo standard</p>
          </div>
          <div class="flex flex-col justify-center rounded-2xl border border-slate-200 bg-white p-6">
            <p class="text-3xl font-bold text-[#16161D]">{GEOGRAPHY.usIndiaShare}</p>
            <p class="mt-1 text-sm text-slate-700">di tutto lo store viene creato solo da USA e India</p>
          </div>
          <div class="flex flex-col justify-center rounded-2xl border border-slate-200 bg-white p-6">
            <p class="text-3xl font-bold text-[#16161D]">{GEOGRAPHY.vietnamSignal}</p>
            <p class="mt-1 text-sm text-slate-700">delle app del Vietnam superano le 10+ recensioni - il miglior tasso di segnale tra i grandi sviluppatori, circa il doppio di USA o India</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 Sectors -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("06", "Settori")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Affollato non è vincibile</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">Le corsie più affollate dello store sono le sue scommesse peggiori. Gli sviluppatori si riversano su spedizioni e chat, utility banali, e quasi nessuno ottiene una recensione: <strong>quasi 6 app di logistica di terzi su 10 non ne ricevono nemmeno una</strong>. Le app che sfondano si concentrano dove il lavoro si accumula - <strong>localizzazione, prezzi e personalizzazione a livello di codice</strong>, gli strumenti che diventano irrinunciabili una volta che un merchant li installa.</p>
      <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
        <p class="text-center text-sm font-semibold text-slate-900">Tutti i settori, per fascia di recensioni</p>
        <p class="mt-0.5 text-center text-xs text-slate-500">Le app di ogni settore, divise per fascia di recensioni e ordinate dalla più grande alla più piccola.</p>
        <div class="mt-4 h-[26rem] sm:h-[30rem]"><canvas id="c-niches" aria-label="Settori di app Shopify divisi per fascia di recensioni, ordinati per la quota che supera le 10 recensioni" role="img"></canvas></div>
        <p class="mt-3 text-center text-xs text-slate-400">I settori raggruppano tag di funzionalità autoassegnati, deduplicati per app. Un'app può stare in più settori, quindi questi si sovrappongono e non sono esclusivi - leggili come grandi corsie, non come dimensioni di mercato precise.</p>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        <div class="flex flex-col justify-center rounded-2xl border border-slate-200 bg-white p-6">
          <p class="text-3xl font-bold text-[#16161D]">{NICHES.deadNicheZero}</p>
          <p class="mt-1 text-sm text-slate-700">delle app di logistica di terzi non ricevono mai una recensione - la nicchia affollata più morta dello store</p>
        </div>
        <div class="flex flex-col justify-center rounded-2xl border border-slate-200 bg-white p-6">
          <p class="text-3xl font-bold text-[#16161D]">{NICHES.bestNicheTraction}</p>
          <p class="mt-1 text-sm text-slate-700">delle app di localizzazione superano le 10 recensioni - le migliori probabilità di qualsiasi settore importante</p>
        </div>
        <div class="flex flex-col justify-center rounded-2xl border border-slate-200 bg-white p-6">
          <p class="text-3xl font-bold text-[#16161D]">{NICHES.topSectorApps}</p>
          <p class="mt-1 text-sm text-slate-700">app si accalcano in spedizioni e logistica, il settore più popolato - eppure solo il 28% ottiene trazione</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 07 The quiz lane -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("07", "La corsia dei quiz")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">La nostra categoria, da vicino</h2>
      {quizParas.map((html) => (
        <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center" set:html={html} />
