---
import Base from "../../layouts/Base.astro";
import { organization, breadcrumb } from "../../lib/schema";
import { SITE } from "../../lib/site";

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Home", url: "/" },
    { name: "Message sent", url: "/message-sent/" },
  ]),
];
---

<Base
  title="Message sent - RevenueHunt"
  description="Thanks for reaching out. We'll get back to you within 2–3 hours on business days."
  noindex={true}
  jsonLd={jsonLd}
>
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-3xl px-6 py-20 text-center sm:py-24">
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100">
        <svg class="h-8 w-8 text-emerald-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7 7a1 1 0 01-1.4 0l-4-4a1 1 0 011.4-1.4l3.3 3.3 6.3-6.3a1 1 0 011.4 0z" clip-rule="evenodd"/>
        </svg>
      </div>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">Thanks for your message!</h1>
      <p class="mt-6 text-lg text-slate-700">
        We'll get back to you in about <strong class="text-slate-900">2–3 hours</strong>, between 9am and 7:30pm GMT, Monday through Friday.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 pb-20">
    <div class="grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-slate-200 bg-white p-6">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500">In the meantime</h2>
        <p class="mt-3 text-slate-700">
          Check our help guides for step-by-step instructions on setting up a quiz, installing integrations, and customizing the design.
        </p>
        <a
          href="https://docs.revenuehunt.com/"
          target="_blank"
          rel="external noopener"
          class="mt-4 inline-flex items-center text-sm font-semibold text-slate-900 underline underline-offset-4 hover:text-slate-700"
        >
          Open the help center ↗
        </a>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-6">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500">Email us directly</h2>
        <p class="mt-3 text-slate-700">For support & sales inquiries:</p>
        <a href="mailto:team@revenuehunt.com" class="mt-1 inline-flex text-base font-semibold text-slate-900 underline underline-offset-4 hover:text-slate-700">team@revenuehunt.com</a>
        <p class="mt-4 text-sm text-slate-500">
          Or visit us at:<br />
          StartHub Miami<br />
          66 W Flagler St #900<br />
          Miami, FL 33130 · United States
        </p>
      </div>
    </div>
    <div class="mt-10 text-center">
      <a
        href="/"
        class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
      >
        Back to home
      </a>
    </div>
  </section>
</Base>
