---
import Base from "../../layouts/Base.astro";
import { organization, breadcrumb } from "../../lib/schema";

const QUIZ_URL = "https://admin.revenuehunt.com/public/quiz/xVHLQz";

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Home", url: "/" },
    { name: "Newsletter", url: "/newsletter/" },
  ]),
];
---

<Base
  title="Newsletter — RevenueHunt"
  description="Get RevenueHunt tips on product recommendation quizzes, ecommerce conversion, and zero-party data — straight to your inbox. No spam, easy unsubscribe."
  jsonLd={jsonLd}
>
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-3xl px-6 py-16 text-center sm:py-20">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-slate-700">Home</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Newsletter</span>
      </nav>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
        Smarter quiz funnels — every other Tuesday.
      </h1>
      <p class="mt-6 text-lg text-slate-700">
        Practical, actionable tips on product recommendation quizzes, zero-party data, and ecommerce conversion. No fluff, no spam, easy to unsubscribe.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-2xl px-6 pb-20">
    <div class="rounded-2xl border border-slate-200 bg-white p-2 shadow-lg">
      <iframe
        src={QUIZ_URL}
        title="Newsletter signup"
        loading="lazy"
        class="h-[640px] w-full rounded-xl"
      ></iframe>
    </div>
  </section>
</Base>
