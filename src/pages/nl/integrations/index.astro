---
import Base from "../../../layouts/Base.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import { organization, breadcrumb, softwareApplication } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

interface Integration {
  name: string;
  category: string;
  logo: string;
  href: string;
}

const groups: { heading: string; emoji: string; intro: string; items: Integration[] }[] = [
  {
    heading: "Analytics en tracking",
    emoji: "📊",
    intro:
      "Meet de quizprestaties, volg conversies en optimaliseer je funnel. Ontdek precies welke vragen verkoop genereren en waar klanten afhaken.",
    items: [
      { name: "Google Analytics", category: "Data", logo: "/img/pages/integrations/ganalytics.webp", href: "https://docs.revenuehunt.com/how-to-guides/integrate-google-analytics/" },
      { name: "Meta Pixel", category: "Data", logo: "/img/pages/integrations/metapixel.webp", href: "https://docs.revenuehunt.com/how-to-guides/integrate-meta-pixel/" },
      { name: "TikTok Pixel", category: "Data", logo: "/img/pages/integrations/tiktoklog.webp", href: "https://docs.revenuehunt.com/how-to-guides/integrate-tiktok-pixel/" },
      { name: "Webhooks", category: "Data", logo: "/img/pages/integrations/webhooklog.webp", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-webhooks/" },
      { name: "Google Product Feed", category: "Producten", logo: "/img/pages/integrations/googleproductfeed.webp", href: "/product-recommendation-quiz-standalone-google-product-feed/" },
    ],
  },
  {
    heading: "Marketing en automatisering",
    emoji: "✉️",
    intro:
      "Synchroniseer quizleads met je e-mailplatform of CRM. Stuur gepersonaliseerde follow-ups, segmenteer klanten op hun antwoorden en zet leads automatisch om in trouwe kopers.",
    items: [
      { name: "Klaviyo", category: "E-mailmarketing", logo: "/img/pages/integrations/klaviyolog.webp", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-klaviyo/" },
      { name: "ActiveCampaign", category: "Automatisering", logo: "/img/pages/integrations/activecampaignlog.webp", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-activecampaign/" },
      { name: "Mailchimp", category: "E-mailmarketing", logo: "/img/pages/integrations/mailchimplog.webp", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-mailchimp/" },
      { name: "Omnisend", category: "E-mailmarketing", logo: "/img/pages/integrations/omnisendlog.webp", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-omnisend/" },
      { name: "Zapier", category: "Automatisering", logo: "/img/pages/integrations/zapierlog.webp", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-zapier/" },
      { name: "HubSpot", category: "CRM", logo: "/img/pages/integrations/hubspotlog.webp", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-hubspot/" },
      { name: "Shopify Customers", category: "CRM", logo: "/img/pages/integrations/shopifylog.webp", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-shopify-customers/" },
    ],
  },
  {
    heading: "Verkoop en social proof",
    emoji: "⭐",
    intro:
      "Tag klanten in Shopify, beveel abonnementen aan en toon reviews, allemaal op basis van de quizantwoorden, zodat elke koper precies het bewijs en het aanbod ziet dat voor hem telt.",
    items: [
      { name: "ReCharge", category: "Abonnementen", logo: "/img/pages/integrations/rechargelog.webp", href: "https://docs.revenuehunt.com/how-to-guides/recommend-subscriptions/" },
      { name: "Shopify Reviews", category: "Social proof", logo: "/img/pages/integrations/shopifyreviews.webp", href: "https://docs.revenuehunt.com/how-to-guides/show-product-reviews/" },
      { name: "Stamped", category: "Social proof", logo: "/img/pages/integrations/stampedlog.webp", href: "https://docs.revenuehunt.com/how-to-guides/show-product-reviews/" },
      { name: "Judge.me", category: "Social proof", logo: "/img/pages/integrations/judgemelog.webp", href: "https://docs.revenuehunt.com/how-to-guides/show-product-reviews/" },
      { name: "Rivyo Reviews", category: "Social proof", logo: "/img/pages/integrations/rivyolog.webp", href: "https://docs.revenuehunt.com/how-to-guides/show-product-reviews/" },
      { name: "POS Tablet Stands", category: "Verkoop in de winkel", logo: "/img/pages/integrations/poslog.webp", href: "/product-recommendation-quiz-pos-tablet-stands/" },
      { name: "Shop App", category: "Verkoop op mobiel", logo: "/img/pages/integrations/shopapplog.webp", href: "https://docs.revenuehunt.com/how-to-guides/show-quiz-in-shop-app/" },
    ],
  },
];

const pillars = [
  {
    emoji: "📊",
    title: "Meet alles",
    body: "Verbind met Google Analytics, Meta Pixel en TikTok om de quizprestaties te meten en je campagnes te optimaliseren.",
  },
  {
    emoji: "✉️",
    title: "Automatiseer follow-ups",
    body: "Synchroniseer quizleads met Klaviyo, Mailchimp of ActiveCampaign om automatisch gepersonaliseerde productaanbevelingen te versturen.",
  },
  {
    emoji: "💰",
    title: "Verhoog je omzet",
    body: "Tag klanten in Shopify, beveel abonnementen aan met ReCharge en toon social proof met review-apps.",
  },
];

const stats = [
  { value: "20+", label: "Native integraties" },
  { value: "5 min", label: "Gemiddelde installatietijd" },
  { value: "Nul", label: "Code nodig" },
];

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=integrations";
const WOOCOMMERCE_DOWNLOAD =
  "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";

const jsonLd = [
  organization(),
  softwareApplication(),
  breadcrumb([
    { name: "Home", url: "/" },
    { name: "Integraties", url: "/integrations/" },
  ]),
];

function isExternal(href: string) {
  return /^https?:\/\//.test(href);
}
---

<Base
  title="Integraties - RevenueHunt"
  description="Verbind je RevenueHunt-quiz met Klaviyo, Meta Pixel, Mailchimp, Omnisend, GA4 en meer. Synchroniseer leads en antwoorden in 5 minuten, zonder code."
  jsonLd={jsonLd}
  lang="nl"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
      <Breadcrumb items={[{ label: "Home", href: localizedHref("/", "nl") }, { label: "Integraties" }]} />
      <Eyebrow>Integraties</Eyebrow>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Wrijvingsloze integraties die de resultaten van je quiz versterken
      </h1>
      <p class="mt-6 max-w-3xl text-xl text-slate-600">
        Zet quizantwoorden om in omzet met krachtige integraties. Verbind RevenueHunt met je huidige marketingstack om follow-ups te automatiseren, campagnes te personaliseren, prestaties te meten en meer kijkers om te zetten in kopers. <strong class="text-slate-900">Geen code nodig.</strong>
      </p>
    </div>
  </section>

  <!-- 3-up pillars -->
  <section class="border-y border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="grid gap-10 md:grid-cols-3">
        {pillars.map((p) => (
          <div>
            <div class="flex items-center gap-3">
              <span class="text-3xl" aria-hidden="true">{p.emoji}</span>
              <h2 class="text-xl font-semibold text-slate-900">{p.title}</h2>
            </div>
            <p class="mt-3 text-slate-600">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats bar -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-5xl px-6 py-14">
      <dl class="grid grid-cols-3 gap-x-8 gap-y-8">
        {stats.map((s) => (
          <div class="text-center">
            <dt class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{s.value}</dt>
            <dd class="mt-2 text-sm text-white/70">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Integration library -->
  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Ontdek onze integratiebibliotheek</h2>
      <p class="mx-auto mt-4 max-w-2xl text-slate-600">
        Klik op een integratie om de installatiegids ervan in ons helpcentrum te bekijken.
      </p>
    </div>

    {groups.map((g) => (
      <div class="mt-16">
        <div class="mb-6 flex items-baseline gap-3">
          <span class="text-2xl" aria-hidden="true">{g.emoji}</span>
          <h3 class="text-2xl font-semibold tracking-tight text-slate-900">{g.heading}</h3>
        </div>
        <p class="max-w-3xl text-slate-600">{g.intro}</p>

        <ul class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
          {g.items.map((it) => (
            <li>
              <a
                href={it.href}
                {...(isExternal(it.href) ? { target: "_blank", rel: "external noopener" } : {})}
                class="flex h-full flex-col items-center gap-3 rounded-xl border border-slate-200 bg-white p-5 text-center transition hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md"
              >
                <img
                  src={it.logo}
                  alt={`Logo van ${it.name}`}
                  width="80"
                  height="80"
                  loading="lazy"
                  class="h-14 w-14 object-contain"
                />
                <div>
                  <p class="text-base font-semibold text-slate-900">{it.name}</p>
                  <p class="mt-1 text-xs uppercase tracking-wider text-slate-500">{it.category}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Klaar om je quiz te verbinden met je marketingstack?
      </h2>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SHOPIFY_INSTALL}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          installeren op Shopify
        </a>
        <a
          href={WOOCOMMERCE_DOWNLOAD}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          downloaden voor WooCommerce
        </a>
      </div>
    </div>
  </section>
</Base>
