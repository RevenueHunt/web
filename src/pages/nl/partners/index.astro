---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

interface Partner {
  name: string;
  url: string;
  logo: string;
  description: string;
}

const groups: { heading: string; emoji: string; intro: string; items: Partner[] }[] = [
  {
    heading: "Lokalisatie",
    emoji: "🌍",
    intro: "Verkoop internationaal met ingebouwde geolocatie, vertaling en meerdere valuta's.",
    items: [
      { name: "Orbe Shopify Geolocation", url: "https://orbe.app/", logo: "/img/pages/partners/orbe-removebg-preview.webp", description: "Maximaliseer wereldwijde verkoop met geavanceerde Shopify-geolocatie. Personaliseer producten, prijzen, valuta en content voor elk land en begeleid klanten naar de juiste shopervaring met Orbe." },
      { name: "Langwill: Language Translate", url: "https://apps.shopify.com/localiser", logo: "/img/pages/partners/1.webp", description: "Vergroot je wereldwijde bereik met Langwill: vertaal je Shopify-winkel naar 138 talen en converteer valuta automatisch voor een soepele, gelokaliseerde shopervaring." },
    ],
  },
  {
    heading: "Chat en support",
    emoji: "💬",
    intro: "Klantaccount-tools die selfservice en support moeiteloos maken.",
    items: [
      { name: "Customer Dashboard Pro", url: "https://apps.shopify.com/customer-dashboard-pro?utm_source=revenuehunt", logo: "/img/pages/partners/CustomerDashboard.webp", description: "Customer Dashboard Pro is de enige app die naadloze ondersteuning biedt voor zowel de nieuwe Customer Accounts van Shopify als de Classic Customer Accounts." },
    ],
  },
  {
    heading: "Upsell en aanbevelingen",
    emoji: "🎯",
    intro: "Verhoog de gemiddelde orderwaarde met cart-upsells, verlanglijsten en pre-orders.",
    items: [
      { name: "WC Wishlist Club", url: "https://apps.shopify.com/wishlist-club?utm_source=revenuehunt&utm_medium=website&utm_campaign=partnership", logo: "/img/pages/partners/wishlist-club-150-150-px-logo.webp", description: "Met WC Wishlist Club kunnen je klanten hun favoriete producten opslaan, verlanglijstjes delen en later kopen, wat de betrokkenheid en verkoop verhoogt. Eenvoudig in te stellen, geoptimaliseerd voor mobiel en perfect om kijkers om te zetten in trouwe kopers." },
      { name: "iCart Cart Drawer Cart Upsell", url: "https://apps.shopify.com/icart/?campaign=promotion&medium=in-app-banner&source=revenuehunt", logo: "/img/pages/partners/iCart-Cart-Drawer-Cart-Upsell-logo.webp", description: "Complete Shopify-app om een cart drawer en de volledige winkelwagenpagina aan te passen met upsell, productaanbevelingen, voortgangsbalk, productbundels en kortingen." },
      { name: "PreOrder Now WOD", url: "https://apps.shopify.com/preorder-now?utm_source=+revenuehunt&utm_medium=web&utm_campaign=partner&utm_id=crosspromo", logo: "/img/pages/partners/PreOrder-Now-Logo.webp", description: "Zet uitverkochte situaties om in pre-orderkansen. Perfect voor print-on-demandbedrijven: vang de interesse van klanten op zonder beginvoorraad." },
    ],
  },
  {
    heading: "Prijzen en kortingen",
    emoji: "🏷️",
    intro: "Bundels, volumekortingen en B2B-prijzen die grotere winkelwagens belonen.",
    items: [
      { name: "Kaching Bundle Quantity Deals", url: "https://apps.shopify.com/bundle-deals?utm_source=partnership&utm_medium=web&utm_campaign=REVENUEH", logo: "/img/pages/partners/Kaching-Logo-1024x1024.webp", description: "Stimuleer de verkoop met Kaching Bundle Quantity Deals: maak bundelaanbiedingen rechtstreeks op je productpagina. Gebruik code REVENUEH20 voor een exclusieve korting van 20%." },
      { name: "BSS: B2B/Wholesale Solution", url: "https://apps.shopify.com/b2b-solution-custom-pricing?utm_source=RevenueHunt&utm_medium=partner-listing&utm_campaign=partnership-2024", logo: "/img/pages/partners/BSS-Commerce_logo_150.webp", description: "Complete groothandeloplossing. Een soepele B2B-shopervaring die merchants bovendien helpt hun groothandelsklanten te beheren en er inzicht in te krijgen." },
    ],
  },
  {
    heading: "Marketing en pop-ups",
    emoji: "📣",
    intro: "Social proof, affiliate-programma's en on-site campagnes die de verkoop stimuleren.",
    items: [
      { name: "ToastiBar – Sales Popup", url: "https://makeprosimp.com/partnership/revenuehunt", logo: "/img/pages/partners/toastibarlogo_fgaiv9.webp", description: "Vergroot het vertrouwen van klanten en stimuleer de verkoop door realtime social proof te tonen: verkopen, winkelwagen, bezoekers, productreviews en voorraadmeldingen." },
      { name: "UpPromote: Affiliate & Referral", url: "https://partners.secomapp.com/apps/affiliate/SHOPQUIZ_APP", logo: "/img/pages/partners/NEW_logo-1.webp", description: "UpPromote is de meest aanbevolen affiliate-/referral-app in de Shopify App Store. Een complete oplossing om je marketingcampagnes op te zetten en te beheren, geschikt voor bedrijven van elke omvang." },
    ],
  },
  {
    heading: "Verzending en fulfilment",
    emoji: "📦",
    intro: "Sourcing, logistiek en gratis-verzendprikkels om sneller te verzenden en op te schalen.",
    items: [
      { name: "Essential Free Shipping Bar", url: "https://apps.shopify.com/essential-order-value-booster", logo: "/img/pages/partners/freeshippingbarlogo.webp", description: "Verhoog verkoop en AOV door onbeperkte gratis-verzendbalken in te stellen met meerdere winkelwagenwaarde-doelen om shoppers te motiveren meer producten toe te voegen." },
      { name: "HyperSKU", url: "https://apps.shopify.com/hypersku", logo: "/img/pages/partners/150150-logo.webp", description: "HyperSKU biedt een complete supply-chainoplossing. Meer dan 1 miljoen producten, bundelverkoop, sampling, kwaliteitsinspectie, merkpersonalisatie en geautomatiseerde orderfulfillment." },
    ],
  },
  {
    heading: "Analyse en rapportage",
    emoji: "📊",
    intro: "SEO-inzichten en orderdata om te meten wat werkt en erover te rapporteren.",
    items: [
      { name: "PDF Invoice Generator", url: "https://apps.shopify.com/fordeer-invoice-order-printer?utm_source=ShopQuizProductRecommender&utm_medium=comarketing&utm_campaign=partner", logo: "/img/pages/partners/fordeer-data-export-1024x1024.webp", description: "De Shopify-factuurgenerator van Fordeer is flexibel, voldoet aan wereldwijde regelgeving en bedient B2C, B2B en groothandel. Aanpasbare PDF-sjablonen, batchprinten en 24/7 live chat-support." },
      { name: "AI SEO Optimizer", url: "https://share.seoant.com/app/1165b75b7ce1524D5J", logo: "/img/pages/partners/SEOAnt-_-AI-SEO-Optimizer_Channelwill-.webp", description: "De beste SEO-app voor Shopify: optimaliseer keywords, verbeter meta tags en verfijn je sitestructuur. AI-gedreven SEO-prestatie- en snelheidsanalyse." },
    ],
  },
  {
    heading: "Winkelontwerp en thema's",
    emoji: "🎨",
    intro: "Premium Shopify-thema's gebouwd om te converteren en je winkel te laten stralen.",
    items: [
      { name: "eComX", url: "https://ecomx.co/", logo: "/img/pages/partners/ecomx-logo.webp", description: "eComX bouwt premium Shopify-thema's die zijn gemaakt om te converteren. Kies uit 16+ niche-specifieke designs, geoptimaliseerd met echte conversiedata en gebouwd voor snelheid, om meer bezoekers in kopers te veranderen." },
    ],
  },
];

const perks = [
  { title: "Referral-commissies", body: "Breng nieuwe klanten aan voor RevenueHunt en ontvang een levenslange commissie van 20% op alle omzet die ze genereren." },
  { title: "Affiliate-links", body: "Voeg je affiliate-links toe aan je artikelen, nieuwsbrieven en social-mediaposts. Link rechtstreeks naar onze apps voor Shopify, WooCommerce, BigCommerce, Magento en standalone." },
  { title: "Je eigen partner manager", body: "Krijg advies over hoe je geautomatiseerde verkoopfunnels bouwt met onze tool en tips om onze oplossing aan je klanten te verkopen." },
  { title: "Exclusieve content", body: "Neem contact met ons op voor advies over hoe je geautomatiseerde verkoopfunnels voor je klanten bouwt met RevenueHunt en andere tools." },
  { title: "Een plek in onze Partner Directory", body: "Onze gebruikers vinden je in onze Partner Directory en nemen contact met je op om je diensten in te schakelen." },
];

const faqs = [
  { q: "Hoeveel kost het om partner te worden?", a: "Aanmelden is volledig gratis. Nul. Niks." },
  { q: "Moet ik klant van RevenueHunt zijn?", a: "Nee, je hoeft geen klant van RevenueHunt te zijn om partner te worden." },
  { q: "Hoe word ik betaald?", a: "We betalen de verdiensten maandelijks uit. Betalingen worden via PayPal verzonden." },
  { q: "Hoe kan ik mijn referrals volgen?", a: "Je kunt je statistieken bekijken in je <a href='https://admin.revenuehunt.com/' target='_blank' rel='external noopener' class='font-semibold text-[#16161D] underline'>Partner Dashboard</a>." },
];

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Home", url: "/" },
    { name: "Partners en affiliates", url: "/partners/" },
  ]),
];
---

<Base
  title="Partnerprogramma - RevenueHunt"
  description="Verwijs je klanten door. Verdien geld. Ontvang een levenslange commissie van 20% op de klanten die je doorverwijst naar RevenueHunt. Meld je gratis aan voor ons Partnerprogramma."
  jsonLd={jsonLd}
  lang="nl"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20 text-center">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={localizedHref("/", "nl")} class="hover:text-slate-700">Home</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Partners en affiliates</span>
      </nav>
      <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">Partnerprogramma</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Verwijs je klanten door. Verdien geld.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-xl text-slate-600">
        Verdien een levenslange commissie van 20% op de klanten die je naar ons doorverwijst. Meld je vandaag gratis aan voor ons Partnerprogramma.
      </p>
      <p class="mx-auto mt-6 max-w-3xl text-slate-600">
        Ben je een <strong class="font-semibold text-slate-900">digital-marketingbureau</strong> of een
        <strong class="font-semibold text-slate-900">ecommerce-specialist</strong> en wil je je bedrijf laten groeien?
        Dan is ons Partnerprogramma iets voor jou. Creëer geweldige ervaringen voor je klanten met RevenueHunt.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
        >
          Begin nu
        </a>
        <a
          href="#partners"
          class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
        >
          Bekijk onze partners
        </a>
      </div>
    </div>
  </section>

  <!-- Who you are + perks -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-1">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Wie je bent</h2>
        <p class="mt-4 text-slate-600">
          Je bent een digital-marketingbureau of een ecommerce-consultant met een passie voor design en geobsedeerd door
          <strong class="font-semibold text-slate-900">de beste resultaten behalen</strong> voor je klanten. Je laat je
          bedrijf groeien door dat van anderen vooruit te helpen.
        </p>
      </div>
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Wat je van ons krijgt</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {perks.map((p) => (
            <li class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="text-base font-semibold text-slate-900">{p.title}</h3>
              <p class="mt-2 text-sm text-slate-600">{p.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Partner directory -->
  <section id="partners" class="mx-auto max-w-7xl px-6 py-16 scroll-mt-24">
    <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Onze partners</h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
      Vertrouwde apps en bureaus die perfect samengaan met RevenueHunt voor je klanten.
    </p>
    <div class="mt-12 space-y-16">
      {groups.map((g) => (
        <div>
          <div class="mb-2 flex items-baseline gap-3">
            <span class="text-2xl" aria-hidden="true">{g.emoji}</span>
            <h3 class="text-2xl font-semibold tracking-tight text-slate-900">{g.heading}</h3>
          </div>
          <p class="max-w-3xl text-slate-600">{g.intro}</p>
          <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {g.items.map((p) => (
        <li>
          <a
            href={p.url}
            target="_blank"
            rel="external noopener nofollow"
            class="group flex h-full flex-col items-center rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm transition hover:border-slate-300 hover:shadow-md"
          >
            <img
              src={p.logo}
              alt={`Logo van ${p.name}`}
              loading="lazy"
              width="120"
              height="120"
              class="h-24 w-24 rounded-lg object-cover"
            />
            <h3 class="mt-5 text-lg font-semibold text-slate-900 group-hover:text-[#16161D]">{p.name}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{p.description}</p>
            <span class="mt-5 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wider text-slate-500 group-hover:text-[#16161D]">
              Bezoek site <span aria-hidden="true">↗</span>
            </span>
          </a>
        </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Veelgestelde vragen</h2>
      <div class="mx-auto mt-8 max-w-2xl">
        {faqs.map((f) => (
          <details class="border-b border-slate-200">
            <summary class="py-4 text-base font-semibold text-slate-900">{f.q}</summary>
            <p class="pb-4 text-slate-600" set:html={f.a}></p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Word partner van RevenueHunt
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        Verwijs je klanten door, bouw geautomatiseerde verkoopfunnels en verdien een levenslange commissie van 20% op alles wat ze uitgeven.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          Begin nu
        </a>
        <a
          href={localizedHref("/demo/", "nl")}
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          Boek een demo
        </a>
      </div>
    </div>
  </section>
</Base>
