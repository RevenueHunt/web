---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb, softwareApplication, faqPage } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=roi_calculator";
// Free WordPress.org plugin (not the WooCommerce.com extension).
const WOO_PLUGIN = "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";

// Inputs. The quiz-taker conversion rate carries a benchmark flag (RevenueHunt
// data badge + helper note) and is editable. The AOV uplift is NOT a visible
// input: it is set by the sector dropdown (hidden #aovlift field) from the
// within-store paired result (median +11% to +15%, concentrated in skincare/
// beauty/supplements, flat in a few categories) and folded into the math.
// Everything else is the merchant's own number.
// (Data: PRD-Octane-AI-SEO-Reverse-Engineering W7 deep-dive note.)
const controls = [
  { id: "visitors", label: "Maandelijkse winkelbezoekers", min: 500, max: 500000, step: 500, value: 10000, suffix: "" },
  { id: "engage", label: "Percentage bezoekers dat de quiz maakt", min: 1, max: 100, step: 1, value: 20, suffix: "%" },
  { id: "aov", label: "Je gemiddelde orderwaarde", min: 10, max: 1000, step: 5, value: 60, suffix: "$" },
  { id: "cvr", label: "Je huidige conversiepercentage", min: 0.1, max: 15, step: 0.1, value: 2, suffix: "%" },
  { id: "quizcvr", label: "Conversiepercentage van wie de quiz maakt", min: 1, max: 50, step: 0.5, value: 5.5, suffix: "%", benchmark: true, note: "Vooraf ingevuld met onze gemeten benchmark: gemiddeld plaatst 1 op de 18 mensen die de quiz maken een bestelling. Pas het aan zodat het bij je winkel past." },
];

// Sector presets for the "what do you sell?" selector. Each sets the quiz-taker
// conversion rate and AOV uplift from measured RevenueHunt data, plus a "% of the
// average store" figure (quiz rate / a 2% average). "All sectors" is the 5.5%
// platform average (= 275%, the brand stat). "Other sectors" is the honest
// residual (everything except the consumable stars), measured at ~3.6% (~180%).
// Selecting a sector pre-fills quizcvr + aovlift; both stay editable.
// (Data: PRD-Octane-AI-SEO-Reverse-Engineering W7 deep-dive note.)
const SECTORS = [
  { id: "all", label: "Alle sectoren (gemiddelde)", quizcvr: 5.5, aovlift: 10, pct: 275 },
  { id: "haircare", label: "Haarverzorging", quizcvr: 7, aovlift: 15, pct: 350 },
  { id: "fragrance", label: "Geuren", quizcvr: 7, aovlift: 0, pct: 350 },
  { id: "beauty", label: "Beauty en huidverzorging", quizcvr: 6, aovlift: 20, pct: 300 },
  { id: "supplements", label: "Supplementen en gezondheid", quizcvr: 6, aovlift: 10, pct: 300 },
  { id: "coffee", label: "Koffie en thee", quizcvr: 5, aovlift: 0, pct: 250 },
  { id: "other", label: "Andere sectoren", quizcvr: 3.6, aovlift: 10, pct: 180 },
];

// Per-vertical conversion (response to order), measured in RevenueHunt data and
// rounded down. The 5.5% benchmark is a platform average; consumable categories
// run higher. Shown as a "conversion by category" proof block.
const BY_VERTICAL = [
  { v: "Haarverzorging", pct: "350%", lift: "+15% AOV" },
  { v: "Geuren", pct: "350%", lift: "AOV ongewijzigd" },
  { v: "Huidverzorging en beauty", pct: "300%", lift: "+20% AOV" },
  { v: "Supplementen", pct: "300%", lift: "+10% AOV" },
  { v: "Koffie en thee", pct: "250%", lift: "AOV ongewijzigd" },
  { v: "Andere sectoren", pct: "180%", lift: "+10% AOV" },
];

// Real, data-backed proof points shown on the page. The 275% is the measured
// 5.5% quiz-taker conversion (1 in 18) expressed against a typical 2% store
// rate: 5.5 / 2 = 2.75x = 275% of baseline (accurate as "of", not "+lift").
const PROOF = [
  { stat: "45M+", label: "geanalyseerde quizantwoorden" },
  { stat: "275%", label: "van het gemiddelde conversiepercentage" },
  { stat: "$370M+", label: "aan gegenereerde omzet voor merchants" },
  { stat: "20.000+", label: "merken gebruiken RevenueHunt" },
];

const faqs: { question: string; answer: string; answerHtml?: string }[] = [
  {
    question: "Waar komt het conversiepercentage van de quiz vandaan?",
    answer:
      "Het is een benchmark op basis van echte RevenueHunt-data. In de set quizantwoorden plaatst 5,5% van de shoppers die een quiz voltooien (ongeveer 1 op de 18) uiteindelijk een gemeten bestelling. Het veld is vooraf ingevuld met die benchmark en je kunt het aanpassen zodat het bij je eigen winkel past.",
  },
  {
    question: "Hoe wordt de extra omzet berekend?",
    answer:
      "De calculator neemt het percentage van je bezoekers dat de quiz voltooit, past daar het conversiepercentage van wie de quiz maakt op toe en vergelijkt het met de conversie die diezelfde bezoekers zouden halen tegen je huidige sitepercentage. Het verschil, vermenigvuldigd met je gemiddelde orderwaarde, is de geschatte extra omzet.",
  },
  {
    question: "Geven shoppers die de quiz maken meer uit per bestelling?",
    answer:
      "Gemiddeld wel, vergelijkbaar met vergelijkbaar. Binnen dezelfde winkel zijn bestellingen die via een quiz binnenkwamen ongeveer 10% hoger dan bestellingen zonder. Het is niet overal gelijk: sterker in categorieën als huidverzorging, beauty en supplementen, en bijna ongewijzigd in andere. De calculator houdt daar automatisch rekening mee op basis van de sector die je kiest.",
  },
  {
    question: "Is dit gebaseerd op echte data of op verzonnen vermenigvuldigers?",
    answer:
      "Echte data. De conversiebenchmark van de quiz is gemeten over meer dan 45 miljoen quizantwoorden en meer dan 370 miljoen dollar aan gegenereerde omzet voor merchants. Je bezoekers, je gemiddelde orderwaarde en je huidige conversiepercentage zijn je eigen cijfers. Het resultaat is een schatting, geen garantie.",
  },
  {
    question: "Waar kan ik alle data achter deze benchmarks zien?",
    answer:
      "In ons benchmarkrapport over ecommercequizzen. Het splitst de conversie per categorie, de stijging van de gemiddelde orderwaarde, de voltooiing en de attributie uit over meer dan 45M echte quizantwoorden. De 5,5%-benchmark en de cijfers per sector in deze calculator komen er rechtstreeks uit.",
    answerHtml:
      "In ons <a href=\"" + localizedHref("/state-of-product-recommendation-quizzes/", "nl") + "\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">benchmarkrapport over ecommercequizzen</a>. Het splitst de conversie per categorie, de stijging van de gemiddelde orderwaarde, de voltooiing en de attributie uit over meer dan 45M echte quizantwoorden. De 5,5%-benchmark en de cijfers per sector in deze calculator komen er rechtstreeks uit.",
  },
  {
    question: "Is de calculator gratis?",
    answer:
      "Ja. Hij is gratis en zonder drempel, geen e-mail nodig. RevenueHunt zelf heeft ook een gratis plan met 100 quizantwoorden per maand, zodat je de echte stijging in je eigen winkel kunt meten.",
  },
];

const jsonLd = [
  organization(),
  softwareApplication(),
  breadcrumb([
    { name: "Home", url: "/" },
    { name: "Quiz-ROI-calculator", url: "/quiz-roi-calculator/" },
  ]),
  faqPage(faqs),
];
---

<Base
  title="Quiz-ROI-calculator voor ecommerce"
  description="Gratis quiz-ROI-calculator op basis van echte data: 5,5% van wie de quiz maakt plaatst een bestelling. Schat de extra omzet en ROI die een quiz je winkel kan opleveren."
  ogImage="/og/quiz-roi-calculator.png"
  jsonLd={jsonLd}
  lang="nl"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={localizedHref("/", "nl")} class="hover:text-slate-700">Home</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Quiz-ROI-calculator</span>
      </nav>
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">Gratis tool</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">Quiz-ROI-calculator</h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          Ontdek hoeveel extra omzet een productaanbevelingsquiz je winkel kan opleveren. De conversiebenchmark van 275% is echt, <a href={localizedHref("/state-of-product-recommendation-quizzes/", "nl")} class="font-semibold text-[#16161D] underline decoration-2 decoration-[#16161D]/40 underline-offset-2 hover:decoration-[#16161D]">gemeten over meer dan 45M quizantwoorden</a>, geen verzonnen vermenigvuldiger. Pas de gegevens aan zodat ze bij jouw cijfers passen.
        </p>
      </div>
    </div>
  </section>

  <!-- Real-data proof band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-8">
      <div class="rounded-2xl bg-[#16161D] px-6 py-10 sm:px-10">
        <p class="text-center text-sm font-semibold uppercase tracking-wider text-white/50">Gebaseerd op echte RevenueHunt-data</p>
        <dl class="mt-6 grid grid-cols-2 gap-8 text-center sm:grid-cols-4">
          {PROOF.map((p) => (
            <div>
              <dt class="text-3xl font-bold tracking-tight text-white">{p.stat}</dt>
              <dd class="mt-1 text-sm text-white/70">{p.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- Calculator -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 pb-8 pt-10">
      <div class="grid gap-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm lg:grid-cols-2 lg:p-8">
        <!-- Inputs -->
        <form id="roi-form" class="space-y-6" aria-label="Gegevens voor de quiz-ROI">
          <div>
            <label for="sector" class="text-sm font-medium text-slate-900">Wat verkoop je?</label>
            <select
              id="sector"
              class="mt-2 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-900 focus:border-[#16161D] focus:outline-none focus:ring-1 focus:ring-[#16161D]"
            >
              {SECTORS.map((s) => (
                <option value={s.id} data-quizcvr={s.quizcvr} data-aovlift={s.aovlift} data-pct={s.pct}>{s.label}</option>
              ))}
            </select>
            <p class="mt-2 rounded-md bg-[#D8F0FE] px-3 py-2 text-xs text-[#2c81b2] ring-1 ring-inset ring-[#2c81b2]/20">
              <span id="sector-note">In de set quizzen van RevenueHunt converteren wie de quiz maken op bijna 275% van de gemiddelde winkel en plaatsen ze bestellingen die ongeveer 10% groter zijn. Kies je sector voor een nauwkeurigere benchmark.</span>
            </p>
          </div>
          {controls.map((c) => (
            <div>
              <div class="flex items-center justify-between gap-3">
                <label for={c.id} class="text-sm font-medium text-slate-900">
                  {c.label}
                </label>
                <div class="flex items-center gap-1 text-sm">
                  {c.suffix === "$" && <span class="text-slate-500">$</span>}
                  <input
                    type="number"
                    id={c.id}
                    min={c.min}
                    max={c.max}
                    step={c.step}
                    value={c.value}
                    class="w-24 rounded-md border border-slate-300 px-2 py-1 text-right font-semibold text-slate-900 focus:border-[#16161D] focus:outline-none focus:ring-1 focus:ring-[#16161D]"
                  />
                  {c.suffix === "%" && <span class="text-slate-500">%</span>}
                </div>
              </div>
              <input
                type="range"
                id={`${c.id}-range`}
                min={c.min}
                max={c.max}
                step={c.step}
                value={c.value}
                class="mt-3 w-full accent-[#16161D]"
                aria-label={`${c.label} slider`}
              />
              {c.note && (
                <p class="mt-2 text-xs text-slate-500">
                  <span id={`${c.id}-note`}>{c.note}</span>
                  {c.benchmark && (
                    <>
                      {" "}
                      <button
                        type="button"
                        id={`${c.id}-reset`}
                        class="hidden font-medium text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-[#16161D]"
                      >
                        Terugzetten naar de RevenueHunt-data
                      </button>
                    </>
                  )}
                </p>
              )}
            </div>
          ))}
          <!-- AOV uplift is not user-editable: the sector dropdown sets it. -->
          <input type="hidden" id="aovlift" value="10" />
        </form>

        <!-- Results -->
        <div class="flex flex-col gap-4 rounded-xl bg-slate-50 p-6">
          <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">Geschatte impact</p>
          <div>
            <p class="text-sm text-slate-600">Extra omzet per maand</p>
            <p id="out-monthly" class="mt-1 text-4xl font-bold tracking-tight text-[#16161D]">$0</p>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div class="rounded-lg border border-slate-200 bg-white p-4">
              <p class="text-xs text-slate-600">Extra omzet per jaar</p>
              <p id="out-annual" class="mt-1 text-xl font-bold text-slate-900">$0</p>
            </div>
            <div class="rounded-lg border border-slate-200 bg-white p-4">
              <p class="text-xs text-slate-600">Extra bestellingen per maand</p>
              <p id="out-orders" class="mt-1 text-xl font-bold text-slate-900">0</p>
            </div>
          </div>
          <dl class="mt-2 space-y-1 text-sm text-slate-600">
            <div class="flex justify-between">
              <dt>Mensen die de quiz maken per maand</dt>
              <dd id="out-takers" class="font-medium text-slate-900">0</dd>
            </div>
            <div class="flex justify-between">
              <dt>Quizbestellingen per maand</dt>
              <dd id="out-quizorders" class="font-medium text-slate-900">0</dd>
            </div>
            <div class="flex justify-between">
              <dt>Basisomzet per maand</dt>
              <dd id="out-baseline" class="font-medium text-slate-900">$0</dd>
            </div>
            <div class="flex justify-between">
              <dt>Met een quiz</dt>
              <dd id="out-withquiz" class="font-medium text-slate-900">$0</dd>
            </div>
          </dl>
          <a
            href={SHOPIFY_INSTALL}
            target="_blank"
            rel="external noopener nofollow"
            onclick="window.gtag&&gtag('event','shopify_app_install',{event_label:'roi_calculator'})"
            class="mt-2 inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
          >
            installeren op Shopify
          </a>
          <a
            href={WOO_PLUGIN}
            target="_blank"
            rel="external noopener nofollow"
            onclick="window.gtag&&gtag('event','woocommerce_plugin_click',{event_label:'roi_calculator'})"
            class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
          >
            installeren op WooCommerce
          </a>
        </div>
      </div>
      <p class="mt-4 text-xs text-slate-500">
        Het conversiepercentage van wie de quiz maakt is een benchmark die je kunt aanpassen, en de AOV-stijging wordt automatisch toegepast op basis van je sector; beide komen uit echte RevenueHunt-data en je winkel zal afwijken. De bezoekers, de gemiddelde orderwaarde en het huidige conversiepercentage zijn je eigen cijfers. Dit is een schatting, geen garantie, en de echte resultaten hangen af van je winkel, je verkeer en je quiz.
      </p>
    </div>
  </section>

  <!-- Recommended plan + ROI -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 pb-14">
      <div class="rounded-2xl border-2 border-[#16161D] bg-slate-50 p-6 sm:p-8">
        <p class="text-center text-sm font-semibold uppercase tracking-wider text-slate-500">Je aanbevolen plan en ROI</p>
        <div class="mt-5 grid gap-6 sm:grid-cols-3">
          <div class="rounded-xl border border-slate-200 bg-white p-5">
            <p class="text-xs text-slate-600">Geschatte quizantwoorden / maand</p>
            <p id="out-responses" class="mt-1 text-3xl font-bold tracking-tight text-slate-900">0</p>
          </div>
          <div class="rounded-xl border border-slate-200 bg-white p-5">
            <p class="text-xs text-slate-600">Aanbevolen plan</p>
            <p id="out-plan" class="mt-1 text-3xl font-bold tracking-tight text-slate-900">Free Plan</p>
            <p id="out-plancost" class="text-sm text-slate-600">Gratis</p>
          </div>
          <div class="rounded-xl border border-slate-200 bg-white p-5">
            <p class="text-xs text-slate-600">Rendement op de plankosten</p>
            <p id="out-roi" class="mt-1 text-3xl font-bold tracking-tight text-emerald-600">-</p>
            <p id="out-net" class="text-sm text-slate-600"></p>
          </div>
        </div>
        <p class="mt-5 text-center text-sm text-slate-700"><span id="plan-note"></span> <a href={localizedHref("/pricing/", "nl")} class="font-medium text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-[#16161D]">Bekijk alle plannen</a>.</p>
        <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
          <a
            href={SHOPIFY_INSTALL}
            target="_blank"
            rel="external noopener nofollow"
            onclick="window.gtag&&gtag('event','shopify_app_install',{event_label:'roi_calculator_plan'})"
            class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
          >
            begin gratis op Shopify
          </a>
          <a
            href={WOO_PLUGIN}
            target="_blank"
            rel="external noopener nofollow"
            onclick="window.gtag&&gtag('event','woocommerce_plugin_click',{event_label:'roi_calculator_plan'})"
            class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
          >
            begin gratis op WooCommerce
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Conversion by category -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 pb-14">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
        <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Stijging van het conversiepercentage per sector</h2>
        <p class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
          Vergeleken met een typische winkel van 2% converteren wie de quiz van RevenueHunt maken vele malen meer. Hier zie je elke categorie als percentage van dat gemiddelde, met de stijging van de orderwaarde waar we die zien.
        </p>
        <dl class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-xl bg-slate-200 sm:grid-cols-3 lg:grid-cols-6">
          {BY_VERTICAL.map((b) => (
            <div class="bg-white px-4 py-6 text-center">
              <dt class="text-3xl font-bold tracking-tight text-[#16161D]">{b.pct}</dt>
              <dd class="mt-1 text-sm text-slate-600">{b.v}</dd>
              <dd class={`mt-2 text-xs font-medium ${b.lift.startsWith("+") ? "text-emerald-700" : "text-slate-400"}`}>{b.lift}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-4 text-center text-xs text-slate-500">
          Weergegeven als percentage van een typisch winkelconversiepercentage van 2%, gemeten in onze data. Je winkel zal afwijken.
        </p>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Hoe de calculator werkt</h2>
      <div class="mt-8 space-y-5 text-lg text-slate-700">
        <p>
          Het model is bewust eenvoudig en eerlijk. Het neemt het percentage van je bezoekers dat de quiz voltooit, converteert ze tegen het percentage van wie de quiz maakt en vergelijkt het met wat diezelfde bezoekers zouden hebben gedaan tegen het huidige <a href="/glossary/conversion-rate-optimization/" class="font-medium text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-[#16161D]">conversiepercentage</a> van je site. Het verschil is de geschatte extra omzet.
        </p>
        <p>
          Op basis van data verzameld over meer dan 45 miljoen echte quizantwoorden plaatst 5,5% van de shoppers die een RevenueHunt-quiz voltooien (ongeveer 1 op de 18) een gemeten bestelling. Tegenover een typisch winkelconversiepercentage van 2% is dat 2,75x, ongeveer 275% van wat een winkel doorgaans converteert. We vullen dat cijfer vooraf in en laten je het aanpassen.
        </p>
        <p>
          We hebben ook de orderwaarde geanalyseerd. Vergelijkbaar met vergelijkbaar, binnen dezelfde winkel, zijn quizbestellingen ongeveer 10% hoger dan bestellingen zonder quiz. De stijging is sterker in categorieën als huidverzorging, beauty en supplementen, en bijna ongewijzigd in sommige andere. De calculator past een conservatieve, datagedreven stijging toe op basis van de sector die je kiest, zodat je niet hoeft te gokken.
        </p>
        <p>
          De calculator gebruikt je eigen <a href="/glossary/average-order-value/" class="font-medium text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-[#16161D]">gemiddelde orderwaarde</a> en negeert de e-mailleads en zero-party data die een quiz vastlegt, die zich in de loop van de tijd opstapelen, dus hij onderschat doorgaans de totale waarde.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900">Veelgestelde vragen</h2>
      <div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
        {faqs.map((faq) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-lg font-semibold text-slate-900 [&::-webkit-details-marker]:hidden">
              <span>{faq.question}</span>
              <svg
                class="h-5 w-5 flex-shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <p class="pb-5 text-slate-700" set:html={faq.answerHtml ?? faq.answer} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Test de stijging, gratis.
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        Maak een productaanbevelingsquiz en meet de echte impact op je winkel. Gratis plan, geen creditcard nodig.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SHOPIFY_INSTALL}
          target="_blank"
          rel="external noopener nofollow"
          onclick="window.gtag&&gtag('event','shopify_app_install',{event_label:'roi_calculator_bottom'})"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          empezar gratis en Shopify
        </a>
        <a
          href={WOO_PLUGIN}
          target="_blank"
          rel="external noopener nofollow"
          onclick="window.gtag&&gtag('event','woocommerce_plugin_click',{event_label:'roi_calculator_bottom'})"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          empezar gratis en WooCommerce
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var KEYS = ["visitors", "aov", "cvr", "engage", "quizcvr"];
      var usd = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 });
      var num = new Intl.NumberFormat("en-US", { maximumFractionDigits: 0 });
      function clamp(el, v) {
        var min = parseFloat(el.min), max = parseFloat(el.max);
        if (!isNaN(min) && v < min) v = min;
        if (!isNaN(max) && v > max) v = max;
        return v;
      }
      function val(id) {
        var el = document.getElementById(id);
        var v = parseFloat(el.value);
        return isNaN(v) ? 0 : v;
      }
      function set(id, v) {
        var t = document.getElementById(id);
        if (t) t.textContent = v;
      }
      // Quiz takers convert at a fixed multiple of a normal store. The sector
      // benchmark is that rate measured at a 2% reference store (5.5% = 2.75x,
      // 3.6% = 1.8x, ...). Express the quiz-taker rate as that same multiple
      // applied to the merchant's OWN rate, but never below the 2% reference, so
      // even a high-converting store still sees a lift instead of a flat $0. The
      // multiple is always >= 1.8, so the result always clears the current rate.
      var sectorBenchmark = 5.5;
      function quizFloor() {
        return Math.round(sectorBenchmark * Math.max(2, val("cvr")) / 2 * 10) / 10;
      }
      function setQuizCvr(v) {
        var n = document.getElementById("quizcvr"), r = document.getElementById("quizcvr-range");
        if (!n) return;
        v = Math.min(v, parseFloat(n.max));
        n.value = v;
        if (r) r.value = clamp(r, v);
      }
      // Raising the current rate lifts the quiz rate to keep the multiple; it
      // never lowers a manual edit the merchant made above the floor.
      function ensureBoost() {
        var f = quizFloor();
        if (val("quizcvr") < f) setQuizCvr(f);
      }
      // Keep the quiz-rate helper note truthful as the rate changes. At the
      // benchmark it's the pre-filled RevenueHunt figure; once the merchant edits
      // it off the benchmark it's their own value (the reset link gets them back).
      function syncNotes() {
        var qc = val("quizcvr");
        if (qc <= 0) return;
        var oneIn = Math.round(100 / qc);
        var bench = quizFloor();
        if (Math.abs(qc - bench) <= 0.05) {
          set("quizcvr-note", "Vooraf ingevuld met RevenueHunt-data: ongeveer 1 op de " + oneIn + " mensen die de quiz maken plaatst een bestelling. Pas het aan zodat het bij je winkel past.");
        } else {
          var d = Math.round((qc / bench - 1) * 100);
          var rel = d >= 0 ? d + "% boven" : Math.abs(d) + "% onder";
          set("quizcvr-note", "Jouw waarde: ongeveer 1 op de " + oneIn + " mensen die de quiz maken plaatst een bestelling. Dat is " + rel + " het gemiddelde conversiepercentage van de quiz.");
        }
      }
      // Only show the reset link when the quiz rate is off its data value — i.e.
      // the merchant edited it, or lowered their current rate so it sits above
      // the benchmark. At the data value there is nothing to reset.
      function syncReset() {
        var btn = document.getElementById("quizcvr-reset");
        if (btn) btn.classList.toggle("hidden", Math.abs(val("quizcvr") - quizFloor()) <= 0.05);
      }
      function calc() {
        syncNotes();
        syncReset();
        var V = val("visitors"), A = val("aov"), c = val("cvr") / 100, q = val("engage") / 100, qc = val("quizcvr") / 100, lift = val("aovlift") / 100;
        var takers = V * q;
        var quizOrders = takers * qc;
        var extraOrders = Math.max(0, takers * (qc - c));
        // Quiz orders carry a within-store AOV uplift; non-quiz baseline does not.
        // Extra = quiz-taker revenue with the quiz, minus what those same takers
        // would do at the site rate. With lift = 0 this is the old (qc - c) * A.
        var quizAov = A * (1 + lift);
        var extra = Math.max(0, quizOrders * quizAov - takers * c * A);
        var baseline = V * c * A;
        set("out-monthly", usd.format(extra));
        set("out-annual", usd.format(extra * 12));
        set("out-orders", num.format(extraOrders));
        set("out-takers", num.format(takers));
        set("out-quizorders", num.format(quizOrders));
        set("out-baseline", usd.format(baseline));
        set("out-withquiz", usd.format(baseline + extra));

        // Recommended plan (by monthly quiz responses) + cost + ROI.
        // Tiers mirror /pricing/ (lib/plans.ts).
        var responses = takers;
        // Anything above the Premium tier (2,500/mo) lands on the Unlimited Plan
        // at $299/mo with no response cap, so the ROI is computed off $299.
        var PLANS = [
          { name: "Free Plan", limit: 100, cost: 0 },
          { name: "Basic Plan", limit: 500, cost: 39 },
          { name: "Pro Plan", limit: 1000, cost: 99 },
          { name: "Premium Plan", limit: 2500, cost: 199 },
          { name: "Unlimited Plan", limit: Infinity, cost: 299, unlimited: true },
        ];
        var plan = PLANS[0];
        for (var i = 0; i < PLANS.length; i++) {
          if (responses <= PLANS[i].limit) { plan = PLANS[i]; break; }
        }
        set("out-responses", num.format(responses));
        if (plan.cost === 0) {
          set("out-plan", plan.name);
          set("out-plancost", "Gratis");
          set("out-roi", extra > 0 ? "Pure winst" : "-");
          set("out-net", extra > 0 ? "+" + usd.format(extra) + " / maand, zonder kosten" : "");
          set("plan-note", "Ongeveer " + num.format(responses) + " quizantwoorden per maand passen in het gratis plan (100 antwoorden), dus de geschatte " + usd.format(extra) + " per maand aan extra omzet kost je niets.");
        } else {
          var roi = extra / plan.cost;
          var net = extra - plan.cost;
          set("out-plan", plan.name);
          set("out-plancost", "$" + plan.cost + " / maand");
          set("out-roi", extra > 0 ? (roi >= 10 ? Math.round(roi) + "x" : roi.toFixed(1) + "x") : "-");
          set("out-net", extra > 0 ? (usd.format(extra) + " omzet min " + usd.format(plan.cost) + " plan = " + usd.format(net) + "/maand netto") : "");
          if (extra <= 0) {
            set("plan-note", "Zet het conversiepercentage van de quiz boven je huidige sitepercentage om een rendement te zien. Het " + plan.name + " ($" + plan.cost + "/maand) dekt " + (plan.unlimited ? "onbeperkte antwoorden." : "ongeveer " + num.format(responses) + " antwoorden per maand."));
          } else {
            var fit = plan.unlimited
              ? "Ongeveer " + num.format(responses) + " quizantwoorden per maand plaatsen je in het " + plan.name + " voor $" + plan.cost + " per maand, met onbeperkte antwoorden."
              : "Ongeveer " + num.format(responses) + " quizantwoorden per maand passen in het " + plan.name + " voor $" + plan.cost + " per maand.";
            set("plan-note", fit + " De geschatte " + usd.format(extra) + " per maand aan extra omzet is ongeveer " + (roi >= 10 ? Math.round(roi) : roi.toFixed(1)) + "x de plankosten.");
          }
        }
      }
      KEYS.forEach(function (k) {
        var n = document.getElementById(k);
        var r = document.getElementById(k + "-range");
        if (!n || !r) return;
        n.addEventListener("input", function () { r.value = clamp(n, val(k)); if (k === "cvr") ensureBoost(); calc(); });
        r.addEventListener("input", function () { n.value = r.value; if (k === "cvr") ensureBoost(); calc(); });
      });
      // Sector selector: pre-fill the quiz rate + AOV uplift from the chosen
      // sector and recompute everything. Unselected stays "All sectors" (275%).
      var sector = document.getElementById("sector");
      function applySector() {
        var o = sector.options[sector.selectedIndex];
        var qc = o.getAttribute("data-quizcvr");
        var lift = o.getAttribute("data-aovlift");
        var pct = o.getAttribute("data-pct");
        function put(id, v) {
          var n = document.getElementById(id), r = document.getElementById(id + "-range");
          if (n) n.value = v;
          if (r) r.value = clamp(r, parseFloat(v));
        }
        sectorBenchmark = parseFloat(qc) || sectorBenchmark;
        // Reset the current rate to its default first, so the quiz rate lands on
        // the sector's published benchmark (5.5%, 3.6%, ...) rather than scaling
        // off whatever the merchant had dragged the current rate to.
        var cvrEl = document.getElementById("cvr");
        if (cvrEl) put("cvr", cvrEl.defaultValue);
        setQuizCvr(quizFloor());
        put("aovlift", lift);
        var liftN = parseFloat(lift) || 0;
        var aovPart = liftN > 0 ? " en plaatsen ze bestellingen die ongeveer " + liftN + "% groter zijn" : "";
        if (o.value === "all") {
          set("sector-note", "In de set quizzen van RevenueHunt converteren wie de quiz maken op bijna " + pct + "% van de gemiddelde winkel" + aovPart + ". Kies je sector voor een nauwkeurigere benchmark.");
        } else {
          set("sector-note", "Wie de quiz maken in " + o.text + " converteren op bijna " + pct + "% van de gemiddelde winkel" + aovPart + ", gemeten in RevenueHunt-data.");
        }
        calc();
      }
      if (sector) sector.addEventListener("change", applySector);
      // Reset link: restore the quiz-taker rate to the RevenueHunt benchmark for
      // the current sector and store rate, in case the merchant dragged it away.
      var quizReset = document.getElementById("quizcvr-reset");
      if (quizReset) quizReset.addEventListener("click", function () { setQuizCvr(quizFloor()); calc(); });
      calc();
    })();
  </script>
</Base>
