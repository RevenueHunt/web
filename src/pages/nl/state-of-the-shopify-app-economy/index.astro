---
import Base from "../../../layouts/Base.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import { organization, breadcrumb, article, faqPage } from "../../../lib/schema";
import { SITE } from "../../../lib/site";
import { localizedHref } from "../../../lib/i18n";
import {
  REPORT,
  SOURCE,
  HEADLINE,
  GROWTH,
  REVIEWS,
  REVENUE,
  PRICING,
  GEOGRAPHY,
  NICHES,
  QUIZ_LANE,
} from "../../../lib/app-economy";

const pageUrl = new URL(`/nl/${REPORT.slug}/`, SITE.site_url).href;
const ogImage = `/og/${REPORT.slug}.png`;

const publishedLabel = new Date(REPORT.datePublished).toLocaleDateString("nl-NL", {
  year: "numeric",
  month: "long",
});

const title = "De staat van de Shopify-app-economie";
const description =
  "Er zijn 22.546 actieve apps in de Shopify App Store en bijna geen enkele komt ergens. Een datarapport over groei, reviews, omzetconcentratie, prijzen en wie ze bouwt, op basis van een momentopname van elke actieve app.";

// Methodology + FAQ, translated. The lead clause of each methodology note is
// bolded inline (the English source bolded it via string replace, which cannot
// match translated text). Defined before jsonLd so faqPage(FAQ) can use it.
const METHODOLOGY = [
  "<strong>Bron:</strong> een momentopname van de openbare Shopify App Store, 22.546 actieve app-listings, gemaakt in juni 2026. Elk veld komt uit de openbare listing, niet uit Shopify's interne data of het account van een merchant.",
  "<strong>De omzet is geschat, niet gemeten.</strong> Hij wordt gemodelleerd op basis van de gepubliceerde prijsniveaus van elke app, samen met review- en installatiesignalen. Behandel de omzetcijfers als een richtinggevend model van hoe geconcentreerd de inkomsten zijn, niet als facturatiedata. Ze worden overal waar ze voorkomen aangeduid als \"geschat\".",
  "<strong>De groei is gebaseerd op de gepubliceerde lanceerdatum van elke listing.</strong> De bron clusterde ongeveer 2.800 lanceerdata in mei 2026, dus de curve wordt gelezen als cumulatief aantal actieve apps per jaar (het eindpunt is het echte huidige totaal), en het cijfer \"6.000+ in de afgelopen 12 maanden\" haalt dat artefact van die ene maand eruit.",
  "<strong>Reviews zijn een indicator voor tractie</strong>, geen perfecte: een geweldige app kan nieuw zijn, en reviewaantallen lopen achter op het werkelijke gebruik. We gebruiken ze omdat ze het duidelijkste openbare, vergelijkbare signaal zijn van een echte merchant-basis over 22.546 apps.",
  "Categorieën in de App Store zijn functie-tags die een app zichzelf kan toekennen, en veel apps dragen er meerdere of geen. Voor het sectoroverzicht groeperen we verwante tags tot brede banen en ontdubbelen we apps binnen elk; een app kan tot meer dan één behoren, dus sectoren overlappen en sluiten elkaar niet uit, en we lezen ze als richtinggevend. Overal elders steunen we op de ondubbelzinnige sneden (reviews, prijzen, lanceerdatum, ontwikkelaarsland).",
];

const FAQ = [
  {
    question: "Hoeveel apps staan er in de Shopify App Store?",
    answer:
      "22.546 actieve apps in deze momentopname van juni 2026. De store is sinds 2020 ongeveer 10 keer zo groot geworden en heeft alleen al in de afgelopen 12 maanden meer dan 6.000 apps toegevoegd, ongeveer 1 op de 4 van alles wat vandaag actief is. AI-ondersteunde ontwikkeling maakte van wat vroeger een bouwklus van zes maanden was een weekendje werk.",
  },
  {
    question: "Waarom mislukken de meeste Shopify-apps?",
    answer:
      "Bouwen is niet langer de beperking, dus de store wordt overspoeld met apps die nooit een merchant-basis vinden. 51% heeft geen enkele review en 81% heeft er minder dan 10. Wat schaars is, is distributie en vertrouwen: support beantwoorden, review voor review verdienen bij merchant na merchant, jarenlang aanwezig blijven. Dat is het deel dat AI niet voor je kan doen.",
  },
  {
    question: "Hoeveel verdienen Shopify-apps?",
    answer:
      "De inkomsten zijn extreem geconcentreerd. Volgens onze schatting pakt de top 1% van de apps (225 stuks) ongeveer 72% van alle app-omzet, en alleen de top 10 al pakt bijna 30%. Slechts ongeveer 36% van de apps lijkt überhaupt iets te verdienen. De omzet is hier geschat op basis van openbare prijzen en gebruikssignalen, niet op basis van facturatiedata.",
  },
  {
    question: "Zijn de meeste Shopify-apps gratis?",
    answer:
      "In feite wel. 46,9% is gratis en nog eens 48,6% begint met een gratis proefperiode; slechts 4,5% vraagt geld vooraf. 57% van de betaalde apps biedt een gratis plan aan. In de Shopify App Store is een gratis instappunt geen groeitactiek, het is de basisverwachting.",
  },
  {
    question: "Waar kan ik de onderliggende data zien?",
    answer:
      "De cijfers komen uit een momentopname die we bijhouden van elke actieve Shopify-app: lanceerdata, reviews, prijzen, het Built for Shopify-keurmerk en het land van de ontwikkelaar. Bouw je op Shopify en wil je het volledige rapport? Neem contact op.",
    answerHtml:
      "De cijfers komen uit een momentopname die we bijhouden van elke actieve Shopify-app: lanceerdata, reviews, prijzen, het Built for Shopify-keurmerk en het land van de ontwikkelaar. Bouw je op Shopify en wil je het volledige rapport? <a href=\"/nl/contact/\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">Neem contact op</a>.",
  },
];

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Home", url: localizedHref("/", "nl") },
    { name: title, url: localizedHref(`/${REPORT.slug}/`, "nl") },
  ]),
  article({
    title,
    description,
    url: pageUrl,
    image: ogImage,
    datePublished: REPORT.datePublished,
    dateModified: REPORT.dateModified,
    author: "RevenueHunt",
    tags: [
      "Shopify app store",
      "Shopify app-ontwikkelaars",
      "app store-statistieken",
      "app-economie",
    ],
  }),
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "De staat van de Shopify-app-economie 2026",
    description,
    url: pageUrl,
    creator: organization(),
    license: "https://creativecommons.org/licenses/by/4.0/",
    isAccessibleForFree: true,
    datePublished: REPORT.datePublished,
    keywords: [
      "Shopify app store",
      "app-ontwikkelaars",
      "app-omzet",
      "app-reviews",
      "ecommerce",
    ],
  },
  faqPage(FAQ),
];

// Section eyebrows for the editorial "field notes" feel.
const E = (n: string, label: string) => `${n} · ${label}`;

// Translated headline cards. Stats stay from the shared data module (HEADLINE[i].stat).
const headlineT = [
  { label: "actieve apps in de store", note: "Ongeveer 10 keer zo veel als in 2020." },
  { label: "hebben geen enkele review", note: "Vier van de vijf hebben er minder dan 10." },
  { label: "van de omzet gaat naar de top 1%", note: "225 apps. Geschat." },
  { label: "vragen geld vooraf", note: "Slechts 1 op de 20. Bijna de helft is gratis." },
];

// Growth caption with the lead phrase bolded.
const growthCaptionHtml =
  "Cumulatief aantal actieve apps per lanceerjaar. <strong>De Shopify App Store is sinds 2020 ongeveer 10 keer zo groot geworden</strong> en heeft alleen al in de afgelopen 12 maanden meer dan 6.000 apps toegevoegd, ongeveer 1 op de 4 van alles wat vandaag actief is.";

// Quiz-lane paragraphs (translated), with the live search link and the load-bearing
// lines bolded inline. Caption text mirrors the English source's meaning.
const quizParas = [
  `Onze eigen categorie laat precies hetzelfde zien. <a href="${QUIZ_LANE.searchUrl}" target="_blank" rel="external noopener nofollow" class="font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]">de zoekopdracht op "quiz" in Shopify</a> levert 149 apps op, maar ook hier stapelt vertrouwen zich bovenaan op, precies zoals in de hele store. De drie apps die er als eerste waren en nooit weggingen, RevenueHunt, Octane AI en Quiz Kit, zijn samen goed voor 45% van alle reviews in de categorie; <strong>RevenueHunt alleen heeft er ongeveer een kwart van</strong>, en de onderste helft heeft er geen enkele.`,
  `We zijn niet bovenaan gekomen met code. <strong>Reviews zijn het symptoom van het operationele zwoegen</strong> dat eronder zit: zes jaar lang support beantwoorden, aan de telefoon zitten met winkels die nooit zouden betalen en winkel voor winkel vertrouwen verdienen. Octane AI en Quiz Kit deden jarenlang hetzelfde zware werk, <strong>en daar hebben we respect voor</strong>. Eervolle vermelding voor Lantern en Quizell, allebei met iets meer dan 120 reviews.`,
];

// Methodology bullets carry their own inline <strong>; render as-is.
const methodologyHtml = METHODOLOGY;
---

<Base
  title={`${title} - datarapport 2026`}
  description={description}
  ogImage={ogImage}
  jsonLd={jsonLd}
  lang="nl"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <Breadcrumb items={[{ label: "Home", href: localizedHref("/", "nl") }, { label: "De staat van de Shopify-app-economie" }]} />
      <div class="text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">
          Veldnotities · {publishedLabel}
        </p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          De staat van de Shopify-app-economie
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          <strong>Er zijn 22.546 actieve apps in de Shopify App Store, en bijna geen enkele komt ergens.</strong> We maakten een momentopname van elke actieve app en lazen de data over groei, reviews, omzet, prijzen en wie ze bouwt. Ze vertellen één verhaal: de app bouwen was nooit het moeilijke deel.
        </p>
      </div>
    </div>
  </section>

  <!-- Source band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-2xl bg-[#16161D] px-6 py-10 sm:px-10">
        <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#4dcaff]">
          De momentopname
        </p>
        <dl class="mt-6 grid grid-cols-2 gap-8 text-center sm:grid-cols-4">
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.apps}</dt>
            <dd class="mt-1 text-sm text-white/70">actieve apps in de momentopname</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.countries}</dt>
            <dd class="mt-1 text-sm text-white/70">landen die ze bouwen</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.reviewless}</dt>
            <dd class="mt-1 text-sm text-white/70">zonder enkele review</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.free}</dt>
            <dd class="mt-1 text-sm text-white/70">volledig gratis, zonder betaald plan</dd>
          </div>
        </dl>
        <p class="mx-auto mt-6 max-w-3xl text-center text-sm text-white/60">
          Elk cijfer hieronder komt uit de openbare App Store-pagina van alle 22.546 actieve apps, juni 2026. De omzet wordt geschat op basis van gepubliceerde prijzen en gebruikssignalen, niet op basis van facturatiedata, en wordt overal in het rapport als zodanig aangeduid.
        </p>
      </div>
    </div>
  </section>

  <!-- Headline cards -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">De opvallendste cijfers</h2>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        {HEADLINE.map((c, i) => (
          <div class="rounded-xl border border-slate-200 p-7">
            <p class="text-4xl font-bold tracking-tight text-[#16161D]">{c.stat}</p>
            <p class="mt-2 font-medium text-slate-900">{headlineT[i].label}</p>
            <p class="mt-2 text-sm text-slate-600">{headlineT[i].note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 01 Growth -->
  <section class="scroll-mt-20 bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("01", "Groei")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">10 keer zo groot sinds 2020</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center" set:html={growthCaptionHtml} />
      <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
        <div class="h-72 sm:h-80"><canvas id="c-growth" aria-label="Cumulatief aantal actieve Shopify-apps per jaar" role="img"></canvas></div>
      </div>
    </div>
  </section>

  <!-- 02 Traction -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("02", "Tractie")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">De meeste apps krijgen nooit een review</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">De helft van de Shopify App Store heeft nooit één review gekregen. Vier van de vijf apps hebben er minder dan 10. Een review is de duidelijkste openbare indicator van een echte, behouden winkel, en de meeste apps krijgen er nooit één.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-center text-sm font-semibold text-slate-900">Apps op aantal reviews</p>
          <div class="h-72 sm:h-80"><canvas id="c-reviews" aria-label="Reviewverdeling over alle actieve apps" role="img"></canvas></div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">81%</p>
            <p class="mt-1 text-slate-700">hebben minder dan 10 reviews</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="font-bold text-[#16161D]"><span class="text-3xl">{REVIEWS.medianReviews}</span> <span class="text-sm font-medium text-slate-500">reviews</span></p>
            <p class="mt-1 text-slate-700">de mediaan, onder de apps die er minstens een hebben</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="font-bold text-[#16161D]"><span class="text-amber-400">★</span> <span class="text-3xl">{REVIEWS.avgRating}</span> <span class="text-sm font-medium text-slate-500">sterren</span></p>
            <p class="mt-1 text-slate-700">gemiddelde beoordeling, onder de {REVIEWS.ratedCount} apps die er een hebben</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 Revenue -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("03", "Omzet · geschat")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Het geld verzamelt zich helemaal bovenaan</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">De geschatte maandelijkse omzet is keihard geconcentreerd bovenaan. De top 1% van de apps (225 stuks) pakt een geschatte 72%, en alleen al 10 van die apps pakken bijna 30% van alle app-omzet. Slechts ongeveer 36% van de apps lijkt überhaupt iets te verdienen. En het balt zich geografisch samen: <strong>alleen de VS en Canada pakken een geschatte 57%</strong> van de omzet in de Shopify App Store.</p>
      <p class="mx-auto mt-3 max-w-3xl text-sm italic text-slate-500 text-center">Eén naam torent boven het hele ecosysteem uit: een app die naar schatting 78% van haar jaaromzet van ongeveer 1 miljard dollar haalt uit Shopify-merchants. Ja, we kijken naar jou, <a href='https://www.sec.gov/Archives/edgar/data/1835830/000162828023030618/klaviyoincs-1.htm' target='_blank' rel='external noopener nofollow' class='font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]'>Klaviyo</a>.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-center text-sm font-semibold text-slate-900">Omzetverdeling</p>
          <div class="h-64 sm:h-72"><canvas id="c-revenue-donut" aria-label="Verdeling van de geschatte omzet: de top 10 apps, de rest van de top 1% en de andere 99%" role="img"></canvas></div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-center text-sm font-semibold text-slate-900">Geschatte omzet per land</p>
          <div class="h-64 sm:h-72"><canvas id="c-revenue-countries" aria-label="Geschatte omzet per land" role="img"></canvas></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 Pricing -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("04", "Prijzen")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Bijna niemand vraagt geld vooraf</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">Bijna de helft van de store vraagt niets vooraf, en minder dan 1 op de 20 apps vraagt geld vóór de eerste installatie. 57% van de betaalde apps biedt een gratis plan aan. Freemium is hier geen strategie, het is het minimum om mee te mogen doen.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="text-center text-sm font-semibold text-slate-900">Instapprijzen over alle 22.546 actieve apps</p>
          <p class="mt-0.5 text-center text-xs text-slate-500">Vier elkaar uitsluitende niveaus, naar wat de app vooraf vraagt.</p>
          <div class="mt-4 h-72 sm:h-80"><canvas id="c-pricing" aria-label="Verdeling van het prijsmodel over alle actieve apps, naar instapniveau" role="img"></canvas></div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">{PRICING.permanentFree}</p>
            <p class="mt-1 text-slate-700">bieden een permanent gratis plan aan, niet alleen een proefperiode</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">{PRICING.completelyFree}</p>
            <p class="mt-1 text-slate-700">zijn volledig gratis, zonder enig betaald plan</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">{PRICING.entryPrice}</p>
            <p class="mt-1 text-slate-700">de meest voorkomende instapprijs, en de mediaan - {PRICING.entryPriceCount} apps vragen precies dit</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 Who builds them -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("05", "Wie ze bouwt")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Signaal versus ruis</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">Twee landen domineren: <strong>de VS (24%) en India (15%) bouwen samen twee op de vijf</strong> apps in de store. Maar <strong>volume is geen tractie</strong>. Sorteer je de landen alleen op de apps die 10+ reviews hebben gehaald, dan tekent de ranglijst zich opnieuw - <strong>Vietnam</strong>, een middelgrote ontwikkelaar, plaatst meer apps met echte tractie dan zijn omvang doet vermoeden.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="text-center text-sm font-semibold text-slate-900">Alle apps, naar reviewniveau</p>
          <p class="mt-0.5 text-center text-xs text-slate-500">Top 10 ontwikkelaars op aantal apps. Klik op een niveau om het in of uit te schakelen - verberg de niveaus 0 en 1–9 en de ranglijst herschikt op tractie: Vietnam, Israël en Singapore klimmen.</p>
          <div class="mt-4 h-80 sm:h-96"><canvas id="c-geography" aria-label="Belangrijkste ontwikkelaarslanden op basis van aantal apps, uitgesplitst naar reviewniveau" role="img"></canvas></div>
        </div>
        <div class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
          <div class="flex flex-col justify-center rounded-2xl border border-slate-200 bg-white p-6">
            <p class="text-3xl font-bold text-[#16161D]">{GEOGRAPHY.builtForShopify}</p>
            <p class="mt-1 text-sm text-slate-700">dragen het Built for Shopify-keurmerk ({GEOGRAPHY.builtForShopifyCount} apps), jaren nadat Shopify de standaard begon te pushen</p>
          </div>
          <div class="flex flex-col justify-center rounded-2xl border border-slate-200 bg-white p-6">
            <p class="text-3xl font-bold text-[#16161D]">{GEOGRAPHY.usIndiaShare}</p>
            <p class="mt-1 text-sm text-slate-700">van de hele store wordt alleen in de VS en India gebouwd</p>
          </div>
          <div class="flex flex-col justify-center rounded-2xl border border-slate-200 bg-white p-6">
            <p class="text-3xl font-bold text-[#16161D]">{GEOGRAPHY.vietnamSignal}</p>
            <p class="mt-1 text-sm text-slate-700">van de apps uit Vietnam halen 10+ reviews - de beste signaalratio van alle grote ontwikkelaars, ongeveer het dubbele van de VS of India</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 Sectors -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("06", "Sectoren")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Druk is niet winbaar</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">De drukste banen van de store zijn de slechtste gokken. Ontwikkelaars storten zich op verzending en chat, alledaagse hulpprogramma's, en bijna niemand krijgt tractie: <strong>bijna 9 van de 10 apps voor externe logistiek hebben minder dan 10 reviews</strong>. De apps die doorbreken clusteren waar het werk zich opstapelt - <strong>lokalisatie, prijzen en aanpassing op codeniveau</strong>, de tools die onmisbaar worden zodra een merchant ze installeert.</p>
      <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
        <p class="text-center text-sm font-semibold text-slate-900">Alle sectoren, naar reviewniveau</p>
        <p class="mt-0.5 text-center text-xs text-slate-500">De apps van elke sector, opgesplitst naar reviewniveau en gesorteerd van groot naar klein.</p>
        <div class="mt-4 h-[26rem] sm:h-[30rem]"><canvas id="c-niches" aria-label="Shopify-app-sectoren opgesplitst naar reviewniveau, gesorteerd op het aandeel dat 10 of meer reviews haalt" role="img"></canvas></div>
        <p class="mt-3 text-center text-xs text-slate-400">Sectoren bundelen zelf toegekende functie-tags, ontdubbeld per app. Een app kan in meerdere zitten, dus sectoren overlappen en sluiten elkaar niet uit - lees ze als brede banen, niet als precieze marktgroottes.</p>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        <div class="flex flex-col justify-center rounded-2xl border border-slate-200 bg-white p-6">
          <p class="text-3xl font-bold text-[#16161D]">{NICHES.deadNicheSub10}</p>
          <p class="mt-1 text-sm text-slate-700">van de apps voor externe logistiek hebben minder dan 10 reviews - de meest dode drukke niche in de store</p>
        </div>
        <div class="flex flex-col justify-center rounded-2xl border border-slate-200 bg-white p-6">
          <p class="text-3xl font-bold text-[#16161D]">{NICHES.bestNicheTraction}</p>
          <p class="mt-1 text-sm text-slate-700">van de lokalisatie-apps halen 10+ reviews - de beste kansen van elke grote sector</p>
        </div>
        <div class="flex flex-col justify-center rounded-2xl border border-slate-200 bg-white p-6">
          <p class="text-3xl font-bold text-[#16161D]">{NICHES.topSectorApps}</p>
          <p class="mt-1 text-sm text-slate-700">apps verdringen zich in verzending en fulfilment, de grootste sector - en toch haalt maar 28% tractie</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 07 The quiz lane -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("07", "Het quiz-segment")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Onze eigen categorie, van dichtbij</h2>
      {quizParas.map((html) => (
        <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center" set:html={html} />
      ))}
      <div class="mx-auto mt-8 grid max-w-3xl grid-cols-3 gap-4 text-center">
        <a
          href="https://apps.shopify.com/product-recommendation-quiz-revenuehunt"
          target="_blank"
          rel="external noopener"
          class="block rounded-xl border border-[#616eff]/60 p-6 shadow-[0_0_28px_-4px_rgba(97,110,255,0.55)] transition hover:border-[#616eff] hover:shadow-[0_0_32px_-2px_rgba(97,110,255,0.7)]"
        >
          <p class="text-sm font-semibold text-slate-900">RevenueHunt</p>
          <p class="mt-1 font-bold text-[#16161D]"><span class="text-3xl">{QUIZ_LANE.revenueHuntReviews}</span> <span class="text-sm font-medium text-slate-500">reviews</span></p>
          <p class="mt-1 text-xs font-semibold text-slate-600"><span class="text-amber-400">★</span> 4,9 sterren</p>
        </a>
        <div class="rounded-xl border border-slate-200 p-6">
          <p class="text-sm font-medium text-slate-700">Octane AI</p>
          <p class="mt-1 font-bold text-slate-500"><span class="text-3xl">{QUIZ_LANE.octaneReviews}</span> <span class="text-sm font-medium text-slate-500">reviews</span></p>
          <p class="mt-1 text-xs font-semibold text-slate-600"><span class="text-amber-400">★</span> 4,8 sterren</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-6">
          <p class="text-sm font-medium text-slate-700">Quiz Kit</p>
          <p class="mt-1 font-bold text-slate-500"><span class="text-3xl">{QUIZ_LANE.quizKitReviews}</span> <span class="text-sm font-medium text-slate-500">reviews</span></p>
          <p class="mt-1 text-xs font-semibold text-slate-600"><span class="text-amber-400">★</span> 4,8 sterren</p>
        </div>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-center text-sm text-slate-500">Reviews in de Shopify App Store, juni 2026. Octane AI en Quiz Kit zijn de echte concurrenten die RevenueHunt in deze categorie heeft; respect voor allebei.</p>
    </div>
  </section>

  <!-- Takeaway -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#4dcaff]">De conclusie</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        De app bouwen was nooit het moeilijke deel.
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-white/75">
        AI veranderde dat niet. Het maakte het alleen onmogelijk om het te verbergen. Wanneer code een commodity wordt, is de stroom nieuwe apps niet de concurrentie. De concurrentie is het handjevol dat er vroeg bij was en nooit ophield met ploeteren: support beantwoorden, winkel voor winkel reviews verdienen, vertrouwen opbouwen.
      </p>
      <p class="mx-auto mt-5 max-w-2xl text-lg font-semibold text-white">
        Distributie en vertrouwen zijn de enige AI-bestendige zet die overblijft.
      </p>
      <p class="mx-auto mt-10 max-w-2xl text-lg text-white/85">
        Bouw je een Shopify-app die echt werkt? Ik wil graag de oprichters ontmoeten die de handen uit de mouwen steken. Laten we praten.
      </p>
      <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={localizedHref("/contact/", "nl")}
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          Neem contact op
        </a>
        <a
          href="https://www.linkedin.com/in/revenuehunt/"
          target="_blank"
          rel="external noopener"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          Connect op LinkedIn
        </a>
      </div>
      <p class="mx-auto mt-10 max-w-2xl text-white/60">
        Interessant gevonden? We deden dezelfde analyse in onze eigen categorie in <a href={localizedHref("/state-of-product-recommendation-quizzes/", "nl")} class="font-medium text-white underline decoration-white/40 underline-offset-2 hover:decoration-white">de staat van de productaanbevelingsquiz</a>.
      </p>
    </div>
  </section>

  <!-- Methodology -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Methodologie</h2>
      <ul class="mt-8 space-y-5" role="list">
        {methodologyHtml.map((m) => (
          <li class="flex gap-3">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400" aria-hidden="true"></span>
            <p class="text-slate-700" set:html={m} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Veelgestelde vragen</h2>
      <div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
        {FAQ.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-lg font-semibold text-slate-900 [&::-webkit-details-marker]:hidden">
              <span>{f.question}</span>
              <svg class="h-5 w-5 flex-shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <p class="pb-5 text-slate-700" set:html={f.answerHtml ?? f.answer} />
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  import Chart from "chart.js/auto";
  import { GROWTH, REVIEWS, REVENUE, PRICING, GEOGRAPHY, NICHES, COLORS, CHART_LABELS } from "../../../lib/app-economy";

  Chart.defaults.font.family =
    "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif";
  Chart.defaults.color = "#475569";
  Chart.defaults.font.size = 13;

  const el = (id: string) => document.getElementById(id) as HTMLCanvasElement | null;
  const grid = "#eef0f2";
  const kfmt = (v: number) => (v >= 1000 ? v / 1000 + "K" : "" + v);
  const L = CHART_LABELS[document.documentElement.lang] ?? CHART_LABELS.en;

  const growth = el("c-growth");
  if (growth)
    new Chart(growth, {
      type: "line",
      data: {
        labels: GROWTH.labels,
        datasets: [
          {
            data: GROWTH.cumulative,
            borderColor: COLORS.primary,
            backgroundColor: "rgba(97,110,255,0.10)",
            fill: true,
            tension: 0.35,
            borderWidth: 2.5,
            pointRadius: 3,
            pointHoverRadius: 5,
            pointBackgroundColor: COLORS.primary,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: { callbacks: { label: (c) => Number(c.parsed.y).toLocaleString() + " apps live" } },
        },
        scales: {
          y: { beginAtZero: true, grid: { color: grid }, ticks: { callback: (v) => kfmt(Number(v)) } },
          x: { grid: { display: false } },
        },
      },
    });

  const donutOpts = (suffix: string) => ({
    responsive: true,
    maintainAspectRatio: false,
    cutout: "62%",
    plugins: {
      legend: { position: "bottom" as const, labels: { boxWidth: 12, boxHeight: 12, padding: 16 } },
      tooltip: { callbacks: { label: (c: any) => `${c.label}: ${c.parsed}${suffix}` } },
    },
  });

  const reviews = el("c-reviews");
  if (reviews)
    new Chart(reviews, {
      type: "doughnut",
      data: { labels: L.reviews, datasets: [{ data: REVIEWS.values, backgroundColor: REVIEWS.colors, borderWidth: 0 }] },
      options: {
        ...donutOpts("%"),
        plugins: {
          legend: { position: "bottom" as const, labels: { boxWidth: 12, boxHeight: 12, padding: 16 } },
          tooltip: {
            callbacks: {
              title: (it: any) => L.reviewsTip.title.replace("{x}", it[0].label),
              label: (c: any) => L.reviewsTip.body.replace("{n}", REVIEWS.counts[c.dataIndex].toLocaleString()).replace("{p}", c.parsed),
            },
          },
        },
      },
    });

  const revDonut = el("c-revenue-donut");
  if (revDonut)
    new Chart(revDonut, {
      type: "doughnut",
      data: { labels: L.revenueDonut, datasets: [{ data: REVENUE.donut.values, backgroundColor: REVENUE.donut.colors, borderWidth: 0 }] },
      options: donutOpts("%"),
    });

  const revCountries = el("c-revenue-countries");
  if (revCountries)
    new Chart(revCountries, {
      type: "doughnut",
      data: { labels: L.revenueCountries, datasets: [{ data: REVENUE.countries.values, backgroundColor: REVENUE.countries.colors, borderWidth: 0 }] },
      options: {
        ...donutOpts("%"),
        plugins: {
          legend: { position: "bottom" as const, labels: { boxWidth: 12, boxHeight: 12, padding: 16 } },
          tooltip: { callbacks: { title: (it: any) => L.revenueCountriesFull[it[0].dataIndex], label: (c: any) => `${L.revenueCountriesFull[c.dataIndex]}: ${c.parsed}%` } },
        },
      },
    });

  const pricing = el("c-pricing");
  if (pricing)
    new Chart(pricing, {
      type: "doughnut",
      data: { labels: L.pricing, datasets: [{ data: PRICING.values, backgroundColor: PRICING.colors, borderWidth: 0 }] },
      options: donutOpts("%"),
    });

  // The "by review tier" chart shows the top 10 builders by whatever tiers are
  // toggled on, drawn from the full GEOGRAPHY.builders pool (16 countries). So
  // toggling tiers can swap countries in and out: showing only "0 reviews"
  // surfaces the biggest noise generators (Pakistan), only "10+" surfaces Israel
  // and Singapore. geoTopTen ranks the pool for a given tier visibility
  // [zero, low, mid, high, vhigh]; applyGeoTop pushes the result into the chart.
  const geoCountry = (en: string) => L.geoCountries?.[en] ?? en;
  const geoPool = GEOGRAPHY.builders.labels.map((label: string, i: number) => ({
    label: geoCountry(label),
    tiers: [GEOGRAPHY.builders.zero[i], GEOGRAPHY.builders.low[i], GEOGRAPHY.builders.mid[i], GEOGRAPHY.builders.high[i], GEOGRAPHY.builders.vhigh[i]],
  }));
  const geoTopTen = (vis: boolean[]) =>
    geoPool
      .map((c: any) => ({
        ...c,
        sum: c.tiers.reduce((s: number, v: number, t: number) => s + (vis[t] ? v : 0), 0),
      }))
      .sort((a: any, b: any) => b.sum - a.sum)
      .slice(0, 10);
  const applyGeoTop = (chart: any) => {
    const top = geoTopTen([0, 1, 2, 3, 4].map((t) => chart.isDatasetVisible(t)));
    chart.data.labels = top.map((c: any) => c.label);
    [0, 1, 2, 3, 4].forEach((t) => {
      chart.data.datasets[t].data = top.map((c: any) => c.tiers[t]);
    });
  };

  const geoTiers = L.geoTiers ?? CHART_LABELS.en.geoTiers!;
  const geoInit = geoTopTen([true, true, true, true, true]);
  const geo = el("c-geography");
  if (geo)
    new Chart(geo, {
      type: "bar",
      data: {
        labels: geoInit.map((c: any) => c.label),
        datasets: [
          { label: geoTiers[0], data: geoInit.map((c: any) => c.tiers[0]), backgroundColor: "#e2e8f0", borderWidth: 0 },
          { label: geoTiers[1], data: geoInit.map((c: any) => c.tiers[1]), backgroundColor: COLORS.gray, borderWidth: 0 },
          { label: geoTiers[2], data: geoInit.map((c: any) => c.tiers[2]), backgroundColor: COLORS.secondary, borderWidth: 0 },
          { label: geoTiers[3], data: geoInit.map((c: any) => c.tiers[3]), backgroundColor: "#579cff", borderWidth: 0 },
          { label: geoTiers[4], data: geoInit.map((c: any) => c.tiers[4]), backgroundColor: COLORS.primary, borderWidth: 0 },
        ],
      },
      options: {
        indexAxis: "y",
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: "bottom" as const,
            labels: { boxWidth: 12, boxHeight: 12, padding: 14 },
            onClick(_e, item, legend) {
              const ch = legend.chart;
              const i = item.datasetIndex ?? 0;
              ch.setDatasetVisibility(i, !ch.isDatasetVisible(i));
              applyGeoTop(ch);
              ch.update();
            },
          },
          tooltip: { callbacks: { label: (c) => `${c.dataset.label}: ${Number(c.parsed.x).toLocaleString()}` } },
        },
        scales: {
          x: { stacked: true, beginAtZero: true, grid: { color: grid }, ticks: { callback: (v) => kfmt(Number(v)) } },
          y: { stacked: true, grid: { display: false } },
        },
      },
    });

  // Sectors: every sector's apps stacked by the 5 review tiers, bar length = the
  // sector's total app count. Same absolute view as the geography chart, and like
  // it the bars re-sort (largest first) by the visible total whenever a tier is
  // toggled in the legend. nicheSorted ranks the pool for a tier-visibility mask;
  // applyNicheSort pushes the result (labels + per-tier data) into the chart.
  const nicheLabels = L.niches ?? CHART_LABELS.en.niches!;
  const nichePool = NICHES.tiers.map((tiers: number[], i: number) => ({ label: nicheLabels[i], tiers }));
  const nicheSorted = (vis: boolean[]) =>
    nichePool
      .map((r: any) => ({ ...r, sum: r.tiers.reduce((s: number, v: number, t: number) => s + (vis[t] ? v : 0), 0) }))
      .sort((a: any, b: any) => b.sum - a.sum);
  const nicheRowLabel = (r: any) => r.label;
  const applyNicheSort = (chart: any) => {
    const rows = nicheSorted([0, 1, 2, 3, 4].map((t) => chart.isDatasetVisible(t)));
    chart.data.labels = rows.map(nicheRowLabel);
    [0, 1, 2, 3, 4].forEach((t) => {
      chart.data.datasets[t].data = rows.map((r: any) => r.tiers[t]);
    });
  };
  const niches = el("c-niches");
  if (niches) {
    const nicheInit = nicheSorted([true, true, true, true, true]);
    new Chart(niches, {
      type: "bar",
      data: {
        labels: nicheInit.map(nicheRowLabel),
        datasets: [0, 1, 2, 3, 4].map((t) => ({
          label: geoTiers[t],
          data: nicheInit.map((r: any) => r.tiers[t]),
          backgroundColor: REVIEWS.colors[t],
          borderWidth: 0,
        })),
      },
      options: {
        indexAxis: "y",
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: "bottom" as const,
            labels: { boxWidth: 12, boxHeight: 12, padding: 14 },
            onClick(_e, item, legend) {
              const ch = legend.chart;
              const i = item.datasetIndex ?? 0;
              ch.setDatasetVisibility(i, !ch.isDatasetVisible(i));
              applyNicheSort(ch);
              ch.update();
            },
          },
          tooltip: {
            callbacks: {
              label: (c) => {
                const v = Number(c.parsed.x);
                const tot = c.chart.data.datasets.reduce((s: number, d: any, t: number) => s + (c.chart.isDatasetVisible(t) ? Number(d.data[c.dataIndex]) : 0), 0);
                return `${c.dataset.label}: ${v.toLocaleString()} (${tot ? Math.round((100 * v) / tot) : 0}%)`;
              },
            },
          },
        },
        scales: {
          x: { stacked: true, beginAtZero: true, grid: { color: grid }, ticks: { callback: (v) => kfmt(Number(v)) } },
          y: { stacked: true, grid: { display: false } },
        },
      },
    });
  }
</script>
