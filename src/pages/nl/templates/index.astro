---
import Base from "../../../layouts/Base.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import { organization, breadcrumb, softwareApplication } from "../../../lib/schema";
import { SITE } from "../../../lib/site";
import { SOLUTIONS, FEATURED_SOLUTIONS } from "../../../lib/solutions";
import { localizedHref } from "../../../lib/i18n";

const lang = "nl";
const lp = (path: string) => localizedHref(path, lang);

const featuredSolutions = FEATURED_SOLUTIONS.map((slug) => SOLUTIONS[slug]!);

interface Template {
  title: string;
  description: string;
  image: string;
  demo: string;
}

interface TemplateGroup {
  id: string;
  label: string;
  items: Template[];
}

const groups: TemplateGroup[] = [
  {
    id: "skincare",
    label: "Huidverzorging, haarverzorging en cosmetica",
    items: [
      { title: "Huidtype- + routinequiz", description: "Bepaal het huidtype en beveel een complete routine aan.", image: "/img/pages/templates/skinquiz1.webp", demo: "https://productrecommendationquiz.com/pages/skin-analysis" },
      { title: "Vind je foundation", description: "De juiste foundation kiezen zou geen gokwerk moeten zijn.", image: "/img/pages/templates/foundation5.webp", demo: "https://productrecommendationquiz.com/pages/foundation-match" },
      { title: "Lipstickkleurzoeker", description: "Vind voor elke klant de perfecte lipstickkleur op basis van huidtint en stijl.", image: "/img/pages/templates/lips1-e1768405685573.webp", demo: "https://productrecommendationquiz.com/pages/lipstick-shade-finder" },
      { title: "Haarverzorgingsquiz", description: "Beveel shampoos, conditioners en behandelingen aan op basis van ieders haardoelen.", image: "/img/pages/templates/hairquiz4.webp", demo: "https://productrecommendationquiz.com/pages/haircare-quiz" },
    ],
  },
  {
    id: "food",
    label: "Voeding en gezondheid",
    items: [
      { title: "Koffiequiz", description: "Begeleid je klanten naar de ideale koffieblend op basis van smaak en levensstijl.", image: "/img/pages/templates/coffee2.webp", demo: "https://productrecommendationquiz.com/pages/coffee-quiz" },
      { title: "Supplementenquiz", description: "Beveel vitaminen en supplementen aan die aansluiten op hun gezondheidsdoelen.", image: "/img/pages/templates/supplements3.webp", demo: "https://productrecommendationquiz.com/pages/supplements-quiz" },
      { title: "CBD-productzoeker", description: "Stel de juiste CBD-producten voor om te ontspannen, slapen of focussen.", image: "/img/pages/templates/cbd1.webp", demo: "https://productrecommendationquiz.com/pages/cbd-product-finder" },
      { title: "Hondenvoerquiz", description: "Vind het perfecte voer voor je hond op basis van zijn specifieke behoeften en voorkeuren.", image: "/img/pages/templates/dogquiz3.webp", demo: "https://productrecommendationquiz.com/pages/dog-food" },
    ],
  },
  {
    id: "clothes",
    label: "Sport, kleding en mode",
    items: [
      { title: "Sieradenquiz", description: "Help je shoppers het perfecte sieraad voor hun stijl te vinden.", image: "/img/pages/templates/jewellery1-e1768405517428.webp", demo: "https://productrecommendationquiz.com/pages/jewellery-quiz" },
      { title: "Kledingstijlquiz", description: "Ontdek je modepersoonlijkheid en ontvang gepersonaliseerde aanbevelingen.", image: "/img/pages/templates/style1.webp", demo: "https://productrecommendationquiz.com/pages/clothing-style-quiz" },
      { title: "Fietsenquiz", description: "Vind voor elke klant de juiste fiets op basis van zijn rijstijl en behoeften.", image: "/img/pages/templates/bike2.webp", demo: "https://productrecommendationquiz.com/pages/bicycle-quiz" },
    ],
  },
];

const gallery = [
  "Screenshot-2020-09-29-at-20.20.43.webp",
  "Screenshot-2020-09-29-at-20.33.39.webp",
  "Screenshot-2020-09-29-at-20.34.03.webp",
  "Screenshot-2020-09-29-at-20.34.16.webp",
  "Screenshot-2020-10-20-at-11.31.49.webp",
  "Screenshot-2020-10-20-at-11.32.06.webp",
  "Screenshot-2020-10-20-at-11.33.20.webp",
  "Screenshot-2020-10-20-at-11.33.57.webp",
  "Screenshot-2020-10-20-at-11.39.39.webp",
  "Screenshot-2020-10-20-at-11.41.15.webp",
  "Screenshot-2020-10-20-at-11.41.36.webp",
  "Screenshot-2020-10-20-at-11.41.51.webp",
  "Screenshot-2020-10-20-at-11.44.30.webp",
  "Screenshot-2020-10-20-at-11.45.11.webp",
  "Screenshot-2020-10-20-at-11.45.42.webp",
  "Screenshot-2020-11-16-at-14.34.09.webp",
  "Screenshot-2020-11-16-at-14.34.22.webp",
  "Screenshot-2020-11-16-at-14.34.34.webp",
  "Screenshot-2020-11-16-at-14.36.54.webp",
  "Screenshot-2020-12-04-at-08.38.54.webp",
  "Screenshot-2020-12-04-at-08.39.14.webp",
  "Screenshot-2020-12-04-at-08.39.25.webp",
  "Screenshot-2020-12-04-at-08.39.35.webp",
  "Screenshot-2021-04-14-at-04.13.10.webp",
  "Screenshot-2021-04-14-at-04.13.50.webp",
  "Screenshot-2021-04-14-at-04.14.16.webp",
  "Screenshot-2021-05-13-at-22.49.10.webp",
];

const reasons = [
  { emoji: "🚀", title: "Snelle installatie voor Shopify en WooCommerce", body: "De templates integreren naadloos met Shopify, WooCommerce, BigCommerce en standalone sites. Geen code: installeer de app, kies een template en pas hem aan zodat hij bij je merk past." },
  { emoji: "💡", title: "Vooraf gebouwde quizlogica en vragen", body: "Elke template bevat door experts opgestelde vragen, voorwaardelijke logica en algoritmes voor productaanbevelingen. Gebouwd op bewezen frameworks die conversies stimuleren in beauty, wellness, dierenverzorging en lifestyle." },
  { emoji: "📊", title: "Verhoog conversies en AOV", body: "Gepersonaliseerde aanbevelingen maken van kijkers kopers. De templates zijn geoptimaliseerd voor hogere conversiepercentages, grotere winkelwagentjes en beter gekwalificeerde leads." },
  { emoji: "🎨", title: "Volledig aanpasbare HTML", body: "Bewerk teksten, design, branding en logica zonder code aan te raken. Voor geavanceerde ontwikkeling is elke template ook volledig toegankelijk via aangepaste HTML, CSS en JS." },
  { emoji: "📧", title: "Verzamel zero-party data", body: "Leg voorkeuren, intentie en segmentatiegegevens rechtstreeks bij de koper vast en synchroniseer ze vervolgens met Klaviyo, Omnisend, Meta of GA4 om je vervolgmarketing te versterken." },
  { emoji: "⚡", title: "Responsive en geoptimaliseerd voor mobiel", body: "Elke template wordt mobile-first geleverd. Snel, toegankelijk en ontworpen om native aan te voelen op mobiel, tablet en desktop." },
];

const jsonLd = [
  organization(),
  softwareApplication(),
  breadcrumb([
    { name: "Home", url: "/" },
    { name: "Quiztemplates", url: "/templates/" },
  ]),
];
---

<Base
  title="Quiztemplates - RevenueHunt"
  description="Productquiz-templates voor Shopify, WooCommerce, BigCommerce en standalone winkels. Huidverzorging, beauty, supplementen, diervoeding, kleding, sport en meer: vooraf gebouwde vragen, voorwaardelijke logica en algoritmes voor productaanbevelingen."
  jsonLd={jsonLd}
  lang="nl"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20 text-center">
      <Breadcrumb items={[{ label: "Home", href: lp("/") }, { label: "Quiztemplates" }]} />
      <Eyebrow>Quiztemplates</Eyebrow>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Productquiz-templates voor Shopify en WooCommerce
      </h1>
      <p class="mt-4 text-xl font-semibold text-slate-700">
        Interactieve productaanbevelingsquiz-templates: klaar voor gebruik
      </p>
      <p class="mx-auto mt-6 max-w-3xl text-slate-600">
        Ontdek onze collectie <strong class="font-semibold text-slate-900">gratis quiztemplates</strong> ontworpen voor ecommercewinkels.
        Van skincare- en beautyquizzen tot supplementen, diervoeding en lifestyleproducten: elke template is gemaakt om je te helpen
        een gepersonaliseerde shopervaring te bieden die converteert. Perfect voor <strong class="font-semibold text-slate-900">Shopify</strong>,
        <strong class="font-semibold text-slate-900">WooCommerce</strong>, <strong class="font-semibold text-slate-900">BigCommerce</strong>,
        en <strong class="font-semibold text-slate-900">standalone</strong> winkels.
      </p>
      <p class="mx-auto mt-4 max-w-3xl text-slate-600">
        Deze quiztemplates in aanpasbare HTML bevatten kant-en-klare vragen, voorwaardelijke logica en algoritmes voor productaanbevelingen.
        Kies een template, koppel je producten, pas het design aan en publiceer. Klik op een template hieronder om een live demo te bekijken.
      </p>
    </div>
  </section>

  <!-- Top CTA banner -->
  <section class="mx-auto max-w-7xl px-6 pb-8">
    <div class="overflow-hidden rounded-2xl bg-[#16161D] px-8 py-12 text-center text-white">
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Probeer onze productquiz-templates live</h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        Ervaar volledig werkende productaanbevelingsquizzen in onze live Shopify-demowinkel. Probeer verschillende quiztypes,
        verken de voorwaardelijke logica, vertakkende vragen en gepersonaliseerde productaanbevelingen in actie.
      </p>
      <a
        href="https://productrecommendationquiz.com/"
        target="_blank"
        rel="external noopener nofollow"
        class="mt-8 inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
      >
        Bekijk de live quizdemo's
      </a>
    </div>
  </section>

  <!-- Category nav -->
  <nav class="sticky top-[60px] z-30 border-y border-slate-200 bg-white/95 backdrop-blur" aria-label="Template categories">
    <ul class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-2 px-6 py-3">
      {groups.map((g) => (
        <li>
          <a
            href={`#${g.id}`}
            class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-[#16161D] hover:text-[#16161D]"
          >
            {g.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href="#gallery"
          class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-[#16161D] hover:text-[#16161D]"
        >
          Galerij met quizvoorbeelden
        </a>
      </li>
    </ul>
  </nav>

  <!-- Template grids -->
  <section class="mx-auto max-w-7xl px-6 py-12">
    {groups.map((g) => (
      <div id={g.id} class="mb-16 scroll-mt-32 last:mb-0">
        <h2 class="mb-8 text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">{g.label}</h2>
        <ul class="grid gap-6 md:grid-cols-2">
          {g.items.map((t) => (
            <li class="flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md">
              <a
                href={t.demo}
                target="_blank"
                rel="external noopener nofollow"
                class="block aspect-[321/217] overflow-hidden bg-slate-50"
              >
                <img src={t.image} alt={t.title} loading="lazy" class="h-full w-full object-cover" />
              </a>
              <div class="flex flex-1 flex-col p-5">
                <h3 class="text-lg font-semibold text-slate-900">{t.title}</h3>
                <p class="mt-2 text-sm text-slate-600">{t.description}</p>
                <div class="mt-5 flex flex-wrap gap-2">
                  <a
                    href={t.demo}
                    target="_blank"
                    rel="external noopener nofollow"
                    class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#26262e]"
                  >
                    Demo
                  </a>
                  <a
                    href={lp("/product-recommendation-quiz/")}
                    class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-4 py-2 text-sm font-semibold text-[#16161D] transition hover:bg-slate-50"
                  >
                    Krijg deze template
                  </a>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <!-- Examples gallery -->
    <div id="gallery" class="scroll-mt-32">
      <h2 class="mb-8 text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Galerij met quizvoorbeelden</h2>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {gallery.map((file) => (
          <li class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
            <a href={`/img/pages/templates/${file}`} target="_blank" rel="noopener" class="block aspect-video overflow-hidden bg-slate-50">
              <img src={`/img/pages/templates/${file}`} alt="Quizvoorbeeld" loading="lazy" class="h-full w-full object-cover" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Solutions cross-link -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 pb-4">
      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-8">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Weet je niet welke quiz je moet maken?</h2>
        <p class="mt-3 text-slate-700">
          Onze quizoplossingen leggen uit welk quiztype het beste is voor jouw sector, van skincareroutines tot cadeauzoekers, met voorbeelden en FAQ's.
        </p>
        <ul class="mt-6 flex flex-wrap gap-3" role="list">
          {featuredSolutions.map((s) => (
            <li>
              <a
                href={`/solutions/${s.slug}/`}
                class="inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-[#16161D] hover:text-[#16161D]"
              >
                {s.name}
              </a>
            </li>
          ))}
          <li>
            <a
              href={lp("/solutions/")}
              class="inline-flex items-center rounded-full bg-[#16161D] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#26262e]"
            >
              Alle oplossingen →
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Why use templates -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Waarom productquiz-templates gebruiken in je ecommercewinkel?
      </h2>
      <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {reasons.map((r) => (
          <li class="rounded-xl border border-slate-200 bg-white p-6">
            <div class="text-2xl">{r.emoji}</div>
            <h3 class="mt-3 text-lg font-semibold text-slate-900">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{r.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Begin vandaag met het bouwen van je productquiz
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        Bouw aantrekkelijke productaanbevelingsquizzen voor je Shopify- of WooCommerce-winkel in enkele minuten. Geen code.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SITE.signup_url}
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          Probeer de quiztemplates gratis
        </a>
        <a
          href={lp("/demo/")}
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          Een demo boeken
        </a>
      </div>
    </div>
  </section>
</Base>
