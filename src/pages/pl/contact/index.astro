---
import Base from "../../../layouts/Base.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import YouTubeFacade from "../../../components/YouTubeFacade.astro";
import { organization, breadcrumb } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Strona główna", url: "/" },
    { name: "Kontakt", url: "/contact/" },
  ]),
];

const channels = [
  {
    label: "Przeczytaj przewodniki pomocy",
    href: "https://docs.revenuehunt.com/",
    note: "Dokumentacja samoobsługowa, integracje, rozwiązywanie problemów.",
    external: true,
  },
  {
    label: "Wsparcie i sprzedaż przez email",
    href: "mailto:team@revenuehunt.com",
    note: "team@revenuehunt.com - sprawdź czasy odpowiedzi poniżej.",
  },
  {
    label: "Sprawdź status systemu",
    href: "https://status.revenuehunt.com/",
    note: "Kondycja usługi w czasie rzeczywistym i historia incydentów. Dostępność 99,98%+.",
    external: true,
  },
];

const responseTiers = [
  {
    label: "Krytyczny - awaria produkcji, bezpieczeństwo, integralność danych",
    sla: "Pierwsza odpowiedź w 30 minut, 24/7 na całym świecie",
  },
  {
    label: "Wysoki - ważna funkcja niesprawna, wielu użytkowników dotkniętych",
    sla: "Pierwsza odpowiedź w 12 godzin",
  },
  {
    label: "Standardowy - pytania, pomoc z konfiguracją",
    sla: "1 dzień roboczy",
  },
  {
    label: "Niski priorytet - opinie, prośby o funkcje",
    sla: "Do 3 dni roboczych",
  },
];
---

<Base
  title="Kontakt - RevenueHunt"
  description="Skontaktuj się z zespołem wsparcia RevenueHunt. Przeczytaj przewodniki pomocy, obejrzyj tutorial lub wypełnij quiz wsparcia, aby uzyskać spersonalizowaną odpowiedź w kilka minut."
  jsonLd={jsonLd}
  lang="pl"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20 text-center">
      <Breadcrumb items={[{ label: "Strona główna", href: localizedHref("/", "pl") }, { label: "Kontakt" }]} />
      <Eyebrow>Napisz do nas</Eyebrow>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Skontaktuj się z nami
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600">
        Przeczytaj przewodniki pomocy, obejrzyj tutorial lub wypełnij nasz quiz wsparcia poniżej - odpowie Ci
        najbystrzejszy i najbardziej przyjazny zespół wsparcia w ecommerce.
      </p>
    </div>
  </section>

  <!-- Two-column: video + channels -->
  <section class="mx-auto max-w-7xl px-6 py-12">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Zacznij od tutoriala</h2>
        <p class="mt-3 text-slate-600">
          Większość pytań rozwiązuje 3-minutowy przewodnik. Rzuć na niego okiem, zanim do nas napiszesz.
        </p>
        <div class="mt-6 aspect-video overflow-hidden rounded-xl bg-slate-900 shadow-xl">
          <YouTubeFacade id="oL1DnBd6N1U" title="Tutorial wsparcia RevenueHunt" />
        </div>
      </div>
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Jak się z nami skontaktować</h2>
        <ul class="mt-6 space-y-3">
          {channels.map((c) => (
            <li>
              <a
                href={c.href}
                target={c.external ? "_blank" : undefined}
                rel={c.external ? "external noopener" : undefined}
                class="group flex items-start justify-between gap-4 rounded-xl border border-slate-200 bg-white p-5 transition hover:border-slate-300 hover:shadow-md"
              >
                <div>
                  <p class="text-base font-semibold text-slate-900 group-hover:text-[#16161D]">{c.label}</p>
                  <p class="mt-1 text-sm text-slate-600">{c.note}</p>
                </div>
                <span class="mt-1 shrink-0 text-slate-400 transition group-hover:text-[#16161D]" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Support quiz -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Wypełnij nasz quiz wsparcia</h2>
      <p class="mx-auto mt-3 max-w-2xl text-slate-600">
        Odpowiedz na kilka szybkich pytań, a skierujemy Cię do odpowiedniej pomocy - dokumentacji, tutoriala lub odpowiedzi od prawdziwej osoby.
      </p>
      <div class="mx-auto mt-8 max-w-4xl overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <iframe
          src="https://admin.revenuehunt.com/public/quiz/ZAHJoMM"
          title="Quiz wsparcia RevenueHunt"
          loading="lazy"
          class="block h-[600px] w-full"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Response times — moved here from the right column so it sits under
       the quiz, since that's where visitors land after asking for help. -->
  <section class="mx-auto max-w-4xl px-6 py-16">
    <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm sm:p-10">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Czasy odpowiedzi</h2>
      <p class="mt-3 text-slate-600">
        Wielopoziomowe SLA wsparcia dla wszystkich sprzedawców, z priorytetem dla kont Shopify Plus i enterprise.
      </p>
      <dl class="mt-6 grid gap-4 sm:grid-cols-2">
        {responseTiers.map((t) => (
          <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
            <dt class="text-sm font-semibold text-slate-900">{t.label}</dt>
            <dd class="mt-1 text-sm text-slate-600">{t.sla}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Base>
