---
import Base from "../../layouts/Base.astro";
import PlanCards from "../../components/pages/PlanCards.astro";
import YouTubeFacade from "../../components/YouTubeFacade.astro";
import { organization, website, softwareApplication } from "../../lib/schema";
import { SITE } from "../../lib/site";
import { localizedHref } from "../../lib/i18n";

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=bfs_badge_hero";
const WOOCOMMERCE_DOWNLOAD =
  "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";
const YOUTUBE_ID = "fJqpGJUzZNE";

const stats = [
  { value: "+20,000", label: "Marek korzystających z RevenueHunt" },
  { value: "+45M", label: "Ukończonych quizów" },
  { value: "+370M USD", label: "Przychodów dla sprzedawców" },
  { value: "4.9 ★", label: "Ponad 450 pięciogwiazdkowych recenzji" },
];

const pillars = [
  {
    image: "/img/pages/home/recommend-right-products.svg",
    title: "Polecaj odpowiednie produkty",
    body:
      "Quizy ze zintegrowanymi produktami napędzają sprzedaż, doradzają klientom w znalezieniu odpowiednich dla nich produktów i pomagają im podejmować decyzje zakupowe z pewnością.",
  },
  {
    image: "/img/pages/home/know-your-customers.svg",
    title: "Poznaj swoich klientów",
    body:
      "Quizy pozwalają Ci zbierać użyteczne dane, zadając klientom konkretne pytania. Segmentuj i taguj kupujących na podstawie ich odpowiedzi.",
  },
  {
    image: "/img/pages/home/grow-your-audience.svg",
    title: "Rozwijaj swoją publiczność",
    body:
      "Wysyłaj przechwycone leady na swoją listę mailingową lub do CRM. Wykorzystuj dane profilowe klientów, by tworzyć bardziej spersonalizowane kampanie marketingowe o wyższym ROI.",
  },
];

const features = [
  {
    kicker: "Copilot quizu z AI",
    title: "Stwórz quiz w 60 sekund z AI",
    body:
      "Opisz swój sklep, a nasz copilot z AI wygeneruje w pełni skonfigurowany quiz - pytania, logikę i przypisanie produktów - gotowy do publikacji.",
  },
  {
    kicker: "Logika warunkowa",
    title: "Logika rozgałęzień metodą przeciągnij i upuść",
    body:
      "Pokazuj lub ukrywaj pytania w zależności od wcześniejszych odpowiedzi. Poprowadź każdego kupującego ścieżką, która kończy się zakupem - bez potrzeby kodu.",
  },
  {
    kicker: "Projekt quizu",
    title: "Spersonalizuj go - bez potrzeby kodu",
    body:
      "Dostosuj kolory, czcionki, obrazy i układ, by pasowały do Twojej marki. Twój quiz wygląda jak część Twojego sklepu, a nie widget zewnętrznej firmy.",
  },
  {
    kicker: "Strona wyników",
    title: "Gotowa do checkoutu strona wyników, która konwertuje",
    body:
      "Pokazuj spersonalizowane rekomendacje produktów pogrupowane według kroku rutyny - ze zdjęciami, cenami i przyciskami dodania do koszyka. Kupujący kupują bezpośrednio ze strony wyników.",
  },
  {
    kicker: "Analityka porzuceń",
    title: "Wiedz dokładnie, gdzie kupujący rezygnują",
    body:
      "Sprawdzaj współczynniki porzuceń pytanie po pytaniu, ścieżki i wyniki. Naprawiaj punkty tarcia, poprawiaj ukończenia i odzyskuj utracone przychody.",
  },
  {
    kicker: "Integracje zewnętrzne",
    title: "Połącz cały swój stos marketingowy",
    body:
      "Wysyłaj dane z quizu do Google Analytics, wyzwalaj zdarzenia Meta Pixel do retargetingu i synchronizuj leady z Klaviyo - wszystko z jednej strony ustawień. Bez kodu, bez middleware.",
  },
];

const steps = [
  {
    title: "Zainstaluj aplikację",
    body: "Instalacja jednym kliknięciem z Shopify App Store lub katalogu wtyczek WordPress.",
  },
  {
    title: "Stwórz swój quiz",
    body: "Użyj copilota z AI lub edytora przeciągnij i upuść. Dodaj swoje pytania, zdefiniuj swoją logikę.",
  },
  {
    title: "Przypisz swoje produkty",
    body: "Połącz odpowiedzi z quizu ze swoim katalogiem produktów. Polecaj najlepsze dopasowanie dla każdego wyniku.",
  },
  {
    title: "Opublikuj i promuj",
    body: "Osadź go na dowolnej stronie, pokaż jako pop-up przy wykryciu zamiaru wyjścia lub linkuj do niego ze swoich reklam.",
  },
];

const testimonials = [
  {
    quote:
      "Przeszłam z Octane. Proces projektowania był znacznie bardziej intuicyjny i przyjemny wizualnie. Gdy miałam problem z Klaviyo, wsparcie odpowiedziało z prędkością błyskawicy i z bardzo bliskim, otwartym podejściem.",
    author: "Kae Paché",
  },
  {
    quote:
      "Eric był niezwykle cierpliwy, kompetentny i dokładny - prowadząc mnie krok po kroku przez konfigurację quizu. Takie wsparcie jest rzadkością.",
    author: "Marcelle",
  },
  {
    quote:
      "Sama aplikacja jest świetna: potężne funkcje, intuicyjna obsługa. Zespół stworzył dla nas spersonalizowany tutorial prowadzony krok po kroku. Używamy jej od ponad 3 lat.",
    author: "Didymos",
  },
  {
    quote:
      "Zdecydowanie najlepsza aplikacja do quizów i rekomendacji produktów, jaką testowałam na Shopify. Zespół poświęcił czas, by zbadać, wyjaśnić każdy krok jasno i poprowadzić mnie, aż problem został w pełni rozwiązany.",
    author: "REYNA",
  },
  {
    quote:
      "To była 5. aplikacja do quizów, jaką testowałem, i jedyna, która w pełni obsługiwała to, czego potrzebowałem. Mogłem stworzyć mój pierwszy quiz bardzo szybko.",
    author: "CCA Printing",
  },
  {
    quote:
      "Obsługa klienta wyróżnia się - agent nagrał wideo i wyjaśnił mi rozwiązanie krok po kroku. Bardzo responsywni i niezwykle pomocni.",
    author: "The Love U Collective",
  },
];

const verticals = [
  { icon: "💄", title: "Beauty i pielęgnacja skóry", body: "Wyszukiwarki typu skóry, dobór odcienia, kreatory rutyn." },
  { icon: "💊", title: "Suplementy", body: "Quizy celów zdrowotnych, które polecają odpowiedni zestaw." },
  { icon: "👗", title: "Moda", body: "Quizy stylu, które odkrywają odpowiedni rozmiar, kolor i krój." },
  { icon: "🐾", title: "Zwierzęta", body: "Rekomendacje produktów specyficzne dla rasy dla każdego właściciela." },
  { icon: "🍵", title: "Jedzenie i napoje", body: "Quizy profilu smaku, które zamieniają ciekawskich w subskrybentów." },
  { icon: "🏋️", title: "Fitness", body: "Lejki oparte na celach dla sprzętu, ubrań i programów." },
  { icon: "🏠", title: "Dom i dekoracje", body: "Quizy stylu, które dopasowują meble do każdej przestrzeni w domu." },
  { icon: "🌿", title: "Eko i zrównoważone", body: "Quizy łączące wartości dla świadomego konsumenta." },
];

const brands = [
  "Olaplex", "Madluvv", "Mattel", "Alt", "Baia", "Bare", "Biktrix",
  "Dermocracy", "Diego", "Gisou", "Laura", "Nuxe", "Olcay",
  "Salad Code", "Salugea", "Sunday", "Tushy", "Tiege",
];

const SHOPIFY_REVIEWS =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/reviews?ratings%5B%5D=5&sort_by=relevance";
const WOOCOMMERCE_REVIEWS =
  "https://wordpress.org/support/plugin/product-recommendation-quiz-for-ecommerce/reviews/?filter=5";
---

<Base
  lang="pl"
  translated={true}
  title={`${SITE.name} - quiz rekomendacji produktów, który konwertuje`}
  description="Zamień ciekawskich, którzy tylko oglądają, w kupujących dzięki prowadzonemu quizowi rekomendacji produktów. Przechwytuj zero-party data, polecaj odpowiedni produkt i zwiększaj konwersję. Bez kodu."
  jsonLd={[organization(), website(), softwareApplication()]}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-7xl px-6 py-16 lg:py-24">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:items-start lg:gap-16">
        <div>
          <a
            href={SHOPIFY_INSTALL}
            rel="external nofollow"
            onclick="window.gtag&&gtag('event','shopify_app_install',{event_label:'home_hero_badge'})"
            class="mb-6 inline-block"
          >
            <img
              src="/img/home/bfs-badge.webp"
              alt="Built for Shopify"
              width="120"
              height="38"
              class="h-8 w-auto"
              loading="eager"
            />
          </a>
          <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
            Quiz rekomendacji produktów, który zamienia ciekawskich w kupujących
          </h1>
          <p class="mt-6 max-w-xl text-lg text-slate-700">
            Płatne reklamy przynoszą kliknięcia - nasze quizy zamieniają je w sprzedaż. RevenueHunt prowadzi kupujących do odpowiednich produktów,
            zbiera dane i napędza konwersje. Łatwy w instalacji, bez kodu.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={SHOPIFY_INSTALL}
              rel="external nofollow"
              onclick="window.gtag&&gtag('event','shopify_app_install',{event_label:'home_hero'})"
              class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
            >
              zainstaluj na Shopify
            </a>
            <a
              href={WOOCOMMERCE_DOWNLOAD}
              rel="external nofollow"
              onclick="window.gtag&&gtag('event','download_woocommerce_plugin',{event_label:'home_hero'})"
              class="inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-6 py-3 text-base font-semibold text-slate-900 transition hover:border-slate-400 hover:bg-slate-50"
            >
              pobierz dla WooCommerce
            </a>
          </div>
          <p class="mt-4 text-sm text-slate-500">
            Dostępny darmowy plan · 15-dniowy darmowy okres próbny · 30-dniowa gwarancja zwrotu pieniędzy
          </p>
        </div>

        <div class="relative lg:mt-14">
          <div class="aspect-video overflow-hidden rounded-xl bg-slate-900 shadow-2xl">
            <YouTubeFacade
              id={YOUTUBE_ID}
              title="RevenueHunt - Quiz rekomendacji produktów"
              poster="/img/home/video-poster.webp"
              alt="Demo quizu rekomendacji produktów RevenueHunt dla sklepów Shopify i WooCommerce"
              eager
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats / proof bar -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <p class="text-center text-sm font-semibold uppercase tracking-wider text-white/70">
        Dlaczego warto wybrać RevenueHunt? Nasz wpływ mówi sam za siebie
      </p>
      <dl class="mt-8 grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-4">
        {stats.map((s) => (
          <div class="text-center">
            <dt class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{s.value}</dt>
            <dd class="mt-2 text-sm text-white/70">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Problem framing -->
  <section class="mx-auto max-w-4xl px-6 py-20 text-center">
    <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
      Kupujący nie zawsze wiedzą, co kupić - a to oznacza utraconą sprzedaż.
    </h2>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-700">
      Nasz <a href={localizedHref("/product-recommendation-quiz/", "pl")} class="font-semibold text-slate-900 underline underline-offset-4 hover:text-slate-700">quiz rekomendacji produktów</a> prowadzi każdego klienta przez całą jego ścieżkę, pomagając mu odkryć i kupić odpowiednie dla niego produkty.
    </p>
  </section>

  <!-- 3-up pillars -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="grid gap-10 md:grid-cols-3">
        {pillars.map((p) => (
          <div class="text-center">
            <img src={p.image} alt={p.title} width="120" height="120" class="mx-auto h-24 w-24" loading="lazy" />
            <h3 class="mt-6 text-xl font-semibold text-slate-900">{p.title}</h3>
            <p class="mt-3 text-slate-600">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features grid -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Wszystko, czego potrzebujesz, by sprzedawać mądrzej</h2>
      </div>
      <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {features.map((f) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">{f.kicker}</p>
            <h3 class="mt-2 text-xl font-semibold text-slate-900">{f.title}</h3>
            <p class="mt-3 text-slate-600">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4-step setup -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Gotowy w 4 krokach. W mniej niż 15 minut.</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          Bez programistów. Bez kodu. Po prostu quiz, który Twoi klienci pokochają.
        </p>
      </div>
      <ol class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <li class="rounded-xl border border-slate-200 bg-white p-6">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-[#16161D] text-sm font-bold text-white">{i + 1}</span>
            <h3 class="mt-4 text-lg font-semibold text-slate-900">{s.title}</h3>
            <p class="mt-2 text-slate-600">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          Odkryj, dlaczego sprzedawcy kochają quiz rekomendacji produktów
        </h2>
        <p class="mx-auto mt-4 max-w-3xl text-lg text-slate-700">
          Zaufało nam ponad 20.000 marek, a wspiera nas ponad 450 pięciogwiazdkowych recenzji na Shopify, WooCommerce i więcej -
          RevenueHunt to wiodąca aplikacja do quizów, która napędza sprzedaż dzięki personalizacji. Ale nie wierz nam na słowo.
        </p>
        <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap text-sm">
          <a href={SHOPIFY_REVIEWS} rel="external nofollow" class="font-semibold text-[#16161D] underline-offset-4 hover:underline">
            Recenzje na Shopify →
          </a>
          <a href={WOOCOMMERCE_REVIEWS} rel="external nofollow" class="font-semibold text-[#16161D] underline-offset-4 hover:underline">
            Recenzje na WooCommerce →
          </a>
        </div>
      </div>

      <h3 class="mt-16 text-center text-xl font-semibold text-slate-900">Co mówią sprzedawcy</h3>
      <div class="rh-carousel mt-8">
        <ul data-carousel class="rh-carousel__track" aria-label="Opinie sprzedawców">
          {testimonials.map((t) => (
            <li class="rounded-xl border border-slate-200 bg-white p-6">
              <p class="text-amber-500" aria-label="5 z 5 gwiazdek">★★★★★</p>
              <blockquote class="mt-3 text-slate-700">"{t.quote}"</blockquote>
              <p class="mt-4 text-sm font-semibold text-slate-900"> - {t.author}</p>
            </li>
          ))}
        </ul>
        <div data-carousel-dots class="rh-carousel__dots"></div>
      </div>
    </div>
  </section>

  <!-- Verticals -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Stworzony dla każdej branży eCommerce</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          Niezależnie od tego, czy sprzedajesz pielęgnację skóry, suplementy czy sofy - quiz, który pomaga kupującym znaleźć odpowiedni produkt, konwertuje lepiej niż jakakolwiek strona kolekcji.
        </p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {verticals.map((v) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6">
            <span class="block text-3xl" aria-hidden="true">{v.icon}</span>
            <h3 class="mt-3 text-base font-semibold text-slate-900">{v.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Brand logos -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-white sm:text-3xl">Napędzamy najlepsze marki eCommerce</h2>
      <div class="brands-marquee mt-10">
        <ul class="brands-marquee__track" aria-label="Logo marek klientów">
          {brands.map((b) => (
            <li class="brands-marquee__item">
              <img
                src={`/img/brands/${b.toLowerCase().replace(/ /g, "-")}.svg`}
                alt={b}
                loading="lazy"
                width="160"
                height="40"
              />
            </li>
          ))}
          {brands.map((b) => (
            <li class="brands-marquee__item" aria-hidden="true">
              <img
                src={`/img/brands/${b.toLowerCase().replace(/ /g, "-")}.svg`}
                alt={`${b} logo`}
                loading="lazy"
                width="160"
                height="40"
              />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <style>
    .brands-marquee {
      overflow: hidden;
      -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
      mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    }
    .brands-marquee__track {
      display: flex;
      align-items: center;
      width: max-content;
      list-style: none;
      padding: 0;
      margin: 0;
      animation: brands-marquee 40s linear infinite;
    }
    .brands-marquee:hover .brands-marquee__track {
      animation-play-state: paused;
    }
    .brands-marquee__item {
      flex-shrink: 0;
      padding: 10px 24px;
      height: 64px;
      display: flex;
      align-items: center;
    }
    .brands-marquee__item img {
      height: 100%;
      width: auto;
      max-width: 160px;
      object-fit: contain;
      /* Normalize mixed-fill SVGs to white on the dark strip. */
      filter: brightness(0) invert(1);
      opacity: 0.85;
    }
    @keyframes brands-marquee {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }
    @media (prefers-reduced-motion: reduce) {
      .brands-marquee__track { animation: none; }
    }
  </style>

  <!-- Plans summary -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Wybierz najlepszy plan dla swojego eCommerce</h2>
        <p class="mt-4 text-base text-slate-700 sm:text-lg">
          Dostępny darmowy plan. 15-dniowy darmowy okres próbny z nieograniczoną liczbą odpowiedzi na quiz i wszystkimi funkcjami. 30-dniowa gwarancja zwrotu pieniędzy.
        </p>
      </div>

      <div class="mt-12">
        <PlanCards lang="pl" />
      </div>
    </div>
  </section>

  <!-- Multi-platform strip -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-16 text-center">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Działa na wielu platformach eCommerce</h2>
      <!-- Logos are white SVGs (built for a dark bg); brightness-0 inverts them to dark for this white section. -->
      <ul class="mt-10 flex flex-wrap items-center justify-center gap-x-14 gap-y-8">
        <li>
          <a href={localizedHref("/product-recommendation-quiz-shopify/", "pl")} aria-label="Quiz rekomendacji produktów dla Shopify">
            <img src="/img/logos/shopify_monotone_white.svg" alt="Shopify" class="h-8 w-auto opacity-60 brightness-0 transition hover:opacity-100" />
          </a>
        </li>
        <li>
          <a href={localizedHref("/product-recommendation-quiz-woocommerce/", "pl")} aria-label="Quiz rekomendacji produktów dla WooCommerce">
