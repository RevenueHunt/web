---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb, softwareApplication } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

interface Integration {
  name: string;
  category: string;
  logo: string;
  href: string;
}

const groups: { heading: string; emoji: string; intro: string; items: Integration[] }[] = [
  {
    heading: "Analityka i śledzenie",
    emoji: "📊",
    intro:
      "Mierz wydajność quizu, śledź konwersje i optymalizuj swój lejek. Dowiedz się dokładnie, które pytania generują sprzedaż, a gdzie klienci rezygnują.",
    items: [
      { name: "Google Analytics", category: "Dane", logo: "/img/pages/integrations/ganalytics.webp", href: "https://docs.revenuehunt.com/how-to-guides/integrate-google-analytics/" },
      { name: "Meta Pixel", category: "Dane", logo: "/img/pages/integrations/metapixel.webp", href: "https://docs.revenuehunt.com/how-to-guides/integrate-meta-pixel/" },
      { name: "TikTok Pixel", category: "Dane", logo: "/img/pages/integrations/tiktoklog.webp", href: "https://docs.revenuehunt.com/how-to-guides/integrate-tiktok-pixel/" },
      { name: "Webhooks", category: "Dane", logo: "/img/pages/integrations/webhooklog.webp", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-webhooks/" },
      { name: "Google Product Feed", category: "Produkty", logo: "/img/pages/integrations/googleproductfeed.webp", href: "/product-recommendation-quiz-standalone-google-product-feed/" },
    ],
  },
  {
    heading: "Marketing i automatyzacja",
    emoji: "✉️",
    intro:
      "Synchronizuj leady z quizu z platformą email lub CRM. Wysyłaj spersonalizowane follow-upy, segmentuj klientów według ich odpowiedzi i automatycznie zamieniaj leady w lojalnych klientów.",
    items: [
      { name: "Klaviyo", category: "Email marketing", logo: "/img/pages/integrations/klaviyolog.webp", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-klaviyo/" },
      { name: "ActiveCampaign", category: "Automatyzacja", logo: "/img/pages/integrations/activecampaignlog.webp", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-activecampaign/" },
      { name: "Mailchimp", category: "Email marketing", logo: "/img/pages/integrations/mailchimplog.webp", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-mailchimp/" },
      { name: "Omnisend", category: "Email marketing", logo: "/img/pages/integrations/omnisendlog.webp", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-omnisend/" },
      { name: "Zapier", category: "Automatyzacja", logo: "/img/pages/integrations/zapierlog.webp", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-zapier/" },
      { name: "HubSpot", category: "CRM", logo: "/img/pages/integrations/hubspotlog.webp", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-hubspot/" },
      { name: "Shopify Customers", category: "CRM", logo: "/img/pages/integrations/shopifylog.webp", href: "https://docs.revenuehunt.com/how-to-guides/send-leads-to-shopify-customers/" },
    ],
  },
  {
    heading: "Sprzedaż i dowód społeczny",
    emoji: "⭐",
    intro:
      "Taguj klientów w Shopify, polecaj subskrypcje i pokazuj recenzje, wszystko na podstawie odpowiedzi z quizu, by każdy kupujący widział dokładnie ten dowód i ofertę, które są dla niego istotne.",
    items: [
      { name: "ReCharge", category: "Subskrypcje", logo: "/img/pages/integrations/rechargelog.webp", href: "https://docs.revenuehunt.com/how-to-guides/recommend-subscriptions/" },
      { name: "Shopify Reviews", category: "Dowód społeczny", logo: "/img/pages/integrations/shopifyreviews.webp", href: "https://docs.revenuehunt.com/how-to-guides/show-product-reviews/" },
      { name: "Stamped", category: "Dowód społeczny", logo: "/img/pages/integrations/stampedlog.webp", href: "https://docs.revenuehunt.com/how-to-guides/show-product-reviews/" },
      { name: "Judge.me", category: "Dowód społeczny", logo: "/img/pages/integrations/judgemelog.webp", href: "https://docs.revenuehunt.com/how-to-guides/show-product-reviews/" },
      { name: "Rivyo Reviews", category: "Dowód społeczny", logo: "/img/pages/integrations/rivyolog.webp", href: "https://docs.revenuehunt.com/how-to-guides/show-product-reviews/" },
      { name: "POS Tablet Stands", category: "Sprzedaż w sklepie", logo: "/img/pages/integrations/poslog.webp", href: "/product-recommendation-quiz-pos-tablet-stands/" },
      { name: "Shop App", category: "Sprzedaż mobilna", logo: "/img/pages/integrations/shopapplog.webp", href: "https://docs.revenuehunt.com/how-to-guides/show-quiz-in-shop-app/" },
    ],
  },
];

const pillars = [
  {
    emoji: "📊",
    title: "Mierz wszystko",
    body: "Połącz z Google Analytics, Meta Pixel i TikTok, by mierzyć wydajność quizu i optymalizować swoje kampanie.",
  },
  {
    emoji: "✉️",
    title: "Automatyzuj follow-upy",
    body: "Synchronizuj leady z quizu z Klaviyo, Mailchimp lub ActiveCampaign, by automatycznie wysyłać spersonalizowane rekomendacje produktów.",
  },
  {
    emoji: "💰",
    title: "Zwiększ swoje przychody",
    body: "Taguj klientów w Shopify, polecaj subskrypcje z ReCharge i pokazuj dowód społeczny dzięki aplikacjom z recenzjami.",
  },
];

const stats = [
  { value: "20+", label: "Natywne integracje" },
  { value: "5 min", label: "Średni czas konfiguracji" },
  { value: "Zero", label: "Wymaganego kodu" },
];

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=integrations";
const WOOCOMMERCE_DOWNLOAD =
  "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";

const jsonLd = [
  organization(),
  softwareApplication(),
  breadcrumb([
    { name: "Strona główna", url: "/" },
    { name: "Integracje", url: "/integrations/" },
  ]),
];

function isExternal(href: string) {
  return /^https?:\/\//.test(href);
}
---

<Base
  title="Integracje - RevenueHunt"
  description="Połącz swój quiz RevenueHunt z Klaviyo, Meta Pixel, Mailchimp, Omnisend, GA4 i więcej. Synchronizuj leady i odpowiedzi w 5 minut, bez kodu."
  jsonLd={jsonLd}
  lang="pl"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={localizedHref("/", "pl")} class="hover:text-slate-700">Strona główna</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Integracje</span>
      </nav>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Bezproblemowe integracje, które wzmacniają wyniki Twojego quizu
      </h1>
      <p class="mt-6 max-w-3xl text-xl text-slate-600">
        Zamień odpowiedzi z quizu w przychody dzięki potężnym integracjom. Połącz RevenueHunt ze swoim obecnym stosem marketingowym, by automatyzować follow-upy, personalizować kampanie, mierzyć wydajność i zamieniać więcej ciekawskich w kupujących. <strong class="text-slate-900">Bez potrzeby kodowania.</strong>
      </p>
    </div>
  </section>

  <!-- 3-up pillars -->
  <section class="border-y border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="grid gap-10 md:grid-cols-3">
        {pillars.map((p) => (
          <div>
            <div class="text-4xl" aria-hidden="true">{p.emoji}</div>
            <h2 class="mt-4 text-xl font-semibold text-slate-900">{p.title}</h2>
            <p class="mt-3 text-slate-600">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats bar -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-5xl px-6 py-14">
      <dl class="grid grid-cols-3 gap-x-8 gap-y-8">
        {stats.map((s) => (
          <div class="text-center">
            <dt class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{s.value}</dt>
            <dd class="mt-2 text-sm text-white/70">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Integration library -->
  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Przeglądaj naszą bibliotekę integracji</h2>
      <p class="mx-auto mt-4 max-w-2xl text-slate-600">
        Kliknij dowolną integrację, by zobaczyć jej przewodnik konfiguracji w naszym centrum pomocy.
      </p>
    </div>

    {groups.map((g) => (
      <div class="mt-16">
        <div class="mb-6 flex items-baseline gap-3">
          <span class="text-2xl" aria-hidden="true">{g.emoji}</span>
          <h3 class="text-2xl font-semibold tracking-tight text-slate-900">{g.heading}</h3>
        </div>
        <p class="max-w-3xl text-slate-600">{g.intro}</p>

        <ul class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
          {g.items.map((it) => (
            <li>
              <a
                href={it.href}
                {...(isExternal(it.href) ? { target: "_blank", rel: "external noopener" } : {})}
                class="flex h-full flex-col items-center gap-3 rounded-xl border border-slate-200 bg-white p-5 text-center transition hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-md"
              >
                <img
                  src={it.logo}
                  alt={`Logo ${it.name}`}
                  width="80"
                  height="80"
                  loading="lazy"
                  class="h-14 w-14 object-contain"
                />
                <div>
                  <p class="text-base font-semibold text-slate-900">{it.name}</p>
                  <p class="mt-1 text-xs uppercase tracking-wider text-slate-500">{it.category}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Gotowy, by połączyć swój quiz ze stosem marketingowym?
      </h2>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SHOPIFY_INSTALL}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          zainstaluj na Shopify
        </a>
        <a
          href={WOOCOMMERCE_DOWNLOAD}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          pobierz dla WooCommerce
        </a>
      </div>
    </div>
  </section>
</Base>
