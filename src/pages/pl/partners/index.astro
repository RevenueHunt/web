---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

interface Partner {
  name: string;
  url: string;
  logo: string;
  description: string;
}

const groups: { heading: string; emoji: string; intro: string; items: Partner[] }[] = [
  {
    heading: "Aplikacje Shopify",
    emoji: "🧩",
    intro: "Aplikacje Shopify, które doskonale współgrają z RevenueHunt, aby rozwijać Twój sklep.",
    items: [
      { name: "Orbe Shopify Geolocation", url: "https://orbe.app/", logo: "/img/pages/partners/orbe-removebg-preview.webp", description: "Maksymalizuj globalną sprzedaż dzięki zaawansowanej geolokalizacji Shopify. Personalizuj produkty, ceny, walutę i treści dla każdego kraju oraz kieruj klientów do odpowiedniego doświadczenia zakupowego z Orbe." },
      { name: "WC Wishlist Club", url: "https://apps.shopify.com/wishlist-club?utm_source=revenuehunt&utm_medium=website&utm_campaign=partnership", logo: "/img/pages/partners/wishlist-club-150-150-px-logo.webp", description: "WC Wishlist Club pozwala Twoim klientom zapisywać ulubione produkty, udostępniać listy życzeń i kupować później, zwiększając zaangażowanie i sprzedaż. Łatwy w konfiguracji, zoptymalizowany pod mobile i idealny do zamiany oglądających w lojalnych klientów." },
      { name: "Langwill: Language Translate", url: "https://apps.shopify.com/localiser", logo: "/img/pages/partners/1.webp", description: "Poszerz swój globalny zasięg z Langwill: przetłumacz swój sklep Shopify na 138 języków i automatycznie przeliczaj waluty, by zapewnić płynne i zlokalizowane zakupy." },
      { name: "Customer Dashboard Pro", url: "https://apps.shopify.com/customer-dashboard-pro?utm_source=revenuehunt", logo: "/img/pages/partners/CustomerDashboard.webp", description: "Customer Dashboard Pro to jedyna aplikacja, która oferuje płynne wsparcie zarówno dla nowych Customer Accounts Shopify, jak i Classic Customer Accounts." },
      { name: "ToastiBar – Sales Popup", url: "https://makeprosimp.com/partnership/revenuehunt", logo: "/img/pages/partners/toastibarlogo_fgaiv9.webp", description: "Zwiększ zaufanie klientów i napędzaj sprzedaż, pokazując dowód społeczny w czasie rzeczywistym: sprzedaż, koszyk, odwiedzających, recenzje produktów i alerty o stanie magazynu." },
      { name: "UpPromote: Affiliate & Referral", url: "https://partners.secomapp.com/apps/affiliate/SHOPQUIZ_APP", logo: "/img/pages/partners/NEW_logo-1.webp", description: "UpPromote to najczęściej polecana aplikacja afiliacyjna/poleceń w Shopify App Store. Kompleksowe rozwiązanie do tworzenia i zarządzania kampaniami marketingowymi, odpowiednie dla firm każdej wielkości." },
      { name: "Essential Free Shipping Bar", url: "https://apps.shopify.com/essential-order-value-booster", logo: "/img/pages/partners/freeshippingbarlogo.webp", description: "Zwiększ sprzedaż i AOV, konfigurując nieograniczone paski darmowej wysyłki z wieloma progami wartości koszyka, by zachęcić kupujących do dodawania kolejnych produktów." },
      { name: "iCart Cart Drawer Cart Upsell", url: "https://apps.shopify.com/icart/?campaign=promotion&medium=in-app-banner&source=revenuehunt", logo: "/img/pages/partners/iCart-Cart-Drawer-Cart-Upsell-logo.webp", description: "Kompleksowa aplikacja Shopify do personalizacji szuflady koszyka i pełnej strony koszyka z upsellem, rekomendacjami produktów, paskiem postępu, pakietami produktów i rabatami." },
      { name: "Kaching Bundle Quantity Deals", url: "https://apps.shopify.com/bundle-deals?utm_source=partnership&utm_medium=web&utm_campaign=REVENUEH", logo: "/img/pages/partners/Kaching-Logo-1024x1024.webp", description: "Napędzaj sprzedaż z Kaching Bundle Quantity Deals: twórz oferty pakietowe bezpośrednio na stronie produktu. Użyj kodu REVENUEH20, by uzyskać ekskluzywny rabat 20%." },
      { name: "PDF Invoice Generator", url: "https://apps.shopify.com/fordeer-invoice-order-printer?utm_source=ShopQuizProductRecommender&utm_medium=comarketing&utm_campaign=partner", logo: "/img/pages/partners/fordeer-data-export-1024x1024.webp", description: "Generator faktur Shopify od Fordeer jest elastyczny, zgodny z globalnymi przepisami i obsługuje B2C, B2B oraz hurtowników. Konfigurowalne szablony PDF, druk wsadowy i wsparcie przez czat na żywo 24/7." },
      { name: "AI SEO Optimizer", url: "https://share.seoant.com/app/1165b75b7ce1524D5J", logo: "/img/pages/partners/SEOAnt-_-AI-SEO-Optimizer_Channelwill-.webp", description: "Najlepsza aplikacja SEO dla Shopify: optymalizuj słowa kluczowe, ulepszaj meta tagi i dopracuj strukturę witryny. Analiza wydajności i prędkości SEO napędzana przez AI." },
      { name: "BSS: B2B/Wholesale Solution", url: "https://apps.shopify.com/b2b-solution-custom-pricing?utm_source=RevenueHunt&utm_medium=partner-listing&utm_campaign=partnership-2024", logo: "/img/pages/partners/BSS-Commerce_logo_150.webp", description: "Kompleksowe rozwiązanie hurtowe. Płynne doświadczenie zakupowe B2B, które dodatkowo pomaga sprzedawcom zarządzać klientami hurtowymi i zdobywać o nich informacje." },
      { name: "PreOrder Now WOD", url: "https://apps.shopify.com/preorder-now?utm_source=+revenuehunt&utm_medium=web&utm_campaign=partner&utm_id=crosspromo", logo: "/img/pages/partners/PreOrder-Now-Logo.webp", description: "Zamień sytuacje braku towaru w okazje do zamówień przedpremierowych. Idealne dla firm print-on-demand: zdobywaj zainteresowanie klientów bez początkowego stanu magazynowego." },
    ],
  },
  {
    heading: "Logistyka i zaopatrzenie",
    emoji: "📦",
    intro: "Partnerzy zaopatrzenia, fulfillmentu i logistyki, aby wysyłać szybciej i skalować się globalnie.",
    items: [
      { name: "Fulfillman", url: "https://www.fulfillman.com/", logo: "/img/pages/partners/fulfillmanlogo.webp", description: "Fulfillman to globalny lider w sourcingu, fulfillmencie i logistyce dla ecommerce, oferujący szybką i niezawodną wysyłkę dzięki dedykowanym usługom linii prywatnej." },
      { name: "HyperSKU", url: "https://www.hypersku.com/", logo: "/img/pages/partners/150150-logo.webp", description: "HyperSKU oferuje kompleksowe rozwiązanie łańcucha dostaw. Ponad 1M produktów, sprzedaż pakietów, próbkowanie, kontrola jakości, personalizacja marki i zautomatyzowany fulfillment zamówień." },
      { name: "Service Points", url: "https://www.servicepoints.eu/en/w2/smart-dropshipping-1?utm_source=revenuehunt&utm_medium=app&utm_id=31", logo: "/img/pages/partners/Logo-Black-background.webp", description: "Service Points przedstawia SMART Dropshipping: zautomatyzowany dropshipping i decyzje łańcucha dostaw oparte na danych, by skalować bez ograniczeń." },
    ],
  },
  {
    heading: "Motywy i projektowanie",
    emoji: "🎨",
    intro: "Motywy premium i projektowanie, aby Twój sklep wyglądał olśniewająco.",
    items: [
      { name: "eComX", url: "https://ecomx.co/", logo: "/img/pages/partners/ecomx-logo.webp", description: "eComX tworzy premium motywy Shopify zaprojektowane pod konwersję. Wybieraj spośród ponad 16 projektów dopasowanych do niszy, zoptymalizowanych na podstawie realnych danych o konwersji i stworzonych z myślą o szybkości, aby zamieniać więcej odwiedzających w kupujących." },
    ],
  },
];

const perks = [
  { title: "Prowizje za polecenia", body: "Zdobywaj nowych klientów dla RevenueHunt i otrzymuj dożywotnią prowizję 20% od wszystkich przychodów, które wygenerują." },
  { title: "Linki afiliacyjne", body: "Dodawaj swoje linki afiliacyjne w artykułach, newsletterach i postach w mediach społecznościowych. Linkuj bezpośrednio do naszych aplikacji Shopify, WooCommerce, BigCommerce, Magento i standalone." },
  { title: "Twój własny partner manager", body: "Otrzymuj wskazówki, jak tworzyć zautomatyzowane lejki sprzedażowe z naszym narzędziem oraz triki na sprzedawanie naszego rozwiązania Twoim klientom." },
  { title: "Ekskluzywne treści", body: "Skontaktuj się z nami, by otrzymać wskazówki, jak tworzyć zautomatyzowane lejki sprzedażowe dla Twoich klientów z użyciem RevenueHunt i innych narzędzi." },
  { title: "Miejsce w naszym Partner Directory", body: "Nasi użytkownicy znajdą Cię w naszym Partner Directory i skontaktują się z Tobą, by skorzystać z Twoich usług." },
];

const faqs = [
  { q: "Ile kosztuje zostanie partnerem?", a: "Rejestracja jest całkowicie darmowa. Zero. Nic." },
  { q: "Czy muszę być klientem RevenueHunt?", a: "Nie, nie musisz być klientem RevenueHunt, by zostać partnerem." },
  { q: "Jak otrzymam wynagrodzenie?", a: "Wypłacamy zarobki co miesiąc. Płatności są wysyłane przez PayPal." },
  { q: "Jak mogę śledzić moje polecenia?", a: "Możesz zobaczyć swoje statystyki w swoim Partner Dashboard." },
];

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Strona główna", url: "/" },
    { name: "Partnerzy i afilianci", url: "/partners/" },
  ]),
];
---

<Base
  title="Program partnerski - RevenueHunt"
  description="Polecaj swoich klientów. Zarabiaj pieniądze. Otrzymaj dożywotnią prowizję 20% od klientów, których polecisz RevenueHunt. Zarejestruj się za darmo w naszym Programie Partnerskim."
  jsonLd={jsonLd}
  lang="pl"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20 text-center">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={localizedHref("/", "pl")} class="hover:text-slate-700">Strona główna</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Partnerzy i afilianci</span>
      </nav>
      <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">Program partnerski</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Polecaj swoich klientów. Zarabiaj pieniądze.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-xl text-slate-600">
        Zarabiaj dożywotnią prowizję 20% od klientów, których nam polecisz. Zarejestruj się dziś za darmo w naszym Programie Partnerskim.
      </p>
      <p class="mx-auto mt-6 max-w-3xl text-slate-600">
        Jeśli jesteś <strong class="font-semibold text-slate-900">agencją marketingu cyfrowego</strong> lub
        <strong class="font-semibold text-slate-900">specjalistą ds. ecommerce</strong> i chcesz rozwijać swój biznes,
        nasz Program Partnerski jest dla Ciebie. Twórz niesamowite doświadczenia dla swoich klientów z RevenueHunt.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
        >
          Zacznij teraz
        </a>
        <a
          href="#partners"
          class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
        >
          Zobacz naszych partnerów
        </a>
      </div>
    </div>
  </section>

  <!-- Who you are + perks -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-1">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Kim jesteś</h2>
        <p class="mt-4 text-slate-600">
          Jesteś agencją marketingu cyfrowego lub konsultantem ecommerce z pasją do designu i obsesją na punkcie
          <strong class="font-semibold text-slate-900">osiągania najlepszych wyników</strong> dla swoich klientów. Rozwijasz
          swój biznes, napędzając biznesy innych.
        </p>
      </div>
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Co od nas otrzymujesz</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {perks.map((p) => (
            <li class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="text-base font-semibold text-slate-900">{p.title}</h3>
              <p class="mt-2 text-sm text-slate-600">{p.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Partner directory -->
  <section id="partners" class="mx-auto max-w-7xl px-6 py-16 scroll-mt-24">
    <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Nasi partnerzy</h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
      Zaufane aplikacje i agencje, które idealnie łączą się z RevenueHunt dla Twoich klientów.
    </p>
    <div class="mt-12 space-y-16">
      {groups.map((g) => (
        <div>
          <div class="mb-2 flex items-baseline gap-3">
            <span class="text-2xl" aria-hidden="true">{g.emoji}</span>
            <h3 class="text-2xl font-semibold tracking-tight text-slate-900">{g.heading}</h3>
          </div>
          <p class="max-w-3xl text-slate-600">{g.intro}</p>
          <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {g.items.map((p) => (
        <li>
          <a
            href={p.url}
            target="_blank"
            rel="external noopener nofollow"
            class="group flex h-full flex-col items-center rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm transition hover:border-slate-300 hover:shadow-md"
          >
            <img
              src={p.logo}
              alt={`Logo ${p.name}`}
              loading="lazy"
              width="120"
              height="120"
              class="h-24 w-24 rounded-full object-cover"
            />
            <h3 class="mt-5 text-lg font-semibold text-slate-900 group-hover:text-[#16161D]">{p.name}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{p.description}</p>
            <span class="mt-5 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wider text-slate-500 group-hover:text-[#16161D]">
              Odwiedź stronę <span aria-hidden="true">↗</span>
            </span>
          </a>
        </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Najczęściej zadawane pytania</h2>
      <div class="mx-auto mt-8 max-w-2xl">
        {faqs.map((f) => (
          <details class="border-b border-slate-200">
            <summary class="py-4 text-base font-semibold text-slate-900">{f.q}</summary>
            <p class="pb-4 text-slate-600">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Zostań partnerem RevenueHunt
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        Polecaj swoich klientów, twórz zautomatyzowane lejki sprzedażowe i zarabiaj dożywotnią prowizję 20% od wszystkiego, co wydadzą.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          Zacznij teraz
        </a>
        <a
          href={localizedHref("/demo/", "pl")}
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          Zarezerwuj demo
        </a>
      </div>
    </div>
  </section>
</Base>
