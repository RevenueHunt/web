---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb, softwareApplication } from "../../../lib/schema";
import { SITE } from "../../../lib/site";
import {
  SOLUTIONS_BY_LANG,
  VERTICAL_ORDER,
  USECASE_ORDER,
  RELATED_GUIDES,
} from "../../../lib/solutions";
import { localizedHref } from "../../../lib/i18n";

const verticals = VERTICAL_ORDER.map((slug) => SOLUTIONS_BY_LANG["pl"][slug]!);
const useCases = USECASE_ORDER.map((slug) => SOLUTIONS_BY_LANG["pl"][slug]!);
const all = [...verticals, ...useCases];

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=solutions_index";
// Free WordPress.org plugin (not the WooCommerce.com extension).
const WOO_PLUGIN = "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";

const jsonLd = [
  organization(),
  softwareApplication(),
  breadcrumb([
    { name: "Strona główna", url: "/" },
    { name: "Rozwiązania", url: "/solutions/" },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    itemListElement: all.map((s, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: `${s.name} quiz`,
      url: new URL(`/solutions/${s.slug}/`, SITE.site_url).href,
    })),
  },
];
---

<Base
  title="Rozwiązania quizów według branży i typu quizu"
  description="Rozwiązania quizów rekomendacji produktów dla pielęgnacji skóry, suplementów, mody, kawy, wyszukiwarek prezentów, doboru rozmiaru i więcej. Darmowy plan, gotowy tego samego dnia."
  ogImage="/og/solutions.png"
  jsonLd={jsonLd}
  lang="pl"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={localizedHref("/", "pl")} class="hover:text-slate-700">Strona główna</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Rozwiązania</span>
      </nav>
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">Rozwiązania</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          Quiz rekomendacji produktów dla Twojej branży
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          Niezależnie od tego, czy sprzedajesz pielęgnację skóry, suplementy czy sofy, quiz, który pomaga kupującym znaleźć odpowiedni produkt, konwertuje lepiej niż strona kategorii. Wybierz swoją branżę lub typ quizu, aby zobaczyć.
        </p>
      </div>
    </div>
  </section>

  <!-- By industry -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Według branży</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {verticals.map((s) => (
          <li>
            <a
              href={`/solutions/${s.slug}/`}
              class="group block h-full rounded-xl border border-slate-200 p-6 transition hover:border-[#16161D] hover:shadow-md"
            >
              <h3 class="text-lg font-semibold text-slate-900 group-hover:text-[#16161D]">{s.name}</h3>
              <p class="mt-2 text-sm text-slate-600">{s.heroSubtitle}</p>
              <span class="mt-4 inline-flex items-center text-sm font-medium text-[#16161D]">
                Zobacz rozwiązanie
                <svg class="ml-1 h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M7.21 4.29a1 1 0 011.42 0l5 5a1 1 0 010 1.42l-5 5a1 1 0 11-1.42-1.42L11.09 10 7.21 6.12a1 1 0 010-1.42z" clip-rule="evenodd" />
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- By quiz type -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Według typu quizu</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {useCases.map((s) => (
          <li>
            <a
              href={`/solutions/${s.slug}/`}
              class="group block h-full rounded-xl border border-slate-200 bg-white p-6 transition hover:border-[#16161D] hover:shadow-md"
            >
              <h3 class="text-lg font-semibold text-slate-900 group-hover:text-[#16161D]">{s.name}</h3>
              <p class="mt-2 text-sm text-slate-600">{s.heroSubtitle}</p>
              <span class="mt-4 inline-flex items-center text-sm font-medium text-[#16161D]">
                Zobacz rozwiązanie
                <svg class="ml-1 h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M7.21 4.29a1 1 0 011.42 0l5 5a1 1 0 010 1.42l-5 5a1 1 0 11-1.42-1.42L11.09 10 7.21 6.12a1 1 0 010-1.42z" clip-rule="evenodd" />
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Learn more (guides + explainers, incl. items moved out of the nav menu) -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Dowiedz się więcej</h2>
      <p class="mt-3 max-w-3xl text-slate-700">
        Przewodniki i wyjaśnienia, które pomogą Ci zaplanować, stworzyć i maksymalnie wykorzystać Twój quiz.
      </p>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {RELATED_GUIDES.map((g) => (
          <li>
            <a
              href={g.href}
              {...(g.external ? { target: "_blank", rel: "external noopener" } : {})}
              class="group block h-full rounded-xl border border-slate-200 p-6 transition hover:border-[#16161D] hover:shadow-md"
            >
              <h3 class="text-lg font-semibold text-slate-900 group-hover:text-[#16161D]">{g.label}</h3>
              {g.blurb && <p class="mt-2 text-sm text-slate-600">{g.blurb}</p>}
              <span class="mt-4 inline-flex items-center text-sm font-medium text-[#16161D]">
                Czytaj więcej
                <svg class="ml-1 h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M7.21 4.29a1 1 0 011.42 0l5 5a1 1 0 010 1.42l-5 5a1 1 0 11-1.42-1.42L11.09 10 7.21 6.12a1 1 0 010-1.42z" clip-rule="evenodd" />
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Odkryj, dlaczego ponad 20.000 marek wybiera RevenueHunt.
      </h2>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SHOPIFY_INSTALL}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          zacznij za darmo na Shopify
        </a>
        <a
          href={WOO_PLUGIN}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          zacznij za darmo na WooCommerce
        </a>
      </div>
    </div>
  </section>
</Base>
