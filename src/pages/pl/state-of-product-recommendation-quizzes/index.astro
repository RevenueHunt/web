---
import Base from "../../../layouts/Base.astro";
import PageHero from "../../../components/PageHero.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import { organization, breadcrumb, article, faqPage } from "../../../lib/schema";
import { SITE } from "../../../lib/site";
import { localizedHref } from "../../../lib/i18n";
import {
  REPORT,
  DATASET,
  HEADLINE,
  VERTICAL_CONVERSION,
  AOV_UPLIFT,
  ATTRIBUTION,
  BASELINES,
} from "../../../lib/quiz-benchmarks";

const pageUrl = new URL(`/${REPORT.slug}/`, SITE.site_url).href;
const ogImage = `/og/${REPORT.slug}.png`;

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=state_of_product_quizzes";
// Free WordPress.org plugin (not the WooCommerce.com extension).
const WOO_PLUGIN =
  "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";

const formatN = (n: number | null) =>
  n === null ? "" : n.toLocaleString("en-US");

// Conversion expressed against a typical 2% store: 6.9% / 2% = 345%.
const boost = (rate: number) => Math.round((rate / HEADLINE.baselinePct) * 100);

// Translated methodology + FAQ (the shared data module stays English for the PDF
// and stat cards). Defined before jsonLd so faqPage(FAQ) uses the translated set.
const METHODOLOGY = [
  "Źródło: własna platforma RevenueHunt, na przestrzeni każdej platformy ecommerce, którą obsługujemy. Zagregowane i zanonimizowane: żaden pojedynczy sklep nie jest możliwy do zidentyfikowania, a nasze własne sklepy demo są wszędzie wykluczone.",
  "Konwersja to wskaźnik na osobę wypełniającą quiz: zamówienia przypisane odpowiedzi na quiz, podzielone przez ukończone quizy. Nie jest to wskaźnik dla całej witryny. Osoby wypełniające quiz dokonują autoselekcji i są bardziej zaangażowane niż przeciętny odwiedzający, więc nie jest to porównanie jeden do jednego z ogólnym wskaźnikiem konwersji sklepu. Mówimy o tym wszędzie tam, gdzie robimy to porównanie.",
  "Kategoria jest wyprowadzana z nazwy quizu nadanej przez sprzedawcę (na przykład \"Quiz pielęgnacji skóry\", \"Quiz karmy dla psów\"). Około 78% odpowiedzi pochodzi z quizów generycznych lub bez nazwy i jest wykluczone z każdej liczby według kategorii.",
  "Wzrost average order value jest mierzony w obrębie sklepu: mediana wartości zamówienia tego samego sklepu z quizu względem jego mediany wartości zamówienia bez quizu. Jest to odporne na walutę i usuwa obciążenie miksem sklepu, które rozmywa efekt w naiwnej średniej na przestrzeni całej platformy.",
  "Każda liczba konwersji to minimum. Atrybucja wciąż się kumuluje, gdy sprzedawcy synchronizują zamówienia (9% pierwszych zamówień przychodzi ponad 30 dni po quizie), a zamówienia między urządzeniami lub nieśledzone nigdy się nie podpinają. Rzeczywiste liczby są wyższe, a nie niższe.",
];

const FAQ = [
  {
    question: "Jak mierzona jest konwersja quizu?",
    answer:
      "Zamówienia przypisane odpowiedzi na quiz, podzielone przez ukończone quizy. Na przestrzeni platformy 5,5% kupujących, którzy kończą quiz (około 1 na 18), składa śledzone zamówienie. Jest to wskaźnik na osobę wypełniającą quiz, a nie wskaźnik dla całej witryny: osoby wypełniające quiz są bardziej zaangażowane niż przeciętny odwiedzający, więc nie da się go bezpośrednio porównać z ogólnym wskaźnikiem konwersji sklepu.",
  },
  {
    question: "Dlaczego wskaźnik konwersji quizu jest tak dużo wyższy niż w przeciętnym sklepie?",
    answer:
      "Dwa powody. Po pierwsze, sam quiz: zastępuje przytłaczający katalog krótką rozmową i jasną rekomendacją, co usuwa niezdecydowanie, przez które wyciekają sprzedaże. Po drugie, to, co dzieje się po napłynięciu odpowiedzi: każdy quiz przechwytuje zero-party data i taguje kupującego, co zasila segmentowane flow follow-up oraz retargeting. Kampanie segmentowane generują ponad 3 razy więcej przychodu na odbiorcę niż masowe wysyłki (benchmark segmentacji Klaviyo), więc quiz nadal konwertuje przez spersonalizowany email i reklamy, nie tylko na stronie wyników.",
    answerHtml:
      "Dwa powody. Po pierwsze, sam quiz: zastępuje przytłaczający katalog krótką rozmową i jasną rekomendacją, co usuwa niezdecydowanie, przez które wyciekają sprzedaże. Po drugie, to, co dzieje się po napłynięciu odpowiedzi: każdy quiz przechwytuje zero-party data i taguje kupującego, co zasila segmentowane flow follow-up oraz retargeting. Kampanie segmentowane generują ponad 3 razy więcej przychodu na odbiorcę niż masowe wysyłki (<a href=\"https://www.klaviyo.com/marketing-resources/segmentation-benchmark-report\" target=\"_blank\" rel=\"external noopener nofollow\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">benchmark segmentacji Klaviyo</a>), więc quiz nadal konwertuje przez spersonalizowany email i reklamy, nie tylko na stronie wyników.",
  },
  {
    question: "Czy kupujący z quizu naprawdę wydają więcej na zamówienie?",
    answer:
      "Średnio tak, mierzone w sposób równoważny. W obrębie tego samego sklepu zamówienia, które przyszły przez quiz, są około 11% do 15% większe niż te, które nie przyszły, i utrzymuje się to w mniej więcej 7 na 10 sklepów. Nie jest to uniwersalne: najsilniej w urodzie i pielęgnacji skóry (około +20%), płaściej w kategoriach takich jak zapachy i kawa.",
  },
  {
    question: "Jak te dane odnoszą się do mojego sklepu?",
    answer:
      "Wpisz własny ruch, average order value i obecny wskaźnik konwersji do naszego kalkulatora ROI quizu. Uruchamia te same benchmarki (wskaźnik 5,5% na osobę wypełniającą quiz, konwersję według kategorii, wzrost AOV) względem Twoich liczb, aby oszacować dodatkowy przychód, który quiz mógłby dodać.",
    answerHtml:
      "Wpisz własny ruch, average order value i obecny wskaźnik konwersji do naszego <a href=\"/pl/quiz-roi-calculator/\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">kalkulatora ROI quizu</a>. Uruchamia te same benchmarki (wskaźnik 5,5% na osobę wypełniającą quiz, konwersję według kategorii, wzrost AOV) względem Twoich liczb, aby oszacować dodatkowy przychód, który quiz mógłby dodać.",
  },
  {
    question: "Czy dane są zanonimizowane?",
    answer:
      "Tak. Każda liczba jest zagregowana i połączona na przestrzeni milionów odpowiedzi i tysięcy sklepów. Żaden pojedynczy sklep nie jest możliwy do zidentyfikowania. Raport istnieje po to, by dzielić się tym, co mówią dane, a nie by ujawniać jakiegokolwiek sprzedawcę.",
  },
  {
    question: "Czy mogę użyć tych liczb?",
    answer:
      "Tak. Cytuj je z linkiem do tej strony. Raport jest darmowy i bez bramki, PDF można pobrać, a najważniejsze liczby są dostępne jako karty do udostępniania.",
  },
];

const pageTitle = "Stan quizów rekomendacji produktów: raport benchmarkowy 2026";
const pageDescription = "Jak naprawdę działają quizy rekomendacji produktów: konwersja, ukończenie i średnia wartość zamówienia, na podstawie ponad 45M prawdziwych odpowiedzi w ponad 20 000 sklepów e-commerce.";

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Strona główna", url: localizedHref("/", "pl") },
    { name: "Stan quizów rekomendacji produktów", url: localizedHref(`/${REPORT.slug}/`, "pl") },
  ]),
  article({
    title: pageTitle,
    description: pageDescription,
    url: pageUrl,
    image: ogImage,
    datePublished: REPORT.datePublished,
    dateModified: REPORT.dateModified,
    author: "RevenueHunt",
    tags: [
      "quiz rekomendacji produktów benchmark",
      "quiz conversion rate",
      "ecommerce personalization",
      "average order value",
    ],
  }),
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "RevenueHunt quiz rekomendacji produktów benchmarks 2026",
    description: pageDescription,
    url: pageUrl,
    creator: organization(),
    license: "https://creativecommons.org/licenses/by/4.0/",
    isAccessibleForFree: true,
    datePublished: REPORT.datePublished,
    keywords: [
      "quiz rekomendacji produktów",
      "conversion rate",
      "average order value",
      "ecommerce",
      "Shopify",
    ],
    distribution: {
      "@type": "DataDownload",
      encodingFormat: "application/pdf",
      contentUrl: new URL(REPORT.pdfPath, SITE.site_url).href,
    },
  },
  faqPage(FAQ),
];

const publishedLabel = new Date(REPORT.datePublished).toLocaleDateString("pl-PL", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

// Category/vertical labels and the two long table notes, translated. Numbers stay
// from the shared data module; only the human-readable labels/notes are localized.
const VERT_LABEL: Record<string, string> = {
  "Fragrance": "Zapachy",
  "Haircare": "Pielęgnacja włosów",
  "Supplements & health": "Suplementy i zdrowie",
  "Beauty & skincare": "Uroda i pielęgnacja skóry",
  "Coffee & tea": "Kawa i herbata",
  "CBD": "CBD",
  "Other sectors": "Inne sektory",
  "All quiz categories (pooled)": "Wszystkie kategorie quizów (łącznie)",
};
const GROUPED_NOTE =
  "Wszystko poza nazwanymi kategoriami, w tym quizy generyczne i o wyższym namyśle. Zmierzone na poziomie około 3,6%, czyli około 180% typowego sklepu.";
const POOLED_NOTE =
  "Nagłówek platformy: 5,5% (1 na 18), około 275% typowego sklepu na poziomie 2%. Generyczne, bezimienne quizy (~78% odpowiedzi) są wykluczone z wierszy według kategorii i ściągają liczbę całościową w dół do ~4%.";
const SCOPE: Record<string, string> = {
  "Statista": "Globalnie, 2025",
  "IRP Commerce": "Dane aktywnych sprzedawców z Wielkiej Brytanii/Irlandii, 2025",
  "Dynamic Yield": "400+ marek średnich i dużych, 2025",
  "Shopify": "Własne opublikowane wytyczne Shopify",
};
const tr = <T extends { vertical: string }>(r: T) => ({ ...r, vertical: VERT_LABEL[r.vertical] ?? r.vertical });
const consumable = VERTICAL_CONVERSION.filter((r) => r.kind === "consumable").map(tr);
const considered = VERTICAL_CONVERSION.filter((r) => r.kind === "considered").map(tr);
const grouped = { ...tr(VERTICAL_CONVERSION.find((r) => r.kind === "grouped")!), note: GROUPED_NOTE };
const pooled = { ...tr(VERTICAL_CONVERSION.find((r) => r.kind === "total")!), note: POOLED_NOTE };
const aovRows = AOV_UPLIFT.perVertical.map(tr);
const baselines = BASELINES.map((b) => ({ ...b, scope: SCOPE[b.source] ?? b.scope }));
---

<Base
  title={pageTitle}
  description={pageDescription}
  ogImage={ogImage}
  jsonLd={jsonLd}
  lang="pl"
  translated={true}
>
  <!-- Hero -->
  <PageHero>
      <Breadcrumb items={[{ label: "Strona główna", href: localizedHref("/", "pl") }, { label: "Stan quizów rekomendacji produktów" }]} />
      <div class="text-center">
        <Eyebrow>Raport benchmarkowy · {publishedLabel}</Eyebrow>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          Stan quizów rekomendacji produktów
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          1 na 18 kupujących, którzy kończą quiz rekomendacji produktów, składa zamówienie, <strong>2,75 raza więcej niż typowy sklep online</strong>. Ten raport rozkłada na czynniki, które kategorie konwertują najwięcej, o ile więcej wydają kupujący z quizu i jak długo pojedynczy quiz wciąż przynosi efekty. Oparte na prawdziwych danych z <strong>{DATASET.responses} odpowiedzi na quiz</strong> w {DATASET.brands} sklepach.
        </p>
        {/* TODO: restore hero CTAs ("Download the PDF" + "Read the findings")
            once a peer reviews the PDF design. Removed 2026-06-08 to hold the
            PDF download until that review. The PDF is still generated and the
            "Cite this report" section's download link is also held (see below). */}
      </div>
  </PageHero>

  <!-- Dataset band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-2xl bg-[#16161D] px-6 py-10 sm:px-10">
        <p class="text-center text-sm font-semibold uppercase tracking-wider text-white/50">
          Zbiór danych
        </p>
        <dl class="mt-6 grid grid-cols-1 gap-8 text-center sm:grid-cols-3">
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.responses}</dt>
            <dd class="mt-1 text-sm text-white/70">przeanalizowanych odpowiedzi na quiz</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.revenue}</dt>
            <dd class="mt-1 text-sm text-white/70">wygenerowanego przychodu sprzedawców</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.brands}</dt>
            <dd class="mt-1 text-sm text-white/70">sklepów ecommerce</dd>
          </div>
        </dl>
        <p class="mx-auto mt-6 max-w-3xl text-center text-sm text-white/60">
          Zagregowane i zanonimizowane, na przestrzeni Shopify, WooCommerce, BigCommerce, Magento i platform samodzielnych. Żaden pojedynczy sklep nie jest możliwy do zidentyfikowania. Każda liczba poniżej to minimum: atrybucja wciąż się kumuluje, więc rzeczywiste liczby są wyższe.
        </p>
      </div>
    </div>
  </section>

  <!-- Key findings (stat cards) -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Najważniejsze liczby</h2>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">{HEADLINE.completedConv}%</p>
          <p class="mt-2 font-medium text-slate-900">kupujących, którzy kończą quiz, składa zamówienie</p>
          <p class="mt-2 text-sm text-slate-600">Około 1 na {HEADLINE.completedOneIn}, mniej więcej {HEADLINE.multiple} raza więcej niż typowy sklep na poziomie {HEADLINE.baselinePct}%.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">+{AOV_UPLIFT.headlineLow}-{AOV_UPLIFT.headlineHigh}%</p>
          <p class="mt-2 font-medium text-slate-900">wyższa average order value, w obrębie tego samego sklepu</p>
          <p class="mt-2 text-sm text-slate-600">Zmierzone w sposób równoważny, obecne w około 7 na 10 sklepów.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">{HEADLINE.completionRate}%</p>
          <p class="mt-2 font-medium text-slate-900">kupujących, którzy zaczynają quiz, kończy go</p>
          <p class="mt-2 text-sm text-slate-600">Około 7 na 10 dociera do strony wyników. {HEADLINE.abandonRate}% rezygnuje wcześniej.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">1 na 5</p>
          <p class="mt-2 font-medium text-slate-900">zamówień przypisanych quizowi przychodzi ponad 30 dni później</p>
          <p class="mt-2 text-sm text-slate-600">Quiz nadal generuje przychody przez wiele miesięcy po wypełnieniu.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Conversion by category -->
  <section id="conversion" class="scroll-mt-20 bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Konwersja według kategorii</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        Średnia platformy ukrywa szerokie rozproszenie. <strong>Kategorie konsumpcyjne i uzupełnialne konwertują od dwóch do trzech razy więcej</strong> niż średni sklep online. Zakupy o wysokiej cenie i wysokim namyśle konwertują o rząd wielkości niżej: tam quiz napędza odkrywanie, ale sprzedaż przychodzi później, poza sesją.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">Kategoria</th>
              <th class="py-3 pr-4 text-right font-semibold">Konwersja</th>
              <th class="py-3 pr-4 text-right font-semibold">Wzrost konwersji z quizu</th>
              <th class="py-3 text-right font-semibold">Odpowiedzi</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {consumable.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{r.rate}%</td>
                <td class="py-3 pr-4 text-right tabular-nums text-slate-600">{boost(r.rate)}%</td>
                <td class="py-3 text-right tabular-nums text-slate-500">{formatN(r.n)}</td>
              </tr>
            ))}
            {considered.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{r.rate}%</td>
                <td class="py-3 pr-4 text-right tabular-nums text-slate-600">{boost(r.rate)}%</td>
                <td class="py-3 text-right tabular-nums text-slate-500">{formatN(r.n)}</td>
              </tr>
            ))}
            <tr class="border-b border-slate-200">
              <td class="py-3 pr-4 font-medium">{grouped.vertical}</td>
              <td class="py-3 pr-4 text-right font-semibold tabular-nums">~{grouped.rate}%</td>
              <td class="py-3 pr-4 text-right tabular-nums text-slate-600">~{boost(grouped.rate)}%</td>
              <td class="py-3 text-right tabular-nums text-slate-500">{formatN(grouped.n)}</td>
            </tr>
            <tr class="border-t-2 border-slate-300">
              <td class="py-3 pr-4 font-semibold">{pooled.vertical}</td>
              <td class="py-3 pr-4 text-right font-bold tabular-nums">{pooled.rate}%</td>
              <td class="py-3 pr-4 text-right font-bold tabular-nums text-slate-600">{boost(pooled.rate)}%</td>
              <td class="py-3 text-right tabular-nums text-slate-500">wszystkie</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        {grouped.note}
      </p>
      <p class="mx-auto mt-2 max-w-3xl text-sm text-slate-500 text-center">
        {pooled.note}
      </p>
    </div>
  </section>

  <!-- AOV uplift -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Czy kupujący z quizu wydają więcej?</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        <strong>Zmierzone w obrębie tego samego sklepu</strong>, zamówienia z quizu są <strong>od {AOV_UPLIFT.headlineLow}% do {AOV_UPLIFT.headlineHigh}% większe</strong> niż zamówienia bez quizu, i utrzymuje się to w {AOV_UPLIFT.storesUpLow}% do {AOV_UPLIFT.storesUpHigh}% sklepów. Nie jest to uniwersalne: silniej tam, gdzie quiz może złożyć zestaw lub rutynę, niemal płasko tam, gdzie zakup to pojedynczy artykuł.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">Kategoria</th>
              <th class="py-3 pr-4 text-right font-semibold">Wzrost AOV w obrębie sklepu</th>
              <th class="py-3 text-right font-semibold">Sklepy ze wzrostem</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {aovRows.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">
                  {r.uplift === null ? "Płasko" : `+${r.uplift}%`}
                </td>
                <td class="py-3 text-right tabular-nums text-slate-500">
                  {r.storesUp === null ? "bd." : `${r.storesUp}%`}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        Zmierzone w obrębie sklepu (ten sam sklep, zamówienia z quizu kontra zamówienia bez quizu), więc jest odporne na walutę i kontroluje mix sklepu. Triangulowane między trzema niezależnymi próbkami z medianą +11%, +15% i +14%. Kategorie z małymi próbkami są pomijane, a nie wyolbrzymiane.
      </p>
    </div>
  </section>

  <!-- Attribution / LTV -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Quiz wciąż przynosi efekty po sesji</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        Większość dashboardów atrybucji ocenia quiz po zamówieniach z tego samego dnia i na tym poprzestaje. To pomija większość wartości. <strong>{ATTRIBUTION.sameDay}% pierwszych zamówień przypisanych quizowi następuje tego samego dnia</strong>, ale ogon jest długi.
      </p>
      <div class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-4">
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.sameDay}%</p>
          <p class="mt-1 text-sm text-slate-600">tego samego dnia</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.within7}%</p>
          <p class="mt-1 text-sm text-slate-600">w ciągu 7 dni</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.within30}%</p>
          <p class="mt-1 text-sm text-slate-600">w ciągu 30 dni</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">1 na 5</p>
          <p class="mt-1 text-sm text-slate-600">przychodzi ponad 30 dni później</p>
        </div>
      </div>
      <p class="mx-auto mt-6 max-w-3xl text-slate-700 text-center">
        Około <strong>1 na 5 wszystkich zamówień przypisanych quizowi przychodzi ponad 30 dni po quizie</strong>. Quiz to nie tylko popchnięcie do checkoutu: każda odpowiedź to zero-party data, które taguje kupującego i zasila segmentowane flow follow-up oraz retargeting. <a href="https://www.klaviyo.com/marketing-resources/segmentation-benchmark-report" target="_blank" rel="external noopener nofollow" class="font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]">Kampanie segmentowane generują ponad 3 razy więcej przychodu na odbiorcę</a> niż masowe wysyłki, więc pojedynczy quiz nadal konwertuje przez email i spersonalizowane reklamy przez wiele miesięcy.
      </p>
    </div>
  </section>

  <!-- Baseline context -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Co liczy się jako "średni sklep"</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        Nie ma jednej prawdziwej liczby dla konwersji w ecommerce: waha się ona w zależności od metodologii i próbki. Uczciwy zakres to około 1,6% do 2,9%. Robimy benchmark względem okrągłych <strong>{HEADLINE.baselinePct}%</strong>, konserwatywnego dolnego krańca, co sytuuje osoby wypełniające quiz na poziomie około <strong>{HEADLINE.multiple} raza</strong> średniego sklepu.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">Źródło</th>
              <th class="py-3 pr-4 text-right font-semibold">Średnia konwersja</th>
              <th class="py-3 font-semibold">Zakres</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {baselines.map((b) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">
                  <a href={b.href} target="_blank" rel="external noopener nofollow" class="text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-slate-500">{b.source}</a>
                </td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{b.rate}</td>
                <td class="py-3 text-sm text-slate-600">{b.scope}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        Ważne: nasze 5,5% to wskaźnik na osobę wypełniającą quiz (zamówienia na ukończony quiz), podczas gdy każda liczba powyżej to wskaźnik dla całej witryny (zamówienia na odwiedzającego). Osoby wypełniające quiz dokonują autoselekcji, więc część różnicy to lejek, a nie tylko quiz. Przedstawiamy to porównanie wprost, zamiast je upiększać.
      </p>
    </div>
  </section>

  <!-- Methodology -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Metodologia</h2>
      <ul class="mt-8 space-y-5" role="list">
        {METHODOLOGY.map((m) => (
          <li class="flex gap-3">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400" aria-hidden="true"></span>
            <p class="text-slate-700">{m}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Najczęściej zadawane pytania</h2>
      <div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
        {FAQ.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-lg font-semibold text-slate-900 [&::-webkit-details-marker]:hidden">
              <span>{f.question}</span>
              <svg
                class="h-5 w-5 flex-shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <p class="pb-5 text-slate-700" set:html={f.answerHtml ?? f.answer} />
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* TODO: restore the entire "Cite this report" section (PDF download +
      shareable stat-card links) once a designer reviews the report + PDF + card
      designs. Removed 2026-06-08 to hold the downloadable assets until review.
      The PDF and card PNGs are still generated by `bun run report`. */}

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Zmierz wzrost we własnym sklepie.
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-white/70">
        RevenueHunt jest darmowy na start, ze 100 odpowiedziami na quiz miesięcznie. Stwórz quiz, przepuść przez niego ruch i odczytaj własne liczby.
      </p>
      <p class="mx-auto mt-4 max-w-2xl text-white/60">
        Zobacz, ile te benchmarki mogłyby dołożyć Twojemu sklepowi, dzięki naszemu <a href={localizedHref("/quiz-roi-calculator/", "pl")} class="font-medium text-white underline decoration-white/40 underline-offset-2 hover:decoration-white">kalkulatorowi ROI quizu</a>.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SHOPIFY_INSTALL}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          zacznij za darmo na Shopify
        </a>
        <a
          href={WOO_PLUGIN}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          zacznij za darmo na WooCommerce
        </a>
      </div>
    </div>
  </section>
</Base>
