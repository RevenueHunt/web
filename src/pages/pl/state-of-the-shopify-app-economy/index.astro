---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb, article, faqPage } from "../../../lib/schema";
import { SITE } from "../../../lib/site";
import { localizedHref } from "../../../lib/i18n";
import {
  REPORT,
  SOURCE,
  HEADLINE,
  GROWTH,
  REVIEWS,
  REVENUE,
  PRICING,
  GEOGRAPHY,
  NICHES,
  QUIZ_LANE,
} from "../../../lib/app-economy";

const pageUrl = new URL(`/pl/${REPORT.slug}/`, SITE.site_url).href;
const ogImage = `/og/${REPORT.slug}.png`;

const publishedLabel = new Date(REPORT.datePublished).toLocaleDateString("pl-PL", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const title = "Stan ekonomii aplikacji Shopify";
const description =
  "W Shopify App Store jest 22 546 aktywnych aplikacji i prawie żadna nie osiąga niczego. Raport z danymi o wzroście, recenzjach, koncentracji przychodów, cenach i tym, kto je tworzy, na podstawie migawki każdej aktywnej aplikacji.";

// Methodology + FAQ, translated. The lead clause of each methodology note is
// bolded inline (the English source bolded it via string replace, which cannot
// match translated text). Defined before jsonLd so faqPage(FAQ) can use it.
const METHODOLOGY = [
  "<strong>Źródło:</strong> migawka publicznego Shopify App Store, 22 546 aktywnych ofert aplikacji, wykonana w czerwcu 2026. Każde pole pochodzi z publicznej oferty, nie z wewnętrznych danych Shopify ani z konta jakiegokolwiek sprzedawcy.",
  "<strong>Przychody są szacowane, a nie mierzone.</strong> Są modelowane na podstawie opublikowanych progów cenowych każdej aplikacji w połączeniu z sygnałami recenzji i instalacji. Traktuj liczby przychodów jako kierunkowy model tego, jak skoncentrowane są zarobki, a nie jako dane rozliczeniowe. Są oznaczone jako \"szacunkowe\" wszędzie tam, gdzie się pojawiają.",
  "<strong>Wzrost opiera się na opublikowanej dacie premiery każdej oferty.</strong> Źródło skupiło około 2800 dat premiery w maju 2026, więc krzywą odczytuje się jako skumulowane aktywne aplikacje według roku (punkt końcowy to prawdziwa bieżąca suma), a liczba \"6000+ w ciągu ostatnich 12 miesięcy\" usuwa ten artefakt jednego miesiąca.",
  "<strong>Recenzje są wskaźnikiem trakcji</strong>, niedoskonałym: świetna aplikacja może być nowa, a liczby recenzji są opóźnione względem rzeczywistego użycia. Używamy ich, bo są najwyraźniejszym publicznym, porównywalnym sygnałem prawdziwej bazy sprzedawców na przestrzeni 22 546 aplikacji.",
  "Kategorie w App Store to etykiety funkcji, które aplikacja może sobie sama przypisać, a wiele aplikacji ma ich kilka lub żadnej. Na potrzeby widoku sektorów grupujemy pokrewne etykiety w szerokie tory i usuwamy duplikaty aplikacji w obrębie każdego; aplikacja może należeć do więcej niż jednego, więc sektory nakładają się i nie wykluczają, i traktujemy je orientacyjnie. Wszędzie indziej opieramy się na jednoznacznych przekrojach (recenzje, ceny, data premiery, kraj dewelopera).",
];

const FAQ = [
  {
    question: "Ile aplikacji jest w Shopify App Store?",
    answer:
      "22 546 aktywnych aplikacji w tej migawce z czerwca 2026. Sklep wzrósł około 10-krotnie od 2020 roku i dodał ponad 6000 aplikacji tylko w ciągu ostatnich 12 miesięcy, czyli mniej więcej 1 na 4 ze wszystkiego, co jest dziś aktywne. Rozwój wspomagany przez AI zamienił to, co kiedyś było półrocznym projektem, w weekend.",
  },
  {
    question: "Dlaczego większość aplikacji Shopify upada?",
    answer:
      "Tworzenie nie jest już ograniczeniem, więc sklep zalewają aplikacje, które nigdy nie znajdują bazy sprzedawców. 51% nie ma żadnej recenzji, a 81% ma mniej niż 10. Tym, co jest rzadkie, są dystrybucja i zaufanie: odpowiadanie na zgłoszenia, zdobywanie recenzji sprzedawca po sprzedawcy, obecność przez lata. To właśnie tej części AI nie zrobi za Ciebie.",
  },
  {
    question: "Ile zarabiają aplikacje Shopify?",
    answer:
      "Zarobki są skrajnie skoncentrowane. Według naszych szacunków górny 1% aplikacji (225 z nich) zgarnia około 72% wszystkich przychodów aplikacji, a samo pierwsze 10 zgarnia prawie 30%. Tylko około 36% aplikacji wygląda na takie, które cokolwiek zarabiają. Przychody są tu szacowane na podstawie publicznych cen i sygnałów użycia, a nie danych rozliczeniowych.",
  },
  {
    question: "Czy większość aplikacji Shopify jest darmowa?",
    answer:
      "W praktyce tak. 46,9% jest darmowych, a kolejne 48,6% zaczyna od darmowego okresu próbnego; tylko 4,5% pobiera opłatę z góry. 57% płatnych aplikacji oferuje darmowy plan. W Shopify App Store darmowy punkt wejścia nie jest taktyką wzrostu, jest podstawowym oczekiwaniem.",
  },
  {
    question: "Gdzie mogę zobaczyć dane źródłowe?",
    answer:
      "Liczby pochodzą z migawki, którą utrzymujemy, każdej aktywnej aplikacji Shopify: daty premiery, recenzje, ceny, odznaka Built for Shopify i kraj dewelopera. Jeśli budujesz na Shopify i chcesz pełny raport, skontaktuj się z nami.",
    answerHtml:
      "Liczby pochodzą z migawki, którą utrzymujemy, każdej aktywnej aplikacji Shopify: daty premiery, recenzje, ceny, odznaka Built for Shopify i kraj dewelopera. Jeśli budujesz na Shopify i chcesz pełny raport, <a href=\"/pl/contact/\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">skontaktuj się z nami</a>.",
  },
];

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Strona główna", url: localizedHref("/", "pl") },
    { name: title, url: localizedHref(`/${REPORT.slug}/`, "pl") },
  ]),
  article({
    title,
    description,
    url: pageUrl,
    image: ogImage,
    datePublished: REPORT.datePublished,
    dateModified: REPORT.dateModified,
    author: "RevenueHunt",
    tags: [
      "Shopify app store",
      "deweloperzy aplikacji Shopify",
      "statystyki app store",
      "ekonomia aplikacji",
    ],
  }),
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "Stan ekonomii aplikacji Shopify 2026",
    description,
    url: pageUrl,
    creator: organization(),
    license: "https://creativecommons.org/licenses/by/4.0/",
    isAccessibleForFree: true,
    datePublished: REPORT.datePublished,
    keywords: [
      "Shopify app store",
      "deweloperzy aplikacji",
      "przychody aplikacji",
      "recenzje aplikacji",
      "ecommerce",
    ],
  },
  faqPage(FAQ),
];

// Section eyebrows for the editorial "field notes" feel.
const E = (n: string, label: string) => `${n} · ${label}`;

// Translated headline cards. Stats stay from the shared data module (HEADLINE[i].stat).
const headlineT = [
  { label: "aktywnych aplikacji w sklepie", note: "Około 10-krotny wzrost od 2020 roku." },
  { label: "nie ma ani jednej recenzji", note: "Cztery na pięć mają mniej niż 10." },
  { label: "przychodów zgarnia górny 1%", note: "225 aplikacji. Szacunkowo." },
  { label: "pobiera opłatę z góry", note: "Tylko 1 na 20. Prawie połowa jest darmowa." },
];

// Growth caption with the lead phrase bolded.
const growthCaptionHtml =
  "Aktywne aplikacje skumulowane według roku premiery. <strong>Shopify App Store zanotował około 10-krotny wzrost od 2020 roku</strong> i dodał ponad 6000 aplikacji tylko w ciągu ostatnich 12 miesięcy, czyli mniej więcej 1 na 4 ze wszystkiego, co jest dziś aktywne.";

// Quiz-lane paragraphs (translated), with the live search link and the load-bearing
// lines bolded inline. Caption text mirrors the English source's meaning.
const quizParas = [
  `Nasza własna kategoria pokazuje dokładnie to samo. <a href="${QUIZ_LANE.searchUrl}" target="_blank" rel="external noopener nofollow" class="font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]">wyszukiwanie hasła "quiz" w Shopify</a> zwraca 149 aplikacji, ale zaufanie kumuluje się tu na szczycie dokładnie tak samo jak w całym sklepie. Trzy aplikacje, które przyszły pierwsze i nigdy nie odeszły, RevenueHunt, Octane AI i Quiz Kit, skupiają 45% wszystkich recenzji w kategorii; <strong>sam RevenueHunt ma około jednej czwartej</strong>, a dolna połowa nie ma żadnej.`,
  `Nie dotarliśmy na szczyt dzięki kodowi. <strong>Recenzje to objaw operacyjnej harówki</strong>, która za nimi stoi: sześć lat odpowiadania na zgłoszenia, dzwonienia do sklepów, które nigdy by nie zapłaciły, i zdobywania zaufania sklep po sklepie. Octane AI i Quiz Kit wykonywali tę samą ciężką pracę przez lata, <strong>i szanujemy ich za to</strong>. Wyróżnienie dla Lantern i Quizell, obie z nieco ponad 120 recenzjami.`,
];

// Methodology bullets carry their own inline <strong>; render as-is.
const methodologyHtml = METHODOLOGY;
---

<Base
  title={`${title} - raport z danymi 2026`}
  description={description}
  ogImage={ogImage}
  jsonLd={jsonLd}
  lang="pl"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={localizedHref("/", "pl")} class="hover:text-slate-700">Strona główna</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Stan ekonomii aplikacji Shopify</span>
      </nav>
      <div class="text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">
          Notatki z terenu · {publishedLabel}
        </p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          Stan ekonomii aplikacji Shopify
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          <strong>W Shopify App Store jest 22 546 aktywnych aplikacji i prawie żadna z nich nie osiąga niczego.</strong> Zrobiliśmy migawkę każdej aktywnej aplikacji, a potem przeanalizowaliśmy dane o wzroście, recenzjach, przychodach, cenach i tym, kto je tworzy. Wszystkie opowiadają jedną historię: stworzenie aplikacji nigdy nie było trudną częścią.
        </p>
      </div>
    </div>
  </section>

  <!-- Source band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-2xl bg-[#16161D] px-6 py-10 sm:px-10">
        <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#4dcaff]">
          Migawka
        </p>
        <dl class="mt-6 grid grid-cols-2 gap-8 text-center sm:grid-cols-4">
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.apps}</dt>
            <dd class="mt-1 text-sm text-white/70">aktywnych aplikacji w migawce</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.countries}</dt>
            <dd class="mt-1 text-sm text-white/70">krajów, które je tworzą</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.reviewless}</dt>
            <dd class="mt-1 text-sm text-white/70">bez żadnej recenzji</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.free}</dt>
            <dd class="mt-1 text-sm text-white/70">całkowicie darmowych, bez płatnego planu</dd>
          </div>
        </dl>
        <p class="mx-auto mt-6 max-w-3xl text-center text-sm text-white/60">
          Każda liczba poniżej pochodzi z publicznej oferty w App Store wszystkich 22 546 aktywnych aplikacji, czerwiec 2026. Przychody są szacowane na podstawie opublikowanych cen i sygnałów użycia, a nie danych rozliczeniowych, i są tak oznaczone w całym raporcie.
        </p>
      </div>
    </div>
  </section>

  <!-- Headline cards -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Najważniejsze liczby</h2>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        {HEADLINE.map((c, i) => (
          <div class="rounded-xl border border-slate-200 p-7">
            <p class="text-4xl font-bold tracking-tight text-[#16161D]">{c.stat}</p>
            <p class="mt-2 font-medium text-slate-900">{headlineT[i].label}</p>
            <p class="mt-2 text-sm text-slate-600">{headlineT[i].note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 01 Growth -->
  <section class="scroll-mt-20 bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("01", "Wzrost")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">10-krotny wzrost od 2020 roku</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center" set:html={growthCaptionHtml} />
      <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
        <div class="h-72 sm:h-80"><canvas id="c-growth" aria-label="Skumulowane aktywne aplikacje Shopify według roku" role="img"></canvas></div>
      </div>
    </div>
  </section>

  <!-- 02 Traction -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("02", "Trakcja")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Większość aplikacji nigdy nie zdobywa recenzji</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">Połowa Shopify App Store nigdy nie zdobyła ani jednej recenzji. Cztery na pięć aplikacji ma mniej niż 10. Recenzja to najwyraźniejszy publiczny wskaźnik prawdziwego, utrzymanego sklepu, a większość aplikacji nigdy żadnej nie dostaje.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-center text-sm font-semibold text-slate-900">Aplikacje według liczby recenzji</p>
          <div class="h-72 sm:h-80"><canvas id="c-reviews" aria-label="Rozkład recenzji wśród wszystkich aktywnych aplikacji" role="img"></canvas></div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">81%</p>
            <p class="mt-1 text-slate-700">ma mniej niż 10 recenzji</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="font-bold text-[#16161D]"><span class="text-3xl">{REVIEWS.medianReviews}</span> <span class="text-sm font-medium text-slate-500">recenzji</span></p>
            <p class="mt-1 text-slate-700">mediana, wśród aplikacji, które mają co najmniej jedną</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="font-bold text-[#16161D]"><span class="text-amber-400">★</span> <span class="text-3xl">{REVIEWS.avgRating}</span> <span class="text-sm font-medium text-slate-500">gwiazdki</span></p>
            <p class="mt-1 text-slate-700">średnia ocena, wśród {REVIEWS.ratedCount} aplikacji, które ją mają</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 Revenue -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("03", "Przychody · szacunkowo")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Pieniądze gromadzą się na samym szczycie</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">Szacowane miesięczne przychody są brutalnie skoncentrowane na górze. Górny 1% aplikacji (225 z nich) zgarnia szacunkowo 72%, a tylko 10 z tych aplikacji zgarnia samodzielnie prawie 30% wszystkich przychodów aplikacji. Zaledwie 36% aplikacji wydaje się w ogóle cokolwiek zarabiać. Skupia się też geograficznie: <strong>same USA i Kanada zgarniają szacunkowo 57%</strong> przychodów Shopify App Store.</p>
      <p class="mx-auto mt-3 max-w-3xl text-sm italic text-slate-500 text-center">Jedna nazwa góruje nad całym ekosystemem: aplikacja, która czerpie szacunkowo 78% swoich rocznych przychodów rzędu miliarda dolarów od sprzedawców Shopify. Tak, patrzymy na ciebie, <a href='https://www.sec.gov/Archives/edgar/data/1835830/000162828023030618/klaviyoincs-1.htm' target='_blank' rel='external noopener nofollow' class='font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]'>Klaviyo</a>.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-center text-sm font-semibold text-slate-900">Rozkład przychodów</p>
          <div class="h-64 sm:h-72"><canvas id="c-revenue-donut" aria-label="Podział szacowanych przychodów: 10 najlepszych aplikacji, reszta z 1% najlepszych i pozostałe 99%" role="img"></canvas></div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-center text-sm font-semibold text-slate-900">Szacowany przychód według kraju</p>
          <div class="h-64 sm:h-72"><canvas id="c-revenue-countries" aria-label="Szacowany przychód według kraju" role="img"></canvas></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 Pricing -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("04", "Ceny")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Prawie nikt nie pobiera opłaty z góry</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">Prawie połowa sklepu nie pobiera niczego z góry, a mniej niż 1 na 20 aplikacji żąda pieniędzy przed pierwszą instalacją. 57% płatnych aplikacji oferuje darmowy plan. Freemium nie jest tu strategią, to absolutne minimum, żeby wejść.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="text-center text-sm font-semibold text-slate-900">Ceny wejściowe wśród wszystkich 22 546 aktywnych aplikacji</p>
          <p class="mt-0.5 text-center text-xs text-slate-500">Cztery wzajemnie wykluczające się progi, według tego, czego aplikacja żąda na starcie.</p>
          <div class="mt-4 h-72 sm:h-80"><canvas id="c-pricing" aria-label="Podział modelu cenowego wśród wszystkich aktywnych aplikacji, według progu wejściowego" role="img"></canvas></div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">{PRICING.permanentFree}</p>
            <p class="mt-1 text-slate-700">oferują stały darmowy plan, nie tylko okres próbny</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">{PRICING.completelyFree}</p>
            <p class="mt-1 text-slate-700">są całkowicie darmowe, bez żadnego płatnego planu</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">{PRICING.entryPrice}</p>
            <p class="mt-1 text-slate-700">najczęstsza cena wejściowa, i mediana - {PRICING.entryPriceCount} aplikacji pobiera dokładnie tyle</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 Who builds them -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("05", "Kto je tworzy")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Sygnał kontra szum</h2>
