  <!-- Takeaway -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#4dcaff]">Wniosek</p>
