---
import Base from "../../layouts/Base.astro";
import { organization, breadcrumb } from "../../lib/schema";
import { SITE } from "../../lib/site";

interface Feature {
  text: string;
  /** Optional inline "more"/"view" link tail. */
  link?: { label: string; href: string };
  /** Plus icon instead of check (used for the Premium "+ Larger plans" line). */
  plus?: boolean;
}

interface Plan {
  name: string;
  /** Big price. "FREE" for the free plan, otherwise the numeric amount. */
  price: string;
  /** Small text next to the price (e.g. "USD/mo.") — omit on the free plan. */
  priceSuffix?: string;
  /** Asterisked sub-price line. */
  priceNote: string;
  tagline: string;
  features: Feature[];
}

const plans: Plan[] = [
  {
    name: "Free Plan",
    price: "FREE",
    priceNote: "* Yes, really!",
    tagline: "Perfect for new brands.",
    features: [
      { text: "100 quiz responses/mo." },
      { text: "Email support" },
      { text: "Create unlimited quizzes" },
      { text: "Custom quiz design" },
      { text: "Conditional logic" },
      { text: "Advanced quiz analytics" },
      { text: "Shopify Markets" },
      { text: "Export quiz leads to CSV" },
      { text: "GDPR & CCPA compliant" },
    ],
  },
  {
    name: "Basic Plan",
    price: "39",
    priceSuffix: "USD/mo.",
    priceNote: "* Billed monthly",
    tagline: "For growing mid-tier stores.",
    features: [
      { text: "500 quiz responses/mo." },
      { text: "Free features +" },
      { text: "Live chat support" },
      { text: "Custom HTML, CSS & JS" },
      { text: "GA4 & Meta Pixel" },
      { text: "Webhooks & Zapier" },
      { text: "Klaviyo, Omnisend &", link: { label: "more", href: "/integrations/" } },
    ],
  },
  {
    name: "Pro Plan",
    price: "99",
    priceSuffix: "USD/mo.",
    priceNote: "* Billed monthly",
    tagline: "For brands ready to scale.",
    features: [
      { text: "1,000 quiz responses/mo." },
      { text: "Basic features +" },
      { text: "Video call support" },
      { text: "Account manager" },
    ],
  },
  {
    name: "Premium Plan",
    price: "199",
    priceSuffix: "USD/mo.",
    priceNote: "* Billed monthly",
    tagline: "Established, multi-market brands.",
    features: [
      { text: "2,500 quiz responses/mo." },
      { text: "Pro features +" },
      { text: "Quarterly strategy review" },
      { text: "Larger plans -", link: { label: "view", href: "/demo/" }, plus: true },
    ],
  },
];

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Home", url: "/" },
    { name: "Pricing", url: "/pricing/" },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: "RevenueHunt — Product Recommendation Quiz",
    description:
      "Product recommendation quizzes for ecommerce. Free plan, paid plans from $39/mo.",
    brand: { "@type": "Brand", name: SITE.name },
    offers: plans.map((p) => ({
      "@type": "Offer",
      name: p.name,
      price: p.price === "FREE" ? "0" : p.price,
      priceCurrency: "USD",
      availability: "https://schema.org/InStock",
      url: SITE.site_url + "/pricing/",
    })),
  },
];
---

<Base
  title="Pricing — RevenueHunt"
  description="RevenueHunt pricing: free plan available. Paid plans from $39/mo. 15-day free trial with unlimited responses. 30-day money-back guarantee."
  jsonLd={jsonLd}
>
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-16 sm:py-20">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-slate-700">Home</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Pricing</span>
      </nav>

      <div class="text-center">
        <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          Choose the best plan for your eCommerce
        </h1>
        <p class="mt-4 text-base text-slate-700 sm:text-lg">
          Free plan available. 15-day free trial with unlimited quiz responses &amp; all features. 30-day money back guarantee.
        </p>
      </div>

      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {plans.map((plan) => (
          <li>
            <article class="flex h-full flex-col rounded-2xl bg-white p-6 shadow-sm">
              <h2 class="text-sm font-medium text-slate-700">{plan.name}</h2>
              <div class="mt-2 flex items-baseline gap-2">
                <span class="text-4xl font-bold tracking-tight text-slate-900">{plan.price}</span>
                {plan.priceSuffix && (
                  <span class="text-base text-slate-700">{plan.priceSuffix}</span>
                )}
              </div>
              <p class="mt-2 text-sm text-slate-600">{plan.priceNote}</p>
              <p class="mt-3 text-sm italic text-slate-500">{plan.tagline}</p>

              <hr class="my-5 border-slate-200" />

              <ul class="space-y-2.5 text-sm text-slate-800">
                {plan.features.map((f) => (
                  <li class="flex items-start gap-2">
                    {f.plus ? (
                      <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-slate-400" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <path d="M10 4v12M4 10h12"/>
                      </svg>
                    ) : (
                      <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-slate-900" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="4 11 8 15 16 5"/>
                      </svg>
                    )}
                    <span>
                      {f.text}
                      {f.link && (
                        <>
                          {" "}
                          <a href={f.link.href} class="font-medium text-slate-900 underline underline-offset-4 hover:text-slate-700">{f.link.label}</a>
                        </>
                      )}
                    </span>
                  </li>
                ))}
              </ul>
            </article>
          </li>
        ))}
      </ul>

      <p class="mx-auto mt-12 max-w-4xl text-center text-base text-slate-700">
        Large brand? We&rsquo;ve got you covered. Get a custom Enterprise Plan
        {" "}<strong class="font-semibold">starting at $299/mo.</strong>{" "}
        for unlimited quiz responses.{" "}
        <a href="/demo/" class="font-semibold text-slate-900 underline underline-offset-4 hover:text-slate-700">Book a strategy call</a>.
      </p>
    </div>
  </section>

  <!-- Enterprise / larger plans — two-column: title+CTA left, 5 checks right -->
  <section id="enterprise" class="mx-auto max-w-7xl px-6 py-12">
    <div class="overflow-hidden rounded-2xl bg-[#16161D] text-white">
      <div class="grid gap-10 p-8 md:grid-cols-2 md:p-12 lg:gap-16">
        <div>
          <p class="text-3xl font-bold tracking-tight sm:text-4xl">Need a larger plan?</p>
          <h2 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Ask about Enterprise.</h2>
          <a
            href="/demo/"
            class="mt-10 inline-flex items-center justify-center rounded-md border border-white bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:bg-white/10"
          >
            book a demo
          </a>
        </div>
        <ul class="space-y-5 md:pt-2">
          <li class="flex gap-3">
            <svg class="mt-1 h-5 w-5 flex-shrink-0 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="5 12 10 17 19 7"/></svg>
            <span class="text-white"><strong class="font-semibold">Starting at 299 USD/mo.</strong> (unlimited responses/mo.)</span>
          </li>
          <li class="flex gap-3">
            <svg class="mt-1 h-5 w-5 flex-shrink-0 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="5 12 10 17 19 7"/></svg>
            <span class="text-white">Designed for Shopify Plus-level growth. All features included.</span>
          </li>
          <li class="flex gap-3">
            <svg class="mt-1 h-5 w-5 flex-shrink-0 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="5 12 10 17 19 7"/></svg>
            <span class="text-white">Scalable pricing for high-volume &amp; multi-market brands</span>
          </li>
          <li class="flex gap-3">
            <svg class="mt-1 h-5 w-5 flex-shrink-0 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="5 12 10 17 19 7"/></svg>
            <span class="text-white">Bring your own contracts &amp; agreements (SLA, NDA…)</span>
          </li>
          <li class="flex gap-3">
            <svg class="mt-1 h-5 w-5 flex-shrink-0 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="5 12 10 17 19 7"/></svg>
            <span class="text-white">Done-for-you quiz building services (paid add-on)</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Two link rows beneath Enterprise block -->
  <section class="mx-auto max-w-3xl px-6 pb-20 text-center">
    <p class="text-slate-700">
      Do you have any questions regarding our Plans &amp; Pricing? —{" "}
      <a href="/faqs/" class="font-semibold text-slate-900 underline underline-offset-4 hover:text-slate-700">
        check out this FAQs article
      </a>
    </p>
    <p class="mt-3 text-slate-700">
      Need a plan with unlimited quiz responses? —{" "}
      <a href="/demo/" class="font-semibold text-slate-900 underline underline-offset-4 hover:text-slate-700">
        Book a demo
      </a>
    </p>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Turn shoppers into confident buyers with a Product Recommendation Quiz that drives sales.
      </h2>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a
          href={`${SITE.app_url}/signup`}
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          Sign up
        </a>
        <a
          href="/demo/"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          Book a demo
        </a>
      </div>
    </div>
  </section>
</Base>
