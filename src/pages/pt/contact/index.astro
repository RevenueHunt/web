---
import Base from "../../../layouts/Base.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import YouTubeFacade from "../../../components/YouTubeFacade.astro";
import { organization, breadcrumb } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Início", url: "/" },
    { name: "Contacto", url: "/contact/" },
  ]),
];

const channels = [
  {
    label: "Lê os guias de ajuda",
    href: "https://docs.revenuehunt.com/",
    note: "Documentação self-service, integrações, resolução de problemas.",
    external: true,
  },
  {
    label: "Suporte e vendas por email",
    href: "mailto:team@revenuehunt.com",
    note: "team@revenuehunt.com - consulta os tempos de resposta abaixo.",
  },
  {
    label: "Verifica o estado do sistema",
    href: "https://status.revenuehunt.com/",
    note: "Estado do serviço em tempo real e histórico de incidentes. 99,98%+ de disponibilidade.",
    external: true,
  },
];

const responseTiers = [
  {
    label: "Crítico - produção em baixo, segurança, integridade dos dados",
    sla: "Primeira resposta em 30 minutos, 24/7 em todo o mundo",
  },
  {
    label: "Alto - funcionalidade importante afetada, vários utilizadores afetados",
    sla: "Primeira resposta em 12 horas",
  },
  {
    label: "Padrão - perguntas, ajuda com a configuração",
    sla: "1 dia útil",
  },
  {
    label: "Baixa prioridade - feedback, pedidos de funcionalidades",
    sla: "Até 3 dias úteis",
  },
];
---

<Base
  title="Contacto - RevenueHunt"
  description="Entra em contacto com a equipa de suporte da RevenueHunt. Lê os guias de ajuda, vê o tutorial ou faz o quiz de suporte para obteres uma resposta personalizada em minutos."
  jsonLd={jsonLd}
  lang="pt"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20 text-center">
      <Breadcrumb items={[{ label: "Início", href: localizedHref("/", "pt") }, { label: "Contacto" }]} />
      <Eyebrow>Contacto</Eyebrow>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Entra em contacto
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600">
        Lê os guias de ajuda, vê o tutorial ou faz o nosso quiz de suporte aqui em baixo - a equipa de suporte mais
        perspicaz e simpática do e-commerce vai responder-te.
      </p>
    </div>
  </section>

  <!-- Two-column: video + channels -->
  <section class="mx-auto max-w-7xl px-6 py-12">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Começa pelo tutorial</h2>
        <p class="mt-3 text-slate-600">
          A maioria das perguntas é respondida no passo a passo de 3 minutos. Dá uma vista de olhos rápida antes de nos contactares.
        </p>
        <div class="mt-6 aspect-video overflow-hidden rounded-xl bg-slate-900 shadow-xl">
          <YouTubeFacade id="oL1DnBd6N1U" title="Tutorial de suporte da RevenueHunt" />
        </div>
      </div>
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Como contactar-nos</h2>
        <ul class="mt-6 space-y-3">
          {channels.map((c) => (
            <li>
              <a
                href={c.href}
                target={c.external ? "_blank" : undefined}
                rel={c.external ? "external noopener" : undefined}
                class="group flex items-start justify-between gap-4 rounded-xl border border-slate-200 bg-white p-5 transition hover:border-slate-300 hover:shadow-md"
              >
                <div>
                  <p class="text-base font-semibold text-slate-900 group-hover:text-[#16161D]">{c.label}</p>
                  <p class="mt-1 text-sm text-slate-600">{c.note}</p>
                </div>
                <span class="mt-1 shrink-0 text-slate-400 transition group-hover:text-[#16161D]" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Support quiz -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Faz o nosso quiz de suporte</h2>
      <p class="mx-auto mt-3 max-w-2xl text-slate-600">
        Responde a algumas perguntas rápidas e encaminhamos-te para a ajuda certa - documentação, tutorial ou uma resposta de uma pessoa real.
      </p>
      <div class="mx-auto mt-8 max-w-4xl overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <iframe
          src="https://admin.revenuehunt.com/public/quiz/ZAHJoMM"
          title="Quiz de suporte da RevenueHunt"
          loading="lazy"
          class="block h-[600px] w-full"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Response times — moved here from the right column so it sits under
       the quiz, since that's where visitors land after asking for help. -->
  <section class="mx-auto max-w-4xl px-6 py-16">
    <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm sm:p-10">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Tempos de resposta</h2>
      <p class="mt-3 text-slate-600">
        SLA de suporte por níveis para todos os merchants, com prioridade para contas Shopify Plus e enterprise.
      </p>
      <dl class="mt-6 grid gap-4 sm:grid-cols-2">
        {responseTiers.map((t) => (
          <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
            <dt class="text-sm font-semibold text-slate-900">{t.label}</dt>
            <dd class="mt-1 text-sm text-slate-600">{t.sla}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Base>
