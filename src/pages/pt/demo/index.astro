---
import Base from "../../../layouts/Base.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import { organization, breadcrumb } from "../../../lib/schema";
import { SITE } from "../../../lib/site";
import { localizedHref } from "../../../lib/i18n";

const QUIZ_URL = "https://admin.revenuehunt.com/public/quiz/8qHyAD6";

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Início", url: "/" },
    { name: "Agendar uma demo", url: "/demo/" },
  ]),
];
---

<Base
  title="Agendar uma demo - RevenueHunt"
  description="Vê o RevenueHunt em ação. Agenda uma chamada de 30 minutos com a nossa equipa para percorrer o produto, esclarecer dúvidas e planear o teu funil de quiz."
  jsonLd={jsonLd}
  lang="pt"
  translated={true}
>
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <Breadcrumb items={[{ label: "Início", href: localizedHref("/", "pt") }, { label: "Agendar uma demo" }]} />
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          <Eyebrow>Vê-o em ação</Eyebrow>
          <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
            Agenda uma demo com a nossa equipa
          </h1>
          <p class="mt-6 text-lg text-slate-700">
            A maioria dos compradores sai porque não consegue encontrar o produto certo. Vamos mostrar-te como um Quiz de recomendação de produtos resolve isso - ao vivo numa loja Shopify real, com as tuas perguntas em primeiro plano.
          </p>
          <ul class="mt-8 space-y-3 text-slate-700">
            <li class="flex gap-3">
              <svg class="mt-1 h-5 w-5 flex-shrink-0 text-emerald-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7 7a1 1 0 01-1.4 0l-4-4a1 1 0 011.4-1.4l3.3 3.3 6.3-6.3a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>
              Visita guiada de 30 minutos pelo construtor de quiz, pela página de resultados e pelas integrações
            </li>
            <li class="flex gap-3">
              <svg class="mt-1 h-5 w-5 flex-shrink-0 text-emerald-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7 7a1 1 0 01-1.4 0l-4-4a1 1 0 011.4-1.4l3.3 3.3 6.3-6.3a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>
              Adaptada ao tamanho do teu catálogo, à tua fonte de tráfego e aos teus objetivos de segmentação
            </li>
            <li class="flex gap-3">
              <svg class="mt-1 h-5 w-5 flex-shrink-0 text-emerald-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7 7a1 1 0 01-1.4 0l-4-4a1 1 0 011.4-1.4l3.3 3.3 6.3-6.3a1 1 0 011.4 0z" clip-rule="evenodd"/></svg>
              Sem pressão para te comprometeres - mostramos-te o que é possível e depois a decisão é tua
            </li>
          </ul>
          <div class="mt-10 flex flex-wrap gap-3">
            <a
              href="https://docs.revenuehunt.com/"
              target="_blank"
              rel="external noopener"
              class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
            >
              Explorar a central de ajuda ↗
            </a>
          </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-1 shadow-lg">
          <iframe
            src={QUIZ_URL}
            title="Agenda uma demo com o RevenueHunt"
            loading="lazy"
            class="h-[600px] w-full rounded-xl"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Preferes explorar por ti próprio? Começa grátis.
      </h2>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SITE.signup_url}
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          Registar
        </a>
      </div>
    </div>
  </section>
</Base>
