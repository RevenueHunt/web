---
import Base from "../../layouts/Base.astro";
import PlanCards from "../../components/pages/PlanCards.astro";
import YouTubeFacade from "../../components/YouTubeFacade.astro";
import { organization, website, softwareApplication } from "../../lib/schema";
import { SITE } from "../../lib/site";
import { localizedHref } from "../../lib/i18n";

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=bfs_badge_hero";
const WOOCOMMERCE_DOWNLOAD =
  "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";
const YOUTUBE_ID = "fJqpGJUzZNE";

const stats = [
  { value: "+20,000", label: "Marcas a usar a RevenueHunt" },
  { value: "+45M", label: "Quizzes concluídos" },
  { value: "+370M USD", label: "Receita para os comerciantes" },
  { value: "4.9 ★", label: "450+ avaliações de cinco estrelas" },
];

const pillars = [
  {
    image: "/img/pages/home/recommend-right-products.svg",
    title: "Recomenda os produtos certos",
    body:
      "Os quizzes shoppable impulsionam as vendas, aconselham os clientes a encontrar os produtos certos para eles e ajudam-nos a tomar decisões de compra com confiança.",
  },
  {
    image: "/img/pages/home/know-your-customers.svg",
    title: "Conhece os teus clientes",
    body:
      "Os quizzes permitem-te recolher dados acionáveis ao fazer perguntas direcionadas aos teus clientes. Segmenta e etiqueta os teus shoppers com base nas respostas.",
  },
  {
    image: "/img/pages/home/grow-your-audience.svg",
    title: "Faz crescer a tua audiência",
    body:
      "Envia os leads captados para a tua lista de email ou CRM. Aproveita os dados de perfil dos clientes para criar campanhas de marketing mais personalizadas e com maior ROI.",
  },
];

const features = [
  {
    kicker: "AI quiz copilot",
    title: "Cria um quiz em 60 segundos com AI",
    body:
      "Descreve a tua loja e o nosso copiloto de AI gera um quiz totalmente configurado - perguntas, lógica e mapeamentos de produtos - pronto a publicar.",
  },
  {
    kicker: "Conditional logic",
    title: "Lógica de ramificação por drag-and-drop",
    body:
      "Mostra ou esconde perguntas com base nas respostas anteriores. Guia cada shopper pelo caminho que termina numa compra - sem código.",
  },
  {
    kicker: "Quiz design",
    title: "Fá-lo teu - sem código",
    body:
      "Personaliza cores, tipos de letra, imagens e layout para combinar com a tua marca. O teu quiz parece parte da tua loja, não um widget de terceiros.",
  },
  {
    kicker: "Results page",
    title: "Uma página de resultados pronta para checkout que converte",
    body:
      "Mostra recomendações de produtos personalizadas agrupadas por passo da rotina - com imagens, preços e botões de adicionar ao carrinho. Os shoppers compram diretamente na página de resultados.",
  },
  {
    kicker: "Drop-off analytics",
    title: "Sabe exatamente onde os shoppers saem",
    body:
      "Vê as taxas de abandono, os destinos e os resultados pergunta a pergunta. Corrige pontos de atrito, melhora as conclusões e recupera a receita perdida.",
  },
  {
    kicker: "Third-party integrations",
    title: "Liga toda a tua stack de marketing",
    body:
      "Envia dados do quiz para o Google Analytics, dispara eventos do Meta Pixel para remarketing e sincroniza leads com o Klaviyo - tudo a partir de uma única página de definições. Sem código, sem middleware.",
  },
];

const steps = [
  {
    title: "Instala a app",
    body: "Instalação com um clique a partir da Shopify App Store ou do diretório de plugins do WordPress.",
  },
  {
    title: "Cria o teu quiz",
    body: "Usa o copiloto de AI ou o builder de drag-and-drop. Adiciona as tuas perguntas, define a tua lógica.",
  },
  {
    title: "Mapeia os teus produtos",
    body: "Liga as respostas do quiz ao teu catálogo de produtos. Recomenda a melhor correspondência por resultado.",
  },
  {
    title: "Publica e promove",
    body: "Incorpora em qualquer página, mostra-o em exit intent ou liga-o a partir dos teus anúncios.",
  },
];

const testimonials = [
  {
    quote:
      "Mudei do Octane. O processo de design foi muito mais intuitivo e visualmente agradável. Quando tive um problema com o Klaviyo, o suporte respondeu com uma rapidez relâmpago e uma atitude super conversacional e aberta.",
    author: "Kae Paché",
  },
  {
    quote:
      "O Eric foi extremamente paciente, conhecedor e minucioso - guiou-me passo a passo na configuração do quiz. Suporte como este é raro.",
    author: "Marcelle",
  },
  {
    quote:
      "A app em si é excelente: funcionalidades poderosas, usabilidade intuitiva. A equipa criou um tutorial passo a passo personalizado para nós. Já a usamos há mais de 3 anos.",
    author: "Didymos",
  },
  {
    quote:
      "De longe a melhor app de quiz e recomendação de produtos que testei na Shopify. A equipa dedicou tempo a investigar, a explicar cada passo com clareza e a orientar até o problema ficar totalmente resolvido.",
    author: "REYNA",
  },
  {
    quote:
      "Foi a 5.ª app de quiz que experimentei e a única que suportou totalmente o que eu precisava. Consegui criar o meu primeiro quiz muito depressa.",
    author: "CCA Printing",
  },
  {
    quote:
      "O apoio ao cliente destaca-se - um agente gravou um vídeo e guiou-me passo a passo na resolução. Muito atencioso e super prestável.",
    author: "The Love U Collective",
  },
];

const verticals = [
  { icon: "💄", title: "Beleza e cuidado da pele", body: "Localizadores de tipo de pele, correspondência de tons, construtores de rotina." },
  { icon: "💊", title: "Suplementos", body: "Quizzes de objetivos de saúde que recomendam o stack certo." },
  { icon: "👗", title: "Moda", body: "Quizzes de estilo que revelam o corte, a cor e o ajuste certos." },
  { icon: "🐾", title: "Animais de estimação", body: "Recomendações de produtos específicas por raça para cada dono." },
  { icon: "🍵", title: "Comida e bebida", body: "Quizzes de perfil de gosto que transformam curiosos em subscritores." },
  { icon: "🏋️", title: "Fitness", body: "Funis baseados em objetivos para equipamento, vestuário e programas." },
  { icon: "🏠", title: "Casa e decoração", body: "Quizzes de estilo que combinam mobiliário com cada espaço de vida." },
  { icon: "🌿", title: "Eco e sustentável", body: "Quizzes de correspondência de valores para o consumidor consciente." },
];

const brands = [
  "Olaplex", "Madluvv", "Mattel", "Alt", "Baia", "Bare", "Biktrix",
  "Dermocracy", "Diego", "Gisou", "Laura", "Nuxe", "Olcay",
  "Salad Code", "Salugea", "Sunday", "Tushy", "Tiege",
];

const SHOPIFY_REVIEWS =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/reviews?ratings%5B%5D=5&sort_by=relevance";
const WOOCOMMERCE_REVIEWS =
  "https://wordpress.org/support/plugin/product-recommendation-quiz-for-ecommerce/reviews/?filter=5";
---

<Base translated={true}
  lang="pt"
  title={`${SITE.name} - Quiz de recomendação de produtos que converte`}
  description="Transforma curiosos passivos em compradores com um Quiz de recomendação de produtos guiado. Capta zero-party data, recomenda o produto certo, aumenta a conversão. Sem código."
  jsonLd={[organization(), website(), softwareApplication()]}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-7xl px-6 py-16 lg:py-24">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:items-start lg:gap-16">
        <div>
          <a
            href={SHOPIFY_INSTALL}
            rel="external nofollow"
            onclick="window.gtag&&gtag('event','shopify_app_install',{event_label:'home_hero_badge'})"
            class="mb-6 inline-block"
          >
            <img
              src="/img/home/bfs-badge.webp"
              alt="Built for Shopify"
              width="120"
              height="38"
              class="h-8 w-auto"
              loading="eager"
            />
          </a>
          <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
            O Quiz de recomendação de produtos que transforma curiosos em compradores
          </h1>
          <p class="mt-6 max-w-xl text-lg text-slate-700">
            Os anúncios pagos trazem cliques - os nossos quizzes transformam-nos em vendas. A RevenueHunt guia os shoppers até aos produtos certos,
            recolhe dados e impulsiona as conversões. Fácil de instalar, sem código.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={SHOPIFY_INSTALL}
              rel="external nofollow"
              onclick="window.gtag&&gtag('event','shopify_app_install',{event_label:'home_hero'})"
              class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
            >
              instalar na Shopify
            </a>
            <a
              href={WOOCOMMERCE_DOWNLOAD}
              rel="external nofollow"
              onclick="window.gtag&&gtag('event','download_woocommerce_plugin',{event_label:'home_hero'})"
              class="inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-6 py-3 text-base font-semibold text-slate-900 transition hover:border-slate-400 hover:bg-slate-50"
            >
              obter para WooCommerce
            </a>
          </div>
          <p class="mt-4 text-sm text-slate-500">
            Plano gratuito disponível · 15 dias de teste grátis · 30 dias de garantia de devolução do dinheiro
          </p>
        </div>

        <div class="relative lg:mt-14">
          <div class="aspect-video overflow-hidden rounded-xl bg-slate-900 shadow-2xl">
            <YouTubeFacade
              id={YOUTUBE_ID}
              title="RevenueHunt - Quiz de recomendação de produtos"
              poster="/img/home/video-poster.webp"
              alt="Demo do Quiz de recomendação de produtos da RevenueHunt para lojas Shopify e WooCommerce"
              eager
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats / proof bar -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <p class="text-center text-sm font-semibold uppercase tracking-wider text-white/70">
        Porquê escolher a RevenueHunt? O nosso impacto fala por si
      </p>
      <dl class="mt-8 grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-4">
        {stats.map((s) => (
          <div class="text-center">
            <dt class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{s.value}</dt>
            <dd class="mt-2 text-sm text-white/70">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Problem framing -->
  <section class="mx-auto max-w-4xl px-6 py-20 text-center">
    <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
      Os shoppers nem sempre sabem o que comprar - e isso significa vendas perdidas.
    </h2>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-700">
      O nosso <a href={localizedHref("/product-recommendation-quiz/", "pt")} class="font-semibold text-slate-900 underline underline-offset-4 hover:text-slate-700">Quiz de recomendação de produtos</a> guia cada cliente ao longo da sua jornada, ajudando-o a descobrir e a comprar os produtos certos para ele.
    </p>
  </section>

  <!-- 3-up pillars -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="grid gap-10 md:grid-cols-3">
        {pillars.map((p) => (
          <div class="text-center">
            <img src={p.image} alt={p.title} width="120" height="120" class="mx-auto h-24 w-24" loading="lazy" />
            <h3 class="mt-6 text-xl font-semibold text-slate-900">{p.title}</h3>
            <p class="mt-3 text-slate-600">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features grid -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Tudo o que precisas para vender de forma mais inteligente</h2>
      </div>
      <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {features.map((f) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">{f.kicker}</p>
            <h3 class="mt-2 text-xl font-semibold text-slate-900">{f.title}</h3>
            <p class="mt-3 text-slate-600">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4-step setup -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">No ar em 4 passos. Em menos de 15 minutos.</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          Sem programadores. Sem código. Apenas um quiz que os teus clientes vão adorar.
        </p>
      </div>
      <ol class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <li class="rounded-xl border border-slate-200 bg-white p-6">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-[#16161D] text-sm font-bold text-white">{i + 1}</span>
            <h3 class="mt-4 text-lg font-semibold text-slate-900">{s.title}</h3>
            <p class="mt-2 text-slate-600">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          Vê porque os comerciantes adoram o Quiz de recomendação de produtos
        </h2>
        <p class="mx-auto mt-4 max-w-3xl text-lg text-slate-700">
          Usado por mais de 20.000 marcas e apoiado por 450+ avaliações de cinco estrelas na Shopify, WooCommerce e mais -
          a RevenueHunt é a app de quiz de referência para impulsionar vendas através da personalização. Só que não confies só na nossa palavra.
        </p>
        <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap text-sm">
          <a href={SHOPIFY_REVIEWS} rel="external nofollow" class="font-semibold text-[#16161D] underline-offset-4 hover:underline">
            Avaliações na Shopify →
          </a>
          <a href={WOOCOMMERCE_REVIEWS} rel="external nofollow" class="font-semibold text-[#16161D] underline-offset-4 hover:underline">
            Avaliações na WooCommerce →
          </a>
        </div>
      </div>

      <h3 class="mt-16 text-center text-xl font-semibold text-slate-900">O que os comerciantes dizem</h3>
      <div class="rh-carousel mt-8">
        <ul data-carousel class="rh-carousel__track" aria-label="Testemunhos de comerciantes">
          {testimonials.map((t) => (
            <li class="rounded-xl border border-slate-200 bg-white p-6">
              <p class="text-amber-500" aria-label="5 em 5 estrelas">★★★★★</p>
              <blockquote class="mt-3 text-slate-700">"{t.quote}"</blockquote>
              <p class="mt-4 text-sm font-semibold text-slate-900"> - {t.author}</p>
            </li>
          ))}
        </ul>
        <div data-carousel-dots class="rh-carousel__dots"></div>
      </div>
    </div>
  </section>

  <!-- Verticals -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Feito para todos os setores de eCommerce</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          Quer vendas cuidados de pele, suplementos ou sofás - um quiz que ajuda os shoppers a encontrar o produto certo converte melhor do que qualquer página de coleção.
        </p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {verticals.map((v) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6">
            <span class="block text-3xl" aria-hidden="true">{v.icon}</span>
            <h3 class="mt-3 text-base font-semibold text-slate-900">{v.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Brand logos -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-white sm:text-3xl">Damos força a marcas de eCommerce de topo</h2>
      <div class="brands-marquee mt-10">
        <ul class="brands-marquee__track" aria-label="Logótipos de marcas clientes">
          {brands.map((b) => (
            <li class="brands-marquee__item">
              <img
                src={`/img/brands/${b.toLowerCase().replace(/ /g, "-")}.svg`}
                alt={b}
                loading="lazy"
                width="160"
                height="40"
              />
            </li>
          ))}
          {brands.map((b) => (
            <li class="brands-marquee__item" aria-hidden="true">
              <img
                src={`/img/brands/${b.toLowerCase().replace(/ /g, "-")}.svg`}
                alt={`${b} logo`}
                loading="lazy"
                width="160"
                height="40"
              />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <style>
    .brands-marquee {
      overflow: hidden;
      -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
      mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    }
    .brands-marquee__track {
      display: flex;
      align-items: center;
      width: max-content;
      list-style: none;
      padding: 0;
      margin: 0;
      animation: brands-marquee 40s linear infinite;
    }
    .brands-marquee:hover .brands-marquee__track {
      animation-play-state: paused;
    }
    .brands-marquee__item {
      flex-shrink: 0;
      padding: 10px 24px;
      height: 64px;
      display: flex;
      align-items: center;
    }
    .brands-marquee__item img {
      height: 100%;
      width: auto;
      max-width: 160px;
      object-fit: contain;
      /* Normalize mixed-fill SVGs to white on the dark strip. */
      filter: brightness(0) invert(1);
      opacity: 0.85;
    }
    @keyframes brands-marquee {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }
    @media (prefers-reduced-motion: reduce) {
      .brands-marquee__track { animation: none; }
    }
  </style>

  <!-- Plans summary -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Escolhe o melhor plano para o teu eCommerce</h2>
        <p class="mt-4 text-base text-slate-700 sm:text-lg">
          Plano gratuito disponível. 15 dias de teste grátis com respostas de quiz ilimitadas &amp; todas as funcionalidades. 30 dias de garantia de devolução do dinheiro.
        </p>
      </div>

      <div class="mt-12">
        <PlanCards lang="pt" />
      </div>
    </div>
  </section>

  <!-- Multi-platform strip -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-16 text-center">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Funciona em várias plataformas de eCommerce</h2>
      <!-- Logos are white SVGs (built for a dark bg); brightness-0 inverts them to dark for this white section. -->
      <ul class="mt-10 flex flex-wrap items-center justify-center gap-x-14 gap-y-8">
        <li>
          <a href="/product-recommendation-quiz-shopify/" aria-label="Quiz de recomendação de produtos para Shopify">
            <img src="/img/logos/shopify_monotone_white.svg" alt="Shopify" class="h-8 w-auto opacity-60 brightness-0 transition hover:opacity-100" />
          </a>
        </li>
        <li>
          <a href="/product-recommendation-quiz-woocommerce/" aria-label="Quiz de recomendação de produtos para WooCommerce">
            <img src="/img/logos/woo_logo_white.svg" alt="WooCommerce" class="h-8 w-auto opacity-60 brightness-0 transition hover:opacity-100" />
          </a>
        </li>
        <li>
          <a href="/product-recommendation-quiz-bigcommerce/" aria-label="Quiz de recomendação de produtos para BigCommerce">
            <img src="/img/logos/bigcommerce_logo_white.svg" alt="BigCommerce" class="h-7 w-auto opacity-60 brightness-0 transition hover:opacity-100" />
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-white/70">
        A maioria dos shoppers vai-se embora porque não encontra o produto certo
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Transforma shoppers em compradores confiantes com um Quiz de recomendação de produtos que impulsiona as vendas.
      </h2>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SHOPIFY_INSTALL}
          rel="external nofollow"
          onclick="window.gtag&&gtag('event','shopify_app_install',{event_label:'home_bottom'})"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          instalar na Shopify
        </a>
        <a
          href={WOOCOMMERCE_DOWNLOAD}
          rel="external nofollow"
          onclick="window.gtag&&gtag('event','download_woocommerce_plugin',{event_label:'home_bottom'})"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          obter para WooCommerce
        </a>
      </div>
    </div>
  </section>
</Base>
