---
import Base from "../../../layouts/Base.astro";
import PageHero from "../../../components/PageHero.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import PartnerCard from "../../../components/PartnerCard.astro";
import { organization, breadcrumb } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

interface Partner {
  name: string;
  url: string;
  logo: string;
  description: string;
}

const groups: { heading: string; emoji: string; intro: string; items: Partner[] }[] = [
  {
    heading: "Localização",
    emoji: "🌍",
    intro: "Vende internacionalmente com geolocalização, tradução e multimoeda integradas.",
    items: [
      { name: "Orbe Shopify Geolocation", url: "https://apps.shopify.com/orbe?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/orbe-removebg-preview.webp", description: "Maximiza as vendas globais com geolocalização avançada de Shopify. Personaliza produtos, preços, moeda e conteúdo para cada país e guia os clientes até à experiência de compra certa com a Orbe." },
    ],
  },
  {
    heading: "Chat e suporte",
    emoji: "💬",
    intro: "Ferramentas de conta de cliente que tornam o autosserviço e o suporte simples.",
    items: [
      { name: "Dondy WhatsApp Marketing & Chat", url: "https://apps.shopify.com/dondy-marketing-ai?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/dondy-logo.webp", description: "Transforma o tráfego perdido em receita com fluxos automatizados de WhatsApp para recuperação, confirmação e retenção, além de um agente de IA que trata do apoio ao cliente para que a tua equipa não precise." },
    ],
  },
  {
    heading: "Upsell e recomendações",
    emoji: "🎯",
    intro: "Aumenta o valor médio do pedido com upsells no carrinho, listas de desejos e pré-encomendas.",
    items: [
      { name: "Smart Size Chart & Fit Finder", url: "https://smartsize.io/?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/smartsize-logo.webp", description: "Cria tabelas de tamanhos, guias de tamanhos e questionários 'qual é o meu tamanho' com IA em minutos: reduz as dúvidas sobre tamanhos e as devoluções enquanto aumentas a conversão." },
      { name: "WC Wishlist Club", url: "https://apps.shopify.com/wishlist-club?utm_source=RevenueHunt&utm_medium=partnership&utm_campaign=partnership", logo: "/img/pages/partners/wishlist-club-150-150-px-logo.webp", description: "O WC Wishlist Club permite que os teus clientes guardem os seus produtos favoritos, partilhem listas de desejos e comprem mais tarde - aumentando o envolvimento e as vendas. Fácil de configurar, otimizado para telemóvel e perfeito para transformar quem só está a ver em compradores fiéis." },
      { name: "iCart Cart Drawer Cart Upsell", url: "https://apps.shopify.com/icart/?campaign=promotion&medium=in-app-banner&source=revenuehunt&utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/iCart-Cart-Drawer-Cart-Upsell-logo.webp", description: "App completa de Shopify para personalizar um cart drawer e a página completa do carrinho com upsell, recomendações de produtos, barra de progresso, bundle de produtos e descontos." },
    ],
  },
  {
    heading: "Preços e descontos",
    emoji: "🏷️",
    intro: "Pacotes, descontos por volume e preços B2B que recompensam carrinhos maiores.",
    items: [
      { name: "Kaching Bundle Quantity Deals", url: "https://apps.shopify.com/bundle-deals?utm_source=RevenueHunt&utm_medium=partnership&utm_campaign=REVENUEH", logo: "/img/pages/partners/Kaching-Logo-1024x1024.webp", description: "Impulsiona as vendas com o Kaching Bundle Quantity Deals - cria ofertas de bundle diretamente na página do teu produto. Usa o código REVENUEH20 para um desconto exclusivo de 20%." },
      { name: "BSS: B2B/Wholesale Solution", url: "https://apps.shopify.com/b2b-solution-custom-pricing?utm_source=RevenueHunt&utm_medium=partnership&utm_campaign=partnership-2024", logo: "/img/pages/partners/BSS-Commerce_logo_150.webp", description: "Solução de wholesale completa. Uma experiência de compra B2B fluida que ajuda também os comerciantes a gerir os seus clientes de wholesale e a obter insights sobre eles." },
    ],
  },
  {
    heading: "Marketing e pop-ups",
    emoji: "📣",
    intro: "Prova social, programas de afiliados e campanhas na loja que impulsionam as vendas.",
    items: [
      { name: "UpPromote: Affiliate & Referral", url: "https://partners.secomapp.com/apps/affiliate/SHOPQUIZ_APP", logo: "/img/pages/partners/NEW_logo-1.webp", description: "A UpPromote é a app de afiliação/referência mais recomendada da Shopify App Store. Solução completa para criar e gerir as tuas campanhas de marketing, adequada para negócios de qualquer dimensão." },
    ],
  },
  {
    heading: "Fidelização e retenção",
    emoji: "💎",
    intro: "Contas de cliente, crédito em loja e listas de desejos que transformam compradores de primeira viagem em clientes recorrentes.",
    items: [
      { name: "Flits: Customer Account Page", url: "https://apps.shopify.com/flits?utm_source=revenuehunt&utm_medium=website&utm_id=app-partnership&utm_content=partner-page", logo: "/img/pages/partners/flits-logo.webp", description: "A Flits transforma a página de conta padrão da Shopify num hub de cliente com a tua marca, com crédito em loja, listas de desejos, recompra e login social — trazendo de volta os compradores de uma só vez para mais." },
    ],
  },
  {
    heading: "Envio e logística",
    emoji: "📦",
    intro: "Fornecimento, logística e incentivos de envio grátis para enviar mais rápido e escalar.",
    items: [
      { name: "Essential Free Shipping Bar", url: "https://apps.shopify.com/essential-order-value-booster?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/freeshippingbarlogo.webp", description: "Aumenta as vendas e o AOV configurando barras de envio grátis ilimitadas com múltiplos objetivos de valor de carrinho para motivar os compradores a adicionar mais produtos." },
      { name: "HyperSKU", url: "https://apps.shopify.com/hypersku?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/150150-logo.webp", description: "A HyperSKU oferece uma solução completa de cadeia de abastecimento. Mais de 1M de produtos, venda de bundles, amostragem, inspeção de qualidade, personalização de marca e fulfillment automatizado de encomendas." },
    ],
  },
  {
    heading: "Análise e relatórios",
    emoji: "📊",
    intro: "Dados de SEO e de pedidos para medir o que funciona e criar relatórios.",
    items: [
      { name: "AI SEO Optimizer", url: "https://share.seoant.com/app/1165b75b7ce1524D5J", logo: "/img/pages/partners/SEOAnt-_-AI-SEO-Optimizer_Channelwill-.webp", description: "A melhor app de SEO para Shopify - otimiza keywords, melhora as meta tags e aperfeiçoa a estrutura do site. Análises de desempenho e velocidade de SEO com tecnologia AI." },
    ],
  },
];

const perks = [
  { title: "Comissões por referência", body: "Angaria novos clientes para a RevenueHunt e recebe uma comissão vitalícia de 20% de toda a receita que gerarem." },
  { title: "Links de afiliado", body: "Adiciona os teus links de afiliado nos teus artigos, newsletters e publicações nas redes sociais. Liga diretamente às nossas apps de Shopify, WooCommerce, BigCommerce, Magento e standalone." },
  { title: "O teu próprio partner manager", body: "Recebe aconselhamento sobre como criar funis de vendas automatizados com a nossa ferramenta e dicas sobre como vender a nossa solução aos teus clientes." },
  { title: "Conteúdo exclusivo", body: "Contacta-nos para obter aconselhamento sobre como criar funis de vendas automatizados para os teus clientes usando a RevenueHunt e outras ferramentas." },
  { title: "Um lugar no nosso Partner Directory", body: "Os nossos utilizadores vão encontrar-te no nosso Partner Directory e contactar-te para contratar os teus serviços." },
];

const faqs = [
  { q: "Quanto custa tornar-me parceiro?", a: "Registar é completamente grátis. Zero. Nada." },
  { q: "Tenho de ser cliente da RevenueHunt?", a: "Não, não tens de ser cliente da RevenueHunt para te tornares parceiro." },
  { q: "Como vou receber o pagamento?", a: "Pagamos os ganhos mensalmente. Os pagamentos são enviados via PayPal." },
  { q: "Como posso acompanhar as minhas referências?", a: "Podes ver as tuas estatísticas no teu <a href='https://admin.revenuehunt.com/' target='_blank' rel='external noopener' class='font-semibold text-[#16161D] underline'>Partner Dashboard</a>." },
];

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Início", url: "/" },
    { name: "Parceiros e afiliados", url: "/partners/" },
  ]),
];
---

<Base
  title="Programa de parceiros - RevenueHunt"
  description="Recomenda os teus clientes. Ganha dinheiro. Recebe uma comissão vitalícia de 20% dos clientes que recomendares à RevenueHunt. Regista-te gratuitamente no nosso Programa de Parceiros."
  jsonLd={jsonLd}
  lang="pt"
  translated={true}
>
  <!-- Hero -->
  <PageHero center>
      <Breadcrumb items={[{ label: "Início", href: localizedHref("/", "pt") }, { label: "Parceiros e afiliados" }]} />
      <Eyebrow>Programa de parceiros</Eyebrow>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Recomenda os teus clientes. Ganha dinheiro.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-xl text-slate-600">
        Recebe uma <strong class="font-semibold text-slate-900">comissão vitalícia de 20%</strong> dos clientes que nos recomendares. Regista-te hoje gratuitamente no nosso Programa de Parceiros.
      </p>
      <p class="mx-auto mt-6 max-w-3xl text-slate-600">
        Se és uma <strong class="font-semibold text-slate-900">agência de marketing digital</strong> ou um
        <strong class="font-semibold text-slate-900">especialista em ecommerce</strong> e queres fazer crescer o teu negócio,
        o nosso Programa de Parceiros é para ti. Cria experiências fantásticas para os teus clientes com a RevenueHunt.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
        >
          Começa agora
        </a>
        <a
          href="#partners"
          class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
        >
          Ver os nossos parceiros
        </a>
      </div>
  </PageHero>

  <!-- Who you are + perks -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-1">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Quem és</h2>
        <p class="mt-4 text-slate-600">
          És uma agência de marketing digital ou um consultor de ecommerce apaixonado por design e obcecado por
          <strong class="font-semibold text-slate-900">obter os melhores resultados</strong> para os teus clientes. Fazes crescer
          o teu negócio capacitando outros negócios.
        </p>
      </div>
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">O que recebes de nós</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {perks.map((p) => (
            <li class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="text-base font-semibold text-slate-900">{p.title}</h3>
              <p class="mt-2 text-sm text-slate-600">{p.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Partner directory -->
  <section id="partners" class="mx-auto max-w-7xl px-6 py-16 scroll-mt-24">
    <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Os nossos parceiros</h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
      Apps e agências de confiança que combinam na perfeição com a RevenueHunt para os teus clientes.
    </p>
    <div class="mt-12 space-y-16">
      {groups.map((g) => (
        <div>
          <div class="mb-2 flex items-baseline gap-3">
            <span class="text-2xl" aria-hidden="true">{g.emoji}</span>
            <h3 class="text-2xl font-semibold tracking-tight text-slate-900">{g.heading}</h3>
          </div>
          <p class="max-w-3xl text-slate-600">{g.intro}</p>
          <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {g.items.map((p) => (
        <PartnerCard {...p} alt={`Logótipo de ${p.name}`} cta="Instalar app" />
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Perguntas frequentes</h2>
      <div class="mx-auto mt-8 max-w-2xl">
        {faqs.map((f) => (
          <details class="border-b border-slate-200">
            <summary class="py-4 text-base font-semibold text-slate-900">{f.q}</summary>
            <p class="pb-4 text-slate-600" set:html={f.a}></p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Torna-te parceiro da RevenueHunt
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        Recomenda os teus clientes, cria funis de vendas automatizados e ganha uma comissão vitalícia de 20% de tudo o que gastarem.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          Começa agora
        </a>
        <a
          href={localizedHref("/demo/", "pt")}
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          Agenda uma demo
        </a>
      </div>
    </div>
  </section>
</Base>
