---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

interface Partner {
  name: string;
  url: string;
  logo: string;
  description: string;
}

const partners: Partner[] = [
  { name: "Taranker", url: "https://taranker.com/", logo: "/img/pages/partners/Icon512.webp", description: "A Taranker é uma plataforma inovadora dedicada a ajudar os negócios de ecommerce a encontrar as melhores ferramentas para otimizar as suas operações. Especializada em recomendações de apps, análises de especialistas e seleções de apps curadas." },
  { name: "SalesHunterThemes", url: "https://saleshunterthemes.com/?utm_source=app-providers&utm_medium=revenuehunt&utm_campaign=partnership-app&utm_content=website", logo: "/img/pages/partners/saleshunterthemes-logo.webp", description: "Impulsiona a tua loja com os themes premium de Shopify da SalesHunterThemes. Designs modernos e responsivos que otimizam o desempenho e a experiência do utilizador, com amplas opções de personalização." },
  { name: "Fulfillman", url: "https://www.fulfillman.com/", logo: "/img/pages/partners/fulfillmanlogo.webp", description: "A Fulfillman é uma líder global em sourcing, fulfillment e logística para ecommerce, oferecendo envios rápidos e fiáveis através de serviços dedicados de linha privada." },
  { name: "WC Wishlist Club", url: "https://apps.shopify.com/wishlist-club?utm_source=revenuehunt&utm_medium=website&utm_campaign=partnership", logo: "/img/pages/partners/wishlist-club-150-150-px-logo.webp", description: "O WC Wishlist Club permite que os teus clientes guardem os seus produtos favoritos, partilhem listas de desejos e comprem mais tarde - aumentando o envolvimento e as vendas. Fácil de configurar, otimizado para telemóvel e perfeito para transformar quem só está a ver em compradores fiéis." },
  { name: "Langwill: Language Translate", url: "https://partner.channelwill.com/ceq5ql", logo: "/img/pages/partners/1.webp", description: "Expande o teu alcance global com a Langwill - traduz a tua loja de Shopify para 138 idiomas e converte moedas automaticamente para uma experiência de compra fluida e localizada." },
  { name: "Orbe Shopify Geolocation", url: "https://orbe.app/", logo: "/img/pages/partners/orbe-removebg-preview.webp", description: "Maximiza as vendas globais com geolocalização avançada de Shopify. Personaliza produtos, preços, moeda e conteúdo para cada país e guia os clientes até à experiência de compra certa com a Orbe." },
  { name: "Checkout Extensions Pro", url: "https://apps.shopify.com/checkout-extensions-pro?utm_source=drip", logo: "/img/pages/partners/CHECKOUT-Extension-Pro-logo_0101.webp", description: "Potencia o teu checkout de Shopify Plus com descontos de upsell personalizados, upsells com AI, uma barra de envio grátis, ofertas pós-compra, selos de confiança, avaliações e muito mais." },
  { name: "Customer Dashboard Pro", url: "https://apps.shopify.com/customer-dashboard-pro?utm_source=revenuehunt", logo: "/img/pages/partners/CustomerDashboard.webp", description: "O Customer Dashboard Pro é a única app que oferece suporte fluido tanto para as New Customer Accounts da Shopify como para as Classic Customer Accounts." },
  { name: "WISS Bundle", url: "https://apps.shopify.com/wiss-bundle", logo: "/img/pages/partners/Logo-9.webp", description: "Aumenta a receita e o AOV da tua loja de Shopify com uma app de bundles de produtos simples e personalizável. Oferece opções de desconto flexíveis: descontos por valor, envio grátis em produtos agrupados ou compra X e leva Y." },
  { name: "ToastiBar – Sales Popup", url: "https://makeprosimp.com/partnership/revenuehunt", logo: "/img/pages/partners/toastibarlogo_fgaiv9.webp", description: "Aumenta a confiança dos clientes e impulsiona as vendas mostrando prova social em tempo real: vendas, carrinho, visitantes, avaliações de produtos e alertas de inventário." },
  { name: "UpPromote: Affiliate & Referral", url: "https://partners.secomapp.com/apps/affiliate/SHOPQUIZ_APP", logo: "/img/pages/partners/NEW_logo-1.webp", description: "A UpPromote é a app de afiliação/referência mais recomendada da Shopify App Store. Solução completa para criar e gerir as tuas campanhas de marketing, adequada para negócios de qualquer dimensão." },
  { name: "Essential Free Shipping Bar", url: "https://essential-apps.com/essential-shopify-free-shipping-bar-application/", logo: "/img/pages/partners/freeshippingbarlogo.webp", description: "Aumenta as vendas e o AOV configurando barras de envio grátis ilimitadas com múltiplos objetivos de valor de carrinho para motivar os compradores a adicionar mais produtos." },
  { name: "iCart Cart Drawer Cart Upsell", url: "https://apps.shopify.com/icart/?campaign=promotion&medium=in-app-banner&source=revenuehunt", logo: "/img/pages/partners/iCart-Cart-Drawer-Cart-Upsell-logo.webp", description: "App completa de Shopify para personalizar um cart drawer e a página completa do carrinho com upsell, recomendações de produtos, barra de progresso, bundle de produtos e descontos." },
  { name: "Kaching Bundle Quantity Deals", url: "https://apps.shopify.com/bundle-deals?utm_source=partnership&utm_medium=web&utm_campaign=REVENUEH", logo: "/img/pages/partners/Kaching-Logo-1024x1024.webp", description: "Impulsiona as vendas com o Kaching Bundle Quantity Deals - cria ofertas de bundle diretamente na página do teu produto. Usa o código REVENUEH20 para um desconto exclusivo de 20%." },
  { name: "PDF Invoice Generator", url: "https://apps.shopify.com/fordeer-invoice-order-printer?utm_source=ShopQuizProductRecommender&utm_medium=comarketing&utm_campaign=partner", logo: "/img/pages/partners/fordeer-data-export-1024x1024.webp", description: "O gerador de faturas de Shopify da Fordeer é flexível, cumpre a regulamentação global e serve B2C, B2B e Wholesale. Modelos PDF personalizáveis, impressão em lote, suporte por chat ao vivo 24/7." },
  { name: "HyperSKU", url: "https://www.hypersku.com/", logo: "/img/pages/partners/150150-logo.webp", description: "A HyperSKU oferece uma solução completa de cadeia de abastecimento. Mais de 1M de produtos, venda de bundles, amostragem, inspeção de qualidade, personalização de marca e fulfillment automatizado de encomendas." },
  { name: "Service Points", url: "https://www.servicepoints.eu/en/w2/smart-dropshipping-1?utm_source=revenuehunt&utm_medium=app&utm_id=31", logo: "/img/pages/partners/Logo-Black-background.webp", description: "A Service Points apresenta o SMART Dropshipping: dropshipping automatizado e decisões de cadeia de abastecimento baseadas em dados para escalar de forma infinita." },
  { name: "AI SEO Optimizer", url: "https://share.seoant.com/app/1165b75b7ce1524D5J", logo: "/img/pages/partners/SEOAnt-_-AI-SEO-Optimizer_Channelwill-.webp", description: "A melhor app de SEO para Shopify - otimiza keywords, melhora as meta tags e aperfeiçoa a estrutura do site. Análises de desempenho e velocidade de SEO com tecnologia AI." },
  { name: "BSS: B2B/Wholesale Solution", url: "https://apps.shopify.com/b2b-solution-custom-pricing?utm_source=RevenueHunt&utm_medium=partner-listing&utm_campaign=partnership-2024", logo: "/img/pages/partners/BSS-Commerce_logo_150.webp", description: "Solução de wholesale completa. Uma experiência de compra B2B fluida que ajuda também os comerciantes a gerir os seus clientes de wholesale e a obter insights sobre eles." },
  { name: "PreOrder Now WOD", url: "https://apps.shopify.com/preorder-now?utm_source=+revenuehunt&utm_medium=web&utm_campaign=partner&utm_id=crosspromo", logo: "/img/pages/partners/PreOrder-Now-Logo.webp", description: "Transforma cenários de rutura de stock em oportunidades de pré-encomenda. Perfeito para negócios de print-on-demand - capta o interesse dos clientes sem stock inicial." },
];

const perks = [
  { title: "Comissões por referência", body: "Angaria novos clientes para a RevenueHunt e recebe uma comissão vitalícia de 20% de toda a receita que gerarem." },
  { title: "Links de afiliado", body: "Adiciona os teus links de afiliado nos teus artigos, newsletters e publicações nas redes sociais. Liga diretamente às nossas apps de Shopify, WooCommerce, BigCommerce, Magento e standalone." },
  { title: "O teu próprio partner manager", body: "Recebe aconselhamento sobre como criar funis de vendas automatizados com a nossa ferramenta e dicas sobre como vender a nossa solução aos teus clientes." },
  { title: "Conteúdo exclusivo", body: "Contacta-nos para obter aconselhamento sobre como criar funis de vendas automatizados para os teus clientes usando a RevenueHunt e outras ferramentas." },
  { title: "Um lugar no nosso Partner Directory", body: "Os nossos utilizadores vão encontrar-te no nosso Partner Directory e contactar-te para contratar os teus serviços." },
];

const faqs = [
  { q: "Quanto custa tornar-me parceiro?", a: "Registar é completamente grátis. Zero. Nada." },
  { q: "Tenho de ser cliente da RevenueHunt?", a: "Não, não tens de ser cliente da RevenueHunt para te tornares parceiro." },
  { q: "Como vou receber o pagamento?", a: "Pagamos os ganhos mensalmente. Os pagamentos são enviados via PayPal." },
  { q: "Como posso acompanhar as minhas referências?", a: "Podes ver as tuas estatísticas no teu Partner Dashboard." },
];

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Início", url: "/" },
    { name: "Parceiros e afiliados", url: "/partners/" },
  ]),
];
---

<Base
  title="Programa de parceiros - RevenueHunt"
  description="Recomenda os teus clientes. Ganha dinheiro. Recebe uma comissão vitalícia de 20% dos clientes que recomendares à RevenueHunt. Regista-te gratuitamente no nosso Programa de Parceiros."
  jsonLd={jsonLd}
  lang="pt"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20 text-center">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={localizedHref("/", "pt")} class="hover:text-slate-700">Início</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Parceiros e afiliados</span>
      </nav>
      <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">Programa de parceiros</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Recomenda os teus clientes. Ganha dinheiro.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-xl text-slate-600">
        Recebe uma comissão vitalícia de 20% dos clientes que nos recomendares. Regista-te hoje gratuitamente no nosso Programa de Parceiros.
      </p>
      <p class="mx-auto mt-6 max-w-3xl text-slate-600">
        Se és uma <strong class="font-semibold text-slate-900">agência de marketing digital</strong> ou um
        <strong class="font-semibold text-slate-900">especialista em ecommerce</strong> e queres fazer crescer o teu negócio,
        o nosso Programa de Parceiros é para ti. Cria experiências fantásticas para os teus clientes com a RevenueHunt.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
        >
          Começa agora
        </a>
        <a
          href="#partners"
          class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
        >
          Ver os nossos parceiros
        </a>
      </div>
    </div>
  </section>

  <!-- Who you are + perks -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-1">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Quem és</h2>
        <p class="mt-4 text-slate-600">
          És uma agência de marketing digital ou um consultor de ecommerce apaixonado por design e obcecado por
          <strong class="font-semibold text-slate-900">obter os melhores resultados</strong> para os teus clientes. Fazes crescer
          o teu negócio capacitando outros negócios.
        </p>
      </div>
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">O que recebes de nós</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {perks.map((p) => (
            <li class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="text-base font-semibold text-slate-900">{p.title}</h3>
              <p class="mt-2 text-sm text-slate-600">{p.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Perguntas frequentes</h2>
      <div class="mx-auto mt-8 max-w-2xl">
        {faqs.map((f) => (
          <details class="border-b border-slate-200">
            <summary class="py-4 text-base font-semibold text-slate-900">{f.q}</summary>
            <p class="pb-4 text-slate-600">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Partner directory -->
  <section id="partners" class="mx-auto max-w-7xl px-6 py-16 scroll-mt-24">
    <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Os nossos parceiros</h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
      Apps e agências de confiança que combinam na perfeição com a RevenueHunt para os teus clientes.
    </p>
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {partners.map((p) => (
        <li>
          <a
            href={p.url}
            target="_blank"
            rel="external noopener nofollow"
            class="group flex h-full flex-col items-center rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm transition hover:border-slate-300 hover:shadow-md"
          >
            <img
              src={p.logo}
              alt={`Logótipo de ${p.name}`}
              loading="lazy"
              width="120"
              height="120"
              class="h-24 w-24 rounded-full object-cover"
            />
            <h3 class="mt-5 text-lg font-semibold text-slate-900 group-hover:text-[#16161D]">{p.name}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{p.description}</p>
            <span class="mt-5 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wider text-slate-500 group-hover:text-[#16161D]">
              Visitar site <span aria-hidden="true">↗</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Torna-te parceiro da RevenueHunt
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        Recomenda os teus clientes, cria funis de vendas automatizados e ganha uma comissão vitalícia de 20% de tudo o que gastarem.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          Começa agora
        </a>
        <a
          href={localizedHref("/demo/", "pt")}
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          Agenda uma demo
        </a>
      </div>
    </div>
  </section>
</Base>
