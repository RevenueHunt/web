---
import Base from "../../../layouts/Base.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import { organization, breadcrumb, softwareApplication, faqPage } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=roi_calculator";
// Free WordPress.org plugin (not the WooCommerce.com extension).
const WOO_PLUGIN = "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";

// Inputs. The quiz-taker conversion rate carries a benchmark flag (RevenueHunt
// data badge + helper note) and is editable. The AOV uplift is NOT a visible
// input: it is set by the sector dropdown (hidden #aovlift field) from the
// within-store paired result (median +11% to +15%, concentrated in skincare/
// beauty/supplements, flat in a few categories) and folded into the math.
// Everything else is the merchant's own number.
// (Data: PRD-Octane-AI-SEO-Reverse-Engineering W7 deep-dive note.)
const controls = [
  { id: "visitors", label: "Visitantes mensais da loja", min: 500, max: 500000, step: 500, value: 10000, suffix: "" },
  { id: "engage", label: "Percentagem de visitantes que fazem o quiz", min: 1, max: 100, step: 1, value: 20, suffix: "%" },
  { id: "aov", label: "O teu valor médio do pedido", min: 10, max: 1000, step: 5, value: 60, suffix: "$" },
  { id: "cvr", label: "A tua taxa de conversão atual", min: 0.1, max: 15, step: 0.1, value: 2, suffix: "%" },
  { id: "quizcvr", label: "Taxa de conversão de quem faz o quiz", min: 1, max: 50, step: 0.5, value: 5.5, suffix: "%", benchmark: true, note: "Pré-preenchido com o nosso benchmark medido: em média, 1 em cada 18 pessoas que fazem o quiz fazem um pedido. Edita-o para corresponder à tua loja." },
];

// Sector presets for the "what do you sell?" selector. Each sets the quiz-taker
// conversion rate and AOV uplift from measured RevenueHunt data, plus a "% of the
// average store" figure (quiz rate / a 2% average). "All sectors" is the 5.5%
// platform average (= 275%, the brand stat). "Other sectors" is the honest
// residual (everything except the consumable stars), measured at ~3.6% (~180%).
// Selecting a sector pre-fills quizcvr + aovlift; both stay editable.
// (Data: PRD-Octane-AI-SEO-Reverse-Engineering W7 deep-dive note.)
const SECTORS = [
  { id: "all", label: "Todos os setores (média)", quizcvr: 5.5, aovlift: 10, pct: 275 },
  { id: "haircare", label: "Cuidado do cabelo", quizcvr: 7, aovlift: 15, pct: 350 },
  { id: "fragrance", label: "Fragrâncias", quizcvr: 7, aovlift: 0, pct: 350 },
  { id: "beauty", label: "Beleza e cuidado da pele", quizcvr: 6, aovlift: 20, pct: 300 },
  { id: "supplements", label: "Suplementos e saúde", quizcvr: 6, aovlift: 10, pct: 300 },
  { id: "coffee", label: "Café e chá", quizcvr: 5, aovlift: 0, pct: 250 },
  { id: "other", label: "Outros setores", quizcvr: 3.6, aovlift: 10, pct: 180 },
];

// Per-vertical conversion (response to order), measured in RevenueHunt data and
// rounded down. The 5.5% benchmark is a platform average; consumable categories
// run higher. Shown as a "conversion by category" proof block.
const BY_VERTICAL = [
  { v: "Cuidado do cabelo", pct: "350%", lift: "+15% AOV" },
  { v: "Fragrâncias", pct: "350%", lift: "AOV sem alteração" },
  { v: "Cuidado da pele e beleza", pct: "300%", lift: "+20% AOV" },
  { v: "Suplementos", pct: "300%", lift: "+10% AOV" },
  { v: "Café e chá", pct: "250%", lift: "AOV sem alteração" },
  { v: "Outros setores", pct: "180%", lift: "+10% AOV" },
];

// Real, data-backed proof points shown on the page. The 275% is the measured
// 5.5% quiz-taker conversion (1 in 18) expressed against a typical 2% store
// rate: 5.5 / 2 = 2.75x = 275% of baseline (accurate as "of", not "+lift").
const PROOF = [
  { stat: "45M+", label: "respostas de quiz analisadas" },
  { stat: "275%", label: "da taxa de conversão média" },
  { stat: "$370M+", label: "de receita gerada para comerciantes" },
  { stat: "20.000+", label: "marcas usam RevenueHunt" },
];

const faqs: { question: string; answer: string; answerHtml?: string }[] = [
  {
    question: "De onde vem a taxa de conversão do quiz?",
    answer:
      "É um benchmark de dados reais da RevenueHunt. No conjunto de respostas de quiz, 5,5% dos compradores que completam um quiz (cerca de 1 em cada 18) acabam por fazer um pedido medido. O campo vem pré-preenchido com esse benchmark, e podes editá-lo para corresponder à tua própria loja.",
  },
  {
    question: "Como é calculada a receita extra?",
    answer:
      "A calculadora pega na percentagem dos teus visitantes que completam o quiz, aplica-lhes a taxa de conversão de quem faz o quiz e compara isso com a conversão que esses mesmos visitantes teriam à taxa atual do teu site. A diferença, multiplicada pelo teu valor médio do pedido, é a receita extra estimada.",
  },
  {
    question: "Quem faz o quiz gasta mais por pedido?",
    answer:
      "Em média, sim, comparando o que é comparável. Dentro da mesma loja, os pedidos que chegaram através de um quiz são cerca de 10% mais altos do que os que não chegaram. Não é igual em todo o lado: mais forte em categorias como cuidado da pele, beleza e suplementos, e quase sem alteração noutras. A calculadora tem isto em conta automaticamente conforme o setor que escolheres.",
  },
  {
    question: "Isto baseia-se em dados reais ou em multiplicadores inventados?",
    answer:
      "Dados reais. O benchmark de conversão do quiz é medido em mais de 45 milhões de respostas de quiz e mais de 370 milhões de dólares em receita gerada para comerciantes. Os teus visitantes, o teu valor médio do pedido e a tua taxa de conversão atual são os teus próprios números. O resultado é uma estimativa, não uma garantia.",
  },
  {
    question: "Onde posso ver todos os dados por trás destes benchmarks?",
    answer:
      "No nosso relatório benchmark de quizzes de e-commerce. Detalha a conversão por categoria, o aumento do valor médio do pedido, a conclusão e a atribuição ao longo de mais de 45M de respostas de quiz reais. O benchmark de 5,5% e os valores por setor desta calculadora saem diretamente dele.",
    answerHtml:
      "No nosso <a href=\"" + localizedHref("/state-of-product-recommendation-quizzes/", "pt") + "\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">relatório benchmark de quizzes de e-commerce</a>. Detalha a conversão por categoria, o aumento do valor médio do pedido, a conclusão e a atribuição ao longo de mais de 45M de respostas de quiz reais. O benchmark de 5,5% e os valores por setor desta calculadora saem diretamente dele.",
  },
  {
    question: "A calculadora é grátis?",
    answer:
      "Sim. É gratuita e sem barreiras, não é preciso email. A própria RevenueHunt também tem um plano gratuito com 100 respostas de quiz por mês, por isso podes medir o aumento real na tua própria loja.",
  },
];

const jsonLd = [
  organization(),
  softwareApplication(),
  breadcrumb([
    { name: "Início", url: "/" },
    { name: "Calculadora de ROI do quiz", url: "/quiz-roi-calculator/" },
  ]),
  faqPage(faqs),
];
---

<Base
  title="Calculadora de ROI do quiz para e-commerce"
  description="Calculadora de ROI do quiz gratuita baseada em dados reais: 5,5% de quem faz o quiz faz um pedido. Estima a receita extra e o ROI que um quiz poderia trazer à tua loja."
  ogImage="/og/quiz-roi-calculator.png"
  jsonLd={jsonLd}
  lang="pt"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <Breadcrumb items={[{ label: "Início", href: localizedHref("/", "pt") }, { label: "Calculadora de ROI do quiz" }]} />
      <div class="text-center">
        <Eyebrow>Ferramenta gratuita</Eyebrow>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">Calculadora de ROI do quiz</h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          Vê a receita extra que um Quiz de recomendação de produtos poderia trazer à tua loja. O benchmark de conversão de 275% é real, <a href={localizedHref("/state-of-product-recommendation-quizzes/", "pt")} class="font-semibold text-[#16161D] underline decoration-2 decoration-[#16161D]/40 underline-offset-2 hover:decoration-[#16161D]">medido em mais de 45M de respostas de quiz</a>, não um multiplicador inventado. Ajusta os dados para corresponderem aos teus números.
        </p>
      </div>
    </div>
  </section>

  <!-- Real-data proof band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-8">
      <div class="rounded-2xl bg-[#16161D] px-6 py-10 sm:px-10">
        <p class="text-center text-sm font-semibold uppercase tracking-wider text-white/50">Baseado em dados reais da RevenueHunt</p>
        <dl class="mt-6 grid grid-cols-2 gap-8 text-center sm:grid-cols-4">
          {PROOF.map((p) => (
            <div>
              <dt class="text-3xl font-bold tracking-tight text-white">{p.stat}</dt>
              <dd class="mt-1 text-sm text-white/70">{p.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- Calculator -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 pb-8 pt-10">
      <div class="grid gap-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm lg:grid-cols-2 lg:p-8">
        <!-- Inputs -->
        <form id="roi-form" class="space-y-6" aria-label="Dados do ROI do quiz">
          <div>
            <label for="sector" class="text-sm font-medium text-slate-900">O que vendes?</label>
            <select
              id="sector"
              class="mt-2 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-900 focus:border-[#16161D] focus:outline-none focus:ring-1 focus:ring-[#16161D]"
            >
              {SECTORS.map((s) => (
                <option value={s.id} data-quizcvr={s.quizcvr} data-aovlift={s.aovlift} data-pct={s.pct}>{s.label}</option>
              ))}
            </select>
            <p class="mt-2 rounded-md bg-[#D8F0FE] px-3 py-2 text-xs text-[#2c81b2] ring-1 ring-inset ring-[#2c81b2]/20">
              <span id="sector-note">No conjunto de quizzes da RevenueHunt, quem faz o quiz converte a cerca de 275% da loja média e faz pedidos cerca de 10% maiores. Escolhe o teu setor para um benchmark mais ajustado.</span>
            </p>
          </div>
          {controls.map((c) => (
            <div>
              <div class="flex items-center justify-between gap-3">
                <label for={c.id} class="text-sm font-medium text-slate-900">
                  {c.label}
                </label>
                <div class="flex items-center gap-1 text-sm">
                  {c.suffix === "$" && <span class="text-slate-500">$</span>}
                  <input
                    type="number"
                    id={c.id}
                    min={c.min}
                    max={c.max}
                    step={c.step}
                    value={c.value}
                    class="w-24 rounded-md border border-slate-300 px-2 py-1 text-right font-semibold text-slate-900 focus:border-[#16161D] focus:outline-none focus:ring-1 focus:ring-[#16161D]"
                  />
                  {c.suffix === "%" && <span class="text-slate-500">%</span>}
                </div>
              </div>
              <input
                type="range"
                id={`${c.id}-range`}
                min={c.min}
                max={c.max}
                step={c.step}
                value={c.value}
                class="mt-3 w-full accent-[#16161D]"
                aria-label={`${c.label} slider`}
              />
              {c.note && (
                <p class="mt-2 text-xs text-slate-500">
                  <span id={`${c.id}-note`}>{c.note}</span>
                  {c.benchmark && (
                    <>
                      {" "}
                      <button
                        type="button"
                        id={`${c.id}-reset`}
                        class="hidden font-medium text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-[#16161D]"
                      >
                        Repor para os dados da RevenueHunt
                      </button>
                    </>
                  )}
                </p>
              )}
            </div>
          ))}
          <!-- AOV uplift is not user-editable: the sector dropdown sets it. -->
          <input type="hidden" id="aovlift" value="10" />
        </form>

        <!-- Results -->
        <div class="flex flex-col gap-4 rounded-xl bg-slate-50 p-6">
          <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">Impacto estimado</p>
          <div>
            <p class="text-sm text-slate-600">Receita extra por mês</p>
            <p id="out-monthly" class="mt-1 text-4xl font-bold tracking-tight text-[#16161D]">$0</p>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div class="rounded-lg border border-slate-200 bg-white p-4">
              <p class="text-xs text-slate-600">Receita extra por ano</p>
              <p id="out-annual" class="mt-1 text-xl font-bold text-slate-900">$0</p>
            </div>
            <div class="rounded-lg border border-slate-200 bg-white p-4">
              <p class="text-xs text-slate-600">Pedidos extra por mês</p>
              <p id="out-orders" class="mt-1 text-xl font-bold text-slate-900">0</p>
            </div>
          </div>
          <dl class="mt-2 space-y-1 text-sm text-slate-600">
            <div class="flex justify-between">
              <dt>Pessoas que fazem o quiz por mês</dt>
              <dd id="out-takers" class="font-medium text-slate-900">0</dd>
            </div>
            <div class="flex justify-between">
              <dt>Pedidos do quiz por mês</dt>
              <dd id="out-quizorders" class="font-medium text-slate-900">0</dd>
            </div>
            <div class="flex justify-between">
              <dt>Receita mensal de base</dt>
              <dd id="out-baseline" class="font-medium text-slate-900">$0</dd>
            </div>
            <div class="flex justify-between">
              <dt>Com um quiz</dt>
              <dd id="out-withquiz" class="font-medium text-slate-900">$0</dd>
            </div>
          </dl>
          <a
            href={SHOPIFY_INSTALL}
            target="_blank"
            rel="external noopener nofollow"
            onclick="window.gtag&&gtag('event','shopify_app_install',{event_label:'roi_calculator'})"
            class="mt-2 inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
          >
            instalar no Shopify
          </a>
          <a
            href={WOO_PLUGIN}
            target="_blank"
            rel="external noopener nofollow"
            onclick="window.gtag&&gtag('event','woocommerce_plugin_click',{event_label:'roi_calculator'})"
            class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
          >
            instalar no WooCommerce
          </a>
        </div>
      </div>
      <p class="mt-4 text-xs text-slate-500">
        A taxa de conversão de quem faz o quiz é um benchmark que podes editar, e o aumento do AOV é aplicado automaticamente conforme o teu setor; ambos vêm de dados reais da RevenueHunt e a tua loja vai variar. Os visitantes, o valor médio do pedido e a taxa de conversão atual são os teus próprios números. Isto é uma estimativa, não uma garantia, e os resultados reais dependem da tua loja, do teu tráfego e do teu quiz.
      </p>
    </div>
  </section>

  <!-- Recommended plan + ROI -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 pb-14">
      <div class="rounded-2xl border-2 border-[#16161D] bg-slate-50 p-6 sm:p-8">
        <p class="text-center text-sm font-semibold uppercase tracking-wider text-slate-500">O teu plano recomendado e ROI</p>
        <div class="mt-5 grid gap-6 sm:grid-cols-3">
          <div class="rounded-xl border border-slate-200 bg-white p-5">
            <p class="text-xs text-slate-600">Respostas de quiz estimadas / mês</p>
            <p id="out-responses" class="mt-1 text-3xl font-bold tracking-tight text-slate-900">0</p>
          </div>
          <div class="rounded-xl border border-slate-200 bg-white p-5">
            <p class="text-xs text-slate-600">Plano recomendado</p>
            <p id="out-plan" class="mt-1 text-3xl font-bold tracking-tight text-slate-900">Free Plan</p>
            <p id="out-plancost" class="text-sm text-slate-600">Grátis</p>
          </div>
          <div class="rounded-xl border border-slate-200 bg-white p-5">
            <p class="text-xs text-slate-600">Retorno sobre o custo do plano</p>
            <p id="out-roi" class="mt-1 text-3xl font-bold tracking-tight text-emerald-600">-</p>
            <p id="out-net" class="text-sm text-slate-600"></p>
          </div>
        </div>
        <p class="mt-5 text-center text-sm text-slate-700"><span id="plan-note"></span> <a href={localizedHref("/pricing/", "pt")} class="font-medium text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-[#16161D]">Ver todos os planos</a>.</p>
        <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
          <a
            href={SHOPIFY_INSTALL}
            target="_blank"
            rel="external noopener nofollow"
            onclick="window.gtag&&gtag('event','shopify_app_install',{event_label:'roi_calculator_plan'})"
            class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
          >
            começar grátis no Shopify
          </a>
          <a
            href={WOO_PLUGIN}
            target="_blank"
            rel="external noopener nofollow"
            onclick="window.gtag&&gtag('event','woocommerce_plugin_click',{event_label:'roi_calculator_plan'})"
            class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
          >
            começar grátis no WooCommerce
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Conversion by category -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 pb-14">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
        <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Aumento da taxa de conversão por setor</h2>
        <p class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
          Comparado com uma loja típica de 2%, quem faz o quiz da RevenueHunt converte várias vezes mais. Aqui tens cada categoria como percentagem dessa média, com o aumento do valor do pedido onde o vemos.
        </p>
        <dl class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-xl bg-slate-200 sm:grid-cols-3 lg:grid-cols-6">
          {BY_VERTICAL.map((b) => (
            <div class="bg-white px-4 py-6 text-center">
              <dt class="text-3xl font-bold tracking-tight text-[#16161D]">{b.pct}</dt>
              <dd class="mt-1 text-sm text-slate-600">{b.v}</dd>
              <dd class={`mt-2 text-xs font-medium ${b.lift.startsWith("+") ? "text-emerald-700" : "text-slate-400"}`}>{b.lift}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-4 text-center text-xs text-slate-500">
          Mostrado como percentagem de uma taxa de conversão típica de loja de 2%, medida nos nossos dados. A tua loja vai variar.
        </p>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Como funciona a calculadora</h2>
      <div class="mt-8 space-y-5 text-lg text-slate-700">
        <p>
          O modelo é deliberadamente simples e honesto. Pega na percentagem dos teus visitantes que completam o quiz, converte-os à taxa de quem faz o quiz, e compara isso com o que esses mesmos visitantes teriam feito à <a href="/glossary/conversion-rate-optimization/" class="font-medium text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-[#16161D]">taxa de conversão</a> atual do teu site. A diferença é a receita extra estimada.
        </p>
        <p>
          Com base nos dados recolhidos ao longo de mais de 45 milhões de respostas de quiz reais, 5,5% dos compradores que completam um quiz da RevenueHunt (cerca de 1 em cada 18) fazem um pedido medido. Face a uma taxa de conversão típica de loja de 2%, isso são 2,75x, cerca de 275% daquilo que uma loja costuma converter. Pré-preenchemos esse valor e deixamos-te editá-lo.
        </p>
        <p>
          Também analisámos o valor do pedido. Comparando o que é comparável, dentro da mesma loja, os pedidos do quiz são cerca de 10% mais altos do que os pedidos sem quiz. O aumento é mais forte em categorias como cuidado da pele, beleza e suplementos, e quase sem alteração em algumas outras. A calculadora aplica um aumento conservador e apoiado em dados conforme o setor que escolheres, para não teres de adivinhar.
        </p>
        <p>
          A calculadora usa o teu próprio <a href="/glossary/average-order-value/" class="font-medium text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-[#16161D]">valor médio do pedido</a> e ignora os leads de email e os dados zero-party que um quiz capta, que se acumulam ao longo do tempo, por isso tende a subestimar o valor total.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900">Perguntas frequentes</h2>
      <div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
        {faqs.map((faq) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-lg font-semibold text-slate-900 [&::-webkit-details-marker]:hidden">
              <span>{faq.question}</span>
              <svg
                class="h-5 w-5 flex-shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <p class="pb-5 text-slate-700" set:html={faq.answerHtml ?? faq.answer} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Põe o aumento à prova, grátis.
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        Cria um Quiz de recomendação de produtos e mede o impacto real na tua loja. Plano gratuito, sem cartão de crédito.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SHOPIFY_INSTALL}
          target="_blank"
          rel="external noopener nofollow"
          onclick="window.gtag&&gtag('event','shopify_app_install',{event_label:'roi_calculator_bottom'})"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          começar grátis no Shopify
        </a>
        <a
          href={WOO_PLUGIN}
          target="_blank"
          rel="external noopener nofollow"
          onclick="window.gtag&&gtag('event','woocommerce_plugin_click',{event_label:'roi_calculator_bottom'})"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          começar grátis no WooCommerce
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var KEYS = ["visitors", "aov", "cvr", "engage", "quizcvr"];
      var usd = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 });
      var num = new Intl.NumberFormat("en-US", { maximumFractionDigits: 0 });
      function clamp(el, v) {
        var min = parseFloat(el.min), max = parseFloat(el.max);
        if (!isNaN(min) && v < min) v = min;
        if (!isNaN(max) && v > max) v = max;
        return v;
      }
      function val(id) {
        var el = document.getElementById(id);
        var v = parseFloat(el.value);
        return isNaN(v) ? 0 : v;
      }
      function set(id, v) {
        var t = document.getElementById(id);
        if (t) t.textContent = v;
      }
      // Quiz takers convert at a fixed multiple of a normal store. The sector
      // benchmark is that rate measured at a 2% reference store (5.5% = 2.75x,
      // 3.6% = 1.8x, ...). Express the quiz-taker rate as that same multiple
      // applied to the merchant's OWN rate, but never below the 2% reference, so
      // even a high-converting store still sees a lift instead of a flat $0. The
      // multiple is always >= 1.8, so the result always clears the current rate.
      var sectorBenchmark = 5.5;
      function quizFloor() {
        return Math.round(sectorBenchmark * Math.max(2, val("cvr")) / 2 * 10) / 10;
      }
      function setQuizCvr(v) {
        var n = document.getElementById("quizcvr"), r = document.getElementById("quizcvr-range");
        if (!n) return;
        v = Math.min(v, parseFloat(n.max));
        n.value = v;
        if (r) r.value = clamp(r, v);
      }
      // Raising the current rate lifts the quiz rate to keep the multiple; it
      // never lowers a manual edit the merchant made above the floor.
      function ensureBoost() {
        var f = quizFloor();
        if (val("quizcvr") < f) setQuizCvr(f);
      }
      // Keep the quiz-rate helper note truthful as the rate changes. At the
      // benchmark it's the pre-filled RevenueHunt figure; once the merchant edits
      // it off the benchmark it's their own value (the reset link gets them back).
      function syncNotes() {
        var qc = val("quizcvr");
        if (qc <= 0) return;
        var oneIn = Math.round(100 / qc);
        var bench = quizFloor();
        if (Math.abs(qc - bench) <= 0.05) {
          set("quizcvr-note", "Pré-preenchido com dados da RevenueHunt: cerca de 1 em cada " + oneIn + " pessoas que fazem o quiz fazem um pedido. Edita-o para corresponder à tua loja.");
        } else {
          var d = Math.round((qc / bench - 1) * 100);
          var rel = d >= 0 ? d + "% acima de" : Math.abs(d) + "% abaixo de";
          set("quizcvr-note", "O teu valor: cerca de 1 em cada " + oneIn + " pessoas que fazem o quiz fazem um pedido. Isso é " + rel + " a taxa de conversão média do quiz.");
        }
      }
      // Only show the reset link when the quiz rate is off its data value — i.e.
      // the merchant edited it, or lowered their current rate so it sits above
      // the benchmark. At the data value there is nothing to reset.
      function syncReset() {
        var btn = document.getElementById("quizcvr-reset");
        if (btn) btn.classList.toggle("hidden", Math.abs(val("quizcvr") - quizFloor()) <= 0.05);
      }
      function calc() {
        syncNotes();
        syncReset();
        var V = val("visitors"), A = val("aov"), c = val("cvr") / 100, q = val("engage") / 100, qc = val("quizcvr") / 100, lift = val("aovlift") / 100;
        var takers = V * q;
        var quizOrders = takers * qc;
        var extraOrders = Math.max(0, takers * (qc - c));
        // Quiz orders carry a within-store AOV uplift; non-quiz baseline does not.
        // Extra = quiz-taker revenue with the quiz, minus what those same takers
        // would do at the site rate. With lift = 0 this is the old (qc - c) * A.
        var quizAov = A * (1 + lift);
        var extra = Math.max(0, quizOrders * quizAov - takers * c * A);
        var baseline = V * c * A;
        set("out-monthly", usd.format(extra));
        set("out-annual", usd.format(extra * 12));
        set("out-orders", num.format(extraOrders));
        set("out-takers", num.format(takers));
        set("out-quizorders", num.format(quizOrders));
        set("out-baseline", usd.format(baseline));
        set("out-withquiz", usd.format(baseline + extra));

        // Recommended plan (by monthly quiz responses) + cost + ROI.
        // Tiers mirror /pricing/ (lib/plans.ts).
        var responses = takers;
        // Anything above the Premium tier (2,500/mo) lands on the Unlimited Plan
        // at $299/mo with no response cap, so the ROI is computed off $299.
        var PLANS = [
          { name: "Free Plan", limit: 100, cost: 0 },
          { name: "Basic Plan", limit: 500, cost: 39 },
          { name: "Pro Plan", limit: 1000, cost: 99 },
          { name: "Premium Plan", limit: 2500, cost: 199 },
          { name: "Unlimited Plan", limit: Infinity, cost: 299, unlimited: true },
        ];
        var plan = PLANS[0];
        for (var i = 0; i < PLANS.length; i++) {
          if (responses <= PLANS[i].limit) { plan = PLANS[i]; break; }
        }
        set("out-responses", num.format(responses));
        if (plan.cost === 0) {
          set("out-plan", plan.name);
          set("out-plancost", "Grátis");
          set("out-roi", extra > 0 ? "Lucro puro" : "-");
          set("out-net", extra > 0 ? "+" + usd.format(extra) + " / mês, sem custo" : "");
          set("plan-note", "Cerca de " + num.format(responses) + " respostas de quiz por mês cabem no plano gratuito (100 respostas), por isso os " + usd.format(extra) + " por mês estimados em receita extra não te custam nada.");
        } else {
          var roi = extra / plan.cost;
          var net = extra - plan.cost;
          set("out-plan", plan.name);
          set("out-plancost", "$" + plan.cost + " / mês");
          set("out-roi", extra > 0 ? (roi >= 10 ? Math.round(roi) + "x" : roi.toFixed(1) + "x") : "-");
          set("out-net", extra > 0 ? (usd.format(extra) + " de receita menos " + usd.format(plan.cost) + " do plano = " + usd.format(net) + "/mês líquido") : "");
          if (extra <= 0) {
            set("plan-note", "Põe a taxa de conversão do quiz acima da tua taxa de conversão atual do site para veres um retorno. O " + plan.name + " ($" + plan.cost + "/mês) cobre " + (plan.unlimited ? "respostas ilimitadas." : "cerca de " + num.format(responses) + " respostas por mês."));
          } else {
            var fit = plan.unlimited
              ? "Cerca de " + num.format(responses) + " respostas de quiz por mês colocam-te no " + plan.name + " a $" + plan.cost + " por mês, com respostas ilimitadas."
              : "Cerca de " + num.format(responses) + " respostas de quiz por mês cabem no " + plan.name + " a $" + plan.cost + " por mês.";
            set("plan-note", fit + " Os " + usd.format(extra) + " por mês estimados em receita extra são aproximadamente " + (roi >= 10 ? Math.round(roi) : roi.toFixed(1)) + "x o custo do plano.");
          }
        }
      }
      KEYS.forEach(function (k) {
        var n = document.getElementById(k);
        var r = document.getElementById(k + "-range");
        if (!n || !r) return;
        n.addEventListener("input", function () { r.value = clamp(n, val(k)); if (k === "cvr") ensureBoost(); calc(); });
        r.addEventListener("input", function () { n.value = r.value; if (k === "cvr") ensureBoost(); calc(); });
      });
      // Sector selector: pre-fill the quiz rate + AOV uplift from the chosen
      // sector and recompute everything. Unselected stays "All sectors" (275%).
      var sector = document.getElementById("sector");
      function applySector() {
        var o = sector.options[sector.selectedIndex];
        var qc = o.getAttribute("data-quizcvr");
        var lift = o.getAttribute("data-aovlift");
        var pct = o.getAttribute("data-pct");
        function put(id, v) {
          var n = document.getElementById(id), r = document.getElementById(id + "-range");
          if (n) n.value = v;
          if (r) r.value = clamp(r, parseFloat(v));
        }
        sectorBenchmark = parseFloat(qc) || sectorBenchmark;
        // Reset the current rate to its default first, so the quiz rate lands on
        // the sector's published benchmark (5.5%, 3.6%, ...) rather than scaling
        // off whatever the merchant had dragged the current rate to.
        var cvrEl = document.getElementById("cvr");
        if (cvrEl) put("cvr", cvrEl.defaultValue);
        setQuizCvr(quizFloor());
        put("aovlift", lift);
        var liftN = parseFloat(lift) || 0;
        var aovPart = liftN > 0 ? " e fazem pedidos cerca de " + liftN + "% maiores" : "";
        if (o.value === "all") {
          set("sector-note", "No conjunto de quizzes da RevenueHunt, quem faz o quiz converte a cerca de " + pct + "% da loja média" + aovPart + ". Escolhe o teu setor para um benchmark mais ajustado.");
        } else {
          set("sector-note", "Quem faz o quiz em " + o.text + " converte a cerca de " + pct + "% da loja média" + aovPart + ", medido em dados da RevenueHunt.");
        }
        calc();
      }
      if (sector) sector.addEventListener("change", applySector);
      // Reset link: restore the quiz-taker rate to the RevenueHunt benchmark for
      // the current sector and store rate, in case the merchant dragged it away.
      var quizReset = document.getElementById("quizcvr-reset");
      if (quizReset) quizReset.addEventListener("click", function () { setQuizCvr(quizFloor()); calc(); });
      calc();
    })();
  </script>
</Base>
