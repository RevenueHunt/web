---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb, article, faqPage } from "../../../lib/schema";
import { SITE } from "../../../lib/site";
import { localizedHref } from "../../../lib/i18n";
import {
  REPORT,
  DATASET,
  HEADLINE,
  VERTICAL_CONVERSION,
  AOV_UPLIFT,
  ATTRIBUTION,
  BASELINES,
} from "../../../lib/quiz-benchmarks";

const pageUrl = new URL(`/${REPORT.slug}/`, SITE.site_url).href;
const ogImage = `/og/${REPORT.slug}.png`;

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=state_of_product_quizzes";
// Free WordPress.org plugin (not the WooCommerce.com extension).
const WOO_PLUGIN =
  "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";

const formatN = (n: number | null) =>
  n === null ? "" : n.toLocaleString("en-US");

// Conversion expressed against a typical 2% store: 6.9% / 2% = 345%.
const boost = (rate: number) => Math.round((rate / HEADLINE.baselinePct) * 100);

// Translated methodology + FAQ (the shared data module stays English for the PDF
// and stat cards). Defined before jsonLd so faqPage(FAQ) uses the translated set.
const METHODOLOGY = [
  "Fonte: a própria plataforma da RevenueHunt, ao longo de todas as plataformas de ecommerce que suportamos. Agregado e anonimizado: nenhuma loja individual é identificável, e as nossas próprias lojas de demonstração estão excluídas em todo o lado.",
  "A conversão é uma taxa por pessoa que faz o quiz: encomendas atribuídas a uma resposta de quiz, divididas por quizzes concluídos. Não é uma taxa de todo o site. Quem faz o quiz autosseleciona-se e está mais envolvido do que o visitante médio, por isso não é uma comparação direta com a taxa de conversão global de uma loja. Dizemo-lo sempre que fazemos a comparação.",
  "A categoria é derivada do nome do quiz escrito pelo comerciante (por exemplo \"Quiz de cuidados da pele\", \"Quiz de comida para cães\"). Cerca de 78% das respostas vêm de quizzes genéricos ou sem nome e estão excluídas de cada valor por categoria.",
  "O aumento do average order value é medido dentro da loja: o valor mediano das encomendas do quiz da mesma loja face ao valor mediano das suas encomendas sem quiz. Isto é robusto face à moeda e remove o enviesamento do mix da loja que dilui o efeito numa média ingénua ao longo de toda a plataforma.",
  "Cada valor de conversão é um mínimo. A atribuição ainda está a ser associada à medida que os comerciantes sincronizam encomendas (9% das primeiras encomendas chegam mais de 30 dias depois do quiz), e as encomendas entre dispositivos ou não rastreadas nunca chegam a ser associadas. Os números reais são mais altos, não mais baixos.",
];

const FAQ = [
  {
    question: "Como é medida a conversão do quiz?",
    answer:
      "Encomendas atribuídas a uma resposta de quiz, divididas por quizzes concluídos. Ao longo da plataforma, 5,5% dos compradores que terminam um quiz (cerca de 1 em cada 18) fazem uma encomenda rastreada. É uma taxa por pessoa que faz o quiz, não uma taxa de todo o site: quem faz o quiz está mais envolvido do que o visitante médio, por isso não é diretamente comparável com a taxa de conversão global de uma loja.",
  },
  {
    question: "Porque é que a taxa de conversão do quiz é tão mais alta do que a da loja média?",
    answer:
      "Duas razões. Primeira, o próprio quiz: substitui um catálogo avassalador por uma conversa curta e uma recomendação clara, o que elimina a indecisão que faz fugir vendas. Segunda, o que acontece depois de as respostas chegarem: cada quiz captura zero-party data e etiqueta o comprador, o que alimenta fluxos de seguimento segmentados e retargeting. As campanhas segmentadas geram mais de 3 vezes a receita por destinatário dos envios genéricos (benchmark de segmentação da Klaviyo), por isso um quiz continua a converter através de email e anúncios personalizados, não apenas na página de resultados.",
    answerHtml:
      "Duas razões. Primeira, o próprio quiz: substitui um catálogo avassalador por uma conversa curta e uma recomendação clara, o que elimina a indecisão que faz fugir vendas. Segunda, o que acontece depois de as respostas chegarem: cada quiz captura zero-party data e etiqueta o comprador, o que alimenta fluxos de seguimento segmentados e retargeting. As campanhas segmentadas geram mais de 3 vezes a receita por destinatário dos envios genéricos (<a href=\"https://www.klaviyo.com/marketing-resources/segmentation-benchmark-report\" target=\"_blank\" rel=\"external noopener nofollow\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">benchmark de segmentação da Klaviyo</a>), por isso um quiz continua a converter através de email e anúncios personalizados, não apenas na página de resultados.",
  },
  {
    question: "Os compradores do quiz gastam mesmo mais por encomenda?",
    answer:
      "Em média, sim, medido de forma equivalente. Dentro da mesma loja, as encomendas que vieram através de um quiz são cerca de 11% a 15% maiores do que as que não vieram, e isso mantém-se em cerca de 7 em cada 10 lojas. Não é universal, no entanto: é mais forte em beleza e cuidados da pele (cerca de +20%), mais plano em categorias como perfumes e café.",
  },
  {
    question: "Como é que estes benchmarks se aplicam à minha loja?",
    answer:
      "Introduz o teu próprio tráfego, valor médio de encomenda e taxa de conversão atual na nossa calculadora de ROI do quiz. Ela corre estes mesmos benchmarks (a taxa de 5,5% por pessoa que faz o quiz, a conversão por categoria, o aumento de AOV) contra os teus números para estimar a receita extra que um quiz poderia somar.",
    answerHtml:
      "Introduz o teu próprio tráfego, valor médio de encomenda e taxa de conversão atual na nossa <a href=\"/pt/quiz-roi-calculator/\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">calculadora de ROI do quiz</a>. Ela corre estes mesmos benchmarks (a taxa de 5,5% por pessoa que faz o quiz, a conversão por categoria, o aumento de AOV) contra os teus números para estimar a receita extra que um quiz poderia somar.",
  },
  {
    question: "Os dados são anonimizados?",
    answer:
      "Sim. Cada valor é agregado e reunido ao longo de milhões de respostas e milhares de lojas. Nenhuma loja individual é identificável. O relatório existe para partilhar o que o conjunto de dados diz, não para expor qualquer comerciante.",
  },
  {
    question: "Posso usar estes números?",
    answer:
      "Sim. Cita-os com uma ligação para esta página. O relatório é gratuito e sem barreiras, o PDF está disponível para download e os números em destaque estão disponíveis como cartões para partilhar.",
  },
];

const pageTitle = "O estado dos quizzes de recomendação de produtos: relatório benchmark 2026";
const pageDescription = "Como os quizzes de recomendação de produtos funcionam realmente: conversão, conclusão e valor médio de encomenda, com benchmark de mais de 45M de respostas reais em mais de 20.000 lojas de e-commerce.";

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Início", url: localizedHref("/", "pt") },
    { name: "O estado dos quizzes de recomendação de produtos", url: localizedHref(`/${REPORT.slug}/`, "pt") },
  ]),
  article({
    title: pageTitle,
    description: pageDescription,
    url: pageUrl,
    image: ogImage,
    datePublished: REPORT.datePublished,
    dateModified: REPORT.dateModified,
    author: "RevenueHunt",
    tags: [
      "quiz de recomendação de produtos benchmark",
      "quiz conversion rate",
      "ecommerce personalization",
      "average order value",
    ],
  }),
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "RevenueHunt quiz de recomendação de produtos benchmarks 2026",
    description: pageDescription,
    url: pageUrl,
    creator: organization(),
    license: "https://creativecommons.org/licenses/by/4.0/",
    isAccessibleForFree: true,
    datePublished: REPORT.datePublished,
    keywords: [
      "quiz de recomendação de produtos",
      "conversion rate",
      "average order value",
      "ecommerce",
      "Shopify",
    ],
    distribution: {
      "@type": "DataDownload",
      encodingFormat: "application/pdf",
      contentUrl: new URL(REPORT.pdfPath, SITE.site_url).href,
    },
  },
  faqPage(FAQ),
];

const publishedLabel = new Date(REPORT.datePublished).toLocaleDateString("pt-PT", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

// Category/vertical labels and the two long table notes, translated. Numbers stay
// from the shared data module; only the human-readable labels/notes are localized.
const VERT_LABEL: Record<string, string> = {
  "Fragrance": "Perfumes",
  "Haircare": "Cuidados capilares",
  "Supplements & health": "Suplementos e saúde",
  "Beauty & skincare": "Beleza e cuidados da pele",
  "Coffee & tea": "Café e chá",
  "CBD": "CBD",
  "Other sectors": "Outros setores",
  "All quiz categories (pooled)": "Todas as categorias de quiz (reunidas)",
};
const GROUPED_NOTE =
  "Tudo o que está fora das categorias nomeadas, incluindo quizzes genéricos e de maior ponderação. Medido em cerca de 3,6%, à volta de 180% de uma loja típica.";
const POOLED_NOTE =
  "O número de destaque da plataforma: 5,5% (1 em cada 18), cerca de 275% de uma loja típica de 2%. Os quizzes genéricos e sem nome (~78% das respostas) estão excluídos das linhas por categoria e arrastam o número global para baixo, até aos ~4%.";
const SCOPE: Record<string, string> = {
  "Statista": "Global, 2025",
  "IRP Commerce": "Dados de comerciantes ativos no Reino Unido/Irlanda, 2025",
  "Dynamic Yield": "400+ marcas de média a grande dimensão, 2025",
  "Shopify": "Orientações publicadas pela própria Shopify",
};
const tr = <T extends { vertical: string }>(r: T) => ({ ...r, vertical: VERT_LABEL[r.vertical] ?? r.vertical });
const consumable = VERTICAL_CONVERSION.filter((r) => r.kind === "consumable").map(tr);
const considered = VERTICAL_CONVERSION.filter((r) => r.kind === "considered").map(tr);
const grouped = { ...tr(VERTICAL_CONVERSION.find((r) => r.kind === "grouped")!), note: GROUPED_NOTE };
const pooled = { ...tr(VERTICAL_CONVERSION.find((r) => r.kind === "total")!), note: POOLED_NOTE };
const aovRows = AOV_UPLIFT.perVertical.map(tr);
const baselines = BASELINES.map((b) => ({ ...b, scope: SCOPE[b.source] ?? b.scope }));
---

<Base
  title={pageTitle}
  description={pageDescription}
  ogImage={ogImage}
  jsonLd={jsonLd}
  lang="pt"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={localizedHref("/", "pt")} class="hover:text-slate-700">Início</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">O estado dos quizzes de recomendação de produtos</span>
      </nav>
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">
          Relatório benchmark · {publishedLabel}
        </p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          O estado dos quizzes de recomendação de produtos
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          1 em cada 18 compradores que terminam um quiz de recomendação de produtos faz uma encomenda, <strong>2,75 vezes mais do que uma loja online típica</strong>. Este relatório detalha quais as categorias que convertem mais, quanto mais gastam os compradores do quiz e durante quanto tempo um único quiz continua a render. Com base em dados reais de <strong>{DATASET.responses} respostas de quiz</strong> em {DATASET.brands} lojas.
        </p>
        {/* TODO: restore hero CTAs ("Download the PDF" + "Read the findings")
            once a peer reviews the PDF design. Removed 2026-06-08 to hold the
            PDF download until that review. The PDF is still generated and the
            "Cite this report" section's download link is also held (see below). */}
      </div>
    </div>
  </section>

  <!-- Dataset band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-2xl bg-[#16161D] px-6 py-10 sm:px-10">
        <p class="text-center text-sm font-semibold uppercase tracking-wider text-white/50">
          O conjunto de dados
        </p>
        <dl class="mt-6 grid grid-cols-1 gap-8 text-center sm:grid-cols-3">
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.responses}</dt>
            <dd class="mt-1 text-sm text-white/70">respostas de quiz analisadas</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.revenue}</dt>
            <dd class="mt-1 text-sm text-white/70">em receita gerada para comerciantes</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.brands}</dt>
            <dd class="mt-1 text-sm text-white/70">lojas de ecommerce</dd>
          </div>
        </dl>
        <p class="mx-auto mt-6 max-w-3xl text-center text-sm text-white/60">
          Agregado e anonimizado, ao longo de Shopify, WooCommerce, BigCommerce, Magento e autónomas. Nenhuma loja individual é identificável. Cada número abaixo é um mínimo: a atribuição ainda está a ser associada, por isso os números reais são mais altos.
        </p>
      </div>
    </div>
  </section>

  <!-- Key findings (stat cards) -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Os números em destaque</h2>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">{HEADLINE.completedConv}%</p>
          <p class="mt-2 font-medium text-slate-900">dos compradores que terminam um quiz faz uma encomenda</p>
          <p class="mt-2 text-sm text-slate-600">Cerca de 1 em cada {HEADLINE.completedOneIn}, aproximadamente {HEADLINE.multiple} vezes uma loja típica de {HEADLINE.baselinePct}%.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">+{AOV_UPLIFT.headlineLow}-{AOV_UPLIFT.headlineHigh}%</p>
          <p class="mt-2 font-medium text-slate-900">mais de average order value, dentro da mesma loja</p>
          <p class="mt-2 text-sm text-slate-600">Medido de forma equivalente, presente em cerca de 7 em cada 10 lojas.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">{HEADLINE.completionRate}%</p>
          <p class="mt-2 font-medium text-slate-900">dos compradores que começam um quiz terminam-no</p>
          <p class="mt-2 text-sm text-slate-600">Cerca de 7 em cada 10 chegam à página de resultados. {HEADLINE.abandonRate}% desistem antes.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">1 em cada 5</p>
          <p class="mt-2 font-medium text-slate-900">encomendas atribuídas ao quiz chegam mais de 30 dias depois</p>
          <p class="mt-2 text-sm text-slate-600">O quiz continua a gerar receita durante meses depois de o fazer.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Conversion by category -->
  <section id="conversion" class="scroll-mt-20 bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Conversão por categoria</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        A média da plataforma esconde uma grande dispersão. <strong>As categorias consumíveis e de reposição convertem duas a três vezes mais</strong> do que a loja online média. As compras de preço elevado e de alta ponderação convertem uma ordem de grandeza abaixo: aí o quiz impulsiona a descoberta, mas a venda chega mais tarde, fora da sessão.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">Categoria</th>
              <th class="py-3 pr-4 text-right font-semibold">Conversão</th>
              <th class="py-3 pr-4 text-right font-semibold">Aumento de conversão do quiz</th>
              <th class="py-3 text-right font-semibold">Respostas</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {consumable.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{r.rate}%</td>
                <td class="py-3 pr-4 text-right tabular-nums text-slate-600">{boost(r.rate)}%</td>
                <td class="py-3 text-right tabular-nums text-slate-500">{formatN(r.n)}</td>
              </tr>
            ))}
            {considered.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{r.rate}%</td>
                <td class="py-3 pr-4 text-right tabular-nums text-slate-600">{boost(r.rate)}%</td>
                <td class="py-3 text-right tabular-nums text-slate-500">{formatN(r.n)}</td>
              </tr>
            ))}
            <tr class="border-b border-slate-200">
              <td class="py-3 pr-4 font-medium">{grouped.vertical}</td>
              <td class="py-3 pr-4 text-right font-semibold tabular-nums">~{grouped.rate}%</td>
              <td class="py-3 pr-4 text-right tabular-nums text-slate-600">~{boost(grouped.rate)}%</td>
              <td class="py-3 text-right tabular-nums text-slate-500">{formatN(grouped.n)}</td>
            </tr>
            <tr class="border-t-2 border-slate-300">
              <td class="py-3 pr-4 font-semibold">{pooled.vertical}</td>
              <td class="py-3 pr-4 text-right font-bold tabular-nums">{pooled.rate}%</td>
              <td class="py-3 pr-4 text-right font-bold tabular-nums text-slate-600">{boost(pooled.rate)}%</td>
              <td class="py-3 text-right tabular-nums text-slate-500">todas</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        {grouped.note}
      </p>
      <p class="mx-auto mt-2 max-w-3xl text-sm text-slate-500 text-center">
        {pooled.note}
      </p>
    </div>
  </section>

  <!-- AOV uplift -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Os compradores do quiz gastam mais?</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        <strong>Medido dentro da mesma loja</strong>, as encomendas do quiz são <strong>{AOV_UPLIFT.headlineLow}% a {AOV_UPLIFT.headlineHigh}% maiores</strong> do que as encomendas sem quiz, e isso mantém-se em {AOV_UPLIFT.storesUpLow}% a {AOV_UPLIFT.storesUpHigh}% das lojas. Não é universal: mais forte onde o quiz consegue montar um conjunto ou uma rotina, quase plano onde a compra é um único artigo.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">Categoria</th>
              <th class="py-3 pr-4 text-right font-semibold">Aumento de AOV dentro da loja</th>
              <th class="py-3 text-right font-semibold">Lojas com aumento</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {aovRows.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">
                  {r.uplift === null ? "Plano" : `+${r.uplift}%`}
                </td>
                <td class="py-3 text-right tabular-nums text-slate-500">
                  {r.storesUp === null ? "n/d" : `${r.storesUp}%`}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        Medido dentro da loja (mesma loja, encomendas do quiz vs. encomendas sem quiz), por isso é robusto face à moeda e controla o mix da loja. Triangulado em três amostras independentes com uma mediana de +11%, +15% e +14%. As categorias com amostras pequenas são omitidas em vez de exageradas.
      </p>
    </div>
  </section>

  <!-- Attribution / LTV -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Um quiz continua a render depois da sessão</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        A maioria dos dashboards de atribuição avalia um quiz pelas encomendas do próprio dia e fica por aí. Isso ignora a maior parte do valor. <strong>{ATTRIBUTION.sameDay}% das primeiras encomendas atribuídas ao quiz acontecem no mesmo dia</strong>, mas a cauda é longa.
      </p>
      <div class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-4">
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.sameDay}%</p>
          <p class="mt-1 text-sm text-slate-600">no mesmo dia</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.within7}%</p>
          <p class="mt-1 text-sm text-slate-600">em 7 dias</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.within30}%</p>
          <p class="mt-1 text-sm text-slate-600">em 30 dias</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">1 em cada 5</p>
          <p class="mt-1 text-sm text-slate-600">chegam mais de 30 dias depois</p>
        </div>
      </div>
      <p class="mx-auto mt-6 max-w-3xl text-slate-700 text-center">
        Cerca de <strong>1 em cada 5 de todas as encomendas atribuídas ao quiz chega mais de 30 dias depois do quiz</strong>. O quiz não é apenas um empurrão para o checkout: cada resposta é zero-party data que etiqueta o comprador e alimenta fluxos de seguimento segmentados e retargeting. <a href="https://www.klaviyo.com/marketing-resources/segmentation-benchmark-report" target="_blank" rel="external noopener nofollow" class="font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]">As campanhas segmentadas geram mais de 3 vezes a receita por destinatário</a> do que os envios genéricos, por isso um único quiz continua a converter através de email e anúncios personalizados durante meses.
      </p>
    </div>
  </section>

  <!-- Baseline context -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">O que conta como "a loja média"</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        Não há um único número verdadeiro para a conversão em ecommerce: oscila com a metodologia e a amostra. O intervalo honesto é de cerca de 1,6% a 2,9%. Fazemos benchmark contra uns <strong>{HEADLINE.baselinePct}%</strong> redondos, o extremo baixo conservador, o que coloca quem faz o quiz em cerca de <strong>{HEADLINE.multiple} vezes</strong> a loja média.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">Fonte</th>
              <th class="py-3 pr-4 text-right font-semibold">Conversão média</th>
              <th class="py-3 font-semibold">Âmbito</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {baselines.map((b) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">
                  <a href={b.href} target="_blank" rel="external noopener nofollow" class="text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-slate-500">{b.source}</a>
                </td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{b.rate}</td>
                <td class="py-3 text-sm text-slate-600">{b.scope}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        Importante: os nossos 5,5% são uma taxa por pessoa que faz o quiz (encomendas por quiz concluído), enquanto cada número acima é uma taxa de todo o site (encomendas por visitante). Quem faz o quiz autosseleciona-se, por isso parte da diferença é o funil, não apenas o quiz. Apresentamos a comparação de forma direta em vez de a enfeitar.
      </p>
    </div>
  </section>

  <!-- Methodology -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Metodologia</h2>
      <ul class="mt-8 space-y-5" role="list">
        {METHODOLOGY.map((m) => (
          <li class="flex gap-3">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400" aria-hidden="true"></span>
            <p class="text-slate-700">{m}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Perguntas frequentes</h2>
      <div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
        {FAQ.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-lg font-semibold text-slate-900 [&::-webkit-details-marker]:hidden">
              <span>{f.question}</span>
              <svg
                class="h-5 w-5 flex-shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <p class="pb-5 text-slate-700" set:html={f.answerHtml ?? f.answer} />
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* TODO: restore the entire "Cite this report" section (PDF download +
      shareable stat-card links) once a designer reviews the report + PDF + card
      designs. Removed 2026-06-08 to hold the downloadable assets until review.
      The PDF and card PNGs are still generated by `bun run report`. */}

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Mede o aumento na tua própria loja.
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-white/70">
        O RevenueHunt é grátis para começar, com 100 respostas de quiz por mês. Cria um quiz, envia tráfego através dele e lê os teus próprios números.
      </p>
      <p class="mx-auto mt-4 max-w-2xl text-white/60">
        Vê o que estes benchmarks podem somar à tua loja com a nossa <a href={localizedHref("/quiz-roi-calculator/", "pt")} class="font-medium text-white underline decoration-white/40 underline-offset-2 hover:decoration-white">calculadora de ROI do quiz</a>.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SHOPIFY_INSTALL}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          começa grátis na Shopify
        </a>
        <a
          href={WOO_PLUGIN}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          começa grátis na WooCommerce
        </a>
      </div>
    </div>
  </section>
</Base>
