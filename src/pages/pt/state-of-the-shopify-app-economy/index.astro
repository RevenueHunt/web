  </section>

  <!-- FAQ -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Perguntas frequentes</h2>
      <div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
        {FAQ.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-lg font-semibold text-slate-900 [&::-webkit-details-marker]:hidden">
              <span>{f.question}</span>
              <svg class="h-5 w-5 flex-shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <p class="pb-5 text-slate-700" set:html={f.answerHtml ?? f.answer} />
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  import Chart from "chart.js/auto";
  import { GROWTH, REVIEWS, REVENUE, PRICING, GEOGRAPHY, COLORS, CHART_LABELS } from "../../../lib/app-economy";

  Chart.defaults.font.family =
    "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif";
  Chart.defaults.color = "#475569";
  Chart.defaults.font.size = 13;

  const el = (id: string) => document.getElementById(id) as HTMLCanvasElement | null;
  const grid = "#eef0f2";
  const kfmt = (v: number) => (v >= 1000 ? v / 1000 + "K" : "" + v);
  const L = CHART_LABELS[document.documentElement.lang] ?? CHART_LABELS.en;

  const growth = el("c-growth");
  if (growth)
    new Chart(growth, {
      type: "line",
      data: {
        labels: GROWTH.labels,
        datasets: [
          {
            data: GROWTH.cumulative,
            borderColor: COLORS.primary,
            backgroundColor: "rgba(97,110,255,0.10)",
            fill: true,
            tension: 0.35,
            borderWidth: 2.5,
            pointRadius: 3,
            pointHoverRadius: 5,
            pointBackgroundColor: COLORS.primary,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: { callbacks: { label: (c) => Number(c.parsed.y).toLocaleString() + " apps live" } },
        },
        scales: {
          y: { beginAtZero: true, grid: { color: grid }, ticks: { callback: (v) => kfmt(Number(v)) } },
          x: { grid: { display: false } },
        },
      },
    });

  const donutOpts = (suffix: string) => ({
    responsive: true,
    maintainAspectRatio: false,
    cutout: "62%",
    plugins: {
      legend: { position: "bottom" as const, labels: { boxWidth: 12, boxHeight: 12, padding: 16 } },
      tooltip: { callbacks: { label: (c: any) => `${c.label}: ${c.parsed}${suffix}` } },
    },
  });

  const reviews = el("c-reviews");
  if (reviews)
    new Chart(reviews, {
      type: "doughnut",
      data: { labels: L.reviews, datasets: [{ data: REVIEWS.values, backgroundColor: REVIEWS.colors, borderWidth: 0 }] },
      options: {
        ...donutOpts("%"),
        plugins: {
          legend: { position: "bottom" as const, labels: { boxWidth: 12, boxHeight: 12, padding: 16 } },
          tooltip: {
            callbacks: {
              title: (it: any) => L.reviewsTip.title.replace("{x}", it[0].label),
              label: (c: any) => L.reviewsTip.body.replace("{n}", REVIEWS.counts[c.dataIndex].toLocaleString()).replace("{p}", c.parsed),
            },
          },
        },
      },
    });

  const revDonut = el("c-revenue-donut");
  if (revDonut)
    new Chart(revDonut, {
      type: "doughnut",
      data: { labels: L.revenueDonut, datasets: [{ data: REVENUE.donut.values, backgroundColor: REVENUE.donut.colors, borderWidth: 0 }] },
      options: donutOpts("%"),
    });

  const revCountries = el("c-revenue-countries");
  if (revCountries)
    new Chart(revCountries, {
      type: "doughnut",
      data: { labels: L.revenueCountries, datasets: [{ data: REVENUE.countries.values, backgroundColor: REVENUE.countries.colors, borderWidth: 0 }] },
      options: {
        ...donutOpts("%"),
        plugins: {
          legend: { position: "bottom" as const, labels: { boxWidth: 12, boxHeight: 12, padding: 16 } },
          tooltip: { callbacks: { title: (it: any) => L.revenueCountriesFull[it[0].dataIndex], label: (c: any) => `${L.revenueCountriesFull[c.dataIndex]}: ${c.parsed}%` } },
        },
      },
    });

  const pricing = el("c-pricing");
  if (pricing)
    new Chart(pricing, {
      type: "doughnut",
      data: { labels: L.pricing, datasets: [{ data: PRICING.values, backgroundColor: PRICING.colors, borderWidth: 0 }] },
      options: donutOpts("%"),
    });

  const geo = el("c-geography");
  if (geo)
    new Chart(geo, {
      type: "bar",
      data: { labels: L.geography, datasets: [{ data: GEOGRAPHY.values, backgroundColor: GEOGRAPHY.labels.map((_, i) => (i < 2 ? COLORS.primary : COLORS.secondary)), borderRadius: 4 }] },
      options: {
        indexAxis: "y",
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: (c) => Number(c.parsed.x).toLocaleString() + " apps" } } },
        scales: { x: { beginAtZero: true, grid: { color: grid }, ticks: { callback: (v) => kfmt(Number(v)) } }, y: { grid: { display: false } } },
      },
    });
</script>
