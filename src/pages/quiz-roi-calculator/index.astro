---
import Base from "../../layouts/Base.astro";
import { organization, breadcrumb, softwareApplication, faqPage } from "../../lib/schema";

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=roi_calculator";

// Inputs. The quiz-taker conversion rate is pre-filled with a benchmark
// measured from real RevenueHunt data (see "benchmark" flag); everything else
// is the merchant's own number. No AOV-uplift input: our aggregate data does
// not support a positive AOV uplift, so we do not model one (fact-based only).
const controls = [
  { id: "visitors", label: "Monthly store visitors", min: 500, max: 500000, step: 500, value: 10000, suffix: "" },
  { id: "aov", label: "Your average order value", min: 10, max: 1000, step: 5, value: 60, suffix: "$" },
  { id: "cvr", label: "Your current conversion rate", min: 0.1, max: 15, step: 0.1, value: 2, suffix: "%" },
  { id: "engage", label: "Share of visitors who take the quiz", min: 1, max: 100, step: 1, value: 20, suffix: "%" },
  { id: "quizcvr", label: "Quiz taker conversion rate", min: 1, max: 25, step: 0.5, value: 5, suffix: "%", benchmark: true },
];

// Real, data-backed proof points shown on the page. The conversion figure is
// the conservative floor of a measured ~5.5% (1 in 18) response-to-order rate
// across a 48k-response sample; attribution undercounts, so the floor is safe.
const PROOF = [
  { stat: "45M+", label: "quiz responses analyzed" },
  { stat: "1 in 20+", label: "quiz takers place an order" },
  { stat: "$1.5B+", label: "merchant revenue influenced" },
  { stat: "20,000+", label: "brands" },
];

const faqs = [
  {
    question: "Where does the quiz conversion rate come from?",
    answer:
      "It is a benchmark from real RevenueHunt data. Across our quiz responses, more than 1 in 20 shoppers who complete a quiz go on to place a tracked order. The field is pre-filled with that conservative figure and you can edit it to match your own store.",
  },
  {
    question: "How is the extra revenue calculated?",
    answer:
      "The calculator takes the share of your visitors who complete the quiz, applies the quiz taker conversion rate to them, and compares that against what those same visitors would convert at your current site rate. The difference, multiplied by your average order value, is the estimated extra revenue.",
  },
  {
    question: "Is this based on real data or made-up multipliers?",
    answer:
      "Real data. The quiz conversion benchmark is measured across more than 45 million quiz responses and over $1.5 billion in influenced merchant revenue. Your visitors, average order value, and current conversion rate are your own numbers. The output is an estimate, not a guarantee.",
  },
  {
    question: "Why is there no average order value uplift field?",
    answer:
      "Because our aggregate data does not support one. Quiz-attributed orders are about the same value as non-quiz orders, so we do not pad the estimate with an AOV bump we cannot prove. The lift this calculator shows comes from conversion, not from inflating order value.",
  },
  {
    question: "Is the calculator free to use?",
    answer:
      "Yes. It is free and ungated, no email required. RevenueHunt itself also has a free plan with 100 quiz responses a month, so you can measure the real lift on your own store.",
  },
];

const jsonLd = [
  organization(),
  softwareApplication(),
  breadcrumb([
    { name: "Home", url: "/" },
    { name: "Quiz ROI calculator", url: "/quiz-roi-calculator/" },
  ]),
  faqPage(faqs),
];
---

<Base
  title="Quiz ROI calculator for ecommerce"
  description="Free quiz ROI calculator built on real data: more than 1 in 20 quiz takers place an order. Estimate the extra revenue a quiz could add to your store."
  ogImage="/og/quiz-roi-calculator.png"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-slate-700">Home</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Quiz ROI calculator</span>
      </nav>
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">Free tool</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">Quiz ROI calculator</h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          See the extra revenue a product recommendation quiz could add to your store. The conversion benchmark is real, measured across 45M+ quiz responses, not a made-up multiplier. Adjust the inputs to match your numbers.
        </p>
      </div>
    </div>
  </section>

  <!-- Real-data proof band -->
  <section class="border-y border-slate-200 bg-white">
    <div class="mx-auto max-w-5xl px-6 py-6">
      <div class="flex items-center justify-center gap-2 text-center">
        <span class="inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
        <p class="text-sm font-semibold uppercase tracking-wider text-slate-600">Based on real RevenueHunt data</p>
      </div>
      <dl class="mt-5 grid grid-cols-2 gap-px overflow-hidden rounded-xl bg-slate-200 sm:grid-cols-4">
        {PROOF.map((p) => (
          <div class="bg-white px-4 py-6 text-center">
            <dt class="text-3xl font-bold tracking-tight text-[#16161D]">{p.stat}</dt>
            <dd class="mt-1 text-sm text-slate-600">{p.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Calculator -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 pb-8 pt-10">
      <div class="grid gap-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm lg:grid-cols-2 lg:p-8">
        <!-- Inputs -->
        <form id="roi-form" class="space-y-6" aria-label="Quiz ROI inputs">
          {controls.map((c) => (
            <div>
              <div class="flex items-center justify-between gap-3">
                <label for={c.id} class="text-sm font-medium text-slate-900">
                  {c.label}
                  {c.benchmark && (
                    <span class="ml-2 inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-emerald-700 ring-1 ring-inset ring-emerald-600/20">
                      RevenueHunt data
                    </span>
                  )}
                </label>
                <div class="flex items-center gap-1 text-sm">
                  {c.suffix === "$" && <span class="text-slate-500">$</span>}
                  <input
                    type="number"
                    id={c.id}
                    min={c.min}
                    max={c.max}
                    step={c.step}
                    value={c.value}
                    class="w-24 rounded-md border border-slate-300 px-2 py-1 text-right font-semibold text-slate-900 focus:border-[#16161D] focus:outline-none focus:ring-1 focus:ring-[#16161D]"
                  />
                  {c.suffix === "%" && <span class="text-slate-500">%</span>}
                </div>
              </div>
              <input
                type="range"
                id={`${c.id}-range`}
                min={c.min}
                max={c.max}
                step={c.step}
                value={c.value}
                class="mt-3 w-full accent-[#16161D]"
                aria-label={`${c.label} slider`}
              />
              {c.benchmark && (
                <p class="mt-2 text-xs text-slate-500">
                  Pre-filled with our measured benchmark: more than 1 in 20 quiz takers place an order. Edit it to match your store.
                </p>
              )}
            </div>
          ))}
        </form>

        <!-- Results -->
        <div class="flex flex-col gap-4 rounded-xl bg-slate-50 p-6">
          <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">Estimated impact</p>
          <div>
            <p class="text-sm text-slate-600">Extra revenue per month</p>
            <p id="out-monthly" class="mt-1 text-4xl font-bold tracking-tight text-[#16161D]">$0</p>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div class="rounded-lg border border-slate-200 bg-white p-4">
              <p class="text-xs text-slate-600">Extra revenue per year</p>
              <p id="out-annual" class="mt-1 text-xl font-bold text-slate-900">$0</p>
            </div>
            <div class="rounded-lg border border-slate-200 bg-white p-4">
              <p class="text-xs text-slate-600">Extra orders per month</p>
              <p id="out-orders" class="mt-1 text-xl font-bold text-slate-900">0</p>
            </div>
          </div>
          <dl class="mt-2 space-y-1 text-sm text-slate-600">
            <div class="flex justify-between">
              <dt>Quiz takers per month</dt>
              <dd id="out-takers" class="font-medium text-slate-900">0</dd>
            </div>
            <div class="flex justify-between">
              <dt>Orders from the quiz per month</dt>
              <dd id="out-quizorders" class="font-medium text-slate-900">0</dd>
            </div>
            <div class="flex justify-between">
              <dt>Baseline monthly revenue</dt>
              <dd id="out-baseline" class="font-medium text-slate-900">$0</dd>
            </div>
            <div class="flex justify-between">
              <dt>With a quiz</dt>
              <dd id="out-withquiz" class="font-medium text-slate-900">$0</dd>
            </div>
          </dl>
          <a
            href={SHOPIFY_INSTALL}
            target="_blank"
            rel="external noopener nofollow"
            onclick="window.gtag&&gtag('event','shopify_app_install',{screen_name:'roi_calculator'})"
            class="mt-2 inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
          >
            start free on Shopify
          </a>
        </div>
      </div>
      <p class="mt-4 text-xs text-slate-500">
        The quiz taker conversion rate is a benchmark measured from real RevenueHunt data across 45M+ quiz responses; your store will vary, so edit it to match. Visitors, average order value, and current conversion rate are your own numbers. This is an estimate, not a guarantee, and actual results depend on your store, traffic, and quiz.
      </p>
    </div>
  </section>

  <!-- How it works -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">How the calculator works</h2>
      <div class="mt-8 space-y-5 text-lg text-slate-700">
        <p>
          The model is deliberately simple and honest. It takes the share of your visitors who complete the quiz, converts them at the quiz taker rate, and compares that against what the same visitors would have done at your current site <a href="/glossary/conversion-rate-optimization/" class="font-medium text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-[#16161D]">conversion rate</a>. The gap is the estimated extra revenue.
        </p>
        <p>
          The one number we did not invent is the quiz taker conversion rate. Across more than 45 million real quiz responses, more than 1 in 20 shoppers who complete a RevenueHunt quiz place a tracked order, which is why quiz traffic typically converts well above a category page. We pre-fill that figure and let you edit it.
        </p>
        <p>
          We deliberately leave <a href="/glossary/average-order-value/" class="font-medium text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-[#16161D]">average order value</a> as your own input and do not add an AOV uplift, because our data does not show quiz orders being larger than non-quiz orders. The calculator also ignores the email leads and zero-party data a quiz captures, which compound over time, so it tends to understate the full value.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900">Frequently asked questions</h2>
      <div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
        {faqs.map((faq) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-lg font-semibold text-slate-900 [&::-webkit-details-marker]:hidden">
              <span>{faq.question}</span>
              <svg
                class="h-5 w-5 flex-shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <p class="pb-5 text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Put the lift to the test, free.
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        Build a product recommendation quiz and measure the real impact on your store. Free plan, no credit card.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a
          href={SHOPIFY_INSTALL}
          target="_blank"
          rel="external noopener nofollow"
          onclick="window.gtag&&gtag('event','shopify_app_install',{screen_name:'roi_calculator_bottom'})"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          start free on Shopify
        </a>
        <a
          href="/pricing/"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          see pricing
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var KEYS = ["visitors", "aov", "cvr", "engage", "quizcvr"];
      var usd = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 });
      var num = new Intl.NumberFormat("en-US", { maximumFractionDigits: 0 });
      function clamp(el, v) {
        var min = parseFloat(el.min), max = parseFloat(el.max);
        if (!isNaN(min) && v < min) v = min;
        if (!isNaN(max) && v > max) v = max;
        return v;
      }
      function val(id) {
        var el = document.getElementById(id);
        var v = parseFloat(el.value);
        return isNaN(v) ? 0 : v;
      }
      function set(id, v) {
        var t = document.getElementById(id);
        if (t) t.textContent = v;
      }
      function calc() {
        var V = val("visitors"), A = val("aov"), c = val("cvr") / 100, q = val("engage") / 100, qc = val("quizcvr") / 100;
        var takers = V * q;
        var quizOrders = takers * qc;
        var extraOrders = Math.max(0, takers * (qc - c));
        var extra = extraOrders * A;
        var baseline = V * c * A;
        set("out-monthly", usd.format(extra));
        set("out-annual", usd.format(extra * 12));
        set("out-orders", num.format(extraOrders));
        set("out-takers", num.format(takers));
        set("out-quizorders", num.format(quizOrders));
        set("out-baseline", usd.format(baseline));
        set("out-withquiz", usd.format(baseline + extra));
      }
      KEYS.forEach(function (k) {
        var n = document.getElementById(k);
        var r = document.getElementById(k + "-range");
        if (!n || !r) return;
        n.addEventListener("input", function () { r.value = clamp(n, val(k)); calc(); });
        r.addEventListener("input", function () { n.value = r.value; calc(); });
      });
      calc();
    })();
  </script>
</Base>
