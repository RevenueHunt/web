---
import Base from "../../layouts/Base.astro";
import { SITE } from "../../lib/site";
import { breadcrumb, organization } from "../../lib/schema";

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Home", url: "/" },
    { name: "Search", url: "/search/" },
  ]),
];
---

<Base
  title={`Search — ${SITE.name}`}
  description="Search the RevenueHunt blog and resource library."
  jsonLd={jsonLd}
  noindex
>
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />

  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-14 sm:py-16">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-slate-700">Home</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Search</span>
      </nav>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">Search</h1>
      <p class="mt-4 max-w-2xl text-lg text-slate-600">Find articles, case studies, and product updates from the RevenueHunt blog.</p>
    </div>
  </section>

  <main class="mx-auto max-w-3xl px-6 py-12">
    <div id="search" class="rh-search"></div>
    <noscript>
      <p class="rounded-md border border-slate-200 bg-white p-4 text-sm text-slate-600">
        Search needs JavaScript. Browse posts on the <a href="/blog/" class="text-[#16161D] underline">blog index</a> instead.
      </p>
    </noscript>
  </main>

  <style is:global>
    .rh-search {
      --pagefind-ui-primary: #16161D;
      --pagefind-ui-text: #0f172a;
      --pagefind-ui-background: #ffffff;
      --pagefind-ui-border: #e2e8f0;
      --pagefind-ui-tag: #f1f5f9;
      --pagefind-ui-border-width: 1px;
      --pagefind-ui-border-radius: 8px;
      --pagefind-ui-font: inherit;
    }
  </style>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", async () => {
      try {
        const mod = await import("/pagefind/pagefind-ui.js");
        new mod.PagefindUI({
          element: "#search",
          showSubResults: true,
          showImages: true,
          resetStyles: false,
          showEmptyFilters: false,
        });
      } catch (err) {
        const el = document.getElementById("search");
        if (el) {
          el.innerHTML = '<p class="rounded-md border border-slate-200 bg-white p-4 text-sm text-slate-600">Search is unavailable in dev mode — run <code>bun run build &amp;&amp; bun run preview</code> to enable it.</p>';
        }
      }
    });
  </script>
</Base>
