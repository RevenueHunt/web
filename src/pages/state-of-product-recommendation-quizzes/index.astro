---
import Base from "../../layouts/Base.astro";
import { organization, breadcrumb, article, faqPage } from "../../lib/schema";
import { SITE } from "../../lib/site";
import {
  REPORT,
  DATASET,
  HEADLINE,
  VERTICAL_CONVERSION,
  AOV_UPLIFT,
  ATTRIBUTION,
  BASELINES,
  METHODOLOGY,
  FAQ,
} from "../../lib/quiz-benchmarks";

const pageUrl = new URL(`/${REPORT.slug}/`, SITE.site_url).href;
const ogImage = `/og/${REPORT.slug}.png`;

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=state_of_product_quizzes";
// Free WordPress.org plugin (not the WooCommerce.com extension).
const WOO_PLUGIN =
  "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";

const formatN = (n: number | null) =>
  n === null ? "" : n.toLocaleString("en-US");

// Conversion expressed against a typical 2% store: 6.9% / 2% = 345%.
const boost = (rate: number) => Math.round((rate / HEADLINE.baselinePct) * 100);

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Home", url: "/" },
    { name: "State of product recommendation quizzes", url: `/${REPORT.slug}/` },
  ]),
  article({
    title: `${REPORT.title}: ${REPORT.subtitle}`,
    description: REPORT.description,
    url: pageUrl,
    image: ogImage,
    datePublished: REPORT.datePublished,
    dateModified: REPORT.dateModified,
    author: "RevenueHunt",
    tags: [
      "product recommendation quiz benchmark",
      "quiz conversion rate",
      "ecommerce personalization",
      "average order value",
    ],
  }),
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "RevenueHunt product recommendation quiz benchmarks 2026",
    description: REPORT.description,
    url: pageUrl,
    creator: organization(),
    license: "https://creativecommons.org/licenses/by/4.0/",
    isAccessibleForFree: true,
    datePublished: REPORT.datePublished,
    keywords: [
      "product recommendation quiz",
      "conversion rate",
      "average order value",
      "ecommerce",
      "Shopify",
    ],
    distribution: {
      "@type": "DataDownload",
      encodingFormat: "application/pdf",
      contentUrl: new URL(REPORT.pdfPath, SITE.site_url).href,
    },
  },
  faqPage(FAQ),
];

const publishedLabel = new Date(REPORT.datePublished).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const consumable = VERTICAL_CONVERSION.filter((r) => r.kind === "consumable");
const considered = VERTICAL_CONVERSION.filter((r) => r.kind === "considered");
const grouped = VERTICAL_CONVERSION.find((r) => r.kind === "grouped")!;
const pooled = VERTICAL_CONVERSION.find((r) => r.kind === "total")!;
---

<Base translated={true}
  title={`${REPORT.title}: ${REPORT.subtitle}`}
  description={REPORT.description}
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-slate-700">Home</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">State of product recommendation quizzes</span>
      </nav>
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">
          Benchmark report · {publishedLabel}
        </p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          The state of product recommendation quizzes
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          1 in 18 shoppers who finish a product recommendation quiz place an order, <strong>2.75x a typical online store</strong>. This report breaks down which categories convert highest, how much more quiz shoppers spend, and how long a single quiz keeps paying. Based on real data from <strong>{DATASET.responses} quiz responses</strong> across {DATASET.brands} stores.
        </p>
        {/* TODO: restore hero CTAs ("Download the PDF" + "Read the findings")
            once a peer reviews the PDF design. Removed 2026-06-08 to hold the
            PDF download until that review. The PDF is still generated and the
            "Cite this report" section's download link is also held (see below). */}
      </div>
    </div>
  </section>

  <!-- Dataset band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-2xl bg-[#16161D] px-6 py-10 sm:px-10">
        <p class="text-center text-sm font-semibold uppercase tracking-wider text-white/50">
          The dataset
        </p>
        <dl class="mt-6 grid grid-cols-1 gap-8 text-center sm:grid-cols-3">
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.responses}</dt>
            <dd class="mt-1 text-sm text-white/70">{DATASET.responsesNote}</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.revenue}</dt>
            <dd class="mt-1 text-sm text-white/70">{DATASET.revenueNote}</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.brands}</dt>
            <dd class="mt-1 text-sm text-white/70">{DATASET.brandsNote}</dd>
          </div>
        </dl>
        <p class="mx-auto mt-6 max-w-3xl text-center text-sm text-white/60">
          Aggregate and anonymized, across {DATASET.platforms}. No individual store is identifiable. Every figure below is a floor: attribution is still attaching, so the real numbers are higher.
        </p>
      </div>
    </div>
  </section>

  <!-- Key findings (stat cards) -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">The headline numbers</h2>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">{HEADLINE.completedConv}%</p>
          <p class="mt-2 font-medium text-slate-900">of shoppers who finish a quiz place an order</p>
          <p class="mt-2 text-sm text-slate-600">About 1 in {HEADLINE.completedOneIn}, roughly {HEADLINE.multiple}x a typical {HEADLINE.baselinePct}% store.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">+{AOV_UPLIFT.headlineLow}-{AOV_UPLIFT.headlineHigh}%</p>
          <p class="mt-2 font-medium text-slate-900">higher average order value, within the same store</p>
          <p class="mt-2 text-sm text-slate-600">Measured like for like, present in roughly 7 in 10 stores.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">{HEADLINE.completionRate}%</p>
          <p class="mt-2 font-medium text-slate-900">of shoppers who start a quiz finish it</p>
          <p class="mt-2 text-sm text-slate-600">About 7 in 10 reach the results page. {HEADLINE.abandonRate}% drop off before.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">1 in 5</p>
          <p class="mt-2 font-medium text-slate-900">quiz-attributed orders land 30+ days later</p>
          <p class="mt-2 text-sm text-slate-600">The quiz keeps driving revenue for months after taking it.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Conversion by category -->
  <section id="conversion" class="scroll-mt-20 bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Conversion by category</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        The platform average hides a wide spread. <strong>Consumable and replenishable categories convert two to three times higher</strong> than the average online store. High-ticket and high-consideration purchases convert an order of magnitude lower: the quiz drives discovery there, but the sale lands later, off-session.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">Category</th>
              <th class="py-3 pr-4 text-right font-semibold">Conversion</th>
              <th class="py-3 pr-4 text-right font-semibold">Quiz conversion boost</th>
              <th class="py-3 text-right font-semibold">Responses</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {consumable.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{r.rate}%</td>
                <td class="py-3 pr-4 text-right tabular-nums text-slate-600">{boost(r.rate)}%</td>
                <td class="py-3 text-right tabular-nums text-slate-500">{formatN(r.n)}</td>
              </tr>
            ))}
            {considered.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{r.rate}%</td>
                <td class="py-3 pr-4 text-right tabular-nums text-slate-600">{boost(r.rate)}%</td>
                <td class="py-3 text-right tabular-nums text-slate-500">{formatN(r.n)}</td>
              </tr>
            ))}
            <tr class="border-b border-slate-200">
              <td class="py-3 pr-4 font-medium">{grouped.vertical}</td>
              <td class="py-3 pr-4 text-right font-semibold tabular-nums">~{grouped.rate}%</td>
              <td class="py-3 pr-4 text-right tabular-nums text-slate-600">~{boost(grouped.rate)}%</td>
              <td class="py-3 text-right tabular-nums text-slate-500">{formatN(grouped.n)}</td>
            </tr>
            <tr class="border-t-2 border-slate-300">
              <td class="py-3 pr-4 font-semibold">{pooled.vertical}</td>
              <td class="py-3 pr-4 text-right font-bold tabular-nums">{pooled.rate}%</td>
              <td class="py-3 pr-4 text-right font-bold tabular-nums text-slate-600">{boost(pooled.rate)}%</td>
              <td class="py-3 text-right tabular-nums text-slate-500">all</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        {grouped.note}
      </p>
      <p class="mx-auto mt-2 max-w-3xl text-sm text-slate-500 text-center">
        {pooled.note}
      </p>
    </div>
  </section>

  <!-- AOV uplift -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Do quiz shoppers spend more?</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        <strong>Measured within the same store</strong>, quiz orders run <strong>{AOV_UPLIFT.headlineLow}% to {AOV_UPLIFT.headlineHigh}% larger</strong> than non-quiz orders, and that holds in {AOV_UPLIFT.storesUpLow}% to {AOV_UPLIFT.storesUpHigh}% of stores. It is not universal: strongest where the quiz can build a set or routine, close to flat where the purchase is a single item.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">Category</th>
              <th class="py-3 pr-4 text-right font-semibold">Within-store AOV uplift</th>
              <th class="py-3 text-right font-semibold">Stores with a lift</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {AOV_UPLIFT.perVertical.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">
                  {r.uplift === null ? "Flat" : `+${r.uplift}%`}
                </td>
                <td class="py-3 text-right tabular-nums text-slate-500">
                  {r.storesUp === null ? "n/a" : `${r.storesUp}%`}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        Measured within-store (same store, quiz orders vs non-quiz orders), so it is currency-robust and controls for store-mix. Triangulated across three independent samples at +11%, +15% and +14% median. Small-sample categories are omitted rather than overstated.
      </p>
    </div>
  </section>

  <!-- Attribution / LTV -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">A quiz keeps paying after the session</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        Most attribution dashboards judge a quiz on same-day orders and stop there. That misses most of the value. <strong>{ATTRIBUTION.sameDay}% of first quiz-attributed orders happen the same day</strong>, but the tail is long.
      </p>
      <div class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-4">
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.sameDay}%</p>
          <p class="mt-1 text-sm text-slate-600">same day</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.within7}%</p>
          <p class="mt-1 text-sm text-slate-600">within 7 days</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.within30}%</p>
          <p class="mt-1 text-sm text-slate-600">within 30 days</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">1 in 5</p>
          <p class="mt-1 text-sm text-slate-600">land 30+ days later</p>
        </div>
      </div>
      <p class="mx-auto mt-6 max-w-3xl text-slate-700 text-center">
        About <strong>1 in 5 of all quiz-attributed orders land more than 30 days after the quiz</strong>. The quiz is not just a checkout nudge: every answer is zero-party data that tags the shopper and feeds segmented follow-up flows and retargeting. <a href="https://www.klaviyo.com/marketing-resources/segmentation-benchmark-report" target="_blank" rel="external noopener nofollow" class="font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]">Segmented campaigns earn more than 3x the revenue per recipient</a> of generic sends, so a single quiz keeps converting through personalized email and ads for months.
      </p>
    </div>
  </section>

  <!-- Baseline context -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">What counts as "the average store"</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        There is no single true number for ecommerce conversion: it swings with methodology and sample. The honest range is roughly 1.6% to 2.9%. We benchmark against a round <strong>{HEADLINE.baselinePct}%</strong>, the conservative low end, which puts quiz takers at about <strong>{HEADLINE.multiple}x</strong> the average store.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">Source</th>
              <th class="py-3 pr-4 text-right font-semibold">Average conversion</th>
              <th class="py-3 font-semibold">Scope</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {BASELINES.map((b) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">
                  <a href={b.href} target="_blank" rel="external noopener nofollow" class="text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-slate-500">{b.source}</a>
                </td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{b.rate}</td>
                <td class="py-3 text-sm text-slate-600">{b.scope}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        Important: our 5.5% is a quiz-taker rate (orders per completed quiz), while every figure above is a site-wide rate (orders per visitor). Quiz takers are self-selected, so part of the gap is the funnel, not just the quiz. We report the comparison plainly rather than dressing it up.
      </p>
    </div>
  </section>

  <!-- Methodology -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Methodology</h2>
      <ul class="mt-8 space-y-5" role="list">
        {METHODOLOGY.map((m) => (
          <li class="flex gap-3">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400" aria-hidden="true"></span>
            <p class="text-slate-700">{m}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Frequently asked questions</h2>
      <div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
        {FAQ.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-lg font-semibold text-slate-900 [&::-webkit-details-marker]:hidden">
              <span>{f.question}</span>
              <svg
                class="h-5 w-5 flex-shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <p class="pb-5 text-slate-700" set:html={f.answerHtml ?? f.answer} />
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* TODO: restore the entire "Cite this report" section (PDF download +
      shareable stat-card links) once a designer reviews the report + PDF + card
      designs. Removed 2026-06-08 to hold the downloadable assets until review.
      The PDF and card PNGs are still generated by `bun run report`. */}

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Measure the lift on your own store.
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-white/70">
        RevenueHunt is free to start, with 100 quiz responses a month. Build a quiz, send traffic through it, and read your own numbers.
      </p>
      <p class="mx-auto mt-4 max-w-2xl text-white/60">
        See what these benchmarks could add to your store with our <a href="/quiz-roi-calculator/" class="font-medium text-white underline decoration-white/40 underline-offset-2 hover:decoration-white">quiz ROI calculator</a>.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SHOPIFY_INSTALL}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          start free on Shopify
        </a>
        <a
          href={WOO_PLUGIN}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          start free on WooCommerce
        </a>
      </div>
    </div>
  </section>
</Base>
