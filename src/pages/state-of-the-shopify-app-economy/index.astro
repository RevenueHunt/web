---
import Base from "../../layouts/Base.astro";
import { organization, breadcrumb, article, faqPage } from "../../lib/schema";
import { SITE } from "../../lib/site";
import {
  REPORT,
  SOURCE,
  HEADLINE,
  GROWTH,
  REVIEWS,
  REVENUE,
  PRICING,
  GEOGRAPHY,
  QUIZ_LANE,
  METHODOLOGY,
  FAQ,
} from "../../lib/app-economy";

const pageUrl = new URL(`/${REPORT.slug}/`, SITE.site_url).href;
const ogImage = `/og/${REPORT.slug}.png`;

const publishedLabel = new Date(REPORT.datePublished).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Home", url: "/" },
    { name: "State of the Shopify app economy", url: `/${REPORT.slug}/` },
  ]),
  article({
    title: REPORT.title,
    description: REPORT.description,
    url: pageUrl,
    image: ogImage,
    datePublished: REPORT.datePublished,
    dateModified: REPORT.dateModified,
    author: "RevenueHunt",
    tags: [
      "Shopify app store",
      "Shopify app developers",
      "app store statistics",
      "app economy",
    ],
  }),
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "The state of the Shopify app economy 2026",
    description: REPORT.description,
    url: pageUrl,
    creator: organization(),
    license: "https://creativecommons.org/licenses/by/4.0/",
    isAccessibleForFree: true,
    datePublished: REPORT.datePublished,
    keywords: [
      "Shopify app store",
      "app developers",
      "app revenue",
      "app reviews",
      "ecommerce",
    ],
  },
  faqPage(FAQ),
];

// Section eyebrows for the editorial "field notes" feel.
const E = (n: string, label: string) => `${n} · ${label}`;

const growthCaptionHtml = GROWTH.caption.replace(
  "The Shopify App Store has roughly 10x'd since 2020",
  "<strong>The Shopify App Store has roughly 10x'd since 2020</strong>",
);

// Bold the lead phrase of each methodology note.
const METHOD_BOLD = [
  "Source: ",
  "Revenue is estimated, not measured.",
  "Growth uses each listing's published launch date. ",
  "Reviews are a proxy for traction",
];
const methodologyHtml = METHODOLOGY.map((m) =>
  METHOD_BOLD.reduce((acc, lead) => acc.replace(lead, `<strong>${lead}</strong>`), m),
);

// Quiz-lane paragraphs. Link "Shopify's quiz search" to the live search (so the
// 149 figure is verifiable) and bold the load-bearing line. Caption text stays
// the single source of truth.
const quizParas = QUIZ_LANE.caption.map((p) =>
  p
    .replace(
      "Shopify's quiz search",
      `<a href="${QUIZ_LANE.searchUrl}" target="_blank" rel="external noopener nofollow" class="font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]">Shopify's quiz search</a>`,
    )
    .replace(
      "Reviews are the residue of the operational scar tissue",
      "<strong>Reviews are the residue of the operational scar tissue</strong>",
    )
    .replace(
      "we respect them for it",
      "<strong>we respect them for it</strong>",
    )
    .replace(
      "RevenueHunt alone holds about a quarter",
      "<strong>RevenueHunt alone holds about a quarter</strong>",
    ),
);
---

<Base
  title={`${REPORT.title} — 2026 data report`}
  description={REPORT.description}
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-slate-700">Home</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">State of the Shopify app economy</span>
      </nav>
      <div class="text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">
          {REPORT.eyebrow} · {publishedLabel}
        </p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          The state of the Shopify app economy
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          <strong>22,546 apps are live on the Shopify App Store, and almost none of them get anywhere.</strong> We took a snapshot of every live app, then read the data on growth, reviews, revenue, pricing and who builds them. It tells one story: building the app was never the hard part.
        </p>
      </div>
    </div>
  </section>

  <!-- Source band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-2xl bg-[#16161D] px-6 py-10 sm:px-10">
        <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-white/50">
          The snapshot
        </p>
        <dl class="mt-6 grid grid-cols-2 gap-8 text-center sm:grid-cols-4">
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.apps}</dt>
            <dd class="mt-1 text-sm text-white/70">{SOURCE.appsNote}</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.countries}</dt>
            <dd class="mt-1 text-sm text-white/70">{SOURCE.countriesNote}</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.reviewless}</dt>
            <dd class="mt-1 text-sm text-white/70">{SOURCE.reviewlessNote}</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.free}</dt>
            <dd class="mt-1 text-sm text-white/70">{SOURCE.freeNote}</dd>
          </div>
        </dl>
        <p class="mx-auto mt-6 max-w-3xl text-center text-sm text-white/60">
          Every figure below comes from the public App Store listing of all 22,546 live apps, June 2026. Revenue is estimated from published pricing and usage signals, not billing data, and is labelled as such throughout.
        </p>
      </div>
    </div>
  </section>

  <!-- Headline cards -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">The headline numbers</h2>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        {HEADLINE.map((c) => (
          <div class="rounded-xl border border-slate-200 p-7">
            <p class="text-4xl font-bold tracking-tight text-[#16161D]">{c.stat}</p>
            <p class="mt-2 font-medium text-slate-900">{c.label}</p>
            <p class="mt-2 text-sm text-slate-600">{c.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 01 Growth -->
  <section class="scroll-mt-20 bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("01", "Growth")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Up 10x since 2020</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center" set:html={growthCaptionHtml} />
      <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
        <div class="h-72 sm:h-80"><canvas id="c-growth" aria-label="Cumulative live Shopify apps by year" role="img"></canvas></div>
      </div>
    </div>
  </section>

  <!-- 02 Traction -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("02", "Traction")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Most apps never earn a review</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">{REVIEWS.caption}</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <div class="h-72 sm:h-80"><canvas id="c-reviews" aria-label="Review distribution across all live apps" role="img"></canvas></div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">74%</p>
            <p class="mt-1 text-slate-700">have fewer than five reviews</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">{REVIEWS.avgRating}</p>
            <p class="mt-1 text-slate-700">average rating, across the {REVIEWS.ratedCount} apps that have one</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 Revenue -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("03", "Revenue · estimated")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">The money pools at the very top</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">{REVENUE.caption}</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <div class="h-64 sm:h-72"><canvas id="c-revenue-donut" aria-label="Share of estimated revenue earned by the top 1% of apps" role="img"></canvas></div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-sm font-medium text-slate-500">Cumulative share of estimated revenue</p>
          <div class="h-64 sm:h-72"><canvas id="c-revenue-bars" aria-label="Cumulative share of estimated revenue by top apps" role="img"></canvas></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 Pricing -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("04", "Pricing")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Almost nobody charges up front</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">{PRICING.caption}</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <div class="h-72 sm:h-80"><canvas id="c-pricing" aria-label="Pricing model split across all live apps" role="img"></canvas></div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">{PRICING.permanentFree}</p>
            <p class="mt-1 text-slate-700">offer a permanent free tier, not just a trial</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">1 in 20</p>
            <p class="mt-1 text-slate-700">apps charge money before the first install</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 Who builds them -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("05", "Who builds them")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Built in 115 countries, dominated by two</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">{GEOGRAPHY.caption}</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <div class="h-72 sm:h-80"><canvas id="c-geography" aria-label="Top developer countries by app count" role="img"></canvas></div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">{GEOGRAPHY.builtForShopify}</p>
            <p class="mt-1 text-slate-700">carry the Built for Shopify badge ({GEOGRAPHY.builtForShopifyCount} apps), years after Shopify began pushing the standard</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">25%</p>
            <p class="mt-1 text-slate-700">of the entire store is built in just the US and India</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 The quiz lane -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("06", "The quiz lane")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Our own category, up close</h2>
      {quizParas.map((html) => (
        <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center" set:html={html} />
      ))}
      <div class="mx-auto mt-8 grid max-w-3xl grid-cols-3 gap-4 text-center">
        <a
          href="https://apps.shopify.com/product-recommendation-quiz-revenuehunt"
          target="_blank"
          rel="external noopener"
          class="block rounded-xl border border-[#4dcaff]/60 p-6 shadow-[0_0_28px_-4px_rgba(77,202,255,0.55)] transition hover:border-[#4dcaff] hover:shadow-[0_0_32px_-2px_rgba(77,202,255,0.7)]"
        >
          <p class="text-sm font-semibold text-slate-900">RevenueHunt</p>
          <p class="mt-1 font-bold text-[#16161D]"><span class="text-3xl">{QUIZ_LANE.revenueHuntReviews}</span> <span class="text-sm font-medium text-slate-500">reviews</span></p>
          <p class="mt-1 text-xs font-semibold text-slate-600"><span class="text-amber-400">★</span> 4.9 stars</p>
        </a>
        <div class="rounded-xl border border-slate-200 p-6">
          <p class="text-sm font-medium text-slate-700">Octane AI</p>
          <p class="mt-1 font-bold text-slate-500"><span class="text-3xl">{QUIZ_LANE.octaneReviews}</span> <span class="text-sm font-medium text-slate-500">reviews</span></p>
          <p class="mt-1 text-xs font-semibold text-slate-600"><span class="text-amber-400">★</span> 4.8 stars</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-6">
          <p class="text-sm font-medium text-slate-700">Quiz Kit</p>
          <p class="mt-1 font-bold text-slate-500"><span class="text-3xl">{QUIZ_LANE.quizKitReviews}</span> <span class="text-sm font-medium text-slate-500">reviews</span></p>
          <p class="mt-1 text-xs font-semibold text-slate-600"><span class="text-amber-400">★</span> 4.8 stars</p>
        </div>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-center text-sm text-slate-500">Reviews on the Shopify App Store, June 2026. Octane AI and Quiz Kit are the real competitors RevenueHunt has in this category; respect to both.</p>
    </div>
  </section>

  <!-- Takeaway -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#4dcaff]">The takeaway</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Building the app was never the hard part.
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-white/75">
        AI didn't change that. It just made it impossible to hide. When code becomes a commodity, the flood of new apps is not the competition. The competition is the handful who showed up early and never stopped grinding: answering support, earning reviews one merchant at a time, building trust.
      </p>
      <p class="mx-auto mt-5 max-w-2xl text-lg font-semibold text-white">
        Distribution and trust is the only AI-proof move left.
      </p>
      <p class="mx-auto mt-10 max-w-2xl text-lg text-white/85">
        Building a Shopify app that's actually working? I want to meet the founders doing the hard part. Let's talk.
      </p>
      <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="/contact/"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          Get in touch
        </a>
        <a
          href="https://www.linkedin.com/in/revenuehunt/"
          target="_blank"
          rel="external noopener"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          Connect on LinkedIn
        </a>
      </div>
      <p class="mx-auto mt-10 max-w-2xl text-white/60">
        This is the full data behind <a href="https://www.linkedin.com/company/revenuehunt/" target="_blank" rel="external noopener" class="font-medium text-white underline decoration-white/40 underline-offset-2 hover:decoration-white">our field note on the app economy</a>. We ran the same teardown on our own category in the <a href="/state-of-product-recommendation-quizzes/" class="font-medium text-white underline decoration-white/40 underline-offset-2 hover:decoration-white">state of product recommendation quizzes</a>.
      </p>
    </div>
  </section>

  <!-- Methodology -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Methodology</h2>
      <ul class="mt-8 space-y-5" role="list">
        {methodologyHtml.map((m) => (
          <li class="flex gap-3">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400" aria-hidden="true"></span>
            <p class="text-slate-700" set:html={m} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Frequently asked questions</h2>
      <div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
        {FAQ.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-lg font-semibold text-slate-900 [&::-webkit-details-marker]:hidden">
              <span>{f.question}</span>
              <svg class="h-5 w-5 flex-shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <p class="pb-5 text-slate-700" set:html={f.answerHtml ?? f.answer} />
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  import Chart from "chart.js/auto";
  import { GROWTH, REVIEWS, REVENUE, PRICING, GEOGRAPHY, COLORS } from "../../lib/app-economy";

  Chart.defaults.font.family =
    "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif";
  Chart.defaults.color = "#475569";
  Chart.defaults.font.size = 13;

  const el = (id: string) => document.getElementById(id) as HTMLCanvasElement | null;
  const grid = "#eef0f2";
  const kfmt = (v: number) => (v >= 1000 ? v / 1000 + "K" : "" + v);

  const growth = el("c-growth");
  if (growth)
    new Chart(growth, {
      type: "line",
      data: {
        labels: GROWTH.labels,
        datasets: [
          {
            data: GROWTH.cumulative,
            borderColor: COLORS.primary,
            backgroundColor: "rgba(97,110,255,0.10)",
            fill: true,
            tension: 0.35,
            borderWidth: 2.5,
            pointRadius: 3,
            pointHoverRadius: 5,
            pointBackgroundColor: COLORS.primary,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: { callbacks: { label: (c) => Number(c.parsed.y).toLocaleString() + " apps live" } },
        },
        scales: {
          y: { beginAtZero: true, grid: { color: grid }, ticks: { callback: (v) => kfmt(Number(v)) } },
          x: { grid: { display: false } },
        },
      },
    });

  const donutOpts = (suffix: string) => ({
    responsive: true,
    maintainAspectRatio: false,
    cutout: "62%",
    plugins: {
      legend: { position: "bottom" as const, labels: { boxWidth: 12, boxHeight: 12, padding: 16 } },
      tooltip: { callbacks: { label: (c: any) => `${c.label}: ${c.parsed}${suffix}` } },
    },
  });

  const reviews = el("c-reviews");
  if (reviews)
    new Chart(reviews, {
      type: "doughnut",
      data: { labels: REVIEWS.labels, datasets: [{ data: REVIEWS.values, backgroundColor: REVIEWS.colors, borderWidth: 0 }] },
      options: donutOpts("%"),
    });

  const revDonut = el("c-revenue-donut");
  if (revDonut)
    new Chart(revDonut, {
      type: "doughnut",
      data: { labels: REVENUE.donut.labels, datasets: [{ data: REVENUE.donut.values, backgroundColor: REVENUE.donut.colors, borderWidth: 0 }] },
      options: donutOpts("%"),
    });

  const revBars = el("c-revenue-bars");
  if (revBars)
    new Chart(revBars, {
      type: "bar",
      data: { labels: REVENUE.bars.labels, datasets: [{ data: REVENUE.bars.values, backgroundColor: COLORS.primary, borderRadius: 4, barThickness: 26 }] },
      options: {
        indexAxis: "y",
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: (c) => c.parsed.x + "% of estimated revenue" } } },
        scales: { x: { beginAtZero: true, max: 100, grid: { color: grid }, ticks: { callback: (v) => v + "%" } }, y: { grid: { display: false } } },
      },
    });

  const pricing = el("c-pricing");
  if (pricing)
    new Chart(pricing, {
      type: "doughnut",
      data: { labels: PRICING.labels, datasets: [{ data: PRICING.values, backgroundColor: PRICING.colors, borderWidth: 0 }] },
      options: donutOpts("%"),
    });

  const geo = el("c-geography");
  if (geo)
    new Chart(geo, {
      type: "bar",
      data: { labels: GEOGRAPHY.labels, datasets: [{ data: GEOGRAPHY.values, backgroundColor: GEOGRAPHY.labels.map((_, i) => (i < 2 ? COLORS.primary : COLORS.secondary)), borderRadius: 4 }] },
      options: {
        indexAxis: "y",
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: (c) => Number(c.parsed.x).toLocaleString() + " apps" } } },
        scales: { x: { beginAtZero: true, grid: { color: grid }, ticks: { callback: (v) => kfmt(Number(v)) } }, y: { grid: { display: false } } },
      },
    });
</script>
