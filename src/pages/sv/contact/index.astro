---
import Base from "../../../layouts/Base.astro";
import PageHero from "../../../components/PageHero.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import YouTubeFacade from "../../../components/YouTubeFacade.astro";
import { organization, breadcrumb } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Hem", url: "/" },
    { name: "Kontakt", url: "/contact/" },
  ]),
];

const channels = [
  {
    label: "Läs hjälpguiderna",
    href: "https://docs.revenuehunt.com/",
    note: "Självbetjäningsdokumentation, integrationer, felsökning.",
    external: true,
  },
  {
    label: "Support och försäljning via e-post",
    href: "mailto:team@revenuehunt.com",
    note: "team@revenuehunt.com - se svarstiderna längre ner.",
  },
  {
    label: "Kolla systemstatusen",
    href: "https://status.revenuehunt.com/",
    note: "Tjänstens hälsa i realtid och incidenthistorik. 99,98 %+ drifttid.",
    external: true,
  },
];

const responseTiers = [
  {
    label: "Kritisk - produktion nere, säkerhet, dataintegritet",
    sla: "Första svar inom 30 minuter, 24/7 över hela världen",
  },
  {
    label: "Hög - viktig funktion påverkad, flera användare berörda",
    sla: "Första svar inom 12 timmar",
  },
  {
    label: "Standard - frågor, hjälp med konfiguration",
    sla: "1 arbetsdag",
  },
  {
    label: "Låg prioritet - feedback, funktionsönskemål",
    sla: "Upp till 3 arbetsdagar",
  },
];
---

<Base
  title="Kontakt - RevenueHunt"
  description="Kom i kontakt med RevenueHunts supportteam. Läs hjälpguiderna, titta på handledningen eller gör supportquizet för att få ett personligt svar på minuter."
  jsonLd={jsonLd}
  lang="sv"
  translated={true}
>
  <!-- Hero -->
  <PageHero center>
      <Breadcrumb items={[{ label: "Hem", href: localizedHref("/", "sv") }, { label: "Kontakt" }]} />
      <Eyebrow>Hör av dig</Eyebrow>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Hör av dig
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-600">
        Läs hjälpguiderna, titta på handledningen eller gör vårt supportquiz här nedanför - ehandelns smartaste
        och vänligaste supportteam svarar dig.
      </p>
  </PageHero>

  <!-- Two-column: video + channels -->
  <section class="mx-auto max-w-7xl px-6 py-12">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Börja med handledningen</h2>
        <p class="mt-3 text-slate-600">
          De flesta frågor besvaras i 3-minutersguiden. Ta en snabb titt innan du skriver till oss.
        </p>
        <div class="mt-6 aspect-video overflow-hidden rounded-xl bg-slate-900 shadow-xl">
          <YouTubeFacade id="oL1DnBd6N1U" title="RevenueHunts supporthandledning" />
        </div>
      </div>
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Så kontaktar du oss</h2>
        <ul class="mt-6 space-y-3">
          {channels.map((c) => (
            <li>
              <a
                href={c.href}
                target={c.external ? "_blank" : undefined}
                rel={c.external ? "external noopener" : undefined}
                class="group flex items-start justify-between gap-4 rounded-xl border border-slate-200 bg-white p-5 transition hover:border-slate-300 hover:shadow-md"
              >
                <div>
                  <p class="text-base font-semibold text-slate-900 group-hover:text-[#16161D]">{c.label}</p>
                  <p class="mt-1 text-sm text-slate-600">{c.note}</p>
                </div>
                <span class="mt-1 shrink-0 text-slate-400 transition group-hover:text-[#16161D]" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Support quiz -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Gör vårt supportquiz</h2>
      <p class="mx-auto mt-3 max-w-2xl text-slate-600">
        Svara på några snabba frågor så hänvisar vi dig till rätt hjälp - dokumentation, handledning eller ett svar från en riktig person.
      </p>
      <div class="mx-auto mt-8 max-w-4xl overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <iframe
          src="https://admin.revenuehunt.com/public/quiz/ZAHJoMM"
          title="RevenueHunts supportquiz"
          loading="lazy"
          class="block h-[600px] w-full"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- Response times — moved here from the right column so it sits under
       the quiz, since that's where visitors land after asking for help. -->
  <section class="mx-auto max-w-4xl px-6 py-16">
    <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm sm:p-10">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Svarstider</h2>
      <p class="mt-3 text-slate-600">
        Nivåbaserad support-SLA för alla handlare, med prioritet för Shopify Plus- och enterprisekonton.
      </p>
      <dl class="mt-6 grid gap-4 sm:grid-cols-2">
        {responseTiers.map((t) => (
          <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
            <dt class="text-sm font-semibold text-slate-900">{t.label}</dt>
            <dd class="mt-1 text-sm text-slate-600">{t.sla}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Base>
