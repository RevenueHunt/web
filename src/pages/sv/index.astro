---
import Base from "../../layouts/Base.astro";
import PlanCards from "../../components/pages/PlanCards.astro";
import YouTubeFacade from "../../components/YouTubeFacade.astro";
import { organization, website, softwareApplication } from "../../lib/schema";
import { SITE } from "../../lib/site";
import { localizedHref } from "../../lib/i18n";

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=bfs_badge_hero";
const WOOCOMMERCE_DOWNLOAD =
  "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";
const YOUTUBE_ID = "fJqpGJUzZNE";

const stats = [
  { value: "+20,000", label: "Varumärken som använder RevenueHunt" },
  { value: "+45M", label: "Genomförda quiz" },
  { value: "+370M USD", label: "Intäkter för handlare" },
  { value: "4.9 ★", label: "Över 550 femstjärniga recensioner" },
];

const pillars = [
  {
    image: "/img/pages/home/recommend-right-products.svg",
    title: "Rekommendera rätt produkter",
    body:
      "Quiz med integrerade produkter driver försäljning, vägleder kunderna till rätt produkter för dem och hjälper dem att fatta köpbeslut med trygghet.",
  },
  {
    image: "/img/pages/home/know-your-customers.svg",
    title: "Lär känna dina kunder",
    body:
      "Quiz låter dig samla in användbara data genom att ställa konkreta frågor till dina kunder. Segmentera och tagga dina köpare utifrån deras svar.",
  },
  {
    image: "/img/pages/home/grow-your-audience.svg",
    title: "Få din publik att växa",
    body:
      "Skicka de insamlade leadsen till din e-postlista eller ditt CRM. Utnyttja kundprofildatan för att skapa mer personliga marknadsföringskampanjer med högre ROI.",
  },
];

const features = [
  {
    kicker: "AI-quizcopilot",
    title: "Skapa ett quiz på 60 sekunder med AI",
    body:
      "Beskriv din butik så genererar vår AI-copilot ett fullt konfigurerat quiz - frågor, logik och produktmatchning - redo att publiceras.",
  },
  {
    kicker: "Villkorslogik",
    title: "Förgreningslogik med dra och släpp",
    body:
      "Visa eller dölj frågor utifrån tidigare svar. Vägled varje köpare längs vägen som slutar i ett köp - ingen kod krävs.",
  },
  {
    kicker: "Quizdesign",
    title: "Gör det till ditt eget - ingen kod krävs",
    body:
      "Anpassa färger, typsnitt, bilder och design så att de matchar ditt varumärke. Ditt quiz ser ut som en del av din butik, inte en tredjepartswidget.",
  },
  {
    kicker: "Resultatsida",
    title: "En kassafärdig resultatsida som konverterar",
    body:
      "Visa personliga produktrekommendationer grupperade efter rutinsteg - med bilder, priser och lägg-i-varukorg-knappar. Köpare handlar direkt från resultatsidan.",
  },
  {
    kicker: "Avhoppsanalys",
    title: "Vet exakt var köparna hoppar av",
    body:
      "Se avhoppsfrekvenser fråga för fråga, destinationer och resultat. Åtgärda friktionspunkter, förbättra slutförandena och återvinn förlorade intäkter.",
  },
  {
    kicker: "Tredjepartsintegrationer",
    title: "Anslut hela din marknadsföringsstack",
    body:
      "Skicka quizdatan till Google Analytics, utlös Meta Pixel-händelser för retargeting och synka leads med Klaviyo - allt från en enda inställningssida. Ingen kod, ingen middleware.",
  },
];

const steps = [
  {
    title: "Installera appen",
    body: "Installation med ett klick från Shopify App Store eller WordPress plugin-katalog.",
  },
  {
    title: "Skapa ditt quiz",
    body: "Använd AI-copiloten eller dra-och-släpp-editorn. Lägg till dina frågor, definiera din logik.",
  },
  {
    title: "Matcha dina produkter",
    body: "Koppla quizets svar till din produktkatalog. Rekommendera den bästa matchningen för varje resultat.",
  },
  {
    title: "Publicera och marknadsför",
    body: "Bädda in det på vilken sida som helst, visa det som en pop-up vid avsiktsavbrott eller länka till det från dina annonser.",
  },
];

const testimonials = [
  {
    quote:
      "Jag bytte från Octane. Designprocessen var mycket mer intuitiv och visuellt tilltalande. När jag fick ett problem med Klaviyo svarade supporten blixtsnabbt och med en superöppen och nära attityd.",
    author: "Kae Paché",
  },
  {
    quote:
      "Eric var extremt tålmodig, kunnig och noggrann - och guidade mig steg för steg genom quizkonfigurationen. Sådan support är sällsynt.",
    author: "Marcelle",
  },
  {
    quote:
      "Själva appen är utmärkt: kraftfulla funktioner, intuitiv användbarhet. Teamet skapade en anpassad guidad handledning åt oss. Vi har använt den i över 3 år.",
    author: "Didymos",
  },
  {
    quote:
      "Helt klart den bästa quiz- och produktrekommendationsappen jag har testat på Shopify. Teamet tog sig tid att undersöka, förklara varje steg tydligt och guida mig tills problemet var helt löst.",
    author: "REYNA",
  },
  {
    quote:
      "Det var den 5:e quizappen jag testade och den enda som helt stödde det jag behövde. Jag kunde skapa mitt första quiz väldigt snabbt.",
    author: "CCA Printing",
  },
  {
    quote:
      "Kundtjänsten utmärker sig - en agent spelade in en video och förklarade lösningen steg för steg. Väldigt lyhörd och superhjälpsam.",
    author: "The Love U Collective",
  },
];

const verticals = [
  { icon: "💄", title: "Skönhet och hudvård", body: "Hudtypsfinnare, nyansmatchning, rutinbyggare." },
  { icon: "💊", title: "Kosttillskott", body: "Hälsomålsquiz som rekommenderar rätt stack." },
  { icon: "👗", title: "Mode", body: "Stilquiz som hittar rätt storlek, färg och passform." },
  { icon: "🐾", title: "Husdjur", body: "Rasspecifika produktrekommendationer för varje ägare." },
  { icon: "🍵", title: "Mat och dryck", body: "Smakprofilquiz som förvandlar nyfikna till prenumeranter." },
  { icon: "🏋️", title: "Fitness", body: "Målbaserade trattar för utrustning, kläder och program." },
  { icon: "🏠", title: "Hem och inredning", body: "Stilquiz som matchar möbler med varje utrymme i hemmet." },
  { icon: "🌿", title: "Eko och hållbart", body: "Quiz som matchar värderingar för den medvetna konsumenten." },
];

const brands = [
  "Olaplex", "Madluvv", "Mattel", "Alt", "Baia", "Bare", "Biktrix",
  "Dermocracy", "Diego", "Gisou", "Laura", "Nuxe", "Olcay",
  "Salad Code", "Salugea", "Sunday", "Tushy", "Tiege",
];

const SHOPIFY_REVIEWS =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/reviews?ratings%5B%5D=5&sort_by=relevance";
const WOOCOMMERCE_REVIEWS =
  "https://wordpress.org/support/plugin/product-recommendation-quiz-for-ecommerce/reviews/?filter=5";
---

<Base
  lang="sv"
  translated={true}
  title={`Produktrekommendationsquiz - ${SITE.name}`}
  description="Förvandla de som bara tittar till köpare med ett produktrekommendationsquiz. Över 20 000 varumärken, 4,9★, över 550 recensioner. Öka konverteringen och fånga zero-party data med ett produktquiz."
  jsonLd={[organization(), website(), softwareApplication()]}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-7xl px-6 py-16 lg:py-24">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:items-start lg:gap-16">
        <div>
          <a
            href={SHOPIFY_INSTALL}
            rel="external nofollow"
            data-install="home_hero_badge"
            class="mb-6 inline-block"
          >
            <img
              src="/img/home/bfs-badge.webp"
              alt="Built for Shopify"
              width="120"
              height="38"
              class="h-8 w-auto"
              loading="eager"
            />
          </a>
          <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
            Produktrekommendationsquizet som förvandlar nyfikna till köpare
          </h1>
          <p class="mt-6 max-w-xl text-lg text-slate-700">
            Betalda annonser ger klick - våra quiz förvandlar dem till försäljning. RevenueHunt vägleder köparna till rätt produkter,
            samlar in data och driver konverteringar. Lätt att installera, ingen kod.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={SHOPIFY_INSTALL}
              rel="external nofollow"
              data-install="home_hero"
              class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
            >
              installera på Shopify
            </a>
            <a
              href={WOOCOMMERCE_DOWNLOAD}
              rel="external nofollow"
              onclick="window.gtag&&gtag('event','download_woocommerce_plugin',{event_label:'home_hero'})"
              class="inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-6 py-3 text-base font-semibold text-slate-900 transition hover:border-slate-400 hover:bg-slate-50"
            >
              hämta för WooCommerce
            </a>
          </div>
          <p class="mt-4 text-sm text-slate-500">
            Gratisplan tillgänglig · 15 dagars gratis provperiod · 30 dagars pengarna-tillbaka-garanti
          </p>
        </div>

        <div class="relative lg:mt-14">
          <div class="aspect-video overflow-hidden rounded-xl bg-slate-900 shadow-2xl">
            <YouTubeFacade
              id={YOUTUBE_ID}
              title="RevenueHunt - produktrekommendationsquiz"
              poster="/img/home/video-poster.webp"
              alt="Demo av RevenueHunts produktrekommendationsquiz för Shopify- och WooCommerce-butiker"
              eager
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats / proof bar -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <p class="text-center text-sm font-semibold uppercase tracking-wider text-white/70">
        Varför välja RevenueHunt? Vår påverkan talar för sig själv
      </p>
      <dl class="mt-8 grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-4">
        {stats.map((s) => (
          <div class="text-center">
            <dt class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{s.value}</dt>
            <dd class="mt-2 text-sm text-white/70">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Problem framing -->
  <section class="mx-auto max-w-4xl px-6 py-20 text-center">
    <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
      Köpare vet inte alltid vad de ska köpa - och det betyder förlorad försäljning.
    </h2>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-700">
      Vårt <a href={localizedHref("/product-recommendation-quiz/", "sv")} class="font-semibold text-slate-900 underline underline-offset-4 hover:text-slate-700">produktrekommendationsquiz</a> vägleder varje kund genom deras resa och hjälper dem att upptäcka och köpa rätt produkter för dem.
    </p>
  </section>

  <!-- 3-up pillars -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="grid gap-10 md:grid-cols-3">
        {pillars.map((p) => (
          <div class="text-center">
            <img src={p.image} alt={p.title} width="120" height="120" class="mx-auto h-24 w-24" loading="lazy" />
            <h3 class="mt-6 text-xl font-semibold text-slate-900">{p.title}</h3>
            <p class="mt-3 text-slate-600">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features grid -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Allt du behöver för att sälja smartare</h2>
      </div>
      <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {features.map((f) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">{f.kicker}</p>
            <h3 class="mt-2 text-xl font-semibold text-slate-900">{f.title}</h3>
            <p class="mt-3 text-slate-600">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4-step setup -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Igång på 4 steg. På mindre än 15 minuter.</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          Inga utvecklare. Ingen kod. Bara ett quiz som dina kunder kommer att älska.
        </p>
      </div>
      <ol class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <li class="rounded-xl border border-slate-200 bg-white p-6">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-[#16161D] text-sm font-bold text-white">{i + 1}</span>
            <h3 class="mt-4 text-lg font-semibold text-slate-900">{s.title}</h3>
            <p class="mt-2 text-slate-600">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          Upptäck varför handlare älskar produktrekommendationsquiz
        </h2>
        <p class="mx-auto mt-4 max-w-3xl text-lg text-slate-700">
          Betrott av fler än 20 000 varumärken och uppbackat av över 550 femstjärniga recensioner på Shopify, WooCommerce och mer -
          RevenueHunt är den givna quizappen för att driva försäljning genom personalisering. Men ta inte bara vårt ord på det.
        </p>
        <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap text-sm">
          <a href={SHOPIFY_REVIEWS} rel="external nofollow" class="font-semibold text-[#16161D] underline-offset-4 hover:underline">
            Recensioner på Shopify →
          </a>
          <a href={WOOCOMMERCE_REVIEWS} rel="external nofollow" class="font-semibold text-[#16161D] underline-offset-4 hover:underline">
            Recensioner på WooCommerce →
          </a>
        </div>
      </div>

      <h3 class="mt-16 text-center text-xl font-semibold text-slate-900">Vad handlarna säger</h3>
      <div class="rh-carousel mt-8">
        <ul data-carousel class="rh-carousel__track" aria-label="Omdömen från handlare">
          {testimonials.map((t) => (
            <li class="rounded-xl border border-slate-200 bg-white p-6">
              <p class="text-amber-500" aria-label="5 av 5 stjärnor">★★★★★</p>
              <blockquote class="mt-3 text-slate-700">"{t.quote}"</blockquote>
              <p class="mt-4 text-sm font-semibold text-slate-900"> - {t.author}</p>
            </li>
          ))}
        </ul>
        <div data-carousel-dots class="rh-carousel__dots"></div>
      </div>
    </div>
  </section>

  <!-- Verticals -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Byggt för varje eHandelsvertikal</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          Oavsett om du säljer hudvård, kosttillskott eller soffor - ett quiz som hjälper köpare att hitta rätt produkt konverterar bättre än någon kollektionssida.
        </p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {verticals.map((v) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6">
            <span class="block text-3xl" aria-hidden="true">{v.icon}</span>
            <h3 class="mt-3 text-base font-semibold text-slate-900">{v.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Brand logos -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-7xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-white sm:text-3xl">Driver de bästa eHandelsvarumärkena</h2>
      <div class="brands-marquee mt-10">
        <ul class="brands-marquee__track" aria-label="Logotyper för kundvarumärken">
          {brands.map((b) => (
            <li class="brands-marquee__item">
              <img
                src={`/img/brands/${b.toLowerCase().replace(/ /g, "-")}.svg`}
                alt={b}
                loading="lazy"
                width="160"
                height="40"
              />
            </li>
          ))}
          {brands.map((b) => (
            <li class="brands-marquee__item" aria-hidden="true">
              <img
                src={`/img/brands/${b.toLowerCase().replace(/ /g, "-")}.svg`}
                alt={`${b} logotyp`}
                loading="lazy"
                width="160"
                height="40"
              />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <style>
    .brands-marquee {
      overflow: hidden;
      -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
      mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    }
    .brands-marquee__track {
      display: flex;
      align-items: center;
      width: max-content;
      list-style: none;
      padding: 0;
      margin: 0;
      animation: brands-marquee 40s linear infinite;
    }
    .brands-marquee:hover .brands-marquee__track {
      animation-play-state: paused;
    }
    .brands-marquee__item {
      flex-shrink: 0;
      padding: 10px 24px;
      height: 64px;
      display: flex;
      align-items: center;
    }
    .brands-marquee__item img {
      height: 100%;
      width: auto;
      max-width: 160px;
      object-fit: contain;
      /* Normalize mixed-fill SVGs to white on the dark strip. */
      filter: brightness(0) invert(1);
      opacity: 0.85;
    }
    @keyframes brands-marquee {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }
    @media (prefers-reduced-motion: reduce) {
      .brands-marquee__track { animation: none; }
    }
  </style>

  <!-- Plans summary -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-7xl px-6 py-20">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Välj den bästa planen för din eHandel</h2>
        <p class="mt-4 text-base text-slate-700 sm:text-lg">
          Gratisplan tillgänglig. 15 dagars gratis provperiod med obegränsade quizsvar och alla funktioner. 30 dagars pengarna-tillbaka-garanti.
        </p>
      </div>

      <div class="mt-12">
        <PlanCards lang="sv" />
      </div>
    </div>
  </section>

  <!-- Multi-platform strip -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 py-16 text-center">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Fungerar på flera eHandelsplattformar</h2>
      <!-- Logos are white SVGs (built for a dark bg); brightness-0 inverts them to dark for this white section. -->
      <ul class="mt-10 flex flex-wrap items-center justify-center gap-x-14 gap-y-8">
        <li>
          <a href={localizedHref("/product-recommendation-quiz-shopify/", "sv")} aria-label="Produktrekommendationsquiz för Shopify">
            <img src="/img/logos/shopify_monotone_white.svg" alt="Shopify" class="h-8 w-auto opacity-60 brightness-0 transition hover:opacity-100" />
          </a>
        </li>
        <li>
          <a href={localizedHref("/product-recommendation-quiz-woocommerce/", "sv")} aria-label="Produktrekommendationsquiz för WooCommerce">
            <img src="/img/logos/woo_logo_white.svg" alt="WooCommerce" class="h-8 w-auto opacity-60 brightness-0 transition hover:opacity-100" />
          </a>
        </li>
        <li>
          <a href={localizedHref("/product-recommendation-quiz-bigcommerce/", "sv")} aria-label="Produktrekommendationsquiz för BigCommerce">
            <img src="/img/logos/bigcommerce_logo_white.svg" alt="BigCommerce" class="h-7 w-auto opacity-60 brightness-0 transition hover:opacity-100" />
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-white/70">
        De flesta köpare lämnar för att de inte hittar rätt produkt
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Förvandla köpare till trygga köpare med ett produktrekommendationsquiz som driver försäljning.
      </h2>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SHOPIFY_INSTALL}
          rel="external nofollow"
          data-install="home_bottom"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          installera på Shopify
        </a>
        <a
          href={WOOCOMMERCE_DOWNLOAD}
          rel="external nofollow"
          onclick="window.gtag&&gtag('event','download_woocommerce_plugin',{event_label:'home_bottom'})"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          hämta för WooCommerce
        </a>
      </div>
    </div>
  </section>
</Base>
