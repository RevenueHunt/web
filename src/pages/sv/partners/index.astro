---
import Base from "../../../layouts/Base.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import { organization, breadcrumb } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

interface Partner {
  name: string;
  url: string;
  logo: string;
  description: string;
}

const groups: { heading: string; emoji: string; intro: string; items: Partner[] }[] = [
  {
    heading: "Lokalisering",
    emoji: "🌍",
    intro: "Sälj över gränserna med inbyggd geolokalisering, översättning och flera valutor.",
    items: [
      { name: "Orbe Shopify Geolocation", url: "https://apps.shopify.com/orbe?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/orbe-removebg-preview.webp", description: "Maximera den globala försäljningen med avancerad Shopify-geolokalisering. Anpassa produkter, priser, valuta och innehåll för varje land och vägled kunderna till rätt köpupplevelse med Orbe." },
      { name: "Langwill: Language Translate", url: "https://apps.shopify.com/localiser?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/1.webp", description: "Utöka din globala räckvidd med Langwill: översätt din Shopify-butik till 138 språk och konvertera valutor automatiskt för en smidig och lokaliserad köpupplevelse." },
    ],
  },
  {
    heading: "Chatt och support",
    emoji: "💬",
    intro: "Kundkontoverktyg som gör självbetjäning och support enkelt.",
    items: [
      { name: "Dondy WhatsApp Marketing & Chat", url: "https://apps.shopify.com/dondy-marketing-ai?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/dondy-logo.webp", description: "Förvandla förlorad trafik till intäkter med automatiserade WhatsApp-flöden för återvinning, bekräftelse och retention – plus en AI-agent som sköter kundsupporten så att ditt team slipper." },
      { name: "Customer Dashboard Pro", url: "https://apps.shopify.com/customer-dashboard-pro?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/CustomerDashboard.webp", description: "Customer Dashboard Pro är den enda appen som erbjuder smidigt stöd för både Shopifys nya Customer Accounts och Classic Customer Accounts." },
    ],
  },
  {
    heading: "Merförsäljning och rekommendationer",
    emoji: "🎯",
    intro: "Öka ordervärdet med merförsäljning i kassan, önskelistor och förbeställningar.",
    items: [
      { name: "WC Wishlist Club", url: "https://apps.shopify.com/wishlist-club?utm_source=RevenueHunt&utm_medium=partnership&utm_campaign=partnership", logo: "/img/pages/partners/wishlist-club-150-150-px-logo.webp", description: "WC Wishlist Club låter dina kunder spara sina favoritprodukter, dela önskelistor och köpa senare, vilket ökar engagemanget och försäljningen. Enkel att konfigurera, mobiloptimerad och perfekt för att förvandla de som bara tittar till lojala köpare." },
      { name: "iCart Cart Drawer Cart Upsell", url: "https://apps.shopify.com/icart/?campaign=promotion&medium=in-app-banner&source=revenuehunt&utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/iCart-Cart-Drawer-Cart-Upsell-logo.webp", description: "En komplett Shopify-app för att anpassa en varukorgslåda och hela varukorgssidan med upsell, produktrekommendationer, förloppsindikator, produktpaket och rabatter." },
      { name: "PreOrder Now WOD", url: "https://apps.shopify.com/preorder-now?utm_source=RevenueHunt&utm_medium=partnership&utm_campaign=partner&utm_id=crosspromo", logo: "/img/pages/partners/PreOrder-Now-Logo.webp", description: "Förvandla situationer med slut i lager till möjligheter för förbeställning. Perfekt för print-on-demand-företag: fånga kundens intresse utan startlager." },
    ],
  },
  {
    heading: "Priser och rabatter",
    emoji: "🏷️",
    intro: "Paket, mängdrabatter och B2B-priser som belönar större varukorgar.",
    items: [
      { name: "Kaching Bundle Quantity Deals", url: "https://apps.shopify.com/bundle-deals?utm_source=RevenueHunt&utm_medium=partnership&utm_campaign=REVENUEH", logo: "/img/pages/partners/Kaching-Logo-1024x1024.webp", description: "Driv försäljning med Kaching Bundle Quantity Deals: skapa paketerbjudanden direkt på din produktsida. Använd koden REVENUEH20 för en exklusiv rabatt på 20 %." },
      { name: "BSS: B2B/Wholesale Solution", url: "https://apps.shopify.com/b2b-solution-custom-pricing?utm_source=RevenueHunt&utm_medium=partnership&utm_campaign=partnership-2024", logo: "/img/pages/partners/BSS-Commerce_logo_150.webp", description: "En komplett grossistlösning. En smidig B2B-köpupplevelse som dessutom hjälper handlare att hantera sina grossistkunder och få insikter om dem." },
    ],
  },
  {
    heading: "Marknadsföring och popups",
    emoji: "📣",
    intro: "Socialt bevis, affiliateprogram och kampanjer på sajten som driver försäljning.",
    items: [
      { name: "ToastiBar – Sales Popup", url: "https://makeprosimp.com/partnership/revenuehunt", logo: "/img/pages/partners/toastibarlogo_fgaiv9.webp", description: "Öka kundernas förtroende och driv försäljning genom att visa social bevisning i realtid: försäljning, varukorg, besökare, produktrecensioner och lagervarningar." },
      { name: "UpPromote: Affiliate & Referral", url: "https://partners.secomapp.com/apps/affiliate/SHOPQUIZ_APP", logo: "/img/pages/partners/NEW_logo-1.webp", description: "UpPromote är den mest rekommenderade affiliate-/hänvisningsappen i Shopify App Store. En komplett lösning för att skapa och hantera dina marknadsföringskampanjer, lämplig för företag av alla storlekar." },
    ],
  },
  {
    heading: "Frakt och logistik",
    emoji: "📦",
    intro: "Inköp, logistik och fri frakt-incitament för att leverera snabbare och skala.",
    items: [
      { name: "Essential Free Shipping Bar", url: "https://apps.shopify.com/essential-order-value-booster?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/freeshippingbarlogo.webp", description: "Öka försäljningen och AOV genom att konfigurera obegränsade fri frakt-barer med flera mål för varukorgsvärde för att motivera köpare att lägga till fler produkter." },
      { name: "HyperSKU", url: "https://apps.shopify.com/hypersku?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/150150-logo.webp", description: "HyperSKU erbjuder en komplett leveranskedjelösning. Över 1 miljon produkter, paketförsäljning, provtagning, kvalitetsinspektion, varumärkesanpassning och automatiserad orderfulfillment." },
    ],
  },
  {
    heading: "Analys och rapportering",
    emoji: "📊",
    intro: "SEO-insikter och orderdata för att mäta vad som fungerar och rapportera om det.",
    items: [
      { name: "PDF Invoice Generator", url: "https://apps.shopify.com/fordeer-invoice-order-printer?utm_source=RevenueHunt&utm_medium=partnership&utm_campaign=partner", logo: "/img/pages/partners/fordeer-data-export-1024x1024.webp", description: "Fordeers Shopify-fakturagenerator är flexibel, följer globala regler och betjänar B2C, B2B och grossister. Anpassningsbara PDF-mallar, batchutskrift och support via livechatt 24/7." },
      { name: "AI SEO Optimizer", url: "https://share.seoant.com/app/1165b75b7ce1524D5J", logo: "/img/pages/partners/SEOAnt-_-AI-SEO-Optimizer_Channelwill-.webp", description: "Den bästa SEO-appen för Shopify: optimera nyckelord, förbättra metataggar och förfina webbplatsstrukturen. AI-drivna analyser av SEO-prestanda och hastighet." },
    ],
  },
  {
    heading: "Butiksdesign och teman",
    emoji: "🎨",
    intro: "Premium Shopify-teman byggda för att konvertera och få din butik att glänsa.",
    items: [
      { name: "eComX", url: "https://ecomx.co/?utm_source=RevenueHunt&utm_medium=partnership", logo: "/img/pages/partners/ecomx-logo.webp", description: "eComX skapar premium Shopify-teman byggda för att konvertera. Välj bland 16+ nischspecifika designer, optimerade med verklig konverteringsdata och byggda för snabbhet, för att förvandla fler besökare till köpare." },
    ],
  },
];

const perks = [
  { title: "Hänvisningsprovision", body: "Värva nya kunder till RevenueHunt och få en livslång provision på 20 % av alla intäkter de genererar." },
  { title: "Affiliate-länkar", body: "Lägg till dina affiliate-länkar i dina artiklar, nyhetsbrev och inlägg på sociala medier. Länka direkt till våra appar för Shopify, WooCommerce, BigCommerce, Magento och fristående." },
  { title: "Din egen partneransvarig", body: "Få råd om hur du bygger automatiserade försäljningstrattar med vårt verktyg och tips för att sälja vår lösning till dina kunder." },
  { title: "Exklusivt innehåll", body: "Kontakta oss för att få råd om hur du bygger automatiserade försäljningstrattar för dina kunder med RevenueHunt och andra verktyg." },
  { title: "En plats i vår Partner Directory", body: "Våra användare hittar dig i vår Partner Directory och kontaktar dig för att anlita dina tjänster." },
];

const faqs = [
  { q: "Vad kostar det att bli partner?", a: "Att registrera sig är helt gratis. Noll. Inget." },
  { q: "Måste jag vara kund hos RevenueHunt?", a: "Nej, du behöver inte vara kund hos RevenueHunt för att bli partner." },
  { q: "Hur får jag betalt?", a: "Vi betalar ut intäkterna månadsvis. Betalningarna skickas via PayPal." },
  { q: "Hur kan jag följa mina hänvisningar?", a: "Du kan se din statistik i din <a href='https://admin.revenuehunt.com/' target='_blank' rel='external noopener' class='font-semibold text-[#16161D] underline'>Partner Dashboard</a>." },
];

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Hem", url: "/" },
    { name: "Partners och affiliates", url: "/partners/" },
  ]),
];
---

<Base
  title="Partnerprogram - RevenueHunt"
  description="Hänvisa dina kunder. Tjäna pengar. Få en livslång provision på 20 % av de kunder du hänvisar till RevenueHunt. Registrera dig gratis i vårt Partnerprogram."
  jsonLd={jsonLd}
  lang="sv"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20 text-center">
      <Breadcrumb items={[{ label: "Hem", href: localizedHref("/", "sv") }, { label: "Partners och affiliates" }]} />
      <Eyebrow>Partnerprogram</Eyebrow>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Hänvisa dina kunder. Tjäna pengar.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-xl text-slate-600">
        Tjäna en <strong class="font-semibold text-slate-900">livslång provision på 20 %</strong> av de kunder du hänvisar till oss. Registrera dig gratis i vårt Partnerprogram idag.
      </p>
      <p class="mx-auto mt-6 max-w-3xl text-slate-600">
        Om du är en <strong class="font-semibold text-slate-900">digital marknadsföringsbyrå</strong> eller en
        <strong class="font-semibold text-slate-900">ehandelsspecialist</strong> och vill växa ditt företag,
        är vårt Partnerprogram för dig. Skapa fantastiska upplevelser för dina kunder med RevenueHunt.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
        >
          Kom igång nu
        </a>
        <a
          href="#partners"
          class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
        >
          Se våra partners
        </a>
      </div>
    </div>
  </section>

  <!-- Who you are + perks -->
  <section class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-1">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Vem du är</h2>
        <p class="mt-4 text-slate-600">
          Du är en digital marknadsföringsbyrå eller en ehandelskonsult som brinner för design och är besatt av att
          <strong class="font-semibold text-slate-900">uppnå bästa möjliga resultat</strong> för dina kunder. Du växer
          ditt företag genom att lyfta andras.
        </p>
      </div>
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Vad du får av oss</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {perks.map((p) => (
            <li class="rounded-xl border border-slate-200 bg-white p-5">
              <h3 class="text-base font-semibold text-slate-900">{p.title}</h3>
              <p class="mt-2 text-sm text-slate-600">{p.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Partner directory -->
  <section id="partners" class="mx-auto max-w-7xl px-6 py-16 scroll-mt-24">
    <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Våra partners</h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
      Betrodda appar och byråer som matchar RevenueHunt perfekt för dina kunder.
    </p>
    <div class="mt-12 space-y-16">
      {groups.map((g) => (
        <div>
          <div class="mb-2 flex items-baseline gap-3">
            <span class="text-2xl" aria-hidden="true">{g.emoji}</span>
            <h3 class="text-2xl font-semibold tracking-tight text-slate-900">{g.heading}</h3>
          </div>
          <p class="max-w-3xl text-slate-600">{g.intro}</p>
          <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {g.items.map((p) => (
        <li>
          <a
            href={p.url}
            target="_blank"
            rel="external noopener nofollow"
            class="group flex h-full flex-col items-center rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm transition hover:border-slate-300 hover:shadow-md"
          >
            <img
              src={p.logo}
              alt={`${p.name}-logotyp`}
              loading="lazy"
              width="120"
              height="120"
              class="h-24 w-24 rounded-lg object-cover"
            />
            <h3 class="mt-5 text-lg font-semibold text-slate-900 group-hover:text-[#16161D]">{p.name}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{p.description}</p>
            <span class="mt-5 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wider text-slate-500 group-hover:text-[#16161D]">
              Besök webbplats <span aria-hidden="true">↗</span>
            </span>
          </a>
        </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-4xl px-6 py-16">
      <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Vanliga frågor</h2>
      <div class="mx-auto mt-8 max-w-2xl">
        {faqs.map((f) => (
          <details class="border-b border-slate-200">
            <summary class="py-4 text-base font-semibold text-slate-900">{f.q}</summary>
            <p class="pb-4 text-slate-600" set:html={f.a}></p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Bli partner till RevenueHunt
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        Hänvisa dina kunder, bygg automatiserade försäljningstrattar och tjäna en livslång provision på 20 % av allt de spenderar.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="mailto:partners@revenuehunt.com?subject=RevenueHunt%20Partner%20Program"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          Kom igång nu
        </a>
        <a
          href={localizedHref("/demo/", "sv")}
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          Boka en demo
        </a>
      </div>
    </div>
  </section>
</Base>
