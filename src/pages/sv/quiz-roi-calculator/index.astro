---
import Base from "../../../layouts/Base.astro";
import PageHero from "../../../components/PageHero.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import { organization, breadcrumb, softwareApplication, faqPage } from "../../../lib/schema";
import { localizedHref } from "../../../lib/i18n";

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=roi_calculator";
// Free WordPress.org plugin (not the WooCommerce.com extension).
const WOO_PLUGIN = "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";

// Inputs. The quiz-taker conversion rate carries a benchmark flag (RevenueHunt
// data badge + helper note) and is editable. The AOV uplift is NOT a visible
// input: it is set by the sector dropdown (hidden #aovlift field) from the
// within-store paired result (median +11% to +15%, concentrated in skincare/
// beauty/supplements, flat in a few categories) and folded into the math.
// Everything else is the merchant's own number.
// (Data: PRD-Octane-AI-SEO-Reverse-Engineering W7 deep-dive note.)
const controls = [
  { id: "visitors", label: "Månatliga besökare i butiken", min: 500, max: 500000, step: 500, value: 10000, suffix: "" },
  { id: "engage", label: "Andel besökare som gör quizet", min: 1, max: 100, step: 1, value: 20, suffix: "%" },
  { id: "aov", label: "Ditt genomsnittliga ordervärde", min: 10, max: 1000, step: 5, value: 60, suffix: "$" },
  { id: "cvr", label: "Din nuvarande konverteringsgrad", min: 0.1, max: 15, step: 0.1, value: 2, suffix: "%" },
  { id: "quizcvr", label: "Konverteringsgrad för den som gör quizet", min: 1, max: 50, step: 0.5, value: 5.5, suffix: "%", benchmark: true, note: "Förifyllt med vår uppmätta benchmark: i genomsnitt gör 1 av 18 personer som gör quizet en beställning. Redigera det så att det matchar din butik." },
];

// Sector presets for the "what do you sell?" selector. Each sets the quiz-taker
// conversion rate and AOV uplift from measured RevenueHunt data, plus a "% of the
// average store" figure (quiz rate / a 2% average). "All sectors" is the 5.5%
// platform average (= 275%, the brand stat). "Other sectors" is the honest
// residual (everything except the consumable stars), measured at ~3.6% (~180%).
// Selecting a sector pre-fills quizcvr + aovlift; both stay editable.
// (Data: PRD-Octane-AI-SEO-Reverse-Engineering W7 deep-dive note.)
const SECTORS = [
  { id: "all", label: "Alla sektorer (genomsnitt)", quizcvr: 5.5, aovlift: 10, pct: 275 },
  { id: "haircare", label: "Hårvård", quizcvr: 7, aovlift: 15, pct: 350 },
  { id: "fragrance", label: "Parfym", quizcvr: 7, aovlift: 0, pct: 350 },
  { id: "beauty", label: "Skönhet och hudvård", quizcvr: 6, aovlift: 20, pct: 300 },
  { id: "supplements", label: "Kosttillskott och hälsa", quizcvr: 6, aovlift: 10, pct: 300 },
  { id: "coffee", label: "Kaffe och te", quizcvr: 5, aovlift: 0, pct: 250 },
  { id: "other", label: "Andra sektorer", quizcvr: 3.6, aovlift: 10, pct: 180 },
];

// Per-vertical conversion (response to order), measured in RevenueHunt data and
// rounded down. The 5.5% benchmark is a platform average; consumable categories
// run higher. Shown as a "conversion by category" proof block.
const BY_VERTICAL = [
  { v: "Hårvård", pct: "350%", lift: "+15% AOV" },
  { v: "Parfym", pct: "350%", lift: "AOV oförändrat" },
  { v: "Hudvård och skönhet", pct: "300%", lift: "+20% AOV" },
  { v: "Kosttillskott", pct: "300%", lift: "+10% AOV" },
  { v: "Kaffe och te", pct: "250%", lift: "AOV oförändrat" },
  { v: "Andra sektorer", pct: "180%", lift: "+10% AOV" },
];

// Real, data-backed proof points shown on the page. The 275% is the measured
// 5.5% quiz-taker conversion (1 in 18) expressed against a typical 2% store
// rate: 5.5 / 2 = 2.75x = 275% of baseline (accurate as "of", not "+lift").
const PROOF = [
  { stat: "45M+", label: "analyserade quizsvar" },
  { stat: "275%", label: "av den genomsnittliga konverteringsgraden" },
  { stat: "$370M+", label: "intäkter genererade för handlare" },
  { stat: "20 000+", label: "varumärken använder RevenueHunt" },
];

const faqs: { question: string; answer: string; answerHtml?: string }[] = [
  {
    question: "Varifrån kommer quizets konverteringsgrad?",
    answer:
      "Det är en benchmark från verkliga RevenueHunt-data. I quizsvarsdatan gör 5,5 % av köparna som slutför ett quiz (omkring 1 av 18) till slut en uppmätt beställning. Fältet är förifyllt med den benchmarken, och du kan redigera det så att det matchar din egen butik.",
  },
  {
    question: "Hur beräknas de extra intäkterna?",
    answer:
      "Kalkylatorn tar andelen av dina besökare som slutför quizet, tillämpar konverteringsgraden för den som gör quizet och jämför den med den konvertering som samma besökare skulle ha vid din webbplats nuvarande grad. Skillnaden, multiplicerad med ditt genomsnittliga ordervärde, är de beräknade extra intäkterna.",
  },
  {
    question: "Spenderar köpare som gör quizet mer per beställning?",
    answer:
      "I genomsnitt ja, vid en jämförelse av lika med lika. Inom samma butik är beställningar som kom via ett quiz omkring 10 % högre än de som inte gjorde det. Det är inte lika överallt: starkare i kategorier som hudvård, skönhet och kosttillskott, och nästan oförändrat i andra. Kalkylatorn tar hänsyn till det automatiskt utifrån vilken sektor du väljer.",
  },
  {
    question: "Bygger detta på verkliga data eller påhittade multiplikatorer?",
    answer:
      "Verkliga data. Quizets konverteringsbenchmark är uppmätt över fler än 45 miljoner quizsvar och över 370 miljoner dollar i intäkter genererade för handlare. Dina besökare, ditt genomsnittliga ordervärde och din nuvarande konverteringsgrad är dina egna siffror. Resultatet är en uppskattning, inte en garanti.",
  },
  {
    question: "Var kan jag se alla data bakom dessa benchmarks?",
    answer:
      "I vår benchmarkrapport om ehandelsquiz. Den bryter ner konverteringen per kategori, ökningen av det genomsnittliga ordervärdet, slutförandet och attributionen över fler än 45M verkliga quizsvar. Benchmarken på 5,5 % och siffrorna per sektor i den här kalkylatorn kommer direkt därifrån.",
    answerHtml:
      "I vår <a href=\"" + localizedHref("/state-of-product-recommendation-quizzes/", "sv") + "\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">benchmarkrapport om ehandelsquiz</a>. Den bryter ner konverteringen per kategori, ökningen av det genomsnittliga ordervärdet, slutförandet och attributionen över fler än 45M verkliga quizsvar. Benchmarken på 5,5 % och siffrorna per sektor i den här kalkylatorn kommer direkt därifrån.",
  },
  {
    question: "Är kalkylatorn gratis?",
    answer:
      "Ja. Den är gratis och utan hinder, ingen e-post krävs. RevenueHunt självt har också en gratisplan med 100 quizsvar per månad, så du kan mäta den verkliga ökningen i din egen butik.",
  },
];

const jsonLd = [
  organization(),
  softwareApplication(),
  breadcrumb([
    { name: "Hem", url: "/" },
    { name: "ROI-kalkylator för quiz", url: "/quiz-roi-calculator/" },
  ]),
  faqPage(faqs),
];
---

<Base
  title="ROI-kalkylator för quiz för ehandel"
  description="Gratis ROI-kalkylator för quiz baserad på verkliga data: 5,5 % av dem som gör quizet gör en beställning. Beräkna de extra intäkterna och den ROI som ett quiz kan ge din butik."
  ogImage="/og/quiz-roi-calculator.png"
  jsonLd={jsonLd}
  lang="sv"
  translated={true}
>
  <!-- Hero -->
  <PageHero>
      <Breadcrumb items={[{ label: "Hem", href: localizedHref("/", "sv") }, { label: "ROI-kalkylator för quiz" }]} />
      <div class="text-center">
        <Eyebrow>Gratisverktyg</Eyebrow>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">ROI-kalkylator för quiz</h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          Upptäck de extra intäkter som ett produktrekommendationsquiz kan ge din butik. Konverteringsbenchmarken på 275 % är verklig, <a href={localizedHref("/state-of-product-recommendation-quizzes/", "sv")} class="font-semibold text-[#16161D] underline decoration-2 decoration-[#16161D]/40 underline-offset-2 hover:decoration-[#16161D]">uppmätt över fler än 45M quizsvar</a>, inte en påhittad multiplikator. Justera siffrorna så att de matchar dina egna.
        </p>
      </div>
  </PageHero>

  <!-- Real-data proof band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-8">
      <div class="rounded-2xl bg-[#16161D] px-6 py-10 sm:px-10">
        <p class="text-center text-sm font-semibold uppercase tracking-wider text-white/50">Baserat på verkliga RevenueHunt-data</p>
        <dl class="mt-6 grid grid-cols-2 gap-8 text-center sm:grid-cols-4">
          {PROOF.map((p) => (
            <div>
              <dt class="text-3xl font-bold tracking-tight text-white">{p.stat}</dt>
              <dd class="mt-1 text-sm text-white/70">{p.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- Calculator -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 pb-8 pt-10">
      <div class="grid gap-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm lg:grid-cols-2 lg:p-8">
        <!-- Inputs -->
        <form id="roi-form" class="space-y-6" aria-label="Data för quizets ROI">
          <div>
            <label for="sector" class="text-sm font-medium text-slate-900">Vad säljer du?</label>
            <select
              id="sector"
              class="mt-2 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-900 focus:border-[#16161D] focus:outline-none focus:ring-1 focus:ring-[#16161D]"
            >
              {SECTORS.map((s) => (
                <option value={s.id} data-quizcvr={s.quizcvr} data-aovlift={s.aovlift} data-pct={s.pct}>{s.label}</option>
              ))}
            </select>
            <p class="mt-2 rounded-md bg-[#D8F0FE] px-3 py-2 text-xs text-[#2c81b2] ring-1 ring-inset ring-[#2c81b2]/20">
              <span id="sector-note">I RevenueHunts quizdata konverterar de som gör quizet till cirka 275 % av den genomsnittliga butiken och gör beställningar som är omkring 10 % större. Välj din sektor för en mer exakt benchmark.</span>
            </p>
          </div>
          {controls.map((c) => (
            <div>
              <div class="flex items-center justify-between gap-3">
                <label for={c.id} class="text-sm font-medium text-slate-900">
                  {c.label}
                </label>
                <div class="flex items-center gap-1 text-sm">
                  {c.suffix === "$" && <span class="text-slate-500">$</span>}
                  <input
                    type="number"
                    id={c.id}
                    min={c.min}
                    max={c.max}
                    step={c.step}
                    value={c.value}
                    class="w-24 rounded-md border border-slate-300 px-2 py-1 text-right font-semibold text-slate-900 focus:border-[#16161D] focus:outline-none focus:ring-1 focus:ring-[#16161D]"
                  />
                  {c.suffix === "%" && <span class="text-slate-500">%</span>}
                </div>
              </div>
              <input
                type="range"
                id={`${c.id}-range`}
                min={c.min}
                max={c.max}
                step={c.step}
                value={c.value}
                class="mt-3 w-full accent-[#16161D]"
                aria-label={`${c.label} slider`}
              />
              {c.note && (
                <p class="mt-2 text-xs text-slate-500">
                  <span id={`${c.id}-note`}>{c.note}</span>
                  {c.benchmark && (
                    <>
                      {" "}
                      <button
                        type="button"
                        id={`${c.id}-reset`}
                        class="hidden font-medium text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-[#16161D]"
                      >
                        Återställ till RevenueHunt-data
                      </button>
                    </>
                  )}
                </p>
              )}
            </div>
          ))}
          <!-- AOV uplift is not user-editable: the sector dropdown sets it. -->
          <input type="hidden" id="aovlift" value="10" />
        </form>

        <!-- Results -->
        <div class="flex flex-col gap-4 rounded-xl bg-slate-50 p-6">
          <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">Beräknad påverkan</p>
          <div>
            <p class="text-sm text-slate-600">Extra intäkter per månad</p>
            <p id="out-monthly" class="mt-1 text-4xl font-bold tracking-tight text-[#16161D]">$0</p>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div class="rounded-lg border border-slate-200 bg-white p-4">
              <p class="text-xs text-slate-600">Extra intäkter per år</p>
              <p id="out-annual" class="mt-1 text-xl font-bold text-slate-900">$0</p>
            </div>
            <div class="rounded-lg border border-slate-200 bg-white p-4">
              <p class="text-xs text-slate-600">Extra beställningar per månad</p>
              <p id="out-orders" class="mt-1 text-xl font-bold text-slate-900">0</p>
            </div>
          </div>
          <dl class="mt-2 space-y-1 text-sm text-slate-600">
            <div class="flex justify-between">
              <dt>Personer som gör quizet per månad</dt>
              <dd id="out-takers" class="font-medium text-slate-900">0</dd>
            </div>
            <div class="flex justify-between">
              <dt>Quizbeställningar per månad</dt>
              <dd id="out-quizorders" class="font-medium text-slate-900">0</dd>
            </div>
            <div class="flex justify-between">
              <dt>Månatliga basintäkter</dt>
              <dd id="out-baseline" class="font-medium text-slate-900">$0</dd>
            </div>
            <div class="flex justify-between">
              <dt>Med ett quiz</dt>
              <dd id="out-withquiz" class="font-medium text-slate-900">$0</dd>
            </div>
          </dl>
          <a
            href={SHOPIFY_INSTALL}
            target="_blank"
            rel="external noopener nofollow"
            data-install="roi_calculator"
            class="mt-2 inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
          >
            installera på Shopify
          </a>
          <a
            href={WOO_PLUGIN}
            target="_blank"
            rel="external noopener nofollow"
            onclick="window.gtag&&gtag('event','woocommerce_plugin_click',{event_label:'roi_calculator'})"
            class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
          >
            installera på WooCommerce
          </a>
        </div>
      </div>
      <p class="mt-4 text-xs text-slate-500">
        Konverteringsgraden för den som gör quizet är en benchmark som du kan redigera, och AOV-ökningen tillämpas automatiskt utifrån din sektor; båda kommer från verkliga RevenueHunt-data och din butik kommer att variera. Besökarna, det genomsnittliga ordervärdet och den nuvarande konverteringsgraden är dina egna siffror. Detta är en uppskattning, inte en garanti, och de verkliga resultaten beror på din butik, din trafik och ditt quiz.
      </p>
    </div>
  </section>

  <!-- Recommended plan + ROI -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 pb-14">
      <div class="rounded-2xl border-2 border-[#16161D] bg-slate-50 p-6 sm:p-8">
        <p class="text-center text-sm font-semibold uppercase tracking-wider text-slate-500">Din rekommenderade plan och ROI</p>
        <div class="mt-5 grid gap-6 sm:grid-cols-3">
          <div class="rounded-xl border border-slate-200 bg-white p-5">
            <p class="text-xs text-slate-600">Beräknade quizsvar / månad</p>
            <p id="out-responses" class="mt-1 text-3xl font-bold tracking-tight text-slate-900">0</p>
          </div>
          <div class="rounded-xl border border-slate-200 bg-white p-5">
            <p class="text-xs text-slate-600">Rekommenderad plan</p>
            <p id="out-plan" class="mt-1 text-3xl font-bold tracking-tight text-slate-900">Free Plan</p>
            <p id="out-plancost" class="text-sm text-slate-600">Gratis</p>
          </div>
          <div class="rounded-xl border border-slate-200 bg-white p-5">
            <p class="text-xs text-slate-600">Avkastning på plankostnaden</p>
            <p id="out-roi" class="mt-1 text-3xl font-bold tracking-tight text-emerald-600">-</p>
            <p id="out-net" class="text-sm text-slate-600"></p>
          </div>
        </div>
        <p class="mt-5 text-center text-sm text-slate-700"><span id="plan-note"></span> <a href={localizedHref("/pricing/", "sv")} class="font-medium text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-[#16161D]">Se alla planer</a>.</p>
        <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
          <a
            href={SHOPIFY_INSTALL}
            target="_blank"
            rel="external noopener nofollow"
            data-install="roi_calculator_plan"
            class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
          >
            kom igång gratis på Shopify
          </a>
          <a
            href={WOO_PLUGIN}
            target="_blank"
            rel="external noopener nofollow"
            onclick="window.gtag&&gtag('event','woocommerce_plugin_click',{event_label:'roi_calculator_plan'})"
            class="inline-flex items-center justify-center rounded-md border border-[#16161D] bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-50"
          >
            kom igång gratis på WooCommerce
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Conversion by category -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 pb-14">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
        <h2 class="text-center text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Ökning av konverteringsgraden per sektor</h2>
        <p class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
          Jämfört med en typisk butik på 2 % konverterar de som gör RevenueHunts quiz flera gånger mer. Här är varje kategori som procent av det genomsnittet, med ökningen av ordervärdet där vi ser den.
        </p>
        <dl class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-xl bg-slate-200 sm:grid-cols-3 lg:grid-cols-6">
          {BY_VERTICAL.map((b) => (
            <div class="bg-white px-4 py-6 text-center">
              <dt class="text-3xl font-bold tracking-tight text-[#16161D]">{b.pct}</dt>
              <dd class="mt-1 text-sm text-slate-600">{b.v}</dd>
              <dd class={`mt-2 text-xs font-medium ${b.lift.startsWith("+") ? "text-emerald-700" : "text-slate-400"}`}>{b.lift}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-4 text-center text-xs text-slate-500">
          Visat som procent av en typisk butikskonverteringsgrad på 2 %, uppmätt i våra data. Din butik kommer att variera.
        </p>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Så fungerar kalkylatorn</h2>
      <div class="mt-8 space-y-5 text-lg text-slate-700">
        <p>
          Modellen är medvetet enkel och ärlig. Den tar andelen av dina besökare som slutför quizet, konverterar dem till graden för den som gör quizet och jämför det med vad samma besökare skulle ha gjort vid din webbplats nuvarande <a href="/glossary/conversion-rate-optimization/" class="font-medium text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-[#16161D]">konverteringsgrad</a>. Skillnaden är de beräknade extra intäkterna.
        </p>
        <p>
          Enligt data insamlad över fler än 45 miljoner verkliga quizsvar gör 5,5 % av köparna som slutför ett RevenueHunt-quiz (omkring 1 av 18) en uppmätt beställning. Mot en typisk butikskonverteringsgrad på 2 % är det 2,75x, omkring 275 % av vad en butik vanligtvis konverterar. Vi förifyller den siffran och låter dig redigera den.
        </p>
        <p>
          Vi analyserade också ordervärdet. Vid en jämförelse av lika med lika, inom samma butik, är quizbeställningar omkring 10 % högre än beställningar utan quiz. Ökningen är starkare i kategorier som hudvård, skönhet och kosttillskott, och nästan oförändrad i några andra. Kalkylatorn tillämpar en konservativ och datauppbackad ökning utifrån vilken sektor du väljer, så du slipper gissa.
        </p>
        <p>
          Kalkylatorn använder ditt eget <a href="/glossary/average-order-value/" class="font-medium text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-[#16161D]">genomsnittliga ordervärde</a> och bortser från e-postleads och zero-party-data som ett quiz fångar, vilka ackumuleras över tid, så den tenderar att underskatta det totala värdet.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-center text-3xl font-bold tracking-tight text-slate-900">Vanliga frågor</h2>
      <div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
        {faqs.map((faq) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-lg font-semibold text-slate-900 [&::-webkit-details-marker]:hidden">
              <span>{faq.question}</span>
              <svg
                class="h-5 w-5 flex-shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <p class="pb-5 text-slate-700" set:html={faq.answerHtml ?? faq.answer} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Sätt ökningen på prov, gratis.
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-white/80">
        Skapa ett produktrekommendationsquiz och mät den verkliga påverkan i din butik. Gratisplan, inget kreditkort.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SHOPIFY_INSTALL}
          target="_blank"
          rel="external noopener nofollow"
          data-install="roi_calculator_bottom"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          kom igång gratis på Shopify
        </a>
        <a
          href={WOO_PLUGIN}
          target="_blank"
          rel="external noopener nofollow"
          onclick="window.gtag&&gtag('event','woocommerce_plugin_click',{event_label:'roi_calculator_bottom'})"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          kom igång gratis på WooCommerce
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var KEYS = ["visitors", "aov", "cvr", "engage", "quizcvr"];
      var usd = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 });
      var num = new Intl.NumberFormat("en-US", { maximumFractionDigits: 0 });
      function clamp(el, v) {
        var min = parseFloat(el.min), max = parseFloat(el.max);
        if (!isNaN(min) && v < min) v = min;
        if (!isNaN(max) && v > max) v = max;
        return v;
      }
      function val(id) {
        var el = document.getElementById(id);
        var v = parseFloat(el.value);
        return isNaN(v) ? 0 : v;
      }
      function set(id, v) {
        var t = document.getElementById(id);
        if (t) t.textContent = v;
      }
      // Quiz takers convert at a fixed multiple of a normal store. The sector
      // benchmark is that rate measured at a 2% reference store (5.5% = 2.75x,
      // 3.6% = 1.8x, ...). Express the quiz-taker rate as that same multiple
      // applied to the merchant's OWN rate, but never below the 2% reference, so
      // even a high-converting store still sees a lift instead of a flat $0. The
      // multiple is always >= 1.8, so the result always clears the current rate.
      var sectorBenchmark = 5.5;
      function quizFloor() {
        return Math.round(sectorBenchmark * Math.max(2, val("cvr")) / 2 * 10) / 10;
      }
      function setQuizCvr(v) {
        var n = document.getElementById("quizcvr"), r = document.getElementById("quizcvr-range");
        if (!n) return;
        v = Math.min(v, parseFloat(n.max));
        n.value = v;
        if (r) r.value = clamp(r, v);
      }
      // Raising the current rate lifts the quiz rate to keep the multiple; it
      // never lowers a manual edit the merchant made above the floor.
      function ensureBoost() {
        var f = quizFloor();
        if (val("quizcvr") < f) setQuizCvr(f);
      }
      // Keep the quiz-rate helper note truthful as the rate changes. At the
      // benchmark it's the pre-filled RevenueHunt figure; once the merchant edits
      // it off the benchmark it's their own value (the reset link gets them back).
      function syncNotes() {
        var qc = val("quizcvr");
        if (qc <= 0) return;
        var oneIn = Math.round(100 / qc);
        var bench = quizFloor();
        if (Math.abs(qc - bench) <= 0.05) {
          set("quizcvr-note", "Förifyllt med RevenueHunt-data: omkring 1 av " + oneIn + " personer som gör quizet gör en beställning. Redigera det så att det matchar din butik.");
        } else {
          var d = Math.round((qc / bench - 1) * 100);
          var rel = d >= 0 ? d + "% över" : Math.abs(d) + "% under";
          set("quizcvr-note", "Ditt värde: omkring 1 av " + oneIn + " personer som gör quizet gör en beställning. Det är " + rel + " den genomsnittliga konverteringsgraden för quizet.");
        }
      }
      // Only show the reset link when the quiz rate is off its data value — i.e.
      // the merchant edited it, or lowered their current rate so it sits above
      // the benchmark. At the data value there is nothing to reset.
      function syncReset() {
        var btn = document.getElementById("quizcvr-reset");
        if (btn) btn.classList.toggle("hidden", Math.abs(val("quizcvr") - quizFloor()) <= 0.05);
      }
      function calc() {
        syncNotes();
        syncReset();
        var V = val("visitors"), A = val("aov"), c = val("cvr") / 100, q = val("engage") / 100, qc = val("quizcvr") / 100, lift = val("aovlift") / 100;
        var takers = V * q;
        var quizOrders = takers * qc;
        var extraOrders = Math.max(0, takers * (qc - c));
        // Quiz orders carry a within-store AOV uplift; non-quiz baseline does not.
        // Extra = quiz-taker revenue with the quiz, minus what those same takers
        // would do at the site rate. With lift = 0 this is the old (qc - c) * A.
        var quizAov = A * (1 + lift);
        var extra = Math.max(0, quizOrders * quizAov - takers * c * A);
        var baseline = V * c * A;
        set("out-monthly", usd.format(extra));
        set("out-annual", usd.format(extra * 12));
        set("out-orders", num.format(extraOrders));
        set("out-takers", num.format(takers));
        set("out-quizorders", num.format(quizOrders));
        set("out-baseline", usd.format(baseline));
        set("out-withquiz", usd.format(baseline + extra));

        // Recommended plan (by monthly quiz responses) + cost + ROI.
        // Tiers mirror /pricing/ (lib/plans.ts).
        var responses = takers;
        // Anything above the Premium tier (2,500/mo) lands on the Unlimited Plan
        // at $299/mo with no response cap, so the ROI is computed off $299.
        var PLANS = [
          { name: "Free Plan", limit: 100, cost: 0 },
          { name: "Basic Plan", limit: 500, cost: 39 },
          { name: "Pro Plan", limit: 1000, cost: 99 },
          { name: "Premium Plan", limit: 2500, cost: 199 },
          { name: "Unlimited Plan", limit: Infinity, cost: 299, unlimited: true },
        ];
        var plan = PLANS[0];
        for (var i = 0; i < PLANS.length; i++) {
          if (responses <= PLANS[i].limit) { plan = PLANS[i]; break; }
        }
        set("out-responses", num.format(responses));
        if (plan.cost === 0) {
          set("out-plan", plan.name);
          set("out-plancost", "Gratis");
          set("out-roi", extra > 0 ? "Ren vinst" : "-");
          set("out-net", extra > 0 ? "+" + usd.format(extra) + " / mån, ingen kostnad" : "");
          set("plan-note", "Cirka " + num.format(responses) + " quizsvar per månad ryms i gratisplanen (100 svar), så de uppskattade " + usd.format(extra) + " per månad i extra intäkter kostar dig ingenting.");
        } else {
          var roi = extra / plan.cost;
          var net = extra - plan.cost;
          set("out-plan", plan.name);
          set("out-plancost", "$" + plan.cost + " / mån");
          set("out-roi", extra > 0 ? (roi >= 10 ? Math.round(roi) + "x" : roi.toFixed(1) + "x") : "-");
          set("out-net", extra > 0 ? (usd.format(extra) + " i intäkter minus " + usd.format(plan.cost) + " för planen = " + usd.format(net) + "/mån netto") : "");
          if (extra <= 0) {
            set("plan-note", "Sätt quizets konverteringsgrad över din webbplats nuvarande konverteringsgrad för att se en avkastning. " + plan.name + " ($" + plan.cost + "/mån) täcker " + (plan.unlimited ? "obegränsade svar." : "cirka " + num.format(responses) + " svar per månad."));
          } else {
            var fit = plan.unlimited
              ? "Cirka " + num.format(responses) + " quizsvar per månad placerar dig på " + plan.name + " för $" + plan.cost + " per månad, med obegränsade svar."
              : "Cirka " + num.format(responses) + " quizsvar per månad ryms i " + plan.name + " för $" + plan.cost + " per månad.";
            set("plan-note", fit + " De uppskattade " + usd.format(extra) + " per månad i extra intäkter är ungefär " + (roi >= 10 ? Math.round(roi) : roi.toFixed(1)) + "x plankostnaden.");
          }
        }
      }
      KEYS.forEach(function (k) {
        var n = document.getElementById(k);
        var r = document.getElementById(k + "-range");
        if (!n || !r) return;
        n.addEventListener("input", function () { r.value = clamp(n, val(k)); if (k === "cvr") ensureBoost(); calc(); });
        r.addEventListener("input", function () { n.value = r.value; if (k === "cvr") ensureBoost(); calc(); });
      });
      // Sector selector: pre-fill the quiz rate + AOV uplift from the chosen
      // sector and recompute everything. Unselected stays "All sectors" (275%).
      var sector = document.getElementById("sector");
      function applySector() {
        var o = sector.options[sector.selectedIndex];
        var qc = o.getAttribute("data-quizcvr");
        var lift = o.getAttribute("data-aovlift");
        var pct = o.getAttribute("data-pct");
        function put(id, v) {
          var n = document.getElementById(id), r = document.getElementById(id + "-range");
          if (n) n.value = v;
          if (r) r.value = clamp(r, parseFloat(v));
        }
        sectorBenchmark = parseFloat(qc) || sectorBenchmark;
        // Reset the current rate to its default first, so the quiz rate lands on
        // the sector's published benchmark (5.5%, 3.6%, ...) rather than scaling
        // off whatever the merchant had dragged the current rate to.
        var cvrEl = document.getElementById("cvr");
        if (cvrEl) put("cvr", cvrEl.defaultValue);
        setQuizCvr(quizFloor());
        put("aovlift", lift);
        var liftN = parseFloat(lift) || 0;
        var aovPart = liftN > 0 ? " och gör beställningar som är omkring " + liftN + "% större" : "";
        if (o.value === "all") {
          set("sector-note", "I RevenueHunts quizdata konverterar de som gör quizet till cirka " + pct + "% av den genomsnittliga butiken" + aovPart + ". Välj din sektor för en mer exakt benchmark.");
        } else {
          set("sector-note", "De som gör quizet inom " + o.text + " konverterar till cirka " + pct + "% av den genomsnittliga butiken" + aovPart + ", uppmätt i RevenueHunt-data.");
        }
        calc();
      }
      if (sector) sector.addEventListener("change", applySector);
      // Reset link: restore the quiz-taker rate to the RevenueHunt benchmark for
      // the current sector and store rate, in case the merchant dragged it away.
      var quizReset = document.getElementById("quizcvr-reset");
      if (quizReset) quizReset.addEventListener("click", function () { setQuizCvr(quizFloor()); calc(); });
      calc();
    })();
  </script>
</Base>
