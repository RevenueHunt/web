---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb, article, faqPage } from "../../../lib/schema";
import { SITE } from "../../../lib/site";
import { localizedHref } from "../../../lib/i18n";
import {
  REPORT,
  DATASET,
  HEADLINE,
  VERTICAL_CONVERSION,
  AOV_UPLIFT,
  ATTRIBUTION,
  BASELINES,
  METHODOLOGY,
  FAQ,
} from "../../../lib/quiz-benchmarks";

const pageUrl = new URL(`/${REPORT.slug}/`, SITE.site_url).href;
const ogImage = `/og/${REPORT.slug}.png`;

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=state_of_product_quizzes";
// Free WordPress.org plugin (not the WooCommerce.com extension).
const WOO_PLUGIN =
  "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";

const formatN = (n: number | null) =>
  n === null ? "" : n.toLocaleString("en-US");

// Conversion expressed against a typical 2% store: 6.9% / 2% = 345%.
const boost = (rate: number) => Math.round((rate / HEADLINE.baselinePct) * 100);

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Hem", url: localizedHref("/", "sv") },
    { name: "Läget för produktrekommendationsquiz", url: localizedHref(`/${REPORT.slug}/`, "sv") },
  ]),
  article({
    title: `${REPORT.title}: ${REPORT.subtitle}`,
    description: REPORT.description,
    url: pageUrl,
    image: ogImage,
    datePublished: REPORT.datePublished,
    dateModified: REPORT.dateModified,
    author: "RevenueHunt",
    tags: [
      "produktrekommendationsquiz benchmark",
      "quiz conversion rate",
      "ecommerce personalization",
      "average order value",
    ],
  }),
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "RevenueHunt produktrekommendationsquiz benchmarks 2026",
    description: REPORT.description,
    url: pageUrl,
    creator: organization(),
    license: "https://creativecommons.org/licenses/by/4.0/",
    isAccessibleForFree: true,
    datePublished: REPORT.datePublished,
    keywords: [
      "produktrekommendationsquiz",
      "conversion rate",
      "average order value",
      "ecommerce",
      "Shopify",
    ],
    distribution: {
      "@type": "DataDownload",
      encodingFormat: "application/pdf",
      contentUrl: new URL(REPORT.pdfPath, SITE.site_url).href,
    },
  },
  faqPage(FAQ),
];

const publishedLabel = new Date(REPORT.datePublished).toLocaleDateString("sv-SE", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const consumable = VERTICAL_CONVERSION.filter((r) => r.kind === "consumable");
const considered = VERTICAL_CONVERSION.filter((r) => r.kind === "considered");
const grouped = VERTICAL_CONVERSION.find((r) => r.kind === "grouped")!;
const pooled = VERTICAL_CONVERSION.find((r) => r.kind === "total")!;
---

<Base
  title={`${REPORT.title}: ${REPORT.subtitle}`}
  description={REPORT.description}
  ogImage={ogImage}
  jsonLd={jsonLd}
  lang="sv"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={localizedHref("/", "sv")} class="hover:text-slate-700">Hem</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Läget för produktrekommendationsquiz</span>
      </nav>
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">
          Benchmarkrapport · {publishedLabel}
        </p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          Läget för produktrekommendationsquiz
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          1 av 18 köpare som slutför ett produktrekommendationsquiz gör en beställning, <strong>2,75 gånger mer än en typisk onlinebutik</strong>. Den här rapporten bryter ner vilka kategorier som konverterar mest, hur mycket mer quizköparna spenderar och hur länge ett enda quiz fortsätter att ge avkastning. Baserat på verkliga data från <strong>{DATASET.responses} quizsvar</strong> i {DATASET.brands} butiker.
        </p>
        {/* TODO: restore hero CTAs ("Download the PDF" + "Read the findings")
            once a peer reviews the PDF design. Removed 2026-06-08 to hold the
            PDF download until that review. The PDF is still generated and the
            "Cite this report" section's download link is also held (see below). */}
      </div>
    </div>
  </section>

  <!-- Dataset band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-2xl bg-[#16161D] px-6 py-10 sm:px-10">
        <p class="text-center text-sm font-semibold uppercase tracking-wider text-white/50">
          Datamängden
        </p>
        <dl class="mt-6 grid grid-cols-1 gap-8 text-center sm:grid-cols-3">
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.responses}</dt>
            <dd class="mt-1 text-sm text-white/70">{DATASET.responsesNote}</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.revenue}</dt>
            <dd class="mt-1 text-sm text-white/70">{DATASET.revenueNote}</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{DATASET.brands}</dt>
            <dd class="mt-1 text-sm text-white/70">{DATASET.brandsNote}</dd>
          </div>
        </dl>
        <p class="mx-auto mt-6 max-w-3xl text-center text-sm text-white/60">
          Aggregerat och anonymiserat, över {DATASET.platforms}. Ingen enskild butik är identifierbar. Varje siffra nedan är ett minimum: attributionen ackumuleras fortfarande, så de verkliga siffrorna är högre.
        </p>
      </div>
    </div>
  </section>

  <!-- Key findings (stat cards) -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">De viktigaste siffrorna</h2>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">{HEADLINE.completedConv}%</p>
          <p class="mt-2 font-medium text-slate-900">av köparna som slutför ett quiz gör en beställning</p>
          <p class="mt-2 text-sm text-slate-600">Omkring 1 av {HEADLINE.completedOneIn}, ungefär {HEADLINE.multiple} gånger en typisk butik på {HEADLINE.baselinePct}%.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">+{AOV_UPLIFT.headlineLow}-{AOV_UPLIFT.headlineHigh}%</p>
          <p class="mt-2 font-medium text-slate-900">högre average order value, inom samma butik</p>
          <p class="mt-2 text-sm text-slate-600">Uppmätt på ett likvärdigt sätt, närvarande i ungefär 7 av 10 butiker.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">{HEADLINE.completionRate}%</p>
          <p class="mt-2 font-medium text-slate-900">av köparna som börjar ett quiz slutför det</p>
          <p class="mt-2 text-sm text-slate-600">Omkring 7 av 10 når resultatsidan. {HEADLINE.abandonRate}% hoppar av tidigare.</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-7">
          <p class="text-4xl font-bold tracking-tight text-[#16161D]">1 av 5</p>
          <p class="mt-2 font-medium text-slate-900">beställningar som tillskrivs quizet kommer mer än 30 dagar senare</p>
          <p class="mt-2 text-sm text-slate-600">Quizet fortsätter att generera intäkter i månader efter att det gjorts.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Conversion by category -->
  <section id="conversion" class="scroll-mt-20 bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Konvertering per kategori</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        Plattformsgenomsnittet döljer en stor spridning. <strong>Förbruknings- och påfyllningskategorier konverterar två till tre gånger mer</strong> än den genomsnittliga onlinebutiken. Köp med högt pris och hög övervägning konverterar en storleksordning lägre: där driver quizet upptäckt, men försäljningen kommer senare, utanför sessionen.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">Kategori</th>
              <th class="py-3 pr-4 text-right font-semibold">Konvertering</th>
              <th class="py-3 pr-4 text-right font-semibold">Quizets konverteringsökning</th>
              <th class="py-3 text-right font-semibold">Svar</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {consumable.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{r.rate}%</td>
                <td class="py-3 pr-4 text-right tabular-nums text-slate-600">{boost(r.rate)}%</td>
                <td class="py-3 text-right tabular-nums text-slate-500">{formatN(r.n)}</td>
              </tr>
            ))}
            {considered.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{r.rate}%</td>
                <td class="py-3 pr-4 text-right tabular-nums text-slate-600">{boost(r.rate)}%</td>
                <td class="py-3 text-right tabular-nums text-slate-500">{formatN(r.n)}</td>
              </tr>
            ))}
            <tr class="border-b border-slate-200">
              <td class="py-3 pr-4 font-medium">{grouped.vertical}</td>
              <td class="py-3 pr-4 text-right font-semibold tabular-nums">~{grouped.rate}%</td>
              <td class="py-3 pr-4 text-right tabular-nums text-slate-600">~{boost(grouped.rate)}%</td>
              <td class="py-3 text-right tabular-nums text-slate-500">{formatN(grouped.n)}</td>
            </tr>
            <tr class="border-t-2 border-slate-300">
              <td class="py-3 pr-4 font-semibold">{pooled.vertical}</td>
              <td class="py-3 pr-4 text-right font-bold tabular-nums">{pooled.rate}%</td>
              <td class="py-3 pr-4 text-right font-bold tabular-nums text-slate-600">{boost(pooled.rate)}%</td>
              <td class="py-3 text-right tabular-nums text-slate-500">alla</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        {grouped.note}
      </p>
      <p class="mx-auto mt-2 max-w-3xl text-sm text-slate-500 text-center">
        {pooled.note}
      </p>
    </div>
  </section>

  <!-- AOV uplift -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Spenderar quizköparna mer?</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        <strong>Uppmätt inom samma butik</strong> är quizbeställningar <strong>{AOV_UPLIFT.headlineLow}% till {AOV_UPLIFT.headlineHigh}% större</strong> än beställningar utan quiz, och det håller i {AOV_UPLIFT.storesUpLow}% till {AOV_UPLIFT.storesUpHigh}% av butikerna. Det är inte universellt: starkare där quizet kan sätta ihop ett set eller en rutin, nästan oförändrat där köpet är en enda artikel.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">Kategori</th>
              <th class="py-3 pr-4 text-right font-semibold">AOV-ökning inom butiken</th>
              <th class="py-3 text-right font-semibold">Butiker med en ökning</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {AOV_UPLIFT.perVertical.map((r) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">{r.vertical}</td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">
                  {r.uplift === null ? "Oförändrat" : `+${r.uplift}%`}
                </td>
                <td class="py-3 text-right tabular-nums text-slate-500">
                  {r.storesUp === null ? "saknas" : `${r.storesUp}%`}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        Uppmätt inom butiken (samma butik, quizbeställningar mot beställningar utan quiz), så det är robust mot valuta och kontrollerar för butiksmixen. Triangulerat mellan tre oberoende stickprov med en median på +11%, +15% och +14%. Kategorier med små stickprov utelämnas i stället för att överdrivas.
      </p>
    </div>
  </section>

  <!-- Attribution / LTV -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Ett quiz fortsätter att ge avkastning efter sessionen</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        De flesta attributionsdashboards bedömer ett quiz utifrån samma dags beställningar och stannar där. Det missar merparten av värdet. <strong>{ATTRIBUTION.sameDay}% av de första beställningarna som tillskrivs quizet sker samma dag</strong>, men svansen är lång.
      </p>
      <div class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-4">
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.sameDay}%</p>
          <p class="mt-1 text-sm text-slate-600">samma dag</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.within7}%</p>
          <p class="mt-1 text-sm text-slate-600">inom 7 dagar</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">{ATTRIBUTION.within30}%</p>
          <p class="mt-1 text-sm text-slate-600">inom 30 dagar</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 text-center">
          <p class="text-3xl font-bold text-[#16161D]">1 av 5</p>
          <p class="mt-1 text-sm text-slate-600">kommer mer än 30 dagar senare</p>
        </div>
      </div>
      <p class="mx-auto mt-6 max-w-3xl text-slate-700 text-center">
        Omkring <strong>1 av 5 av alla beställningar som tillskrivs quizet kommer mer än 30 dagar efter quizet</strong>. Quizet är inte bara en knuff mot kassan: varje svar är zero-party data som taggar köparen och matar segmenterade uppföljningsflöden och retargeting. <a href="https://www.klaviyo.com/marketing-resources/segmentation-benchmark-report" target="_blank" rel="external noopener nofollow" class="font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]">Segmenterade kampanjer genererar mer än 3 gånger intäkterna per mottagare</a> jämfört med generiska utskick, så ett enda quiz fortsätter att konvertera via e-post och personliga annonser i månader.
      </p>
    </div>
  </section>

  <!-- Baseline context -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Vad som räknas som "den genomsnittliga butiken"</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        Det finns ingen enda sann siffra för konvertering inom ehandel: den varierar med metodik och stickprov. Det ärliga intervallet är ungefär 1,6% till 2,9%. Vi benchmarkar mot runda <strong>{HEADLINE.baselinePct}%</strong>, den konservativa låga änden, vilket placerar de som gör quizet på omkring <strong>{HEADLINE.multiple} gånger</strong> den genomsnittliga butiken.
      </p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <thead>
            <tr class="border-b border-slate-300 text-sm text-slate-500">
              <th class="py-3 pr-4 font-semibold">Källa</th>
              <th class="py-3 pr-4 text-right font-semibold">Genomsnittlig konvertering</th>
              <th class="py-3 font-semibold">Omfattning</th>
            </tr>
          </thead>
          <tbody class="text-slate-900">
            {BASELINES.map((b) => (
              <tr class="border-b border-slate-200">
                <td class="py-3 pr-4 font-medium">
                  <a href={b.href} target="_blank" rel="external noopener nofollow" class="text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-slate-500">{b.source}</a>
                </td>
                <td class="py-3 pr-4 text-right font-semibold tabular-nums">{b.rate}</td>
                <td class="py-3 text-sm text-slate-600">{b.scope}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mx-auto mt-4 max-w-3xl text-sm text-slate-500 text-center">
        Viktigt: våra 5,5% är en grad per person som gör quizet (beställningar per slutfört quiz), medan varje siffra ovan är en grad för hela webbplatsen (beställningar per besökare). De som gör quizet självväljer, så en del av skillnaden är tratten, inte bara quizet. Vi presenterar jämförelsen rakt på sak i stället för att försköna den.
      </p>
    </div>
  </section>

  <!-- Methodology -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Metodik</h2>
      <ul class="mt-8 space-y-5" role="list">
        {METHODOLOGY.map((m) => (
          <li class="flex gap-3">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400" aria-hidden="true"></span>
            <p class="text-slate-700">{m}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Vanliga frågor</h2>
      <div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
        {FAQ.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-lg font-semibold text-slate-900 [&::-webkit-details-marker]:hidden">
              <span>{f.question}</span>
              <svg
                class="h-5 w-5 flex-shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <p class="pb-5 text-slate-700" set:html={f.answerHtml ?? f.answer} />
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* TODO: restore the entire "Cite this report" section (PDF download +
      shareable stat-card links) once a designer reviews the report + PDF + card
      designs. Removed 2026-06-08 to hold the downloadable assets until review.
      The PDF and card PNGs are still generated by `bun run report`. */}

  <!-- Bottom CTA -->
  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Mät ökningen i din egen butik.
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-white/70">
        RevenueHunt är gratis att börja med, med 100 quizsvar per månad. Skapa ett quiz, skicka trafik genom det och läs dina egna siffror.
      </p>
      <p class="mx-auto mt-4 max-w-2xl text-white/60">
        Se vad dessa benchmarks kan summera till för din butik med vår <a href={localizedHref("/quiz-roi-calculator/", "sv")} class="font-medium text-white underline decoration-white/40 underline-offset-2 hover:decoration-white">ROI-kalkylator för quiz</a>.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={SHOPIFY_INSTALL}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >
          kom igång gratis på Shopify
        </a>
        <a
          href={WOO_PLUGIN}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >
          kom igång gratis på WooCommerce
        </a>
      </div>
    </div>
  </section>
</Base>
