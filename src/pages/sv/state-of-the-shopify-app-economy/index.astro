---
import Base from "../../../layouts/Base.astro";
import { organization, breadcrumb, article, faqPage } from "../../../lib/schema";
import { SITE } from "../../../lib/site";
import { localizedHref } from "../../../lib/i18n";
import {
  REPORT,
  SOURCE,
  HEADLINE,
  GROWTH,
  REVIEWS,
  REVENUE,
  PRICING,
  GEOGRAPHY,
  QUIZ_LANE,
} from "../../../lib/app-economy";

const pageUrl = new URL(`/sv/${REPORT.slug}/`, SITE.site_url).href;
const ogImage = `/og/${REPORT.slug}.png`;

const publishedLabel = new Date(REPORT.datePublished).toLocaleDateString("sv-SE", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const title = "Läget för Shopifys app-ekonomi";
const description =
  "Det finns 22 546 aktiva appar i Shopify App Store, och nästan ingen av dem kommer någonstans. En datarapport om tillväxt, recensioner, intäktskoncentration, priser och vilka som bygger dem, baserad på en ögonblicksbild av varenda aktiv app.";

// Metodik + Vanliga frågor, översatta. Inledningssatsen i varje metodiknotis
// är fetstilad inline (den engelska källan fetstilade den via en stränger-
// sättning, som inte kan matcha översatt text). Definieras före jsonLd så att
// faqPage(FAQ) kan använda den.
const METHODOLOGY = [
  "<strong>Källa:</strong> en ögonblicksbild av den offentliga Shopify App Store, 22 546 aktiva appannonser, tagen i juni 2026. Varje fält kommer från den offentliga annonseringen, inte från Shopifys interna data eller någon handlares konto.",
  "<strong>Intäkterna är uppskattade, inte uppmätta.</strong> De är modellerade utifrån varje apps publicerade prisnivåer tillsammans med recensions- och installationssignaler. Behandla intäktssiffrorna som en riktningsgivande modell över hur koncentrerade intäkterna är, inte som faktureringsdata. De är märkta som \"uppskattade\" överallt där de förekommer.",
  "<strong>Tillväxten utgår från varje annonserings publicerade lanseringsdatum.</strong> Källan samlade ungefär 2 800 lanseringsdatum i maj 2026, så kurvan läses som ackumulerade aktiva appar per år (slutpunkten är den verkliga aktuella totalen), och siffran \"6 000+ under de senaste 12 månaderna\" rensar bort den enskilda månadens artefakt.",
  "<strong>Recensioner är en proxy för genomslag</strong>, inte en perfekt sådan: en bra app kan vara ny, och antalet recensioner släpar efter den verkliga användningen. Vi använder dem eftersom de är den tydligaste offentliga, jämförbara signalen på en verklig handlarbas över 22 546 appar.",
  "Kategorier i App Store är funktionstaggar som en app kan tillämpa på sig själv, och många appar bär flera eller inga, så vi rapporterar de snitt som är entydiga (recensioner, priser, lanseringsdatum, utvecklarland) och undviker att övertolka taggtaxonomin.",
];

const FAQ = [
  {
    question: "Hur många appar finns i Shopify App Store?",
    answer:
      "22 546 aktiva appar i den här ögonblicksbilden från juni 2026. Butiken har vuxit ungefär tiodubbelt sedan 2020 och lagt till över 6 000 appar bara under de senaste 12 månaderna, ungefär 1 av 4 av allt som är aktivt i dag. AI-assisterad utveckling förvandlade det som förut var ett halvårsbygge till en helg.",
  },
  {
    question: "Varför misslyckas de flesta Shopify-appar?",
    answer:
      "Att bygga är inte längre begränsningen, så butiken översvämmas av appar som aldrig hittar en handlarbas. 51 % har noll recensioner och 81 % har färre än 10. Det som är sällsynt är distribution och förtroende: att svara på support, att förtjäna recensioner en handlare i taget, att finnas där i åratal. Det är den delen AI inte kan göra åt dig.",
  },
  {
    question: "Hur mycket tjänar Shopify-appar?",
    answer:
      "Intäkterna är extremt koncentrerade. Enligt vår uppskattning tar den översta 1 % av apparna (225 av dem) ungefär 72 % av alla appintäkter, och bara de 10 främsta tar nästan 30 %. Bara omkring 36 % av apparna verkar tjäna något alls. Intäkterna här är uppskattade utifrån offentliga priser och användningssignaler, inte faktureringsdata.",
  },
  {
    question: "Är de flesta Shopify-appar gratis?",
    answer:
      "I praktiken, ja. 46,9 % är gratis och ytterligare 48,6 % inleder med en gratis provperiod; bara 4,5 % tar betalt i förväg. Nästan 45 % erbjuder en permanent gratisnivå. I Shopify App Store är en gratis ingångspunkt inte en tillväxttaktik, det är grundförväntningen.",
  },
  {
    question: "Var kan jag se den underliggande datan?",
    answer:
      "Den här rapporten är den datafullständiga följeslagaren till vår fältanteckning på LinkedIn om app-ekonomin. Siffrorna kommer från en ögonblicksbild vi håller av varenda aktiv Shopify-app: lanseringsdatum, recensioner, priser, märket Built for Shopify och utvecklarland. Om du bygger på Shopify och vill ha ett specifikt snitt, hör av dig.",
    answerHtml:
      "Den här rapporten är den datafullständiga följeslagaren till vår fältanteckning på LinkedIn om app-ekonomin. Siffrorna kommer från en ögonblicksbild vi håller av varenda aktiv Shopify-app: lanseringsdatum, recensioner, priser, märket Built for Shopify och utvecklarland. Om du bygger på Shopify och vill ha ett specifikt snitt, <a href=\"/sv/contact/\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">hör av dig</a>.",
  },
];

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Hem", url: localizedHref("/", "sv") },
    { name: title, url: localizedHref(`/${REPORT.slug}/`, "sv") },
  ]),
  article({
    title,
    description,
    url: pageUrl,
    image: ogImage,
    datePublished: REPORT.datePublished,
    dateModified: REPORT.dateModified,
    author: "RevenueHunt",
    tags: [
      "Shopify app store",
      "Shopify-apputvecklare",
      "app store-statistik",
      "app-ekonomi",
    ],
  }),
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "Läget för Shopifys app-ekonomi 2026",
    description,
    url: pageUrl,
    creator: organization(),
    license: "https://creativecommons.org/licenses/by/4.0/",
    isAccessibleForFree: true,
    datePublished: REPORT.datePublished,
    keywords: [
      "Shopify app store",
      "apputvecklare",
      "appintäkter",
      "apprecensioner",
      "ecommerce",
    ],
  },
  faqPage(FAQ),
];

// Section eyebrows for the editorial "field notes" feel.
const E = (n: string, label: string) => `${n} · ${label}`;

// Translated headline cards. Stats stay from the shared data module (HEADLINE[i].stat).
const headlineT = [
  { label: "aktiva appar i butiken", note: "Ungefär tiodubblat sedan 2020." },
  { label: "har ingen enda recension", note: "Fyra av fem har färre än 10." },
  { label: "av intäkterna tas av den översta 1 %", note: "225 appar. Uppskattat." },
  { label: "tar betalt i förväg", note: "Bara 1 av 20. Nästan hälften är gratis." },
];

// Growth caption with the lead phrase bolded.
const growthCaptionHtml =
  "Aktiva appar ackumulerade per lanseringsår. <strong>Shopify App Store har ungefär tiodubblats sedan 2020</strong> och har lagt till över 6 000 appar bara under de senaste 12 månaderna, ungefär 1 av 4 av allt som är aktivt i dag.";

// Quiz-lane paragraphs (translated), with the live search link and the load-bearing
// lines bolded inline. Caption text mirrors the English source's meaning.
const quizParas = [
  `Vår egen kategori bevisar samma sak. <a href="${QUIZ_LANE.searchUrl}" target="_blank" rel="external noopener nofollow" class="font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]">sökningen efter quiz på Shopify</a> ger 149 appar, men här samlas förtroendet i toppen precis som i hela butiken. De tre appar som kom först och aldrig försvann, RevenueHunt, Octane AI och Quiz Kit, står för 45 % av alla recensioner i kategorin; <strong>RevenueHunt ensam har ungefär en fjärdedel</strong>, och den nedre halvan har ingen alls.`,
  `Vi nådde toppen inte genom kod. <strong>Recensioner är resterna av den operativa ärrvävnad</strong> som ligger bakom: sex år av att svara på support, att lyfta luren med handlare som aldrig skulle betala och att förtjäna förtroende butik för butik. Octane AI och Quiz Kit gjorde samma hårda jobb i åratal, <strong>och det respekterar vi dem för</strong>. Ett hedersomnämnande till Lantern och Quizell, båda med drygt 120 recensioner.`,
];

// Methodology bullets carry their own inline <strong>; render as-is.
const methodologyHtml = METHODOLOGY;
---

<Base
  title={`${title} - datarapport 2026`}
  description={description}
  ogImage={ogImage}
  jsonLd={jsonLd}
  lang="sv"
  translated={true}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href={localizedHref("/", "sv")} class="hover:text-slate-700">Hem</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">Läget för Shopifys app-ekonomi</span>
      </nav>
      <div class="text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">
          Fältanteckningar · {publishedLabel}
        </p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          Läget för Shopifys app-ekonomi
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
          <strong>Det finns 22 546 aktiva appar i Shopify App Store, och nästan ingen av dem kommer någonstans.</strong> Vi tog en ögonblicksbild av varenda aktiv app och läste sedan av datan om tillväxt, recensioner, intäkter, priser och vilka som bygger dem. De berättar en enda historia: att bygga appen var aldrig den svåra delen.
        </p>
      </div>
    </div>
  </section>

  <!-- Source band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-2xl bg-[#16161D] px-6 py-10 sm:px-10">
        <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#4dcaff]">
          Ögonblicksbilden
        </p>
        <dl class="mt-6 grid grid-cols-2 gap-8 text-center sm:grid-cols-4">
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.apps}</dt>
            <dd class="mt-1 text-sm text-white/70">aktiva appar i ögonblicksbilden</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.countries}</dt>
            <dd class="mt-1 text-sm text-white/70">länder som bygger dem</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.reviewless}</dt>
            <dd class="mt-1 text-sm text-white/70">utan en enda recension</dd>
          </div>
          <div>
            <dt class="text-4xl font-bold tracking-tight text-white">{SOURCE.free}</dt>
            <dd class="mt-1 text-sm text-white/70">helt gratis, utan betalplan</dd>
          </div>
        </dl>
        <p class="mx-auto mt-6 max-w-3xl text-center text-sm text-white/60">
          Varje siffra nedan kommer från den offentliga annonseringen i App Store för alla 22 546 aktiva appar, juni 2026. Intäkterna uppskattas utifrån publicerade priser och användningssignaler, inte faktureringsdata, och märks som sådana genom hela rapporten.
        </p>
      </div>
    </div>
  </section>

  <!-- Headline cards -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Siffrorna i korthet</h2>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
        {HEADLINE.map((c, i) => (
          <div class="rounded-xl border border-slate-200 p-7">
            <p class="text-4xl font-bold tracking-tight text-[#16161D]">{c.stat}</p>
            <p class="mt-2 font-medium text-slate-900">{headlineT[i].label}</p>
            <p class="mt-2 text-sm text-slate-600">{headlineT[i].note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 01 Growth -->
  <section class="scroll-mt-20 bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("01", "Tillväxt")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Tiodubblat sedan 2020</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center" set:html={growthCaptionHtml} />
      <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
        <div class="h-72 sm:h-80"><canvas id="c-growth" aria-label="Aktiva Shopify-appar ackumulerade per år" role="img"></canvas></div>
      </div>
    </div>
  </section>

  <!-- 02 Traction -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("02", "Genomslag")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">De flesta appar får aldrig en recension</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">Hälften av Shopify App Store har aldrig fått en enda recension. Fyra av fem appar har färre än 10. En recension är den tydligaste offentliga indikatorn på en riktig och kvarhållen handlare, och de flesta appar får aldrig någon.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-center text-sm font-semibold text-slate-700">Appar efter antal recensioner</p>
          <div class="h-72 sm:h-80"><canvas id="c-reviews" aria-label="Recensionsfördelning bland alla aktiva appar" role="img"></canvas></div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">81%</p>
            <p class="mt-1 text-slate-700">har färre än 10 recensioner</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="font-bold text-[#16161D]"><span class="text-3xl">{REVIEWS.medianReviews}</span> <span class="text-sm font-medium text-slate-500">recensioner</span></p>
            <p class="mt-1 text-slate-700">medianen, bland de appar som har en</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="font-bold text-[#16161D]"><span class="text-amber-400">★</span> <span class="text-3xl">{REVIEWS.avgRating}</span> <span class="text-sm font-medium text-slate-500">stjärnor</span></p>
            <p class="mt-1 text-slate-700">snittbetyg, bland de {REVIEWS.ratedCount} appar som har ett</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 Revenue -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("03", "Intäkter · uppskattat")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Pengarna samlas allra högst upp</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">De uppskattade månadsintäkterna är brutalt koncentrerade i toppen. Den översta 1 % av apparna (225 av dem) tar uppskattningsvis 72 %, och bara 10 av dessa appar tar på egen hand nästan 30 % av alla appintäkter. (Och ett namn reser sig över hela ekosystemet: en app som drar uppskattningsvis 78 % av sin årsomsättning på runt 1 miljard dollar från handlare som också kör på Shopify. Ja, vi tittar på dig, <a href='https://www.sec.gov/Archives/edgar/data/1835830/000162828023030618/klaviyoincs-1.htm' target='_blank' rel='external noopener nofollow' class='font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]'>Klaviyo</a>.) Knappt 36 % av apparna verkar tjäna något alls. Den är också geografiskt koncentrerad: <strong>enbart USA och Kanada tar uppskattningsvis 57 %</strong> av intäkterna i Shopify App Store.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-sm font-medium text-slate-500">Intäktsfördelning</p>
          <div class="h-64 sm:h-72"><canvas id="c-revenue-donut" aria-label="Fördelning av de uppskattade intäkterna: de 10 främsta apparna, resten av topp 1% och de övriga 99%" role="img"></canvas></div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <p class="mb-3 text-sm font-medium text-slate-500">Uppskattad intäkt per land</p>
          <div class="h-64 sm:h-72"><canvas id="c-revenue-countries" aria-label="Uppskattad intäkt per land" role="img"></canvas></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 Pricing -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("04", "Priser")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Nästan ingen tar betalt i förväg</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">Nästan hälften av butiken tar inget betalt i förväg, och färre än 1 av 20 appar ber om pengar innan den första installationen. Nästan 45 % erbjuder en permanent gratisplan. Här är freemium inte en strategi, det är minimikravet för att ens vara med.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <div class="h-72 sm:h-80"><canvas id="c-pricing" aria-label="Fördelning av prismodeller bland alla aktiva appar" role="img"></canvas></div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">{PRICING.permanentFree}</p>
            <p class="mt-1 text-slate-700">erbjuder en permanent gratisplan, inte bara en provperiod</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">1 av 20</p>
            <p class="mt-1 text-slate-700">appar tar betalt innan den första installationen</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 Who builds them -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("05", "Vilka bygger dem")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Byggda i 115 länder, dominerade av två</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">Apparna kommer från 115 länder, men två dominerar: USA (16 %) och Indien (9 %) bygger tillsammans en fjärdedel av butiken. Och efter år av att Shopify drivit på standarden bär bara 6,7 % av de aktiva apparna (ungefär 1 500) märket Built for Shopify.</p>
      <div class="mt-8 grid items-center gap-8 lg:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-7">
          <div class="h-72 sm:h-80"><canvas id="c-geography" aria-label="Ledande utvecklarländer efter antal appar" role="img"></canvas></div>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">{GEOGRAPHY.builtForShopify}</p>
            <p class="mt-1 text-slate-700">bär märket Built for Shopify ({GEOGRAPHY.builtForShopifyCount} appar), år efter att Shopify började driva på standarden</p>
          </div>
          <div class="rounded-xl border border-slate-200 p-6">
            <p class="text-3xl font-bold text-[#16161D]">25%</p>
            <p class="mt-1 text-slate-700">av hela butiken byggs enbart i USA och Indien</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 The quiz lane -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-[#616eff]">{E("06", "Quiz-fållan")}</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 text-center">Vår egen kategori, på nära håll</h2>
      {quizParas.map((html) => (
        <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center" set:html={html} />
      ))}
      <div class="mx-auto mt-8 grid max-w-3xl grid-cols-3 gap-4 text-center">
        <a
          href="https://apps.shopify.com/product-recommendation-quiz-revenuehunt"
          target="_blank"
          rel="external noopener"
          class="block rounded-xl border border-[#616eff]/60 p-6 shadow-[0_0_28px_-4px_rgba(97,110,255,0.55)] transition hover:border-[#616eff] hover:shadow-[0_0_32px_-2px_rgba(97,110,255,0.7)]"
        >
          <p class="text-sm font-semibold text-slate-900">RevenueHunt</p>
          <p class="mt-1 font-bold text-[#16161D]"><span class="text-3xl">{QUIZ_LANE.revenueHuntReviews}</span> <span class="text-sm font-medium text-slate-500">recensioner</span></p>
          <p class="mt-1 text-xs font-semibold text-slate-600"><span class="text-amber-400">★</span> 4,9 stjärnor</p>
        </a>
        <div class="rounded-xl border border-slate-200 p-6">
          <p class="text-sm font-medium text-slate-700">Octane AI</p>
          <p class="mt-1 font-bold text-slate-500"><span class="text-3xl">{QUIZ_LANE.octaneReviews}</span> <span class="text-sm font-medium text-slate-500">recensioner</span></p>
          <p class="mt-1 text-xs font-semibold text-slate-600"><span class="text-amber-400">★</span> 4,8 stjärnor</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-6">
          <p class="text-sm font-medium text-slate-700">Quiz Kit</p>
