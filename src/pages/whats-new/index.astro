---
import { getCollection, getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { breadcrumb, organization } from "../../lib/schema";
import { SITE } from "../../lib/site";
import { postHref } from "../../lib/blog";

const intro = await getEntry("pages", "whats-new");
const { Content } = await render(intro!);

const updates = (
  await getCollection(
    "blog",
    ({ data }) => !data.draft && data.categories.includes("Product Updates"),
  )
).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Home", url: "/" },
    { name: intro!.data.title, url: "/whats-new/" },
  ]),
];

function fmt(d: Date) {
  return d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
}
---

<Base title={`${intro!.data.title} - ${SITE.name}`} description={intro!.data.description} jsonLd={jsonLd}>
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
      <nav class="mb-6 text-sm text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-slate-700">Home</a>
        <span class="mx-2 text-slate-300">/</span>
        <span class="text-slate-700">{intro!.data.title}</span>
      </nav>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">{intro!.data.title}</h1>
      {intro!.data.description && (
        <p class="mt-6 max-w-3xl text-xl text-slate-600">{intro!.data.description}</p>
      )}
    </div>
  </section>

  <main class="mx-auto max-w-4xl px-6 py-12 sm:py-16">
    <article class="prose prose-slate prose-lg max-w-none
      prose-headings:tracking-tight prose-headings:text-slate-900
      prose-h3:mt-10 prose-h3:text-xl prose-h3:font-semibold
      prose-p:text-slate-700
      prose-a:text-slate-900 prose-a:underline-offset-4 hover:prose-a:text-slate-700
      prose-strong:text-slate-900
      prose-li:my-1">
      <Content />
    </article>

    <section class="mt-16 border-t border-slate-200 pt-12">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900">Latest product updates</h2>
      <ul class="mt-8 divide-y divide-slate-200">
        {updates.map((post) => (
          <li>
            <a href={postHref(post)} class="group flex gap-6 py-6 sm:gap-8">
              {post.data.featuredImage ? (
                <div class="flex aspect-square h-32 w-32 flex-shrink-0 items-center justify-center overflow-hidden rounded-lg bg-slate-50 sm:h-40 sm:w-40">
                  <img src={post.data.featuredImage} alt="" loading="lazy" class="max-h-full max-w-full object-contain" />
                </div>
              ) : (
                <div class="aspect-square h-32 w-32 flex-shrink-0 rounded-lg bg-slate-100 sm:h-40 sm:w-40" />
              )}
              <div class="min-w-0 flex-1">
                <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">{fmt(post.data.pubDate)}</p>
                <h3 class="mt-2 text-xl font-semibold text-slate-900 group-hover:text-[#16161D]">{post.data.title}</h3>
                {post.data.description && (
                  <p class="mt-2 line-clamp-2 text-sm text-slate-600 sm:text-base">{post.data.description}</p>
                )}
                <span class="mt-3 inline-block text-sm font-semibold text-[#16161D]">Read more →</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>

  <section class="bg-[#16161D]">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-white/70">
        Most shoppers leave because they can't find the right product
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Turn shoppers into confident buyers with a Product Recommendation Quiz that drives sales.
      </h2>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a
          href="/demo/"
          class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-semibold text-[#16161D] transition hover:bg-slate-100"
        >Book a demo</a>
        <a
          href="/pricing/"
          class="inline-flex items-center justify-center rounded-md border border-white/30 bg-transparent px-6 py-3 text-base font-semibold text-white transition hover:border-white hover:bg-white/5"
        >See pricing</a>
      </div>
    </div>
  </section>
</Base>
