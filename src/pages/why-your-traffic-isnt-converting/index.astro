---
import Base from "../../layouts/Base.astro";
import { organization, breadcrumb } from "../../lib/schema";

const QUIZ_URL = "https://admin.revenuehunt.com/public/quiz/bqHVL09";

const jsonLd = [
  organization(),
  breadcrumb([
    { name: "Home", url: "/" },
    { name: "Why your traffic isn't converting", url: "/why-your-traffic-isnt-converting/" },
  ]),
];
---

<Base
  title="Why your traffic isn't converting — RevenueHunt"
  description="Running ads and email campaigns but conversions are flat? Take this 3-minute assessment to find out exactly what's blocking your funnel — and get a personalized plan to fix it."
  jsonLd={jsonLd}
>
  <section class="bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-3xl px-6 py-16 text-center sm:py-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">For ecommerce store owners</p>
      <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
        Why isn't your traffic converting?
      </h1>
      <p class="mt-6 text-lg text-slate-700">
        Running ads and sending email campaigns but the conversions just aren't there? It's almost never the traffic — it's the funnel. <strong class="text-slate-900">Find out what's blocking your conversions</strong> and get a personalized plan to fix it.
      </p>
      <p class="mt-4 text-sm text-slate-500">Takes 3 minutes · Instant results · Free</p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-16">
    <div class="rounded-2xl border border-slate-200 bg-white p-2 shadow-xl">
      <iframe
        src={QUIZ_URL}
        title="Conversion diagnostic quiz"
        loading="lazy"
        class="h-[640px] w-full rounded-xl"
      ></iframe>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 pb-20">
    <div class="grid gap-6 md:grid-cols-3">
      <div class="rounded-xl border border-slate-200 bg-white p-6">
        <div class="text-3xl" aria-hidden="true">📉</div>
        <h2 class="mt-3 font-semibold text-slate-900">Identify drop-off points</h2>
        <p class="mt-2 text-sm text-slate-600">Pinpoint where shoppers leave — landing page, product page, or checkout.</p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-6">
        <div class="text-3xl" aria-hidden="true">🎯</div>
        <h2 class="mt-3 font-semibold text-slate-900">Get a tailored plan</h2>
        <p class="mt-2 text-sm text-slate-600">Personalized fixes based on your store's setup and audience.</p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-6">
        <div class="text-3xl" aria-hidden="true">🚀</div>
        <h2 class="mt-3 font-semibold text-slate-900">See instant results</h2>
        <p class="mt-2 text-sm text-slate-600">Recommendations ranked by expected impact and effort.</p>
      </div>
    </div>
  </section>
</Base>
