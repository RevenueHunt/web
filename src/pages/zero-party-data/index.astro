---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { organization, breadcrumb, softwareApplication, article, faqPage } from "../../lib/schema";
import { SITE } from "../../lib/site";

const SHOPIFY_INSTALL =
  "https://apps.shopify.com/product-recommendation-quiz-revenuehunt/install?utm_source=revenuehunt.com&utm_medium=referral&utm_campaign=zero_party_data_landing";
const WOO_PLUGIN =
  "https://downloads.wordpress.org/plugin/product-recommendation-quiz-for-ecommerce.latest-stable.zip";

const PAGE_URL = new URL("/zero-party-data/", SITE.site_url).href;

const DATA_TYPES = [
  {
    name: "Zero-party",
    who: "You",
    how: "Customer volunteers it in exchange for value",
    example: '"My skin is sensitive. I\'m shopping for a gift."',
    accuracy: "Highest",
    accuracyColor: "text-emerald-600",
    rowBg: "bg-white",
  },
  {
    name: "First-party",
    who: "You",
    how: "Observed: site analytics, purchase history, CRM, email engagement",
    example: '"Visited 3 product pages, bought vitamin C serum 6 months ago"',
    accuracy: "High",
    accuracyColor: "text-emerald-600",
    rowBg: "bg-slate-50",
  },
  {
    name: "Second-party",
    who: "A partner brand",
    how: "Shared from a partner's first-party set via a direct agreement",
    example: "A co-marketing partner shares its newsletter list with you",
    accuracy: "Variable",
    accuracyColor: "text-amber-600",
    rowBg: "bg-white",
  },
  {
    name: "Third-party",
    who: "An intermediary you don't own",
    how: "Aggregated, inferred, or purchased from data brokers, ad networks, look-alike audiences",
    example: '"Females 25-34 likely interested in skincare" from an ad network',
    accuracy: "Lowest",
    accuracyColor: "text-red-600",
    rowBg: "bg-slate-50",
  },
];

const WHY_NOW = [
  {
    n: "01",
    title: "Third-party cookies are finally biting",
    body:
      "Safari and Firefox killed third-party cookies years ago. Chrome's rollout means cross-site behavioural targeting now reaches a fraction of audiences it used to. Look-alike audiences built on cookie graphs degrade weekly. The only durable replacement is data you own, and the highest-resolution version of that is zero-party.",
  },
  {
    n: "02",
    title: "AI personalisation needs structured inputs",
    body:
      "Generative recommendation, dynamic email content, and on-site AI assistants are only as good as the signals feeding them. A model that knows a shopper's stated skin type, primary concern, and budget produces dramatically better recommendations than one inferring those from clickstreams. Zero-party data is the cleanest training signal a model can get: explicit, structured, and labelled at the source.",
  },
  {
    n: "03",
    title: "Privacy regulation has hardened",
    body:
      "GDPR, CCPA, CPRA, Quebec's Law 25, the EU AI Act, and a growing list of state-level US laws share a common pattern: consent must be specific, withdrawable, and demonstrable. Zero-party data is collected with active consent by definition. The customer chose to share it; you can show when, what for, and with what value exchange. Inferred third-party data fails almost every one of those tests.",
  },
  {
    n: "04",
    title: "Acquisition costs keep rising",
    body:
      "With Meta and Google CPMs trending up and attribution windows shrinking, paid acquisition only works if you lift customer LTV. Personalisation is the lever. Personalisation that doesn't feel intrusive requires data the customer knowingly gave you. The math is structural: lift email RPR, repeat-purchase rate, or AOV by even 10% through better targeting, and you can outbid competitors for the same impression while keeping margin intact.",
  },
];

const PITFALLS = [
  {
    title: "Treating it as a one-off campaign",
    body:
      "Zero-party data is a stack-level capability, not a one-quarter project. The lift comes from feeding answers into every downstream system (ESP, ad platform, helpdesk, on-site) and refreshing the data on a cadence. A quiz launched once and never wired into Klaviyo loses most of its value.",
  },
  {
    title: "Asking for too much in one form",
    body:
      "A 20-question quiz with no clear payoff feels like a tax. Three to seven questions with a relevant recommendation at the end converts at 5-10x the rate. If you need more attributes, layer them across progressive profiling and post-purchase surveys instead.",
  },
  {
    title: "Collecting answers without consent linkage",
    body:
      "Capturing a preference is not the same as having permission to use it across channels. Make the consent ask explicit (email opt-in, marketing-purpose declaration) inside the same flow, and store the consent timestamp alongside the attribute so a regulator audit is trivial.",
  },
  {
    title: "Ignoring the activation half",
    body:
      "Stores routinely launch the collection mechanism and then leave the data sitting in a custom property nobody segments on. Wire each attribute to at least one segment, one flow, and one ad-platform audience the same week you ship the quiz.",
  },
];

const COLLECT = [
  {
    n: "1",
    title: "Product recommendation quizzes",
    line: "Highest yield per minute of customer attention.",
    body:
      "Three to seven diagnostic questions, a personalised result page, and the customer walks away with a recommendation while you walk away with a structured profile. Completion rates regularly exceed 40% on well-designed quizzes; every completion produces multiple preference attributes (skin type, concern, age range, budget, shopping-for, lifestyle) that map directly to email and ad platforms.",
    cta: { href: "/product-recommendation-quiz/", label: "See the quiz format" },
  },
  {
    n: "2",
    title: "Preference centres",
    line: "Retention layer on top of a quiz.",
    body:
      "A dedicated page or modal where existing subscribers can update what they want to hear about and how often. The data (channel preference, content topics, frequency, product categories) flows directly into your ESP. Lower conversion than quizzes for first-time visitors because the value exchange is weaker.",
  },
  {
    n: "3",
    title: "Loyalty and account programs",
    line: "Zero-party machines when designed well.",
    body:
      "Every points-earning interaction (review a product, share your birthday, complete your profile, take a survey) is a structured data point in exchange for redeemable value. The data is excellent but the cost-per-attribute is higher than a one-time quiz.",
  },
  {
    n: "4",
    title: "Post-purchase surveys",
    line: "Most under-used zero-party tool in DTC.",
    body:
      "A two-question post-purchase survey (\"How did you hear about us? What problem are you trying to solve?\") attaches answers directly to the order record. The customer has just received value (the order) and is in a brief window of high goodwill. Completion rates of 30-50% are common.",
  },
  {
    n: "5",
    title: "Smart forms and progressive profiling",
    line: "Long-tail enrichment after acquisition.",
    body:
      "Collect one or two pieces of preference data each time a customer interacts, not in one giant form. A shopper who books a virtual consultation, downloads a buying guide, or registers for a webinar contributes one new attribute per touchpoint.",
  },
  {
    n: "6",
    title: "Interactive content",
    line: "Data as a side effect of helping decide.",
    body:
      "Calculators, configurators, \"build your routine\" tools, and visual finders all collect zero-party data as a side effect of helping a shopper decide. The shopper inputs their bra size, room dimensions, or fitness goal to get a personalised output; you keep the input.",
  },
];

const ACTIVATE = [
  {
    title: "Email and SMS",
    line: "Fastest payback.",
    body:
      "Synced as custom properties in Klaviyo, Omnisend, or Mailchimp. Zero-party attributes power segmented welcome series, replenishment reminders, win-back flows, and dynamic content blocks inside otherwise generic campaigns.",
    href: "/klaviyo-zero-party-data/",
    hrefLabel: "Klaviyo zero-party data guide",
  },
  {
    title: "Paid ads",
    line: "Enriched custom audiences and look-alikes.",
    body:
      "A list of 8,000 customers tagged as \"sensitive skin, anti-aging concern, 35-44\" is dramatically more valuable as both a remarketing audience and a look-alike seed than a list of 80,000 untagged subscribers. The campaign-level gains compound through the ad platform's optimisation model.",
    href: "/make-your-facebook-ads-smarter-with-revenuehunts-quiz-integration/",
    hrefLabel: "Quiz integration for Meta ads",
  },
  {
    title: "On-site personalisation",
    line: "Drive collection ordering, hero swaps, PDP logic.",
    body:
      "Store a quiz attribute in a cookie or local-storage key and let your theme or a personalisation app read it on subsequent visits. Drives collection ordering, hero swaps, product recommendation feeds, and hide/show logic on PDPs.",
  },
  {
    title: "Customer service and post-purchase",
    line: "Surface answers inside tickets and emails.",
    body:
      "Surface quiz answers inside Shopify Orders, Gorgias tickets, and post-purchase emails so the human or automated message references what the customer already told you.",
    href: "/mark-orders-and-collect-zero-party-data-for-your-shopify-store/",
    hrefLabel: "Mark Shopify orders with quiz answers",
  },
];

const TOOLS = [
  {
    category: "Product recommendation quizzes",
    bestFor: "Structured preference capture, on-site conversion, ESP enrichment",
    options:
      "**RevenueHunt: Recommender Quiz for Shopify** (native Shopify + Klaviyo), Octane AI, Typeform (generic)",
  },
  {
    category: "Forms, popups, surveys",
    bestFor: "Email capture, simple preference centres, post-purchase surveys",
    options: "Klaviyo forms, Privy, KnoCommerce (post-purchase)",
  },
  {
    category: "Customer data platforms (CDP)",
    bestFor: "Unifying zero-party data with first-party behavioural and transactional data at scale",
    options: "Klaviyo Data Platform, Segment, Rudderstack, BlueConic",
  },
];

const FAQ = [
  {
    question: "What is zero-party data?",
    answer:
      "Zero-party data is information a customer intentionally and proactively shares with a brand: preferences, intents, goals, and how they want to be recognised. It is given freely in exchange for value (a recommendation, a discount, a personalised experience) and is the most accurate and privacy-compliant signal a retailer can act on.",
  },
  {
    question: "What is the difference between zero-party and first-party data?",
    answer:
      "Both are collected and owned by the brand. The difference is intent: first-party data is observed (pages visited, products purchased, emails opened); zero-party data is declared (the customer explicitly tells you their skin type, budget, or primary concern). First-party data is excellent for retargeting and propensity models. Zero-party data is excellent for personalisation, segmentation, and consent.",
  },
  {
    question: "How do you collect zero-party data?",
    answer:
      "Six methods consistently work: product recommendation quizzes, preference centres, loyalty and account programs, post-purchase surveys, smart forms with progressive profiling, and interactive content (calculators, configurators, finders). Product recommendation quizzes typically produce the highest yield per minute of customer attention because they wrap the data ask inside a clear value exchange.",
  },
  {
    question: "What are examples of zero-party data?",
    answer:
      "Skin type, primary skincare concern, age range, budget, shopping-for-self-or-gift, dietary restrictions, fitness goal, preferred communication channel and frequency, sizes, room dimensions, lifestyle category, scent preferences. Anything a customer states explicitly through a quiz, survey, preference centre, or account profile.",
  },
  {
    question: "Is zero-party data the same as first-party data?",
    answer:
      "Some industry frameworks treat zero-party as a subset of first-party (you own both, collected on your infrastructure). Most marketers separate them because zero-party is declared and first-party is observed. They behave differently in activation: zero-party powers explicit personalisation; first-party powers behavioural retargeting and propensity modelling.",
  },
  {
    question: "Why does zero-party data matter in 2026?",
    answer:
      "Four shifts have made it strategic rather than optional: third-party cookie deprecation, AI personalisation needing structured inputs, hardened privacy regulation (GDPR, CCPA, CPRA, Law 25, EU AI Act), and rising acquisition costs that make personalised retention the only durable margin lever.",
  },
  {
    question: "Is collecting zero-party data GDPR-compliant?",
    answer:
      "Zero-party data is the most GDPR-friendly category by definition: it is collected with the customer's active, specific consent in exchange for a stated value. To stay compliant you still need a clear privacy notice, a defined retention period, a documented purpose for processing, and an easy way for the customer to withdraw consent or request deletion.",
  },
  {
    question: "How do I activate zero-party data in Klaviyo?",
    answer:
      "Map each quiz or survey answer to a Klaviyo custom property via a native integration (no Zapier). Use those properties to build conditional splits in welcome and replenishment flows, drive dynamic content blocks in campaigns, and construct segments that were previously impossible (sensitive skin, gift buyers, specific budget tiers).",
    answerHtml:
      "Map each quiz or survey answer to a Klaviyo custom property via a native integration (no Zapier). Use those properties to build conditional splits in welcome and replenishment flows, drive dynamic content blocks in campaigns, and construct segments that were previously impossible (sensitive skin, gift buyers, specific budget tiers). The full mapping chain is covered in <a href=\"/klaviyo-zero-party-data/\" class=\"font-medium text-[#16161D] underline decoration-slate-500 underline-offset-2 hover:decoration-[#16161D]\">our Klaviyo zero-party data guide</a>.",
  },
  {
    question: "How long does it take to launch a zero-party data quiz?",
    answer:
      "Using an industry-specific template and a no-code quiz builder, most Shopify stores launch a working quiz with a native Klaviyo connection in under an hour. Data starts flowing into customer profiles the same day.",
  },
  {
    question: "How is zero-party data different from third-party data?",
    answer:
      "Third-party data is purchased or aggregated by an intermediary you don't own and is typically inferred (e.g. 'likely interested in skincare'). Zero-party data is given to you directly by the customer and is explicit. Third-party data is degrading rapidly as cookies are deprecated and privacy regulation tightens; zero-party data is the structural replacement.",
  },
];

const PAGE_TITLE = "Zero-party data: the complete guide for eCommerce (2026)";
const PAGE_DESCRIPTION =
  "Zero-party vs first-party data, the 4 data types compared, and 6 proven ways to collect zero-party data from your Shopify or WooCommerce store in 2026.";

const jsonLd = [
  organization(),
  softwareApplication(),
  breadcrumb([
    { name: "Home", url: "/" },
    { name: "Zero-party data", url: "/zero-party-data/" },
  ]),
  article({
    title: PAGE_TITLE,
    description: PAGE_DESCRIPTION,
    url: PAGE_URL,
    image: "/og/zero-party-data.png",
    datePublished: "2022-07-07",
    dateModified: "2026-06-16",
    author: "Paulina Chodura",
    authorUrl: new URL("/author/pochodura/", SITE.site_url).href,
    tags: [
      "zero-party data",
      "first-party data",
      "customer data",
      "ecommerce personalization",
      "GDPR",
      "Klaviyo",
    ],
  }),
  faqPage(FAQ),
  {
    "@context": "https://schema.org",
    "@type": "DefinedTermSet",
    name: "Customer data types",
    hasDefinedTerm: [
      {
        "@type": "DefinedTerm",
        name: "Zero-party data",
        description:
          "Information a customer intentionally and proactively shares with a brand: preferences, intents, goals, and how they want to be recognised. Unlike first-party data (observed behaviour) or third-party data (purchased from intermediaries), zero-party data is given freely in exchange for value, which makes it the most accurate and the most privacy-compliant signal a retailer can act on.",
        inDefinedTermSet: PAGE_URL,
      },
      {
        "@type": "DefinedTerm",
        name: "First-party data",
        description:
          "Observed behavioural data that a brand collects on its own infrastructure: site analytics, purchase history, CRM events, email engagement. Owned by the brand but inferred from action rather than declared by the customer.",
        inDefinedTermSet: PAGE_URL,
      },
      {
        "@type": "DefinedTerm",
        name: "Second-party data",
        description:
          "Another brand's first-party data, shared via direct agreement (co-marketing, partnership). Quality varies by partner; trust depends on the partner's collection practices.",
        inDefinedTermSet: PAGE_URL,
      },
      {
        "@type": "DefinedTerm",
        name: "Third-party data",
        description:
          "Aggregated, inferred, or purchased from data brokers, ad networks, or look-alike audiences. The brand neither collected nor owns the underlying records. Degrades as cookies are deprecated and privacy regulation tightens.",
        inDefinedTermSet: PAGE_URL,
      },
    ],
  },
];
---

<Base
  title={PAGE_TITLE}
  description={PAGE_DESCRIPTION}
  ogImage="/og/zero-party-data.png"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <PageHero>
    <Breadcrumb items={[{ label: "Home", href: "/" }, { label: "Zero-party data" }]} />
    <div class="text-center">
      <Eyebrow>The complete guide for eCommerce</Eyebrow>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
        Zero-party data: the complete guide for eCommerce (2026)
      </h1>
      <p class="mx-auto mt-6 max-w-3xl text-xl text-slate-600">
        Preference information your shoppers <strong>volunteer</strong> at the moment they're most engaged. The most accurate and most privacy-compliant signal a retailer can act on, and the structural replacement for cookie-based targeting in 2026.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={SHOPIFY_INSTALL}
          target="_blank"
          rel="external noopener nofollow"
          class="inline-flex items-center justify-center rounded-md bg-[#16161D] px-6 py-3 text-base font-semibold text-white transition hover:bg-[#26262e]"
        >
          Start collecting on Shopify
        </a>
        <a
          href="#collect"
          class="inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-6 py-3 text-base font-semibold text-slate-900 transition hover:border-slate-400 hover:bg-slate-50"
        >
          Jump to the 6 collection methods
        </a>
      </div>
      <p class="mt-6 text-sm text-slate-500">
        Used by <strong class="text-slate-700">20,000+</strong> ecommerce brands · <strong class="text-slate-700">4.9 ★</strong> on Shopify · <a href="/revenuehunt-built-for-shopify/" class="font-semibold text-slate-700 underline decoration-slate-300 underline-offset-2 hover:decoration-slate-700">Built for Shopify</a> certified
      </p>
    </div>
  </PageHero>

  <!-- Definition band -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-2xl bg-[#16161D] px-6 py-10 sm:px-10">
        <p class="text-center text-sm font-semibold uppercase tracking-wider text-[#5AB2FF]">
          Definition
        </p>
        <p class="mx-auto mt-6 max-w-3xl text-center text-xl text-white leading-relaxed">
          <strong>Zero-party data</strong> is information a customer <strong>intentionally and proactively</strong> shares with a brand: preferences, intents, goals, and how they want to be recognised. Unlike first-party data (observed behaviour) or third-party data (purchased from intermediaries), zero-party data is given <strong>freely in exchange for value</strong>, which makes it the most accurate and the most privacy-compliant signal a retailer can act on.
        </p>
      </div>
    </div>
  </section>

  <!-- What is + intro -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <p class="text-lg text-slate-700">
        If you sell online in 2026, your customer-data stack determines what you can personalise, who you can reach, and what you can prove to a privacy regulator. The single most strategic upgrade you can make to that stack this year is to start collecting zero-party data.
      </p>
      <p class="mt-4 text-lg text-slate-700">
        This guide covers what zero-party data is, how it compares to first-party, second-party, and third-party data, why it matters more in 2026 than it did in 2022, the six proven methods for collecting it, and the channels where it produces measurable lift.
      </p>
      <p class="mt-4 text-lg text-slate-700">
        The term <em>zero-party data</em> was coined by <a href="https://www.forrester.com/" target="_blank" rel="external noopener" class="font-medium text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-[#16161D]">Forrester</a> analyst Fatemeh Khatibloo in 2018 to describe a category of customer signal that didn't fit cleanly under "first-party" (observed) or "third-party" (purchased). Eight years later the distinction is no longer academic: cookie deprecation, the EU AI Act, and the rise of agentic shopping have made declared preference data a structural moat. Brands that already have a zero-party pipeline in production are compounding an advantage that brands relying on inferred third-party signals can no longer access.
      </p>
      <p class="mt-4 text-lg text-slate-700">
        This page is the canonical RevenueHunt reference on zero-party data. For the wider category that contains it, see <a href="/first-party-data/" class="font-medium text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-[#16161D]">first-party data</a>. For the format that produces it most efficiently, see <a href="/ecommerce-quiz/" class="font-medium text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-[#16161D]">ecommerce quiz</a>. For the platform that turns it into revenue, see <a href="/product-recommendation-quiz/" class="font-medium text-[#16161D] underline decoration-slate-300 underline-offset-2 hover:decoration-[#16161D]">RevenueHunt's product recommendation quiz</a>.
      </p>
    </div>
  </section>

  <!-- vs first/second/third-party -->
  <section id="compare" class="scroll-mt-20 bg-slate-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 text-center">Zero-party vs first-party vs second-party vs third-party data</h2>
      <p class="mx-auto mt-4 max-w-3xl text-slate-700 text-center">
        The four data types differ on three axes: <strong>who collected it</strong>, <strong>how it was obtained</strong>, and <strong>how reliable it is</strong>. Marketers conflate them constantly, and the conflation has cost.
      </p>

      <div class="mt-10">
        <svg viewBox="0 0 1200 560" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="data-tiers-title" style="width:100%;height:auto;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#16161D;border-radius:16px;padding:28px 16px;box-sizing:border-box;">
          <title id="data-tiers-title">Customer data types from highest accuracy (zero-party) to lowest (third-party)</title>
          <defs><linearGradient id="rh-grad-tiers" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#6464ff"/><stop offset="1" stop-color="#4bd5ff"/></linearGradient></defs>
          <text x="600" y="58" text-anchor="middle" fill="#F5F7FA" font-size="30" font-weight="800" letter-spacing="-0.5">Customer data types, ranked by accuracy</text>
          <g><rect x="60" y="110" width="270" height="400" rx="14" fill="#1F1F29" stroke="rgba(255,255,255,0.10)" stroke-width="1"/><path d="M 60 120 L 60 124 Q 60 110 74 110 L 316 110 Q 330 110 330 124 L 330 178 L 60 178 Z" fill="url(#rh-grad-tiers)"/><text x="195" y="148" text-anchor="middle" fill="#F5F7FA" font-size="22" font-weight="800">Zero-party</text><text x="195" y="220" text-anchor="middle" fill="#F5F7FA" font-size="16" font-weight="700">Customer tells you</text><text x="195" y="280" text-anchor="middle" fill="#A7AFBF" font-size="15"><tspan x="195" dy="0">"My skin is sensitive."</tspan><tspan x="195" dy="24">"I'm shopping for a gift."</tspan><tspan x="195" dy="24">Skin type, budget,</tspan><tspan x="195" dy="24">gift-or-self, fitness goal.</tspan></text><rect x="80" y="420" width="230" height="60" rx="10" fill="rgba(90,178,255,0.18)" stroke="rgba(90,178,255,0.55)" stroke-width="1.5"/><text x="195" y="450" text-anchor="middle" fill="#5AB2FF" font-size="13" font-weight="800" letter-spacing="2">ACCURACY</text><text x="195" y="470" text-anchor="middle" fill="#F5F7FA" font-size="15" font-weight="800">HIGHEST</text></g>
          <g><rect x="350" y="110" width="270" height="400" rx="14" fill="#1F1F29" stroke="rgba(255,255,255,0.10)" stroke-width="1"/><path d="M 350 178 L 350 124 Q 350 110 364 110 L 606 110 Q 620 110 620 124 L 620 178 Z" fill="#5AB2FF"/><text x="485" y="148" text-anchor="middle" fill="#F5F7FA" font-size="22" font-weight="800">First-party</text><text x="485" y="220" text-anchor="middle" fill="#F5F7FA" font-size="16" font-weight="700">You watched them</text><text x="485" y="280" text-anchor="middle" fill="#A7AFBF" font-size="15"><tspan x="485" dy="0">"Visited 3 product pages,</tspan><tspan x="485" dy="24">bought vitamin C serum</tspan><tspan x="485" dy="24">6 months ago." Site analytics,</tspan><tspan x="485" dy="24">CRM, email engagement.</tspan></text><rect x="370" y="420" width="230" height="60" rx="10" fill="rgba(90,178,255,0.12)" stroke="rgba(90,178,255,0.35)" stroke-width="1.5"/><text x="485" y="450" text-anchor="middle" fill="#A7AFBF" font-size="13" font-weight="800" letter-spacing="2">ACCURACY</text><text x="485" y="470" text-anchor="middle" fill="#F5F7FA" font-size="15" font-weight="800">HIGH</text></g>
          <g><rect x="640" y="110" width="270" height="400" rx="14" fill="#1F1F29" stroke="rgba(255,255,255,0.10)" stroke-width="1"/><path d="M 640 178 L 640 124 Q 640 110 654 110 L 896 110 Q 910 110 910 124 L 910 178 Z" fill="#475569"/><text x="775" y="148" text-anchor="middle" fill="#F5F7FA" font-size="22" font-weight="800">Second-party</text><text x="775" y="220" text-anchor="middle" fill="#F5F7FA" font-size="16" font-weight="700">A partner shared it</text><text x="775" y="280" text-anchor="middle" fill="#A7AFBF" font-size="15"><tspan x="775" dy="0">A co-marketing partner</tspan><tspan x="775" dy="24">shares its newsletter</tspan><tspan x="775" dy="24">list with you, or you</tspan><tspan x="775" dy="24">trade segments.</tspan></text><rect x="660" y="420" width="230" height="60" rx="10" fill="rgba(255,179,71,0.12)" stroke="rgba(255,179,71,0.4)" stroke-width="1.5"/><text x="775" y="450" text-anchor="middle" fill="#A7AFBF" font-size="13" font-weight="800" letter-spacing="2">ACCURACY</text><text x="775" y="470" text-anchor="middle" fill="#FFB347" font-size="15" font-weight="800">VARIABLE</text></g>
          <g><rect x="930" y="110" width="210" height="400" rx="14" fill="#1F1F29" stroke="rgba(255,255,255,0.10)" stroke-width="1"/><path d="M 930 178 L 930 124 Q 930 110 944 110 L 1126 110 Q 1140 110 1140 124 L 1140 178 Z" fill="#71717A"/><text x="1035" y="148" text-anchor="middle" fill="#F5F7FA" font-size="22" font-weight="800">Third-party</text><text x="1035" y="220" text-anchor="middle" fill="#F5F7FA" font-size="16" font-weight="700">Inferred elsewhere</text><text x="1035" y="280" text-anchor="middle" fill="#A7AFBF" font-size="15"><tspan x="1035" dy="0">"Females 25-34 likely</tspan><tspan x="1035" dy="24">interested in skincare."</tspan><tspan x="1035" dy="24">Look-alikes, brokers,</tspan><tspan x="1035" dy="24">ad-network inference.</tspan></text><rect x="950" y="420" width="170" height="60" rx="10" fill="rgba(248,113,113,0.12)" stroke="rgba(248,113,113,0.4)" stroke-width="1.5"/><text x="1035" y="450" text-anchor="middle" fill="#A7AFBF" font-size="13" font-weight="800" letter-spacing="2">ACCURACY</text><text x="1035" y="470" text-anchor="middle" fill="#F87171" font-size="15" font-weight="800">LOWEST</text></g>
