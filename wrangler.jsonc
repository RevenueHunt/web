{
  "name": "revenuehunt-web",
  "main": "./src/worker.js",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Without this, env.ASSETS.fetch() returns a bare 404 (no body) for
    // unmatched paths and the browser shows Cloudflare's generic error
    // page. "404-page" makes it serve dist/404.html with a 404 status.
    "not_found_handling": "404-page"
  },
  "vars": {
    "PUBLIC_SITE_URL": "https://revenuehunt.com"
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": false,
  "preview_urls": false
}
