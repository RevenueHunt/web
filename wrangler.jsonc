{
  "name": "revenuehunt-web",
  "main": "./src/worker.js",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "vars": {
    "PUBLIC_SITE_URL": "https://revenuehunt.com"
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": false,
  "preview_urls": false
}
